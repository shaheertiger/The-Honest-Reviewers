{
  "name": "the-honest-reviewers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:words": "node scripts/validate-word-count.js",
    "build": "node scripts/validate-word-count.js && node scripts/validate-internal-links.js && node scripts/format-audit.mjs && astro build",
    "postbuild": "INDEXNOW_AUTO=1 node scripts/submit-indexnow.js",
    "preview": "astro preview",
    "images:fetch": "node scripts/fetch-product-images.mjs",
    "indexnow": "node scripts/submit-indexnow.js",
    "validate:links": "node scripts/validate-internal-links.js",
    "validate:format": "node scripts/format-audit.mjs",
    "images:fetch:all": "node scripts/extract-all-products.mjs && node scripts/fetch-all-product-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@vercel/analytics": "^1.6.1",
    "amazon-creators-api": "^1.2.2",
    "astro": "^5.17.2",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
