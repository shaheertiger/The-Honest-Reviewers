---
interface Product {
  id: string;
  name: string;
  badge?: string;
  category?: string;
  bottomLine?: string;
}
interface Props {
  products: Product[];
  heading?: string;
}
const { products, heading = "Our Picks at a Glance" } = Astro.props;
---

<div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8 my-8 not-prose">
  <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-4">{heading}</p>
  <ul class="space-y-3 list-none p-0 m-0">
    {products.map((product) => (
      <li class="text-sm text-gray-700">
        {product.badge && <span class="font-black text-gray-900">{product.badge}:</span>}{" "}
        <a href={`#${product.id}`} class="text-[#1E90FF] font-bold no-underline hover:underline">{product.name}</a>
        {product.category && <span class="text-gray-500"> — {product.category}</span>}
      </li>
    ))}
  </ul>
</div>
