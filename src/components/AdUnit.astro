---
interface Props {
  variant?: "in-article" | "display";
  slot?: string;
  style?: string;
}

const { variant = "in-article", slot, style } = Astro.props;

const isDisplay = variant === "display";
const resolvedSlot = slot ?? (isDisplay ? "9188237028" : "2786025951");
const resolvedStyle = style ?? (isDisplay ? "display:block" : "display:block; text-align:center;");
---

{isDisplay ? (
  <ins class="adsbygoogle"
       style={resolvedStyle}
       data-ad-client="ca-pub-2128579868272786"
       data-ad-slot={resolvedSlot}
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
) : (
  <ins class="adsbygoogle"
       style={resolvedStyle}
       data-ad-layout="in-article"
       data-ad-format="fluid"
       data-ad-client="ca-pub-2128579868272786"
       data-ad-slot={resolvedSlot}></ins>
)}
<script is:inline>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>
