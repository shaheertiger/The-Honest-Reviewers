---
interface Props {
  slot?: string;
  format?: string;
  layout?: string;
  style?: string;
}

const {
  slot = "2786025951",
  format = "fluid",
  layout = "in-article",
  style = "display:block; text-align:center;",
} = Astro.props;
---

<ins class="adsbygoogle"
     style={style}
     data-ad-layout={layout}
     data-ad-format={format}
     data-ad-client="ca-pub-2128579868272786"
     data-ad-slot={slot}></ins>
<script is:inline>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>
