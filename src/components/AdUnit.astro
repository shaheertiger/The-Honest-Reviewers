---
interface Props {
  slot?: string;
  format?: string;
  fullWidthResponsive?: boolean;
  style?: string;
}

const {
  slot = "9188237028",
  format = "auto",
  fullWidthResponsive = true,
  style = "display:block",
} = Astro.props;
---

<ins class="adsbygoogle"
     style={style}
     data-ad-client="ca-pub-2128579868272786"
     data-ad-slot={slot}
     data-ad-format={format}
     data-full-width-responsive={fullWidthResponsive.toString()}></ins>
<script>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>
