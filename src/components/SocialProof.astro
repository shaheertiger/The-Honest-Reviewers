---
interface Props {
  users: string;
}
const { users } = Astro.props;
---
<div class="flex items-center gap-2 text-gray-500 text-sm italic">
  <div class="flex -space-x-2">
    {[1,2,3,4].map(i => (
      <img src={`https://i.pravatar.cc/40?img=${i+10}`} class="w-6 h-6 rounded-full border-2 border-white" alt="User avatar" />
    ))}
  </div>
  <span>Join {users} others who chose this</span>
</div>
