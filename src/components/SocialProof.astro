---
interface Props {
  users: string;
}
const { users } = Astro.props;
---

<div class="flex items-center gap-3 text-gray-500 text-sm italic">
  <div class="flex -space-x-2 flex-shrink-0">
    {
      [1, 2, 3, 4].map((i) => (
        <img
          src={`https://i.pravatar.cc/40?img=${i + 10}`}
          class="w-7 h-7 rounded-full border-2 border-white"
          alt="User avatar"
        />
      ))
    }
  </div>
  <span class="leading-tight"
    >Join <strong class="text-gray-700 not-italic">{users}</strong> others who chose
    this</span
  >
</div>
