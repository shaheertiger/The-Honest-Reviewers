---
interface Props {
  users: string;
}
const { users } = Astro.props;

// Abstract marks rather than stock photographs of people — the site has no
// photographs of its readers, and borrowed faces imply ones it does not have.
const MARKS = ["#1E90FF", "#38BDF8", "#FF4500", "#0F766E"];
---

<div class="flex items-center gap-3 text-gray-500 text-sm italic">
  <div class="flex -space-x-2 flex-shrink-0" aria-hidden="true">
    {
      MARKS.map((color) => (
        <span
          class="w-7 h-7 rounded-full border-2 border-white inline-block"
          style={`background:linear-gradient(135deg, ${color} 0%, ${color}66 100%)`}
        />
      ))
    }
  </div>
  <span class="leading-tight"
    >Join <strong class="text-gray-700 not-italic">{users}</strong> others who chose
    this</span
  >
</div>
