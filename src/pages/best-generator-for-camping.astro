---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Propane Generators",
    "url": "/best-propane-generator/"
  },
  {
    "title": "Inverter vs Regular Generator",
    "url": "/inverter-generator-vs-regular-generator/"
  },
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best Portable Generators for Camping in 2026: Quiet Enough for Campgrounds";
const description =
  "The best portable generator for camping, judged on campground dB limits, weight you can lift, real watts and parallel kits, with honest advice on when a battery wins.";

const PRODUCTS = [
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i (EU2200ITAG)",
    "category": "Gas Inverter, 1,800W Rated / 2,200W Max",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "1,800 rated watts covers a 12V converter, coffee maker, CPAP and lights",
      "Honda lists 46.5 lb dry, a one-person lift into a truck bed",
      "Rated 3.2 hours at full load and 8.1 hours at quarter load on 0.95 gallons",
      "CO-MINDER shutdown and parallel capability with a second EU2200i",
      "The resale value and dealer network are the best in the category"
    ],
    "cons": [
      "No TT-30R outlet on this version; RV owners need an adapter or the Companion model",
      "Costs roughly twice what the Westinghouse costs for similar output",
      "This EU2200ITAG listing is not sold in California"
    ],
    "bottomLine": "The camping generator to buy if you only buy once: quiet enough for most campground rules, light enough to lift, and the one owners keep for fifteen years.",
    "description": "The EU2200i is the default answer for a portable generator for camping because it hits every campground constraint at once. Honda rates it at 2,200 maximum and 1,800 rated watts, enough for a trailer's converter, a coffee maker or a CPAP plus lights and phones, though not a rooftop air conditioner on its own. Honda lists the dry weight at 46.5 lb, which is about as heavy as a generator can be while one adult still lifts it into a pickup bed without a ramp. The 0.95 gallon tank is rated for 3.2 hours at full load and 8.1 hours at a quarter load, so an evening of lights, fans and charging fits in one fill. Honda's own spec lists 57 dB(A) at rated load, and at the light loads typical of a campsite it runs quieter than that, which keeps it under the roughly 60 dB at 50 feet that many parks enforce. It has CO-MINDER, which shuts the engine down if carbon monoxide builds up, and it parallels with a second EU2200i if you later want to run an air conditioner. The catch is price: it costs roughly double the Westinghouse below for similar watts. What you get for that is a reputation for starting after a season in the shed and resale prices that recover a large share of the cost. This EU2200ITAG listing is not sold in California; buyers there need the CARB-specific variant."
  },
  {
    "id": "westinghouse-igen2550c",
    "name": "Westinghouse iGen2550c",
    "category": "Gas Inverter, 1,900W Running / 2,550W Peak, TT-30R",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "1,900 running watts, more than the Honda, at a much lower price",
      "Built-in TT-30R RV outlet plus two 20A household outlets and USB",
      "Westinghouse rates it as low as 52 dBA",
      "Listed at about 43 lb dry",
      "CO sensor and parallel capability"
    ],
    "cons": [
      "Long-term durability record is shorter than Honda's",
      "Runtime figures differ between the official page (11 hours) and the Amazon listing (12 hours) at 25% load"
    ],
    "bottomLine": "The best camping generator for the money: more watts than the Honda, an RV plug built in, and a weight one person can manage.",
    "description": "The iGen2550c is the value pick because it beats the Honda on paper in the places campers care about and costs far less. Westinghouse lists 2,550 peak and 1,900 running watts, about 100 running watts more than the EU2200i, and it puts a TT-30R 30 amp RV outlet on the panel alongside two 20 amp household outlets and two USB ports, so a small travel trailer plugs straight in without an adapter. Westinghouse rates it as low as 52 dBA, a light-load figure, and lists the dry weight at about 43 lb, a few pounds lighter than the Honda. The official page gives up to 11 hours at 25 percent load on its roughly 1.1 gallon tank, while the Amazon listing says 12, so plan on the lower number. It has a CO sensor that shuts the engine down if carbon monoxide builds, and it can be paralleled with a second Westinghouse inverter through a separate cord, which is the cheapest route to running a 13,500 BTU camper air conditioner. What you give up is the long track record: Westinghouse's small inverters have a good owner reputation, but there is not the fifteen-year history Honda has. For a weekend camper who runs it twenty nights a year, that matters less than the price gap, which is why this is the one we would recommend to most people."
  },
  {
    "id": "champion-2500-dual-fuel",
    "name": "Champion 201323 2500-Watt Dual Fuel Inverter",
    "category": "Dual Fuel Inverter, 1,850W Running (Gas) / 2,500W Starting",
    "badge": "Best Dual Fuel",
    "amazonUrl": "#",
    "pros": [
      "Runs on gasoline or the propane cylinder you already bring for the stove",
      "2,500 starting and 1,850 running watts on gasoline",
      "CO Shield automatic shutoff",
      "Cold start technology for chilly mornings",
      "Champion's 3-year limited warranty"
    ],
    "cons": [
      "Output drops on propane, as it does on every dual fuel unit",
      "Retailers list it at about 43 lb, not the 39 lb some older Champion listings show",
      "No TT-30R outlet on the panel"
    ],
    "bottomLine": "The camping generator for people who would rather not carry gasoline in the car: it runs off the same propane tank as the camp stove.",
    "description": "Champion's 201323 is the pick for campers who already carry propane and do not want a gas can in the vehicle. It is rated for 2,500 starting and 1,850 running watts on gasoline, and it also runs on propane from a standard cylinder, with lower output on propane as every dual fuel engine has. That trade suits camping better than it suits home backup: campsite loads are light, propane does not go stale in the tank between trips, and there is no fuel to spill in the cargo area. It uses an 80cc engine, includes Champion's CO Shield, which shuts the engine off if carbon monoxide builds up, and Champion advertises cold start technology for the frosty mornings that make small engines hard to pull. Retailer listings put the weight at about 43 lb, so it lifts as easily as the Westinghouse. The panel has a covered 120V 20 amp outlet, a 12V outlet and a USB adapter, but no TT-30R, so trailer owners need a dogbone adapter, and on propane its output is too low to start most rooftop air conditioners alone. Champion's noise rating for this exact model was not something we could confirm, so do not buy it on quietness alone. Buy it for fuel flexibility, a 3-year limited warranty and a price well under the Honda."
  },
  {
    "id": "honda-eu1000i",
    "name": "Honda EU1000i (EU1000T1AN)",
    "category": "Gas Inverter, 900W Rated / 1,000W Max",
    "badge": "Lightest Pick",
    "amazonUrl": "#",
    "pros": [
      "About 29 lb, the easiest generator here to carry to a walk-in site",
      "Listing rates it at 42 to 50 dB(A), the quietest here",
      "Runs 3.0 to 6.8 hours on 0.6 gallons",
      "CO-MINDER shutdown",
      "Enough for a CPAP, fans, lights, a laptop and battery charging"
    ],
    "cons": [
      "900 rated watts will not run a coffee maker, microwave or air conditioner",
      "Small tank means refuelling once during a long night",
      "Not sold in California under this model number"
    ],
    "bottomLine": "The camping generator for tent campers and van owners who need light charging power and the least noise, and nothing more.",
    "description": "The EU1000i is the generator for people whose campsite power list is a CPAP, a fan, lights and phones. Honda rates it at 1,000 maximum and 900 rated watts, and the Amazon listing lists 42 to 50 dB(A) and about 29 lb, which makes it the lightest and quietest unit here by a wide margin. At 29 lb it is a one-hand carry from the car to a walk-in tent site, and its noise sits comfortably under the 60 dB limit many campgrounds enforce. The listing rates it for 3.0 hours at full load and 6.8 hours at a quarter load on a 0.6 gallon tank, so an all-night CPAP run may need a top-up. It has Honda's CO-MINDER shutdown. What it will not do is anything that heats: a 900 watt rating rules out most coffee makers, hair dryers, electric kettles, microwaves and every RV air conditioner. If any of those are on your list, buy the EU2200i instead. Be aware that a 300 to 500Wh portable power station now covers much of this same job silently, which is the honest reason to compare it against a power station before buying. Where the EU1000i still wins is multi-day trips without solar or shore power: a gallon of gasoline is far more energy than any battery you can carry. This EU1000T1AN listing is not sold in California."
  },
  {
    "id": "champion-200988-4500-dual-fuel",
    "name": "Champion 200988 4500-Watt Dual Fuel Inverter",
    "category": "Dual Fuel Inverter, 3,500W Running (Gas), TT-30R",
    "badge": "Best for Camper AC",
    "amazonUrl": "#",
    "pros": [
      "3,500 running watts on gas and about 3,150 on propane, enough for a 13,500 BTU AC",
      "Built-in TT-30R RV outlet",
      "Electric start",
      "Runs on gasoline or propane"
    ],
    "cons": [
      "Champion rates it at 61 dBA, over many campground limits",
      "Close to 100 lb per the Amazon listing; it rolls, it does not lift",
      "Too big and loud for tent camping"
    ],
    "bottomLine": "Only buy this one if you need to run a camper air conditioner from a single generator. For everything else it is too heavy and too loud.",
    "description": "The 200988 is here for one reason: some campers need to run a 13,500 or 15,000 BTU rooftop air conditioner from a single generator, and a 2,200 watt unit will not do it alone. Champion rates this one at 4,500 starting and 3,500 running watts on gasoline and about 3,150 running watts on propane, which covers a camper air conditioner plus the converter and a few small loads. It has a TT-30R outlet for a direct trailer connection, electric start, and runs on either fuel. The costs are noise and weight. Champion rates it at 61 dBA, which sits just over the 60 dB at 50 feet that many parks enforce, so in a strict campground you may be asked to shut it off or move it. The Amazon listing puts it at close to 100 lb, which means it rides on its wheels and goes up a ramp, not over a tailgate by hand. If you can live without air conditioning, or you have two people to carry two small units, a pair of paralleled 2,200 to 2,500 watt inverters gives you the same total power in two 45 lb lifts and lets you run one quietly most of the day. For boondocking in summer heat with a single trailer, though, the 200988 is the simplest one-box answer."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Generator for Camping",
          item: "https://www.thehonestreviewers.com/best-generator-for-camping/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size generator do I need for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For lights, fans, phones, laptops and a CPAP, a 1,000 watt class inverter is enough. To add a coffee maker, microwave or hair dryer, step up to an 1,800 to 1,900 running watt unit such as the Honda EU2200i or Westinghouse iGen2550c. To run a 13,500 BTU camper air conditioner, plan on roughly 3,000 running watts, either in one generator or two paralleled small units."
          }
        },
        {
          "@type": "Question",
          "name": "How quiet does a camping generator need to be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many campgrounds cap generator noise at around 60 dB measured at 50 feet, and some set lower limits or ban generators in certain loops. Manufacturers measure at 23 feet, so a quality inverter rated in the low 50s at 23 feet will usually comply at light camp loads. Open-frame generators rated in the high 60s or 70s usually will not."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 2,200 watt generator run an RV air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes. A 13,500 BTU unit runs at roughly 1,200 to 1,600 watts but needs a larger surge to start. Owners commonly report success on cool days with nothing else running and failure on hot days or at altitude. Adding a soft starter to the air conditioner, or paralleling a second generator, makes it reliable."
          }
        },
        {
          "@type": "Question",
          "name": "Is an inverter generator better for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, almost always. An inverter throttles the engine to match the load, which makes it far quieter at typical campsite loads, more fuel efficient, and produces clean power for laptops and CPAP machines. Inverters are also lighter for their output. Conventional generators are cheaper per watt but are usually too loud for campground rules."
          }
        },
        {
          "@type": "Question",
          "name": "Should I get a dual fuel camping generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you already carry propane for a stove, a dual fuel unit such as the Champion 201323 lets you skip carrying gasoline, and propane does not go stale between trips. Expect less output on propane and plan runtime from the propane cylinder size. If you camp in cold weather, keep gasoline as a backup because small propane cylinders struggle in the cold."
          }
        },
        {
          "@type": "Question",
          "name": "Is a portable power station better than a generator for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small loads, often yes: it is silent, has no exhaust, can run overnight during quiet hours and can be used inside a tent or trailer. It cannot match a generator for anything that heats or cools, or for a week off-grid without sun. Many campers use both, charging the battery during permitted generator hours."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a camping generator in the back of my truck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is better not to. A hollow truck bed amplifies vibration and noise, and exhaust can collect under a cap or tonneau cover and drift into the cab. Set the generator on the ground, on a level surface, at least 20 feet from tents and trailers with the exhaust pointing away from people and openings."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "portable generator for camping",
      "camping generator",
      "portable camping generators",
      "camping generator portable",
      "quiet generator for camping",
      "inverter generator for camping"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Generators for Camping</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Five portable camping generators that respect quiet hours, lift into a truck and run what a campsite actually needs, plus the one job a battery does better.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#honda-eu2200i"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 5 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 5 Camping Picks Reviewed</a>
          <a href="#quiet-hours" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Quiet Hours and dB Limits</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. How Many Watts You Need</a>
          <a href="#weight" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Weight You Can Lift</a>
          <a href="#parallel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Parallel Kits</a>
          <a href="#rv-ac" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Running a Camper AC</a>
          <a href="#fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Fuel and Runtime</a>
          <a href="#power-station" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Power Station Instead?</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. CO and Campsite Safety</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The best portable generator for camping is not the most powerful one. It is the one quiet enough that the ranger never comes over, light enough that you actually bring it, and big enough for the one appliance you cannot do without. For most campers that is a 2,000 to 2,500 watt inverter in the 40 to 50 lb range. For a lot of others, it is a battery.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 5 Best Portable Generators for Camping, Ranked
          </h2>

          <p>
            We compared camping generators from Honda, Westinghouse and Champion on rated running and starting watts, published noise ratings, dry weight, runtime, outlets, CO shutdown and parallel capability, then weighed each against typical campground rules. Spec-sheet figures are manufacturer ratings, which we have attributed as such; where retailers and manufacturers disagree, we say so. We left out open-frame generators entirely because none of them come close to a 60 dB campground limit.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} reviews)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
