---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cordless Drills",
    "url": "/best-cordless-drills/"
  },
  {
    "title": "Best Caulk Gun",
    "url": "/best-caulk-gun/"
  },
  {
    "title": "Best Laser Level",
    "url": "/best-laser-level/"
  },
  {
    "title": "Best Stud Finder",
    "url": "/best-stud-finder/"
  },
  {
    "title": "Best Primer",
    "url": "/best-primer/"
  },
  {
    "title": "Best Pressure Washer",
    "url": "/best-pressure-washer/"
  },
  {
    "title": "Best Smart Locks",
    "url": "/best-smart-lock/"
  },
  {
    "title": "Best Video Doorbells",
    "url": "/best-video-doorbell/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-30", modified: "2026-10-30" });
const title = "Home Improvement Ideas: 7 Upgrades Worth Doing First, and the Gear to Do Them";
const description =
  "Home improvement ideas ranked by payoff, from caulk and air sealing to smart locks and lighting, with the gear we'd buy for each and how to sequence them.";

const PRODUCTS = [
  {
    "id": "dewalt-dcd771c2-drill-kit",
    "name": "DEWALT 20V MAX Cordless Drill/Driver Kit (DCD771C2)",
    "category": "Every Project: Drilling and Driving",
    "badge": "Best Starter Tool",
    "amazonUrl": "#",
    "pros": [
      "Compact, lightweight body is easy to handle in tight spots like cabinets and closets",
      "Two batteries and a charger come in the kit, so one can charge while you work",
      "Two-speed gearbox covers both drilling and driving screws",
      "Part of the broad 20V MAX battery platform, so you can add tools later",
      "A 1/2-inch chuck accepts the common range of drill bits and drivers"
    ],
    "cons": [
      "Brushed motor and modest battery size are not built for all-day heavy use",
      "Newer brushless models offer more power and runtime for more money"
    ],
    "bottomLine": "A sensible first drill for a homeowner who wants a trusted platform without paying for pro-level power.",
    "description": "Nearly every upgrade in this guide, from hanging shelves to installing a smart lock, starts with a drill, and the DEWALT DCD771C2 kit is a long-running, widely owned entry point. The kit pairs a compact 20V MAX drill/driver with two batteries and a charger, which solves the most common beginner frustration: running out of power halfway through a job. The manufacturer specifies a 1/2-inch chuck and a two-speed gearbox, and owners commonly report that it handles household drilling and screwdriving comfortably. It is not the most powerful drill DEWALT sells, and heavy users will eventually want brushless, but for shelves, curtain rods, light fixtures and furniture it is more than enough. The real value is the platform: the same batteries power DEWALT's other 20V MAX tools, so the kit works as the foundation of a growing collection."
  },
  {
    "id": "google-nest-learning-thermostat",
    "name": "Google Nest Learning Thermostat",
    "category": "Energy Upgrade: Smart Thermostat",
    "badge": "Best Smart Thermostat Upgrade",
    "amazonUrl": "#",
    "pros": [
      "Learns your schedule and adjusts heating and cooling automatically",
      "Remote control and scheduling through a phone app",
      "ENERGY STAR certified model line, so utility rebates may be available in some areas",
      "Clean, readable display that looks good on most walls",
      "Compatibility checker on the manufacturer's site reduces installation surprises"
    ],
    "cons": [
      "Some heating and cooling systems need extra wiring or a power accessory",
      "Costs more than basic programmable thermostats"
    ],
    "bottomLine": "A strong pick if your routine varies week to week and you want the thermostat to figure it out for you.",
    "description": "A thermostat is the control center of your heating and cooling, and the Nest Learning Thermostat is one of the best-known ways to upgrade it. Instead of making you program a schedule, it watches how you adjust the temperature and builds a schedule from that, then uses presence sensing and your phone to avoid conditioning an empty house. The manufacturer promotes energy savings, and utility programs have studied smart thermostats generally, but your results depend on your climate, equipment and habits. Installation is within reach of a careful DIYer: shut off power, photograph the existing wiring, label the wires, and follow the app's guided steps. The most important step happens before you buy, which is running the compatibility checker for your system. If it flags an unusual setup, such as line-voltage heat, hire an HVAC technician."
  },
  {
    "id": "yale-assure-lock-2",
    "name": "Yale Assure Lock 2",
    "category": "Security Upgrade: Smart Lock",
    "badge": "Best Smart Lock Upgrade",
    "amazonUrl": "#",
    "pros": [
      "Keypad or touchscreen options mean no key needed for daily use",
      "Lets you create separate codes for family, guests and service visits",
      "Available in several connectivity versions, including Wi-Fi and Bluetooth modules",
      "Replaces only the deadbolt hardware on your existing door in most cases",
      "Many models keep a traditional key cylinder as a backup"
    ],
    "cons": [
      "Connected features depend on the module and may add cost",
      "Battery-powered, so you need to change batteries on schedule"
    ],
    "bottomLine": "A practical door upgrade that ends key fumbling and makes guest access simple.",
    "description": "A smart lock solves a problem you hit every day: getting in the door with your hands full, or letting someone in when you are not home. The Yale Assure Lock 2 is a popular choice because it comes in several styles, including keypad and touchscreen versions, and several connectivity options, so you can match it to the smart home setup you already have. The manufacturer designs it to replace the deadbolt on a standard prepared door, and many homeowners install one in under an hour with a screwdriver. The practical benefit is code management: you can issue and revoke codes without rekeying. Check that your door's bore and backset match the lock, choose the connectivity version carefully, and keep a mechanical key option or backup battery method in mind. Our smart lock guide compares alternatives."
  },
  {
    "id": "bosch-gll-55",
    "name": "Bosch GLL 55 Self-Leveling Cross-Line Laser",
    "category": "Layout Upgrade: Shelves, Tile, Art",
    "badge": "Best Layout Tool",
    "amazonUrl": "#",
    "pros": [
      "Projects level horizontal and vertical lines so shelves and tile rows come out straight",
      "Self-leveling design corrects small tilts automatically",
      "Compact and light enough to carry from room to room",
      "A pendulum lock protects the mechanism during transport",
      "Saves time compared with measuring and chasing a bubble level"
    ],
    "cons": [
      "Red lasers can be hard to see in bright light or outdoors",
      "Accuracy depends on setup, so you still verify against a known reference"
    ],
    "bottomLine": "The cheapest way to make every shelf, picture row and tile line look professional.",
    "description": "Straight lines are the difference between a DIY job that looks professional and one that does not, and a self-leveling cross-line laser is the easiest way to get them. The Bosch GLL 55 projects horizontal and vertical lines that you can follow with a pencil, and the manufacturer lists a working range suitable for room-sized projects. Owners commonly use it for hanging gallery walls, aligning cabinets, setting tile courses and laying out chair rails. Place it on a stable surface or tripod, wait for it to self-level, mark your points, and you are done. In a bright room or outdoors the line fades, which is when a detector or a different model helps. Pair it with a stud finder to locate framing, and check our laser level guide for other options."
  },
  {
    "id": "dap-alex-plus-caulk",
    "name": "DAP Alex Plus Acrylic Latex Caulk Plus Silicone",
    "category": "Seal and Paint: Caulking",
    "badge": "Best Everyday Caulk",
    "amazonUrl": "#",
    "pros": [
      "Paintable, so it works around trim, baseboards and window casings",
      "Water cleanup makes it forgiving for beginners",
      "Flexible enough for small expansion and contraction of trim joints",
      "Widely available and inexpensive compared with the cost of a bad finish",
      "Comes in common tube sizes that fit a standard caulk gun"
    ],
    "cons": [
      "Not the right choice for constantly wet areas such as shower seams",
      "Needs a clean, dry joint to bond well"
    ],
    "bottomLine": "The one tube to keep in the house for trim, casings and small gaps before painting.",
    "description": "Caulk is the cheapest upgrade in this guide, and DAP Alex Plus is a long-standing favorite for interior trim and paintable joints. It is an acrylic latex caulk with silicone added for flexibility, and the label specifies it as paintable and cleanable with water, which makes it a beginner-friendly choice. Use it where trim meets wall, around window and door casings, and in small gaps you plan to paint over. Do not use it as a shower or tub sealant, where a mildew-resistant silicone is the right chemistry. Prep matters more than product: scrape out failed caulk, vacuum the joint, cut the nozzle small, run a continuous bead and smooth it with a damp finger. Read our guides to exterior caulk and bathroom caulk for wetter locations."
  },
  {
    "id": "sun-joe-spx3000",
    "name": "Sun Joe SPX3000 Electric Pressure Washer",
    "category": "Curb Appeal: Driveway, Deck, Siding",
    "badge": "Best Curb Appeal Cleanup",
    "amazonUrl": "#",
    "pros": [
      "Plug-in electric design is quieter and needs no fuel or tune-ups",
      "Rated by the manufacturer at roughly 2,000 PSI, enough for patios, siding and vehicles",
      "Multiple spray tips let you match pressure to the surface",
      "Built-in detergent tank for soap application",
      "Easier to store than gas models"
    ],
    "cons": [
      "Less powerful than gas units for heavily stained concrete",
      "Limited by cord length and a nearby outlet"
    ],
    "bottomLine": "A manageable, low-maintenance way to restore the look of hard surfaces before painting or sealing.",
    "description": "Dirt and mildew age a house faster than most people realize, and cleaning is often the highest-impact curb appeal upgrade for the least money. The Sun Joe SPX3000 is a widely owned electric pressure washer, and the manufacturer rates it around 2,000 PSI, which is suited to patios, walkways, fences, siding and outdoor furniture. Owners commonly like that it needs no fuel, starts reliably and stores easily. Use the wider tips on delicate surfaces like wood and siding, keep a consistent distance, and never aim at windows, electrical outlets or people. If you plan to seal or repaint, wash first and let surfaces dry completely. For tougher jobs or larger driveways, compare gas models in our pressure washer guide."
  },
  {
    "id": "lutron-caseta-dimmer-kit",
    "name": "Lutron Caseta Smart Dimmer Switch Starter Kit",
    "category": "Lighting Upgrade: Smart Dimmers",
    "badge": "Best Lighting Upgrade",
    "amazonUrl": "#",
    "pros": [
      "In-wall dimmers replace existing switches, so lights still work by hand",
      "Works without a neutral wire in many installations, per the manufacturer",
      "Hub-based design keeps lighting control separate from your Wi-Fi traffic",
      "Includes a hub and remote in starter kit versions",
      "Compatible with several popular voice assistants and smart home platforms"
    ],
    "cons": [
      "Starter kits cover only a few switches, so a whole house adds up",
      "You need to match the dimmer to your bulb type and load"
    ],
    "bottomLine": "A reliable, family-friendly way to add dimming and scheduling without relying on an app.",
    "description": "Lighting changes how a room feels more than almost any other upgrade, and dimmers are the easiest way to take control of it. Lutron Caseta dimmers replace the wall switch you already have, so family members and guests do not need to learn an app, and the lights still work if your Wi-Fi goes down. The manufacturer says many Caseta dimmers do not require a neutral wire, which matters in older homes. A starter kit includes a hub, which connects the dimmers to your phone and voice assistant for scheduling and remote control. Installation means turning off the breaker, confirming the power is off, and swapping wires one for one, a job a careful DIYer can handle. Check that the dimmer's rating matches your bulbs, particularly LEDs, and hire an electrician if the wiring looks confusing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Home Improvement Ideas",
          item: "https://www.thehonestreviewers.com/home-improvement-ideas/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What home improvement ideas add the most value?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Annual cost-versus-value surveys consistently show that exterior and maintenance projects, such as replacing an entry door or garage door, tend to recover a larger share of their cost than big interior remodels. Smaller upgrades like fresh paint, sealed gaps and updated lighting also improve how a home shows."
          }
        },
        {
          "@type": "Question",
          "name": "What should I fix first in an older house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with water and air: leaks, failed caulk, missing weatherstripping and poor drainage. These protect the structure and reduce energy waste. Then address safety items such as smoke and carbon monoxide detectors, electrical hazards and lead paint before cosmetic work."
          }
        },
        {
          "@type": "Question",
          "name": "Do smart thermostats really save money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can, but results vary. Savings depend on your climate, your equipment, how well the house is sealed and whether you actually use the scheduling features. A smart thermostat reliably prevents conditioning an empty house, and some utilities offer rebates, so check local programs."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a smart lock myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases yes. Many smart locks replace the deadbolt on a standard prepared door with a screwdriver in under an hour. Measure your door's bore and backset first, choose the right connectivity version, and keep a backup entry method in case batteries run out."
          }
        },
        {
          "@type": "Question",
          "name": "What basic tools does every homeowner need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cordless drill/driver, tape measure, level, stud finder, caulk gun, utility knife, screwdriver set and pliers cover most household projects. Buy fewer, better tools on one battery platform rather than many cheap tools you rarely use."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to buy tools and home upgrades?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prices commonly soften around major holidays, at the end of a season and when a new product generation arrives. Watch the price of specific items for a few weeks so you recognize a real discount. Avoid buying simply because a sale is ending."
          }
        },
        {
          "@type": "Question",
          "name": "Which home improvements need a permit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Requirements vary by location, but electrical, plumbing, gas, structural and some roofing, deck and fence projects commonly need permits. Cosmetic work like painting and caulking generally does not. Call your local building department before starting; it is usually a free, quick answer."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "home improvement ideas",
      "home upgrades",
      "diy home improvement",
      "home renovation ideas",
      "best home upgrades",
      "home improvement tools"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Ranked by Payoff
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Home Improvement <span class="text-[#38BDF8]">Ideas Worth Doing First</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven upgrades ranked by what they actually do for comfort, security and bills, each paired with the one piece of gear we'd start with.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dewalt-dcd771c2-drill-kit"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See How to Sequence Your Projects
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#ranked-by-payoff" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Home Improvement Ideas, Ranked by Payoff</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 7 Upgrades and the Gear to Do Them</a>
          <a href="#budget-tiers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Budget Tiers: What to Do at Each Price Level</a>
          <a href="#comfort-and-bills" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Comfort and Energy Upgrades</a>
          <a href="#smart-and-security" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Smart Home and Security Upgrades</a>
          <a href="#diy-vs-hire" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. DIY or Hire a Pro?</a>
          <a href="#starter-kit" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. The Starter Tool Kit Logic</a>
          <a href="#safety-timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Safety, Permits and Timing Your Purchases</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most home improvement lists are a catalog of things that look good in a photo. The upgrades that pay you back are quieter: a sealed gap, a thermostat that stops heating an empty house, a lock you never have to think about, a coat of paint on a wall you have stared at for years. This guide ranks seven ideas by what they change in daily life, then names the gear to do each one properly.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="ranked-by-payoff" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Home Improvement Ideas, Ranked by Payoff
          </h2>

          <p>
            The honest way to rank home improvement ideas is by how much each one changes your daily experience per hour and dollar spent, not by how impressive it looks on a listing. By that measure the winners are rarely glamorous. Sealing air leaks and caulking gaps stops conditioned air from escaping and keeps water out of walls. A programmable or learning thermostat trims heating and cooling when nobody is home. Fresh paint resets a room for the price of a weekend. These projects share a trait: they fix something you notice every day.
          </p>

          <p>
            Annual remodeling cost-versus-value surveys consistently show that smaller, exterior-facing and maintenance-driven projects recover a larger share of their cost at resale than big interior remodels do. Replacing an entry door or garage door tends to return more of its price than a custom kitchen. We will not quote percentages here because they shift every year and vary by region, but the pattern is stable enough to plan around: spend big where it protects the house, spend small where it improves how you live.
          </p>

          <p>
            Our ranking puts <strong>sealing and caulking</strong> first because it is the cheapest upgrade with the widest benefit, followed by <strong>lighting and paint</strong> for visible change, then <strong>smart thermostat and lock</strong> upgrades for comfort and security, then <strong>outdoor cleanup</strong> for curb appeal. The tools that make all of them possible, a decent drill and a level, sit underneath the list because every other project leans on them. If you can only do one thing this month, grab a caulk gun and a tube of good caulk and walk the house.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Upgrade idea</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What it changes</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Difficulty</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gear we'd start with</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Seal and caulk</td>
                    <td class="px-4 py-4 text-gray-700">Drafts, moisture, bugs</td>
                    <td class="px-4 py-4 text-gray-700">Easy</td>
                    <td class="px-4 py-4 text-gray-700">DAP Alex Plus caulk</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Smart thermostat</td>
                    <td class="px-4 py-4 text-gray-700">Heating and cooling schedule</td>
                    <td class="px-4 py-4 text-gray-700">Easy to moderate</td>
                    <td class="px-4 py-4 text-gray-700">Google Nest Learning Thermostat</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Smart lock</td>
                    <td class="px-4 py-4 text-gray-700">Keys, access, security</td>
                    <td class="px-4 py-4 text-gray-700">Easy</td>
                    <td class="px-4 py-4 text-gray-700">Yale Assure Lock 2</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
