---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Water Softener Systems",
    "url": "/best-water-softener-system/"
  },
  {
    "title": "Best Under Sink Water Filters",
    "url": "/best-under-sink-water-filter/"
  },
  {
    "title": "Best Countertop Water Filters",
    "url": "/best-countertop-water-filter/"
  },
  {
    "title": "Why Does My Water Smell Like Rotten Eggs",
    "url": "/why-does-my-water-smell-like-rotten-eggs/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best Water Test Kits in 2026: Strips, Well Kits and Certified Labs";
const description =
  "The best water test kits for city and well water, from 17-in-1 strips to certified mail-in lab panels, and which contaminants each type can actually detect.";

const PRODUCTS = [
  {
    "id": "tap-score-advanced-home-water-test",
    "name": "Tap Score Advanced Home Water Test Kit",
    "category": "Mail-In Lab Panel, 116 Analytes, Well or City",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "116 analytes, including lead, copper, other metals, minerals, hardness and alkalinity",
      "Samples go to EPA-certified drinking water labs, per the listing",
      "Works for both well and city water",
      "Report compares each result with health-based benchmarks rather than just a pass/fail line"
    ],
    "cons": [
      "PFAS is a separate Tap Score test, not part of this panel",
      "Costs many times more than a strip kit",
      "You must ship samples promptly, which rules out a Friday-night sample"
    ],
    "bottomLine": "The test to buy if you want one answer about your drinking water before spending money on a filter. Add the PFAS test only if you live near a known source.",
    "description": "Tap Score is the consumer brand of SimpleLab, which sells sampling kits and routes the samples to partner labs. The Advanced Home Water Test is its broad baseline panel: the Amazon listing puts it at 116 analytes, including lead, copper, hardness and alkalinity, analysed by EPA-certified drinking water labs, and it is sold for well or city water. You fill the supplied bottles, ship them back and get a report online that sets each result against health guidelines and explains what kind of treatment would address anything that is elevated. That last part is the real value, because it turns a list of numbers into a filter decision. The panel does not include PFAS, which Tap Score sells as a separate, more expensive test, so it is not the whole story for homes near military bases, airports or industrial sites. For most households on a well or an older city service line, though, it covers the contaminants that actually drive treatment choices."
  },
  {
    "id": "safe-home-ultimate-water-test-kit",
    "name": "Safe Home ULTIMATE Drinking Water Test Kit SH-UWT1",
    "category": "Mail-In Lab Panel, 200 Parameters",
    "badge": "Most Comprehensive",
    "amazonUrl": "#",
    "pros": [
      "Listed at 200 parameters, the broadest panel on this list",
      "Tested at Safe Home's EPA-certified laboratory, per the listing",
      "Covers metals, minerals, volatile organic compounds and physical properties",
      "A sensible choice before installing a whole-house system"
    ],
    "cons": [
      "The most expensive kit here",
      "More parameters does not mean more useful results for a typical city home",
      "Bacteria and PFAS coverage should be confirmed against the current listing before buying"
    ],
    "bottomLine": "Buy it when you need the widest net, such as a new well, a home near industry or before a large treatment purchase. Overkill for most city water.",
    "description": "Safe Home's ULTIMATE kit, model SH-UWT1, is the widest single panel we found sold on Amazon: the listing describes testing at Safe Home's EPA-certified laboratory for 200 parameters. Review coverage describes the bulk of those as volatile organic compounds, with metals, minerals and physical properties such as pH and hardness making up the rest. That breadth matters in specific cases: a newly drilled well, a property near a fuel spill, farmland or a manufacturing site, or a house where you are about to spend thousands on a whole-house treatment system and want to size it once. For a typical home on treated municipal water it is more test than you need, because your utility already monitors most of those organics and publishes the results. It costs several times what a targeted kit does, so match it to the risk rather than buying it for reassurance. Check the current listing for exactly which categories are included, as panel contents change over time."
  },
  {
    "id": "tap-score-lead-and-copper-water-test",
    "name": "Tap Score Lead & Copper in Water Test Kit",
    "category": "Mail-In Lab Test, Lead and Copper",
    "badge": "Best for Lead",
    "amazonUrl": "#",
    "pros": [
      "Lab analysis for lead and copper at a fraction of the cost of a full panel",
      "Sold for well or city water",
      "Full written report, per the listing",
      "The right test for an older home with possible lead solder or a lead service line"
    ],
    "cons": [
      "Covers only lead, copper and a basic water parameter or two",
      "Results depend on following the sampling instructions exactly"
    ],
    "bottomLine": "The cheapest honest answer to the lead question. Buy this instead of trusting a strip's lead pad.",
    "description": "If lead is your actual worry, this is the kit to buy. Tap Score's Lead & Copper test sends a sample from your tap to an EPA-certified lab and returns a full report, according to the listing, and it costs a fraction of the broad panels. Lab analysis matters here more than anywhere else, because the levels that matter for lead are in the low parts per billion, and that is precisely where strip pads and colour charts lose resolution. Copper comes along in the same analysis, which is useful because both metals leach from household plumbing, and high copper can point to corrosive water that is also pulling lead from older solder or fixtures. It is the right test for homes built before the 1986 federal ban on lead solder and pipes, homes with a known or suspected lead service line, and anyone feeding infant formula with tap water. It will not tell you anything about bacteria, nitrates or PFAS, so pair it with a well kit if you are on a private well."
  },
  {
    "id": "watersafe-ws425w-well-water-test-kit",
    "name": "Watersafe WS-425W Well Water Test Kit",
    "category": "DIY Reagent Kit, Bacteria, Lead, Nitrate, Pesticides",
    "badge": "Best DIY Well Kit",
    "amazonUrl": "#",
    "pros": [
      "Includes a coliform bacteria vial, the test well owners need most",
      "Lead test is designed to detect dissolved lead below the 15 ppb EPA action level",
      "Nitrate and nitrite strip read against the 10 ppm and 1 ppm EPA limits",
      "Also checks pesticides, iron, copper, pH, hardness and chlorine"
    ],
    "cons": [
      "Single-use: one test of each",
      "Bacteria result takes 48 hours and is presence or absence only",
      "Colour matching is a judgement call near the threshold"
    ],
    "bottomLine": "The best at-home kit for a quick well screen between annual lab tests. A positive result means call a certified lab, not pour bleach and hope.",
    "description": "The Watersafe WS-425W is a one-time kit built around the tests a private well needs. Inside are a bacteria vial for total coliform, a lead and pesticide packet, a nitrate and nitrite packet, a pH, hardness and chlorine packet, and packets for iron and copper. Watersafe states that the lead test detects dissolved lead below the EPA action level of 15 parts per billion, and the nitrate strip is read against the EPA limits of 10 ppm for nitrate and 1 ppm for nitrite. Most results take a few minutes; the bacteria vial incubates for 48 hours, and turns from purple to yellow if coliform bacteria are present. That makes it a good screen after flooding, a new pump or a change in taste or colour, and a reasonable annual check between full lab tests. It is still a screen: a positive bacteria or nitrate result should be confirmed by a state-certified lab before you treat or abandon the well, and a negative lead result tells you the level is below the action level, not that it is zero."
  },
  {
    "id": "varify-17-in-1-water-test-kit",
    "name": "Varify 17-in-1 Complete Water Test Kit",
    "category": "Test Strips, 100 Strips Plus 2 Bacteria Tests",
    "badge": "Best Test Strips",
    "amazonUrl": "#",
    "pros": [
      "100 strips, enough to test several taps or retest after installing a filter",
      "Includes two bacteria test kits",
      "Covers hardness, chlorine, iron, copper, fluoride, zinc, lead and more on one strip",
      "Results in a few minutes for a tiny cost per test"
    ],
    "cons": [
      "Lead and arsenic pads are screening tools, not quantitative measurements",
      "Colour reading varies with lighting and the person doing it",
      "Cannot detect PFAS, VOCs or most pesticides"
    ],
    "bottomLine": "Buy it to set a softener, check a filter is working or get a rough picture of hardness and chlorine. Do not use it to rule out lead.",
    "description": "Varify's 17-in-1 kit is a typical multi-pad strip kit done well: 100 strips and two bacteria test kits in one box, according to the listing, with pads for lead, chlorine, hardness, iron, fluoride, copper, zinc and other common parameters. Dip a strip, wait, and match each pad against the colour chart. Strips are genuinely useful for the parameters that come in big numbers and change in obvious steps: hardness for sizing or setting a water softener, free chlorine for deciding whether a carbon filter is worth it, iron for orange staining and pH for corrosion. With 100 strips you can test before and after a filter and keep testing every few months to know when a cartridge is spent. Where strips fall down is anything that matters at parts-per-billion levels. The lead pad can flag a high result, but it cannot tell 3 ppb from 12 ppb reliably, and no strip can detect PFAS or volatile organic compounds at all. Use it for the plumbing questions, and a lab for the health ones."
  },
  {
    "id": "hm-digital-tds-3",
    "name": "HM Digital TDS-3 Handheld TDS Meter",
    "category": "Digital TDS Meter, 0-9,990 ppm",
    "badge": "Best TDS Meter",
    "amazonUrl": "#",
    "pros": [
      "Rated 0 to 9,990 ppm range with 1 ppm resolution",
      "Listed readout accuracy of plus or minus 2%",
      "Reusable for years, ideal for checking reverse osmosis output",
      "Includes a carrying case"
    ],
    "cons": [
      "Measures only total dissolved solids, not what those solids are",
      "A low reading does not mean the water is safe",
      "Cannot detect lead, bacteria, PFAS or organics"
    ],
    "bottomLine": "The right tool for checking that a reverse osmosis system is still working. The wrong tool for deciding whether water is safe to drink.",
    "description": "The HM Digital TDS-3 is the meter most reverse osmosis owners end up with. HM Digital rates it for 0 to 9,990 ppm with 1 ppm resolution and plus or minus 2% readout accuracy, and it ships with a carrying case. It measures electrical conductivity and converts it to an estimate of total dissolved solids, which makes it fast and repeatable for one job: comparing tap water with filtered water. A healthy RO system typically removes the large majority of dissolved solids, so if your tap reads 300 ppm and the RO faucet reads 15, the membrane is working; if the RO reading creeps toward the tap reading, it is time for a membrane. What it cannot do is tell you what the dissolved solids are. Calcium and magnesium raise the number; lead, arsenic, PFAS and bacteria barely move it, if at all. Sellers who pair a TDS meter with a filter demo are exploiting that confusion. Buy it as a maintenance tool alongside an RO system, not as a safety test."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Water Test Kit",
          item: "https://www.thehonestreviewers.com/best-water-test-kit/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the most accurate home water test kit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A mail-in lab test is the most accurate option, because a laboratory measures contaminants with instruments and reports numbers with detection limits. The Tap Score Advanced panel and Safe Home ULTIMATE both send samples to EPA-certified labs, per their listings. Strips and reagent kits are screening tools: good for hardness, chlorine and pH, weak for lead at low levels, and blind to PFAS."
          }
        },
        {
          "@type": "Question",
          "name": "Can a water test kit detect lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some can, with limits. Strips with a lead pad give a rough screen, and the Watersafe WS-425W is designed to show whether dissolved lead is above the EPA's 15 ppb action level. Neither can measure low single-digit ppb levels reliably. For an actual lead number, use a lab test such as Tap Score's Lead & Copper kit with a first-draw sample."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I test well water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The CDC recommends at least once a year for total coliform bacteria, nitrates, total dissolved solids and pH. Test again after flooding, after work on the well or pump, if anyone in the house gets a stomach illness that might be waterborne, or when taste, smell or colour changes. Test once for arsenic, uranium and other local geology-driven contaminants."
          }
        },
        {
          "@type": "Question",
          "name": "Do water test strips detect bacteria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard strips do not. Bacteria testing needs a culture, where water sits in a growth medium for 24 to 48 hours and changes colour if coliforms are present. Kits like the Varify 17-in-1 and Watersafe WS-425W include separate bacteria vials for this. A positive at-home bacteria result should be confirmed by a certified lab before you disinfect."
          }
        },
        {
          "@type": "Question",
          "name": "Can I test for PFAS at home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not with a strip or reagent kit. PFAS limits are measured in parts per trillion, which requires laboratory mass spectrometry. Lab services such as Tap Score and Safe Home sell dedicated PFAS kits that you sample at home and mail in. Check your utility's water quality report first, because many larger systems now publish PFAS results."
          }
        },
        {
          "@type": "Question",
          "name": "Is a TDS meter a good water test?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only for one job. A TDS meter estimates dissolved minerals and is excellent for confirming a reverse osmosis membrane is still working. It cannot detect lead, bacteria, PFAS or pesticides, and a high reading often just means hard, mineral-rich water. Never buy a treatment system on the strength of a TDS reading alone."
          }
        },
        {
          "@type": "Question",
          "name": "Should I test city water if my utility already tests it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Read your utility's Consumer Confidence Report first. It covers the water leaving the plant and in the mains, not your house plumbing. If your home was built before 1986 or has a lead service line, test your own tap for lead and copper. Otherwise, strips for chlorine and hardness are usually enough to choose a filter."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "water test kit",
      "home water test kit",
      "drinking water test kit",
      "well water test kit",
      "water testing kit for lead",
      "lab water test"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Water Test Kits</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A strip kit tells you about hardness and chlorine in two minutes. It cannot tell you about PFAS, arsenic at the levels that matter, or lead below the action level. Here is which test answers which question, and the six kits worth buying.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#tap-score-advanced-home-water-test"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-it-detects" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Each Kit Detects</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 6 Best, Ranked</a>
          <a href="#strips-vs-lab" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Strips vs Lab Tests</a>
          <a href="#lead" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Testing for Lead</a>
          <a href="#well-water" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Well Water Testing</a>
          <a href="#city-water" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. City Water: Read the CCR First</a>
          <a href="#pfas" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. PFAS and What Strips Miss</a>
          <a href="#tds" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. What a TDS Meter Tells You</a>
          <a href="#certified-lab" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When to Pay for a Certified Lab</a>
          <a href="#after-results" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. What to Do With Results</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people buy a water test kit to answer one question: is the water from my tap safe to drink, and do I need a filter? A $20 pack of test strips can answer part of that question and a $300 lab panel can answer most of it, but the two are not interchangeable, and the cheap kit's blind spots are exactly the contaminants you most want to know about. This guide sorts the kits by what they can actually detect, so you buy the test that fits your water source and your worry, then buy a filter for the problem you found rather than the one you guessed.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-it-detects" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What Each Type of Water Test Kit Can Detect
          </h2>

          <p>
            There are four kinds of home water test, and the price gap between them reflects what they can see. Test strips are paper or plastic sticks with reagent pads that change colour. Reagent kits, like Watersafe's, use separate packets and vials for individual tests, including a bacteria culture that incubates for a day or two. Handheld meters measure one physical property, usually total dissolved solids. Mail-in lab tests ship your sample to a laboratory that uses instruments such as ICP-MS for metals and chromatography for organics, and they report numbers rather than colours.
          </p>

          <p>
            The useful way to think about it is resolution. Hardness is measured in the tens or hundreds of parts per million, and a colour pad can tell 50 ppm from 250 ppm without trouble. Lead matters at single-digit parts per billion, a thousand times smaller. PFAS matters at parts per trillion, a million times smaller. Colour chemistry that works fine for hardness has no hope at those levels, which is why every serious health question about drinking water ends at a lab.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Contaminant</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Test strips</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Reagent kit</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">TDS meter</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certified lab</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Hardness, pH, chlorine</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Iron, copper</td>
                    <td class="px-4 py-4 text-gray-700">Yes, rough</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Nitrate / nitrite</td>
                    <td class="px-4 py-4 text-gray-700">Yes, near limit</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Coliform bacteria</td>
                    <td class="px-4 py-4 text-gray-700">Add-on vial</td>
