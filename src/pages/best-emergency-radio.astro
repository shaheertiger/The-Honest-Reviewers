---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-charger-for-power-outages/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Solar Lanterns",
    "url": "/best-solar-lantern/"
  },
  {
    "title": "Best Battery Powered Lanterns",
    "url": "/best-battery-powered-lantern/"
  },
  {
    "title": "Best Carbon Monoxide Detectors",
    "url": "/best-carbon-monoxide-detector/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best Emergency Radios in 2026: Crank, Solar and NOAA Alerts That Work";
const description =
  "The best emergency radios and NOAA weather radios, with S.A.M.E. alerts explained, the real math on hand cranking and solar, and how much phone charge each holds.";

const PRODUCTS = [
  {
    "id": "midland-er310",
    "name": "Midland ER310 Emergency Crank Weather Radio",
    "category": "Portable, AM/FM/NOAA Alert, Crank, Solar, USB, 6x AA",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Four power sources: USB, solar, hand crank and six AA batteries",
      "2,600 mAh lithium-ion battery with USB output for phones",
      "Midland rates one minute of cranking at up to 9 minutes of radio",
      "NOAA alert mode with siren, flashing LED and display",
      "130-lumen flashlight with SOS strobe"
    ],
    "cons": [
      "Tone alert only, no S.A.M.E. county programming",
      "Phone charging is a partial top-up at best"
    ],
    "bottomLine": "The crank radio to buy for most households: a big battery, AA backup and the most useful published crank and solar figures.",
    "description": "The ER310 is the most complete portable emergency radio we can recommend, and the one on this list with the clearest manufacturer numbers. Midland fits a 2,600 mAh lithium-ion battery and lets you run the radio on six AA batteries instead, so it does not depend on the crank or the sun. Midland rates one minute of cranking at up to 9 minutes of radio, and one hour of optimal sunlight on the top panel at up to 45 minutes of radio. It receives AM, FM and all seven NOAA weather channels, and in alert mode it sits in standby and sounds a siren, flashes its LED and lights the display when a warning tone comes through. There is a 130-lumen flashlight with an SOS strobe, an ultrasonic dog whistle and a USB port to top up a phone. Two honest limits: the alert is tone-only with no S.A.M.E. county filter, and a full battery adds roughly a third to half of a modern phone charge. As the radio in the emergency kit, it is the best pick."
  },
  {
    "id": "eton-frx3-plus",
    "name": "Eton American Red Cross FRX3+ Weather Alert Radio",
    "category": "Portable, AM/FM/NOAA Alert, Crank, Solar, USB, AAA",
    "badge": "Best Compact Crank Radio",
    "amazonUrl": "#",
    "pros": [
      "2,600 mAh lithium battery per the FRX3+ manual",
      "Retailers list 15 to 20 minutes of radio per minute of cranking",
      "NOAA weather alert with LED flashlight and red beacon",
      "USB output for phone charging",
      "Supports the American Red Cross with each sale"
    ],
    "cons": [
      "AAA backup rather than AA",
      "Eton's 1.5 smartphone charges claim is optimistic for current phones",
      "No S.A.M.E. county programming"
    ],
    "bottomLine": "A smaller, lighter alternative to the ER310 with the best published crank figure, if you accept AAA backup.",
    "description": "The FRX3+ is Eton's American Red Cross-branded crank radio and the most popular alternative to the Midland. The FRX3+ manual lists a 3.7V, 2,600 mAh lithium battery, the same capacity as the ER310, and Eton lists a total USB charge time of 3 to 5 hours. It can also be powered by the hand turbine, the solar panel on top or AAA batteries. Retailers list one minute of cranking at 15 to 20 minutes of radio, the strongest crank claim on this list. It receives AM, FM and all seven NOAA weather channels, with an alert mode that switches on for weather warnings, plus an LED flashlight and a red flashing beacon. The USB output can top up a phone; Eton says 1.5 smartphone charges, which we would read as true for small or older phones and closer to a partial charge for current ones. The trade-offs against the ER310 are AAA backup instead of AA and no S.A.M.E. filter."
  },
  {
    "id": "midland-wr120b",
    "name": "Midland WR120B NOAA Weather Alert Radio with S.A.M.E.",
    "category": "Desktop, NOAA S.A.M.E. Alerts, AC with 3x AA Backup",
    "badge": "Best for Weather Alerts",
    "amazonUrl": "#",
    "pros": [
      "S.A.M.E. programming for up to 25 counties",
      "Choose which of 60-plus alert types will sound",
      "Runs on wall power with three AA batteries as outage backup",
      "Alarm clock and trilingual display"
    ],
    "cons": [
      "No crank, solar or AM/FM",
      "Not built to be carried in an emergency kit",
      "No phone charging"
    ],
    "bottomLine": "The radio to keep by the bed: it only wakes you for warnings in the counties you choose.",
    "description": "The WR120B is not a crank radio, and that is the point. It is a desktop NOAA weather alert radio built to sit plugged in every night and wake you for warnings, with three AA batteries keeping it running when the power fails. Its key feature is S.A.M.E.: you program up to 25 county codes, and the radio only sounds for warnings that name those counties, rather than every warning across a transmitter area that can cover a dozen. You can also choose which of its 60-plus alert types sound, so a winter weather advisory does not wake you while a tornado warning does. It doubles as an alarm clock and has a trilingual display. It has no crank, no solar panel, no AM or FM and no phone charging. That is why we recommend it alongside a portable crank radio rather than instead of one. In tornado country, it is the most important radio in the house."
  },
  {
    "id": "kaito-ka500",
    "name": "Kaito KA500 Voyager Solar/Crank AM/FM/SW/NOAA Weather Alert Radio",
    "category": "Portable, AM/FM/Shortwave/NOAA Alert, Crank, Solar, 3x AA",
    "badge": "Best for Shortwave",
    "amazonUrl": "#",
    "pros": [
      "Adds shortwave to AM, FM and seven NOAA channels with alert",
      "Five power options including three AA batteries",
      "Solar panel on a hinged flap you can angle toward the sun",
      "Replaceable rechargeable pack and a reading lamp",
      "This Amazon bundle includes an AC adapter and case"
    ],
    "cons": [
      "Small 600 mAh NiMH pack per retailer listings",
      "Too little stored energy to be a useful phone charger",
      "About 1.8 pounds, the heaviest portable here"
    ],
    "bottomLine": "Buy it for shortwave, AA backup and the best-aimed solar panel, not for phone charging.",
    "description": "The Kaito KA500 Voyager is the radio for listeners who want more than local news. It covers AM, FM and shortwave as well as the seven NOAA weather channels with alert, and it can be powered five ways: the hand crank, the solar panel, USB, an AC adapter, and three AA batteries. The solar panel sits on a hinged flap that tilts through about 180 degrees, so you can aim it at a low winter sun, and a reading lamp is built in behind it. Retailer listings describe the rechargeable pack as a 600 mAh three-cell NiMH, which is replaceable but small; owners commonly report that it is not enough to meaningfully charge a phone, and the crank needs steady turning to keep the radio going. Treat the KA500 as a capable multi-band radio with good battery backup rather than a power bank. The listing we link is the bundle with an AC adapter and storage case."
  },
  {
    "id": "fospower-a1",
    "name": "FosPower A1 NOAA Emergency Weather Radio (FOSPWB-2376)",
    "category": "Portable, AM/FM/NOAA, Crank, Solar, USB, AAA",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "2,000 mAh (7,400 mWh) lithium-ion power bank",
      "Solar, hand crank, USB and AAA battery power",
      "Flashlight, reading lamp and SOS alarm",
      "IPX3 splash resistance and a USB-C cable in the box"
    ],
    "cons": [
      "Smaller battery than the Midland and Eton",
      "Flashlight is a modest 20 lumens per Best Buy's listing",
      "Listings disagree on the AAA count; no S.A.M.E."
    ],
    "bottomLine": "A sound budget crank radio for a car or second kit; spend more for the ER310 as your main radio.",
    "description": "The FosPower A1 covers the basics at a lower price than the Midland or Eton. It receives AM, FM and NOAA weather, and FosPower lists a 2,000 mAh (7,400 mWh) lithium-ion battery that doubles as a small power bank. It can be charged by its solar panel, by hand crank or over USB, and it accepts AAA batteries as a backup, though retail listings disagree on how many. The manual asks for a steady 130 to 150 turns a minute on the crank without publishing a radio-minutes figure. You also get a flashlight (rated 1 W and 20 lumens on Best Buy's listing), a reading lamp under the solar panel, an SOS alarm and IPX3 splash resistance, and a USB-C cable is included. The smaller battery means less phone charge, roughly a third of a current phone at best. As a radio for the car, a second bedroom or a go-bag, it is good value; as the main household radio, the ER310 is worth the extra."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Emergency Radio",
          item: "https://www.thehonestreviewers.com/best-emergency-radio/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best emergency radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a portable crank radio, the Midland ER310: a 2,600 mAh battery, six-AA backup, NOAA alert, and Midland's published one-minute-crank-to-nine-minutes-of-radio figure. For overnight warnings, pair it with a S.A.M.E. desk radio like the Midland WR120B, which only sounds for the counties you program."
          }
        },
        {
          "@type": "Question",
          "name": "What is a S.A.M.E. weather radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "S.A.M.E. stands for Specific Area Message Encoding. NOAA alerts carry a digital code listing the counties affected, and a S.A.M.E. radio lets you enter your county's six-digit code so it only alarms for warnings that include you. Without it, a weather radio sounds for every warning across a transmitter's whole coverage area."
          }
        },
        {
          "@type": "Question",
          "name": "How long do you have to crank an emergency radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On Midland's figures for the ER310, one minute of cranking gives up to 9 minutes of radio; retailers list Eton's FRX3+ at 15 to 20 minutes. Those are best-case numbers. Plan on several minutes of steady cranking for each hour of listening, and use stored batteries or USB charging first."
          }
        },
        {
          "@type": "Question",
          "name": "Can a hand crank radio charge a phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, from its internal battery, but not much. A full 2,600 mAh radio battery can add roughly a third to half of a modern phone charge, then the radio is empty. Cranking directly into a phone yields only seconds of charge per minute. A separate power bank is the real phone solution."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a NOAA weather radio if I have a phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth having. Phones receive Wireless Emergency Alerts, but cell networks fail or get overloaded in major storms, and phones on silent or out of battery miss alerts. A plugged-in NOAA radio with battery backup works with no cell network and will sound even at 3 a.m."
          }
        },
        {
          "@type": "Question",
          "name": "Which batteries are best for an emergency radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AA, if the radio accepts them. AA cells hold about twice the energy of AAA and are the size most households already stock. The Midland ER310 takes six AA, the Kaito KA500 three AA, and the WR120B uses three AA as outage backup. Store them sealed beside the radio rather than inside it."
          }
        },
        {
          "@type": "Question",
          "name": "How do I test my weather radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the radio's test or weather button to confirm it receives your local NOAA channel, then listen for the routine weekly test your local National Weather Service office broadcasts, typically on a Wednesday around late morning; the office lists its schedule. If a S.A.M.E. radio responds to that test, it is programmed and working."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "emergency radio",
      "hand crank radio",
      "weather radio",
      "solar crank radio",
      "noaa weather radio",
      "emergency weather radio"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Emergency Radios</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          When the power and the cell network go down together, a radio is how you hear what is coming. Here are the five worth owning, and the honest numbers on cranking, solar and phone charging.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#midland-er310"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="10.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-it-does" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What It Has to Do</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#noaa-same" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. NOAA and S.A.M.E. Alerts</a>
          <a href="#crank" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Hand Crank Reality</a>
          <a href="#solar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Solar Panels on Radios</a>
          <a href="#batteries" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Battery Backup</a>
          <a href="#phone-charging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Phone Charging Capacity</a>
          <a href="#bands" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Bands and Reception</a>
          <a href="#two-radio" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. The Two-Radio Setup</a>
          <a href="#outage-kit" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. In an Outage Kit</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          An emergency radio has two jobs: wake you up when the National Weather Service issues a warning for your county, and keep you informed for days after the power goes out. Most hand crank radios do the second job well and the first one poorly, because few of them can be programmed for your county. The best setup for most households is two radios, not one, and it costs less than a single premium model.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-it-does" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What an Emergency Radio Actually Has to Do
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Why Phones Are Not Enough</h3>

          <p>
            Cell phones are the first thing people reach for in a storm, and they are also the first thing to fail. Towers lose power, backup batteries at the tower run down, and the networks that survive get overloaded as everyone calls at once. Broadcast radio does not have those problems. A single AM, FM or NOAA weather transmitter can reach everyone in a wide area with no network to congest, and a radio needs only a tiny amount of power to receive it.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Three Jobs, in Order</h3>

          <p>
            That gives an emergency radio three jobs, in order of importance. First, receive the NOAA Weather Radio broadcasts and ideally sound an alarm when a warning is issued. Second, receive local AM and FM news, which is where evacuation orders, shelter locations and boil-water notices are announced after the storm passes. Third, keep running for days without the grid, from a crank, a solar panel, replaceable batteries or all three.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Everything Else Is a Bonus</h3>

          <p>
            Everything else on the box, the flashlight, the phone charger, the SOS siren, the reading lamp, is a bonus. Some of those extras are genuinely useful and some are marketing. A 130-lumen flashlight on a radio you are already carrying is handy. A phone charger that can add a third of a charge is worth having. But do not choose a radio for its extras if it does the first two jobs badly.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Alert Radio vs Carry Radio</h3>

          <p>
            The radio that wakes you at 3 a.m. for a tornado warning and the radio you carry to the basement are often not the same device. Desk-style weather alert radios are built for the first job and have no crank. Hand crank radios are built for the second and third jobs and usually have weak alert features. Understanding that split is the key to buying well, and it is why our list includes both kinds.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The 5 Best Emergency Radios, Ranked
          </h2>

          <p>
            We compared emergency and weather radios from Midland, Eton (the American Red Cross line), Kaito and FosPower on NOAA weather band coverage and alert behavior, S.A.M.E. county programming, the number of ways to power them, internal battery capacity, replaceable battery backup, published crank and solar figures, and phone-charging output. Every number below is the manufacturer's rating or a retailer spec sheet; phone-charge estimates are arithmetic from the battery size, not our own measurements. Where sources disagreed on a spec, we say so or leave it out.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
