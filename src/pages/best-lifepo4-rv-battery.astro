---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How to Charge a Portable Power Station with Solar",
    "url": "/how-to-charge-a-portable-power-station-with-solar/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator?",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  },
  {
    "title": "How Long Do Portable Power Stations Last?",
    "url": "/how-long-do-portable-power-stations-last/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best LiFePO4 RV Batteries in 2026: Lithium House Batteries Ranked";
const description =
  "The best LiFePO4 RV batteries in 2026, from Battle Born to LiTime, with real cost-per-cycle math, cold-charging advice and how to size a house bank.";

const PRODUCTS = [
  {
    "id": "battle-born-bb10012",
    "name": "Battle Born 100Ah 12V LiFePO4 Deep Cycle Battery",
    "category": "12V 100Ah LiFePO4, 100A BMS, Group 27/31 Size",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "The most proven drop-in RV lithium battery, with years of owner history in trailers and motorhomes",
      "10-year warranty, with the first 8 years covered by repair or replacement",
      "BMS protects against cold charging, overcharge, deep discharge and short circuit",
      "Reno-based support team that will talk through converter and alternator setups",
      "Heated kit version available for owners who charge below freezing"
    ],
    "cons": [
      "Costs well over double a budget 100Ah battery with the same rated capacity",
      "Standard model has no Bluetooth, so you need a shunt monitor to see state of charge"
    ],
    "bottomLine": "The battery to buy when you want the longest track record and the best support, and are willing to pay for both.",
    "description": "Battle Born is the name most RV owners hear first, and for good reason: the BB10012 has been the default drop-in lithium house battery for years, and the owner record is long enough that its failure modes are well understood. It is a 12V, 100Ah LiFePO4 battery in a Group 27/31-sized case, weighing about 31 pounds, which makes it a direct replacement for the 60-plus-pound lead-acid battery most trailers ship with. The internal battery management system handles the protections that matter in an RV: it stops charging when the cells are too cold, cuts off before the cells are over-discharged, and disconnects on a short circuit. It is rated for 100A continuous, which is enough for a 1,000W inverter on a single battery, and Battle Born recommends pairing batteries for anything bigger. What you pay extra for is the warranty and the people. The 10-year warranty covers the first eight years with repair or replacement, and the company's technicians are known for helping owners work out whether an older converter, a stock alternator or a solar controller will charge lithium correctly. The standard battery has no Bluetooth, so plan on a shunt-based monitor such as a Victron SmartShunt if you want an accurate state-of-charge reading. If you camp where nights fall below freezing and you charge in the morning, look at the heated kit, which adds an internal heater with a switch so the cells can warm before charging. For a full-time rig or anyone who wants to buy once and stop thinking about it, this is still the safest choice."
  },
  {
    "id": "sok-12v-100ah-heated-bluetooth",
    "name": "SOK 12V 100Ah LiFePO4 Battery with Bluetooth and Built-in Heater",
    "category": "12V 100Ah LiFePO4, Self-Heating, Bluetooth, Serviceable Case",
    "badge": "Best for Cold-Weather Camping",
    "amazonUrl": "#",
    "pros": [
      "Built-in heater rated to allow charging down to about -4F",
      "Bluetooth monitoring of voltage, current, temperature and cell balance",
      "Serviceable design with prismatic cells you can inspect, a rarity in this class",
      "7-year warranty at a mid-range price",
      "About 27 pounds, lighter than most premium 100Ah batteries"
    ],
    "cons": [
      "The Bluetooth app is a generic BMS app, not a polished branded one",
      "Published charge and discharge current ratings vary between retailers, so check the current spec sheet"
    ],
    "bottomLine": "The best mix of cold-weather capability, monitoring and price for owners who camp in the shoulder seasons.",
    "description": "SOK has built a loyal following among DIY RV and van builders because its batteries are designed to be opened and serviced, and because the price sits comfortably between budget imports and Battle Born. The SK12V100H is the version most RV owners should look at: it adds a built-in heater and Bluetooth to the standard 12V 100Ah LiFePO4 pack. The heater is the headline. LiFePO4 cells must not be charged below freezing, and SOK rates this battery to accept charge down to about -4F by warming the cells first, using current from your charger, solar controller or DC-DC charger. That turns a cold morning from a no-charge event into a short delay. The Bluetooth BMS reports voltage, current, temperature and individual cell voltages, which is far more useful than a four-LED gauge when you are trying to tell whether a bank is healthy or a cell is drifting. The battery weighs about 27 pounds and carries a 7-year warranty. The serviceable construction matters more than it sounds: if a BMS fails years from now, a battery built this way can be repaired rather than recycled. The main complaint owners raise is the app, which is a generic BMS interface rather than a polished branded one, and retailers list slightly different current ratings, so read the spec sheet for the exact SKU you buy before you size an inverter around it. For a trailer that sees October and March trips in cold country, it is the most capable battery here for the money."
  },
  {
    "id": "epoch-12v-100ah-heated-bluetooth",
    "name": "Epoch 12V 100Ah Heated and Bluetooth LiFePO4 Battery",
    "category": "12V 100Ah LiFePO4, Self-Heating, Bluetooth, IP67",
    "badge": "Best Premium Alternative",
    "amazonUrl": "#",
    "pros": [
      "Internal heater lets the battery charge in sub-freezing weather",
      "Bluetooth app for iOS and Android with state of charge, current and temperature",
      "Listed with a 120A continuous BMS and a 200A short-term rating",
      "IP67 rating, useful for an exposed tongue-mounted battery box",
      "Epoch's heated lineup carries long warranties, with up to 11 years on some models"
    ],
    "cons": [
      "Warranty length differs across Epoch models, so confirm the term on the exact SKU",
      "Priced closer to premium brands than to budget imports"
    ],
    "bottomLine": "A premium-feeling heated, connected battery for less than Battle Born, with a little more BMS headroom.",
    "description": "Epoch has become a popular choice for owners who want premium features without the top-tier price, and its 12V 100Ah heated and Bluetooth battery is the model that fits most RVs. It is a LiFePO4 pack with an internal heater, a Bluetooth BMS and an IP67 rating, and retailers list its BMS at 120A continuous with 200A available for 30 seconds. That extra headroom over the common 100A rating is helpful if you run a 1,000W to 1,200W inverter from a single battery, because a coffee maker or microwave can push current right up against a 100A limit. The heater warms the cells before they accept charge, so a battery mounted in an unheated front compartment or a tongue box can still take solar or alternator charge on a cold morning. The Bluetooth app reports state of charge, current flow and temperature on iOS and Android, which is enough to see what the fridge and furnace fan are really costing you overnight. Epoch's heated batteries carry long warranties, up to 11 years on some models, but terms differ between the 100Ah, the Group 24 105Ah and the non-heated Eco line, so confirm the warranty on the exact model before you buy. The IP67 rating is a genuine advantage if your battery lives on the A-frame, where road spray and rain reach it. It is not the cheapest heated battery you can buy, but the BMS rating and build quality justify the step up from budget brands for a rig you use every month."
  },
  {
    "id": "renogy-pro-12v-100ah-self-heating",
    "name": "Renogy Pro 12V 100Ah Smart LiFePO4 Battery (Self-Heating, Bluetooth)",
    "category": "12V 100Ah LiFePO4, Self-Heating, Bluetooth",
    "badge": "Best for a Renogy Solar System",
    "amazonUrl": "#",
    "pros": [
      "Self-heating and Bluetooth in one battery",
      "Integrates with Renogy's app alongside its solar charge controllers and DC-DC chargers",
      "7-year warranty",
      "Widely stocked, including at big-box retailers, which makes replacements and returns easy",
      "Low-temperature charge protection on top of the heater"
    ],
    "cons": [
      "Renogy's lineup and model names change often, so make sure you are buying the self-heating Bluetooth version",
      "The app is at its best only if the rest of your system is Renogy too"
    ],
    "bottomLine": "The easy choice if your solar controller and DC-DC charger are already Renogy and you want one app for the whole system.",
    "description": "Renogy sells more RV solar kits than almost anyone, and its Pro 12V 100Ah smart LiFePO4 battery is built to slot into those systems. This version combines self-heating with Bluetooth monitoring, which covers the two features cold-weather campers most often wish they had bought. The heater warms the cells before charging when temperatures drop near freezing, and the BMS still blocks charging if the pack is too cold, so a solar panel on a frosty morning will not damage the cells. The Bluetooth connection shows state of charge, voltage, current and temperature in the Renogy app, and the real advantage appears when your charge controller and DC-DC charger are also Renogy: the app shows solar input, alternator charging and battery state together, so you can see at a glance whether the roof panels are keeping up with the fridge. Renogy backs the battery with a 7-year warranty, and because it is stocked widely, including at big-box retailers, swapping a bad unit is usually straightforward. The caution is naming. Renogy sells several 100Ah batteries, including the compact Core Mini, a self-heating Core Mini variant and the Pro smart battery, and they do not all include both Bluetooth and heating. Check the listing carefully. If you are building a system from scratch and like the idea of one ecosystem for panels, controller, charger and battery, it is a sensible, well-supported pick. If you already run Victron gear, there is less reason to choose it over SOK or Epoch."
  },
  {
    "id": "litime-12v-100ah-self-heating",
    "name": "LiTime 12V 100Ah Self-Heating LiFePO4 Battery",
    "category": "12V 100Ah LiFePO4, Self-Heating, 100A BMS",
    "badge": "Best Budget Heated Battery",
    "amazonUrl": "#",
    "pros": [
      "One of the least expensive self-heating 100Ah batteries from an established brand",
      "Rated for 4,000 cycles at 100% depth of discharge",
      "100A BMS with low-temperature charge protection",
      "5-year warranty",
      "Bluetooth versions available in LiTime's lineup if you want app monitoring"
    ],
    "cons": [
      "Support is mostly by email and online, not a phone line with RV-specific technicians",
      "Bluetooth and heating are split across different SKUs, so read the listing"
    ],
    "bottomLine": "The value pick for a weekend trailer that sometimes sees frost: real heating and a decent BMS for much less money.",
    "description": "LiTime, formerly sold as Ampere Time, is one of the brands that pushed 100Ah LiFePO4 prices down to where an upgrade from lead-acid no longer needs a long justification. Its self-heating 12V 100Ah battery is the model most RV owners should consider, because it adds the one feature budget batteries usually skip. The heater warms the cells when the battery is cold and a charge source is connected, and the BMS blocks charging below freezing until the cells are warm enough. LiTime rates the battery for 4,000 cycles at full depth of discharge and backs it with a 5-year warranty. The BMS is rated for 100A continuous, which comfortably runs a 1,000W inverter at modest loads, and two batteries in parallel handle a 2,000W inverter. Weight is in the low-to-mid 20-pound range depending on the exact version. The compromises are the usual ones at this price. Support is online rather than through a technician who knows RV converters, and the product line is wide enough that Bluetooth, heating and size options are spread across different listings, so match the SKU to what you want. Owners commonly report solid capacity and few early failures, which matches what we would expect from cells at this grade. For a family that camps on long weekends from spring to fall and wants to stop babying a lead-acid battery, it is excellent value. For a full-time rig in a cold climate, the longer warranty and support of SOK, Epoch or Battle Born are worth the extra money."
  },
  {
    "id": "redodo-12v-100ah-bluetooth",
    "name": "Redodo 12V 100Ah Bluetooth LiFePO4 Battery",
    "category": "12V 100Ah LiFePO4, Bluetooth, 100A BMS",
    "badge": "Best Budget Bluetooth",
    "amazonUrl": "#",
    "pros": [
      "Among the cheapest ways to get Bluetooth monitoring on a 100Ah LiFePO4 battery",
      "100A BMS with low-temperature protection",
      "5-year warranty",
      "Self-heating and Group 31 versions available if you need them",
      "Light enough to lift into a front compartment with one hand"
    ],
    "cons": [
      "The standard Bluetooth model has no heater, so it cannot charge below freezing",
      "Budget brand: less long-term owner history than Battle Born or SOK"
    ],
    "bottomLine": "A good-value battery with app monitoring for warm-weather campers who want to see their state of charge on a phone.",
    "description": "Redodo sits in the same budget tier as LiTime and is built to the same basic recipe: a 12V 100Ah LiFePO4 pack, a 100A BMS, and a price that makes the jump from lead-acid easy. The Bluetooth version is the one to buy, because it solves a common budget-lithium problem. LiFePO4 voltage stays almost flat from 90% down to 20%, so the voltmeter on an RV's monitor panel tells you almost nothing about how full a lithium battery is. The Redodo app reports state of charge, current and temperature, which is enough to know whether you can run the furnace fan overnight without a shunt monitor. The BMS includes low-temperature protection that blocks charging below freezing, but the standard Bluetooth model has no heater, so in cold weather it will simply refuse to charge until it warms up. If you camp in frost, Redodo sells a self-heating version, and a Group 31 version as well. The warranty is 5 years. Owners commonly report good capacity and easy installation, and the light case is genuinely handy in a cramped front compartment. The honest drawback is history: Redodo has not been in the RV market as long as Battle Born or SOK, so the decade-long reliability record does not exist yet. That is less of a concern at this price, because you could replace the battery once and still spend less than a premium unit. For a summer and fall camper who wants app monitoring without paying for it twice, this is a good buy."
  },
  {
    "id": "renogy-core-mini-12v-100ah",
    "name": "Renogy Core Mini 12V 100Ah LiFePO4 Battery",
    "category": "12V 100Ah LiFePO4, Group 22NF Size, 100A BMS",
    "badge": "Best Compact Battery",
    "amazonUrl": "#",
    "pros": [
      "Group 22NF footprint, much smaller than a typical Group 27 or 31 RV battery",
      "Fits tight battery boxes and under-seat compartments where full-size 100Ah batteries do not",
      "Low-temperature charging cut-off",
      "Can be paralleled to build a larger bank in a compact space",
      "Self-heating DuoHeat version available"
    ],
    "cons": [
      "The base model has no Bluetooth or heater",
      "Compact cases leave less room for heat to dissipate during sustained high-current use"
    ],
    "bottomLine": "Buy it when space, not money, is the constraint: a full 100Ah in a battery box sized for something smaller.",
    "description": "Not every RV has room for a full-size battery. Teardrops, small travel trailers and truck campers often have a battery box or under-bench space sized for a small lead-acid battery, and the Renogy Core Mini is the answer for those rigs. It packs a full 12V 100Ah of LiFePO4 into a Group 22NF case, which Renogy describes as its smallest 100Ah battery, and that means two of them can fit where a single Group 31 lead-acid battery used to sit. The BMS handles the standard protections and includes a low-temperature cut-off that stops charging in freezing weather. The base model skips Bluetooth and heating to hit its size and price, so you will want a shunt monitor to see state of charge accurately, and if you camp in the cold, Renogy sells a DuoHeat self-heating version of the Core Mini. Its 100A rating handles a modest inverter on one battery, and pairing two in parallel gives you 200Ah and enough current for a 2,000W inverter in roughly the footprint of one large battery. The one engineering caution with any very compact battery is heat during sustained high-current loads, so do not box it in tightly next to an inverter. For anyone whose problem is a small battery tray rather than a small budget, it is the most practical way to get a full 100Ah of lithium on board. If you have room for a standard Group 24 or 27 battery, the heated and connected picks above give you more for similar money."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best LiFePO4 RV Battery",
          item: "https://www.thehonestreviewers.com/best-lifepo4-rv-battery/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best RV battery overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most owners, a 12V 100Ah LiFePO4 battery is the best RV house battery. Battle Born has the longest track record and best support, SOK and Epoch offer heating and Bluetooth for less, and LiTime and Redodo are the value picks. Choose based on how cold you camp and whether you want app monitoring, since capacity is nearly identical."
          }
        },
        {
          "@type": "Question",
          "name": "Can I just swap my RV's lead-acid battery for lithium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Physically, yes, but check your charging sources first. Confirm the converter has a lithium setting or replace it, add a DC-DC charger if you charge from the tow vehicle's alternator, and set your solar controller to its LiFePO4 profile. The battery will run your 12V systems immediately; the charging setup decides whether it fills fully."
          }
        },
        {
          "@type": "Question",
          "name": "How many lithium batteries do I need for boondocking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most couples who boondock for a weekend with a 12V fridge, lights, a water pump and phones do well with 200Ah, which means two 100Ah batteries. Add a furnace on cold nights or Starlink and 300Ah is more comfortable. Full-timers usually run 400Ah or more with a substantial solar array to recharge it."
          }
        },
        {
          "@type": "Question",
          "name": "Do LiFePO4 RV batteries work in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They discharge fine down to roughly -4F, so the furnace can run all night, but they must not be charged below freezing. The BMS blocks cold charging to protect the cells. A self-heating battery warms itself using charge current before accepting a charge, and mounting batteries inside the heated coach is the best winter solution."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a vented battery box for a lithium battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Venting is required for lead-acid batteries, which release hydrogen while charging. LiFePO4 batteries do not vent gas in normal operation. A battery box for a trailer still matters for physical protection, keeping water and road debris off the terminals and holding the battery firmly, so use a strap and a lid that covers the terminals."
          }
        },
        {
          "@type": "Question",
          "name": "Is a heated lithium battery worth the extra money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you charge in freezing temperatures. If you camp from late spring to early fall, a standard battery with low-temperature cut-off is fine. If you camp in the shoulder seasons or keep solar charging a stored trailer through winter, a heater avoids days of blocked charging. For true winter camping, move the bank inside instead."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a LiFePO4 RV battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most are rated for 3,000 to 5,000 cycles at deep discharge, and calendar life commonly runs 10 years or more with sensible care. A weekend camper uses well under 100 cycles a year, so capacity loss is rarely the limit. In practice, physical damage, a failed BMS or charging below freezing are what end most batteries early."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Fitness & Outdoor Gear",
    tags: [
      "best rv battery",
      "lifepo4 rv battery",
      "best lithium battery for rv",
      "battery box for trailer",
      "rv house battery",
      "12v 100ah lithium battery"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best LiFePO4 <span class="text-[#38BDF8]">RV Battery</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven 12V 100Ah lithium house batteries for trailers, campers and motorhomes, picked on BMS rating, cold-weather charging, monitoring, warranty and what you actually pay per cycle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#battle-born-bb10012"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Size Your Bank
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our Top Picks</a>
          <a href="#lithium-vs-agm" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Lithium vs AGM Cost</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Sizing a Battery Bank</a>
          <a href="#cold-weather" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Cold-Weather Charging</a>
          <a href="#bms-bluetooth" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. BMS and Bluetooth</a>
