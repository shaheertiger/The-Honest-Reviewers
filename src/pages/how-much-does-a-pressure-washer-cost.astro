const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Much Does a Pressure Washer Cost",
          item: "https://www.thehonestreviewers.com/how-much-does-a-pressure-washer-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is a good pressure washer for the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners, a mid-range electric machine around 2,000 PSI and 1.2 to 1.5 GPM gives the best balance of price and capability. It handles cars, decks, siding and average driveways without the noise and upkeep of gas. If you have a large concrete area or heavy grime, a homeowner gas machine is the better value."
          }
        },
        {
          "@type": "Question",
          "name": "Is a cheap electric pressure washer worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For light, occasional work, yes. A budget electric machine will clean cars, furniture and small patios well enough. It will be slow on concrete and may not last as long, since cheaper pumps and motors are often not repairable. If you plan to use it often, spending a bit more usually saves money over time."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to rent a pressure washer for a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typically roughly $75 to $120 or more for a full day for a homeowner-grade gas machine at a home improvement store or rental center, with lower half-day rates and higher rates for commercial units. Surface cleaners and other attachments are often extra. Prices vary by region and change over time, so check locally."
          }
        },
        {
          "@type": "Question",
          "name": "Do gas pressure washers cost more to maintain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Gas engines need oil changes, spark plugs, air filters and fuel stabilizer, and carburetor problems after storage are common. Electric machines need very little routine maintenance beyond flushing and winterizing. Over several years, the gap in upkeep cost is modest in dollars but noticeable in time and hassle."
          }
        },
        {
          "@type": "Question",
          "name": "How much should I pay to have my house pressure washed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many companies quote house washing by size and number of stories, and a one-story home commonly runs somewhere around $250 to $500, with two-story homes higher. Mildew treatment, access and region all move the price. Get at least two or three written quotes that specify the method, chemicals and plant protection."
          }
        },
        {
          "@type": "Question",
          "name": "Is it worth buying a pressure washer versus hiring someone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you would hire a pro more than once a year for jobs you can safely do yourself, such as a driveway or deck, buying typically pays off within a season or two. For two-story siding, roofs or delicate surfaces, hiring is often the better choice because of the risk of injury and surface damage."
          }
        },
        {
          "@type": "Question",
          "name": "Are cordless pressure washers worth the price?",
