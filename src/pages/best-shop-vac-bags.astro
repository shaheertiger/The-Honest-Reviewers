  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Shop Vac Bags",
          item: "https://www.thehonestreviewers.com/best-shop-vac-bags/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Are shop vac bags universal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Each brand designs its bag collar around its own inlet, and sizes overlap without matching. A RIDGID Size A bag, a Shop-Vac Type J and a DEWALT DXVA19-4102 are not interchangeable even where the gallon ranges overlap. Some aftermarket bags claim universal fit with stretchy collars, but those are the ones most likely to leak or slip off the inlet."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a filter if I use a bag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The bag catches debris before the cartridge, but the cartridge still filters the air before it reaches the motor. Running a bag without a cartridge sends anything that passes the bag into the motor and out the exhaust. Keep the cartridge in for all dry pickup, and remove both for wet pickup."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use shop vac bags for water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every bag on this list is labelled for dry pickup only or carries no wet rating. Paper bags soak through and split, and synthetic bags hold water until they pull off the inlet. Remove the bag and the pleated cartridge before wet pickup, fit the foam sleeve if your model uses one, and dry the drum before refitting."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between high efficiency and HEPA shop vac bags?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-efficiency bags are sold for fine dust like drywall and sanding dust. HEPA bags are sold as capturing ultra-fine dust and are the step up for silica or allergens. Neither RIDGID nor Shop-Vac publishes a micron rating for these bags, so treat HEPA as the higher grade rather than a certified figure."
          }
        },
        {
          "@type": "Question",
          "name": "How often should you change a shop vac bag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Change it when suction drops noticeably, not when it looks full. On drywall sanding that can be a single large room, because fine dust loads the media quickly. On sawdust, a bag may last several sessions. Never empty and reuse a disposable bag; the collar flap and seams are not built for it."
          }
        },
        {
          "@type": "Question",
          "name": "Do shop vac bags reduce suction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Slightly, compared with a clean cartridge alone, because air passes through an extra layer. In practice they usually improve suction across a job, because they keep the cartridge from blinding. On fine dust, a bagged vac holds its suction far longer than a bagless one, which loses airflow quickly as the pleats load."
          }
        },
        {
          "@type": "Question",
          "name": "Are cheap third-party shop vac bags any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some are fine for coarse, low-stakes work like sawdust. The risk is the collar: universal or loose collars leak or slip off when the bag gets heavy, which sends dust straight to the cartridge. For drywall, concrete or ash, buy the genuine part for your model so the fit is known."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
