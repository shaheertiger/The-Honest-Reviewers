const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best Shop Vac Bags in 2026: Matched to Your Drum Size and Brand";
const description =
  "The best shop vac bags for RIDGID, Shop-Vac, Craftsman, DEWALT and Vacmaster drums, with high efficiency vs HEPA explained and the jobs that justify a bag.";

