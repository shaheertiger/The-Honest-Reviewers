import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Ice Melt for Concrete", url: "/best-ice-melt-for-concrete/" },
    { title: "Best Penetrating Concrete Sealer", url: "/best-penetrating-concrete-sealer/" },
    { title: "Sealing Old Concrete", url: "/sealing-old-concrete/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "How to Prevent Concrete Spalling in Winter";
const description =
  "Spalling is water freezing inside the slab, accelerated by deicing salt. The sealer type, the deicer choice and the drainage fixes that actually stop it.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Prevent Concrete Spalling in Winter", item: "https://www.thehonestreviewers.com/how-to-prevent-concrete-spalling-in-winter/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What causes concrete to spall in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Water absorbed into the concrete's pore structure freezes and expands by roughly nine percent, and the pressure fractures the surface layer from within. Deicing salts make it far worse, not by chemically dissolving the concrete but by drawing more moisture in and by driving many more freeze-thaw cycles across the surface each winter than temperature alone would produce." },
        },
        {
          "@type": "Question",
          name: "Does rock salt damage concrete?",
          acceptedAnswer: { "@type": "Answer", text: "Indirectly, and severely. Sodium chloride does not attack cured cement paste chemically the way some deicers do, but it dramatically increases the number of freeze-thaw cycles the surface goes through and increases how much water the slab holds. On concrete less than a year old, on any slab without air entrainment, or on an unsealed surface, that is enough to cause visible scaling within a season or two." },
        },
        {
          "@type": "Question",
          name: "What is the safest ice melt for concrete?",
          acceptedAnswer: { "@type": "Answer", text: "Calcium magnesium acetate is generally the gentlest on concrete, followed by sand used purely for traction with no melting action at all. Magnesium chloride and calcium chloride melt at lower temperatures than rock salt but should be used sparingly. Ammonium sulphate and ammonium nitrate fertilisers must never be used as deicers — they chemically attack cement paste." },
        },
        {
          "@type": "Question",
          name: "Will sealing concrete prevent spalling?",
          acceptedAnswer: { "@type": "Answer", text: "A penetrating silane or siloxane sealer is the single most effective preventive measure, because it lines the pore structure and stops water and dissolved salt being absorbed while still letting the slab breathe. Film-forming acrylic sealers look good but can trap moisture beneath the film in a freeze-thaw climate, which sometimes makes spalling worse rather than better." },
        },
        {
          "@type": "Question",
          name: "Can you seal concrete in cold weather?",
          acceptedAnswer: { "@type": "Answer", text: "Only within the temperature window on the product, which for most sealers means above about 10°C for application and cure, with no freezing expected for at least 24 to 48 hours afterwards. Late summer and early autumn are the sensible times. Sealing a cold, damp slab in November generally produces a poor bond and a coating that fails in its first winter." },
        },
        {
          "@type": "Question",
          name: "How long should new concrete cure before winter?",
          acceptedAnswer: { "@type": "Answer", text: "Give a new slab at least 28 days of cure before it sees freeze-thaw cycling, and ideally a full month more before any deicer touches it — many contractors advise no deicing salt at all through the first winter. Young concrete has not developed its full strength or its final pore structure, and it is dramatically more vulnerable to salt-accelerated scaling than a mature slab." },
        },
        {
          "@type": "Question",
          name: "Can spalled concrete be repaired?",
          acceptedAnswer: { "@type": "Answer", text: "Shallow surface scaling can be resurfaced with a polymer-modified overlay after the loose material is removed and the surface properly prepared. Deeper spalling that exposes aggregate or reinforcement needs patching with a bonding agent and a repair mortar, and widespread deep damage usually means replacement is the better value. Repairs fail quickly if the underlying water problem is not fixed first." },
        },
        {
          "@type": "Question",
          name: "Does air-entrained concrete prevent spalling?",
          acceptedAnswer: { "@type": "Answer", text: "It is the main reason exterior concrete survives freeze-thaw climates. Air entrainment disperses microscopic air bubbles through the mix that give freezing water somewhere to expand into, relieving internal pressure. If you are pouring new exterior concrete anywhere that freezes, specifying an air-entrained mix is the most important durability decision you make, and it cannot be added afterwards." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
