---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Espresso Machines",
    "url": "/best-espresso-machine/"
  },
  {
    "title": "Best Water Filter Pitchers",
    "url": "/best-water-filter-pitcher/"
  },
  {
    "title": "Best Under Sink Water Filters",
    "url": "/best-under-sink-water-filter/"
  },
  {
    "title": "Best Electric Kettles",
    "url": "/best-electric-kettle/"
  },
  {
    "title": "Best Rice Cookers",
    "url": "/best-rice-cooker/"
  },
  {
    "title": "Best Dishwashers",
    "url": "/best-dishwasher/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Countertop Ice Makers: Nugget, Bullet and Clear Ice Picks";
const description =
  "The best countertop ice makers for nugget, bullet and clear ice, compared on daily output, bin size, cleaning and noise, from a budget bullet unit to the GE Opal.";

const PRODUCTS = [
  {
    "id": "ge-profile-opal-2-ultra",
    "name": "GE Profile Opal 2.0 Ultra Nugget Ice Maker",
    "badge": "Best Overall",
    "category": "Nugget Ice, Wi-Fi, Scale-Inhibiting Filter",
    "amazonUrl": "#",
    "description": "The Opal 2.0 Ultra is the countertop nugget ice maker we would buy if the budget allows, because it pairs the highest rated output in the Opal line with a scale-inhibiting filter that addresses the machine's biggest long-term weakness. Abt lists 38 lb of ice per day measured at 70°F ambient and 60°F water, with a footnote giving 32 lb per day at 90°F ambient and 70°F water per DOE testing, plus a 3 lb storage bin. Retailers describe built-in Wi-Fi for scheduling ice production, maintenance alerts and software updates through GE's SmartHQ app. Side-tank versions (XPIO13 series) add a water reservoir to the side and measure about 13.4 in wide versus 10.5 in for the standard XPIO23. Pricing swings with rebates: Abt showed the stainless model at $398 after a manufacturer rebate against a $629 regular price, and Walmart listed $449.",
