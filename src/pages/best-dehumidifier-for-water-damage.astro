---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Dehumidifiers With a Pump",
    "url": "/best-dehumidifier-with-pump/"
  },
  {
    "title": "Best Garage Dehumidifiers",
    "url": "/best-dehumidifier-for-garage/"
  },
  {
    "title": "How to Get Rid of Mold in a Basement",
    "url": "/how-to-get-rid-of-mold-in-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "7 Best Dehumidifiers for Water Damage in 2026: LGR Picks and Rent-or-Buy";
const description =
  "The best LGR dehumidifiers for drying out after leaks and floods, from Dri-Eaz, AlorAir, Phoenix, BlueDri and Abestorm, with pro sizing and rent-or-buy advice.";

const PRODUCTS = [
  {
    "id": "alorair-storm-lgr-extreme-dehumidifier",
    "name": "AlorAir Storm LGR Extreme 85 PPD (AHAM) LGR Dehumidifier with Pump",
    "category": "LGR, 85 PPD AHAM / 180 PPD Saturation, Built-In Pump",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Restoration-style LGR unit at a price close to a big household portable",
      "85 pints per day at AHAM and 180 at saturation, per listings",
      "Built-in pump and a compact rotomolded body that stacks and carries",
      "5.62 amps on 115 volts, so two can share a 15 amp circuit with care"
    ],
    "cons": [
      "Weight listed at 64 to 70.5 pounds depending on source",
      "Loud and industrial for a living space during a long dry-out"
    ],
    "bottomLine": "The dehumidifier most homeowners should buy for water damage: true LGR performance, a pump and a rugged body for less than a few days of renting pro gear.",
    "description": "The Storm LGR Extreme is AlorAir's compact restoration dehumidifier, and it is the best balance of capability and price for a homeowner drying out after a leak. Listings rate it at 85 pints per day at AHAM conditions (80°F and 60% relative humidity) and 180 pints at saturation (90°F and 90%), which is the kind of air a freshly flooded basement produces. It is a low grain refrigerant design, so it keeps pulling water as the room dries, rather than tailing off the way a household unit does. AlorAir's spec sheet lists a functioning range of 33.8°F to 104°F, 210 CFM of airflow, an energy factor of 2.44 liters per kWh and 5.62 amps on 115 volts. The built-in pump is how restoration crews run it: point the hose at a sink, a sump or out a window and leave it. The rotomolded body is designed to be carried, stacked and knocked around, with weight listed at about 64 to 70.5 pounds. Wi-Fi versions are available. Retailers have listed it from roughly $780 to $970, which is less than many people pay to rent comparable gear for a long week."
  },
  {
    "id": "dri-eaz-revolution-lgr-dehumidifier",
    "name": "Dri-Eaz Revolution LGR Dehumidifier (F413)",
    "category": "LGR, 80 PPD AHAM, 6.2 Amps, Built-In Pump, 65 lb",
    "badge": "Best Pro Compact",
    "amazonUrl": "#",
    "pros": [
      "Dri-Eaz is a restoration industry standard; parts and service are widespread",
      "80 pints per day at AHAM with only 6.2 amps of draw, per the manual",
      "Compact 12.5 x 17.6 x 21.5 inch body at about 65 pounds",
      "The same model Home Depot rents as its compact Dri-Eaz unit"
    ],
    "cons": [
      "Priced like professional equipment, roughly $2,700 to $3,700 depending on seller",
      "Warranty terms differ by seller"
    ],
    "bottomLine": "The pro-grade compact LGR to buy if you own rental property, do repeat restoration work or want the exact unit the pros use; otherwise rent it.",
    "description": "Dri-Eaz builds equipment for water damage restoration companies, and the Revolution is its compact LGR dehumidifier, the model you are most likely to find on a restoration truck or at a rental counter. Home Depot's tool rental lists a compact Dri-Eaz F413, the Revolution's model number. Dri-Eaz rates it at 80 pints per day at AHAM conditions, and the manual lists a current draw of 6.2 amps at those conditions, low enough to run two units and an air mover on separate outlets of an ordinary home without drama. Listings give 139 pints at 90°F and 90% relative humidity. The body is unusually small for its output, about 12.5 by 17.6 by 21.5 inches and 65 pounds with cord and hose, with a handle for carrying it up basement stairs. It has a built-in condensate pump and a long drain hose, and the humidistat sets from 30% to 90% in 5% steps. Airflow is listed at about 121 to 180 CFM depending on fan speed, and the listed operating range is 33°F to 100°F. The price is the obstacle: sellers list it from roughly $2,700 to well over $3,500, which only makes sense for repeat use."
  },
  {
    "id": "dri-eaz-lgr-3500i",
    "name": "Dri-Eaz LGR 3500i Commercial Dehumidifier with Pump (F411)",
    "category": "LGR, 170 PPD AHAM / 240 PPD Saturation, 400 CFM",
    "badge": "Best for Large Losses",
    "amazonUrl": "#",
    "pros": [
      "170 pints per day at AHAM and 240 at saturation, per listings",
      "400 CFM of airflow, the most in this guide",
      "One machine can replace two compact units on a whole-basement loss",
      "Built-in pump and a cabinet designed to roll through doorways"
    ],
    "cons": [
      "About 157 to 165 pounds and over 10 amps",
      "Roughly $4,000 to $4,500 new, so most homeowners should rent one"
    ],
    "bottomLine": "The unit for a whole flooded basement or a large commercial loss, where one high-capacity machine is simpler than three small ones; buy it only if you do this for a living.",
    "description": "The LGR 3500i is Dri-Eaz's large-capacity LGR dehumidifier, built for big water losses such as a finished basement that took several inches of water or a commercial space after a sprinkler discharge. Listings rate it at 170 pints per day at AHAM conditions and 240 pints at saturation, with 400 CFM of airflow, roughly double the AHAM capacity of the compact units in this guide. That capacity comes with size: the cabinet is listed at about 157 to 165 pounds and roughly 44 to 48.5 inches tall, on wheels, and current draw is listed at about 10.5 to 11.2 amps on 115 volts. On a home's 15 amp circuits, give it a circuit to itself and run air movers elsewhere. It has a built-in pump with a long drain hose, and one retailer lists an operating range of 33°F to 100°F. The 3500i is an industry workhorse, which is good news for buyers: used units from restoration fleets appear regularly, and dealers stock parts. New, it runs roughly $4,000 to $4,500 from mainstream sellers. For a one-off flood, the sizing section below shows when two compact units do the same job, and the rental section explains why renting one is often the better call."
  },
  {
    "id": "phoenix-drymax-xl-lgr",
    "name": "Phoenix DryMAX XL LGR Dehumidifier (4037000)",
    "category": "LGR, 125 PPD AHAM, 7.7 Amps, 300 CFM, 88 lb",
    "badge": "Most Portable High Capacity",
    "amazonUrl": "#",
    "pros": [
      "125 pints per day at AHAM in a body about 16 x 17.5 x 24 inches",
      "Spec sheet lists 7.7 amps and 300 CFM",
      "Listed operating range of 33°F to 110°F",
      "One Amazon listing mentions Bluetooth for sending readings to an app"
    ],
    "cons": [
      "Roughly $3,300 to $3,500, pro-equipment pricing",
      "Weight listed at 83 to 88 pounds depending on source"
    ],
    "bottomLine": "A restoration pro's pick when high capacity has to fit in a car trunk and go down narrow stairs; hard to justify for a single household flood.",
    "description": "Phoenix is Therma-Stor's restoration brand, and the DryMAX XL is its attempt to put large-dehumidifier capacity into a compact, rotomolded body. The manufacturer's spec sheet lists 125 pints per day at AHAM conditions, 300 CFM of airflow and a current draw of 7.7 amps, from a unit about 16 inches wide, 17.5 inches tall and 24 inches deep. That is the same AHAM capacity as the much larger AlorAir Storm Elite and the Storm SLGR 1250X in a smaller box, which matters when you are carrying it down basement stairs or loading it into a car. Weight is listed at 88 pounds on the manufacturer-derived listing and 83 pounds on some resellers. The operating range is listed at 33°F to 110°F, it uses R-410A refrigerant and a 12 by 14 inch MERV 10 filter, and one Amazon listing describes built-in Bluetooth for sending psychrometric readings to an app, which restoration crews use for job documentation. Confirm on the listing whether a pump and hose are included in the configuration you buy. Retailers list it at roughly $3,300 to $3,500, so like the Dri-Eaz units, it makes most sense for people who dry buildings regularly."
  },
  {
    "id": "alorair-storm-slgr-1250x",
    "name": "AlorAir Storm SLGR 1250X 125 PPD (AHAM) LGR Dehumidifier with Pump",
    "category": "LGR, 125 PPD AHAM / 264 PPD Saturation, 300 CFM",
    "badge": "Best High-Capacity Value",
    "amazonUrl": "#",
    "pros": [
      "125 pints per day at AHAM and 264 at saturation, per listings",
      "300 CFM and a listed operating range of 33.8°F to 110°F",
      "Built-in pump with a 19.6-foot hose",
      "Roughly a third of the price of comparable Dri-Eaz and Phoenix capacity"
    ],
    "cons": [
      "Listed at about 81.6 pounds",
      "Some listings are Wi-Fi and some are not, under very similar names"
    ],
    "bottomLine": "The way to get pro-level capacity for a whole-basement flood without paying pro-brand prices; check that the listing is the variant you want.",
    "description": "The Storm SLGR 1250X is AlorAir's high-capacity rotomolded LGR unit, and it delivers the AHAM capacity of the Phoenix DryMAX XL for a fraction of the price. Listings rate it at 125 pints per day at AHAM conditions and 264 pints at saturation, with 300 CFM of airflow and an operating range of 33.8°F to 110°F. The built-in pump feeds a 19.6-foot hose, auto defrost keeps it working in a cool basement, and the noise rating is listed at 60 dBA. Listings give dimensions of about 26.1 by 15.5 by 17.6 inches and a weight of 81.6 pounds, so it is a two-handed lift but compact for its output, and it is ETL safety listed according to AlorAir. Listings disagree on a few details: some variants are labelled no Wi-Fi and others include app control, and the name appears as both SLGR 1250X and LGR 1250X. The closely related non-X LGR 1250 has been listed at Home Depot for under $1,000 and on AlorAir's own site at about $1,377, so expect roughly $1,000 to $1,400. For a large flooded basement, one of these replaces two compact units on the sizing chart."
  },
  {
    "id": "bluedri-dh76-lgr",
    "name": "BlueDri DH76 150 PPD Compact LGR Commercial Dehumidifier",
    "category": "LGR, 76 PPD AHAM / 150 PPD Saturation, Stackable",
    "badge": "Best Stackable",
    "amazonUrl": "#",
    "pros": [
      "76 pints per day at AHAM and 150 at saturation, per listings",
      "Amazon listing says it stacks up to four high for storage and transport",
      "About 66 pounds per BlueDri's parent company Lasko",
      "Listing includes a 25-foot drain hose"
    ],
    "cons": [
      "Listings disagree on weight and dimensions",
      "Amazon listing gives about 715 watts, less efficient than the AlorAir LGR units"
    ],
    "bottomLine": "A good choice if you want two or three compact LGR units to spread across several wet rooms and stack in a garage afterwards.",
    "description": "BlueDri, sold by fan maker Lasko, makes restoration gear aimed at smaller contractors and serious homeowners, and the DH76 is its compact LGR dehumidifier. Listings rate it at 76 pints per day at AHAM conditions and 150 pints at saturation. Its design point is the shape: the Amazon listing says the units stack up to four high, which makes them easy to store in a garage and easy to move several at once, and that suits the way water damage is usually dried, with one unit per wet room rather than one big machine. Lasko's listing gives a weight of about 66 pounds and dimensions of roughly 20 by 23 by 12 inches, though a review spec block lists heavier figures for the related BD-76, so check the listing. The Amazon listing includes a 25-foot drain hose, an upper temperature rating of 105°F and about 715 watts. A 2023 review recorded it at $999 on Amazon, and current prices are in that area. It is less efficient on paper than the AlorAir Storm LGR Extreme, which is rated higher on AHAM pints for less money, so buy the DH76 if stacking and BlueDri's dealer network matter to you."
  },
  {
    "id": "abestorm-lgr85",
    "name": "Abestorm Hurricane LGR85 180 PPD LGR Dehumidifier with Pump",
    "category": "LGR, 85 PPD AHAM / 180 PPD Saturation, 14.7 ft Pump Lift",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "85 pints per day at AHAM and 180 at saturation, per Abestorm",
      "Abestorm lists a 14.7-foot pump lift and 19.6-foot hose",
      "58 pounds, the lightest unit in this guide",
      "5-year warranty and a listed noise level of 58 dBA"
    ],
    "cons": [
      "Some listings split the warranty into shorter full coverage and longer refrigeration-only coverage",
      "Abestorm does not list amp draw on its product page"
    ],
    "bottomLine": "The cheapest way into a real LGR dehumidifier with a pump: Storm LGR Extreme capacity in a lighter body for a few hundred dollars less.",
    "description": "Abestorm's Hurricane LGR85 is a compact LGR unit that matches the AlorAir Storm LGR Extreme on paper for less money. Abestorm's own product page rates it at 85 pints per day at AHAM conditions and 180 pints at saturation, with 210 CFM of airflow, an operating range of 33.8°F to 104°F and coverage marketed at up to 2,300 square feet. The built-in pump is described as lifting water up to 14.7 feet vertically through a 19.6-foot hose. At 58 pounds and about 22.8 by 13.7 by 17.3 inches, it is the lightest unit in this guide, which matters when one person is carrying it into a flooded basement. Abestorm lists a noise level of 58 dBA and a 5-year warranty, though one Amazon listing breaks that down into one year of parts and labor, three years on the refrigeration system and five years of refrigeration parts only. Amazon listings give slightly higher weights of about 62 to 64 pounds, and a Wi-Fi version weighs more. Abestorm does not publish an amp figure on the product page. Abestorm's site has listed it at about $600 to $800, which makes it the budget pick for a homeowner who wants to own an LGR unit."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dehumidifier for Water Damage",
          item: "https://www.thehonestreviewers.com/best-dehumidifier-for-water-damage/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What kind of dehumidifier is best for water damage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A low grain refrigerant (LGR) dehumidifier with a built-in pump. LGR units keep removing water as the air dries, which a household unit does not, and the pump lets them run unattended. Compact models such as the AlorAir Storm LGR Extreme and Abestorm Hurricane LGR85 suit a room or two; larger losses need the Dri-Eaz LGR 3500i or several units."
          }
        },
        {
          "@type": "Question",
          "name": "How long should I run a dehumidifier after water damage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Until the wet materials are as dry as unaffected materials elsewhere in the house, measured with a moisture meter. For a typical clean-water loss with enough dehumidifiers and air movers, that usually takes three to five days. Dense materials, cool rooms and jobs that started late take longer. Do not stop when the surface feels dry."
          }
        },
        {
          "@type": "Question",
          "name": "Can a dehumidifier dry wet carpet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It helps, but it cannot do it alone. Extract water first with a wet vac or carpet extractor, then use air movers across or under the carpet to evaporate what remains, while the dehumidifier removes that moisture from the air. Carpet pad is often replaced rather than dried, and carpet soaked by sewage or floodwater is usually discarded."
          }
        },
        {
          "@type": "Question",
          "name": "How many dehumidifiers do I need for water damage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Restorers use the IICRC method: calculate the room's cubic feet and divide by a factor for the class of water. For LGR units the factor is 50 for a typical Class 2 loss. A 2,400 cubic foot room needs about 48 AHAM pints, one compact unit. A 9,600 cubic foot basement needs about 192 pints, two or three units."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to rent or buy a water damage dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a single small leak, renting is often cheaper. Rental guides put LGR units around $85 to $300 a day, and a dry-out takes three to five days, often with air movers on top. A budget LGR unit costs roughly $600 to $1,000, so buying makes sense if you expect to use it again or want it as a basement dehumidifier afterwards."
          }
        },
        {
          "@type": "Question",
          "name": "What does grain depression mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Grain depression is the difference between the moisture content of air entering a dehumidifier and air leaving it, measured in grains of water per pound of dry air. A higher figure means the unit is removing more water from each pass. Restoration technicians track it to confirm a dehumidifier is working and to decide when a room is nearly dry."
          }
        },
        {
          "@type": "Question",
          "name": "How soon after a leak will mold grow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EPA guidance says to dry water-damaged areas and items within 24 to 48 hours to prevent mold growth. That is why fast extraction and properly sized drying equipment matter more than the brand of dehumidifier. If materials have been wet longer, or mold is already visible over a large area, consider professional restoration and remediation."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "dehumidifier for water damage",
      "dehumidifier for carpet drying",
      "dehumidifier for wet carpet",
      "best water restoration dehumidifier",
      "water damage dehumidifier",
      "lgr dehumidifier",
      "restoration dehumidifier",
      "flood dehumidifier"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
