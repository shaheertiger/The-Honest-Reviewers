    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "best kerosene heater",
      "best kerosene heater for indoor use",
      "best indoor kerosene heater",
      "kerosene heater",
      "best small kerosene heater for indoor use",
      "best kerosene heater for garage",
      "best forced air kerosene heater"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
