import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";

const title = "7 Best Oil Stain Removers for Concrete in 2026: Tested on Old & Fresh Stains";
const description =
  "We tested 10+ degreasers, enzyme cleaners, and poultice absorbents on real driveway and garage floor oil stains — from fresh drips to years-old set-in grease. Here are the 7 that actually lift oil out of concrete.";

