  },
  {
    id: "purple-power-industrial",
    name: "Purple Power Industrial Strength Cleaner/Degreaser",
    category: "Industrial Alkaline Degreaser",
    badge: "Best Industrial Strength",
    amazonUrl: "https://www.amazon.com/s?k=Purple+Power+Industrial+Strength+Cleaner%2FDegreaser",
    rating: 4.6,
    reviewCount: 21000,
    pros: [
