import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Prepare Concrete for Epoxy", url: "/how-to-prepare-concrete-for-epoxy/" },
    { title: "Hot Tire Pickup on Epoxy Garage Floors", url: "/hot-tire-pickup-epoxy-garage-floor/" },
    { title: "Best Garage Floor Epoxy", url: "/best-garage-floor-epoxy/" },
    { title: "Epoxy Over Existing Epoxy?", url: "/can-you-apply-epoxy-over-existing-epoxy/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "Why Your Epoxy Garage Floor Is Peeling (and How to Fix It)";
const description =
  "Epoxy garage floors peel for nine reasons and surface prep tops the list. Read the failure pattern, patch or strip and recoat, and pick a system that stays put.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Epoxy Garage Floor Peeling", item: "https://www.thehonestreviewers.com/epoxy-garage-floor-peeling/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why is my epoxy garage floor peeling?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In most cases the concrete was not prepared properly. Epoxy needs an open, clean, profiled surface to bond to, and smooth or sealed concrete, leftover laitance, oil or old paint all stop it from getting a grip. The next most common causes are moisture coming up through the slab and hot tires softening a thin coating.",
          },
        },
        {
          "@type": "Question",
          name: "Can you epoxy over peeling epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not over the loose parts. Anything that lifts must come off, and the surrounding coating must be sanded and tested for adhesion before you recoat. Applying new epoxy over a failing layer just means the new layer peels along with the old one.",
          },
        },
        {
          "@type": "Question",
          name: "How do I fix peeling epoxy without redoing the whole floor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If less than about a fifth of the floor has failed and the rest passes a tape and knife test, scrape off the loose material, sand the edges to a feather, clean with solvent, spot-prime the bare concrete and recoat the patch. Expect a visible repair on solid colours; flake floors hide it well.",
          },
        },
        {
          "@type": "Question",
          name: "Does moisture cause epoxy to peel?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and it is the hardest cause to fix. Water vapour moving up through the slab builds pressure under a non-breathable coating and lifts it, often as blisters or sheets along edges and control joints. A moisture test before coating, and a moisture-tolerant primer if the result is high, prevents it.",
          },
        },
        {
          "@type": "Question",
          name: "Why did my epoxy peel only where the tires sit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "That is hot tire pickup. Tires come off the road hot and soften a thin or under-cured coating; as they cool and contract they pull the coating off with them. It mostly affects one-part epoxy paints and low-solids water-based kits and is prevented with a thicker system and a proper topcoat.",
          },
        },
        {
          "@type": "Question",
          name: "How long after epoxy can I park on it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Walk on it after 24 hours, move light items after 48 to 72 hours, and keep vehicles off for a full 5 to 7 days at normal temperatures. Cold garages can double those times. Parking early is a common trigger for peeling because the coating has not built full hardness or adhesion yet.",
          },
        },
        {
          "@type": "Question",
          name: "Do I have to grind the concrete before epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Grinding is the most reliable preparation and the one professionals use. Acid etching works on porous, unsealed concrete if it is done thoroughly and rinsed completely, but it does nothing on sealed or densified slabs and leaves residue if rushed. If water beads on your floor rather than soaking in, etching alone will not be enough.",
          },
        },
        {
          "@type": "Question",
          name: "Is polyaspartic less likely to peel than epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not by itself. Polyaspartic resists hot tire pickup, UV yellowing and abrasion better than epoxy, but it bonds to concrete the same way and fails the same way on poor prep or a wet slab. The best systems use an epoxy or moisture-tolerant primer under a polyaspartic or polyurethane topcoat.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
