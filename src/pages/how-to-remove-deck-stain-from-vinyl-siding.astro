---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Prep a Deck for Staining", url: "/how-to-prep-a-deck-for-staining/" },
    { title: "How to Pressure Wash Vinyl Siding", url: "/how-to-pressure-wash-vinyl-siding/" },
    { title: "How to Stain a Deck", url: "/how-to-stain-a-deck/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "How to Remove Deck Stain From Vinyl Siding";
const description =
  "What actually lifts deck stain off vinyl, which solvents melt it instead, and the escalation order that stops you making a small mark into a permanent one.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Remove Deck Stain From Vinyl Siding",
          item: "https://www.thehonestreviewers.com/how-to-remove-deck-stain-from-vinyl-siding/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do you remove deck stain from vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Work up in strength rather than starting strong. Fresh water-based stain comes off with warm soapy water and a soft cloth. Fresh oil-based stain needs mineral spirits on a rag, followed by a wash. Cured stain usually responds to mineral spirits with dwell time, then a citrus or vinyl-safe cleaner, and finally to careful use of a melamine sponge. Always test in a hidden spot first.",
          },
        },
        {
          "@type": "Question",
          name: "Will mineral spirits damage vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Used briefly and rinsed off, mineral spirits are generally safe on vinyl and are the standard first solvent for oil-based stain. What they can do is strip the chalky oxidised layer from older siding, leaving a patch that looks cleaner and slightly different from the panel around it. Feather the area outward and expect to wash the whole panel afterwards.",
          },
        },
        {
          "@type": "Question",
          name: "What should you never use on vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Acetone, lacquer thinner, MEK, chlorinated solvents, paint or deck stripper, and abrasive pads or wire brushes. Those solvents soften and dissolve PVC itself, producing a dull, permanently etched patch that no cleaning will fix. Paint strippers do the same and can also craze the surface. Nothing on the siding is worth that trade.",
          },
        },
        {
          "@type": "Question",
          name: "How do you get dried deck stain off siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Soften it rather than scrub it. Lay a mineral-spirits-dampened cloth over the mark for five to ten minutes so the solvent has time to work, then wipe with light pressure and repeat. Several gentle cycles remove more than one aggressive attempt, and they do it without dulling the surface.",
          },
        },
        {
          "@type": "Question",
          name: "Can you pressure wash deck stain off vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It rarely removes cured stain, and at close range it drives water behind the panels and can crack older siding. If you use a washer at all, keep it under about 1,500 psi with a wide tip, work from at least three feet back, and spray downward or level rather than upward under the laps.",
          },
        },
        {
          "@type": "Question",
          name: "Does a Magic Eraser work on stain marks on siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, yes — a melamine sponge lifts residual staining that solvents leave behind. It is a fine abrasive rather than a chemical, so it also removes some surface sheen. Use it damp, with light pressure, only on the mark itself, and check the result from a few steps back in daylight before continuing.",
          },
        },
        {
          "@type": "Question",
          name: "What if the stain will not come off at all?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Replacing the affected panel is easier and cheaper than most people expect. Vinyl siding unlocks with a zip tool for a few dollars, panels are sold individually, and a single course can usually be swapped in under an hour. On older sun-faded siding, a replacement panel may not match exactly, so take a piece to the supplier.",
          },
        },
        {
          "@type": "Question",
          name: "How do you keep stain off the siding in the first place?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mask the bottom two or three courses with plastic sheeting and tape before you open a can, use a brush rather than a sprayer within two feet of the wall, and keep a rag and a bottle of mineral spirits in your pocket while you work. Wiping a splash within a minute makes it a non-event; finding it the next morning makes it a project.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Stone & Wood Sealers",
    tags: [
      "remove deck stain from vinyl siding",
      "stain on siding",
      "vinyl siding cleaning",
      "deck staining",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Deck Staining Guide",
    link: "/how-to-stain-a-deck/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Repair
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Removing Deck Stain From <span class="text-[#38BDF8]">Vinyl Siding</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The stain is removable. The damage from the wrong solvent is not — so the order you try things in matters more than what you try.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#escalation"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            Start With Step One
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#first" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Before You Touch It</a>
          <a href="#fresh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Stain That Is Still Wet</a>
          <a href="#escalation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Escalation Order</a>
          <a href="#never" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Will Ruin the Siding</a>
          <a href="#oxidation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The Clean-Patch Problem</a>
          <a href="#by-type" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Oil vs Water-Based Stain</a>
          <a href="#last-resort" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When Nothing Works</a>
          <a href="#prevention" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Not Doing This Again</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Vinyl siding is PVC, and the solvents that dissolve deck stain fastest also dissolve PVC. That is the entire problem in one sentence, and it is why the strong stuff under the sink is the wrong place to start.
        </p>

        <div id="first" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Before You Touch It
          </h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Find a hidden test area.</strong> Behind a downspout, under the deck, low on a side wall. Every product below gets tested there first and left ten minutes before you judge it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Work in shade, on a cool surface.</strong> Warm vinyl is softer and marks more easily, and solvents flash off before they have done anything useful.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Check what the stain was.</strong> The can tells you whether it is oil or water-based, and that determines which solvent has any chance of working.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Protect what is below.</strong> Solvent-loaded stain running down onto planting, decking or a patio creates a second problem. Sheet it off and wet the plants.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Accept it may take several passes.</strong> Three gentle cycles remove more than one hard one, and only the gentle ones leave the surface intact.</span>
            </li>
          </ul>

          <p>
            The instinct with a fresh mark is to attack it. Resist that for ninety seconds and read the next section instead, because the single most common way a splash becomes permanent is someone reaching for the strongest solvent in the garage.
          </p>
        </div>

        <div id="fresh" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Stain That Is Still Wet
          </h2>

          <p>
            If you have caught it within minutes, this is barely a job at all. Blot rather than wipe first — wiping spreads a drip into a smear three times the size — then clean.
          </p>

          <p>
            <strong>Water-based stain:</strong> warm water with a little dish soap and a soft cloth. It will come off completely, and there is no need for anything stronger.
          </p>

          <p>
            <strong>Oil-based stain:</strong> a rag lightly dampened with mineral spirits, working from the outside of the mark inward, then a soap-and-water wash to remove the solvent residue. Again, entirely routine while it is wet.
          </p>

          <p>
            This is why anyone staining a deck within a few feet of a wall should keep a rag and a small bottle of mineral spirits in a pocket for the whole job. The difference between wiping a splash immediately and finding it dry the next morning is roughly the difference between thirty seconds and an afternoon.
          </p>
        </div>

        <div id="escalation" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Escalation Order for Dried Stain
          </h2>

          <p>
            Start at step one even if you are confident it will not work. Each step is gentler than the one after it, and the goal is to remove the stain with the mildest thing that will do it.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Step</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Try</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Method</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1</td>
                    <td class="px-4 py-4 text-gray-700">Hot soapy water</td>
                    <td class="px-4 py-4 text-gray-700">Soft cloth, several minutes of patient rubbing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2</td>
                    <td class="px-4 py-4 text-gray-700">Household vinyl siding cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Spray, dwell per label, soft brush, rinse</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">3</td>
                    <td class="px-4 py-4 text-gray-700">Mineral spirits</td>
                    <td class="px-4 py-4 text-gray-700">Damp cloth laid over the mark 5–10 min, then wipe</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">4</td>
                    <td class="px-4 py-4 text-gray-700">Citrus or vinyl-safe adhesive remover</td>
                    <td class="px-4 py-4 text-gray-700">Test first; short dwell, wipe, wash off immediately</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">5</td>
                    <td class="px-4 py-4 text-gray-700">Melamine sponge</td>
                    <td class="px-4 py-4 text-gray-700">Damp, light pressure, on the mark only</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">6</td>
                    <td class="px-4 py-4 text-gray-700">Replace the panel</td>
                    <td class="px-4 py-4 text-gray-700">Zip tool, one course, under an hour</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Step three is where most dried stain actually comes off, and the trick there is dwell time rather than pressure. Lay a mineral-spirits-dampened cloth over the mark and leave it — five to ten minutes lets the solvent soften the stain film so it wipes away, instead of you grinding at a hard film with a dry-ish rag.
          </p>

          <p>
            Step five works better than its reputation suggests but is genuinely abrasive. A melamine sponge removes stain and a little of the siding's surface sheen with it, so use it damp, use light pressure, keep to the mark itself, and step back to look at the result in daylight before doing any more.
          </p>
        </div>

        <div id="never" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Will Ruin the Siding
          </h2>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-3">Never Use These on Vinyl</p>
            <p class="text-xl font-bold text-white mb-3">Acetone. Lacquer thinner. MEK. Chlorinated solvents. Paint or deck stripper. Wire brushes and abrasive pads.</p>
            <p class="text-gray-300 leading-relaxed m-0">These do not clean vinyl, they dissolve it. The result is a dull, softened, permanently etched patch — a mark that is far more obvious than the stain splash you started with, and one that only a replacement panel will fix.</p>
          </div>

          <p>
            Nail polish remover belongs on that list too, since it is mostly acetone. So does brake cleaner, which people reach for surprisingly often. And any deck stripper is doubly bad news: it is designed to break down exactly the kind of coating vinyl's surface is, and it will craze the panel while it works.
          </p>

          <p>
            The mechanical versions are just as final. A wire brush, a scouring pad or a stiff bristle brush leave a scuffed patch that catches the light from every angle. Once the surface gloss is gone from vinyl, there is no polishing it back.
          </p>
        </div>

        <div id="oxidation" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. The Clean-Patch Problem
          </h2>

          <p>
            Here is the thing that surprises people who do everything right. Older vinyl carries a chalky oxidised layer plus years of accumulated grime, and the solvent that removes your stain also removes that. You end up with a stain-free patch that is visibly cleaner and brighter than the panel around it.
          </p>

          <p>
            The fix is to widen the cleaning rather than to keep working the spot. Wash the whole panel, then the whole wall, with a vinyl siding cleaner so everything matches again. Feathering outward from the treated area as you go avoids a hard edge where the clean zone stops.
          </p>

          <p>
            It is worth planning for this before you start. If the wall is due a wash anyway, doing the stain removal first and the wall wash immediately afterwards turns a two-stage problem into one afternoon. Our guide to <a href="/how-to-pressure-wash-vinyl-siding/">pressure washing vinyl siding</a> covers doing that part without forcing water behind the panels.
          </p>
        </div>

        <div id="by-type" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Oil-Based vs Water-Based Stain
          </h2>

          <p>
            <strong>Water-based stains</strong> are easier while wet and can be surprisingly stubborn once cured, because the acrylic binder forms a genuine film on the siding. Hot soapy water and patience handle most of them; a melamine sponge handles the rest. Mineral spirits do comparatively little here.
          </p>

          <p>
            <strong>Oil-based stains</strong> are the opposite. They need a solvent even when fresh, but mineral spirits keep working on them long after they have dried, because the oil never fully cross-links into a hard film the way acrylic does. Dwell time is your main tool.
          </p>

          <p>
            <strong>Solid stains</strong>, of either chemistry, are the hardest case. They carry the most pigment and the most binder, so a splash is essentially a spot of paint. Expect to reach step four or five, and expect a visible ghost of colour to remain on textured siding where pigment has settled into the grain pattern.
          </p>

          <p>
            If you have not yet started staining and are choosing between the two, the difference in clean-up is one small consideration among several — the larger ones are in <a href="/oil-based-vs-water-based-deck-stain/">oil-based versus water-based deck stain</a>.
          </p>
        </div>

        <div id="last-resort" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. When Nothing Works
          </h2>

          <p>
            Replacing a panel is the honest answer, and it is a far smaller job than it sounds. Vinyl siding is designed to come apart: a zip tool costs a few dollars, unlocks the bottom lip of the course above, and the damaged panel slides out sideways once its nails are pulled. Most single-course swaps take under an hour with basic tools.
          </p>

          <p>
            The catch is matching. Vinyl fades over the years, so a new panel of the same product and colour may still read as brighter than its neighbours. Take a cut-off to the supplier, and if the wall is prominent, consider taking the replacement panel from a hidden elevation — a gable end, or behind a shed — and putting the new panel there instead.
          </p>

          <p>
            Painting vinyl is possible with a vinyl-safe acrylic in a colour no darker than the original, since dark colours absorb heat and warp panels. But it commits the whole wall to a repaint cycle to avoid a patchwork, which is a large response to one splash of deck stain.
          </p>
        </div>

        <div id="prevention" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            8. Not Doing This Again
          </h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Mask the bottom three courses.</strong> Plastic sheeting and painter's tape, run the full length of the wall, before the can is opened. Ten minutes.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Brush the last two feet.</strong> Whatever you use elsewhere, the boards nearest the house get done by hand, not by sprayer or a loaded pad.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Never spray in wind.</strong> Overspray drifts much further than it looks, and it lands as a fine mist that dries before anyone notices it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Carry a rag and solvent.</strong> In a pocket, all day. A splash wiped inside a minute never becomes a search result.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Check the wall before you pack up.</strong> Splashes are far easier to see wet than dry, and far easier to remove the same evening than the next week.</span>
            </li>
          </ul>

          <p>
            The masking step is the one people skip because the wall is only a foot away and they are being careful. Everyone is being careful; the marks happen anyway, usually from a pad flicked on a corner or a brush loaded slightly too heavily. The full prep routine is covered in <a href="/how-to-prep-a-deck-for-staining/">how to prep a deck for staining</a>.
          </p>
        </div>

        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Stain On Everything Else Nearby</h2>
        <p>
          Vinyl is the fussiest surface around a deck, but it is rarely the only one that catches a splash. <strong>Glass and aluminium window frames</strong> are the easiest of the lot: mineral spirits on a rag lifts oil stain readily, and a razor blade held at a shallow angle takes cured stain off glass without marking it — though never off the frame or the seal.
        </p>
        <p>
          <strong>Brick and concrete</strong> are the hardest, because the stain soaks into a porous surface rather than sitting on it. A poultice works better than any wipe: mix an absorbent powder with a solvent into a paste, spread it over the mark, cover it with plastic for several hours and let it draw the stain back out as it dries. Expect to repeat it, and expect a faint ghost to remain.
        </p>
        <p>
          <strong>Painted wood trim</strong> is the one place to be most careful, since the solvent that removes deck stain will happily soften the paint underneath it. Test in a hidden spot, work quickly with minimal solvent, and accept that a small touch-up with the trim paint is often the faster and better-looking fix than another round of rubbing.
        </p>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Starting With the Strongest Solvent</h3>
              <p class="text-gray-700 text-sm m-0">
                Acetone and lacquer thinner remove the stain and the surface of the siding at the same time. The resulting dull patch is permanent and far more visible than the splash. Work up from soapy water, and test everything in a hidden spot first.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Scrubbing Instead of Soaking</h3>
              <p class="text-gray-700 text-sm m-0">
                Dried stain gives way to dwell time, not force. A solvent-dampened cloth left over the mark for ten minutes does what five minutes of hard rubbing will not — and hard rubbing dulls the vinyl while it fails.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Working in Direct Sun</h3>
              <p class="text-gray-700 text-sm m-0">
                Warm vinyl is softer and marks more easily, and solvents evaporate before they can work. Wait for shade or the cool of the evening; the same product behaves completely differently on a cool panel.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Pressure Washing at Close Range</h3>
              <p class="text-gray-700 text-sm m-0">
                It rarely shifts cured stain and it does drive water up behind the laps and into the wall, and can crack older brittle panels. Stay under 1,500 psi, use a wide tip, work at least three feet back, and never aim upward under the courses.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Stopping at the Edge of the Mark</h3>
              <p class="text-gray-700 text-sm m-0">
                Removing stain from older siding also removes years of oxidation and grime, leaving a bright patch. Wash outward across the whole panel and then the wall so the cleaned area blends rather than announcing itself.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            10. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you remove deck stain from vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Work up in strength. Fresh water-based stain comes off with warm soapy water. Fresh oil-based needs mineral spirits then a wash. Cured stain responds to mineral spirits with dwell time, then a citrus or vinyl-safe cleaner, then careful use of a melamine sponge. Test everything in a hidden spot first.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Will mineral spirits damage vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Used briefly and rinsed off, they are generally safe and are the standard first solvent for oil-based stain. What they do strip is the chalky oxidised layer on older siding, leaving a patch that looks cleaner than its surroundings — so feather outward and plan to wash the whole panel.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What should you never use on vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Acetone, lacquer thinner, MEK, chlorinated solvents, paint or deck stripper, and abrasive pads or wire brushes. Those solvents dissolve PVC itself and leave a dull, etched patch that no cleaning fixes. Nothing on the siding is worth that trade.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you get dried deck stain off siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Soften rather than scrub. Lay a mineral-spirits-dampened cloth over the mark for five to ten minutes, wipe with light pressure, and repeat. Several gentle cycles remove more than one aggressive attempt, and they leave the surface sheen intact.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you pressure wash deck stain off siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It rarely removes cured stain, and at close range it drives water behind the panels and can crack older siding. If you use one, keep it under about 1,500 psi with a wide tip, work from three feet back, and spray downward or level rather than up under the laps.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Does a Magic Eraser work on siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Often, yes — a melamine sponge lifts residue that solvents leave behind. It is a fine abrasive rather than a chemical, so it also takes some surface sheen. Use it damp, with light pressure, on the mark only, and check the result from a few steps back in daylight.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What if the stain will not come off at all?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Replace the panel. A zip tool costs a few dollars, panels sell individually, and a single course usually swaps in under an hour. On sun-faded siding a new panel may not match exactly, so take a piece to the supplier — or borrow a panel from a hidden elevation.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you keep stain off siding in the first place?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Mask the bottom two or three courses before opening a can, brush rather than spray within two feet of the wall, and keep a rag and mineral spirits in your pocket while you work. A splash wiped within a minute is a non-event.
              </p>
            </div>
          </div>
        </div>

