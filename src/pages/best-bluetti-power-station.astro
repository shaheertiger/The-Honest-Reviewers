---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Bluetti vs EcoFlow",
    "url": "/bluetti-vs-ecoflow/"
  },
  {
    "title": "Jackery vs EcoFlow",
    "url": "/jackery-vs-ecoflow/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Home Battery Backup Systems",
    "url": "/best-home-battery-backup-system/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "Can a Portable Power Station Run a CPAP?",
    "url": "/can-a-portable-power-station-run-a-cpap/"
  },
  {
    "title": "How Long Do Portable Power Stations Last?",
    "url": "/how-long-do-portable-power-stations-last/"
  },
  {
    "title": "Portable Power Station vs Generator",
    "url": "/portable-power-station-vs-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Bluetti Power Stations in 2026: Every Model Ranked";
const description =
  "We ranked Bluetti's current power stations, from the EB3A to the Apex 300, on capacity, solar input, expansion and value, so you buy the right model.";

const PRODUCTS = [
  {
    "id": "bluetti-elite-100-v2",
    "name": "BLUETTI Elite 100 V2",
    "category": "1,024Wh / 1,800W LiFePO4 Power Station",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh LiFePO4 battery rated for 4,000 cycles to 80 percent",
      "1,800W continuous output covers coffee makers, microwaves and most power tools",
      "1,000W solar input, unusually high for a 1 kWh unit",
      "About 25 pounds, light for its capacity",
      "Sub-10 ms UPS switchover for routers, PCs and CPAPs"
    ],
    "cons": [
      "Fixed capacity: no expansion battery port",
      "No 30A RV outlet or 240V option"
    ],
    "bottomLine": "The Bluetti most people should buy: a full kilowatt-hour, real 1,800W output and a 1,000W solar ceiling in a box you can carry with one hand.",
    "description": "The Elite 100 V2 is the model that best represents where Bluetti is going, and it is the one we would hand to most buyers who type 'best Bluetti power station' into a search bar. It packs a 1,024Wh LiFePO4 battery and an 1,800W pure sine wave inverter into a unit that weighs about 25 pounds, which is roughly ten pounds lighter than the AC180 it effectively replaces at the 1 kWh level. Bluetti rates the cells for 4,000 cycles to 80 percent capacity, so even with a full charge and discharge every weekend you are looking at decades of calendar life before the battery is the limiting factor. The headline spec is solar: the Elite 100 V2 accepts up to 1,000W of panels on a 12-60V input, double what the AC180 takes. With a properly sized array in good sun it can refill in well under two hours, which turns it into a genuine off-grid tool rather than a battery you top up from the wall. Wall charging is fast too, with Bluetti quoting 45 minutes to 80 percent. Bluetti also lists a sub-10 ms UPS switchover, enough to keep most routers, desktop PCs and CPAP machines running through a blackout without a reboot. At about 85 percent usable energy, the battery runs a 120W-average refrigerator for roughly seven hours or a 40W CPAP for around 21. The catch is that capacity is fixed: there is no expansion port, so if you think you will need 2 kWh or more within a couple of years, start with the AC200L instead. For everyone else, this is the sweet spot of the lineup."
  },
  {
    "id": "bluetti-ac200l",
    "name": "BLUETTI AC200L",
    "category": "2,048Wh / 2,400W Expandable Power Station",
    "badge": "Best Expandable",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh LiFePO4 battery expands to 8,192Wh with two B300 or B300K packs",
      "2,400W continuous output runs most kitchen appliances one at a time",
      "1,200W solar input with a wide 12-145V window",
      "2,400W AC charging for fast refills from the wall or a generator",
      "30A RV outlet for campers and travel trailers"
    ],
    "cons": [
      "About 62 pounds, a two-hand lift",
      "120V only, so it will not run a well pump or dryer"
    ],
    "bottomLine": "The right Bluetti if you want 2 kWh today and the option to quadruple it later without replacing the main unit.",
    "description": "The AC200L is the expandable middle of the Bluetti lineup and the unit we point to when a buyer is not sure how much capacity they will eventually need. Out of the box it carries a 2,048Wh LiFePO4 battery and a 2,400W inverter, which is enough to run a full-size refrigerator, a microwave, a window air conditioner or a circular saw, one big load at a time. Add one or two B300 or B300K expansion batteries and the system grows to as much as 8,192Wh, which is the difference between getting through an evening outage and getting through a long weekend. At 85 percent usable energy, the base unit alone runs a 120W-average refrigerator for about 14 hours; with two expansion packs, that figure stretches past two days. Solar input tops out at 1,200W across a 12-145V window, which is the widest voltage range in the portable part of the lineup and means you can wire panels in series for less loss over long cable runs. AC charging is a fast 2,400W, so a generator or wall outlet can refill it in about an hour, and the 30A RV outlet makes it a straightforward fit for a travel trailer. Bluetti rates the battery for 3,000-plus cycles. The trade-offs are weight and voltage. At roughly 62 pounds it is a two-hand carry, and it is strictly 120V, so a well pump, electric dryer or central air system is out of reach. If those are on your list, you need the Apex 300. If they are not, the AC200L is the most flexible Bluetti you can buy."
  },
  {
    "id": "bluetti-apex-300",
    "name": "BLUETTI Apex 300",
    "category": "2,764.8Wh / 3,840W Home Backup System",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "pros": [
      "3,840W continuous output, the most in Bluetti's single-unit lineup",
      "Expands toward 58kWh with B300K or B500K batteries and stacked units",
      "Up to 2,400W of built-in solar input, more with Bluetti's add-on controllers",
      "Designed to tie into home circuits through Bluetti's hub and panel accessories",
      "Replaces the older EP500 as Bluetti's home battery workhorse"
    ],
    "cons": [
      "Heavy: this is a roll-into-place unit, not a carry-to-camp one",
      "A real home setup needs extra hardware and an electrician"
    ],
    "bottomLine": "Buy it if you want a battery system that can grow into whole-home backup; skip it if you only need to keep a fridge and phones alive.",
    "description": "The Apex 300 is where Bluetti's portable products turn into a home energy system, and it is the model to buy if your goal is backing up house circuits rather than powering a campsite. The base unit carries a 2,764.8Wh LiFePO4 battery and a 3,840W continuous inverter, with a Power Lifting mode Bluetti rates up to 7,680W for resistive loads like space heaters and kettles. Built-in solar input reaches 2,400W through two inputs, and Bluetti sells external solar controllers that raise that ceiling for larger roof or ground-mount arrays. Expansion is the real story. Each Apex 300 accepts B300K expansion batteries (2,764.8Wh each) or the larger B500K (5,120Wh each), and multiple Apex units can be linked through Bluetti's hub, with Bluetti quoting a ceiling of about 58kWh for a fully built system. At 85 percent usable energy, a single base unit runs a 120W-average refrigerator for about 19 hours; with two B300K packs it can carry a fridge, a furnace blower, lights and internet for most of two days. Bluetti markets the Apex 300 for 120/240V home integration, which is the capability that lets a battery system reach well pumps and other 240V loads, but getting there requires Bluetti's hub or smart panel and a proper installation, not just an extension cord. Budget for those parts and an electrician when you price it out. It is also heavy, so treat it as furniture. For a buyer comparing it with the older AC300 plus B300 or the AC500, the Apex 300 is the current platform and the one Bluetti is actively developing accessories around."
  },
  {
    "id": "bluetti-ac180-solar-generator",
    "name": "BLUETTI AC180",
    "category": "1,152Wh / 1,800W LiFePO4 Power Station",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "1,152Wh LiFePO4 battery, slightly more capacity than the Elite 100 V2",
      "1,800W continuous output with a 2,700W Power Lifting mode for resistive loads",
      "1,440W turbo AC charging",
      "Frequently discounted below the newer Elite models",
      "Proven platform with years of owner feedback"
    ],
    "cons": [
      "Solar input capped at 500W",
      "About 35 pounds, ten more than the Elite 100 V2"
    ],
    "bottomLine": "When it is on sale, the AC180 is the cheapest way into a real 1 kWh Bluetti; pay more for the Elite 100 V2 only if solar and weight matter.",
    "description": "The AC180 has been one of Bluetti's best-selling models for years, and even with the Elite 100 V2 now sitting above it, it remains a smart buy whenever it is discounted, which is often. You get a 1,152Wh LiFePO4 battery, a little more than the Elite 100 V2, paired with the same 1,800W continuous inverter rating. Bluetti's Power Lifting mode lets it push resistive loads such as kettles and hair dryers up to 2,700W by lowering voltage, which is useful in a pinch but not something to rely on for motors or electronics. AC charging tops out at 1,440W in turbo mode, so a wall outlet refills it in about an hour. At roughly 85 percent usable energy, the AC180 runs a 120W-average refrigerator for about eight hours, a 60W laptop and monitor setup for most of a workday and a 40W CPAP for over 24 hours. Where it shows its age is solar and weight. Solar input is limited to 500W on a 12-60V input, half what the Elite 100 V2 accepts, so a full solar recharge takes the better part of a sunny day rather than a couple of hours. It also weighs about 35 pounds, roughly ten more than its newer sibling. The AC180 can draw from certain Bluetti batteries through its DC input, but that is one-way charging, not true expansion. Buy the AC180 if you want 1 kWh at the lowest price and mostly charge from the wall. If you plan to lean on solar, the Elite 100 V2 is worth the difference."
  },
  {
    "id": "bluetti-elite-200-v2",
    "name": "BLUETTI Elite 200 V2",
    "category": "2,073.6Wh / 2,600W LiFePO4 Power Station",
    "badge": "Longest-Rated Battery",
    "amazonUrl": "#",
    "pros": [
      "2,073.6Wh capacity with a 2,600W continuous inverter",
      "Bluetti rates the battery for 6,000-plus cycles and a 17-year service life",
      "Power Lifting mode for resistive loads up to 3,900W",
      "1,000W solar input on a 12-60V window",
      "Bluetti's named successor to the AC200MAX"
    ],
    "cons": [
      "Fixed capacity: no expansion batteries",
      "About 62 pounds, same as the expandable AC200L"
    ],
    "bottomLine": "Pick it over the AC200L if you want more output and the longest-rated battery in the lineup, and you know 2 kWh is enough.",
    "description": "The Elite 200 V2 is the 2 kWh version of Bluetti's newer Elite line, and it competes directly with the AC200L for buyers who want a serious outage battery without stepping up to a home system. It carries a 2,073.6Wh LiFePO4 pack and a 2,600W continuous inverter, which is 200W more than the AC200L, with a Power Lifting mode Bluetti rates to 3,900W for resistive loads. The standout spec is longevity. Bluetti rates the battery for more than 6,000 cycles and quotes an expected service life of around 17 years, the longest figure anywhere in its portable range. If you plan to cycle the unit daily, for example running a cabin, a van or a time-of-use home setup, that rating matters more than any other number on the box. At 85 percent usable energy, it runs a 120W-average refrigerator for about 14 hours, or a fridge plus a 60W internet and lighting load for about 9 hours. Charging is quick from the wall, and solar input reaches 1,000W on a 12-60V window, so a well-sized array can refill it in a sunny afternoon. The reason it is not ranked higher is that capacity is fixed. Unlike the AC200L, there is no expansion port, so the 2 kWh you buy is the 2 kWh you keep. It is also not light: Bluetti lists it at about 62 pounds. Choose the Elite 200 V2 if you cycle hard and want maximum output at this size. Choose the AC200L if there is any chance you will want 4 or 8 kWh down the road."
  },
  {
    "id": "bluetti-elite-30-v2",
    "name": "BLUETTI Elite 30 V2",
    "category": "288Wh / 600W Compact Power Station",
    "badge": "Most Portable",
    "amazonUrl": "#",
    "pros": [
      "About 9.5 pounds, the lightest unit in this guide",
      "288Wh LiFePO4 battery, enough for a CPAP night or a weekend of phones and lights",
      "600W continuous output with 1,500W surge",
      "200W solar input through a standard XT60 port",
      "UPS-style pass-through for a router or small desk setup"
    ],
    "cons": [
      "Solar cable sold separately on some bundles",
      "Too small for refrigerators beyond a few hours"
    ],
    "bottomLine": "The Bluetti to throw in a car or tent bag; buy something bigger if you are planning for outages longer than a night.",
    "description": "The Elite 30 V2 is Bluetti's small, modern answer to the question of what to carry when weight matters more than runtime. It weighs about 9.5 pounds and holds a 288Wh LiFePO4 battery behind a 600W continuous inverter with a 1,500W surge rating. That is enough for a CPAP machine overnight, a laptop for a full workday, a string of LED lights, a small fan or a 12V camping fridge, but not a household refrigerator for long. At roughly 85 percent usable energy, a 40W CPAP without a heated humidifier runs for about six hours, and a 50W portable fridge with a typical duty cycle can stretch toward a full day. Solar input is 200W through an XT60 port on a 12-28V window, so a single 100W to 200W panel can refill it in roughly two to three hours of good sun. Note that some bundles do not include the XT60 solar cable, which several reviewers flagged, so check the box contents before you head out. The Elite 30 V2 also offers a pass-through mode that lets it act as a small UPS for a router or modem, which is a genuinely useful second job when it is sitting at home. Compared with the EB3A, it carries slightly more capacity in a lighter, more compact shell and benefits from Bluetti's newer app and firmware. Buy it for camping, road trips, a bedside CPAP backup or as a second unit alongside a larger Bluetti. Do not buy it as your only outage plan if you have a refrigerator to protect."
  },
  {
    "id": "bluetti-eb3a",
    "name": "BLUETTI EB3A",
    "category": "268Wh / 600W Entry-Level Power Station",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "Often the cheapest LiFePO4 power station Bluetti sells",
      "600W continuous output with 1,200W surge",
      "Up to 430W combined AC and solar charging",
      "200W solar input for a single portable panel",
      "About 10 pounds with a built-in carry handle"
    ],
    "cons": [
      "Older design than the Elite 30 V2",
      "268Wh is small for anything beyond devices and a CPAP"
    ],
    "bottomLine": "A cheap, reliable starter battery; spend a little more on the Elite 30 V2 if you can, but the EB3A on sale is hard to argue with.",
    "description": "The EB3A has been Bluetti's entry ticket for years, and it still earns its spot because it is regularly the least expensive LiFePO4 power station the brand sells. It holds 268Wh behind a 600W pure sine wave inverter with a 1,200W surge rating and weighs about 10 pounds. That makes it a good fit for charging phones, cameras and drones, running a laptop for most of a day, powering LED lights at a campsite or carrying a CPAP machine through a night without humidification. At 85 percent usable energy, a 40W CPAP runs for about five and a half hours, and a phone at roughly 15Wh per charge can be refilled more than a dozen times. Charging is flexible for a small unit. The AC input is rated at 350W, solar input reaches 200W on a 12-28V window, and the two together can push up to 430W, so it can go from nearly empty to full in well under an hour on combined input. A single 200W panel such as the PV200 refills it in roughly two hours of strong sun. The EB3A's weaknesses are age and size. The Elite 30 V2 now offers slightly more capacity in a lighter, more refined package, so if the two are close in price, buy the newer model. And 268Wh simply will not run a refrigerator for long or anything with a heating element for more than a few minutes. Treat the EB3A as a device charger, CPAP backup and campsite battery, and buy it when it is discounted."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Bluetti Power Station",
          item: "https://www.thehonestreviewers.com/best-bluetti-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best Bluetti power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, the Elite 100 V2 is the best Bluetti power station. It combines 1,024Wh of LiFePO4 capacity, 1,800W of continuous output and 1,000W of solar input in a unit weighing about 25 pounds. Choose the AC200L if you want expansion, the Apex 300 for home backup, or the EB3A for a budget camping battery."
          }
        },
        {
          "@type": "Question",
          "name": "Is Bluetti a good brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Bluetti is one of the established power station brands, alongside EcoFlow, Jackery and Anker SOLIX, and its entire current lineup uses long-life LiFePO4 batteries. Its strengths are capacity per dollar and solar input. Its weaker points are app polish and support response times during busy seasons, which owners commonly mention in reviews."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a Bluetti power station and a solar generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nothing, internally. A Bluetti solar generator is simply a power station bundled with one or more solar panels, often at a modest discount. The battery, inverter and outlets are identical. Buy the bundle only if the included panel wattage fits the unit's solar input limit and you actually plan to charge from the sun."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a Bluetti power station run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide usable capacity by your fridge's average draw. At about 85 percent of rated capacity and a 120W average, the Elite 100 V2 runs a fridge for roughly seven hours, the AC200L for about 14 and the Apex 300 base unit for about 19. Adding expansion batteries to the AC200L or Apex 300 stretches that to multiple days."
          }
        },
        {
          "@type": "Question",
          "name": "Can a Bluetti power station run a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a portable one. Whole-home backup with Bluetti means the Apex 300 with expansion batteries, paired AC300 or AC500 units, or an installed EP-series system, connected through a transfer switch or Bluetti smart panel. Even then, most owners back up essential circuits rather than running central air and an electric range at the same time."
          }
        },
        {
          "@type": "Question",
          "name": "Which Bluetti power stations are expandable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Of the current models in this guide, the AC200L and Apex 300 support true expansion. The AC200L accepts up to two B300 or B300K packs for 8,192Wh, and the Apex 300 accepts B300K or B500K packs and can be linked into larger systems. The Elite V2 models are fixed-capacity, and the AC180 only supports one-way DC charging."
          }
        },
        {
          "@type": "Question",
          "name": "How long do Bluetti batteries last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bluetti rates its LiFePO4 batteries for thousands of cycles before they fall to 80 percent capacity: 4,000 cycles for the Elite 100 V2 and more than 6,000 for the Elite 200 V2. At one full cycle per week, that is well over a decade of use. Heat and storage at full charge shorten life faster than cycling does."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best bluetti power station",
      "bluetti power station",
      "bluetti elite 100 v2 portable power station",
      "bluetti solar generator",
      "bluetti portable power station"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Bluetti Power Stations</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Bluetti sells more than a dozen power stations. We compared specs, charging, expansion and owner reports to find the seven worth buying, from a 10-pound camping box to a 240V home system.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#bluetti-elite-100-v2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Lineup
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#lineup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Lineup Explained</a>
          <a href="#comparison" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Comparison Table</a>
          <a href="#how-to-choose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How to Choose</a>
