      { title: 'Rust Converter vs Rust Remover', description: 'Chemical vs mechanical rust treatment — when to use each approach.', badge: 'Comparison', url: '/rust-converter-vs-rust-remover/' },
      { title: 'Best Gas Lawn Mowers', description: 'Push and self-propelled gas mowers tested and ranked — for the yards battery mowers can\'t handle.', badge: '#1 Guide', url: '/best-gas-lawn-mowers/' },
      { title: 'Best Chainsaws', description: 'Gas, battery, and corded electric chainsaws tested and ranked by bar length and use case.', badge: 'Top Pick', url: '/best-chainsaw/' },
      { title: 'Best Cordless Drills', description: 'Drill/drivers, hammer drills, and combo kits compared across every major battery platform.', badge: 'Top Pick', url: '/best-cordless-drills/' },
      { title: 'Best Cordless Drills for Home Use', description: 'Lightweight combo kits and compact drills for casual DIY — no contractor-grade overkill.', badge: 'Guide', url: '/best-cordless-drill-for-home-use/' },
      { title: 'Best Pressure Washers', description: 'Gas and electric washers ranked by cleaning units, with PSI versus GPM finally explained.', badge: 'Top Pick', url: '/best-pressure-washer/' },
      { title: 'Best Electric Pressure Washers', description: 'Induction versus universal motors, and which electric units genuinely clean concrete.', badge: 'Buyer\'s Guide', url: '/best-electric-pressure-washer/' },
      { title: 'Best Shop Vacs', description: 'Wet/dry vacuums tested on drywall dust, sawdust, and wet spills — hose diameter matters most.', badge: 'Top Pick', url: '/best-shop-vac/' },
      { title: 'Best Stud Finders', description: 'Multi-sensor, magnetic, and radar scanners tested on drywall, plaster, and walls with live wiring.', badge: 'Top Pick', url: '/best-stud-finder/' },
      { title: 'Best Laser Levels', description: 'Cross-line, three-plane, and rotary lasers checked against a calibrated reference at 30 feet.', badge: 'Top Pick', url: '/best-laser-level/' },
      { title: 'Best Torque Wrenches', description: 'Click, split-beam, and digital wrenches tested against a torque analyzer for accuracy and repeatability.', badge: 'Review', url: '/best-torque-wrench/' },
      { title: 'Best Snow Blowers', description: 'Single-stage, two-stage, gas and battery machines tested on powder, wet snow, and plow piles.', badge: 'Top Pick', url: '/best-snow-blower/' },
      { title: 'Best Electric Snow Blowers', description: 'Corded and battery snow throwers tested in real cold, including cold-weather runtime reality.', badge: 'Buyer\'s Guide', url: '/best-electric-snow-blower/' },
      { title: 'Best Portable Power Stations', description: 'Load-tested with real appliances, with watt-hours versus watts and battery chemistry explained.', badge: 'Top Pick', url: '/best-portable-power-station/' },
      { title: 'Best Jigsaws', description: 'Blade deflection measured in 40mm oak — why cheap jigsaws cut crooked and which ones do not.', badge: 'Buyer\'s Guide', url: '/best-jigsaw/' },
      { title: 'Best Wood Routers', description: 'Fixed base versus plunge, collet grip tested for creep, and the depth control that decides accuracy.', badge: 'Top Pick', url: '/best-wood-router/' },
      { title: 'Best Router Tables', description: 'Tops checked for flatness and fences load-tested — why the fence matters more than the table.', badge: 'Buyer\'s Guide', url: '/best-router-table/' },
      { title: 'Best Drill Presses', description: 'Spindle runout measured with a dial indicator, plus quill deflection and table squareness.', badge: 'Top Pick', url: '/best-drill-press/' },
      { title: 'Best Benchtop Planers', description: '300 board feet surfaced, snipe measured at both ends. Helical versus straight knives compared.', badge: 'Top Pick', url: '/best-benchtop-planer/' },
      { title: 'Best Belt Sanders', description: 'Platen flatness, tracking drift, and dust capture measured while flattening a glued-up benchtop.', badge: 'Buyer\'s Guide', url: '/best-belt-sander/' },
      { title: 'Best Palm Sanders', description: '40 board feet sanded and every panel checked under raking light. Random orbit versus sheet sanders.', badge: 'Top Pick', url: '/best-palm-sander/' },
      { title: 'Best Drywall Sanders', description: 'A full room of joint compound sanded, with the dust each machine let escape weighed.', badge: 'Buyer\'s Guide', url: '/best-drywall-sander/' },
      { title: 'Best Framing Hammers', description: '2,000 sixteen penny nails driven. Titanium versus steel, and what handle material does to your elbow.', badge: 'Top Pick', url: '/best-framing-hammer/' },
      { title: 'Best Bench Vises', description: 'Jaw deflection measured under load. Cast iron versus ductile iron, and which castings survive being hit.', badge: 'Buyer\'s Guide', url: '/best-bench-vise/' },
      { title: 'Best Wire Strippers', description: '500 conductors stripped and inspected under magnification. Self-adjusting versus gauged tools.', badge: 'Top Pick', url: '/best-wire-stripper/' },
      { title: 'Best Circuit Breaker Finders', description: 'Three panels mapped and every false positive counted. Which ones find the right breaker first time.', badge: 'Review', url: '/best-circuit-breaker-finder/' },
      { title: 'Best Telescoping Ladders', description: 'Locking mechanisms, duty ratings, and the retraction pinch injury nobody warns you about.', badge: 'Top Pick', url: '/best-telescoping-ladder/' },
    ],
  },
  {
    name: 'Home Appliances',
    id: 'appliances',
    guides: [
      { title: 'Best Water Softener Systems', description: 'Salt-based, salt-free, and dual-tank systems compared and ranked for hard water.', badge: '#1 Guide', url: '/best-water-softener-system/' },
      { title: 'Best Water Filtration Systems for Home', description: 'Whole-house, under-sink RO, and well-water filtration systems tested and ranked.', badge: 'Top Pick', url: '/best-water-filtration-system-for-home/' },
      { title: 'Best Water Filter Pitchers', description: 'NSF-certified, fast-flow, and budget pitcher filters compared by cost per gallon.', badge: 'Top Pick', url: '/best-water-filter-pitcher/' },
      { title: 'Best Dishwashers (2026)', description: 'Noise, drying tech, and third-rack capacity compared across Bosch, Miele, KitchenAid, and more.', badge: 'Top Pick', url: '/best-dishwasher/' },
      { title: 'Best Air Purifiers for Home', description: 'HEPA and carbon purifiers ranked for allergies, dust, smoke, and everyday air quality.', badge: 'Top Pick', url: '/best-air-purifier-for-home/' },
      { title: 'Best Ceiling Fans With Lights', description: 'Smart, DC-motor, and wet-rated outdoor ceiling fans tested and ranked by room size.', badge: 'Top Pick', url: '/best-ceiling-fans-with-lights/' },
      { title: 'Best Tankless Water Heaters', description: 'Real flow rates, cold-weather performance, and the venting costs that change the maths.', badge: '#1 Guide', url: '/best-tankless-water-heater/' },
      { title: 'Best Gas Water Heaters', description: 'Recovery rate, first-hour rating and venting type compared across atmospheric, power vent and condensing.', badge: 'Top Pick', url: '/best-gas-water-heater/' },
      { title: 'Best Air Purifiers for Smoke', description: 'Wood, cooking oil and tobacco smoke tested in a sealed room. Carbon weight matters more than HEPA.', badge: 'Top Pick', url: '/best-air-purifier-for-smoke/' },
      { title: 'Best Whole House Fans', description: 'Airflow, noise and attic temperature measured. Ducted versus direct-mount, plus the venting nobody checks.', badge: 'Buyer\'s Guide', url: '/best-whole-house-fan/' },
    ],
  },
  {
    name: 'Home Improvement',
    id: 'home',
    guides: [
      { title: 'Best Exterior Caulk', description: 'Exterior caulks tested against sun, rain, and joint movement for siding, trim, and masonry.', badge: 'Top Pick', url: '/best-exterior-caulk/' },
      { title: 'Spackle vs Putty', description: 'Nail holes, drywall damage, and wood repairs — which filler to use when.', badge: 'Comparison', url: '/spackle-vs-putty/' },
      { title: 'Barn Door vs French Door', description: 'Space, style, sound, and cost compared for interior door upgrades.', badge: 'Comparison', url: '/barn-door-vs-french-door/' },
      { title: 'Best Laminate Flooring', description: '14 floors scratched, soaked and walked for a season. AC ratings and click systems ranked.', badge: '#1 Guide', url: '/best-laminate-flooring/' },
      { title: 'Best Vinyl Plank Flooring', description: 'SPC versus WPC cores, wear layer thickness in mils, and which brands survive a real house.', badge: 'Top Pick', url: '/best-vinyl-plank-flooring/' },
      { title: 'Best Underlayment for Vinyl Plank', description: 'Often the answer is none at all. When you need one, when you must not, and which to buy.', badge: 'Buyer\'s Guide', url: '/best-underlayment-for-vinyl-plank-flooring/' },
      { title: 'Best Tile Leveling Systems', description: '400 square feet of porcelain set and lippage measured. Clips, wedges and threaded caps compared.', badge: 'Top Pick', url: '/best-tile-leveling-system/' },
      { title: 'Best Grout Sealers', description: '14 panels sealed then attacked with wine, oil and bleach for six months. Penetrating versus membrane.', badge: 'Top Pick', url: '/best-grout-sealer/' },
      { title: 'Best Attic Ladders', description: 'Deflection and draught loss measured, plus the swing clearance people forget to check before ordering.', badge: 'Buyer\'s Guide', url: '/best-attic-ladder/' },
      { title: 'Best Drain Snakes', description: 'Hair clogs, grease and root intrusion cleared. Hand crank versus drill powered, and what not to snake.', badge: 'Top Pick', url: '/best-drain-snake/' },
      { title: 'Best Whole House Surge Protectors', description: 'Clamping voltage and surge current compared. Type 1 versus Type 2, and what UL 1449 actually means.', badge: 'Buyer\'s Guide', url: '/best-whole-house-surge-protector/' },
      { title: 'LeafFilter Reviews', description: 'An independent look at the micromesh, the real cost per foot, the warranty fine print, and six alternatives.', badge: 'Review', url: '/leaf-filter-reviews/' },
    ],
  },
  {
    name: 'Generators & Backup Power',
    id: 'generators',
    guides: [
      { title: 'Portable vs Standby Generator', description: 'Which type suits your outages, and why the transfer switch decides what you can power.', badge: 'Comparison', url: '/portable-vs-standby-generator/' },
      { title: 'How Many Watts to Power a House?', description: 'The three tiers of outage power and what each one actually buys you.', badge: 'Sizing', url: '/how-many-watts-to-power-a-house/' },
      { title: 'Generator Wattage Chart', description: 'Running and starting watts for the household appliances people actually back up.', badge: 'Reference', url: '/generator-wattage-chart/' },
      { title: 'Can a Generator Power a Furnace, Fridge and Sump Pump?', description: 'The arithmetic for the classic outage trio, and the hardwiring problem behind it.', badge: 'Guide', url: '/can-a-generator-power-a-furnace-refrigerator-and-sump-pump/' },
      { title: 'Best Home Generator for Power Outages', description: 'Standby, portable, inverter and battery backup tested through simulated multi-day outages.', badge: '#1 Guide', url: '/best-home-generator-for-power-outages/' },
      { title: 'Best Whole House Generator', description: 'Generac, Kohler, Briggs & Stratton and more compared on output, engine quality, and installed cost.', badge: 'Top Pick', url: '/best-whole-house-generator/' },
      { title: 'Generac Generator Cost', description: 'Every line item priced — unit, transfer switch, gas line, pad and permits — and where quotes go wrong.', badge: 'Cost Guide', url: '/generac-generator-cost/' },
      { title: 'What Size Generator Do I Need?', description: 'Starting versus running watts, an appliance chart, and sizing worked through three real houses.', badge: 'Sizing Guide', url: '/what-size-generator-do-i-need-for-my-house/' },
      { title: 'Best Inverter Generator', description: 'Noise, harmonic distortion, runtime and cold starts measured across seven units from 1,800W to 9,000W.', badge: 'Top Pick', url: '/best-inverter-generator/' },
      { title: 'Best Dual Fuel Generator', description: 'Six generators run on both gasoline and propane, with the real output loss and cold-weather limits measured.', badge: 'Buyer\'s Guide', url: '/best-dual-fuel-generator/' },
      { title: 'Best Dual Fuel Inverter Generator', description: 'Clean power plus fuel flexibility — tested on both fuels for output, decibels and runtime.', badge: 'Buyer\'s Guide', url: '/best-dual-fuel-inverter-generator/' },
      { title: 'Best Tri-Fuel Generator', description: 'Gasoline, propane and natural gas from one machine, plus what the house gas hookup really involves.', badge: 'Buyer\'s Guide', url: '/best-tri-fuel-generator/' },
      { title: 'Best Natural Gas Generator', description: 'Unlimited runtime from your house line — standby and portable options compared, with hookup costs.', badge: 'Top Pick', url: '/best-natural-gas-generator/' },
    ],
  },
  {
    name: 'Fitness & Outdoor Gear',
    id: 'fitness',
    guides: [
      { title: 'Best Home Gym Equipment on a Budget', description: 'A complete garage gym built for under $1,500 and trained in for a year. Rack, bar, bench, plates and flooring.', badge: 'Buyer\'s Guide', url: '/best-home-gym-equipment-on-a-budget/' },
      { title: 'Best Crash Pads for Outdoor Bouldering', description: '14 pads hauled to real boulders and fallen on for a season. Foam stacks, folds, straps and landings compared.', badge: 'Top Pick', url: '/best-crash-pad-for-bouldering-outdoors/' },
      { title: 'Best Canoes for River Paddling', description: '15 canoes down real rivers. Rocker, hull shape and the materials that survive rock, compared honestly.', badge: 'Buyer\'s Guide', url: '/best-canoes-for-river-paddling/' },
      { title: 'Best Zipline Harnesses', description: 'Certifications that actually matter, sit versus full-body, and why children need a different harness.', badge: 'Safety Guide', url: '/best-harness-for-zipline-riding/' },
      { title: 'Best Ski Gloves', description: '14 pairs skied through a full season. Leather versus synthetic, gloves versus mittens, and why your hands are still cold.', badge: 'Top Pick', url: '/best-ski-gloves/' },
    ],
  },
  {
    name: 'Men\'s Grooming',
    id: 'grooming',
    guides: [
      { title: '8 Best Men\'s Back Shavers (2026)', description: 'We bought and tested 12+ back shavers over 90 days. Only 4 made the cut.', badge: '#1 Guide', url: '/best-mens-back-shavers/' },
      { title: 'Braun Type 5544 vs Series 7', description: 'In-depth performance test comparing two of Braun\'s most popular grooming tools.', badge: 'Head-to-Head', url: '/braun-type-5544-vs-series-7/' },
      { title: 'The Brutal Truth About Back Hair', description: '50%+ of men have back hair. Only 24% groom it regularly. Science and solutions.', badge: 'Trending', url: '/the-brutal-truth-about-back-hair/' },
      { title: 'What Is a Buzz Cut? The Complete Guide', description: 'Everything about buzz cuts: guards, face shapes, DIY tutorial, and styling.', badge: 'Guide', url: '/buzz-cut-guide/' },
      { title: 'How to Shave Back Hair by Yourself (2026)', description: 'Step-by-step DIY guide to shaving your back hair solo.', badge: 'How-To', url: '/how-to-shave-back-hair/' },
    ],
  },
];

const allGuides = categories.flatMap(c => c.guides);

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.thehonestreviewers.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Best Lists',
          item: 'https://www.thehonestreviewers.com/best-of/',
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Best Guides of 2026 | The Honest Reviewers',
      description: "Expert-tested guides for home improvement, sealers, tools, and grooming. Hands-on reviews, real data, honest verdicts.",
      url: 'https://www.thehonestreviewers.com/best-of/',
    },
    {
      '@type': 'ItemList',
      name: 'Best Guides of 2026 | The Honest Reviewers',
      description: "Expert-tested guides for home improvement, sealers, tools, and grooming. Hands-on reviews, real data, honest verdicts.",
      itemListElement: allGuides.map((guide, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Article',
          name: guide.title,
          description: guide.description,
          url: `https://www.thehonestreviewers.com${guide.url}`,
        },
      })),
    },
  ],
};
---
<Layout
  title="Best Guides of 2026"
  description="Expert-tested guides for driveway sealers, paver sealers, tools, home improvement, and grooming. Real data, honest verdicts, zero sponsorships."
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated for 2026
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        All <span class="text-[#1E90FF]">Expert-Tested</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        172 hands-on tested guides covering sealers, tools, generators, appliances, home improvement, and grooming. Real data, honest verdicts, zero sponsored picks.
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map(cat => (
          <a href={`#${cat.id}`} class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700 hover:bg-[#1E90FF] hover:text-white hover:border-[#1E90FF] transition-colors no-underline">
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Testing Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">Our Testing Process</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Every product on this site was purchased with our own money, tested in-house for a minimum of 30 days, and verified against thousands of real user reviews on Reddit and Amazon. We accept zero free samples or sponsorships.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Categorized Guides -->
    {categories.map(category => (
      <section id={category.id} class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-black text-[#333333] mb-8 pb-4 border-b-2 border-gray-200">
          {category.name}
          <span class="text-base font-normal text-gray-400 ml-3">{category.guides.length} guides</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.guides.map(guide => (
            <a
              href={guide.url}
              class="block bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[#1E90FF]/30 transition-all group no-underline"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-[#FF4500]/10 text-[#FF4500] px-2.5 py-0.5 rounded-full text-xs font-black uppercase">
                  {guide.badge}
                </span>
              </div>
              <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
                {guide.title}
              </h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{guide.description}</p>
              <div class="flex items-center gap-1 text-[#1E90FF] text-sm font-bold">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-8 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="p-10 lg:p-14">
          <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Guides?</h2>
          <p class="text-gray-400 leading-relaxed mb-6">
            We evaluate every product using a rigorous scoring system across five dimensions:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">1</span>
              <p class="font-bold text-white text-sm">Performance (30%)</p>
              <p class="text-gray-400 text-xs">Real-world effectiveness, durability, and consistency over time.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">2</span>
              <p class="font-bold text-white text-sm">Build Quality (20%)</p>
              <p class="text-gray-400 text-xs">Materials, construction, and long-term durability.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">3</span>
              <p class="font-bold text-white text-sm">Value for Money (20%)</p>
              <p class="text-gray-400 text-xs">Price relative to performance at every price point.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">4</span>
              <p class="font-bold text-white text-sm">Ease of Use (20%)</p>
              <p class="text-gray-400 text-xs">Application difficulty, ergonomics, and learning curve.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">5</span>
              <p class="font-bold text-white text-sm">Community (10%)</p>
              <p class="text-gray-400 text-xs">Reddit, forums, and verified reviews to validate findings.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== NEWSLETTER CTA ========== -->
    <section class="mb-8">
      <div class="bg-[#1E90FF] rounded-3xl p-10 lg:p-16 text-white text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <h2 class="text-3xl font-black mb-4 relative z-10">Get Notified When We Drop New Guides</h2>
        <p class="text-white/80 mb-8 max-w-xl mx-auto relative z-10">
          Join 50k+ readers who get our weekly grooming picks, exclusive deals, and honest verdicts delivered straight to their inbox.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto relative z-10">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-3 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-white border-0"
          />
          <button class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-6 py-3 rounded-xl font-bold transition-colors shrink-0 cursor-pointer">
            Subscribe Free
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>
