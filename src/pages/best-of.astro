---
import Layout from '../layouts/Layout.astro';
import UrgencyTimer from '../components/UrgencyTimer';

const guides = [
  {
    title: '8 Best Men\'s Back Shavers (2026)',
    description: 'We bought and tested 12+ back shavers over 90 days. Only 4 made the cut.',
    badge: '#1 Guide',
    url: '/best-mens-back-shavers',
    image: '/images/guides/shaver-comparison.png',
  },
  {
    title: 'Braun Type 5544 vs Series 7',
    description: 'In-depth performance test comparing two of Braun\'s most popular grooming tools.',
    badge: 'Head-to-Head',
    url: '/braun-type-5544-vs-series-7',
    image: '/images/guides/braun-comparison.png',
  },
  {
    title: 'The Brutal Truth About Back Hair',
    description: '50%+ of men have back hair. Only 24% groom it regularly. We break down the science and the fix.',
    badge: 'Trending',
    url: '/the-brutal-truth-about-back-hair',
    image: '/images/guides/back-hair-truth.png',
  },
];

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Men\'s Grooming Guides of 2026',
  description: "Expert-tested grooming guides for men. Hands-on reviews, real data, honest verdicts.",
  itemListElement: guides.map((guide, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Article',
      name: guide.title,
      description: guide.description,
      url: `https://thehonestreviewers.com${guide.url}`,
    },
  })),
};
---
<Layout
  title="Best Men's Grooming Guides of 2026 | The Honest Reviewers"
  description="Expert-tested men's grooming guides. Back shavers, body groomers, and more — tested hands-on and ranked honestly."
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated for 2026
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        Best <span class="text-[#1E90FF]">Men's Grooming</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        Hands-on tested grooming products and guides for men. Real data, honest verdicts, zero sponsored picks.
      </p>

      <!-- Testing Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">Our Testing Process</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Every product on this site was purchased with our own money, tested in-house for a minimum of 30 days, and verified against thousands of real user reviews on Reddit and Amazon. We accept zero free samples or sponsorships.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Guides List -->
    <div class="space-y-8 mb-20">
      {guides.map((guide, index) => (
        <a
          href={guide.url}
          class="block bg-white border border-gray-200 rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all group no-underline"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <div class="lg:col-span-4 relative aspect-video lg:aspect-auto overflow-hidden">
              <img
                src={guide.image}
                alt={guide.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-4 left-4">
                <span class="bg-[#FF4500] text-white px-3 py-1 rounded-full text-xs font-black uppercase">
                  {guide.badge}
                </span>
              </div>
            </div>
            <div class="lg:col-span-8 p-8 lg:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-4xl font-black text-gray-200">#{index + 1}</span>
              </div>
              <h2 class="text-2xl lg:text-3xl font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-3">
                {guide.title}
              </h2>
              <p class="text-gray-600 text-lg mb-6">{guide.description}</p>
              <div class="flex items-center gap-2 text-[#1E90FF] font-bold">
                Read Full Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-20 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
          <div class="p-10 lg:p-14">
            <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Grooming Guides?</h2>
            <p class="text-gray-400 leading-relaxed mb-6">
              We evaluate every grooming product using a rigorous scoring system across five dimensions:
            </p>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black shrink-0">1</span>
                <div>
                  <p class="font-bold text-white text-sm">Performance (30%)</p>
                  <p class="text-gray-400 text-sm">Shave closeness, comfort, and consistency across multiple uses and body areas.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black shrink-0">2</span>
                <div>
                  <p class="font-bold text-white text-sm">Build Quality (20%)</p>
                  <p class="text-gray-400 text-sm">Materials, durability, and construction. Will it survive daily use for 2+ years?</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black shrink-0">3</span>
                <div>
                  <p class="font-bold text-white text-sm">Value for Money (20%)</p>
                  <p class="text-gray-400 text-sm">Price relative to performance. We pick the smartest investment at every price point.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black shrink-0">4</span>
                <div>
                  <p class="font-bold text-white text-sm">Ease of Use (20%)</p>
                  <p class="text-gray-400 text-sm">Ergonomics, reach, grip, and whether you can actually use it solo on hard-to-reach areas.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black shrink-0">5</span>
                <div>
                  <p class="font-bold text-white text-sm">Community Sentiment (10%)</p>
                  <p class="text-gray-400 text-sm">We analyze Reddit, forums, and verified Amazon reviews to validate our findings.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="relative hidden lg:block">
            <img
              src="/images/guides/testing-lab.png"
              alt="Grooming products being tested in our review lab"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-gray-900 to-transparent"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== NEWSLETTER CTA ========== -->
    <section class="mb-8">
      <div class="bg-[#1E90FF] rounded-3xl p-10 lg:p-16 text-white text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <h2 class="text-3xl font-black mb-4 relative z-10">Get Notified When We Drop New Guides</h2>
        <p class="text-white/80 mb-8 max-w-xl mx-auto relative z-10">
          Join 50k+ readers who get our weekly grooming picks, exclusive deals, and honest verdicts delivered straight to their inbox.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto relative z-10">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-3 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-white border-0"
          />
          <button class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-6 py-3 rounded-xl font-bold transition-colors shrink-0 cursor-pointer">
            Subscribe Free
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>
