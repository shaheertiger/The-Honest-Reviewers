---
import Layout from '../layouts/Layout.astro';
import UrgencyTimer from '../components/UrgencyTimer';

const categories = [
  {
    name: 'Driveway & Concrete Sealers',
    id: 'sealers',
    guides: [
      { title: 'Best Driveway Sealer (2026)', description: 'Top-rated driveway sealers tested head-to-head on asphalt and concrete.', badge: '#1 Guide', url: '/best-driveway-sealer' },
      { title: 'Best Asphalt Driveway Sealer', description: 'Coal-tar vs asphalt-based sealers — real driveway tests over 12 months.', badge: 'Top Pick', url: '/best-asphalt-driveway-sealer-reviews' },
      { title: 'Best Concrete Driveway Sealer', description: 'Penetrating vs film-forming sealers ranked by durability, finish, and value.', badge: 'Top Pick', url: '/best-concrete-driveway-sealer-reviews' },
      { title: 'Best Asphalt Sealer', description: 'From parking lots to driveways — the best asphalt sealcoating products.', badge: 'Review', url: '/best-asphalt-sealer' },
      { title: 'Best Concrete Sealer', description: 'Penetrating vs film-forming sealers for driveways, garages, patios, and basements.', badge: 'Top Pick', url: '/best-concrete-sealer' },
      { title: 'Best Asphalt Crack Filler', description: 'Hot-pour ropes and rubberized fillers tested — stop water before it becomes a pothole.', badge: 'Top Pick', url: '/best-asphalt-crack-filler' },
      { title: 'Asphalt Repair Guide', description: 'Fix potholes, cracks, crumbling edges, and low spots — the complete DIY playbook.', badge: 'Guide', url: '/asphalt-repair' },
      { title: 'Asphalt Sealcoating Guide', description: 'What it is, how often to do it, DIY vs pro costs, and step-by-step application.', badge: 'Guide', url: '/asphalt-sealcoating' },
      { title: 'Best Stamped Concrete Sealer', description: 'Protect and enhance decorative stamped concrete with the right sealer.', badge: 'Review', url: '/best-stamped-concrete-sealer' },
      { title: 'Best Concrete Countertop Sealer', description: 'Food-safe sealers tested for stain resistance, heat tolerance, and finish quality.', badge: 'Review', url: '/best-concrete-countertop-sealer' },
      { title: 'Best Garage Floor Epoxy', description: 'Top epoxy coating kits for garage floors — durability, finish, and ease of DIY tested.', badge: 'Top Pick', url: '/best-garage-floor-epoxy' },
      { title: 'How to Apply Garage Floor Epoxy', description: 'Complete DIY guide: surface prep, mixing, broadcasting flakes, and topcoat application.', badge: 'How-To', url: '/how-to-apply-garage-floor-epoxy' },
      { title: 'How to Seal a Concrete Driveway', description: 'Step-by-step guide to prepping, applying, and curing concrete driveway sealer.', badge: 'How-To', url: '/how-to-seal-a-concrete-driveway' },
      { title: 'How to Fix Crumbling Asphalt Driveway', description: 'DIY repair guide for potholes, alligator cracks, and crumbling edges.', badge: 'How-To', url: '/how-to-fix-crumbling-asphalt-driveway' },
      { title: 'How to Clean Asphalt Driveway Before Sealing', description: 'Surface prep is 80% of a sealing job. Complete cleaning guide for professional results.', badge: 'How-To', url: '/how-to-clean-asphalt-driveway-before-sealing' },
      { title: 'Asphalt vs Concrete Driveway', description: 'Cost, durability, climate performance, and maintenance compared side by side.', badge: 'Comparison', url: '/asphalt-vs-concrete-driveway' },
      { title: 'Best Driveway Sealer at Home Depot', description: 'The 7 best blacktop and concrete sealers you can actually buy at Home Depot — tested and ranked.', badge: 'Buyer\'s Guide', url: '/driveway-sealer-home-depot' },
      { title: 'Best Ice Melt for Concrete', description: 'Concrete-safe deicers ranked by melting power, temperature range, and scaling risk.', badge: 'Top Pick', url: '/best-ice-melt-for-concrete' },
      { title: 'Best Driveway Cleaner', description: 'Degreasers and stain removers tested on oil, rust, and tire marks before sealing.', badge: 'Top Pick', url: '/best-driveway-cleaner' },
      { title: 'Best Oil Stain Remover for Concrete', description: 'Poultice, enzyme, and solvent cleaners ranked on fresh and old-set oil stains.', badge: 'Review', url: '/best-oil-stain-remover-for-concrete' },
    ],
  },
  {
    name: 'Paver & Masonry Sealers',
    id: 'pavers',
    guides: [
      { title: 'Best Paver Sealer', description: 'Wet-look, natural, and water-based paver sealers compared across every finish type.', badge: '#1 Guide', url: '/best-paver-sealer' },
      { title: 'Best Paver Sealers for a Wet Look', description: 'Enhance your pavers with a glossy wet-look finish — top products tested.', badge: 'Top Pick', url: '/best-paver-sealers-for-a-wet-look' },
      { title: 'Best Water-Based Paver Sealer', description: 'Low-VOC, easy-apply paver sealers ranked by performance and breathability.', badge: 'Review', url: '/best-water-based-paver-sealer-reviews' },
      { title: 'Best Brick Sealer', description: 'Protect brick walls, patios, and fireplaces from moisture and efflorescence.', badge: 'Review', url: '/best-brick-sealer-reviews' },
      { title: 'Best Cinder Block Sealer', description: 'Waterproof and protect cinder block walls with these top-rated sealers.', badge: 'Review', url: '/best-cinder-block-sealer-reviews' },
      { title: 'Best Basement Wall Sealer', description: 'Stop moisture, mold, and water intrusion with the right basement sealer.', badge: 'Review', url: '/best-basement-wall-sealer' },
      { title: 'Armor AR350 Concrete Sealer Review', description: 'Hands-on review of the popular "wet look" acrylic sealer for concrete and pavers.', badge: 'Review', url: '/armor-ar350-concrete-sealer-review' },
      { title: 'How to Apply Paver Sealer', description: 'Complete guide to cleaning, prepping, and sealing pavers like a pro.', badge: 'How-To', url: '/how-to-apply-paver-sealer' },
      { title: 'How to Stain Concrete Patio to Look Like Stone', description: 'Transform a plain patio into a faux-stone masterpiece with acid stain.', badge: 'How-To', url: '/how-to-stain-concrete-patio-to-look-like-stone' },
    ],
  },
  {
    name: 'Stone & Wood Sealers',
    id: 'stone-wood',
    guides: [
      { title: 'Best Marble Sealer', description: 'Impregnating sealers tested on Carrara, Calacatta, and honed marble.', badge: 'Top Pick', url: '/best-marble-sealer' },
      { title: 'Best Granite Sealer', description: 'Penetrating impregnators tested on real countertops over 12 months — wine, oil, citrus.', badge: 'Top Pick', url: '/best-granite-sealer' },
      { title: 'Best Redwood Sealer', description: 'UV-blocking sealers that preserve redwood\'s natural beauty without darkening.', badge: 'Review', url: '/best-redwood-sealer' },
      { title: 'Best Deck Stain for Pressure-Treated Wood', description: 'Stains that actually bond with PT lumber — penetrating formulas tested for a year.', badge: 'Top Pick', url: '/best-deck-stain-for-pressure-treated-wood' },
      { title: 'Teak Oil vs Teak Sealer', description: 'Which finish actually protects outdoor teak furniture? We tested both.', badge: 'Comparison', url: '/teak-oil-vs-teak-sealer' },
      { title: 'Deck Stain Colors Guide', description: 'The most popular deck stain colors, opacity explained, and how to match your home.', badge: 'Guide', url: '/deck-stain-colors-guide' },
      { title: 'Best Deck Stain for Cedar', description: 'Stains tested to preserve cedar\'s natural red glow — oil vs water-based, tannin handling, and graying.', badge: 'Top Pick', url: '/best-deck-stain-for-cedar' },
      { title: 'Best Porch Paint', description: 'Porch floor enamels tested through a year of foot traffic — latex, oil, and epoxy options ranked.', badge: 'Top Pick', url: '/best-porch-paint' },
      { title: 'Best Fence Stain', description: 'Fence stains tested for UV fade, water beading, and multi-year durability.', badge: 'Top Pick', url: '/best-fence-stain' },
    ],
  },
  {
    name: 'Basement Waterproofing',
    id: 'basement-waterproofing',
    guides: [
      { title: 'Best Basement Waterproofing Systems', description: 'Interior drains, exterior membranes, sump pumps, and DIY — every system compared by cost and result.', badge: '#1 Guide', url: '/best-basement-waterproofing-systems' },
      { title: 'How to Waterproof a Basement', description: 'The complete 5-step DIY playbook: diagnose, drain, repair, seal, and manage interior water.', badge: 'How-To', url: '/how-to-waterproof-a-basement' },
      { title: 'How to Fix a Damp Basement', description: 'Tell condensation from seepage and stop the musty smell and damp walls for good.', badge: 'How-To', url: '/how-to-fix-a-damp-basement' },
      { title: 'Interior vs Exterior Basement Waterproofing', description: 'Which method is actually worth it? Cost, durability, and disruption compared.', badge: 'Comparison', url: '/interior-vs-exterior-basement-waterproofing' },
      { title: 'Best Basement Wall Sealer', description: 'Stop moisture, mold, and water intrusion with the right basement sealer.', badge: 'Review', url: '/best-basement-wall-sealer' },
    ],
  },
  {
    name: 'Polymeric Sand & Pavers',
    id: 'polymeric-sand',
    guides: [
      { title: 'How to Use Polymeric Sand', description: 'Application guide covering sweeping, misting, curing, and common mistakes.', badge: 'How-To', url: '/how-to-use-polymeric-sand' },
      { title: 'Polymeric Sand vs Regular Sand for Pavers', description: 'Is polymeric sand worth 10x the price? We break down the real differences.', badge: 'Comparison', url: '/polymeric-sand-vs-regular-sand-for-pavers' },
      { title: 'Paver Sand vs Play Sand', description: 'Why the sand type matters more than you think for paver installations.', badge: 'Comparison', url: '/paver-sand-vs-play-sand' },
      { title: 'Polymeric Sand Alternatives', description: 'Epoxy, resin, gravel, and other options when polymeric sand isn\'t right.', badge: 'Guide', url: '/polymeric-sand-alternatives' },
      { title: 'Best Polymeric Sand', description: 'Polymeric sands ranked for haze resistance, cracking, and weed prevention.', badge: 'Top Pick', url: '/best-polymeric-sand' },
    ],
  },
  {
    name: 'Tools & Equipment',
    id: 'tools',
    guides: [
      { title: 'Best Surface Cleaner for Pressure Washer', description: 'Spinning surface cleaner attachments tested on driveways and patios for streak-free results.', badge: 'Top Pick', url: '/best-surface-cleaner-for-pressure-washer' },
      { title: 'Best Hookaroon Reviews', description: 'Move, stack, and sort firewood with the best hookaroons on the market.', badge: 'Top Pick', url: '/best-hookaroon-reviews' },
      { title: 'Hookaroon vs Pickaroon', description: 'Similar tools, different designs — which one should you actually buy?', badge: 'Comparison', url: '/hookaroon-vs-pickaroon' },
      { title: 'Tekton Tools Review', description: 'Are Tekton\'s USA-designed tools worth it? We tested wrenches, sockets, and more.', badge: 'Brand Review', url: '/tekton-tools-review' },
      { title: 'Ryobi Tools Review', description: 'Is Ryobi\'s ONE+ system the best value in cordless tools? Full platform review.', badge: 'Brand Review', url: '/ryobi-tools-review' },
      { title: 'Best Brush for Water-Based Polyurethane', description: 'Synthetic brushes tested for smooth, streak-free poly application.', badge: 'Review', url: '/best-brush-for-water-based-polyurethane' },
      { title: 'Best Polyurethane for Stairs', description: 'Oil vs water-based poly ranked by durability, drying time, and finish.', badge: 'Review', url: '/best-polyurethane-for-stairs' },
      { title: 'Rust Converter vs Rust Remover', description: 'Chemical vs mechanical rust treatment — when to use each approach.', badge: 'Comparison', url: '/rust-converter-vs-rust-remover' },
    ],
  },
  {
    name: 'Home Improvement',
    id: 'home',
    guides: [
      { title: 'Best Exterior Caulk', description: 'Exterior caulks tested against sun, rain, and joint movement for siding, trim, and masonry.', badge: 'Top Pick', url: '/best-exterior-caulk' },
      { title: 'Spackle vs Putty', description: 'Nail holes, drywall damage, and wood repairs — which filler to use when.', badge: 'Comparison', url: '/spackle-vs-putty' },
      { title: 'Barn Door vs French Door', description: 'Space, style, sound, and cost compared for interior door upgrades.', badge: 'Comparison', url: '/barn-door-vs-french-door' },
    ],
  },
  {
    name: 'Men\'s Grooming',
    id: 'grooming',
    guides: [
      { title: '8 Best Men\'s Back Shavers (2026)', description: 'We bought and tested 12+ back shavers over 90 days. Only 4 made the cut.', badge: '#1 Guide', url: '/best-mens-back-shavers' },
      { title: 'Braun Type 5544 vs Series 7', description: 'In-depth performance test comparing two of Braun\'s most popular grooming tools.', badge: 'Head-to-Head', url: '/braun-type-5544-vs-series-7' },
      { title: 'The Brutal Truth About Back Hair', description: '50%+ of men have back hair. Only 24% groom it regularly. Science and solutions.', badge: 'Trending', url: '/the-brutal-truth-about-back-hair' },
      { title: 'What Is a Buzz Cut? The Complete Guide', description: 'Everything about buzz cuts: guards, face shapes, DIY tutorial, and styling.', badge: 'Guide', url: '/buzz-cut-guide' },
      { title: 'How to Shave Back Hair by Yourself (2026)', description: 'Step-by-step DIY guide to shaving your back hair solo.', badge: 'How-To', url: '/how-to-shave-back-hair' },
    ],
  },
];

const allGuides = categories.flatMap(c => c.guides);

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Guides of 2026 | The Honest Reviewers',
  description: "Expert-tested guides for home improvement, sealers, tools, and grooming. Hands-on reviews, real data, honest verdicts.",
  itemListElement: allGuides.map((guide, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Article',
      name: guide.title,
      description: guide.description,
      url: `https://www.thehonestreviewers.com${guide.url}`,
    },
  })),
};
---
<Layout
  title="Best Guides of 2026 | The Honest Reviewers"
  description="Expert-tested guides for driveway sealers, paver sealers, tools, home improvement, and grooming. Real data, honest verdicts, zero sponsorships."
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated for 2026
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        All <span class="text-[#1E90FF]">Expert-Tested</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        64 hands-on tested guides covering sealers, tools, home improvement, and grooming. Real data, honest verdicts, zero sponsored picks.
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map(cat => (
          <a href={`#${cat.id}`} class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700 hover:bg-[#1E90FF] hover:text-white hover:border-[#1E90FF] transition-colors no-underline">
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Testing Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">Our Testing Process</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Every product on this site was purchased with our own money, tested in-house for a minimum of 30 days, and verified against thousands of real user reviews on Reddit and Amazon. We accept zero free samples or sponsorships.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Categorized Guides -->
    {categories.map(category => (
      <section id={category.id} class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-black text-[#333333] mb-8 pb-4 border-b-2 border-gray-200">
          {category.name}
          <span class="text-base font-normal text-gray-400 ml-3">{category.guides.length} guides</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.guides.map(guide => (
            <a
              href={guide.url}
              class="block bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[#1E90FF]/30 transition-all group no-underline"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-[#FF4500]/10 text-[#FF4500] px-2.5 py-0.5 rounded-full text-xs font-black uppercase">
                  {guide.badge}
                </span>
              </div>
              <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
                {guide.title}
              </h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{guide.description}</p>
              <div class="flex items-center gap-1 text-[#1E90FF] text-sm font-bold">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-8 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="p-10 lg:p-14">
          <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Guides?</h2>
          <p class="text-gray-400 leading-relaxed mb-6">
            We evaluate every product using a rigorous scoring system across five dimensions:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">1</span>
              <p class="font-bold text-white text-sm">Performance (30%)</p>
              <p class="text-gray-400 text-xs">Real-world effectiveness, durability, and consistency over time.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">2</span>
              <p class="font-bold text-white text-sm">Build Quality (20%)</p>
              <p class="text-gray-400 text-xs">Materials, construction, and long-term durability.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">3</span>
              <p class="font-bold text-white text-sm">Value for Money (20%)</p>
              <p class="text-gray-400 text-xs">Price relative to performance at every price point.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">4</span>
              <p class="font-bold text-white text-sm">Ease of Use (20%)</p>
              <p class="text-gray-400 text-xs">Application difficulty, ergonomics, and learning curve.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">5</span>
              <p class="font-bold text-white text-sm">Community (10%)</p>
              <p class="text-gray-400 text-xs">Reddit, forums, and verified reviews to validate findings.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== NEWSLETTER CTA ========== -->
    <section class="mb-8">
      <div class="bg-[#1E90FF] rounded-3xl p-10 lg:p-16 text-white text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <h2 class="text-3xl font-black mb-4 relative z-10">Get Notified When We Drop New Guides</h2>
        <p class="text-white/80 mb-8 max-w-xl mx-auto relative z-10">
          Join 50k+ readers who get our weekly grooming picks, exclusive deals, and honest verdicts delivered straight to their inbox.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto relative z-10">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-3 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-white border-0"
          />
          <button class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-6 py-3 rounded-xl font-bold transition-colors shrink-0 cursor-pointer">
            Subscribe Free
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>
