                    <td class="px-4 py-4 font-black text-gray-900">Culligan MaxClear Venture</td>
                    <td class="px-4 py-4 text-gray-700">IAPMO R&amp;T</td>
                    <td class="px-4 py-4 text-gray-700">42, 53, 401, 372</td>
                    <td class="px-4 py-4 text-gray-700">Few; data sheet matches listing</td>
