                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Use</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Watch out for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cut-off wheel</td>
