    "id": "ryobi-pblag01b",
    "name": "Ryobi ONE+ HP 18V Brushless 4-1/2\" Angle Grinder (PBLAG01B)",
    "category": "4-1/2\", 18V Brushless",
    "badge": "Best Budget Cordless",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 10,
    "pros": [
      "9,200 RPM brushless motor on the ONE+ battery platform",
      "Tool-free wheel removal",
      "Three-position side handle",
      "Ships with grinding and cut-off guards",
      "Three-year manufacturer warranty"
