---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best Crawl Space Dehumidifiers",
    "url": "/best-crawl-space-dehumidifier/"
  },
  {
    "title": "Best Whole-House Dehumidifiers",
    "url": "/best-whole-house-dehumidifier/"
  },
  {
    "title": "Best Dehumidifiers With a Pump",
    "url": "/best-dehumidifier-with-pump/"
  },
  {
    "title": "Best Attic Fans",
    "url": "/best-attic-fan/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "6 Best Attic Dehumidifiers in 2026: For Sealed and Spray Foam Attics";
const description =
  "The best attic dehumidifiers for sealed and spray foam attics, plus when a vented attic needs air sealing and ventilation fixes instead of a dehumidifier.";

const PRODUCTS = [
  {
    "id": "santa-fe-compact70-crawl-space",
    "name": "Santa Fe Compact70 Dehumidifier 4033600",
    "category": "70 PPD at 80°F/60%, 47 at 70°F, 12 x 12 x 21 Inches, Hang Kit Available",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "12 by 12 by 21 inch cabinet, sized to fit between framing for hanging",
      "Santa Fe publishes a 70°F figure (47 pints) as well as the 80°F rating",
      "Optional hang kit, supply and return duct kits and a condensate pump with a 20-foot hose",
      "580 watts and 5.1 amps on a standard 115-volt circuit, with auto restart"
    ],
    "cons": [
      "Rated operating range is 49°F to 95°F, so it belongs in a conditioned attic, not a vented one",
      "No built-in pump; the Santa Fe pump is an extra purchase"
    ],
    "bottomLine": "The best all-round choice for a sealed spray foam attic: small enough to hang between rafters, ductable, efficient and honest about its output at realistic temperatures.",
    "description": "Santa Fe is Therma-Stor's residential brand, and the Compact70 is its smallest unit, the one installers reach for when space is the constraint. Santa Fe rates it at 70 pints per day at 80°F and 60% relative humidity and, more usefully, 47 pints at 70°F and 60%, which is much closer to conditions in a sealed attic tied into the house. The data sheet lists an energy factor of 2.4 liters per kWh at 80°F, a 150 CFM blower, 580 watts and 5.1 amps on a standard 115-volt circuit, and a 12 by 12 by 21 inch cabinet weighing 55 pounds. That footprint is the attraction: Santa Fe says it is sized to fit between floor joists for hanging installation, and the same logic applies to rafters or a platform in a sealed attic. The accessory list is what makes it attic-friendly: a hang kit (part 4036695), separate supply and return duct kits, and a condensate pump with a 20-foot hose for when gravity drainage is not possible. It has a 3/4-inch threaded drain, an 8-foot gravity hose and auto restart after a power cut. The limit is heat: Santa Fe lists a 95°F maximum operating temperature, so it is for conditioned attics only."
  },
  {
    "id": "aprilaire-e080-pro",
    "name": "AprilAire E080 Pro 80-Pint Whole-House Dehumidifier",
    "category": "80 PPD at 80°F/60%, 65 at 73°F, 10-Inch Duct Collars, Ducted",
    "badge": "Best for Ducting Into the HVAC",
    "amazonUrl": "#",
    "pros": [
      "Published 65 pints per day at 73°F and 60%, plus 80 at 80°F",
      "Energy factor of 2.8 L/kWh at 80°F, the most efficient listed here",
      "10-inch inlet and outlet collars and a backdraft damper for tying into ductwork",
      "Five-year warranty and 45 dBA ducted noise rating"
    ],
    "cons": [
      "63 pounds and 14 by 15 by 26 inches, so check the attic hatch first",
      "Dehumidification inlet range is 50°F to 104°F, so not for an unconditioned attic"
    ],
    "bottomLine": "The pick when the air handler already lives in a sealed attic and you want the dehumidifier ducted into the HVAC system to treat the attic and the house together.",
    "description": "In many sealed attics the air handler and ductwork are already up there, and the cleanest way to dehumidify is to tie a ducted unit into that system. The E080 is AprilAire's mid-size whole-house dehumidifier, and AprilAire lists the attic among its common installation locations. The spec sheet gives 80 pints per day at 80°F and 60% relative humidity and 65 pints at 73°F and 60%, with energy factors of 2.8 and 2.35 liters per kWh, the best efficiency in this guide. Airflow is 185 CFM at zero static pressure and 135 CFM at 0.2 inches, which is the more realistic figure once ducts are attached. It draws 4.8 amps, has 10-inch inlet and outlet collars, a backdraft damper at the outlet, a washable MERV 8 filter and corrosion-resistant aluminum coils, and is rated at 45 dBA ducted. The cabinet is 14 by 15 by 26 inches and weighs 63 pounds, and the inlet air range for dehumidification is 50°F to 104°F. There is no built-in pump, so pair it with one if the drain has to rise. The Pro bundle sold on Amazon adds installation accessories; warranty is five years."
  },
  {
    "id": "alorair-sentinel-hd55p",
    "name": "AlorAir Sentinel HD55P Dehumidifier with Pump",
    "category": "55 PPD at AHAM, Built-In Pump, Rated 33°F to 105°F",
    "badge": "Best With a Built-In Pump",
    "amazonUrl": "#",
    "pros": [
      "Built-in condensate pump with a 19.6-foot hose, plus a gravity drain option",
      "Spec sheet lists a 33°F to 105°F operating range",
      "About 44 pounds and under 12 inches tall, light enough to hang with AlorAir's kit",
      "3.51 amps and 153 CFM on a standard 115-volt outlet"
    ],
    "cons": [
      "MERV-1 filter is coarse; add better filtration if the attic is dusty",
      "Listings disagree on ENERGY STAR status for the pump version"
    ],
    "bottomLine": "The easiest install in this guide for an attic with no downhill drain route: the pump is built in, the unit is light, and AlorAir's hanging kit is rated for attic use.",
    "description": "Drainage is the hardest part of most attic installs, and the HD55P solves it in the box. It is the pump version of AlorAir's popular Sentinel HD55, with a built-in condensate pump and a hose the Amazon listing gives as 19.6 feet, so water can be pushed across the attic and down to a drain, a sink or an existing condensate line. It also keeps a gravity drain mode, a sensible backup if the pump ever fails. AlorAir's spec sheet rates it at 55 pints per day at 80°F and 60% and 120 pints at saturation, for up to about 1,500 square feet, with a functioning temperature range of 33°F to 105°F, which gives it more heat headroom than the Santa Fe. It draws 3.51 amps, moves 153 CFM, is listed at under 57 dBA and has an efficiency of 2.3 liters per kWh. The cabinet is 17.64 by 11.69 by 11.85 inches and weighs 44.4 pounds, and AlorAir's hanging kit instructions explicitly include attic installation. The filter is a coarse MERV-1, so in a dusty attic plan on a better pre-filter. Listings disagree on whether this pump version carries ENERGY STAR, so check the current listing if that matters to you."
  },
  {
    "id": "alorair-sentinel-hd35-crawl-space",
    "name": "AlorAir Sentinel HD35P Wi-Fi Dehumidifier with Pump",
    "category": "35 PPD at AHAM, Built-In Pump, Wi-Fi, Rated 33.8°F to 110°F",
    "badge": "Best for Small Attics",
    "amazonUrl": "#",
    "pros": [
      "Widest listed heat range here: 33.8°F to 110°F",
      "Built-in pump drainage and ENERGY STAR listed on the spec sheet",
      "Just 2.9 amps and 39.7 pounds, 11.4 inches tall",
      "Wi-Fi version lets you watch attic humidity from your phone"
    ],
    "cons": [
      "35 pints at AHAM leaves little headroom for a large or leaky attic",
      "Its 115 CFM airflow is modest for long duct runs"
    ],
    "bottomLine": "The right size for a small sealed attic, a finished attic room or a kneewall space, and the lowest-cost way to get a pump and remote monitoring.",
    "description": "Many sealed attics are small, especially over a ranch house addition or a bonus room, and they do not need a 70-pint machine. The HD35P is AlorAir's compact pump model, and the Wi-Fi version sold on Amazon adds app monitoring, which is genuinely useful for a space you rarely climb into. AlorAir's spec sheet rates it at 35 pints per day at AHAM conditions and 70 pints at saturation, for up to about 1,000 square feet. Its functioning temperature range is listed as 33.8°F to 110°F, the widest heat tolerance of any unit here, which gives some margin in a sealed attic that runs warm on summer afternoons. It draws just 2.9 amps, moves 115 CFM, is rated at 55 dBA and an efficiency of 2.0 liters per kWh, and weighs 39.7 pounds in a cabinet 15.35 by 11.2 by 11.4 inches. Drainage is by built-in pump, and AlorAir's hanging kit is listed as compatible. The limit is capacity: 35 pints with modest airflow will not keep up with a large attic, open-cell foam over a humid climate, or a space that still has air leaks to the outside. In those cases, step up to the HD55P or the Santa Fe."
