                    <td class="px-4 py-4 text-gray-700">40-50W</td>
                    <td class="px-4 py-4 text-gray-700">17 to 22 hr</td>
                    <td class="px-4 py-4 text-gray-700">35 to 45 hr</td>
                  </tr>
