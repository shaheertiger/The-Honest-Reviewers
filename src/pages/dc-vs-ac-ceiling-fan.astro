                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC motor fan</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">DC motor fan</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Typical draw on high, 48-52 in fan</td>
