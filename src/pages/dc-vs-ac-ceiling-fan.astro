                    <td class="px-4 py-4 font-black text-gray-900">Speeds</td>
                    <td class="px-4 py-4 text-gray-700">Usually 3</td>
                    <td class="px-4 py-4 text-gray-700">Usually 5-6, sometimes more</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Noise</td>
                    <td class="px-4 py-4 text-gray-700">Can hum, especially on high</td>
                    <td class="px-4 py-4 text-gray-700">Quieter, particularly at low speeds</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Control</td>
