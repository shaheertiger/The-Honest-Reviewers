const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "6 Best Humidifiers for Bedrooms: Quiet Picks That Won't Wake You";
const description =
  "Quiet, dark and easy to clean: six bedroom humidifiers chosen on published noise ratings, sleep modes, tank size and cleaning, plus sizing and placement advice.";

