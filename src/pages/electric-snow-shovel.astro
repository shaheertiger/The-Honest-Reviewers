                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Electric shovel</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Single-stage blower</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Hand shovel</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
