const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Humidifiers for Allergies",
          item: "https://www.thehonestreviewers.com/best-humidifier-for-allergies/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What type of humidifier is best for allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evaporative humidifiers are usually the better choice for allergy sufferers. They release water vapor rather than mist, leave minerals behind in the wick, and are self-limiting as humidity rises. Pair one with a built-in humidistat or a separate hygrometer so you can hold humidity around 40 to 45 percent, below the levels that favor dust mites and mold."
          }
        },
        {
          "@type": "Question",
          "name": "Can a humidifier make allergies worse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it pushes humidity too high or is not cleaned. Dust mites and mold thrive in damp air, and the EPA recommends keeping indoor humidity below 60 percent, ideally 30 to 50. A dirty tank can also put bacteria and mold into the air, particularly from ultrasonic units. Measure humidity and clean on schedule."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity level is best for allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for roughly 40 to 45 percent. The EPA's recommended range is 30 to 50 percent, and allergy organizations advise keeping humidity low to control dust mites. The lower half of the band eases winter dryness while staying clear of damp conditions. Lower it further if windows start to show condensation in very cold weather."
          }
        },
        {
          "@type": "Question",
          "name": "Is a humidifier or an air purifier better for allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. A HEPA air purifier removes airborne allergens such as pollen, dander and dust. A humidifier only adds moisture to ease dryness and does not remove allergens. Many allergy sufferers use both in winter, keeping them on opposite sides of the room and using distilled water in any ultrasonic humidifier."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I clean a humidifier if I have allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Empty and rinse the tank every day rather than topping it up, and clean and disinfect it thoroughly at least weekly, or every few days as the EPA suggests, following your manual. Replace wicks and filters on schedule, sooner with hard water. A humidifier that is not cleaned can make allergy symptoms worse."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need distilled water for an allergy humidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In an ultrasonic humidifier, yes, because it atomizes the tank water and sends minerals into the air as white dust. Evaporative units leave minerals in the wick, so tap water is generally fine, though hard water shortens wick life. Distilled water reduces minerals but does not stop microbial growth, so cleaning still matters."
          }
        },
        {
          "@type": "Question",
          "name": "Will a humidifier help a dry nose from allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A humidifier can ease the dryness that winter heating causes, including a dry nose and throat, when indoor humidity is very low. It does not treat the allergy itself. Keep humidity in a moderate range and clean the unit regularly. If symptoms persist, see your doctor or an allergist rather than raising the humidity further."
          }
        }
      ],
    },
