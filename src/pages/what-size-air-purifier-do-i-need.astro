const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Size Air Purifier Do I Need?",
          item: "https://www.thehonestreviewers.com/what-size-air-purifier-do-i-need/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size air purifier do I need for a bedroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical 150 to 250 square foot bedroom, look for a dust CADR of 160 to 260 CFM, which usually means a unit marketed for 350 to 550 square feet. That delivers four to five air changes an hour at a moderate fan speed — the level at which allergy sufferers consistently notice a difference — rather than the two the box rating assumes."
          }
        },
        {
          "@type": "Question",
          "name": "How do I calculate what size air purifier I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Multiply floor area by ceiling height to get room volume, multiply CADR by 60 to get hourly output, then divide the second by the first for air changes per hour. Aim for four to five for allergies, six or more for smoke. The shortcut is to buy a dust CADR figure roughly equal to your room's square footage."
          }
        },
        {
          "@type": "Question",
          "name": "What is CADR and why does it matter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean air delivery rate measures how much filtered air a purifier produces, in cubic feet per minute, verified independently under the AHAM programme. It is the only genuinely comparable performance figure in the category. It is published separately for smoke, dust and pollen, and smoke is the most demanding of the three."
          }
        },
        {
          "@type": "Question",
          "name": "Is it better to buy an air purifier that is too big?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, within reason. An oversized unit run on its quiet setting delivers the same clean air as a correctly sized one running at maximum, while being far quieter and less stressed. Since the quiet setting is the one you will actually use overnight, buying a size up is the standard advice rather than an extravagance."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need one air purifier per room?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For the rooms you spend real time in, yes. Air mixes poorly between rooms and hardly at all through a closed door, so one large machine in a hallway leaves the bedroom largely untreated. If you buy one purifier, put it in the bedroom and close the door — that is where the uninterrupted hours are."
          }
        },
        {
          "@type": "Question",
          "name": "Does ceiling height change what size purifier I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Considerably. Sizing charts assume 8-foot ceilings, so a 10-foot ceiling adds 25 percent to the volume and a 12-foot ceiling adds 50 percent. Multiply your required CADR by the same proportion, or the machine will run permanently at maximum without ever reaching the target air change rate."
          }
        },
        {
          "@type": "Question",
          "name": "What size air purifier do I need for smoke?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Size on the smoke CADR figure rather than the headline number, target six or more air changes an hour, and go one size larger than the arithmetic suggests. Smoke particles are small and, during an active event, arrive continuously — so seal the room as well, because no purifier outruns an open window."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
