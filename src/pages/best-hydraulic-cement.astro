---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "How to Use Hydraulic Cement",
    "url": "/how-to-use-hydraulic-cement/"
  },
  {
    "title": "Best Basement Wall Sealers",
    "url": "/best-basement-wall-sealer/"
  },
  {
    "title": "Basement Crack Repair",
    "url": "/basement-crack-repair/"
  },
  {
    "title": "Water Coming Through Basement Floor",
    "url": "/water-coming-through-basement-floor/"
  },
  {
    "title": "Best Flooring for Basement",
    "url": "/best-flooring-for-basement/"
  },
  {
    "title": "Basement Moisture Control",
    "url": "/basement-moisture-control/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "7 Best Hydraulic Cements for Stopping Basement Leaks";
const description =
  "The best hydraulic cement for plugging active basement leaks, compared on set time, strength and package size, from DRYLOK Fast Plug to Quikrete and Xypex.";

const PRODUCTS = [
  {
    "id": "drylok-fast-plug",
    "name": "DRYLOK Fast Plug Hydraulic Cement",
    "badge": "Best Overall",
    "category": "Hydraulic Cement, Powder",
    "description": "DRYLOK Fast Plug is the hydraulic cement most homeowners should buy first, and the reason is the paperwork as much as the powder. DRYLOK's product data sheet gives a set time of 3 to 5 minutes, a mix of 3 parts powder to 1 part water to a putty consistency, coverage of about 16 cubic inches per pound, and an application requirement of 40°F and above. It also publishes a strength curve: 311 psi at 1 hour, 2,650 psi at 24 hours and 3,050 psi at 7 days. The data sheet advises mixing only what you can place in about three minutes, which is the practical working window. Fast Plug comes in 4, 10 and 50 pound sizes, so a single leak and a whole foundation are both covered, and it can be painted with DRYLOK waterproofer once set, which makes it the natural first step before a wall coating. Like all cementitious products it contains crystalline silica, so wear a dust mask when mixing.",
    "pros": [
      "Data sheet set time of 3 to 5 minutes",
      "Published strength curve, 2,650 psi at 24 hours",
      "Sold in 4, 10 and 50 lb sizes",
      "Paintable with DRYLOK waterproofers once set"
    ],
    "cons": [
      "Roughly three minutes of real working time",
      "Not for use below 40°F",
      "Contains crystalline silica; mask up when mixing"
    ],
    "bottomLine": "The well-documented, widely stocked hydraulic cement to reach for first on a leaking basement wall."
  },
  {
    "id": "quikrete-hydraulic-water-stop",
    "name": "Quikrete Hydraulic Water-Stop Cement (No. 1126)",
    "badge": "Best Value",
    "category": "Hydraulic Cement, Powder",
    "description": "Quikrete's Hydraulic Water-Stop Cement is the alternative you will find on the shelf next to Fast Plug, and on paper it is every bit as capable. Quikrete's data sheet lists a final set of 5 minutes or less under ASTM C191, the standard needle test for cement set time, and compressive strength of 1,000 psi at 2 hours rising to 5,500 psi at 28 days under ASTM C109. It advises mixing no more than you can place in 2 to 3 minutes, warns that hot temperatures reduce set time, and recommends warm water below 50°F. Retail listings describe it as stopping active leaks in 3 to 5 minutes. It comes in 10, 20 and 50 pound pails. Practically, it behaves much like Fast Plug, and buying whichever is in stock is a sensible strategy. Do not confuse it with Quikrete's FastSet Water-Stop, a different, faster product.",
    "pros": [
      "Final set of 5 minutes or less per ASTM C191",
      "1,000 psi at 2 hours, 5,500 psi at 28 days on the data sheet",
      "Sold in 10, 20 and 50 lb pails",
      "Widely stocked at home centers and hardware stores"
    ],
    "cons": [
      "Only 2 to 3 minutes of working time",
      "Set time shortens in heat",
      "Easy to confuse with Quikrete's faster FastSet product"
    ],
    "bottomLine": "An equally capable, often cheaper alternative to Fast Plug; buy whichever your store stocks."
  },
  {
    "id": "quikrete-fastset-water-stop",
    "name": "Quikrete FastSet Water-Stop Cement",
    "badge": "Fastest for Running Water",
    "category": "Rapid-Set Repair Cement",
    "description": "When water is not seeping but actually running out of a hole, a faster product earns its place, and Quikrete's FastSet Water-Stop is built for that. Quikrete's product page describes it as a rapid-setting repair material for stopping active leaks in masonry and concrete, above or below grade, that stops flowing water in 60 to 90 seconds. Ace Hardware's listing gives a 2-minute set time, though that figure does not appear in the manufacturer text we found. It is sold in 20 pound pails, and Quikrete gives a yield of about 0.17 cubic feet per pail. The very short window is both the advantage and the risk: there is time to form a plug and hold it, and almost no time for anything else. Mix tiny batches, have everything staged, and keep this one for actively running leaks rather than routine crack filling.",
    "pros": [
      "Stops flowing water in 60 to 90 seconds, per Quikrete",
      "Rated for above and below-grade repairs",
      "20 lb pail covers several leaks",
      "The right tool when water is actively running"
    ],
    "cons": [
      "Extremely short working time",
      "Set time figures differ between manufacturer and retailer",
      "Overkill for slow seeps and dry cracks"
    ],
    "bottomLine": "The plug for a hole that is actively running water, if you can work fast."
  },
  {
    "id": "sakrete-leak-stopper",
    "name": "Sakrete Leak Stopper Hydraulic Cement",
    "badge": "Best for Underwater Leaks",
    "category": "Hydraulic Cement, Powder",
    "description": "Sakrete Leak Stopper is a solid alternative with an unusually clear technical data sheet. It lists an initial set of 1 to 3 minutes under ASTM C191 and a final set of 3 to 4 minutes, with compressive strength above 1,000 psi at 2 hours and 3,000 psi at 28 days. The data sheet specifies application between 40°F and 90°F for both air and substrate, and describes placing the mixed material in a plastic bag and forcing it into the opening for underwater or active leaks, a technique that also works well in a basement. Retailers sell it in 10 and 20 pound sizes. The faster initial set means it starts stiffening sooner than Fast Plug, so mix smaller batches. It is a good pick where your local store stocks Sakrete rather than DRYLOK or Quikrete.",
    "pros": [
      "Clear data sheet: 1 to 3 minute initial, 3 to 4 minute final set",
      "Over 1,000 psi at 2 hours",
      "Rated for active and underwater leaks",
      "Defined 40°F to 90°F application range"
    ],
    "cons": [
      "Starts stiffening faster than Fast Plug",
      "Smaller package range than DRYLOK",
      "Lower 28-day strength than Quikrete's published figure"
    ],
    "bottomLine": "A well-specified alternative, especially handy for leaks that are actively wet."
  },
  {
    "id": "sikaset-waterplug",
    "name": "SikaSet Waterplug (formerly MasterSeal 590)",
    "badge": "Best Pro-Grade Option",
    "category": "Fast-Setting Water Stop Mortar",
    "description": "Contractors may know this product by its older names, Thoro Waterplug and later MasterSeal 590, and Sika now lists it as SikaSet Waterplug. It is a one-component, cement-based fast-setting mortar for plugging active water leaks. Retailer listings give a set time of about 3 to 5 minutes, and manufacturer material says it can be topcoated with an appropriate product after 15 minutes, which is useful when the plug is the first step before a waterproof coating. We could not read the current Sika technical data sheet, so the set time here comes from retailer spec fields, and you should check the TDS for an authoritative figure. It is sold in quart, 10 lb and 50 lb sizes through hardware and commercial suppliers. The main reason to choose it is familiarity: if your contractor specifies Waterplug, this is the same product under a new name.",
    "pros": [
      "Long track record under the Thoro Waterplug name",
      "Topcoat after about 15 minutes, per manufacturer material",
      "Sizes from a quart to a 50 lb pail",
      "Sold through hardware and pro supply channels"
    ],
    "cons": [
      "Set time here comes from retailers, not the current TDS",
      "Name changes make it confusing to find",
      "Pricier than home-center brands"
    ],
    "bottomLine": "The contractor-familiar Waterplug, now under the Sika name, for when a pro specifies it."
  },
  {
    "id": "xypex-patchn-plug",
    "name": "Xypex Patch'n Plug",
    "badge": "Best With a Crystalline System",
    "category": "Fast-Setting Hydraulic Repair Compound",
    "description": "Xypex Patch'n Plug is the choice when the plug is the first step in a crystalline waterproofing repair rather than a standalone fix. Xypex's North American data sheets list an initial set of 1:30 to 4:00 and a final set of 4:30 to 9:00 under ASTM C266, with a note that results vary significantly with conditions, while the newer metric sheet uses a different test and gives 2 to 4 minutes initial and 5 to 9 minutes final. The somewhat longer final set gives more time to shape and finish the plug than the fastest home-center products. Patch'n Plug is designed to work with Xypex's crystalline products, which react with moisture in the concrete to block capillary pores, so it makes most sense if you plan to treat the wall with that system afterwards. It is sold mainly through specialty and pro channels.",
    "pros": [
      "Final set of 4:30 to 9:00, more time to shape the plug",
      "Designed to pair with Xypex crystalline waterproofing",
      "Data sheets published for multiple test standards",
      "Suited to structural concrete repairs"
    ],
    "cons": [
      "Mostly sold through specialty and pro suppliers",
      "Set figures vary by data sheet version and test",
      "Costs more than home-center hydraulic cement"
    ],
    "bottomLine": "The plug to use when the wall is getting a crystalline waterproofing treatment afterwards."
  },
  {
    "id": "rapid-set-water-stop",
    "name": "Rapid Set WATER STOP",
    "badge": "Fastest to Full Strength",
    "category": "Rapid-Set Repair Material",
    "description": "CTS Cement's Rapid Set WATER STOP is a blend of Rapid Set hydraulic cement and graded fine aggregates designed for stopping leaks in concrete and masonry. CTS's datasheet says it sets in less than 5 minutes and achieves structural strength in 1 hour, which is the fastest strength gain claim on this list and useful when a repair needs to take load or a coating soon after. It is sold in a 25 pound box. Rapid Set products use a calcium sulfoaluminate cement rather than ordinary portland cement, which is where the fast strength comes from. The trade-off is availability: Rapid Set is easiest to find at concrete supply houses and some home centers rather than every hardware store, and CTS's guideline specification is written for professionals, so homeowners get less hand-holding than with DRYLOK or Quikrete.",
    "pros": [
      "Sets in under 5 minutes, per CTS",
      "Structural strength in 1 hour, per CTS",
      "25 lb box suits larger repairs",
      "Aggregate blend for a stronger patch"
    ],
    "cons": [
      "Harder to find than DRYLOK or Quikrete",
      "Documentation aimed at professionals",
      "Only one package size listed"
    ],
    "bottomLine": "The fastest route to a load-bearing patch, if you can find it locally."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Hydraulic Cement",
          item: "https://www.thehonestreviewers.com/best-hydraulic-cement/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best hydraulic cement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most basement leaks, DRYLOK Fast Plug is the best all-round choice, with a published 3 to 5 minute set time, a clear strength curve and sizes from 4 to 50 pounds. Quikrete Hydraulic Water-Stop performs similarly on paper and is a good alternative if that is what your store stocks."
          }
        },
        {
          "@type": "Question",
          "name": "How long does hydraulic cement take to set?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most set in about three to five minutes. DRYLOK lists 3 to 5 minutes, Quikrete a final set of 5 minutes or less, and Sakrete an initial set of 1 to 3 minutes. Warm water and warm rooms shorten the set, and your real working window is usually only two to three minutes."
          }
        },
        {
          "@type": "Question",
          "name": "Can hydraulic cement stop running water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, that is what it is designed for. For water actively running out of a hole, a faster product such as Quikrete FastSet Water-Stop, which Quikrete says stops flowing water in 60 to 90 seconds, is easier to use. Form a plug, press it in and hold it until it sets."
          }
        },
        {
          "@type": "Question",
          "name": "Is hydraulic cement waterproof?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The set cement is dense and seals the opening it fills, but it is a plug, not a waterproof coating. It stops a leak through a specific hole or crack. For general seepage through a wall, apply a masonry waterproofer over the wall after plugging."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use hydraulic cement on a basement floor crack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for non-moving cracks that leak. Undercut the crack, clean it, and pack the cement in. Water coming up at the joint between the floor and wall is often a drainage or pressure problem, though, and plugging it may just move the water elsewhere."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint over hydraulic cement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes. DRYLOK says Fast Plug can be painted with its waterproofers once set, and Sika says Waterplug can be topcoated after about 15 minutes. Check the coating's own instructions for cure time before painting."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a hydraulic cement repair last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A properly undercut plug in a non-moving crack can last for many years. Plugs fail early when the crack was not undercut, the batch was re-tempered, or the crack is still moving. If water runs around the plug after the next storm, cut it out and redo it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best hydraulic cement",
      "hydraulic cement for basement leaks",
      "water stop cement",
      "quick setting cement for leaks",
      "hydraulic cement",
      "leak stopper cement"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Hydraulic Cements</span> for Leaks
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Fast-setting, expanding cement that plugs holes and keyed cracks while water is still coming through. Compared on set time, strength and how much working time you actually get.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#drylok-fast-plug"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#what-it-does" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Hydraulic Cement Does</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Picks</a>
          <a href="#set-time" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Set Time Is the Whole Job</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Preparing the Crack</a>
          <a href="#when-not" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. When It Is the Wrong Fix</a>
          <a href="#after" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. After the Plug</a>
          <a href="#buying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Choosing a Size</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          For most basement leaks, DRYLOK Fast Plug is the hydraulic cement to buy, with Quikrete Hydraulic Water-Stop a close, widely stocked alternative. Both set in about three to five minutes. Which one you choose matters less than how you prepare the crack, because the product sets far faster than most people expect and a badly cut crack fails no matter what is in the tub.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-picked" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Picked These Cements
          </h2>

          <p>
            We did not plug leaks in a test wall with seven products and wait for spring rain, and we are not going to claim we did. This guide is built from technical data sheets, which for hydraulic cement are unusually informative, plus retailer listings and the way these products are actually used in basement repairs. Every figure is attributed, and where a retailer number disagrees with the manufacturer, we say so.
          </p>

          <p>
            The comparison that matters is set time. Hydraulic cement exists to harden fast enough to stop water while it is still flowing, so we looked at initial and final set times, the test method behind them, and the working window each manufacturer recommends. Strength comes second, because a plug in a foundation crack does not carry much load, but early strength tells you how soon you can coat over it.
          </p>

          <p>
            We also weighed availability and package size. A product you cannot buy on the Saturday morning your basement is leaking is not much use, so the list leans toward brands sold at home centers and hardware stores, with a few pro products where they offer something specific, such as a longer working time or a crystalline repair system.
          </p>

          <p>
            If you are new to the product, read our guide on <a href="/how-to-use-hydraulic-cement/">how to use hydraulic cement</a> before you open a tub. The technique matters more than the brand, and most failed plugs fail because of how the crack was cut or how the batch was mixed.
          </p>
        </div>

        <div id="what-it-does" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. What Hydraulic Cement Does, and Does Not Do
          </h2>

          <p>
            Hydraulic cement is a rapid-setting cement blended so that it expands very slightly as it cures instead of shrinking. That expansion is the point. Packed into a properly undercut crack or hole, it locks itself in place and seals against the sides, which is why it can stop water that is actively coming through a wall or floor.
          </p>

          <p>
            It is a plug, not a coating. It fills individual holes, cracks and the joints around pipe penetrations; it does not waterproof a whole wall. For broad dampness through block or concrete, a coating such as a masonry waterproofer is the right tool, and our <a href="/best-basement-wall-sealer/">basement wall sealer guide</a> covers those. The usual sequence on a leaking wall is to plug the active leaks with hydraulic cement, then coat the wall.
          </p>

          <p>
            It is also rigid. A crack that is still moving, such as a settlement crack that opens and closes with the seasons, may crack around a hydraulic cement plug, because the plug cannot flex. Those cracks are better served by flexible injection products, which our <a href="/basement-crack-repair/">basement crack repair guide</a> explains.
          </p>

          <p>
            And it does not fix the cause. Water pushed through a wall by saturated soil or poor drainage will look for the next weak point once you plug the first. Hydraulic cement buys time and stops the immediate leak; grading, gutters and drainage stop the water reaching the wall in the first place.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Our 7 Picks
          </h2>

          <p>
            Every set time and strength figure below comes from the manufacturer's technical data sheet or a retailer listing repeating it, and we note where those disagree. We did not lab-test these cements. We picked them on set speed, strength, availability and package size, and checked each against current data sheets. Set times are measured under lab conditions; warm water or a warm basement shortens them noticeably.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
