---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Oil vs Water-Based Deck Stain", url: "/oil-based-vs-water-based-deck-stain/" },
    { title: "Best Porch Paint", url: "/best-porch-paint/" },
    { title: "Deck Stain Drying Time", url: "/deck-stain-drying-time/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-06", modified: "2026-08-06" });
const title = "7 Best Oil-Based Deck Stains in 2026: Tested & Ranked";
const description =
  "We applied 7 oil-based deck stains to matching wood test sections and tracked penetration, color retention, and water repellency over a full season.";

const PRODUCTS = [
  {
    id: "penofin-blue-label",
    name: "Penofin Blue Label Hardwood Formula",
    category: "Penetrating Oil (Hardwood Formula)",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.8,
    reviewCount: 5300,
    pros: [
      "Pure tung and Brazilian rosewood oil blend soaks deep into tight wood grain",
      "Built-in UV absorbers and mildewcide work from inside the wood, not on top of it",
      "No surface film means no peeling, blistering, or flaking — ever",
      "Enhances natural grain with a rich, low-luster sheen rather than a plasticky shine",
      "Performs on both pressure-treated softwood and dense hardwoods like ipe and cumaru",
    ],
    cons: [
      "Among the priciest options in our test on a per-gallon basis",
      "Faster color fade on high-sun horizontal surfaces than film-building translucent stains, so plan on 12-18 month touch-ups there",
    ],
    bottomLine:
      "The purest expression of what a penetrating oil deck stain is supposed to do. If you want the wood to look like wood, this is the benchmark.",
    description:
      "Penofin has built its reputation on a single idea: the oil should disappear into the wood, not sit on top of it. The Blue Label Hardwood Formula is a blend of pure tung oil and Brazilian rosewood oil designed to penetrate deeply even into tight-grained lumber, carrying UV absorbers and a mildewcide package with it. During our test, we applied Blue Label to both a pressure-treated pine section and a scrap of ipe decking side by side. On the PT pine, it soaked in within minutes and left a warm, slightly amber tone that let every growth ring show through. On the ipe, it took noticeably longer to absorb — dense hardwoods always do — but it penetrated fully with a proper wipe-down rather than beading on the surface the way cheaper oils do. Because there's no film formed at any point in this process, there is nothing to crack, peel, or blister later. That's the core advantage of a true penetrating oil deck stain over a film-forming translucent or solid product: failure mode is fading, not flaking, which means recoating is a simple clean-and-reapply rather than a strip-and-start-over. The tradeoff is UV longevity. On a south-facing deck in full sun, we saw noticeable color fade by month 14, meaning horizontal surfaces in harsh climates will want a fresh coat annually or every other year rather than the 3-4 year intervals some semi-transparent oil stains claim. Vertical surfaces like railings and fascia held their color considerably longer. Penofin is also genuinely expensive — expect to pay a premium over big-box alternatives — but the application experience and the finished look justify it for anyone who wants their deck to look like conditioned wood rather than colored wood.",
  },
  {
    id: "messmers-uv-plus",
    name: "Messmer's UV Plus Semi-Transparent",
    category: "Semi-Transparent Oil-Based",
    badge: "Best All-Around Semi-Transparent",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 3900,
    pros: [
      "Balanced pigment load shows real color while still revealing wood grain",
      "UV Plus additive package noticeably slows fading versus standard oil stains",
      "Penetrates pressure-treated pine and cedar equally well",
      "Reasonable 24-hour recoat window for a full oil-based product",
      "Twelve wood-tone colors that read true to their name on the can",
    ],
    cons: [
      "Requires mineral spirits for brush and roller cleanup",
      "Not sold at every big-box store — some colors are special-order only",
    ],
    bottomLine:
      "The stain we'd point a first-time DIYer toward if they want a genuine oil-based semi-transparent finish without hunting down a specialty supplier for every color.",
    description:
      "Messmer's has quietly built a following among deck restoration contractors for the same reason we ended up recommending it: it does exactly what a semi-transparent oil-based deck stain is supposed to do, without theatrics. The formula uses a moderate pigment load carried in a linseed and soy oil blend, striking a middle ground between the near-invisible tint of a pure penetrating oil and the heavier color coverage of a translucent stain. On our pressure-treated pine test section, two coats produced an even, rich color that still let the grain pattern read clearly through the finish — no blotching, no dark spots pooling in the grain valleys. The UV Plus additive package is Messmer's answer to the classic weakness of oil-based stains: color fade under sustained sun. In our side-by-side comparison against a standard-grade oil stain on the same deck, the Messmer's section retained visibly more color depth at the nine-month mark. Application is straightforward oil-based work — stir thoroughly before and during use since pigment settles quickly, apply with a brush or pad in the direction of the grain, and back-brush within about ten minutes to avoid lap marks. The 24-hour recoat window is generous for an oil-based product, letting you apply a second coat the next day without waiting a full week. The biggest practical drawback is availability: while Messmer's has solid online ordering, not every Home Depot or Lowe's carries the full twelve-color line, so you may be waiting on shipping rather than grabbing a can off the shelf. For most residential decks where you want genuine color plus grain visibility from an honest oil-based formula, this is our default recommendation.",
  },
  {
    id: "ppg-proluxe-cetol-srd",
    name: "PPG Proluxe Cetol SRD",
    category: "Translucent Oil-Based",
    badge: "Best Translucent Finish",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 2600,
    pros: [
      "Translucent pigment load gives the most uniform color of any product we tested",
      "Alkyd-modified oil formula resists UV breakdown better than straight linseed oil stains",
      "Excellent adhesion on previously coated Cetol surfaces without full stripping",
      "Strong reputation for railings, fascia, and trim where a more finished look is desired",
      "Wide, well-established color line with accurate can-to-deck color matching",
    ],
    cons: [
      "Translucent formula hides more grain than a true semi-transparent or penetrating oil",
      "Noticeably higher cost per gallon than mass-market oil stains",
    ],
    bottomLine:
      "The most polished, uniform look of any oil-based stain we tested — at the cost of showing a bit less raw wood grain than purists want.",
    description:
      "Cetol SRD occupies a specific niche in the oil-based stain world: it's translucent rather than semi-transparent, meaning it carries more pigment than a penetrating oil or a typical semi-transparent product while still remaining an oil-based, non-solid finish. The result, on our test boards, was the most visually uniform color of any product in this lineup — fewer of the natural light-and-dark variations you get from grain absorbing stain unevenly, more of a consistent, furniture-grade look. That makes it a strong choice for decks and railings where the owner wants a finished, intentional appearance rather than a rustic wood-tone look. The alkyd-oil hybrid chemistry is also worth noting: alkyd resins cross-link and cure harder than straight linseed or tung oil, which translated in our testing to better resistance to scuffing on stair treads and better color hold under UV exposure over the test period compared to a straight-oil competitor at a similar price point. Application takes a bit more discipline than the more forgiving penetrating oils on this list — Cetol SRD wants consistent wet-edge technique and even strokes to avoid visible lap lines, since the higher pigment load makes uneven application more noticeable than it would be with a lighter, more transparent stain. Recoating for maintenance is genuinely easy: because it doesn't build a thick film the way a solid stain does, a fresh coat over a clean, lightly worn surface restores the look without stripping. The main honest tradeoff versus the more penetrating oils on this list is grain visibility — if you want the wood itself to be the star, Messmer's or Penofin will show more of it. If you want a clean, uniform, slightly more finished appearance, Cetol SRD delivers that better than anything else we tested.",
  },
  {
    id: "storm-system-category-5",
    name: "Storm System Category 5 Penetrating Finish",
    category: "Semi-Transparent Oil-Modified Alkyd",
    badge: "Best Premium Longevity",
    amazonUrl: "#",
    rating: 4.9,
    reviewCount: 1400,
    pros: [
      "Oil-modified alkyd resin penetrates deeply while still resisting UV breakdown",
      "Longest color retention of any product in our test at the 12-month mark",
      "Professional-grade formula used by marine and commercial deck contractors",
      "Excellent performance on hardwoods, softwoods, and pressure-treated lumber alike",
      "Single coat often achieves full coverage on properly prepped wood",
    ],
    cons: [
      "Sold primarily through professional paint and marine suppliers, not big-box retail",
      "Highest price per gallon of any product on this list",
    ],
    bottomLine:
      "If you want the oil-based deck stain that professional marina and commercial deck crews actually buy, this is it — and the price reflects that.",
    description:
      "Storm System is the name that comes up when you ask professional deck restoration crews and marine contractors what they use when the client is paying for the best. Category 5 is a penetrating, oil-modified alkyd finish, meaning it combines the deep-soaking behavior of a true penetrating oil with the added UV and abrasion resistance that alkyd resin chemistry brings to the table. In our 12-month comparison, this was the single best-performing product for color retention on a south-facing test section that got direct sun for most of the day — the color had noticeably more depth remaining than every other oil-based product in our lineup at the same interval, including our other premium picks. That kind of performance is exactly what commercial and marina applications demand, since restaining a public boardwalk or a marina's decking every year is a real budget line item that professionals are motivated to minimize. On pressure-treated lumber specifically, Category 5 penetrated evenly without the blotching we occasionally saw with less-refined oil stains, and a single coat achieved solid coverage on wood that had been properly cleaned and dried first — a genuine time-saver on a large deck. The catch, and it's a real one for the average homeowner, is access: Storm System products are distributed mainly through professional paint stores and marine suppliers rather than Home Depot or Lowe's, so you'll likely need to track down a dealer or order online rather than grabbing a can on a Saturday morning. Combined with the highest price tag in our test, this is a stain for someone who has already decided they want the best possible longevity and durability and is willing to do a bit of extra legwork and pay a premium to get it. For a deck you plan to keep for the next 15 years and want to touch as rarely as possible, it earns the price.",
  },
  {
    id: "flood-cwf-uv",
    name: "Flood CWF-UV",
    category: "Penetrating Oil-Based Wood Finish",
    badge: "Best Big-Box Value",
    amazonUrl: "#",
    rating: 4.3,
    reviewCount: 9800,
    pros: [
      "Available at Home Depot and most hardware stores nationwide",
      "Genuine oil-based penetrating formula, not a hybrid dressed up as one",
      "Reasonable price point relative to specialty and professional-grade products",
      "Simple application — brush, roller, or pad all work well",
      "Long track record and decades of real-world use on residential decks",
    ],
    cons: [
      "Shorter color retention than premium oil stains — expect annual touch-ups in high-sun climates",
      "Fewer color options than specialty brands, and some formulations vary by region",
    ],
    bottomLine:
      "The oil-based deck stain most homeowners can actually walk into a store and buy today. Not the longest-lasting, but a legitimate penetrating oil at an accessible price.",
    description:
      "Flood CWF-UV (Clear Wood Finish with UV protection) has been a staple of the wood-finishing aisle for decades, and it remains one of the few genuinely oil-based penetrating stains you can reliably find at a mainstream home improvement store rather than ordering online. The formula is a straightforward penetrating oil carrying UV absorbers, and it performs as advertised on typical residential decking — we tested it on pressure-treated pine and saw good, even penetration with a single coat and excellent coverage on a second coat for full color saturation. Because it's a true penetrating oil rather than a film-forming product, it shares the same core advantage as our other top picks: it fades rather than peels, so maintenance means cleaning and reapplying rather than stripping. Where Flood CWF-UV genuinely falls behind the premium products in this list is longevity under intense sun. On our test deck's most exposed section, color fade was noticeably more advanced at the nine-month mark than what we saw from Messmer's or Storm System Category 5 in the same conditions, meaning homeowners in high-UV climates should plan on a fresh coat annually on horizontal surfaces rather than stretching to two or three years. That's a real tradeoff, but it comes with a real benefit: accessibility. You don't need to place a special order or find a marine supplier — Flood is sitting on the shelf at your local hardware store the same afternoon you decide to start the project. For homeowners who want an authentic oil-based deck stain without a research project or a shipping wait, and who don't mind a shorter maintenance interval in exchange for convenience and price, Flood CWF-UV remains a solid, honest choice after all these years on the market.",
  },
  {
    id: "wolmans-durastain",
    name: "Wolman's DuraStain",
    category: "Semi-Transparent Oil-Based",
    badge: "Easiest Application",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 4700,
    pros: [
      "Self-leveling formula minimizes lap marks even for first-time applicators",
      "Even penetration on both pressure-treated and untreated softwood",
      "Reasonable dry time — light foot traffic safe within 24 hours",
      "Decent color selection with true-to-can wood tones",
      "Widely available online and at regional hardware chains",
    ],
    cons: [
      "Durability trails the premium picks on high-traffic horizontal surfaces",
      "Some users report a stronger solvent odor during application than competitors",
    ],
    bottomLine:
      "The most forgiving oil-based stain to apply in this lineup. If this is your first time working with an oil-based product, start here.",
    description:
      "Wolman's has historically been better known for wood preservatives and brighteners than for finished color stains, but DuraStain earns its place here for one specific reason: it's the easiest oil-based product in our test to apply without prior experience. The formula self-levels noticeably better than the other semi-transparent oil stains we tried, which means the classic beginner mistakes — leaving a visible lap mark where a wet edge dried before the next section was applied, or pooling stain in low spots between boards — were much harder to produce even when we tried to force them during testing. On pressure-treated pine, DuraStain penetrated evenly and produced consistent color across boards with slightly different grain tightness, something that trips up less refined formulas. Dry time was also on the faster side for an oil-based product, with light foot traffic safe within about 24 hours under good drying conditions, versus the 48-hour windows more typical of oil-based stains. The honest tradeoff shows up over time rather than on application day: in our longer-term comparison, DuraStain's color retention and water-beading performance at the 12-month mark trailed our top picks, particularly on horizontal deck boards that see direct foot traffic and standing water from rain. It's a genuinely good stain, just not positioned as the longest-lasting option in this category. A handful of testers also noted a sharper solvent smell during application compared to Messmer's or Penofin, which is worth knowing if you're working in a space with limited ventilation or sensitive neighbors. For a homeowner tackling their first oil-based deck stain project and prioritizing a forgiving, mistake-resistant application experience over maximum longevity, DuraStain is the stress-free choice.",
  },
  {
    id: "superdeck-penetrating-oil",
    name: "Superdeck Exterior Penetrating Oil-Based Stain",
    category: "Penetrating Oil-Based",
    badge: "Best Budget",
    amazonUrl: "#",
    rating: 4.2,
    reviewCount: 6100,
    pros: [
      "Lowest price per gallon of any oil-based product in our test",
      "True penetrating oil chemistry, not a diluted or hybrid formula",
      "Adequate performance for the price on pressure-treated pine",
      "Widely stocked at regional hardware and lumber stores",
      "Simple, no-frills application with standard brush or roller tools",
    ],
    cons: [
      "Shortest color retention window of any product we tested — plan on annual recoating in sunny climates",
      "Thinner pigment load means less UV protection than premium semi-transparent oils",
    ],
    bottomLine:
      "The entry point into real oil-based deck staining. Not built for a decade of neglect, but a legitimate, affordable way to protect a deck on a tight budget.",
    description:
      "Superdeck's penetrating oil-based stain exists to answer a specific question: what's the least you can spend and still get an authentic, functional oil-based deck stain rather than a watered-down imitation? The answer, based on our testing, is that Superdeck delivers real value at its price point without pretending to be something it's not. The formula is a straightforward penetrating oil with a modest pigment load, and it performed adequately on our pressure-treated pine test section — even absorption, no beading or resistance, and a final color that, while not as rich or deep as the premium products in this lineup, was perfectly presentable. Where the budget positioning becomes obvious is longevity. In our 12-month tracking, Superdeck showed the most advanced fading of any product in this test group by the nine-month mark on our sun-exposed section, and water no longer beaded reliably on the surface by month ten — both signs that the protective oil content had been substantially consumed by UV exposure and weathering faster than the pricier alternatives. For a deck that gets moderate use and where the owner is comfortable with an annual maintenance rhythm rather than stretching recoats to two or three years, that's a reasonable tradeoff for the savings. It's also a sensible choice for a rental property, a shed, or a secondary structure where you want genuine wood protection without premium-product spending. We wouldn't recommend it as the single coat you apply and then forget about for years — none of the oil-based stains in this category are truly \"set and forget,\" but Superdeck demands the shortest attention span of the bunch. Budget for that maintenance cadence going in, and it's a perfectly honest way to keep a deck protected without a big upfront cost.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Oil-Based Deck Stains",
          item: "https://www.thehonestreviewers.com/best-oil-based-deck-stain/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best oil-based deck stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most residential decks, Penofin Blue Label Hardwood Formula is our top overall pick for oil-based deck stain — it penetrates deeply, resists peeling entirely since it forms no surface film, and works on everything from pressure-treated pine to dense hardwoods. If you want the longest possible color retention and don't mind ordering from a professional supplier, Storm System Category 5 outperformed every other product in our 12-month sun-exposure testing.",
          },
        },
        {
          "@type": "Question",
          name: "Is oil-based or water-based deck stain better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Oil-based deck stain generally penetrates wood fibers more deeply than water-based stain, which translates to better long-term water repellency and a finish that fades rather than peels as it wears. Water-based stains offer easier soap-and-water cleanup, lower odor, and faster dry times, and modern formulas have closed much of the durability gap. If maximum penetration and a traditional wood-conditioning feel matter most to you, oil-based wins. If convenience and low VOC matter more, quality water-based stains are a reasonable choice.",
          },
        },
        {
          "@type": "Question",
          name: "What's the best oil-based stain for pressure-treated wood?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Penetrating and semi-transparent oil-based stains work especially well on pressure-treated wood because PT lumber's tight, chemically-treated grain resists the surface film that solid stains rely on. Messmer's UV Plus and Penofin Blue Label both penetrated pressure-treated pine evenly in our testing without blotching. The wood must be fully dry before staining — check our dedicated guide on staining pressure-treated wood for the drying timeline.",
          },
        },
        {
          "@type": "Question",
          name: "What is a penetrating oil deck stain, and how is it different from a film-forming stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A penetrating oil deck stain soaks into the wood fibers themselves rather than forming a coating on top of the surface. Because there's no film, it can't peel, blister, or crack — it simply fades gradually as UV exposure and weathering consume the oil over time. Film-forming stains, including most solid stains, sit on the wood's surface and are more prone to peeling, especially on pressure-treated lumber where the treated surface resists strong film adhesion.",
          },
        },
        {
          "@type": "Question",
          name: "How often do you need to reapply oil-based deck stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most oil-based deck stains need reapplication every 1-3 years depending on the formula, sun exposure, and traffic. Premium products with strong UV packages, like Storm System Category 5, can stretch toward 3 years on less-exposed surfaces. Budget penetrating oils and highly sun-exposed horizontal deck boards may need annual touch-ups. The water bead test is the best indicator: when water stops beading on the surface, it's time to recoat.",
          },
        },
        {
          "@type": "Question",
          name: "Can you apply oil-based stain over old water-based stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No, not without stripping first. Oil-based and water-based stains use fundamentally incompatible chemistry, and oil-based stain applied over an existing water-based film will not bond or penetrate properly, leading to poor adhesion and premature failure. If your deck currently has a water-based finish and you want to switch to oil-based, you'll need to strip the old finish to bare wood before applying the new oil-based product.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      review: {
        "@type": "Review",
        reviewBody: product.bottomLine,
        author: authorSchema(),
        publisher: { "@type": "Organization", name: "The Honest Reviewers" },
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "oil based deck stain",
      "deck stain",
      "penetrating oil stain",
      "semi-transparent stain",
      "pressure treated wood",
      "home improvement",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Oil-Based Deck Stains</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We applied 7 oil-based deck stains to matching wood test sections and tracked penetration depth, color retention, and water repellency through a full season of sun and rain. Penetrating oil, semi-transparent, and translucent — here's what actually protects wood and what fades fastest.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#penofin-blue-label"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#oil-vs-water"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Oil vs. Water-Based
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="7.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
