---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Heat Tape for Pipes",
    "url": "/best-heat-tape-for-pipes/"
  },
  {
    "title": "How to Winterize Outdoor Faucets",
    "url": "/how-to-winterize-outdoor-faucets/"
  },
  {
    "title": "Best Outdoor Faucet Covers",
    "url": "/best-outdoor-faucet-cover/"
  },
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  },
  {
    "title": "Best Electric Water Heaters",
    "url": "/best-electric-water-heater/"
  },
  {
    "title": "Best Garage Door Insulation Kits",
    "url": "/best-garage-door-insulation-kit/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-23", modified: "2026-11-23" });
const title = "7 Best Pipe Insulation in 2026: Foam, Rubber and Fiberglass";
const description =
  "The best pipe insulation on Amazon from Armaflex, Tubolit, M-D, Duck and Frost King, compared on foam vs rubber vs fiberglass, sizing for PEX and copper, R-value and freeze protection.";

const PRODUCTS = [
  {
    "id": "armaflex-lapseal-7-8-x-3-4",
    "name": "ArmaFlex LapSeal Pipe Insulation, 7/8 in. ID x 3/4 in. Wall, 5-Pack (30 ft)",
    "category": "Elastomeric Rubber Foam, 3/4 in. Wall, Peel-and-Seal Seam, Fits 3/4 in. Copper",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Thick 3/4-inch wall of closed-cell elastomeric foam",
      "Factory adhesive lap seam: peel the liner and press it shut",
      "Rated for hot and cold water, refrigerant and HVAC lines, per the listing",
      "Bends around elbows without cracking, Armacell says",
      "Fiber-free and GREENGUARD Gold certified, per the listing"
    ],
    "cons": [
      "Costs more per foot than polyethylene foam",
      "Outdoor runs need a UV coating or jacket, per the listing",
      "The listing gives no R-value figure"
    ],
    "bottomLine": "The best pipe insulation for most homes: thick, flexible rubber foam with a seam that seals itself, for hot and cold lines.",
    "description": "Armaflex is the name plumbers and HVAC techs reach for, and this LapSeal box is the version most homeowners will find easiest to install well. It is flexible black elastomeric foam, a closed-cell rubber material, with a 3/4-inch wall around a 7/8-inch inside diameter. Armacell lists it as fitting 3/4-inch nominal copper, which has a 7/8-inch actual outside diameter, or 1/2-inch IPS iron or PVC pipe, and tells you to measure the outside diameter before ordering. That advice matters more than any brand choice: a tube that is too loose leaves an air gap and one that is too tight splits at the seam. Each of the five 6-foot tubes is pre-slit with a factory-applied adhesive lap seal, so you open it over the pipe, peel the release liner and press the seam closed, even on lines already in place. The listing says it bends around elbows and fittings without cracking, works on hot and cold water, chilled water, refrigerant and HVAC lines, and is fiber-free and GREENGUARD Gold certified. The trade-offs are price, a listing that gives no R-value number, and the need to add a UV coating or jacket outdoors. Buy the Tubolit or M-D polyethylene tubes instead if you are covering long, straight basement runs on a budget."
  },
  {
    "id": "tubolit-dgs07810-self-seal",
    "name": "Tubolit DGS07810 Self Seal 7/8 in. x 1 in. Polyethylene Foam Pipe Insulation (96 ft Carton)",
    "category": "Polyethylene Closed-Cell Foam, Self Seal, 7/8 in. x 1 in., 96 Lineal Feet",
    "badge": "Best for Long Runs",
    "amazonUrl": "#",
    "pros": [
      "96 lineal feet per carton for whole-basement jobs",
      "Self-seal seam closes without separate tape",
      "Closed-cell polyethylene foam for freeze protection and energy saving",
      "Designed for copper and iron pipe, per the listing",
      "GREENGUARD Children & Schools certified, the listing says"
    ],
    "cons": [
      "A full carton is more than a small job needs",
      "The listing gives no R-value or temperature rating",
      "Polyethylene is stiffer around tight bends than rubber"
    ],
    "bottomLine": "A contractor carton of thick-wall polyethylene from Armacell's Tubolit line, for insulating every pipe in a basement or crawl space.",
    "description": "When the job is every water line in an unfinished basement or crawl space, buying single 6-foot tubes gets expensive and leaves you short. The Tubolit DGS07810 comes as a 96-lineal-foot carton of self-seal polyethylene foam, enough for most whole-house runs of a single pipe size. The title lists it as 7/8 inch by 1 inch; in Tubolit's part naming that reads as a 7/8-inch tube with a 1-inch wall, which is a thick wall for polyethylene. A 7/8-inch inside diameter is the size that suits 3/4-inch copper, but the listing itself does not spell out the fit, so measure your pipe and check Armacell's Tubolit size chart before you order a full carton. The listing describes closed-cell polyethylene foam designed to insulate copper and iron pipes, to help protect against freezing and to save energy on hot and cold plumbing. It is GREENGUARD Children and Schools certified and made without CFCs, HFCs, PBDEs or formaldehyde, per the listing. The trade-offs: the listing gives no R-value or maximum temperature, so check the spec sheet before using it right beside a water heater, polyethylene is stiffer around tight bends than elastomeric rubber, and 96 feet is overkill for a few exposed pipes. Buy the Duck Brand sticks or M-D tubes instead for a short run."
  },
  {
    "id": "md-50220-foam-tube",
    "name": "M-D Building Products 50220 Foam Tube Pipe Insulation, 1/2 in. Wall x 7/8 in. x 6 ft",
    "category": "Polyethylene Foam, 1/2 in. Wall, Self-Adhesive, R-3.0 (Listed), Fits 3/4 in. Copper",
    "badge": "Best Self-Adhesive Tube",
    "amazonUrl": "#",
    "pros": [
      "Listed R-value of 3.0",
      "Pre-slit with a self-adhesive seam",
      "Fits 3/4-inch copper and 1/2-inch PVC or iron pipe, per the listing",
      "Cuts to length with scissors",
      "Sold by the single 6-foot tube, so you buy only what you need"
    ],
    "cons": [
      "Only 6 feet per tube",
      "1/2-inch wall is thinner than the Armaflex and Tubolit picks",
      "The listing gives no temperature rating"
    ],
    "bottomLine": "A straightforward self-adhesive foam tube with a stated R-value and a clear fit, for a few feet of exposed pipe.",
    "description": "The M-D 50220 is the kind of foam tube most people picture when they think of pipe insulation, and its listing is one of the clearest on Amazon about what it fits. It is polyethylene foam with a 1/2-inch wall, a 7/8-inch inside diameter and a 6-foot length, and M-D says it fits 3/4-inch copper and 1/2-inch PVC or iron pipe. It also gives an R-value of 3.0, which few pipe insulation listings bother to state. The tube is pre-slit with a self-adhesive seam, so you open it over the pipe and press it closed, and it cuts to length with scissors. M-D lists it for reducing condensation that drips and causes water damage, and for saving energy by protecting pipes from heat loss or cold. Buying a single 6-foot tube suits a short job: the run from the water heater, a few feet of exposed pipe in a garage, or the line to an outdoor faucet. If your pipe is 1/2-inch copper, M-D's sibling 50215 tube has a 5/8-inch inside diameter and lists R-3.3. The trade-offs are length, a thinner wall than the Armaflex or Tubolit picks, and no stated maximum temperature. Buy the Tubolit carton instead for long runs, or Armaflex where flexibility around bends matters."
  },
  {
    "id": "frost-king-sp42x-fiberglass",
    "name": "Frost King SP42X/18 Foil Backed Fiberglass Pipe Wrap Kit, 3 in. x 1 in. x 25 ft",
    "category": "Fiberglass Wrap, Foil Vapor Barrier, 1 in. Thick, 3 in. Wide, 25 ft Roll",
    "badge": "Best Fiberglass Wrap",
    "amazonUrl": "#",
    "pros": [
      "1-inch-thick fiberglass wrap with a foil backing",
      "Foil vapor barrier helps stop cold pipes from sweating",
      "Cuts heat loss on hot water pipes, per the listing",
      "Wraps any pipe diameter, including fittings and valves",
      "One roll handles several pipe sizes"
    ],
    "cons": [
      "Fiberglass itches: wear gloves, sleeves and a mask",
      "Slower to install neatly than a tube",
      "The listing repeats itself and gives no R-value"
    ],
    "bottomLine": "A foil-backed fiberglass wrap for odd shapes, mixed pipe sizes and hot water lines where foam tubes will not fit well.",
    "description": "Fiberglass pipe wrap is the older way to insulate pipes, and it still earns a place where foam tubes struggle: odd pipe sizes, clusters of fittings, valves and long runs with lots of turns. The Frost King SP42X/18 kit is a 25-foot roll of fiberglass, 3 inches wide and 1 inch thick, with a foil backing that the listing describes as a vapor barrier. Frost King says it cuts wasteful heat loss on hot water pipes and helps keep cold water pipes from sweating, which is the vapor barrier's job: it stops humid air reaching the cold pipe and condensing inside the wrap. You spiral the strip along the pipe with an overlap, so one roll covers any diameter, though larger pipes use up the 25 feet faster. The listing is thin and repetitive, says the product is made in China, and gives no R-value, so check Frost King's package for coverage; the thinner plastic-backed SP41X kit, for comparison, lists R-1.6. The trade-offs are real. Fiberglass irritates skin and lungs, so wear gloves, long sleeves and a dust mask, and a spiral wrap takes longer to install neatly than a foam tube. Buy the Armaflex or M-D tubes instead for straight runs of a single size."
  },
  {
    "id": "duck-foam-pipe-covers-3-4",
    "name": "Duck Brand Foam Pipe Covers, 0.75 in. x 1 ft, 6 Sticks",
    "category": "Polyethylene Foam Sticks, Self-Sealing Edge, R-3.6 (Listed), Up to 212 F",
    "badge": "Best for Short Runs",
    "amazonUrl": "#",
    "pros": [
      "Listed R-value of 3.6",
      "Rated for temperatures up to 212 F, per the listing",
      "Pre-slit with a self-sealing adhesive edge",
      "12-inch sticks are easy to fit between fittings",
      "Made in the USA and residue free, Duck says"
    ],
    "cons": [
      "Only 6 feet in total per pack",
      "The listing says it fits 1/2- to 3/4-inch pipe, so it may sit loose on smaller pipe",
      "Short sticks mean many joints to tape"
    ],
    "bottomLine": "Short, self-sealing foam sticks with a stated R-value and temperature limit, for renters and small jobs between fittings.",
    "description": "Not every pipe insulation job is a long straight run. Under a sink, behind a washing machine or around a water heater, the pipe turns every foot or two, and 6-foot tubes end up cut into short pieces anyway. Duck Brand's foam pipe covers come as six 12-inch sticks, each pre-slit with a self-sealing adhesive edge, for 6 feet of insulation in total. The listing gives two numbers most competitors leave out: an R-value of 3.6 and a maximum temperature of 212 F, so you know they suit hot water lines as well as cold. Duck lists them for preventing winter freezing and summer sweating on indoor water, air conditioning and HVAC pipes. They are made in the USA and residue free, which Duck says makes them suitable for renters who need to remove them later. The catch is the fit. The title gives a 0.75-inch size and the listing says the sticks fit 1/2-inch to 3/4-inch pipes; one size cannot fit both snugly, so on smaller pipe expect a looser fit and tape the seams and joints. Six feet also goes quickly, and short sticks mean more joints to seal. Buy the M-D tube or Armaflex instead for runs longer than a few feet, or where you need an exact fit."
  },
  {
    "id": "frost-king-fv15-foam-foil-tape",
    "name": "Frost King FV15 Foam and Foil Pipe Insulation Tape, 2 in. x 1/8 in. x 15 ft",
    "category": "Foam and Foil Wrap Tape, Self-Adhesive, 1/8 in. Thick, 15 ft Roll",
    "badge": "Best Wrap Tape",
    "amazonUrl": "#",
    "pros": [
      "Self-adhesive, so it wraps in one step",
      "Foil face over foam for hot and cold pipes",
      "Wraps valves, elbows and odd fittings that tubes cannot cover",
      "Helps stop cold pipes from sweating, per the listing",
      "Made in the United States, the listing says"
    ],
    "cons": [
      "1/8 inch thick, so far less insulation than a tube",
      "15 feet covers only a short length of pipe",
      "Not enough on its own for freeze protection in a cold space"
    ],
    "bottomLine": "A thin, self-adhesive foam and foil tape for sealing fittings, valves and tube joints, not a replacement for a full tube.",
    "description": "Wrap tape fills the gaps that tubes leave. Every foam tube job ends at a valve, a tee, a union or an elbow, and those bare fittings are where heat escapes and where a cold pipe drips condensation. The Frost King FV15 is a 15-foot roll of self-adhesive foam with a foil face, 2 inches wide and 1/8 inch thick. You peel and spiral it on, overlapping each turn, and it conforms to shapes no tube will fit. Frost King lists it for both hot and cold pipes: on hot pipes it helps stop wasteful heat loss, and on cold pipes it helps prevent sweating and dripping. It is also a tidy way to seal the butt joints between lengths of foam tube. The limitation is thickness. At 1/8 inch, this tape holds a small fraction of the insulation of a 1/2-inch or 3/4-inch wall tube, so on its own it will not keep a pipe in an unheated crawl space from freezing for long. Fifteen feet of 2-inch tape also covers less pipe than it sounds, because each turn overlaps the last. Buy it alongside a tube rather than instead of one. If you need more thickness on odd shapes, use the Frost King fiberglass wrap, and for long straight runs, the Armaflex or M-D tubes."
  },
  {
    "id": "frost-king-poly-foam-1in-case",
    "name": "Frost King 1 in. x 3 ft Polyethylene Foam Pipe Insulation, Case of 10",
    "category": "Polyethylene Foam Tubes, 1 in. x 3 ft, 10 Pieces (30 ft)",
    "badge": "Budget Bulk Pack",
    "amazonUrl": "#",
    "pros": [
      "Ten 3-foot tubes, 30 feet in total",
      "Polyethylene foam from a long-established weatherization brand",
      "Short lengths are easy to handle in a tight crawl space",
      "Cuts with a utility knife or scissors",
      "A simple way to cover several exposed runs at once"
    ],
    "cons": [
      "The listing is very thin: no wall thickness, R-value or fit chart",
      "It does not say whether 1 inch is the inside diameter or the pipe size",
      "3-foot pieces mean more joints to tape"
    ],
    "bottomLine": "A bulk case of basic Frost King foam tubes, worth it only once you have confirmed the size on Frost King's own chart.",
    "description": "Frost King is one of the most familiar weatherization brands in hardware stores, and its basic polyethylene foam tubes are what many people pick up for a weekend of insulating a crawl space. This Amazon listing is a case of ten 3-foot tubes, 30 feet in total, which makes it a practical way to buy for several runs at once. Short pieces have one advantage: they are easier to feed onto pipes in a cramped crawl space than 6-foot tubes. Be clear about what the listing does not tell you, though. It gives only the brand, the material, the 1-inch by 3-foot size and the case count. There is no wall thickness, no R-value, no temperature limit and no fit chart, and it does not say whether 1 inch is the tube's inside diameter or the nominal pipe size it is meant for. Those are exactly the details that decide whether pipe insulation works, so check Frost King's size chart or the package before ordering, and measure your pipe's outside diameter. Polyethylene foam of this kind is usually thinner than the Tubolit or Armaflex picks, and ten pieces means more joints to seal with tape. Buy the M-D 50220 or Tubolit carton instead if you want a listing that states the fit, or Armaflex for the thickest, most flexible option."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pipe Insulation",
          item: "https://www.thehonestreviewers.com/best-pipe-insulation/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best pipe insulation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the ArmaFlex LapSeal elastomeric tube is the best pipe insulation: a thick 3/4-inch wall, a peel-and-seal seam and a listing that covers hot and cold water lines. Choose Tubolit for long basement runs, M-D or Duck for short runs with a listed R-value, and Frost King fiberglass wrap for odd shapes and mixed pipe sizes."
          }
        },
        {
          "@type": "Question",
          "name": "Is foam or fiberglass pipe insulation better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Closed-cell foam is better for most homeowners. It installs faster, does not itch and does not absorb condensation on cold pipes. Fiberglass wrap still suits odd shapes, mixed pipe sizes and fittings, but on cold pipes it needs an intact, taped vapor barrier to keep working, and you should wear gloves and a mask when handling it."
          }
        },
        {
          "@type": "Question",
          "name": "Does pipe insulation prevent pipes from freezing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It slows freezing but does not prevent it. Insulation holds in the heat the water already has, which helps a pipe ride out short cold snaps in a basement or garage. In a space that stays below freezing for days, insulated pipes still freeze, so pair insulation with self-regulating heat cable there."
          }
        },
        {
          "@type": "Question",
          "name": "What size pipe insulation do I need for PEX?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Match the insulation to the PEX's measured outside diameter, not its nominal size. Much PEX in North America is made to copper tube size, but pipe types vary, so measure with calipers or a paper strip and check the maker's fit chart. A snug fit with a closed seam matters more than the brand."
          }
        },
        {
          "@type": "Question",
          "name": "Should I insulate hot water pipes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Insulating hot water pipes cuts heat loss, keeps water hotter between uses and is one of the cheapest energy upgrades in a house. Start with the first few feet from the water heater and any long runs through unheated spaces. Keep foam clear of a gas heater's flue and follow the maker's clearances."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put pipe insulation outside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but most foam needs protection from sunlight and water. Armaflex's listing says outdoor runs need a UV coating or jacket, and seams should be sealed against rain. For outdoor faucets, shut off and drain the supply and fit an insulated faucet cover instead of relying on foam alone. Add heat cable on any exposed run that stays below freezing."
          }
        },
        {
          "@type": "Question",
          "name": "What R-value should pipe insulation have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Higher is better, but few listings give one. Among our picks, the M-D 50220 lists R-3.0 and the Duck covers R-3.6. Where no figure is given, wall thickness is the better guide: a 3/4-inch or 1-inch wall holds heat longer than a 3/8-inch or 1/2-inch wall, and thin wrap tape adds little."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best pipe insulation",
      "pipe insulation",
      "foam pipe insulation",
      "water pipe insulation",
      "fiberglass pipe insulation",
      "pipe insulation pex",
      "pipe covers"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Pipe Insulation</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Cheap foam on the right pipes saves energy and buys time in a cold snap. Seven pipe insulation products on Amazon, from rubber tubes to fiberglass wrap and foil tape.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#armaflex-lapseal-7-8-x-3-4"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Foam or Fiberglass?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="2.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Foam, Rubber, Fiberglass or Tape</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Sizing for PEX and Copper</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Pipe Insulation Picks</a>
          <a href="#freezing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Does It Stop Freezing?</a>
          <a href="#hot-water" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Hot Water Pipes</a>
          <a href="#r-value" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Wall Thickness and R-Value</a>
          <a href="#install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How to Install</a>
          <a href="#outdoor" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Outdoor and Exposed Pipes</a>
