---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  },
  {
    "title": "Best Lawn Tractors",
    "url": "/best-lawn-tractor/"
  },
  {
    "title": "Best Zero Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best 42 Inch Zero Turn Mowers",
    "url": "/best-42-inch-zero-turn-mower/"
  },
  {
    "title": "Best Commercial Zero Turn Mowers",
    "url": "/best-commercial-zero-turn-mower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best Sub Compact Tractors in 2026: Loader, PTO and Mower Deck Specs Compared";
const description =
  "The best sub compact tractors compared like-for-like: PTO horsepower, loader lift at the pin and 500 mm forward, Category 1 hitch ratings and mid-mount decks.";

const PRODUCTS = [
  {
    "id": "kubota-bx2680",
    "name": "Kubota BX2680 Sub-Compact Tractor",
    "category": "24.8 hp Diesel, 19.5 PTO hp, HST, 4WD",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "19.5 claimed PTO hp, the highest PTO rating on this list",
      "Published specs list about 680 lb of 3-point lift at 24 in behind the pins",
      "LA344 loader rated around 739 lb at the pin to full height",
      "54 or 60 in mid-mount decks, plus a large Kubota implement catalog",
      "Kubota dealer density and resale are among the best in the class"
    ],
    "cons": [
      "Lower 3-point and loader ratings than the Mahindra and LS on paper",
      "Typically priced above the LS and Kioti once equipped"
    ],
    "bottomLine": "The sub-compact to buy if you mow first and do loader work second: the most PTO power here, a proven drivetrain and a dealer in most towns.",
    "description": "The BX2680 is the mowing-first sub-compact, and its strength is the number that matters for a mower deck: published specs list 19.5 claimed PTO horsepower from a 24.8 hp three-cylinder diesel, the highest PTO rating on this page. Drive is hydrostatic with 4WD, the rear hitch is Category I, and spec databases put 3-point lift at about 680 lb measured 24 inches behind the pins. The matching LA344 loader is listed at roughly 739 lb to full height at the pivot pin and about 509 lb at 500 mm forward, which is the more honest figure for a bucket of gravel. Kubota offers 54 and 60-inch mid-mount mower decks. On paper the Mahindra and LS lift more; the BX earns its place on PTO output, refinement and Kubota's dealer network. It is dealer-only."
  },
  {
    "id": "john-deere-1025r",
    "name": "John Deere 1025R Sub-Compact Tractor",
    "category": "23.9 hp Diesel, 18.2 PTO hp, Hydrostatic, 4WD",
    "badge": "Best Mid-Mount Mower",
    "amazonUrl": "#",
    "pros": [
      "AutoConnect 54D and 60D drive-over mid-mount decks",
      "Deere lists 758 lb of 3-point lift at 24 in behind the link arms",
      "120R loader: 803 lb at the pivot to full height, 553 lb at 500 mm forward",
      "18.2 PTO hp from a 23.9 hp diesel, per Deere",
      "Huge dealer network and strong resale"
    ],
    "cons": [
      "Limited Category 1 hitch, like the rest of the class",
      "Usually the most expensive tractor here once equipped"
    ],
    "bottomLine": "The sub-compact to buy if the mid-mount mower is the reason you are buying a tractor: drive-over AutoConnect decks make it the easiest here to switch between mowing and loader work.",
    "description": "The 1025R's case is the mower deck. Deere's AutoConnect 54D and 60D mid-mount decks attach by driving the tractor over the deck and lowering the lift, with no crawling underneath to hook up linkages, which matters if you plan to swap between mowing and loader work every weekend. Deere lists the engine at 23.9 hp and PTO output at 18.2 hp, with a limited Category 1 hitch rated at 758 lb measured 24 inches behind the link arms. Deere's 120R loader is listed at 803 lb to full height at the pivot pin and 553 lb at 500 mm forward. The drive is hydrostatic with twin-pedal control. Deere is rarely the cheapest option once equipped, but dealer coverage and resale are strong. Our compact tractor guide covers the 1025R as a loader machine; this page treats it as the best mowing platform. It is dealer-only."
  },
  {
    "id": "mahindra-emax-25l-hst",
    "name": "Mahindra eMAX 25L HST Sub-Compact Tractor",
    "category": "24 hp Diesel, 16.9 PTO hp, 2-Range HST",
    "badge": "Best Loader Lift",
    "amazonUrl": "#",
    "pros": [
      "25LSK loader rated 900 lb at the pivot pin to full height, 75.3 in max height",
      "Mahindra lists 1,323 lb of 3-point lift capacity",
      "Skid-steer style loader coupler standard",
      "1,175cc three-cylinder, the largest displacement Mahindra cites in its class",
      "Optional 26B backhoe with an 80 in max dig depth"
    ],
    "cons": [
      "16.9 PTO hp is lower than the Kubota or Deere",
      "Mahindra's lift figure does not state where it is measured, so compare with care"
    ],
    "bottomLine": "The sub-compact to buy if the loader is the main tool: the highest loader rating here and a skid-steer coupler out of the box.",
    "description": "The eMAX 25L HST is the loader-first pick. Mahindra's brochure lists the 25LSK loader at 900 lb to full height at the pivot pin, with a 75.3 inch maximum lift height, 2,000 lb of breakout force and a skid-steer style quick-attach coupler as standard, so pallet forks, grapples and buckets from the huge aftermarket bolt straight on. The engine is a 24 hp, 1,175cc three-cylinder diesel working at 2,600 rpm, through a two-range hydrostatic transmission and a Category I hitch rated by Mahindra at 1,323 lb. PTO output is 16.9 hp, lower than the Kubota or Deere, which is the trade for the low-rpm engine. Mahindra offers a 60-inch 62M mid-mount deck and the 26B backhoe with an 80 inch maximum dig depth. Max total hydraulic flow is listed at 7.1 gpm. It is dealer-only."
  },
  {
    "id": "ls-mt125",
    "name": "LS Tractor MT125 Sub-Compact Tractor",
    "category": "24.7 hp Yanmar Diesel, 17.2 PTO hp, 2-Range HST",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Yanmar 3TNV80F three-cylinder diesel, 24.7 hp",
      "LS lists 1,008 lb loader lift capacity",
      "3-point lift of 992 lb at the hitch ends and 728 lb at 24 in",
      "Optional 60 in mid-mount mower and three compatible backhoes",
      "Typically priced below Kubota and Deere equivalents"
    ],
    "cons": [
      "LS has published more than one loader figure for this model over time",
      "Thinner dealer network than Kubota or Deere in many regions"
    ],
    "bottomLine": "The best value sub-compact here: a Yanmar diesel and strong lift numbers for less money, if there is an LS dealer within reasonable driving distance.",
    "description": "The MT125 gives the most lift for the money on this page. LS fits a 24.7 hp Yanmar 3TNV80F three-cylinder diesel, a two-range hydrostatic transmission with dual pedals, and a Category 1 hitch that LS rates at 992 lb at the hitch ends and 728 lb at 24 inches, second only to the Deere's 758 lb on that measure. LS lists 1,008 lb of loader lift capacity and a weight of 1,444 lb without ballast. PTO output is 17.2 hp. The options list includes a 60-inch mid-mount mower, a 50-inch front snow blower and three compatible backhoes. The caveat is that LS has published more than one loader lift figure for the MT125 over the years, so confirm the number for the loader on your quote. It is dealer-only, and dealer distance should decide it."
  },
  {
    "id": "kioti-cs2210",
    "name": "Kioti CS2210 Sub-Compact Tractor",
    "category": "21 hp Diesel, about 18.6 PTO hp, 2-Range HST",
    "badge": "Best Entry-Level",
    "amazonUrl": "#",
    "pros": [
      "Smallest and lightest tractor here, about 1,485 lb with ag tires and ROPS per dealers",
      "Independent rear and mid PTO, with a strong PTO rating relative to its engine",
      "Category 1 hitch rated at 700 lb",
      "Kioti pitches the CS series for properties up to 10 acres"
    ],
    "cons": [
      "Dealer listings put the SL2410 loader at about 675 lb, the lowest here",
      "21 hp leaves the least reserve for a 60 in deck in heavy grass"
    ],
    "bottomLine": "The entry point: buy it for mowing, snow and light loader chores on a few acres, not for moving heavy material every weekend.",
    "description": "The CS2210 is the smallest machine here and the cheapest way into a real sub-compact with a diesel, a hydrostatic transmission, a Category 1 three-point hitch and independent rear and mid PTOs. Kioti rates the engine at 21 hp gross, and a 2021 spec sheet lists about 18.6 PTO hp, which is a strong ratio for the size. The hitch is rated at 700 lb, and dealer listings put the SL2410 loader at around 675 lb and the tractor at about 1,485 lb with ag tires and ROPS. That loader rating is the lowest on this page, so treat it as a tractor for mowing, snow clearing, mulch and light grading rather than daily gravel work. Kioti pitches the CS series for properties up to 10 acres. Confirm current specs and the deck options with your dealer; it is dealer-only."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Sub Compact Tractor",
          item: "https://www.thehonestreviewers.com/best-sub-compact-tractor/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best sub compact tractor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, the Kubota BX2680: 19.5 claimed PTO hp, a hydrostatic 4WD drivetrain, a Category I hitch and Kubota's dealer network. Pick the John Deere 1025R if the mid-mount mower matters most, the Mahindra eMAX 25L HST for the strongest loader, or the LS MT125 for the most lift per dollar."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a subcompact and a compact tractor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sub compact tractors run about 20 to 25 hp, weigh roughly 1,400 to 1,900 lb and often have a limited Category 1 hitch; they are built to mow and carry a loader. Compact utility tractors run about 25 to 45 hp, weigh more and have a full Category 1 hitch for ground-engaging implements like tillers and rotary cutters."
          }
        },
        {
          "@type": "Question",
          "name": "How many acres can a sub compact tractor handle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kioti pitches its CS series for properties up to 10 acres, and that is a fair range for the class: two to ten acres of lawn, gardens and a gravel drive. More acreage is fine for mowing, but pasture, brush and field work push you toward a heavier compact tractor."
          }
        },
        {
          "@type": "Question",
          "name": "Can a sub compact tractor use Category 1 implements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, within limits. Most sub-compacts have a limited Category 1 hitch that accepts standard Category 1 implements, but lift capacity and weight restrict you to lighter ones: 4 to 5 foot box blades and land planes, 4 foot rotary cutters, small tillers, rear blades and post hole diggers."
          }
        },
        {
          "@type": "Question",
          "name": "How much can a sub compact tractor loader lift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturer ratings on this page range from about 675 lb to 1,008 lb, but the measuring point matters. At 500 mm forward of the pivot, where a bucket's load actually sits, Deere's 120R loader is rated at 553 lb and Kubota's LA344 at about 509 lb, roughly 30 percent below the pivot-pin numbers."
          }
        },
        {
          "@type": "Question",
          "name": "Is a sub compact tractor good for mowing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Kubota, Deere, Mahindra and LS here all offer 60-inch mid-mount decks driven by the mid PTO, and a sub-compact on turf tires handles uneven ground well. A zero turn mows faster, but a tractor that mows and also carries a loader replaces two machines on a property that needs both."
          }
        },
        {
          "@type": "Question",
          "name": "Can you buy a sub compact tractor on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The Kubota, John Deere, Mahindra, LS and Kioti tractors on this page are sold through dealers, and Amazon listings under their model numbers are parts, filters and seat covers. A dealer handles setup, warranty work and parts, which you will want on a tractor regardless."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn & Yard Care",
    tags: [
      "sub compact tractor",
      "subcompact tractor",
      "best subcompact tractor",
      "sub compact tractors",
      "subcompact tractor with loader"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Sub Compact Tractors</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A sub compact tractor mows like a lawn tractor and lifts like a small loader. Here are the five worth a dealer visit, with their spec sheets read on the same measuring points so the numbers actually compare.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#kubota-bx2680"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What a Sub-Compact Is
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-is" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What a Sub-Compact Is</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#spec-sheet" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Reading the Spec Sheet</a>
          <a href="#hitch" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Category 1 Hitch Limits</a>
          <a href="#mower" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Mid-Mount Mower Decks</a>
          <a href="#loader" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Loader Lift in Practice</a>
          <a href="#hst" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Hydrostatic Drive</a>
          <a href="#dealer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Buying From a Dealer</a>
          <a href="#skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When Not to Buy</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Buy a sub compact tractor when your property needs a mower and a loader and you would rather own one machine than two. The five here are close on paper, and the brochures make them look closer than they are: loader and hitch ratings are measured at different points, and engine horsepower says little about what reaches the mower deck. Read on the same basis, the differences are clear.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-is" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What a Sub Compact Tractor Is, and Who It Is For
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Machine Itself</h3>

          <p>
            A sub compact tractor is the smallest real tractor: a 20 to 25 hp three-cylinder diesel, a hydrostatic transmission, 4WD, a Category 1 three-point hitch, a rear 540 rpm PTO and a mid PTO that drives a belly mower. The five machines on this page weigh roughly 1,400 to 1,900 lb without a loader, small enough to cross a lawn on turf tires and fit in a standard garage bay, and big enough to carry a front-end loader and pull a box blade.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Where It Fits Between a Lawn Tractor and a Compact</h3>

          <p>
            That combination fills a gap. A lawn tractor or garden tractor mows well but cannot carry a real loader or run 540 rpm implements; our <a href="/best-lawn-tractor/">lawn tractor guide</a> covers that class. A compact utility tractor in the 25 to 45 hp range handles tillers, rotary cutters and pasture work, but it is heavier, wider and harder on turf; our <a href="/best-compact-tractor/">compact tractor guide</a> compares those machines and explains when you need one. The sub-compact sits between them: a lawn-friendly tractor that mows, moves mulch, clears snow and grades a gravel drive.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Typical Buyer</h3>

          <p>
            The typical buyer has two to ten acres, a meaningful lawn, and a list of chores that keeps growing: firewood, mulch, garden beds, a gravel driveway, fence posts, snow. If the job list is just mowing, a zero turn is cheaper and faster, and our <a href="/best-zero-turn-mower/">zero turn mower guide</a> covers it; on a smaller lot with gates, the <a href="/best-42-inch-zero-turn-mower/">42 inch zero turn</a> is often the better tool. If the job list includes moving material every week, the sub-compact starts paying for itself.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Machine</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Engine / Hitch</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best At</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lawn or garden tractor</td>
                    <td class="px-4 py-4 text-gray-700">Gas, 18-26 hp, sleeve or light hitch</td>
                    <td class="px-4 py-4 text-gray-700">Mowing, light towing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sub compact tractor</td>
                    <td class="px-4 py-4 text-gray-700">Diesel, 20-25 hp, Cat 1 (often limited)</td>
                    <td class="px-4 py-4 text-gray-700">Mowing plus loader work</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Compact utility tractor</td>
                    <td class="px-4 py-4 text-gray-700">Diesel, 25-45 hp, full Cat 1</td>
                    <td class="px-4 py-4 text-gray-700">Ground-engaging implements</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Zero turn mower</td>
                    <td class="px-4 py-4 text-gray-700">Gas or battery, 20-25 hp</td>
                    <td class="px-4 py-4 text-gray-700">Fastest mowing, nothing else</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The 5 Best Sub Compact Tractors, Ranked
          </h2>

          <p>
            We compared current sub compact tractors from Kubota, John Deere, Mahindra, LS and Kioti on PTO horsepower, loader lift with its measuring point, three-point lift at 24 inches where published, transmission, mid-mount deck options and dealer support. Figures come from manufacturer spec sheets and brochures, or published spec databases where the maker's page does not list them; we note the source where numbers vary. All five are dealer-sold and not available on Amazon.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
