---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Nozzle Colors Explained", url: "/pressure-washer-nozzle-colors-explained/" },
    { title: "How to Winterize", url: "/how-to-winterize-a-pressure-washer/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "How to Use Detergent in a Pressure Washer";
const description =
  "The soap siphon only draws at low pressure, which is why most people think theirs is broken. How to apply, dwell and rinse it properly.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Using Detergent",
          item: "https://www.thehonestreviewers.com/how-to-use-detergent-in-a-pressure-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why is my pressure washer not drawing soap?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Almost always because a high-pressure nozzle is fitted. The siphon only engages at low pressure, so it stops drawing with any tip other than the black soap nozzle. After that, check the siphon tube is in the detergent, the tube filter is clear, and nothing is kinked.",
          },
        },
        {
          "@type": "Question",
          name: "What nozzle do I use for soap?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The black one, and only the black one. It is a wide low-pressure tip whose entire purpose is to drop the pressure enough for the detergent siphon to engage. No other nozzle in the set will draw soap, and there is no substitute if you lose it.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use dish soap in a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Avoid it. On a vehicle it strips the wax or sealant that keeps dirt from bonding to the paint, and it is hard on rubber and trim over time. It also foams more than pressure washer formulations are designed for. Use a product labelled for pressure washers.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use bleach in a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not unless the machine explicitly permits it. Bleach attacks pump seals, O-rings and metal components, and the damage is cumulative rather than immediate. If a job genuinely needs it, apply it separately with a garden sprayer and use the machine only to rinse.",
          },
        },
        {
          "@type": "Question",
          name: "How long should detergent dwell before rinsing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Several minutes, and never long enough to dry. That window is where the chemical work happens, breaking down algae, mildew and road film so far less pressure is needed. Work in sections small enough to rinse in time, and re-wet the surface if it starts drying.",
          },
        },
        {
          "@type": "Question",
          name: "Is a foam cannon better than the built-in soap tank?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For anything vertical, considerably. The built-in siphon produces thin soap that runs off in seconds, while a cannon produces thick foam that clings for minutes, which is what lets the chemistry work. Check the cannon fitting matches your machine and the minimum flow it needs.",
          },
        },
        {
          "@type": "Question",
          name: "Why is my foam thin with a foam cannon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually too little product in the mix, a clogged cannon filter, hard water, or a machine below the cannon minimum flow. Dissolving the detergent in warm water in the bottle helps noticeably, and it is the cheapest thing to try before adjusting anything else.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to flush the detergent system after use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and it takes a minute. Run plain water through the siphon with the black tip fitted so it actually draws, then rinse the tank and the small filter on the siphon tube. Detergent left to dry in the injector is the usual reason a working soap system stops.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "how to use detergent in a pressure washer",
      "pressure washer soap not working",
      "pressure washer detergent",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            How-To
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How to Use Detergent <span class="text-[#38BDF8]">in a Pressure Washer</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The single most common support question in this category has the same answer nearly every time: the wrong nozzle is fitted. The siphon only engages at low pressure, and no high-pressure tip will draw soap.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#why-no-soap"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See How It Works
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-no-soap" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why No Soap</a>
          <a href="#the-method" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Apply, Dwell, Rinse</a>
          <a href="#what-to-use" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. What to Use</a>
          <a href="#foam-cannons" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Foam Cannons</a>
          <a href="#downstream" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How Injectors Work</a>
          <a href="#why-chemistry-wins" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Why Chemistry Wins</a>
          <a href="#aftercare" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Aftercare</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Chemistry does more of the cleaning than pressure does on almost every household surface. Getting the detergent system working properly is worth more than several hundred extra PSI, and it usually costs nothing at all.
        </p>

        <div id="why-no-soap" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Why No Soap Is Coming Out
          </h2>

          <p>
            Start here, because this accounts for the large majority of detergent complaints and the fix takes ten seconds.
          </p>

          <p>
            The detergent siphon on a pressure washer only engages at low pressure. Fitting a high-pressure nozzle raises the pressure at the tip, the siphon stops drawing, and nothing comes through. The system is not broken; it is doing exactly what it was designed to do.
          </p>

          <p>
            The black soap nozzle exists for this reason. It is a wide, low-pressure tip whose entire purpose is to drop the pressure enough for the siphon to work. It is the only tip in the set that will draw detergent, and nothing substitutes for it.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Fit the black nozzle before expecting any soap at all. This alone solves most cases.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check the siphon tube is actually in the detergent and reaching the bottom of the bottle.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check the small filter on the end of the siphon tube, which clogs with dried detergent.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check the tube for kinks, splits and loose connections at the machine end.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>On machines with a dial or tank selector, confirm it is set to the tank you filled.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Give it time. A long siphon tube can take twenty or thirty seconds of trigger to prime.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Order to Check In</p>
            <p class="text-xl font-bold text-white mb-3">Black nozzle, then the tube, then the filter.</p>
            <p class="text-gray-300 leading-relaxed m-0">That sequence resolves nearly every case. If soap still will not draw after all three, the usual remaining cause is dried detergent blocking the injector inside the machine, which flushing with warm water through the siphon tube will often clear. Running plain water through the detergent system after every use prevents it entirely.</p>
          </div>
        </div>

        <div id="the-method" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Apply, Dwell, Rinse Sequence
          </h2>

          <p>
            Detergent does its work between application and rinsing. Everything about the technique is designed to maximise that window.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">1. Pre-Wet the Surface</h3>

          <p>
            A wet surface stops detergent soaking straight in and drying, and on siding it prevents the streaking that dry runs leave behind. Pre-wet the plants and lawn below the work area too, which both protects them and stops the cleaner concentrating on foliage.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">2. Apply From the Bottom Up</h3>

          <p>
            On any vertical surface, work upward. Detergent running down dry siding leaves tracks that are harder to remove than the original dirt was; detergent running down already-wet siding does not. This is counterintuitive and it is the difference between an even result and a streaked one.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">3. Let It Dwell</h3>

          <p>
            Several minutes, and do not let it dry. This is where the cleaning happens: the detergent breaks down algae, mildew and road film chemically so that far less pressure is needed to remove it. Re-wet the surface if it starts drying in sun or wind, and work in sections small enough to keep everything within the dwell window.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">4. Rinse From the Top Down</h3>

          <p>
            Switch to a rinsing tip, usually white or green, and work downward so dirt runs onto surfaces you have not yet finished rather than over ones you have. On siding, keep the stream angled downward or level and never upward under the laps.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">5. Flush the System</h3>

          <p>
            Run clean water through the detergent siphon for a minute at the end. Detergent left sitting in the injector dries and blocks it, which is the second most common cause of a soap system that stops working.
          </p>
        </div>

        <div id="what-to-use" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What to Put in the Tank
          </h2>

          <p>
            Detergent choice matters more than most people expect, both for results and for the machine's own survival.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Job</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Use</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">House and siding</td>
                    <td class="px-4 py-4 text-gray-700">House wash solution</td>
                    <td class="px-4 py-4 text-gray-700">Formulated for algae and atmospheric film</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vehicles</td>
                    <td class="px-4 py-4 text-gray-700">Car shampoo or snow foam</td>
                    <td class="px-4 py-4 text-gray-700">Never dish soap; it strips wax and sealant</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Decks and fences</td>
                    <td class="px-4 py-4 text-gray-700">Deck cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Brightens greyed timber chemically</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Driveways and concrete</td>
                    <td class="px-4 py-4 text-gray-700">Concrete or driveway cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Targets organic growth and embedded grime</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Oil and grease</td>
                    <td class="px-4 py-4 text-gray-700">Degreaser</td>
                    <td class="px-4 py-4 text-gray-700">Pressure alone will not remove penetrated oil</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Roofs and fragile surfaces</td>
                    <td class="px-4 py-4 text-gray-700">Dedicated soft wash product</td>
                    <td class="px-4 py-4 text-gray-700">Applied at low pressure only</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">General purpose</td>
                    <td class="px-4 py-4 text-gray-700">Multi-purpose pressure washer detergent</td>
                    <td class="px-4 py-4 text-gray-700">Fine for most light jobs</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Use a product labelled for pressure washers. They are formulated to be low-foaming enough not to cause problems in the pump and free of solvents that attack seals, which is not true of everything under a kitchen sink.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never use bleach unless the machine explicitly permits it. It attacks pump seals, O-rings and metal components.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never use dish soap on a vehicle. It strips the wax or sealant that keeps dirt from bonding to the paint.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Avoid solvent-based cleaners entirely, which damage seals and hoses.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Dilute according to the label. Stronger is not better and concentrated product is harder on the machine.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not mix products. Some combinations produce hazardous gases, and chlorine plus acid is the classic example.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check plant safety on the label if you are working anywhere near planting.</span>
            </li>
          </ul>
        </div>

        <div id="foam-cannons" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Foam Cannons and Why the Siphon Is Weak
          </h2>

          <p>
            The built-in siphon is convenient and produces thin soap that runs off vertical surfaces quickly. For jobs where dwell time is the point, a foam cannon is a genuine upgrade rather than an accessory.
          </p>

          <p>
            A foam cannon attaches in place of the wand tip and mixes detergent, water and air under pressure to produce thick foam that clings. That clinging is the whole value: several minutes of contact instead of several seconds, which is the difference between chemistry working and chemistry running into the gutter.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Built-in Siphon</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Foam Cannon</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Foam thickness</td>
                    <td class="px-4 py-4 text-gray-700">Thin</td>
                    <td class="px-4 py-4 text-gray-700">Thick and clinging</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dwell achieved on vertical surfaces</td>
                    <td class="px-4 py-4 text-gray-700">Seconds</td>
                    <td class="px-4 py-4 text-gray-700">Several minutes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Setup</td>
                    <td class="px-4 py-4 text-gray-700">Fill the tank, fit the black tip</td>
                    <td class="px-4 py-4 text-gray-700">Mix in the bottle, fit the cannon</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Best for</td>
                    <td class="px-4 py-4 text-gray-700">Flat surfaces, quick jobs</td>
                    <td class="px-4 py-4 text-gray-700">Vehicles, siding, anything vertical</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Extra cost</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flow needed</td>
                    <td class="px-4 py-4 text-gray-700">Any</td>
                    <td class="px-4 py-4 text-gray-700">Check the minimum GPM</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Two things to check before buying one. The fitting must match your machine, because some brands use a proprietary connection rather than a standard quick-connect. And the cannon will specify a minimum flow, below which it produces thin foam whatever detergent you use, so a low-GPM machine may disappoint.
          </p>

          <p>
            If the foam is thin on a machine that should manage it, the usual causes are too little product in the mix, a dirty cannon filter, or hard water. Warm water in the cannon bottle also helps the detergent dissolve properly, which is a small change that makes a visible difference.
          </p>
        </div>

        <div id="downstream" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Downstream and Upstream Injectors
          </h2>

          <p>
            Understanding which system your machine uses explains most of its behaviour, including why the soap comes out at low pressure and why it sometimes stops.
          </p>

          <p>
            Nearly every consumer machine uses a downstream injector, which introduces detergent after the pump. That is why it only works at low pressure, and it is also a good thing: the pump never sees the chemical, so detergent cannot damage the pump seals directly.
          </p>

          <p>
            Upstream injection draws detergent before the pump, which allows soap at higher pressure but exposes the pump to whatever you are using. It appears on some professional machines with chemical-resistant pumps and is rare on consumer units, which is fortunate, because it makes detergent choice a much more serious matter.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Downstream means the black nozzle is mandatory, not optional, because pressure at the tip controls the draw.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Downstream means the pump is protected from your detergent, within reason.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The injector itself can clog with dried product, which is why flushing after use matters.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A long siphon tube takes time to prime, so give it twenty or thirty seconds before concluding it has failed.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Dual-tank machines use a selector dial, and setting it to a tank you did not fill is a common oversight.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A cracked or loose siphon tube draws air instead of detergent and produces nothing at all.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Feature Worth Having</p>
            <p class="text-xl font-bold text-white mb-3">Two tanks beat one by more than you would expect.</p>
            <p class="text-gray-300 leading-relaxed m-0">Machines with dual onboard detergent tanks let you keep a house wash in one and a degreaser in the other, switching between them with a dial rather than draining, rinsing and refilling mid-job. It sounds minor and it changes how often people actually use detergent at all, which is the thing that most affects cleaning results.</p>
          </div>
        </div>

        <div id="why-chemistry-wins" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Why Chemistry Beats Pressure
          </h2>

          <p>
            This matters more on electric machines than gas ones, because there is less raw output to spare. A proper cleaner that dwells turns a marginal machine into an entirely adequate one.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Soil</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Responds To</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pressure Alone?</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Algae, mildew, green growth</td>
                    <td class="px-4 py-4 text-gray-700">Chemistry and dwell time</td>
                    <td class="px-4 py-4 text-gray-700">Slowly and incompletely</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Road film on vehicles</td>
                    <td class="px-4 py-4 text-gray-700">Detergent and flow</td>
                    <td class="px-4 py-4 text-gray-700">Poorly</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Atmospheric grime on siding</td>
                    <td class="px-4 py-4 text-gray-700">Detergent and flow</td>
                    <td class="px-4 py-4 text-gray-700">Partly</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Greyed, weathered timber</td>
                    <td class="px-4 py-4 text-gray-700">Deck cleaner and brightener</td>
                    <td class="px-4 py-4 text-gray-700">Only by removing wood fibre</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Embedded dirt in concrete</td>
                    <td class="px-4 py-4 text-gray-700">Cleaner plus flow</td>
                    <td class="px-4 py-4 text-gray-700">Partly, with effort</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Oil and grease</td>
                    <td class="px-4 py-4 text-gray-700">Degreaser or a poultice</td>
                    <td class="px-4 py-4 text-gray-700">No, at any pressure</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rust stains</td>
                    <td class="px-4 py-4 text-gray-700">Oxalic acid based remover</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Only the bottom rows of most soil charts genuinely reward force, and two of them are not removable by pressure at all. Everything above is a chemistry problem, which is why the most common upgrade path in this category, buying a bigger machine to tackle a driveway that will not come clean, so often disappoints.
          </p>

          <p>
            The practical consequence for buying is straightforward: a mid-range machine with a working detergent system and a good cleaner outperforms a powerful machine used with plain water on nearly every household surface. Our guides to <a href="/what-psi-pressure-washer-do-i-need/">what PSI you actually need</a> and <a href="/can-an-electric-pressure-washer-clean-concrete/">whether electric cleans concrete</a> both come back to the same point.
          </p>
        </div>

        <div id="aftercare" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Looking After the Detergent System
          </h2>

          <p>
            The detergent system is the part of a pressure washer most likely to stop working, and almost all of that is preventable with two minutes at the end of a session.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Flush plain water through the siphon for a minute after every use, with the black tip fitted so it actually draws.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Empty and rinse onboard tanks rather than leaving product sitting in them between jobs.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse the small filter on the end of the siphon tube, which is where dried detergent collects.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Store the black nozzle with the others, because it is the one that goes missing and the one you cannot improvise.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse a foam cannon thoroughly and leave the bottle empty and open to dry.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not leave detergent in the machine over winter, where it can dry solid in the injector.</span>
            </li>
          </ul>

          <p>
            That last point overlaps with the wider winter routine, which matters far more on an electric machine than people assume. Water left in the pump over a freeze cracks the housing, and on most consumer machines the pump is not economically replaceable, so it ends the machine. Our <a href="/how-to-winterize-a-pressure-washer/">winterizing guide</a> covers the full sequence.
          </p>

          <p>
            If the soap system has already stopped working and the nozzle, tube and filter all check out, warm water flushed back through the siphon tube will often dissolve dried product in the injector. It is worth trying before assuming a fault, because a blocked injector is by far the most likely cause and it is not a failure.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Expecting Soap Through a High-Pressure Nozzle</h3>
              <p class="text-gray-700 text-sm m-0">
                The siphon only engages at low pressure, so any high-pressure tip stops it drawing entirely. This is the single most common detergent complaint and it is not a fault. Fit the black soap nozzle, which is the only tip in the set that will let detergent through.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Applying Detergent From the Top Down</h3>
              <p class="text-gray-700 text-sm m-0">
                Cleaner running down dry siding leaves tracks that are harder to remove than the original dirt. Pre-wet the surface, apply from the bottom up so it cannot run onto dry areas, let it dwell, then rinse from the top down so the dirt has somewhere to go.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Letting the Detergent Dry on the Surface</h3>
              <p class="text-gray-700 text-sm m-0">
                Dwell time is where the cleaning happens, but a cleaner that dries leaves marks that are worse than what it was removing, and it stops working entirely. Work in sections small enough to rinse within the window, and re-wet the surface if sun or wind starts drying it.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using Bleach or Dish Soap</h3>
              <p class="text-gray-700 text-sm m-0">
                Bleach attacks pump seals, O-rings and metal components unless the machine explicitly permits it. Dish soap strips the wax or sealant on a vehicle, which is the layer keeping dirt from bonding to the paint. Use products formulated for pressure washers, diluted as the label specifies.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Never Flushing the System After Use</h3>
              <p class="text-gray-700 text-sm m-0">
                Detergent left in the injector dries and blocks it, which is the second most common cause of a soap system that stops drawing. Run plain water through the siphon for a minute at the end of every session with the black tip fitted, and rinse the tank and tube filter.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why is my pressure washer not drawing soap?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Almost always because a high-pressure nozzle is fitted. The siphon only engages at low pressure, so it stops drawing with any tip other than the black soap nozzle. After that, check the siphon tube is in the detergent, the tube filter is clear, and nothing is kinked.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What nozzle do I use for soap?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The black one, and only the black one. It is a wide low-pressure tip whose entire purpose is to drop the pressure enough for the detergent siphon to engage. No other nozzle in the set will draw soap, and there is no substitute if you lose it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I use dish soap in a pressure washer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Avoid it. On a vehicle it strips the wax or sealant that keeps dirt from bonding to the paint, and it is hard on rubber and trim over time. It also foams more than pressure washer formulations are designed for. Use a product labelled for pressure washers.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I use bleach in a pressure washer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Not unless the machine explicitly permits it. Bleach attacks pump seals, O-rings and metal components, and the damage is cumulative rather than immediate. If a job genuinely needs it, apply it separately with a garden sprayer and use the machine only to rinse.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long should detergent dwell before rinsing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Several minutes, and never long enough to dry. That window is where the chemical work happens, breaking down algae, mildew and road film so far less pressure is needed. Work in sections small enough to rinse in time, and re-wet the surface if it starts drying.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is a foam cannon better than the built-in soap tank?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For anything vertical, considerably. The built-in siphon produces thin soap that runs off in seconds, while a cannon produces thick foam that clings for minutes, which is what lets the chemistry work. Check the cannon fitting matches your machine and the minimum flow it needs.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why is my foam thin with a foam cannon?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Usually too little product in the mix, a clogged cannon filter, hard water, or a machine below the cannon minimum flow. Dissolving the detergent in warm water in the bottle helps noticeably, and it is the cheapest thing to try before adjusting anything else.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I need to flush the detergent system after use?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, and it takes a minute. Run plain water through the siphon with the black tip fitted so it actually draws, then rinse the tank and the small filter on the siphon tube. Detergent left to dry in the injector is the usual reason a working soap system stops.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Pressure Washer Guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
