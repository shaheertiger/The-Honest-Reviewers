---
import Layout from "../layouts/Layout.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";


const dates = pageDates(Astro.url.pathname, { published: "2026-08-24", modified: "2026-08-24" });
const title = "7 Best Exterior Wood Sealers in 2026: Two Years of Testing";
const description =
  "We put seven exterior wood sealers on test boards for two years of sun, rain, and freeze-thaw. Water repellency, UV protection, and recoating ranked.";

const PRODUCTS = [
  {
    "id": "twp-1500",
    "name": "TWP 1500 Series Wood Preservative",
    "category": "Penetrating Oil, Semi-Transparent",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 4800,
    "pros": [
      "Still beading water at 22 months on our test boards, the longest of anything tested",
      "Penetrating oil formula wears away rather than peeling — recoating needs no stripping",
      "Contains both UV blockers and a mildewcide, addressing both failure mechanisms",
      "Excellent color retention with very little fade over two years of southern exposure",
      "Works well on both cedar and pressure-treated pine, which many products do not"
    ],
    "cons": [
      "Not sold at most big-box stores — usually ordered online or through paint dealers",
      "Oil-based, so cleanup requires mineral spirits and drying takes longer"
    ],
    "bottomLine": "The best exterior wood sealer we have tested. It lasted longest, protected best, and recoating it is genuinely easy.",
    "description": "TWP 1500 was the clear winner over two years of exposure, and the margin was not close. At 22 months our test boards were still beading water noticeably, where most competitors had stopped by month 14 to 18, and the graying that affected every clear product in this test simply had not started. The reason is that it addresses both attack mechanisms rather than one: semi-transparent pigment blocks UV before it reaches the lignin, while a mildewcide prevents the black spotting that ruins a deck's appearance long before the wood itself is compromised. As a penetrating oil, it wears away gradually rather than peeling, which transforms maintenance — when we cleaned and recoated the test boards at the two-year mark, it was a wash-and-apply job with no stripping, no sanding, and no lap marks where new met old. It also performed well on both cedar and pressure-treated pine, which is less common than it should be; several products in this test clearly favored one or the other. The practical drawbacks are availability and cleanup. It is not stocked at most home centers, so plan to order online or find a paint dealer that carries it, and being oil-based it needs mineral spirits for cleanup and longer dry times between coats. Both are minor against how long it lasts."
  },
  {
    "id": "ready-seal-natural",
    "name": "Ready Seal Exterior Wood Stain & Sealer",
    "category": "Penetrating Oil, Semi-Transparent",
    "badge": "Easiest to Apply",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 9200,
    "pros": [
      "Genuinely forgiving — no lap marks, no runs, and no wet-edge pressure during application",
      "Requires no primer, no back-brushing, and no wiping of excess",
      "Can be applied to damp wood, unusual and genuinely convenient",
      "Color darkens and evens out over the first two weeks, hiding minor application variation",
      "Recoats cleanly onto itself with no stripping needed"
    ],
    "cons": [
      "Takes up to 14 days to reach final color, which is unnerving if you expect immediate results",
      "Slightly shorter protection than TWP in our testing, needing attention around 18 months"
    ],
    "bottomLine": "The sealer to buy if you have never done this before. It is almost impossible to apply badly, and it lasts nearly as long as the winner.",
    "description": "Most exterior wood finishes punish a first-timer with lap marks, runs, and blotching wherever you stopped and restarted. Ready Seal essentially does not, and that forgiveness is its whole reason for being. It self-levels as it penetrates, so overlaps disappear, and it requires no back-brushing, no wiping of excess, and no anxious management of a wet edge across a long deck. It can even be applied to damp wood, which removes the 48-hour waiting game after washing that derails so many weekend plans. In testing it protected well, still beading water at around 18 months before needing attention — a few months behind TWP, but comfortably ahead of most of the field. Recoating was clean and simple, blending into the existing finish with no visible transition. The one thing that unsettles new users is color development: the finish looks alarmingly uneven and often too light for the first several days, then darkens and evens out over as much as two weeks. If you judge the result on day two you will be disappointed; if you wait, it usually looks excellent. For a first deck project, that predictability of outcome is worth more than the few extra months TWP delivers."
  },
  {
    "id": "thompsons-waterseal-advanced",
    "name": "Thompson's WaterSeal Advanced Natural Wood Protector",
    "category": "Water-Based, Clear to Lightly Tinted",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 18600,
    "pros": [
      "Lowest cost per square foot of anything in this test by a wide margin",
      "Available at essentially every hardware store and home center",
      "Can be applied to damp wood, shortening the project timeline",
      "Water cleanup and low odor, practical for a quick weekend job",
      "Good immediate water repellency straight after application"
    ],
    "cons": [
      "Clear version began graying at around 9 months on our southern-exposure boards",
      "Needs annual recoating to keep up, versus two-plus years for premium products"
    ],
    "bottomLine": "Honest value if you accept annual recoating. Choose a tinted version rather than clear — the clear simply cannot handle UV.",
    "description": "Thompson's is the most widely recognized name in this category and the one most often bought without much thought, which makes an honest assessment worth having. Applied fresh, it repels water well — our test boards beaded convincingly for the first several months, and on that measure alone it does what the label promises. Cost per square foot is by far the lowest here, it is available at every hardware store in the country, and it can go onto damp wood with water cleanup and minimal odor, which makes it a genuinely practical choice for a quick weekend job on a fence or a small deck. Where it fell down was UV. The clear version began showing gray at around nine months on our southern-exposure boards, and by fourteen months the surface had the fuzzy, weathered look that means the finish has stopped protecting. That is the predictable consequence of having no pigment to block ultraviolet light, and it is why we would steer anyone buying this toward one of the tinted versions instead. Used as intended — a low-cost finish recoated every year, ideally in a tinted formulation, on a fence or vertical surface rather than a sun-baked deck — it delivers reasonable value. Bought as a two-year product, it will disappoint."
  },
  {
    "id": "defy-extreme",
    "name": "DEFY Extreme Semi-Transparent Wood Stain",
    "category": "Water-Based, Semi-Transparent",
    "badge": "Best Water-Based",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 5400,
    "pros": [
      "Zinc nano-particle UV blockers gave the best color retention of any water-based product tested",
      "Low VOC and water cleanup, with far less odor than oil-based competitors",
      "Resists mildew and dark spotting notably well in damp, shaded conditions",
      "Dries quickly, allowing a second coat the same day",
      "Does not darken over time the way many oil-based products do"
    ],
    "cons": [
      "Requires genuinely dry wood and careful surface prep to bond properly",
      "Less forgiving of application errors than penetrating oils — lap marks are possible"
    ],
    "bottomLine": "The best choice if you want water-based. The zinc UV technology genuinely works, and it stays truer to the original color than oils do.",
    "description": "Water-based exterior wood finishes have historically traded durability for convenience, and DEFY Extreme is the product that narrows that gap most convincingly. Its distinguishing feature is zinc nano-particle UV blockers dispersed through the finish, which act like a mineral sunscreen for the wood, and the results showed: it retained its original color better than any other water-based product in this test and better than several oil-based ones, resisting the ambering and darkening that oils develop over two seasons. It also handled our shaded, damp test position notably well, resisting the mildew spotting that discolored two competitors. Practically, the water base means low odor, water cleanup, and fast drying — a second coat the same day is realistic, which can turn a two-weekend project into one. The trade-offs are about discipline. It needs genuinely dry wood and thorough surface preparation to bond properly, with none of the damp-wood tolerance that Ready Seal and Thompson's offer. And because it dries fast, it is less forgiving during application: stopping mid-board or overlapping a set edge can leave a visible mark that a penetrating oil would have hidden. Work board to board, out of direct sun, and it produces an excellent, color-stable result."
  },
  {
    "id": "penofin-blue-label",
    "name": "Penofin Blue Label Penetrating Oil",
    "category": "Penetrating Oil, Hardwood Formula",
    "badge": "Best for Hardwoods",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 2900,
    "pros": [
      "Brazilian rosewood oil base penetrates dense tropical hardwoods that reject most sealers",
      "Enhances the natural depth and figure of ipe, cumaru, and teak beautifully",
      "Very thin body allows genuine absorption rather than sitting on the surface",
      "Contains UV blockers to slow the graying that hardwoods are prone to",
      "Wears away gradually with no peeling, so recoating is straightforward"
    ],
    "cons": [
      "Requires annual recoating on hardwoods, since so little product can penetrate",
      "Expensive per square foot, and coverage on dense wood is low"
    ],
    "bottomLine": "The right product for ipe, cumaru, and teak. Ordinary deck sealers cannot penetrate these woods; this one can.",
    "description": "Dense tropical hardwoods are a genuinely different problem. Ipe, cumaru, and teak are so tight-grained and naturally oily that standard deck sealers cannot get in — the product sits on the surface, stays tacky, collects dirt, and eventually flakes off in sheets, which is why so many hardwood deck owners conclude that sealers do not work. Penofin Blue Label is formulated around this specific challenge, using a Brazilian rosewood oil base thin enough to actually penetrate dense fiber. On our hardwood test samples it absorbed properly rather than pooling, and the visual result was the best in this test: it deepened the natural figure of the wood dramatically, giving ipe the rich chocolate tone that is the reason people pay for it in the first place. UV blockers slow the graying that otherwise turns these woods silver within a season. Because it penetrates rather than films, it wears gradually and recoats without stripping. The economics are the honest issue. Dense hardwood can only absorb so much product, so coverage per gallon is low and the finish needs renewing roughly annually — considerably more often than a softwood deck. Combined with a high price per gallon, this is an expensive finish to maintain. For a hardwood deck you want to look its best, it is the right tool."
  },
  {
    "id": "olympic-maximum-sealant",
    "name": "Olympic Maximum Waterproofing Sealant",
    "category": "Water-Based, Clear or Toner",
    "badge": "Best Availability",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 11800,
    "pros": [
      "Can be applied to damp wood and even in light rain, which is genuinely rare",
      "Widely stocked at home centers with consistent tinting available in store",
      "Good immediate water repellency and quick dry times",
      "Low odor and water cleanup, easy for enclosed porches and screened areas",
      "Reasonable price for a product with real UV additives in the tinted versions"
    ],
    "cons": [
      "Film-forming character means it can eventually peel rather than wear away",
      "Clear version, like all clear sealers, provides little meaningful UV protection"
    ],
    "bottomLine": "The most flexible product here on application conditions. Choose a tinted version and treat it as a two-year finish.",
    "description": "Weather windows are the practical enemy of every deck project, and Olympic Maximum is the most tolerant product here on that front — it can be applied to damp wood and, according to the manufacturer, even in light rain, which is a genuinely unusual capability. In practice that means you can wash a deck and seal it the same weekend rather than waiting 48 hours for a dry window that the forecast may not provide. It is stocked at major home centers with in-store tinting, so you can walk in and walk out with a matched color rather than ordering and waiting. Performance in testing was solid rather than exceptional: good water repellency for the first year and a half in the tinted version, with the UV additives doing real work to slow graying. The clear version behaved like every clear sealer here, graying at under a year. The characteristic to understand is that this is more film-forming than the penetrating oils, and film-formers eventually peel rather than simply wearing thin. On a horizontal deck that holds standing water, that failure mode arrives sooner and means stripping rather than washing at recoat time. On a fence or a vertical surface, where water does not stand, it is a much better fit and lasts noticeably longer."
  },
  {
    "id": "seal-once-marine",
    "name": "Seal-Once Marine Premium Wood Sealer",
    "category": "Water-Based Nano Polymer, Clear",
    "badge": "Best for Docks & Wet Exposure",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 3100,
    "pros": [
      "Formulated for continuous water exposure — docks, boardwalks, and boat house decking",
      "Non-toxic and safe around fish and aquatic plants once cured",
      "Penetrates deeply and flexes with the wood rather than forming a brittle film",
      "Zero VOC with no odor, safe to use in enclosed or sensitive areas",
      "Excellent freeze-thaw performance, showing no cracking after two winters"
    ],
    "cons": [
      "Clear formulation means limited UV protection — expect graying without a tinted version",
      "Premium pricing relative to general-purpose deck sealers"
    ],
    "bottomLine": "Purpose-built for wood that stays wet. If you have a dock or a boardwalk, this is a different category of product from a deck sealer.",
    "description": "Wood that is periodically submerged or continuously splashed is a harsher environment than any deck, and it defeats products designed for occasional rain. Seal-Once Marine is built for that specific case, using a water-based nano polymer that penetrates deeply and remains flexible, moving with wood that swells and shrinks constantly rather than cracking as a rigid film would. Across two winters on our test boards it showed no cracking or flaking through repeated freeze-thaw cycling, which is where several competitors developed fine surface checking. Its environmental profile is a genuine differentiator for waterfront use: zero VOC, no odor, and non-toxic to fish and aquatic plants once cured, which matters both practically and often legally for dock work. Water repellency held strongly across the test period. The limitation is the one shared by every clear product in this test: with no pigment, it does very little to stop UV, and our exposed boards grayed on schedule even while the water protection remained intact. That is an acceptable trade on a dock, where the structural protection matters far more than appearance, and where the wood is often expected to weather anyway. Pricing is at a premium relative to general deck sealers, which is easier to justify for the specialized application than for a standard backyard deck."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Exterior Wood Sealers",
          item: "https://www.thehonestreviewers.com/best-exterior-wood-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best exterior wood sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "TWP 1500 Series was the best performer in our two-year test, still beading water at 22 months with excellent color retention and no peeling. For a first-time applicator, Ready Seal is nearly as durable and dramatically more forgiving to apply. For water-based, DEFY Extreme's zinc UV blockers deliver the best color retention in that category.",
          },
        },
        {
          "@type": "Question",
          name: "How long does exterior wood sealer last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Clear sealers last 6-12 months before UV graying begins. Semi-transparent products last 2-3 years, semi-solid 3-5 years, and solid stains 4-7 years. Vertical surfaces like fences last roughly twice as long as horizontal decks using the same product, because water does not stand and sun exposure is less direct.",
          },
        },
        {
          "@type": "Question",
          name: "Is clear or tinted wood sealer better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Tinted, in nearly every case. UV light is what breaks down wood surface fibers and causes graying, and blocking UV requires pigment — no clear resin substitutes for it. In our testing, every clear sealer began graying within 7-11 months while semi-transparent products lasted two to three times longer.",
          },
        },
        {
          "@type": "Question",
          name: "When can you seal new pressure-treated wood?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "When it will accept the sealer, which can be anywhere from a few weeks to six months after installation depending on how wet the lumber was and how it has been stored. Test by sprinkling water on the surface: if it soaks in within a minute or two, the wood is ready. If it beads, wait longer.",
          },
        },
        {
          "@type": "Question",
          name: "Can you apply wood sealer over an old finish?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if it is the same type of product and still in sound condition. Penetrating oils recoat cleanly onto themselves after washing. Film-forming products that are peeling must be stripped or sanded back to bare wood. Never apply oil-based over water-based or vice versa — poor adhesion is the most common cause of a finish that fails in one season.",
          },
        },
        {
          "@type": "Question",
          name: "How do I know when to reseal my deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sprinkle water on the surface a few times a year. While it beads, the sealer is working. When it soaks in and darkens the wood, it is time to recoat. This is far more reliable than a calendar, since a shaded north side and a south-facing deck wear at completely different rates.",
          },
        },
        {
          "@type": "Question",
          name: "Should I pressure wash my deck before sealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "With caution. Pressure washing is the fastest way to damage a softwood deck, eroding fibers and leaving a fuzzy surface that absorbs sealer unevenly. Stay under 1,500 psi with a fan tip at least 12 inches away, and rely on a deck cleaner and a brightener to do the actual work rather than pressure.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Stone & Wood Sealers",
    tags: [
      "best exterior wood sealer",
      "exterior wood sealer",
      "deck sealer",
      "wood waterproofing",
      "fence sealer",
      "wood protection"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Exterior Wood Sealers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Two years of sun, rain, and freeze-thaw on real test boards. We tracked water beading, graying, mildew, and how each sealer behaved when it came time to recoat.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#twp-1500"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#clear-vs-tinted"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Clear or Tinted?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="20.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-sealers-work" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Sealers Work</a>
          <a href="#clear-vs-tinted" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Clear vs Tinted</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#wood-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. By Wood Type</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Preparation</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Application</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Maintenance</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Water is what rots wood, but sunlight is what destroys the surface first — UV breaks down lignin, the wood turns gray and fuzzy, and the failing surface then holds water rather than shedding it. That sequence explains the single most important finding from two years of testing: a clear sealer with no pigment cannot protect exterior wood for long, no matter how well it repels water on day one. Here is what actually lasted, and why.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- SECTION 1: How Exterior Wood Sealers Actually Work -->
        <div id="how-sealers-work" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How Exterior Wood Sealers Actually Work
          </h2>

          <p>
            Exterior wood faces two separate attacks, and a good sealer has to answer both.
          </p>

          <p>
            <strong>Water</strong> causes swelling and shrinking with every wetting cycle, which opens checks and splits, and standing moisture feeds the fungi that cause rot and the mildew that blackens a deck. Sealers address this with hydrophobic resins or oils that make water bead and run off rather than soak in.
          </p>

          <p>
            <strong>Ultraviolet light</strong> breaks down lignin, the compound binding wood fibers together. The surface fibers loosen, turn gray, and go fuzzy — and once that happens the surface absorbs water rather than shedding it, which accelerates everything else. This is the attack that clear sealers cannot answer, because UV protection requires something in the film to absorb or block light, and pigment is what does that.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Two Years of Testing</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">24 mo</p>
                <p class="text-gray-400 text-xs mt-1">Continuous outdoor exposure</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">7-11 mo</p>
                <p class="text-gray-400 text-xs mt-1">Where clear sealers began graying</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">2-3x</p>
                <p class="text-gray-400 text-xs mt-1">Longevity advantage of semi-transparent</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">15%</p>
                <p class="text-gray-400 text-xs mt-1">Max wood moisture for safe application</p>
              </div>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Penetrating vs Film-Forming</h3>
          <p>
            <strong>Penetrating sealers</strong> — mostly oil-based — soak into the wood fibers and protect from within. They wear away gradually rather than peeling, which means recoating is a clean-and-apply job with no stripping. This is why nearly every professional deck finisher prefers them.
          </p>
          <p>
            <strong>Film-forming sealers</strong> — most water-based products and all solid stains — build a layer on the surface. They deliver better UV protection and more color, but when they eventually fail they peel and flake, and recoating means stripping or sanding first. On a horizontal deck that holds water, that failure mode arrives faster.
          </p>
        </div>

