const dates = pageDates(Astro.url.pathname, { published: "2026-09-08", modified: "2026-09-08" });
const title = "Can a Portable Power Station Run a CPAP? (Nights Per Charge)";
const description =
  "Yes, and a small one goes further than you think — if you turn the humidifier off and run it on DC. Here is the runtime maths for real machines.";

