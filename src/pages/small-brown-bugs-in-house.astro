                    <td class="px-4 py-4 text-gray-700">Soft, pale tan to brown, wingless, quick</td>
                    <td class="px-4 py-4 text-gray-700">Damp books, paper, cardboard, basement boxes</td>
                    <td class="px-4 py-4 text-gray-700">Humidity high enough for mold</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Springtails</td>
