                    <td class="px-4 py-4 font-black text-gray-900">Carpet beetle larvae</td>
                    <td class="px-4 py-4 text-gray-700">Up to about 5/16 in</td>
                    <td class="px-4 py-4 text-gray-700">Bristly, banded brown, caterpillar-like; leaves shed skins</td>
                    <td class="px-4 py-4 text-gray-700">Closets, rug edges, under furniture, baseboards</td>
                    <td class="px-4 py-4 text-gray-700">Wool, feathers or pet hair to feed on</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Bed bugs</td>
                    <td class="px-4 py-4 text-gray-700">About apple-seed size</td>
                    <td class="px-4 py-4 text-gray-700">Flat, oval, reddish-brown, wingless</td>
                    <td class="px-4 py-4 text-gray-700">Mattress seams, headboards, bed frames</td>
                    <td class="px-4 py-4 text-gray-700">Needs a methodical plan</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fleas</td>
