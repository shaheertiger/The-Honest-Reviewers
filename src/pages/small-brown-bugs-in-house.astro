                    <td class="px-4 py-4 text-gray-700">About 1/8 in</td>
                    <td class="px-4 py-4 text-gray-700">Reddish-brown, oval, fine lengthwise grooves on the wing covers</td>
                    <td class="px-4 py-4 text-gray-700">Pantry, spices, pet food, windowsills</td>
                    <td class="px-4 py-4 text-gray-700">An infested dry-goods package</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cigarette beetle</td>
                    <td class="px-4 py-4 text-gray-700">About 1/8 in</td>
                    <td class="px-4 py-4 text-gray-700">Like the drugstore beetle but smooth wing covers, humped, head tucked under</td>
                    <td class="px-4 py-4 text-gray-700">Spices, dried peppers, pet food, dried flowers</td>
                    <td class="px-4 py-4 text-gray-700">An infested package or decoration</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sawtoothed grain beetle</td>
                    <td class="px-4 py-4 text-gray-700">About 1/10 in</td>
                    <td class="px-4 py-4 text-gray-700">Slender and flat, six saw-like teeth along each side of the thorax</td>
                    <td class="px-4 py-4 text-gray-700">Cereal, flour, dried fruit, nuts</td>
                    <td class="px-4 py-4 text-gray-700">Infested dry goods</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flour beetles</td>
                    <td class="px-4 py-4 text-gray-700">About 1/7 in</td>
                    <td class="px-4 py-4 text-gray-700">Reddish-brown, flat, elongated</td>
                    <td class="px-4 py-4 text-gray-700">Flour, baking mixes, crackers</td>
                    <td class="px-4 py-4 text-gray-700">Old or damaged flour products</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rice and granary weevils</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1/8 in</td>
                    <td class="px-4 py-4 text-gray-700">Dark brown with a distinct snout</td>
                    <td class="px-4 py-4 text-gray-700">Whole grains, rice, popcorn</td>
