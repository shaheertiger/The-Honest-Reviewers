                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fine cracks, sides level</td>
                    <td class="px-4 py-4 text-gray-700">Shrinkage</td>
                    <td class="px-4 py-4 text-gray-700">Fill or leave alone</td>
                  </tr>
