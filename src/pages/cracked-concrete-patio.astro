                    <td class="px-4 py-4 text-gray-700">Cover or replace</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flaking surface, few cracks</td>
                    <td class="px-4 py-4 text-gray-700">Freeze-thaw, deicers</td>
                    <td class="px-4 py-4 text-gray-700">Resurface</td>
