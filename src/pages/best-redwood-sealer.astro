    badge: "Best Overall",
    amazonUrl: "https://amzn.to/4bSW9jy",
    rating: 4.7,
    reviewCount: 14200,
    pros: [
      "No primer, back-brushing, or wet-line application required",
      "Self-priming formula penetrates deep into redwood grain",
