import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water-Based Paver Sealers",
    "url": "/best-water-based-paver-sealer-reviews/"
  },
  {
    "title": "Why Paver Sealer Turns White",
