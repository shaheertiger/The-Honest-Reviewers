const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Temperature to Seal Pavers",
          item: "https://www.thehonestreviewers.com/what-temperature-to-seal-pavers/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best temperature to seal pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A surface temperature between 16 and 27 degrees Celsius, ideally in the lower half of that band, out of direct sun, with an overnight low above 10 degrees and no rain for at least 24 hours. A mild overcast day at around 18 degrees is close to perfect conditions."
          }
        },
        {
          "@type": "Question",
          "name": "Can you seal pavers in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Below about 10 degrees Celsius a water-based sealer may not coalesce properly, producing a chalky film with the integrity of powder that fails within a season. Solvent-based is more tolerant at the low end but cures slowly and is very intolerant of the damp that cold pavers usually hold. Below 7 degrees, do not seal."
          }
        },
        {
          "@type": "Question",
          "name": "Can it be too hot to seal pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is more common than people expect because surface temperature runs far above air temperature in sun. On a hot surface the carrier flashes before the sealer can flow out and penetrate, producing lap marks, blotchy absorption and, with solvent products, blushing from trapped solvent."
          }
        },
        {
          "@type": "Question",
          "name": "Does humidity affect sealing pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Considerably. High humidity slows evaporation, which extends every stage of drying and curing and widens the window in which dew, a shower or a sprinkler can damage the film. Aim for below about 70 percent relative humidity, and be aware that a still humid day can double the wait before foot traffic."
          }
        },
        {
          "@type": "Question",
          "name": "How do I measure paver surface temperature?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An infrared thermometer, which costs roughly the same as a gallon of sealer and removes the largest source of error in this subject. Point it at several places — sunny middle, shaded edge, the area that has been in sun longest. Without one, keep the surface out of direct sun entirely."
          }
        },
        {
          "@type": "Question",
          "name": "What time of day is best to seal pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Early morning is usually best, because surfaces are coolest and the film gets maximum daylight hours to cure before nightfall and dew. Late afternoon works on a cool day but leaves less curing time before the temperature drops. On an overcast day the timing matters much less."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best time of year to seal pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Late spring and early autumn in temperate climates, when days and nights are both mild and the sun angle is low enough that surfaces do not bake. High summer works if you schedule around the sun. Late autumn is a trap — mild afternoons, cold nights, damp pavers and short days."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
