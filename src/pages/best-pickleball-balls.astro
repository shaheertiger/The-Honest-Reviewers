                    <td class="px-4 py-4 text-gray-700">About 0.92 oz (26 g)</td>
                    <td class="px-4 py-4 text-gray-700">About 0.85 to 0.92 oz</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Diameter</td>
                    <td class="px-4 py-4 text-gray-700">2.87 to 2.97 in</td>
                    <td class="px-4 py-4 text-gray-700">About 2.9 in (74 mm)</td>
                    <td class="px-4 py-4 text-gray-700">About 2.9 in (74 mm)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Holes</td>
                    <td class="px-4 py-4 text-gray-700">26 to 40</td>
                    <td class="px-4 py-4 text-gray-700">About 40, smaller</td>
                    <td class="px-4 py-4 text-gray-700">About 26, larger</td>
                  </tr>
