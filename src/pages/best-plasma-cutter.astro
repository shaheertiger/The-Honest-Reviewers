---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Welders for Beginners",
    "url": "/best-welder-for-beginners/"
  },
  {
    "title": "Best Angle Grinders",
    "url": "/best-angle-grinder/"
  },
  {
    "title": "Best Bench Vises",
    "url": "/best-bench-vise/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best Cordless Tool Brand",
    "url": "/best-cordless-tool-brand/"
  },
  {
    "title": "Best Wire Strippers",
    "url": "/best-wire-stripper/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Plasma Cutters: Clean-Cut Picks From Hobby to Shop";
const description =
  "The best plasma cutters for home shops and fabrication, compared on rated cut versus severance, air supply, duty cycle and 120V or 240V input, with honest caveats.";

const PRODUCTS = [
  {
    "id": "hypertherm-powermax30-xp",
    "name": "Hypertherm Powermax30 XP",
    "badge": "Best Overall",
    "category": "120/240V, 30A, External Air",
    "amazonUrl": "#",
    "description": "The Hypertherm Powermax30 XP is the plasma cutter we would recommend to most home shops and farms, because it pairs a useful cut rating with the brand whose consumables and support are easiest to find. Hypertherm's specification sheet lists a recommended cut of 3/8 inch at 20 inches per minute and a severance capacity of 5/8 inch. It runs on 120 to 240 volts single-phase, with 15 to 30 amps of output, and the duty cycle is listed as 35 percent at 240 volts and 20 percent at 120 volts. Listings say it ships with a 240-volt plug plus adapters for 120-volt 15-amp and 240-volt 20-amp circuits on CSA models. It needs an external air supply; retailers list a recommended flow of 4 scfm at 80 psi of clean, dry, oil-free air. The system weighs about 21.4 pounds with the 15-foot torch. It costs more than import machines, and that premium buys consistent cut quality and long consumable life.",
    "pros": [
      "3/8-inch recommended cut, 5/8-inch severance, per Hypertherm",
      "Runs on 120V or 240V with plug adapters",
      "About 21 pounds with torch",
      "Modest air need of about 4 scfm at 80 psi, per listings",
      "Strong consumable availability and dealer support"
    ],
    "cons": [
      "20 percent duty cycle on 120V",
      "Needs a separate air compressor",
      "Costs more than import alternatives"
    ],
    "bottomLine": "For a home shop cutting up to 3/8-inch steel, the Powermax30 XP is the safest buy: dependable cuts, dual voltage and consumables you can find."
  },
  {
    "id": "hypertherm-powermax45-xp",
    "name": "Hypertherm Powermax45 XP",
    "badge": "Best for Thick Steel",
    "category": "240V, 45A, External Air",
    "amazonUrl": "#",
    "description": "The Powermax45 XP is the step up for fabricators and farms that cut 1/2-inch plate regularly. Retailer listings give a recommended cut of 5/8 inch and a severance capacity of 1-1/8 inches, though some Welders Supply pages list 1/2 inch as the cut capacity, so check Hypertherm's manual for your configuration. Air demand is higher: listings give 6 scfm at 90 psi for cutting, which rules out small pancake compressors. It is sold in hand-torch and mechanized packages with CPC ports for CNC tables, and listed weights vary with the package. Warranty figures also vary by listing, with one retailer citing six years on the power supply and another three, so confirm the term with your dealer. This is more machine than most hobbyists need, but if your work is 1/2-inch and thicker, buying the 30 XP and fighting it is a false economy.",
    "pros": [
      "5/8-inch recommended cut, per retailer listings",
      "Severs over an inch of steel, per listings",
      "CNC-ready packages with CPC port",
      "Hypertherm consumables and support",
      "Headroom for heavy fabrication"
    ],
    "cons": [
      "Needs about 6 scfm at 90 psi of air",
      "Listings disagree on cut rating and warranty",
      "Overkill and overpriced for sheet metal"
    ],
    "bottomLine": "Choose the Powermax45 XP if 1/2-inch plate is routine or you plan a CNC table; most home users are better served by the 30 XP."
  },
  {
    "id": "hobart-airforce-40i",
    "name": "Hobart AirForce 40i",
    "badge": "Best Value Brand-Name",
    "category": "120/240V, 40A, External Air",
    "amazonUrl": "#",
    "description": "The Hobart AirForce 40i gives more cutting capacity per dollar than the Hypertherm while keeping a major brand's support. Listings give a rated cut of 5/8-inch mild steel at a 60 percent duty cycle and a maximum severance of 7/8 inch, with the higher figures applying on 240-volt power. A Hobart spec sheet lists 20 amps at 60 percent on a 120-volt 15-amp circuit, 27 amps at 35 percent on a 120-volt 20-amp circuit and 40 amps at 60 percent on 240 volts, so it is genuinely usable on household power at reduced output. Current listings call for at least 6.0 cfm at 90 to 120 psi of air, while older Hobart literature cited 4.8 scfm, so plan for the higher figure when sizing a compressor. Listed weights range from about 21 to under 30 pounds. The 60 percent duty cycle at its 240-volt rating is generous for long cuts.",
    "pros": [
      "5/8-inch rated cut at 60 percent duty cycle, per listings",
      "Runs on 120V or 240V with MVP adapters",
      "High duty cycle on 240V",
      "More capacity per dollar than Hypertherm",
      "Hobart dealer network"
    ],
    "cons": [
      "Needs about 6 cfm at 90 psi per current listings",
      "Full rating requires 240V",
      "Air spec has changed between documents"
    ],
    "bottomLine": "For thicker cuts on a budget with brand-name support, the AirForce 40i is the value pick, as long as your compressor can supply about 6 cfm."
  },
  {
    "id": "miller-spectrum-375-x-treme",
    "name": "Miller Spectrum 375 X-TREME",
    "badge": "Most Portable",
    "category": "120/240V, 30A, External Air",
    "amazonUrl": "#",
    "description": "The Miller Spectrum 375 X-TREME is the plasma cutter to throw in a truck. Miller rates it at 30 amps for mild steel up to 3/8 inch, with one retailer listing 1/4-inch aluminum capacity. It runs on 115 or 230 volts single-phase with automatic input detection, and ships with 5-15P and 6-50P plugs per listings. At about 18 pounds, with one listing giving 19, it is among the lightest units here. It needs a compressor supplying at least 90 psi. We could not find a duty cycle figure in the listings we checked, so look at Miller's spec sheet before relying on it for long production cuts. It costs more than import units at the same amperage, and you are paying for portability, Miller build quality and dealer support rather than raw capacity.",
    "pros": [
      "About 18 pounds, per listings",
      "3/8-inch mild steel capacity, per Miller",
      "Auto-detects 115V or 230V input",
      "Ships with both plug types",
      "Miller service network"
    ],
    "cons": [
      "Duty cycle not stated in the listings we found",
      "Pricey for 30 amps",
      "Needs a compressor at 90 psi minimum"
    ],
    "bottomLine": "If you carry your cutter to jobs, the Spectrum 375 X-TREME's light weight and auto voltage detection are worth the premium."
