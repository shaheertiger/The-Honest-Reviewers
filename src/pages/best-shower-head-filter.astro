          "@type": "Question",
          "name": "Can I use a shower filter with a handheld shower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you install an inline filter on the shower arm before the hose, so all water to the handheld passes through it. Filtered showerheads replace the head itself, so they only work with handhelds designed for them."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
