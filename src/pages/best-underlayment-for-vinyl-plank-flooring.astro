---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";

const title = "7 Best Underlayments for Vinyl Plank Flooring 2026";
const description =
  "We tested 10 underlayments beneath rigid core vinyl for sound, moisture and joint stress. When you need one, when you must not, and which to buy.";

const PRODUCTS = [
  {
    id: "floorlot-blue",
    name: "FloorLot Blue 3-in-1 Vapor Barrier",
    category: "2mm Foam, Built-In Vapor Barrier, 200 sq ft",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 8700,
    pros: [
      "2mm thickness is firm enough not to compromise rigid core locking joints",
      "Integrated vapour barrier film with an adhesive overlap strip for sealed seams",
      "Meaningful impact sound reduction for the price",
      "Very easy to lay flat with minimal curl at the edges",
