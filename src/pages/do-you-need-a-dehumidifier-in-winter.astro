];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "Do You Need a Dehumidifier in Winter?";
const description =
  "Most basements do not, and running a standard compressor unit below about 18°C can freeze its coil. When winter damp is real, what causes it, and what to run instead.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Do You Need a Dehumidifier in Winter", item: "https://www.thehonestreviewers.com/do-you-need-a-dehumidifier-in-winter/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you need a dehumidifier in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Usually not. Cold outdoor air holds very little moisture, and heating it indoors drops the relative humidity further, so most homes are drier in winter than in summer. The exceptions are real though: an unheated basement or crawlspace with a genuine water source, a house with heavy internal moisture generation and poor ventilation, or a mild damp maritime winter where outdoor humidity stays high." },
        },
        {
          "@type": "Question",
          name: "Will a dehumidifier work in a cold basement?",
          acceptedAnswer: { "@type": "Answer", text: "A standard compressor dehumidifier loses efficiency as temperature drops and its coil begins frosting over, which is why most are rated only down to about 15 to 18°C. Below that they either cycle constantly through defrost or stop working altogether. Low-temperature compressor models with active defrost, and desiccant dehumidifiers, are the two designs that work in genuinely cold spaces." },
        },
        {
          "@type": "Question",
          name: "What humidity should a basement be in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Around 30 to 50 percent relative humidity is the usual target, and in winter the lower half of that range is sensible. Above 60 percent supports mould growth and dust mites; below about 30 percent causes discomfort, static and shrinkage in timber and joinery. A cheap hygrometer is the only way to know where you actually are, and it is worth buying before a dehumidifier." },
        },
        {
          "@type": "Question",
          name: "Why is my basement damp in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Usually one of three things: liquid water entering through the foundation from saturated or thawing ground, moisture rising through an uncovered slab or dirt crawlspace floor, or warm humid indoor air condensing on cold surfaces such as walls below grade, cold water pipes and uninsulated rim joists. The third is the most common in a heated house, and a dehumidifier treats the symptom rather than the cause." },
        },
        {
          "@type": "Question",
          name: "Should you run a dehumidifier in an unheated crawlspace in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Only if it is a model rated for low temperatures, and ideally only in a crawlspace that has been encapsulated and sealed first. Running a standard unit in a cold vented crawlspace mostly produces a frozen coil and a high electricity bill, while doing nothing about the ground moisture and outside air that caused the problem. Seal and cover the ground first, then dehumidify if the readings still call for it." },
        },
        {
          "@type": "Question",
          name: "Is a desiccant dehumidifier better in winter?",
          acceptedAnswer: { "@type": "Answer", text: "In a cold space, yes. A desiccant unit adsorbs moisture onto a rotating wheel and regenerates it with a heater rather than relying on condensation, so it works at low temperatures where a compressor unit frosts up. It also gives off a little heat, which is welcome in a garage or cellar. The trade-offs are higher running cost and less capacity per kilowatt in warm conditions." },
        },
        {
          "@type": "Question",
          name: "Can a dehumidifier stop condensation on windows?",
          acceptedAnswer: { "@type": "Answer", text: "It can reduce it, because condensation is indoor moisture meeting a cold surface, and lowering the moisture raises the temperature at which that happens. But window condensation usually points at ventilation rather than a need for a machine — extractor fans that vent outside, lids on pans, drying laundry outdoors or in a vented dryer, and trickle vents will often solve it more cheaply and permanently." },
        },
        {
          "@type": "Question",
          name: "Does a dehumidifier help prevent mould in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Keeping relative humidity below about 60 percent does prevent mould growth, so where winter humidity genuinely runs high a dehumidifier helps. But mould in a cold-weather house is more often about cold surfaces than about overall humidity — a wall behind a wardrobe on an uninsulated external wall grows mould at room humidity because that surface is much colder than the room. Insulation and air movement fix that; a dehumidifier does not." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
