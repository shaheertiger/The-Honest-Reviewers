                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Deep fills</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Water-based / latex</td>
                    <td class="px-4 py-4 text-gray-700">About 15 minutes to 2 hours</td>
                    <td class="px-4 py-4 text-gray-700">Several hours to overnight; build in layers</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solvent-based</td>
                    <td class="px-4 py-4 text-gray-700">About 15 to 60 minutes</td>
                    <td class="px-4 py-4 text-gray-700">Hours; shrinks, so overfill or layer</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Two-part polyester</td>
                    <td class="px-4 py-4 text-gray-700">Often 15 to 30 minutes</td>
                    <td class="px-4 py-4 text-gray-700">About the same as shallow</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Two-part epoxy</td>
                    <td class="px-4 py-4 text-gray-700">A few hours (15-30 min working time)</td>
                    <td class="px-4 py-4 text-gray-700">About the same; full cure often 24 hours</td>
                  </tr>
