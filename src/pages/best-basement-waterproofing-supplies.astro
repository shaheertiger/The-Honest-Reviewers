  description={description}
  ogImage="https://placehold.co/1200x630/374151/white?text=Best+Basement+Waterproofing+Supplies+2026"
  ogType="article"
  article={{
    publishedTime: "2026-08-11",
    modifiedTime: "2026-08-11",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "basement waterproofing supplies",
      "basement waterproofing products",
      "waterproofing cement",
      "sump pump",
      "crack injection kit",
      "water leak sensor",
      "basement dehumidifier",
      "vapor barrier",
    ],
  }}
  jsonLd={schema}
>
