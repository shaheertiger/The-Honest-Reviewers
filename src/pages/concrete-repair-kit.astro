  },
  {
    "title": "Caulk for Basement Wall Cracks",
    "url": "/caulk-for-basement-wall-cracks/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-11", modified: "2026-11-11" });
const title = "Concrete Repair Kit: What Is in the Box and Which Damage Each Kit Fits";
const description =
  "The four kinds of concrete repair kit, what each box contains, which cracks and breaks it fits, how to use it, and when loose components are the better buy.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Repair Kit",
          item: "https://www.thehonestreviewers.com/concrete-repair-kit/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best concrete repair kit for a leaking basement wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a leaking crack in a poured concrete wall, a polyurethane injection kit is the usual DIY choice. The resin reacts with water, expands to fill the crack through the wall thickness and stays flexible. Epoxy kits are better for dry, dormant cracks where you want strength. Neither is suitable for block walls or for horizontal or bowing cracks, which need a structural assessment."
          }
        },
        {
          "@type": "Question",
          "name": "Do concrete crack repair kits work on driveways?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Slab crack seal kits work on driveways if the crack is cleaned properly, backer rod fills deeper cracks and the temperature is within the label range. They seal out water and debris, which slows further damage, but they do not glue the slab back together. For cracks that move with the seasons, a polyurethane sealant tends to last longer than acrylic or latex fillers."
          }
        },
        {
          "@type": "Question",
          "name": "How long does an injection kit take from start to finish?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on most of a day of elapsed time but only a couple of hours of work. Cleaning and setting ports takes under an hour, the surface paste usually needs 30 minutes to a few hours to cure, and injecting a single crack can take an hour if it is tight. The resin then cures for roughly a day before ports are trimmed."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an epoxy patch kit on a large spalled area?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is usually the wrong tool. Epoxy patch kits come in small quantities, cost a lot per cubic inch and expand differently from concrete in sun and frost. For spalled areas more than a few inches across, a polymer-modified cement patch or a resurfacer is cheaper and tends to last better. Keep epoxy for small, high-stress spots like anchor holes and step corners."
          }
        },
        {
          "@type": "Question",
          "name": "What temperature do concrete repair kits need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most kit labels specify minimum air and surface temperatures of roughly 40 to 50 degrees Fahrenheit, rising during cure. Cold slows curing sharply, especially for epoxy, and can leave resin soft for days. Heat shortens working time, so on hot days work in shade or early morning. Always check the specific label, because ranges vary by chemistry and brand."
          }
        },
        {
          "@type": "Question",
          "name": "Is a resurfacing kit enough for a whole driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Resurfacing kits are sized for patios, walks and small slabs, and a typical two-car driveway needs many bags at 1/8 inch, more if you are filling pitting. For a full driveway, buy resurfacer by the bag or pallet, line up a second person, and work in sections between control joints so each batch stays workable."
          }
        },
        {
          "@type": "Question",
          "name": "When should I skip the kit and call a professional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call a professional for horizontal basement wall cracks, walls that bow or lean, stair-step cracking in block, cracks wider than about 1/4 inch with one side offset, and slabs that have heaved or sunk noticeably. Those point to soil pressure or settlement. A kit can seal the symptom, but it will not address the cause, and it can hide evidence an engineer would want to see."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
