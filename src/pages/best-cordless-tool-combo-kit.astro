---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cordless Drills",
    "url": "/best-cordless-drills/"
  },
  {
    "title": "Best Impact Drivers",
    "url": "/best-impact-driver/"
  },
  {
    "title": "Milwaukee vs DeWalt",
    "url": "/milwaukee-vs-dewalt/"
  },
  {
    "title": "DeWalt vs Makita",
    "url": "/dewalt-vs-makita/"
  },
  {
    "title": "Brushless vs Brushed Drills",
    "url": "/brushless-vs-brushed-drill/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "7 Best Cordless Tool Combo Kits in 2026: What's Actually in the Box";
const description =
  "The best cordless tool combo kits from Milwaukee, DeWalt, Makita, Bosch and Ryobi, judged on the tools, battery Ah, charger and brand you're locking into.";

const PRODUCTS = [
  {
    "id": "milwaukee-m18-fuel-2997-22",
    "name": "Milwaukee M18 FUEL Hammer Drill and Impact Driver Combo Kit (2997-22)",
    "category": "2-Tool Kit, Brushless, 2 x 5.0Ah",
    "badge": "Best for Pros",
    "amazonUrl": "#",
    "pros": [
      "Two XC5.0 extended-capacity batteries, the largest in any two-tool kit here",
      "2804-20 hammer drill rated for 1,200 in-lbs and 32,000 BPM",
      "2853-20 impact driver rated for 2,000 in-lbs with three speed settings",
      "M18/M12 multi-voltage charger and a carrying case"
