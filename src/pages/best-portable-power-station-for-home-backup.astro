---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Portable Power Station vs Generator",
    "url": "/portable-power-station-vs-generator/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "Can a Portable Power Station Run a CPAP?",
    "url": "/can-a-portable-power-station-run-a-cpap/"
  },
  {
    "title": "Are Portable Power Stations Safe Indoors?",
    "url": "/are-portable-power-stations-safe-indoors/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "Interlock Kit vs Transfer Switch",
    "url": "/interlock-kit-vs-transfer-switch/"
  },
  {
    "title": "Best Battery Backup Sump Pumps",
    "url": "/best-battery-backup-sump-pump/"
  },
  {
    "title": "Jackery vs EcoFlow",
    "url": "/jackery-vs-ecoflow/"
  },
  {
    "title": "Bluetti vs EcoFlow",
    "url": "/bluetti-vs-ecoflow/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Portable Power Stations for Home Backup in 2026: Ranked";
const description =
  "The 7 best portable power stations for home backup, from 1kWh essentials units to 240V whole-circuit systems, with runtime math, wiring options and recharge plans.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow DELTA Pro 3",
    "category": "4,096Wh LiFePO4, 120V/240V, Expandable",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "4,096Wh of LiFePO4 storage in a single wheeled unit",
      "Native 120V and 240V output from one box, so a well pump is not automatically ruled out",
      "Up to 2,600W of solar input across a high-voltage and a low-voltage port",
      "Expands with extra batteries, and pairs with EcoFlow's Smart Home Panel 2 for circuit-level backup",
      "Fast AC recharging and a UPS-style mode for keeping the house topped up between outages"
    ],
    "cons": [
      "Roughly 114 pounds, so it lives where you park it, not on a shelf",
      "The panel integration that makes it a real home system adds substantially to the cost"
    ],
    "bottomLine": "The best balance of capacity, 240V capability and price for most homes. One unit covers essentials for about two days; add a battery and a transfer switch and it starts to feel like a small standby system.",
    "description": "The DELTA Pro 3 is the unit we would put in most houses that want real outage coverage without a dealer-installed battery wall. Its 4,096Wh LiFePO4 pack is the sweet spot for essential loads: at about 85% usable, that is roughly 3,480Wh, which runs a typical refrigerator for well over two days on its own, or a fridge, CPAP, router and a few LED lights for about a day and a half. What separates it from the 2kWh class is that it outputs both 120V and 240V from a single unit, which means a 240V well pump or a dryer-style inlet is on the table without pairing two machines. Solar input is rated up to 2,600W split across a high-voltage port and a low-voltage port, which is more than most people will ever hang off it, but it means you can run two separate panel strings and actually refill the battery in a good day of sun during a multi-day outage. It accepts EcoFlow's extra batteries to stretch capacity, and it works with the Smart Home Panel 2, which turns it from an extension-cord appliance into circuit-level backup with automatic switchover. The downsides are physical and financial. At around 114 pounds it rolls on wheels but does not go up stairs, and the panel, inlet and electrician add a meaningful amount on top of the unit price. Owners commonly report the app is solid and the fan noise under heavy load is noticeable but not obnoxious. If you are only ever going to plug in a fridge with an extension cord, the DELTA 2 Max costs less; if you want a system you can grow into, start here."
  },
  {
    "id": "anker-solix-f3800-plus",
    "name": "Anker SOLIX F3800 Plus",
    "category": "3,840Wh LiFePO4, 6,000W, 120V/240V",
    "badge": "Most Output",
    "amazonUrl": "#",
    "pros": [
      "6,000W continuous output, the most of any single wheeled unit here",
      "120V and 240V output, including a 30A-class outlet for a transfer switch or RV",
      "Up to 3,200W of solar input through dual MPPT controllers",
      "Expands to roughly 26.9kWh with up to six BP3800 batteries",
      "Five-year warranty and a mature home-panel ecosystem from Anker"
    ],
    "cons": [
      "Around 136 pounds; this is a roll-into-place appliance",
      "Capacity is slightly below the DELTA Pro 3 despite the bigger inverter"
    ],
    "bottomLine": "Buy it if your backup plan includes heavy 240V loads like a well pump or a small central AC with a soft starter. The inverter headroom is the point.",
    "description": "The F3800 Plus is the pick for houses with big motors. Its 6,000W continuous inverter and 120V/240V output give it more headroom than anything else on wheels in this list, which matters when the load is a 240V submersible well pump or, with a soft starter fitted, a smaller central air conditioner. Capacity is 3,840Wh of LiFePO4, or roughly 3,260Wh usable, so it lands in the same runtime class as the DELTA Pro 3 for everyday essentials: well over two days of refrigerator alone, about a day and a half of fridge plus CPAP plus networking. Where it pulls ahead is ceiling. Anker supports up to six BP3800 expansion batteries per unit, for roughly 26.9kWh total, and solar input is rated up to 3,200W through two MPPT controllers, so a large ground-mount array can genuinely keep it running through a long outage in decent weather. It also pairs with Anker's home power panel for circuit-level automatic switchover, and the five-year warranty is reassuring on a battery this expensive. The trade-offs: it weighs about 136 pounds, each expansion battery adds roughly another 73, and the big inverter tempts people into running loads the battery cannot sustain. A 3,500W central AC will drain the base unit in about an hour, which is a lesson owners commonly report learning the hard way. If your heaviest load is a refrigerator, this is more machine than you need. If it is a well pump, it is one of very few portable units we would trust."
  },
  {
    "id": "ecoflow-delta-pro-ultra",
    "name": "EcoFlow DELTA Pro Ultra",
    "category": "6,144Wh per battery, 7,200W, 120V/240V",
    "badge": "Best Whole-Home System",
    "amazonUrl": "#",
    "pros": [
      "6,144Wh per battery module, stackable to about 30kWh on one inverter",
      "7,200W of 120V/240V output, enough for most essential-circuit panels",
      "Up to 5,600W of solar input for genuine off-grid recharging",
      "Pairs with Smart Home Panel 2 for automatic, circuit-level switchover",
      "Modular design: inverter and batteries move separately"
    ],
    "cons": [
      "Priced like a home battery, not a power station",
      "Really needs an electrician and a panel to justify the cost"
    ],
    "bottomLine": "The closest thing to a standby battery wall that you can still roll out of the garage. Overkill for a fridge-and-CPAP plan; exactly right if you want most of the house to keep running.",
    "description": "The DELTA Pro Ultra is less a portable power station than a modular home battery that happens to have wheels. The system is split into an inverter unit and stackable battery modules of 6,144Wh each, and a single inverter supports up to five batteries for about 30kWh. The inverter delivers 7,200W at 120V and 240V, which is enough to run a typical essential-circuits subpanel, including a well pump, furnace blower, refrigerator, freezer and lights, with room left over. Solar input is rated up to 5,600W, which is unusual in anything portable and means a sizable array can carry it through a multi-day outage rather than just slowing the decline. One battery module, at roughly 5,220Wh usable, runs a refrigerator for three and a half days on its own, or fridge, furnace blower and basic circuits for most of a day in winter. Two or three modules start to look like a permanent installation. The catch is that it is priced like one, and it only makes sense wired in through EcoFlow's Smart Home Panel 2 or a proper transfer switch; running a 7,200W inverter off extension cords wastes most of what you paid for. The modular design helps with weight, since no single piece is unliftable for two people, but this is a buy-once-and-install product. If you have been quoted for a standby generator and balked at the gas line and maintenance, compare it against a permanently installed home battery before you decide."
  },
  {
    "id": "jackery-solar-generator-2000-plus",
    "name": "Jackery Solar Generator 2000 Plus",
    "category": "2,042Wh LiFePO4, 3,000W, Expandable",
    "badge": "Best Solar Generator Kit",
    "amazonUrl": "#",
    "pros": [
      "2,042Wh LiFePO4 base with a 3,000W inverter",
      "Sold as a kit with SolarSaga panels, so solar works out of the box",
      "Expands with add-on battery packs, and two units can pair for 240V",
      "About 61 pounds, with wheels and a telescoping handle",
      "Simple, well-labeled interface that non-technical household members can run"
    ],
    "cons": [
      "Needs a second unit for 240V, which doubles the cost",
      "Bundled panels are portable folding types, slow to deploy and store"
    ],
    "bottomLine": "The easiest way to buy a complete solar generator for home backup in one box. Best for households that want simple operation and solar from day one.",
    "description": "Jackery's Solar Generator 2000 Plus is the kit for people who want to open one box and have a working solar backup system. The power station inside is the Explorer 2000 Plus, with 2,042Wh of LiFePO4 capacity and a 3,000W inverter, bundled with SolarSaga folding panels. At about 1,740Wh usable, it runs a typical refrigerator for a little over a day, or fridge plus CPAP and networking for roughly 17 hours, before you account for any solar coming in. With a few hundred watts of panels in good sun, owners commonly report putting back a meaningful share of a day's fridge consumption, which is what turns a one-night unit into a multi-day one. It also scales: Jackery's add-on battery packs stack under the unit, and two 2000 Plus units can be paired for 240V output, which is the route to a transfer switch with both legs powered. At around 61 pounds it is the lightest unit in this list that we would call home backup rather than essentials, and the wheels and handle make it reasonable to move from garage to kitchen. The interface is about as plain as power stations get, which matters more than reviewers admit: in an outage, the person who has to operate it may not be the one who bought it. Downsides are the price premium for the kit compared with buying a station and panels separately, and the fact that 240V needs a second unit. If 240V matters to you, the DELTA Pro 3 is the better buy."
  },
  {
    "id": "bluetti-ac200l",
    "name": "Bluetti AC200L",
    "category": "2,048Wh LiFePO4, 2,400W, Expandable",
    "badge": "Best Mid-Size Value",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh LiFePO4 capacity in a unit around 62 pounds",
      "2,400W continuous inverter with a power-lifting mode for resistive loads",
      "Expands to about 8kWh with Bluetti expansion batteries",
      "Up to 1,200W of solar input",
      "Frequently priced well below rivals with similar capacity"
    ],
    "cons": [
      "120V only, so no 240V well pump or dual-leg transfer switch",
      "Power-lifting mode only helps heating loads, not motors"
    ],
    "bottomLine": "A strong value 2kWh unit for fridge, CPAP and sump-pump backup on 120V circuits. Skip it if anything you must back up runs on 240V.",
    "description": "The AC200L is our value pick in the 2kWh class, and for a lot of homes 2kWh is the right starting point. It carries 2,048Wh of LiFePO4 capacity, about 1,740Wh usable, with a 2,400W continuous inverter. That is enough to start and run a refrigerator, a 1/2 HP sump pump, a CPAP and a modem without juggling, and it runs a typical fridge alone for a bit over a day. Bluetti's power-lifting mode lets it run resistive loads above the inverter rating at reduced voltage, which helps with a kettle or a space heater on low but does nothing for motor loads, so do not count it as extra capacity. Expansion is the real reason to choose it: Bluetti's add-on batteries take the system to around 8kWh, so you can start with one unit and add capacity after your first long outage tells you what you actually used. Solar input is rated up to 1,200W, enough for a real roof-or-ground array rather than a single folding panel. At roughly 62 pounds it is portable in the true sense. The limitation is voltage. The AC200L is a 120V machine, so it cannot run a 240V well pump, and it cannot power both legs of a typical transfer switch. For houses on municipal water with gas heat, that does not matter. For rural homes on a well, look at the DELTA Pro 3 or F3800 Plus. Owners commonly report it is quiet at moderate loads and that the app is functional rather than polished."
  },
  {
    "id": "ecoflow-delta-2-max",
    "name": "EcoFlow DELTA 2 Max",
    "category": "2,048Wh LiFePO4, 2,400W, Expandable to 6kWh",
    "badge": "Best for Expanding Later",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh LiFePO4 capacity with a 2,400W inverter",
      "Expands to about 6kWh with two extra batteries",
      "Fast AC charging, so it refills quickly from a gas generator",
      "Up to 1,000W of solar input across two ports",
      "Around 50 pounds, the lightest 2kWh unit here"
    ],
    "cons": [
      "120V only",
      "Expansion batteries are pricey relative to the base unit"
    ],
    "bottomLine": "A compact, fast-charging 2kWh unit that grows to 6kWh. Ideal for apartments, townhouses and anyone pairing batteries with a small gas generator.",
    "description": "The DELTA 2 Max is the 2kWh unit we would pick for a household that expects to add capacity later or to pair the battery with a small gas generator. It carries 2,048Wh of LiFePO4, about 1,740Wh usable, with a 2,400W inverter, and it accepts up to two extra batteries for roughly 6kWh total. That ladder is useful: buy the base unit now, cover a fridge and CPAP overnight, then add a battery when you know whether your outages tend to run six hours or three days. Where it really earns its spot is AC charging speed. EcoFlow's fast charging means a modest inverter generator can refill it in an hour or two, so the generator only needs to run briefly a couple of times a day instead of all night, which saves fuel and keeps the neighbors happy. Solar input is rated up to 1,000W across two ports, which is plenty for the panels most people can deploy. At about 50 pounds it is the lightest 2kWh-class unit here, and it fits under a desk or in a closet. The trade-offs are the 120V-only output, which rules out 240V well pumps and dual-leg transfer switches, and the fact that by the time you buy two extra batteries you are close to DELTA Pro 3 money without the 240V output. If you already know you want 4kWh or more, buy the bigger unit. If you want to start at 2kWh and stay flexible, this is the better entry point than the AC200L for fast generator recharging."
  },
  {
    "id": "ecoflow-delta-2",
    "name": "EcoFlow DELTA 2",
    "category": "1,024Wh LiFePO4, 1,800W",
    "badge": "Best Budget Essentials",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh LiFePO4 capacity at a price most households can justify",
      "1,800W inverter runs a fridge, CPAP, router and lights together",
      "Expandable with an extra battery",
      "About 27 pounds, easy to carry room to room",
      "Fast wall charging, so it is ready again quickly between outages"
    ],
    "cons": [
      "About 14 hours of refrigerator alone; this is a one-night unit",
      "Too small for a sump pump in a heavy storm or any furnace backup"
    ],
    "bottomLine": "The cheapest unit we would trust for real outages. It covers a fridge overnight or a CPAP for several nights, which is all many households actually need.",
    "description": "Not everyone needs a 4kWh system. If your outages are usually a few hours and your priorities are a CPAP, phones, Wi-Fi and keeping the fridge from warming up overnight, the DELTA 2 does that for a fraction of the cost of everything above it. It carries 1,024Wh of LiFePO4, about 870Wh usable, behind an 1,800W inverter that comfortably starts a refrigerator and runs a CPAP, router and LED lights at the same time. The arithmetic is honest about its limits: a typical fridge averaging around 60W over a day runs for roughly 14 hours, and a CPAP without a heated humidifier runs for several nights. That is a one-night unit for the fridge and a several-night unit for medical equipment, not a weekend system. It is expandable with an extra battery if you outgrow it, it weighs about 27 pounds so it moves easily from bedroom to kitchen, and it recharges quickly from the wall, so it is full again soon after the power comes back. Solar input is modest compared with the big units, so solar recharging is a top-up rather than a full refill. What it cannot do is back up a sump pump through a heavy rain, run a furnace blower through a cold night, or touch anything on 240V. For those, step up to at least the 2kWh class. For phones alone, honestly, a pair of portable chargers for power outages, like a 20,000mAh power bank, is enough, and you can skip a power station entirely."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Power Station for Home Backup",
          item: "https://www.thehonestreviewers.com/best-portable-power-station-for-home-backup/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size portable power station do I need for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a refrigerator, CPAP and networking through one night, 1-2kWh is enough. For a full day or a weekend of those essentials, buy 3-4kWh. If you need the furnace blower in winter or a well pump, plan on 4kWh or more plus 240V output, and add expansion batteries or a recharge plan. Size from daily kilowatt-hours, not inverter watts."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable power station run my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in the way a standby generator can. The largest systems, like the DELTA Pro Ultra with several batteries, can run most essential circuits for days, but electric heat, water heaters, ranges and central AC will drain even 30kWh quickly. Realistically, a power station backs up the circuits that matter and leaves the big resistive loads off until the grid returns."
          }
        },
        {
          "@type": "Question",
          "name": "Is a solar generator the same as a portable power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in practice. A solar generator is a portable power station sold with solar panels, or marketed around solar charging. There is no engine. The battery and inverter are identical to a station bought on its own. The best solar generator for home backup is a large-capacity station with high solar input paired with enough panels to refill it in a day."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug a power station into a wall outlet to power the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Plugging a station into a wall outlet with a double-male cord backfeeds the house wiring, which can electrocute utility workers and damage the station. The safe options are extension cords to individual appliances, a manual transfer switch with an inlet box, an interlock kit where permitted, or a manufacturer smart panel installed by an electrician."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a power station run a refrigerator during a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide usable capacity by the fridge's average draw. A typical full-size fridge averages around 60W over a day, so a 1,024Wh unit runs it about 14 hours, a 2,048Wh unit about 28 hours, and a 4,096Wh unit a bit over two days. Older or larger fridges and frequent door openings shorten that, sometimes considerably."
          }
        },
        {
          "@type": "Question",
          "name": "Are portable chargers enough for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For phones and tablets, yes. A 20,000mAh power bank recharges a typical phone several times, and a pair of them covers a family for a short outage. They cannot run a refrigerator, CPAP for long, or a sump pump. If anything beyond phones needs power, a 1kWh-plus power station is the smallest thing that actually helps."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a power station or a gas generator for outages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If outages are usually under a day, a power station is quieter, safer and easier. If they regularly last several days and you need high loads, a gas generator delivers far more energy per dollar. The best setup for most homes is both: a station to run the house quietly overnight and a small inverter generator to refill it during the day."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "portable power stations for home backup",
      "best solar generator for home backup",
      "power station for power outage",
      "portable chargers for power outages",
      "home backup power station",
      "battery backup for home without generator",
      "240V portable power station"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Portable Power Stations for Home Backup</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A power station that keeps your phone charged is not the same thing as one that keeps your fridge cold, your sump pump running and your furnace blowing for two days. These are the seven we would actually put in a house, from a 1kWh essentials unit to a 240V system that wires into the panel.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-delta-pro-3"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="14.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
