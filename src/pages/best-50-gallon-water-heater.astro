                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Heat source</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Listed first-hour rating</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rheem PROE50 M2 RH95</td>
