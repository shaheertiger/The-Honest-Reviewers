      "50 gallon electric water heater",
      "50 gallon gas water heater",
      "50 gal gas water heater",
      "50 gallon water tank",
      "best 50 gallon water heater"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
