  },
  {
    "id": "lg-dt501bkr0",
    "name": "LG PuriCare Sonoran 50-Pint Smart Dehumidifier DT501BKR0",
    "category": "49.81 Pints/Day (ENERGY STAR), Hose and Adapter Included",
    "badge": "Best Documented Hose",
    "amazonUrl": "#",
    "pros": [
      "LG publishes the included hose: about 0.56 in inside diameter, 4.9 ft long",
      "Drain hose and adapter in the box, per retailer listings",
      "ENERGY STAR record lists 49.81 pints/day and 524 kWh a year",
      "Wi-Fi control through the LG ThinQ app"
