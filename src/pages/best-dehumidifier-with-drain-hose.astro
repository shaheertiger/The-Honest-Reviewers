const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dehumidifier With Drain Hose",
          item: "https://www.thehonestreviewers.com/best-dehumidifier-with-drain-hose/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do dehumidifiers come with a drain hose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some do and some do not. The Midea Cube 50 and 35, the LG DT501BKR0 and crawl space units like the Santa Fe Compact70 include a hose. Others, such as the Midea MAD50C1AWS-A, have a hose socket but no hose in the box. Check the listing, because even included hoses are often only about five feet long."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a garden hose to drain a dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On most portables with a threaded drain port, yes. North American dehumidifiers that use a garden hose connection take a standard 3/4-inch garden hose thread, and any length of garden hose will fit. Use a hose with a good washer, keep it sloping downhill all the way to the drain, and avoid kinks."
          }
        },
        {
          "@type": "Question",
          "name": "Does a dehumidifier drain hose need to go downhill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Without a pump, water flows out of the hose by gravity alone, so the hose must be lower than the drain port along its entire length. A dip followed by a rise traps water and backs it up into the unit. If your drain is higher than the port, raise the unit or use a pump."
          }
        },
        {
          "@type": "Question",
          "name": "Can a dehumidifier drain into a sump pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and in many basements it is the best option. Run the hose to the pit, secure it over the edge so it cannot fall onto the pump float, and let the sump pump discharge the water outside. A dehumidifier adds only a few gallons a day. Keep the sump lid sealed, since an open pit adds humidity."
          }
        },
        {
          "@type": "Question",
          "name": "What size hose fits a dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the model. Garden hose ports take standard 3/4-inch garden hose thread. LG lists its included hose at about 0.56 inches inside diameter, and Santa Fe's earlier data sheet lists a 5/8-inch hose on a 3/4-inch NPT fitting. A Hisense manual recommends an inside diameter greater than 1/2 inch for a reliable gravity drain."
          }
        },
        {
          "@type": "Question",
          "name": "Can a dehumidifier drain into a laundry sink?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not by gravity, because a laundry sink rim sits far above a portable's drain port. You would need to raise the dehumidifier above the sink rim, which is impractical. Instead, buy a model with a built-in pump or put a small condensate pump beside a gravity unit to lift the water into the sink."
          }
        },
        {
          "@type": "Question",
          "name": "Why is my dehumidifier filling the bucket with the hose attached?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually the hose is blocked, kinked or running uphill, so water backs up into the bucket. On some models a cap or plug must be removed before the hose drains, and the bucket must stay seated for the unit to run. Check the slope, flush the hose and read the manual's continuous-drain steps."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
