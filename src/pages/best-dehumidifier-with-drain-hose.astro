const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "7 Best Dehumidifiers With a Drain Hose in 2026: Gravity Drainage Done Right";
const description =
  "The best dehumidifiers with a drain hose for gravity drainage: which include a hose, which need a garden hose, and how to route it to a floor drain or sump pit.";

const PRODUCTS = [
  {
    "id": "midea-cube-50-mad50s1qwt-a",
    "name": "Midea Cube 50-Pint Dehumidifier MAD50S1QWT-A",
    "category": "50 Pints/Day, Drain Hose Included, Expanding Tank",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Drain hose in the box, so gravity drainage works on day one",
      "Expanding tank retailers list at about 4.2 gallons as a backup",
      "Nests to about 14.5 inches on each side for off-season storage",
