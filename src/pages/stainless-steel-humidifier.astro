                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Mist chimney or nozzle</td>
                    <td class="px-4 py-4 text-gray-700">Usually plastic</td>
                    <td class="px-4 py-4 text-gray-700">Weekly rinse; check for slime</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lid and float</td>
                    <td class="px-4 py-4 text-gray-700">Usually plastic</td>
                    <td class="px-4 py-4 text-gray-700">Weekly wash</td>
