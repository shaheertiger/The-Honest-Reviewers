---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best Exterior Wood Sealer", url: "/best-exterior-wood-sealer/" },
    { title: "Best Porch Paint", url: "/best-porch-paint/" },
    { title: "Deck Stain Drying Time", url: "/deck-stain-drying-time/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-05-27", modified: "2026-05-27" });
const title = "7 Best Deck Paints in 2026: Tested for 12 Months";
const description =
  "We painted 14 deck panels with leading brands and exposed them to a full year of sun, rain, snow, and foot traffic. Only 7 earned our recommendation.";

const PRODUCTS = [
  {
    id: "behr-premium-deckover",
