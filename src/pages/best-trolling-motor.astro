    "bottomLine": "If you want to motor a fishing kayak or canoe, the Kayak Series gets the shaft length right; budget for a mount and a battery your kayak can actually carry."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Trolling Motors",
          item: "https://www.thehonestreviewers.com/best-trolling-motor/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much thrust do I need for my boat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The common rule of thumb is at least 2 lb of thrust per 100 lb of fully loaded boat weight, counting the hull, batteries, gear and people. Bass Pro suggests 2.5 lb per 100 lb. Go higher if you fish wind, current or tides, because extra thrust at a low setting costs little battery."
          }
        },
        {
          "@type": "Question",
          "name": "What shaft length should my trolling motor have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure from the mounting point to the waterline and add 15 to 20 inches, or make sure the prop sits under at least 12 inches of water. Kayaks usually suit 24 to 36 inches, jon boat transoms 30 to 42 inches, and bass boat bow mounts 45 inches or more."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 55 lb trolling motor enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most jon boats, canoes, kayaks and small aluminum boats, yes. By the 2 lb per 100 lb rule, 55 lb covers loaded boats up to roughly 2,750 lb, which matches one retailer's guidance for the MotorGuide Xi5-55. Heavier bass and pontoon boats usually step up to 24V or 36V motors."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a lithium battery with a trolling motor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many makers now support LiFePO4 batteries, which weigh less and hold voltage better than lead-acid. Check your motor's manual first: Newport's guidance, for example, is to use lead-acid deep-cycle marine batteries and not lithium. Whatever you use, install the specified breaker or fuse."
          }
        },
        {
          "@type": "Question",
          "name": "What is Spot-Lock or GPS anchoring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a feature that uses GPS to hold your boat within a few feet of a chosen spot by making constant small motor corrections, even in wind and current. Minn Kota calls it Spot-Lock, MotorGuide calls it Pinpoint GPS Anchor and Garmin calls it anchor lock."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to register a kayak with a trolling motor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In many states, yes. Adding any motor, including an electric trolling motor, can turn a paddle craft into a vessel that must be registered. Rules vary by state, so check with your state's boating or wildlife agency before you launch."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a freshwater trolling motor in salt water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not recommended. Freshwater motors lack the corrosion protection and sealed electronics of saltwater models, and salt damage is often not covered by warranty. If you fish salt or brackish water at all, buy a saltwater-rated motor and rinse it after every trip."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
