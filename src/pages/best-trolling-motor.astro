const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Trolling Motors: Transom, Bow-Mount and Kayak Picks";
const description =
  "The best trolling motors for jon boats, bass boats and kayaks, compared on thrust, shaft length, voltage, GPS anchoring and saltwater rating, with sizing rules.";

const PRODUCTS = [
  {
