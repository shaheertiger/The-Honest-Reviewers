---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Indoor Heaters for Power Outages",
    "url": "/best-indoor-heater-for-power-outage/"
  },
  {
    "title": "Best Carbon Monoxide Detectors",
    "url": "/best-carbon-monoxide-detector/"
  },
  {
    "title": "Best Portable Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Electric Fireplaces",
    "url": "/best-electric-fireplace/"
  },
  {
    "title": "Best Kerosene Heaters",
    "url": "/best-kerosene-heater/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Pellet Stoves in 2026: The Power Outage Truth";
const description =
  "Most pellet stoves stop heating in a power outage: they need electricity. Seven real pellet stoves, with honest sizing, venting, safety and backup power advice.";

const PRODUCTS = [
  {
    "id": "comfortbilt-hp22",
    "name": "ComfortBilt HP22 Pellet Stove, 55 lb Hopper (HP22)",
    "category": "Freestanding, Up to 2,800 Sq Ft, 55 lb Hopper",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Rated to heat up to 2,800 sq ft, per the listing",
      "55 lb hopper holds more than one standard 40 lb bag",
      "Bay-window style front with a large glass view of the fire",
      "Sold in several colours, including black and burgundy",
      "A long-running model line, so parts and owner advice are easy to find"
    ],
    "cons": [
      "Needs mains power for the auger, fans and igniter, like every electric pellet stove",
      "The 2,800 sq ft rating assumes a well-insulated, open home",
      "Costs more than the smaller ComfortBilt and Castle models"
    ],
    "bottomLine": "The pellet stove we would put in a main living area first: big rated output, a hopper that takes a full bag, and a long track record.",
    "description": "If you want one pellet stove to carry the main floor of a house through the cold months, the ComfortBilt HP22 is where we would start. The listing rates it to heat up to 2,800 square feet and gives it a 55 lb hopper, which matters more than it sounds: a standard bag of pellets weighs 40 lb, so you can empty a whole bag in and still have room to top up, instead of feeding the stove twice a day. The bay-style front puts a wide pane of glass on the fire. The HP22 has been sold for years in several finishes, and that history is useful in practice, because owners commonly report that replacement igniters, gaskets and blowers are easy to track down. The honest trade-offs are the same ones every electric pellet stove carries. The auger, combustion fan, room blower and igniter all need 120-volt power, so the HP22 stops heating in a power cut unless you have a battery backup or a generator ready. And treat the 2,800 square foot claim as a best case for an open, well-sealed home in a mild climate, not a promise for a drafty older house. If your space is a single large room, the Castle Serenity is cheaper and easier to place. If you have a working masonry fireplace, look at the HP22i insert instead."
  },
  {
    "id": "pelpro-pp150",
    "name": "PelPro PP150 Pellet Stove, 49,200 BTU, 150 lb Hopper (PP150)",
    "category": "Freestanding, 49,200 BTU, Up to 2,500 Sq Ft, 150 lb Hopper",
    "badge": "Longest Time Between Fills",
    "amazonUrl": "#",
    "pros": [
      "150 lb hopper, the largest of our picks, per the listing",
      "Listed at 49,200 BTU, rated to heat up to 2,500 sq ft",
      "Easy-dial temperature control with a built-in thermostat",
      "Auto-ignition, so it lights itself when the room cools",
      "Listing describes a quiet 265 CFM room blower"
    ],
    "cons": [
      "A 150 lb hopper makes for a tall, heavy cabinet",
      "Still goes cold in a power cut without backup power",
      "Simple dial controls rather than an app or remote"
    ],
    "bottomLine": "The pick for people who hate refilling: a 150 lb hopper, a built-in thermostat and auto-ignition make it the closest thing to set-and-forget.",
    "description": "The PelPro PP150 is built around one number: a 150 lb hopper, which the listing pairs with a 49,200 BTU rating and a heated area of up to 2,500 square feet. That hopper holds nearly four standard 40 lb bags, so on a moderate setting you are looking at refilling every few days rather than every morning. If you work long shifts or hate carrying pellets daily, that is the deciding feature. The controls are deliberately simple. The listing describes an easy-dial temperature control with a built-in thermostat and auto-ignition, so the stove lights itself when the room cools and backs off when it reaches temperature, which is how a pellet stove saves fuel compared with running flat out. The room blower is listed at 265 CFM and described as quiet. The trade-offs are physical. A hopper that size makes a tall, heavy cabinet, so measure the spot, the doorway and the route in before you order, and plan on two people for the move. Like every electric pellet stove, it needs power for the auger, fans and igniter, so a big hopper does not help in an outage on its own: the fuel is there, but nothing is feeding it. If you want an app or remote, the Comfort Glow below adds one, and if you need a smaller cabinet, PelPro also sells the PP70 with a 70 lb hopper."
  },
  {
    "id": "castle-serenity-41278",
    "name": "Castle Serenity Pellet Stove, 40 lb Hopper (41278)",
    "category": "Freestanding, Up to 1,500 Sq Ft, 40 lb Hopper, Smart Controller",
    "badge": "Best for Smaller Homes",
    "amazonUrl": "#",
    "pros": [
      "Rated for up to 1,500 sq ft, a better fit for one floor or a cabin",
      "Smart Controller with manual, weekly, thermostat and eco modes",
      "Weekly schedule can warm the house before you get up",
      "Listing highlights an easy-clean design",
      "40 lb hopper takes one standard bag"
    ],
    "cons": [
      "A 40 lb hopper means a refill roughly every day in cold weather",
      "Too small to carry a large, open, two-storey house",
      "Programmable controls take some setup time"
    ],
    "bottomLine": "The best pellet stove for a smaller home, cabin or single floor, with the most useful controls of any stove here.",
    "description": "Most people do not need a stove rated for 2,800 square feet, and an oversized pellet stove runs on low much of the time, which tends to mean more soot on the glass and more frequent cleaning. The Castle Serenity 41278 is rated for up to 1,500 square feet, which suits a single floor, a smaller house, a cabin or a large open room. What sets it apart is the Smart Controller. The listing names four operating modes: manual, weekly, thermostat and eco. Thermostat mode holds the room at a set temperature, the weekly program lets you have the stove warm the house before you get up and ease off while you are out, and eco mode is meant to trim pellet use. Those controls are the difference between a stove you babysit and one that behaves like a heating system. The listing also calls out an easy-clean design, which matters because pellet stoves need their burn pot cleared often. The 40 lb hopper takes one standard bag, so in a cold snap expect to refill about once a day. And like every electric pellet stove, it needs power for its controller, auger, fans and igniter, so plan backup power if outages are the reason you are shopping. If you need more output or more time between fills, the ComfortBilt HP22 or PelPro PP150 are the step up."
  },
  {
    "id": "comfort-glow-cgps2200",
    "name": "Comfort Glow Pellet Stove with Remote, 120 lb Hopper (CGPS2200)",
    "category": "Freestanding, Up to 2,800 Sq Ft, 120 lb Hopper, Mobile Home Approved",
    "badge": "Best for Mobile Homes",
    "amazonUrl": "#",
    "pros": [
      "Listing states it is mobile home approved",
      "120 lb hopper for several days between fills",
      "Rated to heat up to 2,800 sq ft",
      "Digital control panel plus a remote control",
      "Listed 200 CFM blower to push heat into the room"
    ],
    "cons": [
      "Mobile home installs still need the outside air kit and anchoring the manual specifies",
      "Needs power for the controls, auger and blowers",
      "Newer to pellet stoves than ComfortBilt or PelPro, so less owner history"
    ],
    "bottomLine": "The pick for a manufactured or mobile home: the listing says it is approved for that use, and the 120 lb hopper means fewer trips with bags.",
    "description": "Manufactured and mobile homes are a special case for any stove. The rules for them are stricter, and a stove has to be listed for that use, so the first thing to check on any pellet stove for a mobile home is whether the maker says it is approved. The Comfort Glow CGPS2200 listing says so plainly, which is why it earns this spot. Beyond that, it is a large stove: the listing rates it to heat up to 2,800 square feet, gives it a 120 lb hopper, and adds a digital control panel, a remote control and a 200 CFM blower. A 120 lb hopper holds three standard bags, so on moderate settings you can go several days between fills, which is a real benefit in a home where storage space is tight and you would rather not haul bags every morning. The honest caveats: mobile home approval is not a shortcut. Installations in manufactured homes typically require an outside combustion air supply, a stove anchored to the floor and specific clearances, all spelled out in the manual, and your local inspector and insurer will want to see it done that way. The stove also needs power for its controls, auger and blowers. Comfort Glow is better known for kerosene and gas heaters, so this model has less owner history than ComfortBilt or PelPro."
  },
  {
    "id": "us-stove-us5513-w",
    "name": "US Stove Pellet Stove, 1,800 Sq Ft, 40 lb Hopper (US5513-W)",
    "category": "Freestanding, Up to 1,800 Sq Ft, 40 lb Hopper",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Rated to heat up to 1,800 sq ft, per the listing",
      "40 lb hopper takes one standard bag",
      "Among the lower-priced pellet stoves we found from a major brand",
      "United States Stove Company is a long-established heating maker",
      "A middle size that suits many single-floor homes"
    ],
    "cons": [
      "Fewer listed features than the Castle or Comfort Glow",
      "A daily refill in cold weather with a 40 lb hopper",
      "Needs electricity to run, like every stove here except the Wiseway"
    ],
    "bottomLine": "A straightforward pellet stove from a big-name maker at a lower price, sized for a single floor or a mid-size home.",
    "description": "United States Stove Company has made wood, coal and pellet heaters for a long time, and it sells under several names, including US Stove and Ashley. The US5513-W is its plainest offer in this list: the listing rates it to heat up to 1,800 square feet and gives it a 40 lb hopper. That puts it between the Castle Serenity and the big ComfortBilt in size, which is the sweet spot for a lot of single-floor homes, and it tends to sit at the lower end of the price range we saw for complete stoves from a known maker. The appeal is simplicity. If you want pellet heat for one floor, do not care about an app or a weekly program, and would rather put the money towards proper venting and a battery backup, this is the sensible place to look. The 40 lb hopper takes one full bag, so in steady cold weather expect to feed it about once a day. The listing gives fewer details than the Castle or Comfort Glow pages, so download the manual before you buy and check the venting requirements, clearances and the control features against what you need. As with every electric pellet stove, it will not heat during a power cut without backup power. If you want programmable control at a similar size, the Castle Serenity is worth the small step up."
  },
  {
    "id": "comfortbilt-hp22i",
    "name": "ComfortBilt HP22i Pellet Stove Fireplace Insert, 47 lb Hopper (HP22i)",
    "category": "Fireplace Insert, Up to 2,800 Sq Ft, 47 lb Hopper",
    "badge": "Best Fireplace Insert",
    "amazonUrl": "#",
    "pros": [
      "Fits into an existing fireplace instead of taking floor space",
      "Rated to heat up to 2,800 sq ft, per the listing",
      "47 lb hopper takes a full 40 lb bag",
      "Turns a drafty open fireplace into a controllable heater",
      "Some listings include a shroud, ash vacuum and remote"
    ],
    "cons": [
      "Needs a chimney liner and a professional fit in most cases",
      "Most expensive pick here, before installation",
      "Your fireplace opening has to match the insert's dimensions"
    ],
    "bottomLine": "If you have a fireplace that loses more heat than it gives, this insert turns it into a real heat source.",
    "description": "An open masonry fireplace is one of the least efficient ways to heat a room. Much of the warm air goes up the chimney, and on a cold night a fireplace can pull heated air out of the house. A pellet insert fixes that by sliding a sealed, thermostat-controlled stove into the firebox. The ComfortBilt HP22i is the insert version of our top pick: the listing rates it to heat up to 2,800 square feet and gives it a 47 lb hopper, enough to take a full 40 lb bag. Because it sits inside the fireplace, it takes no extra floor space, which is why people with a living room fireplace often choose an insert over a freestanding stove. Some versions of the listing include a surround shroud, an ash vacuum and a remote, so check exactly what the one you choose includes. The trade-offs are cost and fit. This is the most expensive stove on our list, and the install usually adds to that, because most jurisdictions and manufacturers call for a liner run up the existing chimney, connected to the insert, rather than venting into the open flue. Measure the fireplace opening against the insert's dimensions before ordering, and have a certified installer check the chimney. And yes, it needs electricity, just like the freestanding HP22. If you have no fireplace, the freestanding HP22 does the same job for less."
  },
  {
    "id": "wiseway-non-electric",
    "name": "Wiseway Non Electric Pellet Stove (Gravity Fed)",
    "category": "Gravity-Fed, No Electricity Required",
    "badge": "Best for Power Outages",
    "amazonUrl": "#",
    "pros": [
      "Listed as non-electric: no auger motor, fan or igniter to power",
      "Keeps burning when the grid goes down",
      "Gravity feed means fewer moving parts to fail",
      "Quiet, with no blower noise",
      "Pairs well with a generator-free outage plan"
    ],
    "cons": [
      "No thermostat or auto-ignition: you light and tend it by hand",
      "Relies on natural draft, so the vent must be planned carefully",
      "No blower to push heat into other rooms"
    ],
    "bottomLine": "The only stove here that heats through a power outage without a battery or generator, at the cost of the automation pellet stoves are known for.",
    "description": "Every other stove on this page needs electricity. The Wiseway is the exception, and that is the whole reason it is here. The listing calls it a non-electric pellet stove, and it is a gravity-fed design: pellets slide down from the hopper into the burn chamber under their own weight, so there is no auger motor, no combustion fan and no electric igniter. When the grid drops, it keeps burning. You give up a lot for that. There is no thermostat, no auto-ignition and no schedule, so you light it yourself and adjust it by hand, much like a wood stove. There is also no room blower, so heat spreads by radiation and natural convection, which favours one open space over a house of separate rooms. The bigger point is venting. An electric pellet stove uses a fan to push exhaust out, which is why many can vent straight through a wall. A non-electric stove depends on natural draft, so the vent design matters more: follow the manual's requirements for vertical rise and chimney height exactly, and have the installation inspected. The listing shows the brand field as generic, but the title names Wiseway, and replacement burn chambers and burn pots sold for the Wiseway gravity-fed stove are listed too. If you want automation and outage protection together, buy a conventional stove and add backup power instead."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pellet Stoves",
          item: "https://www.thehonestreviewers.com/best-pellet-stove/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best pellet stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the ComfortBilt HP22 is the best pellet stove: it is rated to heat up to 2,800 square feet, takes a full 40 lb bag in its 55 lb hopper, and has a long track record for parts. Choose the PelPro PP150 for the longest time between fills, or the Castle Serenity for a smaller home."
          }
        },
        {
          "@type": "Question",
          "name": "Do pellet stoves work without electricity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard pellet stoves do not. The auger, combustion fan, room blower, igniter and controls all need household power, so the stove shuts down in an outage. To keep heating, you need a battery backup, a power station with a pure sine wave inverter, or a generator. Gravity-fed non-electric pellet stoves are the exception and run with no power at all."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a battery backup run a pellet stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the battery's capacity and the stove's running wattage, which is listed in its manual. Start-up draws far more than running because the igniter is on, so it is best to light the stove on grid power or a generator. Divide the battery's usable watt-hours by the stove's running watts for a rough estimate."
          }
        },
        {
          "@type": "Question",
          "name": "Can a pellet stove vent through a wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. Because a pellet stove uses a fan to push exhaust out, most can vent horizontally through an exterior wall using listed pellet vent pipe, without a full chimney. Manuals commonly call for some vertical rise first, so the stove drafts naturally if the power fails, and set distances from windows, doors and walkways."
          }
        },
        {
          "@type": "Question",
          "name": "How many bags of pellets does a pellet stove use per day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly one 40 lb bag a day is a common figure when a stove runs steadily in cold weather, though use varies widely with the stove, the setting and the weather. Mild days and low settings use much less, and a hard freeze with the stove on high uses more. Buy a pallet before winter to avoid shortages."
          }
        },
        {
          "@type": "Question",
          "name": "Is a pellet stove cheaper to run than electric heat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It often is, compared with electric resistance heat, propane or heating oil, but it depends on local prices for pellets and energy. A pellet stove also has real upfront costs for the stove, vent kit, floor protection and installation, so it pays off best when it carries much of your heating every winter."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a permit to install a pellet stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most areas, yes. A new solid-fuel appliance usually needs a permit and an inspection, and many insurers want to be told about it. Requirements vary by location, so check with your local building department first. A professional installer will normally handle the permit and make sure clearances, floor protection and venting meet the manual and local code."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "best pellet stove",
      "pellet stove",
      "best pellet stoves",
      "pellet stove for power outage",
      "non electric pellet stove",
      "pellet stove insert",
      "pellet vs wood stove"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Pellet Stoves</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A pellet stove looks like outage-proof heat: it burns wood, not gas. But its auger, fans and igniter all run on electricity, so when the grid drops, the fire goes out. Here is what actually works: the right stove, sized honestly, with a backup plan.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#comfortbilt-hp22"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Rankings
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="4.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#power-outage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Pellet Stoves in a Power Outage</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Size You Need</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Pellet Stoves</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Venting and Safety</a>
          <a href="#pellet-vs-wood" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Pellet vs Wood Stove</a>
          <a href="#pellets" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Pellet Use and Buying</a>
          <a href="#cleaning" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cleaning and Maintenance</a>
          <a href="#worth-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Is It Worth It?</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
