                <p class="text-gray-400 text-xs mt-1">Avg. cost to seal a set</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~1 yr</p>
                <p class="text-gray-400 text-xs mt-1">Protection per coat</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">100%</p>
                <p class="text-gray-400 text-xs mt-1">UV graying blocked</p>
