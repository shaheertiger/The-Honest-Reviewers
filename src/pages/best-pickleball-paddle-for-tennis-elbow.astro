---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Pickleball Paddles",
    "url": "/best-pickleball-paddle/"
  },
  {
    "title": "Best Pickleball Paddles for Spin",
    "url": "/best-pickleball-paddle-for-spin/"
  },
  {
    "title": "Pickleball Paddle Grip Size",
    "url": "/pickleball-paddle-grip-size/"
  },
  {
    "title": "Pickleball Paddle Weight",
    "url": "/pickleball-paddle-weight/"
  },
  {
    "title": "14mm vs 16mm Pickleball Paddles",
    "url": "/14mm-vs-16mm-pickleball-paddle/"
  },
  {
    "title": "Thermoformed Pickleball Paddles",
    "url": "/thermoformed-pickleball-paddle/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-18", modified: "2026-10-18" });
const title = "6 Best Pickleball Paddles for Tennis Elbow: Softer Picks That Go Easy on the Arm";
const description =
  "Six thicker-core, softer pickleball paddles for players with tennis elbow, chosen on core, weight and grip size, plus what loads the forearm and what a paddle cannot fix.";

const PRODUCTS = [
  {
    "id": "selkirk-luxx-control-air-invikta",
    "name": "Selkirk LUXX Control Air Invikta",
    "badge": "Best Overall",
    "category": "Carbon Face, 20mm Core, Elongated",
    "amazonUrl": "#",
    "description": "The LUXX Control Air Invikta is the thickest core on this list, and that is why it leads it. Retailers list a 20mm X7 Thikset honeycomb core with a FlexFoam perimeter, a Florek carbon fiber face, and a weight of 7.8 to 8.1 ounces averaging about 7.95, with a 16.45-inch length and a 7.5-inch width. A 20mm core is noticeably thicker than the 16mm most control paddles use, and thicker cores are generally described as softer and more cushioned on contact, which is exactly what a sore forearm wants. The moderate weight avoids both the shock of a heavy head and the overswinging a very light paddle invites. It is assembled in the USA and listed as USA Pickleball approved. The trade-offs are price, which is at the premium end, and the elongated shape, which some players find a little slower at the net. One review measured the core at 19mm rather than 20, so treat the exact figure loosely.",
    "pros": [
      "20mm core, the thickest here, per retailers",
      "FlexFoam perimeter for stability on off-center hits",
      "Moderate 7.8 to 8.1 oz weight range",
      "Listed as USA Pickleball approved"
    ],
    "cons": [
      "Premium price",
      "Elongated shape is slower in quick exchanges",
      "Very soft feel gives up some put-away power"
    ],
    "bottomLine": "If you want the softest, most cushioned paddle to protect a sore elbow, the Selkirk LUXX Control Air Invikta's 20mm core and moderate weight make it our first pick."
  },
  {
    "id": "joola-hyperion-cfs-16",
    "name": "JOOLA Hyperion CFS 16",
    "badge": "Most Stable",
    "category": "Carbon Friction Surface, 16mm, Elongated",
    "amazonUrl": "#",
    "description": "The Hyperion CFS 16 suits players whose elbow pain flares on off-center hits, because it is built for stability. JOOLA and retailers list a 16mm reactive polymer honeycomb core, a carbon friction surface face and a foam-injected Hyperfoam edge wall, with a 16.5-inch length, a 7.5-inch width and a 5.5-inch handle. The standard version weighs about 8.4 ounces per retailers, with a lighter Swift version around 7.9 ounces. That choice matters: some players with elbow pain prefer a slightly heavier paddle because it absorbs more of the ball's impact instead of passing it into the arm, while others find the extra head weight tiring. If you are unsure, start with the Swift. Grip circumference is listed at about 4.25 inches on most listings, with some at 4.125. The foam-filled edge is meant to steady the paddle when you catch the ball near the rim, which is when the jolt to the forearm is worst.",
    "pros": [
      "16mm core with a foam-injected edge wall, per JOOLA",
      "Standard (about 8.4 oz) and lighter Swift (about 7.9 oz) versions",
      "Long 5.5 in handle for two-handed backhands",
      "Grip listed at about 4.25 in on most listings"
    ],
    "cons": [
      "Standard version is on the heavy side for some players",
      "Elongated shape adds swing weight",
      "Grip size varies slightly between listings"
    ],
    "bottomLine": "If mishits near the edge are what hurt, the JOOLA Hyperion CFS 16's foam-filled edge and 16mm core add stability; pick the Swift version if you want it lighter."
  },
  {
    "id": "gamma-compass-neucore",
    "name": "Gamma Compass NeuCore",
    "badge": "Best Soft Feel",
    "category": "Graphite Face, About 16mm, Elongated",
    "amazonUrl": "#",
    "description": "The Gamma Compass is built around a soft core rather than a grippy face. Gamma lists its NeuCore polypropylene honeycomb at about 5/8 inch, roughly 15.9mm, and says it is 25% thicker than its previous core with larger cells for a softer feel. Retailers list a weight of about 7.75 ounces, plus or minus a quarter ounce, and a length of about 16 5/8 inches. Reviewers commonly describe the feel as soft even on hard-hit balls, which is the quality that matters most here. The graphite face grips the ball less than raw carbon, so spin-heavy players may want something else, but for a recreational player nursing an elbow, a soft, light, forgiving paddle is a sensible trade. It is also usually priced below the premium carbon paddles on this list.",
    "pros": [
      "Soft NeuCore honeycomb, about 15.9mm, per Gamma",
      "Light, about 7.75 oz",
      "Larger core cells designed for a softer feel",
      "Usually priced below premium carbon paddles"
    ],
    "cons": [
      "Graphite face offers less spin than raw carbon",
      "Elongated length adds swing weight",
      "Fewer published specs on grip size"
    ],
    "bottomLine": "For a soft, light and affordable paddle that takes the edge off contact, the Gamma Compass NeuCore is a good choice for recreational players with a sore forearm."
  },
  {
    "id": "paddletek-tempest-wave-pro-c",
    "name": "Paddletek Tempest Wave Pro-C",
    "badge": "Best for Soft Game",
    "category": "Carbon Face, 14.3mm Core, Standard Shape",
    "amazonUrl": "#",
    "description": "The Tempest Wave has long been a favorite of players who want a cushioned, controlled paddle, and the Pro-C version adds a carbon face. Paddletek lists a static weight of 7.8 to 8.2 ounces, within a tenth of an ounce of the stated figure, and a 14.3mm Tempest polymer honeycomb core. That core is thinner than the others here, so it is not the softest on paper, but retailers and reviewers consistently describe its feel as plush and soft on contact, particularly on dinks and resets. The standard shape keeps swing weight down, which helps players whose elbow complains on fast volleys. It is a good fit for doubles players who win with the soft game and want a paddle that feels gentle without going dead. Note that Paddletek also sells a V3 version with slightly different weight listings, so check which you are buying.",
    "pros": [
      "Weight held to within 0.1 oz of spec, per Paddletek",
      "Consistently described as soft and plush on contact",
      "Standard shape keeps swing weight low",
      "Carbon face for better control"
    ],
    "cons": [
      "14.3mm core is thinner than other picks",
      "Less reach than elongated paddles",
      "Pro-C and V3 versions have different specs"
    ],
    "bottomLine": "If your game is built on dinks and resets, the Paddletek Tempest Wave Pro-C offers a famously soft feel in a quick, low-swing-weight standard shape."
  },
  {
    "id": "onix-evoke-premier",
    "name": "Onix Evoke Premier",
    "badge": "Best Lightweight Option",
    "category": "Composite Face, Wide Body, Three Weights",
    "amazonUrl": "#",
    "description": "The Onix Evoke Premier earns its place because it lets you choose the weight. Onix lists light (7.5 to 7.8 ounces), medium (7.8 to 8.2 ounces) and heavy (8.2 to 8.5 ounces) versions of a wide-bodied paddle, 16 inches long and 8 inches wide, with a polypropylene honeycomb core and a composite face. The wide face gives a large, forgiving sweet spot, which means fewer of the off-center hits that jar the arm. Onix lists a 4.125-inch grip for the medium and heavy versions and a smaller 4-inch grip on the light one, so most players with elbow pain should pick the medium. Core thickness is listed inconsistently, 16mm by one major retailer and 13mm by another, so check the listing for the version you buy. It is listed as USA Pickleball approved and is usually affordable.",
    "pros": [
      "Three weight options, per Onix",
      "Wide 8 in face for a large sweet spot",
      "4.125 in grip on medium and heavy versions",
      "Listed as USA Pickleball approved"
    ],
    "cons": [
      "Core thickness listed as 16mm or 13mm depending on the retailer",
      "Light version has a small 4 in grip",
      "Composite face offers less spin than raw carbon"
    ],
    "bottomLine": "The Onix Evoke Premier's wide sweet spot and choice of three weights make it an easy, affordable way to find a paddle your arm tolerates; the medium is the one to start with."
  },
  {
    "id": "selkirk-slk-halo-control-max",
    "name": "Selkirk SLK Halo Control Max",
    "badge": "Best Budget",
    "category": "Carbon Face, 16mm Core, Wide Body",
    "amazonUrl": "#",
    "description": "The SLK line is Selkirk's lower-priced range, and the Halo Control Max brings a 16mm core and a wide face to a budget paddle. Most retailers list a 16mm Rev-Control polymer honeycomb core, an 18K UltraWeave carbon fiber face, a 16-inch length, a 7.85-inch width and a weight around 7.7 to 8.0 ounces, though one listing gives 7.6 to 8.2. Grip circumference is listed at about 4.25 inches. The wide face and 16mm core combine a forgiving sweet spot with a softer, control-oriented feel, which is what you want when the elbow is sensitive. The shorter handle, listed at about 4.85 inches, suits one-handed players better than two-handed ones. One retailer's listing for this paddle describes a fiberglass face and different dimensions, so stick to listings that match Selkirk's specs.",
    "pros": [
      "16mm control core at a budget price",
      "Wide 7.85 in face for forgiveness",
      "Grip listed at about 4.25 in",
      "Selkirk build quality in the SLK range"
    ],
    "cons": [
      "Short handle, about 4.85 in, limits two-handed backhands",
      "Weight listed in slightly different ranges",
      "One retailer listing conflicts with others"
    ],
    "bottomLine": "For a budget paddle with a 16mm core, a wide forgiving face and a decent grip size, the Selkirk SLK Halo Control Max is the sensible value pick for a sore arm."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pickleball Paddles for Tennis Elbow",
          item: "https://www.thehonestreviewers.com/best-pickleball-paddle-for-tennis-elbow/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best pickleball paddle for tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our pick is the Selkirk LUXX Control Air Invikta. Retailers list a 20mm honeycomb core with a foam perimeter and a weight of 7.8 to 8.1 ounces, which makes it one of the softest, most cushioned paddles available. Budget buyers should look at the Selkirk SLK Halo Control Max or the Gamma Compass NeuCore."
          }
        },
        {
          "@type": "Question",
          "name": "Is a heavier or lighter paddle better for tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most guidance points to the light-to-medium range, roughly 7.5 to 8.2 ounces. Heavier paddles absorb more impact but take more effort to swing and stop, while very light paddles can push you to swing harder and grip tighter. Swing weight matters too, so prefer a moderate one."
          }
        },
        {
          "@type": "Question",
          "name": "Are 16mm paddles better for tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thicker cores are generally described as softer and more cushioned, so 16mm or thicker is a sensible choice for a sore elbow. A few thinner paddles, like the Paddletek Tempest Wave Pro-C at 14.3mm, also have a reputation for a soft feel. Core construction and grip size matter as well."
          }
        },
        {
          "@type": "Question",
          "name": "What grip size should I use for tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A grip that lets you hold the paddle loosely, which for many adults means 4.125 inches or larger. A grip that is too small makes you squeeze, which loads the tendon. If you are between sizes, go larger, or add an overgrip to a smaller handle."
          }
        },
        {
          "@type": "Question",
          "name": "Can a paddle cure tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A paddle can reduce the shock, vibration and grip pressure that load the tendon, but recovery usually comes from reducing total load and strengthening the forearm over weeks to months. See a doctor or physical therapist if pain persists or appears at rest."
          }
        },
        {
          "@type": "Question",
          "name": "Do thermoformed paddles cause tennis elbow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do not cause it on their own, but some arm-health guides report that certain foam-core and thermoformed paddles feel firmer and transmit more shock than traditional honeycomb paddles. If you have elbow pain, read owner reports from players with arm issues before buying one."
          }
        },
        {
          "@type": "Question",
          "name": "Should I wear an elbow strap for pickleball?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many players find a counterforce strap worn just below the elbow eases symptoms during play. Ask your doctor or physical therapist whether one suits you. A strap manages symptoms, but it does not replace rest, strengthening and technique changes."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Outdoor Gear",
    tags: [
      "best pickleball paddle for tennis elbow",
      "pickleball paddle for tennis elbow",
      "pickleball paddle for arm pain",
      "soft pickleball paddle",
      "pickleball elbow",
      "16mm pickleball paddle"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Buyer's Guide
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Pickleball Paddles <span class="text-[#38BDF8]">for Tennis Elbow</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Six thicker, softer paddles that cut the sting reaching your forearm, plus the grip, weight and technique changes that matter as much as the paddle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#selkirk-luxx-control-air-invikta"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#what-loads-the-elbow"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What Loads the Elbow
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-chose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Chose</a>
          <a href="#what-loads-the-elbow" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Loads the Elbow</a>
          <a href="#core" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Core Thickness and Softness</a>
          <a href="#weight" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Weight and Swing Weight</a>
          <a href="#grip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Grip Size and Overgrips</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Technique Changes That Help</a>
          <a href="#when-paddle-wont-fix" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When a Paddle Won't Fix It</a>
          <a href="#buying-checklist" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Buying Checklist</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          No paddle cures tennis elbow, and anyone who tells you otherwise is selling something. What a paddle can do is reduce the sting and vibration that reach a sore forearm, and stop you squeezing the handle to hang on. That means a thicker, softer core, a moderate weight, and a grip big enough to hold loosely. The six paddles below are built that way. Pair one with a properly sized grip, a relaxed stroke and advice from a doctor or physical therapist, and you give the tendon a better chance to settle.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-chose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Chose These Six
          </h2>

          <p>
            Tennis elbow, lateral epicondylitis, is an overuse problem in the tendons on the outside of the elbow that attach the muscles extending the wrist. In pickleball, those muscles work every time you grip the paddle, stabilise it at contact and decelerate after the shot. A paddle cannot heal the tendon, but it can change how much shock and vibration reach it and how hard you have to grip. Those are the qualities we selected for.
          </p>

          <p>
            We looked for paddles with thick or notably soft cores, moderate weights in the 7.5 to 8.5 ounce range, grips of 4.125 inches or larger, and forgiving faces or foam-filled edges that steady off-center hits. Each pick is from an established brand that publishes its specs. We have not measured vibration ourselves, so every figure is attributed to the manufacturer or retailers, and we note where listings disagree.
          </p>

          <p>
            This page is a gear guide, not medical advice. If your elbow hurts at rest, wakes you at night, or has not improved after a few weeks of reduced play, see a doctor, sports medicine clinician or physical therapist. They can confirm what is going on and give you exercises that do more for the tendon than any paddle. Our main guide to the <a href="/best-pickleball-paddle/">best pickleball paddles</a> covers paddles for every style of play if arm pain is not your concern.
          </p>

          <p>
            The six picks cover the realistic choices: the thickest core available, a stable foam-edged elongated paddle, a soft and light budget-friendly option, a famously plush standard-shape paddle, a wide-bodied paddle with three weights, and a budget 16mm paddle from a major brand.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Our 6 Picks for Tennis Elbow
          </h2>

          <p>
            We have not lab-tested these paddles for vibration, and this is not medical advice. Every spec below comes from the manufacturer or major retailers, and we note where listings disagree. The six favor thick or soft cores, moderate weights and grips at 4.125 inches or larger, with options for different budgets and shapes.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
