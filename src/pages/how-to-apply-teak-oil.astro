                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Raw, new teak</td>
                    <td class="px-4 py-4 text-gray-700">150 to 220</td>
