---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Fire Pits",
    "url": "/best-fire-pit/"
  },
  {
    "title": "Best Charcoal Grills",
    "url": "/best-charcoal-grill/"
  },
  {
    "title": "Best Smokers",
    "url": "/best-smoker/"
  },
  {
    "title": "Concrete Patio Cost",
    "url": "/concrete-patio-cost/"
  },
  {
    "title": "Best Pool Deck Sealers",
    "url": "/best-pool-deck-sealer/"
  },
  {
    "title": "Best Outdoor Concrete Stains",
    "url": "/best-outdoor-concrete-stain/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Gas Fire Pits in 2026: BTU, Burn Time and Fuel Type";
const description =
  "The best gas fire pits on Amazon from Real Flame, Solo Stove, Outland Living, Endless Summer and Amazon Basics, compared on BTU, burn time per 20 lb tank, propane vs natural gas and safety.";

const PRODUCTS = [
  {
    "id": "real-flame-aegean-42-gas-fire-table",
    "name": "Real Flame Aegean 42-Inch Propane or Natural Gas Fire Pit Table",
    "category": "Fire Pit Table, 50,000 BTU, Propane or Natural Gas (Conversion Kit Included), Lava Rock, CSA Certified",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Ships with both an LP hose and regulator and a natural gas conversion kit",
      "50,000 BTU stainless steel burner with push-button ignition",
      "Listed as safe for use on a wooden deck, with automatic safety shut-off",
      "CSA Certified, per the listing",
      "Burner lid, lava rock, tank seat and storage cover included"
    ],
    "cons": [
      "The 20 lb tank sits outside the table; a tank cover is sold separately",
      "Natural gas conversion must be done by a certified gas technician",
      "Lava rock looks rustic rather than modern"
    ],
    "bottomLine": "The best gas fire pit for most patios: a 42-inch table that runs on propane now and natural gas later, with the conversion kit in the box.",
    "description": "Most buyers searching for a gas fire pit are really choosing between propane today and a natural gas line later, and the Real Flame Aegean is the one table that handles both without an extra purchase. Real Flame lists a 42-inch rectangular table in powder-coated steel with a 23-inch stainless steel burner rated at 50,000 BTU, push-button ignition and adjustable flame height. In the box you get a 9-foot LP hose with regulator for a standard 20 lb tank, plus a natural gas conversion kit with a 10-foot NG hose and quick-connect socket. Real Flame is clear that the conversion must be done by a certified gas technician, which is the right advice for any gas line work. The safety details are why it ranks first. The listing says it is safe for use on a wooden deck, includes an automatic safety shut-off and is CSA Certified, and it comes with a burner lid, lava rock filler, leveling feet, a tank seat and a vinyl storage cover. The trade-offs: the propane tank sits outside the table, so you will see it unless you buy the separate tank cover, and lava rock gives a rustic look rather than the glass sparkle of a modern table. Buy the Outland Series 403 instead if you want fire glass, or the Outland Firebowl 870 if you need to carry it."
  },
  {
    "id": "solo-stove-infinity-flame-42",
    "name": "Solo Stove Infinity Flame 42-Inch Propane Fire Pit",
    "category": "Propane Fire Pit Table, Up to 72,000 BTU, Up to 5.5 Hours per 20 lb Tank, 304 Stainless Steel, Fire Glass",
    "badge": "Best Premium",
    "amazonUrl": "#",
    "pros": [
      "Up to 72,000 BTU, the highest output in this guide",
      "Solo Stove lists up to 5.5 hours on a standard 20 lb tank",
      "304 stainless steel and powder-coated steel construction",
      "Black Pearl fire glass and a burner designed to mimic a wood fire",
      "Wide tabletop helps reduce hot spots and seats 5 to 8 people"
    ],
    "cons": [
      "Propane only; the listing mentions no natural gas option",
      "The listing does not state a CSA certification",
      "Premium brand pricing"
    ],
    "bottomLine": "The most powerful and best-finished gas fire pit here, for a big group that wants Solo Stove's look without wood smoke.",
    "description": "Solo Stove built its name on smokeless wood pits, and the Infinity Flame is its answer for people who want that look with the convenience of propane. The listing describes a 42-inch fire pit table, 20 inches high, that seats five to eight people, built from 304 stainless steel, powder-coated steel and UV-resistant waterproof materials. Its burner and Black Pearl fire glass are designed to recreate the look and movement of a wood fire without smoke, ash or sparks. The spec that sets it apart is heat. Solo Stove lists up to 72,000 BTU, the highest output in this guide, and up to 5.5 hours on a standard 20 lb propane tank. That run time is honest arithmetic for that output: a bigger flame empties a tank faster, so plan on a spare for long evenings. The wide tabletop is designed to disperse heat and reduce hot spots, with room for drinks, and Solo Stove notes that the outside still gets hot. The listing's own safety advice is sound: use it outdoors on a stable, non-flammable surface away from overhangs, turn off the gas at the tank after use, and check hoses for leaks. The trade-offs: it is propane only, the listing does not state CSA certification, and it costs far more than the others. Buy the Real Flame Aegean if you may switch to natural gas."
  },
  {
    "id": "outland-firebowl-870-premium",
    "name": "Outland Living Firebowl 870 Premium 19-Inch Auto-Ignition Propane Fire Pit",
    "category": "Portable Propane Fire Pit, 58,000 BTU, Auto-Ignition, Lava Rock, CSA Approved, NG Kit 785 Optional",
    "badge": "Best Portable",
    "amazonUrl": "#",
    "pros": [
      "58,000 BTU from a 19 x 19 x 11 inch bowl",
      "Matchless auto-ignition for quick start-up",
      "CSA approved, per the listing",
      "Cover, carry kit, 10-ft hose, regulator and 4.4 lb lava rock included",
      "Optional CSA-approved natural gas conversion kit 785 sold separately"
    ],
    "cons": [
      "A small bowl seats fewer people than a table",
      "Conversion kit and carry bag cost extra",
      "Heat is concentrated close to the bowl"
    ],
    "bottomLine": "A compact, auto-igniting propane fire bowl for camping, tailgates and small patios, with a natural gas kit available later.",
    "description": "If your gas fire pit needs to travel to campsites, tailgates and the beach as well as sit on the patio, a portable bowl beats a table, and the Outland Firebowl 870 Premium is the one we would pick. It is a different, newer model from the Outland 893 on our main fire pit page: the 870 adds matchless auto-ignition, so you turn the knob and light it without a long lighter. Outland lists it at 19 by 19 by 11 inches with 58,000 BTU per hour, which is a lot of output for its size, and says it sets up in minutes with no tools and no assembly. The kit is complete: a cover and carry kit, a pre-attached 10-foot hose that lets you keep a standard 20 lb tank out of sight, an adjustable regulator with a chrome valve knob, and a 4.4 lb natural lava rock set. Outland says it is CSA approved and safe to use during most campfire bans, while telling buyers to check current fire restrictions, which is the right caveat. An optional CSA-approved natural gas conversion kit, model 785, is sold separately. The trade-offs: a 19-inch bowl gathers four people, not eight, its heat is concentrated close in, and the carry bag costs extra. Buy the Real Flame Aegean instead for a permanent patio table."
  },
  {
    "id": "endless-summer-donovan-dualheat",
    "name": "Endless Summer DualHeat Donovan 38-Inch Propane Fire Pit Table and Patio Heater",
    "category": "Fire Pit Table + Patio Heater, 30,000 + 11,000 BTU, Hidden Tank, Auto Shut-Off, Fire Glass",
    "badge": "Best for Heat",
    "amazonUrl": "#",
    "pros": [
      "30,000 BTU fire burner plus an 11,000 BTU heater below the mantel",
      "Heater and flame adjust independently, per the listing",
      "Hidden tank compartment keeps the 20 lb tank out of sight",
      "Automatic safety shut-off valve and hidden control panel",
      "Table insert stores inside the door for a full tabletop"
    ],
    "cons": [
      "The fire burner alone is smaller than most tables here",
      "Placement on non-combustible floors is recommended",
      "Bulky at 38 x 38 x 30 inches"
    ],
    "bottomLine": "The gas fire pit that actually warms your legs, combining a flame with a lower heater element in one hidden-tank table.",
    "description": "The most common complaint about gas fire pit tables is that they look warm but leave your legs cold, because the heat rises off the flame and over the table. Endless Summer's DualHeat Donovan tackles that directly. The listing describes a 30,000 BTU main burner for the fire plus an 11,000 BTU heater element below the mantel, totaling 41,000 BTU, with the lower element aimed at the people sitting around it. Endless Summer says it can be used four ways: as a fire pit, as a patio heater, as both at once, or with the table insert in place as a plain table, and you adjust the flame and heater independently. The design hides a standard 20 lb propane tank inside the table, which keeps it tidy and out of reach, and the listing includes an automatic safety shut-off valve, a hidden control panel, bronze glass rock, a stainless steel burner, a steel table insert stored on the inside of the door, adjustable feet and a protective cover. It measures 38 by 38 by 30 inches. The trade-offs: the fire burner alone is smaller than the 50,000 BTU tables here, Endless Summer recommends non-combustible floors and well-ventilated, non-enclosed areas, and it is bulky. Buy the Solo Stove Infinity Flame instead if a bigger flame matters more than leg warmth."
  },
  {
    "id": "outland-series-403-fire-table",
    "name": "Outland Living Series 403 44-Inch Propane Fire Pit Table",
    "category": "Fire Pit Table, 50,000 BTU, Tempered Glass Top, 15.5 lb Fire Glass, Push-Button Ignition, Wicker",
    "badge": "Best Fire Glass Table",
    "amazonUrl": "#",
    "pros": [
      "50,000 BTU with push-button spark ignition",
      "8 mm black tempered glass tabletop",
      "15.5 lb Arctic Ice decorative glass rock set included",
      "All-weather HDPE wicker over a powder-coated aluminum frame",
      "Clearances listed plainly: 80 inches above, 36 inches to the sides"
    ],
    "cons": [
      "Non-combustible floors only, so not for a wooden deck",
      "A 3-ft hose means the tank sits right beside the table",
      "Wicker styling will not suit every patio"
    ],
    "bottomLine": "A stylish 44-inch fire glass table with a tempered glass top and clearly listed clearances, for stone or concrete patios.",
    "description": "If you want the modern look of fire dancing over glass rather than lava rock, the Outland Living Series 403 is the table we would choose, partly because its listing is unusually clear about how to use it safely. Outland lists it at 44 by 32 by 24 inches with 50,000 BTU per hour, a push-button spark ignition and a chrome control valve for adjustable, smoke-free flame height. The top is 8 mm black tempered glass, which reflects the flames, and it comes with a 15.5 lb set of Arctic Ice decorative glass rocks. The base is espresso-brown HDPE wicker over a powder-coated aluminum frame, both chosen to stand up to weather. The listing states the clearances: 80 inches above the table and 36 inches to the sides, and says to install it on or over non-combustible floors only, in a well-ventilated space and never in an enclosed area. That rules out a wooden or composite deck unless you add a suitable non-combustible base and the instructions allow it. It uses a standard 20 lb tank on a pre-attached 3-foot hose with regulator, so the tank sits beside the table, and the wicker style is a matter of taste. Buy the Real Flame Aegean instead for a deck-rated table or a natural gas option, or the Lindsey for a smaller footprint."
  },
  {
    "id": "endless-summer-lindsey-30",
    "name": "Endless Summer Lindsey 30-Inch LP Gas Fire Pit Table (GAD15318ES)",
    "category": "Fire Pit Table, 50,000 BTU Stainless Burner, Auto Shut-Off, Hidden Control Panel, White Fire Glass",
    "badge": "Best Compact Table",
    "amazonUrl": "#",
    "pros": [
      "50,000 BTU stainless steel burner in a 30 x 30 inch table",
      "Automatic shutoff safety device",
      "Hidden control panel with push-and-turn ignition",
      "Steel table insert turns it into a side table when off",
      "White fire glass, cover and adjustable feet included"
    ],
    "cons": [
      "Weighs 61.73 lb, per the listing",
      "Faux wood mantel is a look, not real wood",
      "The listing does not state certification or tank placement"
    ],
    "bottomLine": "A compact 30-inch propane fire table with full 50,000 BTU output and an automatic shutoff, sized for small patios.",
    "description": "Not every patio has room for a 42-inch table, and the Endless Summer Lindsey puts full-size output into a 30-inch square. Endless Summer lists it at 30 inches long, 30 inches wide and 24 inches tall, with a 50,000 BTU stainless steel burner, the same rating as tables much larger, so a small group sits closer to the heat. Safety and convenience features are well thought out. It has an automatic shutoff safety device and a hidden control panel with push-and-turn ignition, which keeps the knob out of easy reach of small children. A steel table insert covers the burner when the fire is off, so it doubles as a side table, and the listing notes the base is a handy place to store that insert while the fire is lit. White fire glass, a protective cover and adjustable feet are included. The base is stamped steel with a weather-protected finish and a decorative cut-out pattern, under a multi-tone faux wood mantel. It runs on a standard 20 lb LP grill tank. The trade-offs: at 61.73 pounds it is heavier than its size suggests, the mantel is faux wood, and the listing does not state a certification or say whether the tank hides inside, so check the manual. Buy the Donovan instead if warmth at leg level matters more than size."
  },
  {
    "id": "amazon-basics-fire-table-28",
    "name": "Amazon Basics 28-Inch Propane Fire Table, 50,000 BTU",
    "category": "Square Fire Pit Table, 50,000 BTU, Lava Rock, Lid Doubles as Tabletop",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "50,000 BTU output, the same as tables costing much more",
      "Lid doubles as an outdoor tabletop",
      "Lava rock with adjustable flame control",
      "Propane connection pre-tested for safety, per the listing",
      "Square 28 x 28 x 25 inch design leaves a ledge for drinks"
    ],
    "cons": [
      "A thin listing: no certification, ignition type or tank placement stated",
      "Lava rock only",
      "No natural gas option mentioned"
    ],
    "bottomLine": "A plain, low-cost 50,000 BTU propane fire table for buyers who want heat and a flame, not a showpiece.",
    "description": "If you want a gas fire table for the patio without paying for a brand or a showpiece design, the Amazon Basics fire table covers the essentials. The listing describes a square table measuring 28 by 28 by 25 inches with a 50,000 BTU burner, the same output as the Real Flame and Outland tables, and a lava rock fire bed with adjustable flame control so you can turn it up for heat or down for ambience. The square design leaves a ledge around the fire for drinks and plates, and the included lid covers the burner and doubles as an outdoor tabletop when the fire is off. Amazon says setup is quick, with a simple propane connection that has been pre-tested for safety. Be clear about what the listing does not say, because it is thin. It does not state a CSA or other certification, the ignition type, whether the tank hides inside the table, the material of the body, clearances, or whether it can be used on a wooden deck. Read the manual before you buy if any of those matter, follow its clearance and surface rules, and still leak-test every connection with soapy water on first use. It is also lava rock only, with no natural gas option mentioned. Buy the Endless Summer Lindsey instead for an automatic shutoff and hidden controls in a similar size."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gas Fire Pits",
          item: "https://www.thehonestreviewers.com/best-gas-fire-pit/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best gas fire pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most patios, the Real Flame Aegean 42-inch is the best gas fire pit. Its listing includes both a propane hose and a natural gas conversion kit, a 50,000 BTU burner, an automatic shut-off, CSA certification and approval for wooden decks. For a portable model, the Outland Firebowl 870 Premium is the best choice."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best outdoor natural gas fire pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Real Flame Aegean is the best natural gas option we found on Amazon because the conversion kit and a 10-foot NG hose come in the box. Outland Firebowls take an optional natural gas kit. Any natural gas hookup must be installed by a licensed gas professional, and many areas require a permit."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a 20 lb propane tank last in a fire pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly 8.5 hours at full flame on a 50,000 BTU burner, about 7.4 hours at 58,000 BTU and about 6 hours at 72,000 BTU. Solo Stove lists up to 5.5 hours for the Infinity Flame. Running the flame lower stretches a tank, while cold and wind shorten it, so keep a spare filled tank on hand."
          }
        },
        {
          "@type": "Question",
          "name": "Are gas fire pits worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you want an instant, smoke-free flame with no ash, sparks or firewood to store. Gas pits work on many decks and patios where wood fires are not allowed. They give less heat and less campfire character than wood, so choose wood if you want to cook over coals."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a gas fire pit under a covered patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the maker's manual specifically allows it and the listed overhead clearance and ventilation are met. Covers trap heat and combustion gases. The Outland Series 403, for example, lists 80 inches of clearance above. If the manual does not allow covered use, do not do it, and never use one in a screened or enclosed porch."
          }
        },
        {
          "@type": "Question",
          "name": "Is lava rock or fire glass better for a gas fire pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither burns better; the choice is mostly looks. Lava rock is cheaper and looks like a campfire, but it soaks up rain and should be dried before a full flame. Fire glass reflects the flame for a modern look and does not soak up water. Use only filler made for gas fire pits."
          }
        },
        {
          "@type": "Question",
          "name": "Do gas fire pits give off heat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but most of it rises. A 50,000 BTU table warms people seated nearby on a mild evening, and less in wind or deep cold. For real warmth, sit close, shelter it from wind within the allowed clearances, or choose a combination unit like the Endless Summer DualHeat Donovan, which adds a heater aimed at legs."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Outdoor Living",
    tags: [
      "best gas fire pit",
      "best outdoor natural gas fire pits",
      "best gas fire pits",
      "best outdoor gas fire pit",
      "best propane fire pit",
      "best gas fire pit table",
      "best natural gas fire pit"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Gas Fire Pits</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Instant flame, no smoke, no ash. Seven propane and natural gas fire pits on Amazon, from portable bowls to fire pit tables, compared on heat, fuel and safety.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#real-flame-aegean-42-gas-fire-table"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Propane or Natural Gas?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Bowl, Table or Tabletop</a>
          <a href="#btu-burn-time" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. BTU and Burn Time</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Gas Fire Pits</a>
          <a href="#propane-vs-natural-gas" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Propane vs Natural Gas</a>
          <a href="#lava-rock-vs-glass" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Lava Rock vs Fire Glass</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Safety Rules</a>
          <a href="#decks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Using One on a Deck</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. What Size You Need</a>
          <a href="#heat" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Getting Real Heat</a>
          <a href="#setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Setup and Lighting</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Covers and Storage</a>
