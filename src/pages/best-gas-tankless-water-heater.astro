---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Tankless Water Heaters",
    "url": "/best-tankless-water-heater/"
  },
  {
    "title": "Best Propane Tankless Water Heaters",
    "url": "/best-propane-tankless-water-heater/"
  },
  {
    "title": "Best Electric Tankless Water Heaters",
    "url": "/best-electric-tankless-water-heater/"
  },
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  },
  {
    "title": "What Size Tankless Water Heater Do I Need?",
    "url": "/what-size-tankless-water-heater-do-i-need/"
  },
  {
    "title": "Tankless Water Heater Cost",
    "url": "/tankless-water-heater-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "7 Best Gas Tankless Water Heaters in 2026: GPM and Venting";
const description =
  "The best gas tankless water heaters on Amazon from Rinnai, Rheem, Noritz and Eccotemp: condensing and non-condensing, indoor and outdoor, compared on GPM, BTU, efficiency and installation.";

const PRODUCTS = [
  {
    "id": "rinnai-rx160in",
    "name": "Rinnai RX160iN Condensing Smart Sense Tankless Water Heater",
    "category": "Condensing, 9 GPM, 160k BTU, Natural Gas or Propane, Indoor/Outdoor",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Super-high efficiency, listed at UEF 0.97",
      "Up to 9 GPM, which Rinnai says covers about 6 fixtures at once",
      "Smart Sense gas control runs on natural gas or propane",
      "Versa Vent allows indoor or outdoor installation (outdoor needs the RX-OVC vent cap)",
      "Quick Flush feature to simplify descaling"
    ],
    "cons": [
      "Condensing units need a condensate drain line",
      "Wi-Fi needs the separate Controlr module",
      "Rinnai recommends professional installation, which adds to the cost"
    ],
    "bottomLine": "The best gas tankless water heater for most homes: very high efficiency, flexible venting and either fuel, at a size that suits two to three bathrooms.",
    "description": "The Rinnai RX160iN is the gas tankless water heater we would point most households toward, because it is efficient, flexible and sized for a typical family home. Rinnai lists its efficiency at a UEF of 0.97, among the highest for gas water heaters, which comes from condensing technology that recovers heat from the exhaust. It delivers up to 9 gallons per minute, which Rinnai describes as about six fixtures at once, enough for two showers and a dishwasher in most climates. Two features make it easier to fit into an existing home. Smart Sense gas control lets the same unit run on natural gas or propane, and Rinnai's Versa Vent design allows indoor or outdoor installation, with the RX-OVC vent cap required outside. It also has a Quick Flush feature for simpler descaling. The warranty is listed at 15 years on the heat exchanger, 5 on parts and 5 on labor if you register within 90 days. The trade-offs are typical of condensing units. You need a condensate drain line, Wi-Fi control needs Rinnai's Controlr module, and Rinnai recommends professional installation. Buy the Rinnai RE199iN instead for a bigger, cheaper non-condensing unit, or a 199k BTU model if you live somewhere with very cold groundwater."
  },
  {
    "id": "rinnai-re199in",
    "name": "Rinnai RE199iN Non-Condensing Natural Gas Tankless Water Heater",
    "category": "Non-Condensing, 9.8 GPM, 199k BTU, Natural Gas, Indoor",
    "badge": "Best High-Flow Value",
    "amazonUrl": "#",
    "pros": [
      "Up to 9.8 GPM from 199,000 BTU, per the listing",
      "Non-condensing, so no condensate drain is needed",
      "LED display with diagnostic codes and a service reminder",
      "15-year heat exchanger warranty, per the listing",
      "Compact, wall-mounted design"
    ],
    "cons": [
      "Lower efficiency than condensing models",
      "Non-condensing units need stainless or other high-temperature vent pipe",
      "Indoor installation only"
    ],
    "bottomLine": "The most hot water per dollar here: a 199k BTU indoor unit for large households, without a condensing unit's drain line.",
    "description": "If your household runs several showers at once, BTU input decides how much hot water a tankless heater can make, and the Rinnai RE199iN gives you the maximum residential input of 199,000 BTU for less than a condensing unit of the same size. Rinnai lists it at up to 9.8 gallons per minute, supporting showers, laundry and a dishwasher together, which suits large households and colder regions where incoming water needs more heating. As a non-condensing heater, it skips the condensate drain line that condensing units need, which can simplify installation where there is no convenient drain. A wall-mounted LED display shows diagnostic codes and a service reminder, and it works with Rinnai's Controlr module, sold separately, for Wi-Fi control. Rinnai lists a 15-year limited warranty on the heat exchanger, 5 years on parts and 5 years on labor when registered within 90 days. The trade-offs are efficiency and venting. A non-condensing unit is less efficient than the RX160iN, so running costs are higher, and its hot exhaust needs high-temperature vent pipe, which can cost more than the plastic vent condensing units use. It is indoor only. Buy the RX160iN instead for lower gas bills, or the Rheem RTG outdoor model to avoid indoor venting entirely."
  },
  {
    "id": "rheem-rtgh-84dvln-3",
    "name": "Rheem RTGH Series 8.4 GPM Condensing Natural Gas Tankless (Indoor)",
    "category": "Condensing, 8.4 GPM at 35F Rise, 157k BTU, UEF 0.93, Indoor Direct Vent",
    "badge": "Best Rheem",
    "amazonUrl": "#",
    "pros": [
      "8.4 GPM at a 35°F rise from 157,000 BTU/hr, per the listing",
      "Condensing, with a 0.93 UEF",
      "Rheem says it handles 3 to 4 showers at once",
      "Digital LED temperature control to ±1°F",
      "Built-in freeze protection and ultra-low NOx compliance"
    ],
    "cons": [
      "Its 8.4 GPM rating is at a 35°F rise, so colder groundwater lowers it",
      "Professional installation recommended",
      "Indoor direct vent only"
    ],
    "bottomLine": "A condensing Rheem with clear sizing data and tight temperature control, for multi-bathroom homes on natural gas.",
    "description": "Rheem's RTGH 8.4 GPM indoor model is a condensing natural gas tankless heater, and its listing gives one of the clearest sizing figures here: 8.4 gallons per minute at a 35°F temperature rise from 157,000 BTU per hour. That 35°F figure matters, because it shows flow at the modest rise of a warm climate; in a colder region where incoming water must be heated by 60°F or more, expect noticeably less. Rheem describes it as suited to three or four simultaneous showers and large multi-bathroom families. Its condensing design is listed at a 0.93 uniform energy factor, and Rheem says it uses up to 34 percent less energy than a standard 50-gallon electric tank. It installs indoors with direct venting, is compliant with ultra-low NOx rules that apply in some regions, and is CSA certified. A digital LED control sets temperature to within one degree, and freeze protection and a multi-point safety system are built in. The listing includes mounting hardware and a 15-year heat exchanger and 5-year parts warranty. The trade-offs: it is indoor only, professional installation is recommended, and like any condensing unit it needs a condensate drain. Buy the Rinnai RX160iN instead for higher efficiency and the option of propane or outdoor installation."
  },
  {
    "id": "rinnai-rep199in",
    "name": "Rinnai REP199iN Smart-Circ Natural Gas Tankless Water Heater",
    "category": "Non-Condensing, Built-In Recirculation Pump, 199k BTU, Natural Gas, Indoor",
    "badge": "Best for Faster Hot Water",
    "amazonUrl": "#",
    "pros": [
      "Built-in recirculation pump to cut the wait for hot water",
      "Smart-Circ learns your usage and schedules the pump",
      "199,000 BTU input, per the listing",
      "Compact, about the size of a small suitcase",
      "15-year heat exchanger warranty"
    ],
    "cons": [
      "Lower flow than the RE199iN: the listing gives 7.9 GPM in its title and 7.6 GPM in its description",
      "Recirculation uses some energy to keep the loop warm",
      "Non-condensing, so lower efficiency"
    ],
    "bottomLine": "The fix for the most common tankless complaint: waiting for hot water at a distant tap.",
    "description": "The most common complaint about tankless water heaters is the wait for hot water at a faucet far from the heater. The Rinnai REP199iN addresses it directly with a built-in recirculation pump and what Rinnai calls Smart-Circ, which learns your household's hot water patterns and schedules the pump to run when you are likely to need hot water, rather than all the time. In a long house or one with the heater in a garage at one end, that can shorten the wait at the far bathroom considerably. Otherwise it is a 199,000 BTU non-condensing indoor unit, compact enough that Rinnai compares it to a small suitcase. The flow figure is worth reading carefully: the listing title says 7.9 gallons per minute and the description says 7.6, so plan on the lower number. Either way it is less than the RE199iN's 9.8, because part of the design goes to recirculation. Rinnai lists a 15-year heat exchanger warranty, with 5 years on parts and labor when registered within 90 days. The trade-offs are flow, efficiency and the energy the pump uses keeping the loop warm. Buy the RE199iN instead if the wait for hot water does not bother you and flow matters more, or add a recirculation system later."
  },
  {
    "id": "rheem-rtg-70-outdoor",
    "name": "Rheem RTG Series 7.0 GPM Natural Gas Tankless (Outdoor)",
    "category": "Non-Condensing, 7.0 GPM at 35F Rise, 160k BTU, UEF 0.82, Outdoor",
    "badge": "Best Outdoor",
    "amazonUrl": "#",
    "pros": [
      "Outdoor installation eliminates venting, per the listing",
      "7.0 GPM at a 35°F rise from 160,000 BTU/hr",
      "Durable metal cabinet for outdoor mounting",
      "Freeze protection and flame failure protection built in",
      "Digital LED temperature control to ±1°F"
    ],
    "cons": [
      "Lower efficiency (0.82 UEF) than the condensing models",
      "Best suited to milder climates where outdoor units are common",
      "Rated for 2 to 3 showers at once, per Rheem"
    ],
    "bottomLine": "The simplest gas tankless installation where climate allows: mounted outside, with no vent pipe through the house.",
    "description": "Venting is one of the biggest costs in a gas tankless installation, and the Rheem RTG 7.0 GPM outdoor model avoids it. Because it mounts on an outside wall, the listing says outdoor installation eliminates venting, which makes it a good fit for homes in mild climates, homes without a good indoor location, or replacements where routing a new vent would be expensive. Rheem lists it at 7.0 gallons per minute at a 35°F temperature rise from 160,000 BTU per hour, which it describes as enough for two to three simultaneous showers. It has a durable metal cabinet for outdoor mounting, built-in freeze protection, flame failure protection and a multi-point safety system, plus a digital LED control panel that sets temperature to within one degree. It is CSA certified, and the listing includes mounting hardware and a 15-year heat exchanger and 5-year parts warranty. The trade-offs are efficiency and climate. As a non-condensing unit it is listed at a 0.82 UEF, well below the condensing models here, and outdoor tankless units are most common in regions with mild winters; freeze protection depends on power, so a long outage in deep cold is a risk. Buy the Rinnai RX160iN instead for indoor-or-outdoor flexibility and higher efficiency."
  },
  {
    "id": "noritz-ez-series-pro-gq-c3261wx",
    "name": "Noritz EZ Series Pro Natural Gas Tankless Water Heater (GQ-C3261WX-FF)",
    "category": "11.1 GPM, 199,900 BTU, Indoor/Outdoor, 120V, Bluetooth",
    "badge": "Highest Flow",
    "amazonUrl": "#",
    "pros": [
      "Highest listed flow here at 11.1 GPM",
      "199,900 BTU input",
      "Rated for indoor or outdoor installation",
      "Bluetooth connectivity",
      "Runs on standard 120-volt power"
    ],
    "cons": [
      "The Amazon listing gives few details beyond the title",
      "Check the efficiency rating and venting requirements in Noritz's documentation before buying",
      "Highest flow means a large gas line requirement"
    ],
    "bottomLine": "The pick for the biggest households and coldest groundwater, if you confirm the details with Noritz first.",
    "description": "For large homes with several bathrooms in use at once, or for cold regions where every degree of temperature rise costs flow, the Noritz EZ Series Pro has the highest listed flow on this list at 11.1 gallons per minute, from 199,900 BTU, the top of the residential range. Noritz's EZ Series is designed to simplify replacing a tank water heater, and this Pro model is listed for indoor or outdoor installation, runs on standard 120-volt power and adds Bluetooth connectivity. Noritz is one of the long-established Japanese tankless makers, alongside Rinnai and Takagi. The honest caveat is that the Amazon listing is thin. Beyond the title, it gives almost no detail, so the efficiency rating, the venting materials, the warranty terms and the flow at your temperature rise are not stated there. Check Noritz's own specification sheet and installation manual before buying, and have your installer confirm venting and gas supply. A 199,900 BTU heater needs a gas line and meter that can supply that much gas alongside your furnace and stove, which in many homes means upgrading the line. Buy the Rinnai RE199iN instead if you want a high-flow unit with full details and warranty terms on the listing."
  },
  {
    "id": "eccotemp-smarthome-indoor-ng",
    "name": "Eccotemp SMARTHOME Indoor 6.8 GPM Natural Gas Tankless Water Heater",
    "category": "6.8 GPM at 35F Rise, 140k BTU, Wi-Fi App, Alexa/Google, Indoor",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "6.8 GPM at 140,000 BTU with a 35°F rise, per the listing",
      "Eccotemp says it covers up to 3 bathrooms at once",
      "Mobile app for temperature, schedules and energy tracking",
      "Works with Amazon Alexa and Google Home",
      "Temperature range of 95 to 140°F"
    ],
    "cons": [
      "Shorter warranty: 5 years heat exchanger, 2 years parts",
      "Lower BTU than the 199k units, so less flow in cold climates",
      "Efficiency rating not stated on the listing"
    ],
    "bottomLine": "A lower-cost smart gas tankless for smaller homes, condos and cabins, with app and voice control built in.",
    "description": "The Eccotemp SMARTHOME is the lower-cost route into gas tankless, aimed at standard single-family homes, townhomes, condos and cabins rather than large houses. Eccotemp lists it at 6.8 gallons per minute at 140,000 BTU with a 35°F temperature rise, rated for three to four applications and showers in up to three bathrooms at once. Its distinguishing feature is smart control without an add-on module. The Eccotemp app tracks energy use, adjusts temperature, sets schedules and flags errors, and an Eco Mode is designed to cut energy use. It also works with Amazon Alexa and Google Home, so you can set the temperature by voice, and a Smart Power Button handles on and off, error detection and a sleep mode. The temperature range runs from 95 to 140°F. Eccotemp also sells an EZ-Flush descaling kit for this series. It is CSA certified for the US and Canada. The trade-offs are warranty, flow and efficiency information. The warranty is listed at 5 years on the heat exchanger and 2 on parts, well below Rinnai's and Rheem's 15-year heat exchanger coverage, its 140,000 BTU gives less flow in cold climates, and the listing does not state a UEF. Buy the Rinnai RX160iN instead for longer warranty and higher efficiency."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gas Tankless Water Heaters",
          item: "https://www.thehonestreviewers.com/best-gas-tankless-water-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best gas tankless water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Rinnai RX160iN is the best gas tankless water heater for most homes. It is a condensing unit listed at a UEF of 0.97 and up to 9 GPM, runs on natural gas or propane, and installs indoors or outdoors. The Rinnai RE199iN is the better value for high flow, and the Noritz EZ Series Pro lists the most flow at 11.1 GPM."
          }
        },
        {
          "@type": "Question",
          "name": "Do gas tankless water heaters need electricity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Gas tankless heaters use electricity for their controls, electronic ignition, combustion fan and freeze protection, usually from a standard 120-volt outlet. Without power, they cannot make hot water, so a gas tankless heater will not work in a power outage unless it has a backup power source."
          }
        },
        {
          "@type": "Question",
          "name": "Are tankless water heaters gas or electric?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both types exist. Gas tankless heaters, running on natural gas or propane, deliver more hot water and are the usual choice for whole-house use, especially in cold climates. Electric tankless heaters suit smaller loads, point-of-use installs and homes without gas, but whole-house electric units need very large electrical service."
          }
        },
        {
          "@type": "Question",
          "name": "What size gas tankless water heater do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add up the flow of fixtures you use at once, then check each heater's flow at your temperature rise. Two showers and a dishwasher need about 5 to 6 GPM. In cold climates with a 70°F rise, that usually means a 199,000 BTU unit; in warm climates, 140,000 to 160,000 BTU is often enough."
          }
        },
        {
          "@type": "Question",
          "name": "Are gas tankless water heaters worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For households that run out of hot water, plan to stay for many years and have a gas supply that can support one, they usually are. They provide endless hot water, use less standby energy and last longer than tanks. The catch is higher installation cost, especially when a gas line upgrade or new venting is needed."
          }
        },
        {
          "@type": "Question",
          "name": "How long do gas tankless water heaters last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gas tankless heaters generally last longer than tank heaters when they are descaled regularly. Rinnai and Rheem list 15-year warranties on the heat exchanger for the models here, which reflects their expected life. Hard water without descaling is the main thing that shortens it."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a gas tankless water heater myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every maker here recommends professional installation, and Rinnai says it does not recommend installing without a technician. The job involves gas line sizing, venting and combustion safety, usually needs a permit, and DIY installation can affect the warranty. Hire a licensed installer."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "gas tankless water heater",
      "best gas tankless water heater",
      "tankless gas water heater",
      "natural gas tankless water heater",
      "on demand gas water heater",
      "do gas tankless water heaters need electricity",
      "condensing gas tankless water heater"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Gas Tankless</span> Water Heaters
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Endless hot water, as long as it is sized right. Seven natural gas tankless heaters on Amazon, chosen by flow at your temperature rise, efficiency and what the installation needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#rinnai-rx160in"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Size It First
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-it-works" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Gas Tankless Works</a>
          <a href="#condensing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Condensing vs Non-Condensing</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Gas Tankless Water Heaters</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Size Do You Need?</a>
          <a href="#installation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Gas Line, Venting and Power</a>
          <a href="#costs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cost and Savings</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Descaling and Care</a>
          <a href="#vs-tank" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Tankless vs Tank</a>
          <a href="#indoor-outdoor" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Indoor vs Outdoor</a>
          <a href="#hot-water-wait" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. The Wait for Hot Water</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A gas tankless water heater makes hot water on demand instead of keeping a tank hot. The right one depends on how much hot water you use at once, how cold your groundwater is, and what your gas line and venting can support. This guide explains all three, then ranks seven real models.
