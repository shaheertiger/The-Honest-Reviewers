        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#inslx-tough-shield" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">See Our #1 Pick</a>
          <a href="#how-to-paint" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Application Guide</a>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
