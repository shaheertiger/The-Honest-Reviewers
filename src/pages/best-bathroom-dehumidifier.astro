const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Bathroom Dehumidifiers",
          item: "https://www.thehonestreviewers.com/best-bathroom-dehumidifier/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do I need a dehumidifier in my bathroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not, if the bathroom has a working, properly sized exhaust fan that you run during and after showers. A dehumidifier makes sense when there is no fan, the fan cannot easily be fixed, or the room stays damp for hours afterward. A hygrometer will show you whether humidity drops back below 60 percent within an hour or so."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to use a dehumidifier in a bathroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with precautions. Plug it directly into a GFCI-protected outlet, never an extension cord, and keep it away from the tub and shower where it could be splashed. Set it on a dry floor and route the cord and drain hose along the wall. Unplug it before emptying or cleaning, and always handle it with dry hands."
          }
        },
        {
          "@type": "Question",
          "name": "What size dehumidifier do I need for a bathroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a full bathroom with a shower or tub, a compact compressor model rated around 20 to 22 pints a day under the 2019 DOE test is plenty. Small Peltier units rated in ounces per day are only suitable for powder rooms or closets. A 35 or 50 pint unit is oversized unless you are drying a whole damp basement suite."
          }
        },
        {
          "@type": "Question",
          "name": "Do small bathroom dehumidifiers actually work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small thermoelectric units do remove some water, but very little. Pro Breeze rates the PB-02 at about 9 ounces a day at 86 degrees and 80 percent humidity, and RTINGS describes such units as suited only to very small spaces. They help with mild, constant dampness in a tiny room, not with the steam from a daily shower."
          }
        },
        {
          "@type": "Question",
          "name": "Can I drain a dehumidifier into the bathtub?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is one of the best things about using one in a bathroom. Most compact compressor units have a continuous-drain port; run the hose to the tub or shower drain. Without a pump, drainage is by gravity, so the outlet must sit above the drain with no upward loops. Keep the unit itself out of the splash zone."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should a bathroom be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA recommends keeping indoor humidity below 60 percent, ideally 30 to 50 percent. A bathroom will spike near 100 percent during a shower, which is normal; the aim is to bring it back under 60 percent quickly. Setting a dehumidifier to about 50 percent and running the exhaust fan for 20 minutes or so after showering usually achieves that."
          }
        },
        {
          "@type": "Question",
          "name": "Will a dehumidifier get rid of bathroom mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It helps prevent new mold by keeping humidity in check, but existing mold needs cleaning, and stained caulk usually needs replacing. Recurring mold in the same spot can mean a hidden leak or a cold exterior wall. The EPA suggests calling a professional for mold larger than about 10 square feet or inside walls."
          }
        }
