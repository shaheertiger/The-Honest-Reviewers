const title = "Best Bathroom Dehumidifiers: 5 Picks, and When a Fan Is Better";
const description =
  "Five dehumidifiers for bathrooms, from tiny Peltier units to 22-pint compressor models, plus why an exhaust fan comes first and how to run one safely by water.";

const PRODUCTS = [
