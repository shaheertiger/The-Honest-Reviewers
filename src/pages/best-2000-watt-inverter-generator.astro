];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best 2000 Watt Inverter Generators in 2026: What 1,800 Running Watts Will Run";
const description =
  "The best 2,000 to 2,500-watt inverter generators, from Honda, Champion, WEN, Westinghouse, Generac and Yamaha, with what they run and how to parallel two.";

const PRODUCTS = [
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i EU2200ITAN 2200-Watt Inverter Generator",
    "category": "Compact Inverter, 2,200W Peak / 1,800W Running",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Honda rates it at 48 dB(A) at quarter load and 57 dB(A) at rated load, the quietest figures in this class",
      "GXR120 commercial-series engine with a long record among campers and contractors",
      "About 47 lb dry, light enough for one-hand carrying",
      "Parallel capable with a second EU2200i or another compatible Honda",
      "Strong resale value and a nationwide dealer network"
