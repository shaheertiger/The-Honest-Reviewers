  },
  {
    "id": "champion-201323-dual-fuel",
    "name": "Champion Power Equipment 201323 2500-Watt Dual Fuel Portable Inverter Generator with CO Shield",
    "category": "Dual Fuel Inverter, 2,500W Starting / 1,850W Running",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
