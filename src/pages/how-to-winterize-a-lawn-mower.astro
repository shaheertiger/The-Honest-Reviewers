---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How Often to Sharpen Mower Blades", url: "/how-often-to-sharpen-mower-blades/" },
    { title: "Best Gas Lawn Mowers", url: "/best-gas-lawn-mowers/" },
    { title: "Best Self-Propelled Lawn Mowers", url: "/best-self-propelled-lawn-mower/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "How to Winterize a Lawn Mower (Gas and Battery)";
const description =
  "Fuel is what kills stored mowers, not cold. The full end-of-season routine for gas and battery machines, in the order that matters, in about an hour.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "How to Winterize a Lawn Mower", item: "https://www.thehonestreviewers.com/how-to-winterize-a-lawn-mower/" },
      ],
    },
    {
      "@type": "HowTo",
      name: "How to winterize a gas lawn mower",
      totalTime: "PT1H",
      step: [
        { "@type": "HowToStep", name: "Deal with the fuel", text: "Either run the tank dry or fill it and add stabilizer, then run the engine five minutes to draw treated fuel through the carburettor. Do one or the other, never neither." },
        { "@type": "HowToStep", name: "Change the oil", text: "Drain the oil warm and refill with fresh. Used oil holds combustion acids that pit bearings over a long, cold sit." },
        { "@type": "HowToStep", name: "Clean the deck", text: "Scrape packed grass from the underside of the deck so trapped moisture cannot rust it through over winter." },
        { "@type": "HowToStep", name: "Service the plug and filter", text: "Fit a new spark plug or clean and re-gap the old one, and clean or replace the air filter." },
        { "@type": "HowToStep", name: "Sharpen and balance the blade", text: "Sharpen now so the mower is ready in spring rather than sitting in a queue at the shop in April." },
        { "@type": "HowToStep", name: "Store it dry", text: "Keep the mower off a damp concrete floor, covered but not sealed in plastic, in an unheated garage or shed." },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Should you drain the gas from a lawn mower for winter?",
          acceptedAnswer: { "@type": "Answer", text: "Either drain it completely or fill the tank and treat it with stabilizer. Both work. What destroys carburettors is the middle option — leaving a half tank of untreated pump gas to separate and varnish over five months. If you drain, run the engine until it stalls so the carburettor bowl empties too, because fuel left in the bowl is what actually gums up the jets." },
        },
        {
          "@type": "Question",
          name: "How long does gas last in a lawn mower?",
          acceptedAnswer: { "@type": "Answer", text: "Untreated pump gasoline starts degrading in about 30 days and is unreliable beyond 60. Ethanol blends absorb water from the air and can phase-separate, leaving a corrosive water and ethanol layer sitting on the bottom of the tank and in the carburettor bowl. Stabilizer extends usable life to roughly a year, and ethanol-free fuel longer still." },
        },
        {
          "@type": "Question",
          name: "Do you need to change the oil before storing a mower?",
          acceptedAnswer: { "@type": "Answer", text: "Yes, and doing it in autumn rather than spring is the better habit. Used oil carries acidic combustion by-products and moisture that quietly attack bearing surfaces while the engine sits. Draining it warm gets more of that contamination out, and the mower is then ready to run in spring rather than needing service first." },
        },
        {
          "@type": "Question",
          name: "How do you winterize a battery lawn mower?",
          acceptedAnswer: { "@type": "Answer", text: "Remove the battery pack and store it indoors at roughly 40 to 60 percent charge, at room temperature, never on a freezing concrete floor. Lithium packs lose capacity permanently when stored full or completely flat, and cold storage at a full charge is the harshest combination. Clean the deck and sharpen the blade exactly as you would on a gas mower." },
        },
        {
          "@type": "Question",
          name: "Can you leave a lawn mower outside over winter?",
          acceptedAnswer: { "@type": "Answer", text: "It will survive, but it will age several years in one season. The damage is moisture rather than cold: condensation inside the tank and cylinder, rust on the deck and blade, and water in the cables. An unheated shed or garage is fine and is all that most machines need. If it must live outdoors, get it off the ground and use a breathable cover, not a sealed tarp." },
        },
        {
          "@type": "Question",
          name: "Should you remove the spark plug when storing a mower?",
          acceptedAnswer: { "@type": "Answer", text: "It is worth doing on a machine going into long storage. Pull the plug, squirt a teaspoon of clean engine oil into the cylinder, pull the starter cord slowly two or three times to coat the bore, then fit the plug. That oil film prevents the cylinder wall rusting from condensation, which is the failure that turns a stored engine into a seized one." },
        },
        {
          "@type": "Question",
          name: "Is it better to sharpen mower blades in autumn or spring?",
          acceptedAnswer: { "@type": "Answer", text: "Autumn, for practical reasons rather than mechanical ones. The blade takes its worst beating in late-season mowing over acorns and hidden debris, and a sharp blade stored is a mower that starts the season ready. Every small-engine shop in the country is backed up three weeks in April, and that is the queue you avoid." },
        },
        {
          "@type": "Question",
          name: "Do you need to winterize a mower in a mild climate?",
          acceptedAnswer: { "@type": "Answer", text: "If the mower will sit unused for more than about two months, yes — the fuel and oil steps matter regardless of temperature, because gasoline degradation is a chemical clock rather than a cold-weather event. In a climate where you mow year-round on a reduced schedule, run the machine monthly and treat the fuel, and you can skip the full routine." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
