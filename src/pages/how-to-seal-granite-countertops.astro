---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "The Best Granite Sealers",
    "url": "/best-granite-sealer/"
  },
  {
    "title": "How to Tell If Granite Needs Sealing",
    "url": "/how-to-tell-if-granite-needs-sealing/"
  },
  {
    "title": "Impregnating vs Topical Stone Sealer",
    "url": "/impregnating-vs-topical-stone-sealer/"
  },
  {
    "title": "Best Natural Stone Sealer",
    "url": "/best-natural-stone-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-15", modified: "2026-09-15" });
const title = "How to Seal Granite Countertops: The Two-Coat Method";
const description =
  "Sealing granite countertops properly: prep, dwell time, the second coat, and the buff that decides whether you end up with protection or a hazy film.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Seal Granite Countertops",
          item: "https://www.thehonestreviewers.com/how-to-seal-granite-countertops/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How do you seal granite countertops step by step?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean with a stone-safe cleaner and let the surface dry for several hours. Apply impregnating sealer generously to a two to three square foot section, keep it visibly wet for the label's dwell time of five to fifteen minutes, then buff the section completely dry. Repeat across the countertop, apply a second coat after 30 to 120 minutes, and keep the surface dry for 24 hours."
          }
        },
        {
          "@type": "Question",
          "name": "How long does granite sealer need to sit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Five to fifteen minutes per coat, depending on the product. That dwell is when the carrier transports the repellent into the pore structure, so it is the part of the job that matters most. Top up any section that dries early rather than letting it flash off."
          }
        },
        {
          "@type": "Question",
          "name": "Do you wipe off granite sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and thoroughly. Anything that has not soaked in by the end of the dwell must be buffed off with a clean dry cloth, then checked again ten minutes later for product that has wicked back to the surface. Sealer left to dry on top is the hazy film people blame on the product."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of granite sealer should I apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two is standard. The first coat takes most of the product because it is going into open pores; the second uses roughly half to two thirds as much. On unusually absorbent stone that drinks the second coat as fast as the first, a third is justified."
          }
        },
        {
          "@type": "Question",
          "name": "How long before I can use the countertop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The surface is dry to the touch within an hour, but keep it free of water for 24 hours and avoid heavy or absorbent items for the same period. Full chemical cure takes 48 to 72 hours with most impregnators, and the sealer is not at full strength until then."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my granite look cloudy after sealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sealer dried on the surface instead of being buffed off. With a solvent-based product, apply a little more sealer to the hazy area, let it soften the residue for a minute, and buff hard with a dry cloth. Water-based residue usually clears with warm water, a stone cleaner and firm buffing."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal granite myself or should I hire someone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a straightforward DIY job on a normal kitchen — the skill is in the dwell and the buff, not in anything requiring tools. Professional sealing makes sense for very large installations, for colour-enhancing products where a mistake is permanent, or where stains need drawing out first."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

