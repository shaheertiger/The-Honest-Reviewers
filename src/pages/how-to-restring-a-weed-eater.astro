const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Restring a Weed Eater",
          item: "https://www.thehonestreviewers.com/how-to-restring-a-weed-eater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much line do I put on a weed eater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the length your owner manual specifies, which for most dual-line residential heads falls somewhere between about 10 and 20 feet in total. Ryobi calls for 16 feet in its Reel Easy head, for example. If you do not have the manual, start with around 10 feet and add more next time if there is clear room on the spool."
          }
        },
        {
          "@type": "Question",
          "name": "Which way do you wind weed eater string?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow the arrow molded into the spool or printed on the head. The correct direction is set by which way the head spins, and it differs between models, so there is no universal clockwise or counterclockwise rule. Wound the wrong way, the line will not feed when you bump. Wind tightly and keep each line in its own channel."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use .095 line in a trimmer made for .080?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the head lists .095 as acceptable. Many heads accept a range, such as Ryobi Reel Easy at .080 to .105 inch. If the maximum is .080, thicker line will load the motor, reduce cutting speed and battery runtime, and tend to jam and weld in the spool. Check the head or manual before sizing up."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my weed eater line keep breaking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The usual causes are old, dried-out line, worn and sharp eyelets, line that is too thin for the growth, and technique, especially holding the head against fences, walls or concrete. Replace damaged eyelets, try fresh or soaked line, cut with the tip rather than burying the head, and approach hard edges at an angle."
          }
        },
        {
          "@type": "Question",
          "name": "Why will my trimmer line not come out when I bump it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check that it was wound in the direction of the arrow, that several inches of line extend from each eyelet, and that the spring is present. Welded line on the spool and a worn bump knob also stop feeding. Always bump at full speed on soil or grass, because the head needs centrifugal force to pull the line out."
          }
        },
        {
          "@type": "Question",
          "name": "Should I soak trimmer line in water before using it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It helps old line that has dried out. Nylon absorbs moisture, which makes it more flexible and less likely to snap, and the official Stihl New Zealand store recommends soaking new line for at least 24 hours before loading. Fresh line from a sealed package benefits less. Soak overnight in a bucket, dry it off, then wind it as usual."
          }
        },
        {
          "@type": "Question",
          "name": "Is round, twisted or square trimmer line better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Round line is the most durable and the best choice for trimming along concrete, fences and edges. Twisted line cuts with less noise and drag. Square and multi-sided line cuts thick weeds more cleanly but wears faster against hard surfaces. For most homeowners, round or twisted line in the correct diameter is the right choice."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
