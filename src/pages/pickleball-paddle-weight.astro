                    <td class="px-4 py-4 font-black text-gray-900">Midweight</td>
                    <td class="px-4 py-4 text-gray-700">About 7.6 to 8.2 oz</td>
                    <td class="px-4 py-4 text-gray-700">Balance of power, control and speed</td>
                    <td class="px-4 py-4 text-gray-700">No standout strength</td>
                    <td class="px-4 py-4 text-gray-700">Most recreational and improving players</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Heavyweight</td>
                    <td class="px-4 py-4 text-gray-700">About 8.3 oz and up</td>
                    <td class="px-4 py-4 text-gray-700">Power, stability, deep drives</td>
                    <td class="px-4 py-4 text-gray-700">Slower, more tiring, harder on some shoulders</td>
