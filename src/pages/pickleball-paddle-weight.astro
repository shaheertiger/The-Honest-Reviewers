                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical weight</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Strengths</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Trade-offs</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Suits</th>
                  </tr>
                </thead>
