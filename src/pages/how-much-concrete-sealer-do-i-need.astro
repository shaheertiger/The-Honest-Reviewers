      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Much Concrete Sealer Do I Need",
          item: "https://www.thehonestreviewers.com/how-much-concrete-sealer-do-i-need/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much concrete sealer do I need for a two-car driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A typical two-car driveway is 20 by 30 feet, or 600 square feet. With a penetrating silane-siloxane at around 150 square feet per gallon, that is four gallons for one saturating coat, so a five-gallon pail. With a water-based acrylic in two coats it works out at roughly 4.2 gallons, which is also a pail. In both cases the pail is the right buy."
          }
        },
        {
          "@type": "Question",
          "name": "Is one gallon of concrete sealer enough for a patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a small patio, often yes. One gallon of water-based acrylic covers about 250 square feet on a first coat and 350 on a second, so it will just about do a 10 by 12 patio in two coats. A stamped or textured patio of the same size will need closer to two gallons because the profile holds far more product."
          }
        },
        {
          "@type": "Question",
          "name": "Does concrete sealer coverage change on old concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Significantly. Weathered concrete has lost the fine paste at the surface, leaving the pore structure open, so it absorbs more sealer than a newer slab of the same size. Budget roughly a third more product for a driveway that has gone ten years or more unsealed, and do a water-drop test on a clean patch to confirm before you order."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy extra concrete sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy 10 to 15 percent more than your calculation. Rounding up to the next container usually supplies that automatically. The real reason is batch consistency: finishing a job from a container bought later can leave a visible line, especially with tinted or gloss acrylics."
          }
        },
        {
          "@type": "Question",
          "name": "How many square feet does a 5 gallon bucket of concrete sealer cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Between roughly 750 and 2,000 square feet depending on the product and the slab. A penetrating sealer on open concrete lands near 750; a water-based acrylic on a smooth surface can reach the top of that range on a first coat. Use the label's range, and plan at its lower number for exterior flatwork."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use leftover sealer next season?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it was sealed properly and never froze. Water-based sealers are ruined by freezing, solvent-based ones tolerate cold but not heat. Stir thoroughly, and if the product has separated into layers that will not recombine, do not use it on a visible surface."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need more sealer for a stamped concrete patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Stamped and textured surfaces have far more actual surface area than their footprint suggests, and sealer pools in the low points. Plan at roughly 70 percent of the coverage you would use on a flat slab of the same square footage, and expect the first coat to take the bulk of it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
