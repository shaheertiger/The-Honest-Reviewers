const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ideal Indoor Humidity",
          item: "https://www.thehonestreviewers.com/ideal-indoor-humidity/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the ideal indoor humidity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA recommends keeping indoor relative humidity below 60 percent and ideally between 30 and 50 percent. In practice that means 40 to 50 percent in summer, controlled with air conditioning or a dehumidifier, and 30 to 45 percent in winter, with the lower end used on the coldest days to keep windows and walls from condensing."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should my house be in winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start around 40 percent and adjust for outdoor temperature. Common guidance is about 40 percent when it is 20 to 40 degrees outside, 35 percent at 10 to 20 degrees, 30 percent near zero and 25 percent or lower below zero. If water collects on the inside of your windows, lower the setting until the glass stays clear."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best humidity for sleeping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most people sleep comfortably in the 40 to 50 percent range, and keeping a bedroom at or below about 50 percent is commonly recommended for people sensitive to dust mites. In winter the low to mid 40s is a sensible bedroom target. Use a humidifier with a humidistat so a closed room does not climb past it overnight."
          }
        },
        {
          "@type": "Question",
          "name": "Is 30 percent humidity too low?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thirty percent is at the bottom of the EPA's ideal range, so it is acceptable, and on very cold days it may be the highest your windows can handle without condensation. Many people find it slightly dry for comfort. If the windows stay clear at 30 percent, you can usually raise it toward 35 to 40 percent without problems."
          }
        },
        {
          "@type": "Question",
          "name": "Is 60 percent humidity too high indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 60 percent is the upper limit the EPA recommends staying below. At that level and above, dust mites and mold grow more readily, and in winter you will almost certainly see condensation on windows. If your home sits at 60 percent or higher, turn off any humidifier and look at ventilation or a dehumidifier."
          }
        },
        {
          "@type": "Question",
          "name": "How do I check if my hygrometer is accurate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the salt test. Mix a few tablespoons of table salt with just enough water to form a damp paste, seal it in a zip-top bag with the hygrometer, and leave it 8 to 12 hours at a steady temperature. The air in the bag settles near 75 percent, so the difference between that and your reading is the meter's error."
          }
        },
        {
          "@type": "Question",
          "name": "What should I set my humidifier to?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Set it to the low to mid 40s for most rooms in mild winter weather, and lower toward 30 to 35 percent when outdoor temperatures drop near or below zero. Avoid running it on continuous high. Confirm with a separate hygrometer, because the humidifier's built-in sensor often reads the moist air right beside the outlet."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
