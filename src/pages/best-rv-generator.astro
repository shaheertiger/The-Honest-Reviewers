const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best RV Generators",
          item: "https://www.thehonestreviewers.com/best-rv-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size generator do I need for a 30 amp RV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most 30-amp trailers are well served by a generator with about 3,000 to 3,700 running watts and a TT-30R outlet, which can start and run one 13,500 BTU air conditioner plus the fridge and lights. A generator around 2,000 to 2,800 rated watts can work if the air conditioner has a soft-start device."
