                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Plug</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Max power</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Generator to look for</th>
                  </tr>
                </thead>
                <tbody>
