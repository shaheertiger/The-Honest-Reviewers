const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best RV Generators for 30-Amp and 50-Amp Campers";
const description =
  "The best RV generators for 30-amp and 50-amp rigs, compared on running watts, RV outlet, rated noise and fuel, with the air conditioner and campground math.";

const PRODUCTS = [
