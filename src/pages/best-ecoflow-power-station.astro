---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Jackery vs EcoFlow",
    "url": "/jackery-vs-ecoflow/"
  },
  {
    "title": "Bluetti vs EcoFlow",
    "url": "/bluetti-vs-ecoflow/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How Long Do Portable Power Stations Last?",
    "url": "/how-long-do-portable-power-stations-last/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator?",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  },
  {
    "title": "Are Portable Power Stations Worth It?",
    "url": "/are-portable-power-stations-worth-it/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best EcoFlow Power Stations in 2026: Every Model Ranked";
const description =
  "We ranked EcoFlow's current RIVER, DELTA and DELTA Pro power stations by capacity, charging, solar input and value, plus which older models are worth buying on sale.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow DELTA 3 Plus",
    "category": "1,024Wh LiFePO4 / 1,800W, Expandable",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh LiFePO4 battery rated for thousands of cycles before it drops to 80% capacity",
      "1,800W continuous AC output with a 3,600W surge rating covers fridges, microwaves and most power tools",
      "Fast AC recharge, roughly an hour from empty on wall power",
      "Two solar inputs let you hang two panel strings off one unit",
      "Expandable with EcoFlow extra batteries if your needs grow"
    ],
    "cons": [
      "About 27 pounds, so it is a carry-to-the-car unit, not a hiking unit",
      "Costs noticeably more than the DELTA 3 Classic for features some buyers never use"
    ],
    "bottomLine": "The EcoFlow most people should buy: enough capacity for a fridge through a short outage, fast charging, and a path to more storage later.",
    "description": "The DELTA 3 Plus is the model we would hand to a buyer who says 'I want one EcoFlow and I do not want to think about it again.' It pairs a 1,024Wh lithium iron phosphate (LiFePO4) battery with an 1,800W inverter rated for 3,600W surge, which is enough to start a full-size refrigerator, run a 1,000W microwave, or keep a CPAP, router and phone chargers going overnight with plenty in reserve. The LFP chemistry matters: it is the same chemistry EcoFlow uses across its current lineup, and it is rated for thousands of full cycles, which means a decade of weekend camping and storm-season use is realistic. Wall charging is the headline feature. EcoFlow rates the DELTA 3 Plus to go from empty to full in about an hour on AC, so a unit drained during an evening outage is back to full before breakfast once the grid returns. It also has two solar inputs, each rated around 500W, so you can run two separate panel strings into it. Where it pulls ahead of the cheaper DELTA 3 Classic is expandability: the Plus accepts EcoFlow's DELTA 3 series extra batteries, which takes it into multi-kilowatt-hour territory without replacing the unit. EcoFlow also rates its UPS-style switchover at 10 milliseconds, quick enough for most desktop computers and network gear. At about 27 pounds it is portable in the 'carry it to the truck' sense, not in the 'carry it a mile' sense. If you know you will never expand and never pair it with large solar, the Classic saves money. Everyone else should start here."
  },
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow DELTA Pro 3",
    "category": "4,096Wh LiFePO4 / 4,000W, 120/240V",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "pros": [
      "4,096Wh LiFePO4 battery in one wheeled chassis",
      "4,000W continuous AC output with native 120/240V for well pumps and 240V circuits",
      "Up to 2,600W of solar input across high- and low-voltage ports",
      "Expands to roughly 12kWh with extra batteries",
      "Integrates with EcoFlow's Smart Home Panel 2 for whole-circuit backup"
    ],
    "cons": [
      "About 113 pounds: it rolls, but it does not lift easily",
      "Expensive, and only worth it if you will actually wire it into the house"
    ],
    "bottomLine": "The serious home-backup EcoFlow: 240V output, 4kWh in one box and real expansion, at a price that only makes sense if it gets wired in.",
    "description": "The DELTA Pro 3 is the replacement for the original DELTA Pro and the model to buy if your goal is keeping a house running rather than a campsite. It carries 4,096Wh of LiFePO4 storage and a 4,000W inverter, and unlike the DELTA and RIVER lines it can deliver 240V natively, which opens up well pumps, some HVAC circuits and other 240V loads that 120V-only stations cannot touch. Solar input is a real strength: EcoFlow rates it for up to 2,600W combined, split between a 1,600W high-voltage port and a 1,000W low-voltage port, so a modest rooftop-style array or a big portable setup can refill a meaningful share of the battery in a sunny day. Capacity scales to about 12kWh with extra batteries, and the unit works with EcoFlow's Smart Home Panel 2 so selected household circuits switch over automatically. The tradeoff is weight. At roughly 113 pounds, the DELTA Pro 3 has wheels and a telescoping handle for a reason; you will roll it across the garage, not carry it up stairs. It also carries an IP65 rating, which is unusual for this category. Price is the other honest caveat. Bought as a portable power station that sits in a closet and occasionally runs a fridge, it is overkill, and a DELTA 3 Plus with an extra battery does the same job for much less. Bought as the core of a wired backup system with a transfer panel and solar, it is one of the most capable all-in-one batteries you can buy without a permanent installation."
  },
  {
    "id": "ecoflow-delta-3-classic",
    "name": "EcoFlow DELTA 3 Classic",
    "category": "1,024Wh LiFePO4 / 1,800W, Non-Expandable",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Same 1,024Wh capacity and 1,800W output class as the DELTA 3 Plus",
      "LiFePO4 chemistry with a long rated cycle life",
      "500W solar input is plenty for one or two portable panels",
      "Usually the cheapest way into a 1kWh EcoFlow",
      "Simple: no expansion ecosystem to figure out"
    ],
    "cons": [
      "EcoFlow does not list extra-battery support, so the capacity you buy is the capacity you keep",
      "Single solar input limits larger panel setups"
    ],
    "bottomLine": "If you need about 1kWh and will never expand, this is the DELTA 3 Plus experience for less money.",
    "description": "The DELTA 3 Classic is EcoFlow's answer to buyers who looked at the DELTA 3 Plus and asked which features they could do without. It keeps the parts that matter for most people: a 1,024Wh LiFePO4 battery, an 1,800W inverter with a 3,600W surge rating, and enough outlets to run a refrigerator, a CPAP and a few chargers at once. Solar input is a single port rated up to 500W, which is a good match for one or two 200W to 220W folding panels, the kind most campers and storm-preppers actually own. What it drops is the expansion path. EcoFlow does not list the Classic as compatible with its DELTA 3 extra batteries, so treat the 1,024Wh as fixed. For a lot of buyers that is fine: a 1kWh station is the most popular size for a reason, and plenty of owners never add a second battery to the unit they already have. It weighs in the mid-20-pound range, about the same as the Plus. The math on runtime is identical too. At roughly 85% usable capacity, a fridge averaging 120W runs about seven hours, and a 40W CPAP runs about 20 hours. If your plan is weekend camping, a short-outage fridge backup, or a jobsite battery for corded tools, the Classic does the job and the price difference can go toward a solar panel. If there is any chance you will want 2kWh or more in a year, pay for the Plus now rather than buying twice."
  },
  {
    "id": "ecoflow-delta-2-max",
    "name": "EcoFlow DELTA 2 Max",
    "category": "2,048Wh LiFePO4 / 2,400W, Expandable",
    "badge": "Best 2kWh Pick",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh LiFePO4 battery doubles the DELTA 3's capacity",
      "2,400W continuous output handles space heaters and larger tools",
      "Up to 1,000W of solar input via two ports",
      "Expands to about 6kWh with extra batteries",
      "Frequently discounted now that newer DELTA 3 Max models exist"
    ],
    "cons": [
      "About 50 pounds, so moving it is a two-hand job",
      "Older app and charging generation than the DELTA 3 series"
    ],
    "bottomLine": "The cheapest sensible way to get 2kWh from EcoFlow, especially on sale. Worth buying over a DELTA 3 Max Plus if the price gap is large.",
    "description": "The DELTA 2 Max is a generation older than the DELTA 3 models above it, and that is exactly why it earns a spot: it is the most common way to buy 2kWh of EcoFlow storage at a sensible price. The specs still hold up. You get a 2,048Wh LiFePO4 battery, a 2,400W inverter rated for 4,800W surge, and up to 1,000W of solar input through two ports. That is enough inverter to run a 1,500W space heater or a circular saw, and enough battery to carry a typical refrigerator for roughly 14 hours at a 120W average draw once you account for about 85% usable capacity. Add EcoFlow's extra batteries and it expands to about 6kWh, which puts it into real multi-day outage territory. EcoFlow has since released the DELTA 3 Max line in the same capacity class, with newer charging hardware and app integration. If those are close in price, buy the newer model. But the DELTA 2 Max is frequently discounted, and when the gap is a few hundred dollars the older unit is the better value for most buyers, because the battery, inverter and solar specs are what decide whether your fridge stays cold. The main downside is weight: at around 50 pounds it has handles, not wheels, and you will want to pick a permanent spot for it. Owners commonly report that it handles daily solar cycling well, which makes it a strong pick for a cabin, van build or small off-grid setup on a budget."
  },
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow RIVER 3 Plus",
    "category": "286Wh LiFePO4 / 600W, Expandable",
    "badge": "Best Portable",
    "amazonUrl": "#",
    "pros": [
      "Just over 10 pounds, easy to carry one-handed",
      "600W output, with X-Boost for resistive loads up to about 1,200W",
      "220W solar input pairs well with a single folding panel",
      "Expands to about 858Wh with a clip-on extra battery",
      "Fast UPS switchover for routers and modems"
    ],
    "cons": [
      "286Wh on its own will not carry a fridge through the night",
      "X-Boost runs heating loads at reduced power rather than full wattage"
    ],
    "bottomLine": "The best carry-anywhere EcoFlow, with an expansion option that most small stations lack.",
    "description": "The RIVER 3 Plus is the EcoFlow we would take camping, tailgating or into a home office as a battery backup for the router. It carries 286Wh of LiFePO4 storage and a 600W inverter, weighs a little over 10 pounds, and is small enough to sit on a desk or in a footwell. That capacity is honest small-station territory. It will recharge a laptop five or six times, run a 40W CPAP without a humidifier for about six hours, or keep a 15W router and modem online for well over a dozen hours. It will not run a refrigerator overnight, and you should not buy it expecting that. Two features lift it above a basic small station. First, X-Boost lets it run resistive loads such as a kettle or hair dryer up to about 1,200W by lowering voltage, which works but means the appliance runs below full power. Second, and more useful, it can expand: EcoFlow sells clip-on extra batteries that take the system to roughly 858Wh, which puts it in the range where a small fridge or a full night of CPAP with humidifier becomes realistic. Solar input is rated at 220W, a good match for one 200W to 220W folding panel. EcoFlow rates the UPS switchover at under 10 milliseconds, quick enough to keep most networking gear online through a blip. If you want something genuinely portable that can still grow, the RIVER 3 Plus is the pick. If you only need phone and laptop charging, the cheaper RIVER 3 is enough."
  },
  {
    "id": "ecoflow-delta-pro-ultra",
    "name": "EcoFlow DELTA Pro Ultra",
    "category": "6,144Wh per Battery / 7,200W, Whole-Home Scale",
    "badge": "Best Whole-Home System",
    "amazonUrl": "#",
    "pros": [
      "7,200W inverter output handles central-air-sized loads",
      "6,144Wh per battery module, stackable for much larger systems",
      "Up to 5,600W of solar input across two inputs",
      "Pairs with the Smart Home Panel 2 for automatic whole-circuit switchover",
      "Battery-based, so it runs indoors with no fumes or fuel"
    ],
    "cons": [
      "Inverter plus one battery weighs roughly 180 pounds",
      "Priced like a home battery system, because that is what it is"
    ],
    "bottomLine": "The EcoFlow that competes with installed home batteries. Only buy it if you are backing up most of a house.",
    "description": "The DELTA Pro Ultra stretches the word 'portable' past its limit. It is a modular system made of an inverter unit and stackable battery modules, each holding 6,144Wh, with a 7,200W inverter that can deliver 120/240V. In practical terms, that is enough to run a central air conditioner's compressor, a well pump and the kitchen at once, and enough storage that a single battery covers a typical refrigerator, lights, internet and a furnace blower for a day or more. Batteries stack, and multiple inverters can be combined, which lets the system scale into the tens of kilowatt-hours for buyers who want something close to an installed home battery without a permanent wall-mounted install. Solar input is rated at up to 5,600W across two inputs, enough for a real array rather than a couple of folding panels. The intended setup pairs it with EcoFlow's Smart Home Panel 2, which handles automatic switchover on the circuits you choose. The downsides are exactly what you would expect. The inverter and one battery together weigh about 180 pounds, so it rolls on casters but lives in one place, usually a garage or utility room. And it is priced like a home battery system. If you are comparing it against a single DELTA Pro 3, ask whether you truly need more than 4kWh and 4,000W. If you do, and you want battery-only backup with no fuel or fumes, the DELTA Pro Ultra is EcoFlow's best answer. For most homes, the DELTA Pro 3 is enough."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow RIVER 3",
    "category": "245Wh LiFePO4 / 300W, Ultra-Compact",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "About 7.8 pounds, the lightest EcoFlow worth buying",
      "LiFePO4 battery in a small, inexpensive package",
      "110W solar input for a single small panel",
      "Quiet enough for a tent or bedside table",
      "Often the cheapest EcoFlow on sale"
    ],
    "cons": [
      "300W output rules out anything with a heating element",
      "Not expandable, so 245Wh is all you get"
    ],
    "bottomLine": "A cheap, light power bank for phones, laptops, lights and small fans. Do not buy it for outages beyond a router and some charging.",
    "description": "The RIVER 3 is the smallest EcoFlow we would recommend and the best choice for buyers who mostly need to charge things rather than run things. It holds 245Wh of LiFePO4 storage behind a 300W inverter and weighs about 7.8 pounds, light enough to toss in a backpack or keep on a nightstand. In real terms, that is around four laptop recharges, dozens of phone charges, or a full night for a small fan and string lights at a campsite. It will run a 15W router and modem for most of a workday during an outage, and it can handle a CPAP without humidifier for a few hours. What it cannot do is anything with heat. Coffee makers, hair dryers, microwaves and space heaters are all well beyond a 300W inverter, and X-Boost only helps with gentle resistive loads at reduced power. It also does not expand, so if you think you will want more capacity later, the RIVER 3 Plus is the smarter buy. Solar input is rated at 110W, which pairs with a single 100W folding panel and refills the battery in a few hours of decent sun. The RIVER 3 is frequently on sale, and at its typical discount it is one of the cheapest LiFePO4 stations from a major brand. Buy it as a premium power bank for camping, travel and short outages. If you are shopping for real home backup, skip straight to the DELTA line."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best EcoFlow Power Station",
          item: "https://www.thehonestreviewers.com/best-ecoflow-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best EcoFlow power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the DELTA 3 Plus. It has 1,024Wh of LiFePO4 storage, an 1,800W inverter, fast AC charging and the option to add extra batteries later. Choose the DELTA Pro 3 if you want to back up house circuits with 240V output, or the RIVER 3 Plus if you need something you can carry one-handed."
          }
        },
        {
          "@type": "Question",
          "name": "Is EcoFlow a good brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. EcoFlow is one of the largest portable power station brands, its current lineup uses long-life LiFePO4 batteries, and it is known for fast charging and a capable app. The main complaints are price and frequent model changes that make the lineup confusing. Buy current models when you can, and check warranty terms before buying older stock."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the DELTA 3 Plus and DELTA 3 Classic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both have 1,024Wh of capacity and 1,800W output. The DELTA 3 Plus adds expansion with extra batteries, two solar inputs and generally faster charging hardware. The Classic has one 500W solar input and EcoFlow does not list extra-battery support. If you might want more capacity later, buy the Plus; if not, the Classic saves money."
          }
        },
        {
          "@type": "Question",
          "name": "Can an EcoFlow power my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A DELTA Pro Ultra with multiple batteries and the Smart Home Panel 2 can cover most of a typical home, including 240V loads. A DELTA Pro 3 covers a selection of essential circuits. Smaller DELTA and RIVER models cannot power a whole house, but a DELTA can keep a refrigerator, lights and internet running through an overnight outage."
          }
        },
        {
          "@type": "Question",
          "name": "What is an EcoFlow solar generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is an EcoFlow power station sold in a bundle with one or more solar panels. The station stores the energy and the panels recharge it. Bundles can save money, but make sure the panel wattage matches the station's solar input limit. You can also buy the station alone and pair it with compatible third-party panels."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy an older EcoFlow like the DELTA 2 or DELTA Pro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The DELTA 2 is a good buy if it is clearly cheaper than a DELTA 3 Classic, since it uses the same LiFePO4 chemistry. The original DELTA Pro uses NCM cells with a shorter rated cycle life, so only buy it at a steep discount for occasional outage use, not for daily solar cycling."
          }
        },
        {
          "@type": "Question",
          "name": "How long does an EcoFlow battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Current EcoFlow models use LiFePO4 cells rated for thousands of full charge cycles before falling to about 80% of original capacity. For typical backup and camping use, that means many years of service. Storing the station at a partial charge, keeping it out of extreme heat and cycling it every few months all help extend its life."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best ecoflow power station",
      "ecoflow portable power station",
      "ecoflow solar generator",
      "ecoflow power station",
      "ecoflow delta 3 plus",
      "ecoflow delta pro 3",
      "ecoflow delta pro",
      "ecoflow river 2 pro",
      "ecoflow delta 2",
      "ecoflow delta 3 classic",
      "ecoflow river 2",
      "ecoflow river 3 plus",
      "ecoflow delta 2 max",
      "ecoflow river 2 max"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">EcoFlow Power Stations</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          From the 8-pound RIVER 3 to the whole-home DELTA Pro Ultra, we compared every current EcoFlow on capacity, output, charging speed, solar input and real-world value, so you buy the right size the first time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-delta-3-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Reviews
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="21.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 7 EcoFlow Picks Reviewed</a>
          <a href="#model-comparison" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Model Comparison Table</a>
          <a href="#river-vs-delta" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. RIVER vs DELTA vs DELTA Pro</a>
          <a href="#older-models" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Older Models on Sale</a>
