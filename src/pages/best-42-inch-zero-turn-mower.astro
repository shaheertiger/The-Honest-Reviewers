            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Your Lawn</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">42" Zero Turn?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Under 1/2 acre, flat</td>
                    <td class="px-4 py-4 text-gray-700">Usually overkill</td>
                    <td class="px-4 py-4 text-gray-700">A self-propelled mower or small rider costs less</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/2 to 1 acre, obstacles</td>
                    <td class="px-4 py-4 text-gray-700">Yes, best fit</td>
                    <td class="px-4 py-4 text-gray-700">Fits gates and side yards, little trimming</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1 to 2 acres, mixed</td>
