];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best 42 Inch Zero Turn Mowers in 2026: Small Decks That Fit the Gate";
const description =
  "The best 42 inch zero turn mowers for one to two acre lawns with gates and tight storage: overall widths, stamped vs fabricated decks, transaxles and warranties.";

