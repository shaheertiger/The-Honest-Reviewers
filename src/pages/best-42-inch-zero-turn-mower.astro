const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 42 Inch Zero Turn Mower",
          item: "https://www.thehonestreviewers.com/best-42-inch-zero-turn-mower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a 42 inch zero turn mower big enough for 2 acres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be. Toro and John Deere both rate their 42-inch machines to mow up to 2 acres, and at 6.5 to 7 mph a 42-inch zero turn covers ground quickly. On open, simple ground over about 1.5 acres a 48 to 54-inch deck saves real time each week; on a lot with gates and obstacles the 42-inch machine is usually the better fit."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 42 inch zero turn fit through a 48 inch gate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not comfortably. Husqvarna lists the Z242F at 48 inches wide with the chute up and 56 inches with it down, which is typical of the class. Plan on an opening of at least 52 inches with the chute raised, and check the specific machine's overall width before buying."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best small zero turn mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, the Toro TimeCutter 42 (75742): a 22.5 hp V-twin, Hydro-Gear ZT2100 transaxles and Smart Speed for tight lawns, with an unlimited-hour residential warranty. If rough ground is the issue, the fabricated-deck Cub Cadet Ultima Z2 42 or Husqvarna Z242F Special Edition is the better buy."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a 42 inch zero turn last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With seasonal oil changes, greased spindles and sharp blades, owners commonly report 10 or more seasons from a residential 42-inch zero turn on a one to two acre lawn. Transaxles and spindle bearings are the usual wear items, so a fabricated deck, greasable spindles and gentle use on hills extend life the most."
          }
        },
