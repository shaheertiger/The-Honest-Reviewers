const moreInCategory = [
  {
    "title": "Best Zero Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Residential Zero Turn Mowers",
    "url": "/best-residential-zero-turn-mower/"
