    { title: "Best Deck Cleaner", url: "/best-deck-cleaner/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "Can You Stain Composite Decking? Trex, TimberTech and the Rest";
const description =
  "Capped composite cannot be stained at all, uncapped composite can only be painted with a solid acrylic, and both answers void the warranty. What actually works instead.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
