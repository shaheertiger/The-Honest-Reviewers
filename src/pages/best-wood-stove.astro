const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Wood Stoves in 2026: Heat That Needs No Power";
const description =
  "A bigger wood stove is not a warmer house: an oversized stove gets choked down and smokes. 7 wood stoves sized for real homes, plus EPA, chimney and CO safety.";

const PRODUCTS = [
