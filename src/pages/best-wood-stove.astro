const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Wood Stoves",
          item: "https://www.thehonestreviewers.com/best-wood-stove/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best wood stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the Comfort Glow CGWS1500 is the best wood stove: its listing states EPA certification, a rating of up to 1,200 square feet, 18-inch logs and mobile home approval. Choose the Comfort Glow CGWS2500 for large homes, the Vogelzang VG1120E-BL for a well-supported plate steel stove, and the Comfort Glow CGWS750 or US Stove TH-100 for small spaces and tiny homes."
          }
        },
        {
          "@type": "Question",
          "name": "Does a wood stove work during a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A wood stove needs no electricity to make heat. The fire heats the stove body, which warms the room by radiation and natural convection. An optional electric blower stops when the power goes out, but the stove keeps heating. That makes a wood stove one of the most reliable ways to keep a home warm in a long outage."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a permit to install a wood stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most places, yes. Many towns and counties require a building permit and an inspection for a new wood stove and chimney, and your home insurer will usually want to know about it. A certified installer will know local code. Installing without a permit can cause problems with insurance claims and when you sell the house."
          }
        },
        {
          "@type": "Question",
          "name": "How far does a wood stove need to be from the wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow the clearances on the stove's label and in its manual, which vary by model and by whether you use heat shields. As a general rule, the NFPA 211 standard calls for 36 inches from combustibles for unlisted stoves and 18 inches for single-wall connector pipe. Listed stoves can sit closer only as their labels allow."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a carbon monoxide detector with a wood stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A cracked gasket, blocked chimney or downdraft can push carbon monoxide into the room, and you cannot smell it. Fit a CO alarm on every level of the home and outside sleeping areas, ideally with battery backup so it keeps working in an outage. Test it monthly and replace it at the end of its rated life."
          }
        },
        {
          "@type": "Question",
          "name": "Is a wood stove cheaper than a pellet stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Up front, prices overlap, but a wood stove can cost more to install if you need a full new chimney, while many pellet stoves vent through a wall. Running costs depend on fuel: free or cheap firewood makes a wood stove much cheaper to run, while bagged pellets cost more but need less work. Only a wood stove heats without electricity."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put a wood stove in a mobile home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only a stove that is specifically listed and approved for mobile homes, installed exactly as the manual says. That usually means an outside combustion air kit, the stove bolted to the floor and a listed chimney system. The Comfort Glow CGWS1500, CGWS2500 and CGWS750 listings state mobile home approval. Check local rules and your insurer too."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "best wood stove",
      "wood stove",
      "best wood burning stove",
      "best wood stove for heating",
      "best wood stove for power outage",
      "EPA certified wood stove",
      "best small wood stove",
      "wood vs pellet stove"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Wood Stoves</span> for Heat Without Power
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A bigger wood stove is not a warmer house: an oversized stove gets choked down, smokes and coats the chimney with creosote. What keeps a home warm through an outage is an EPA-certified stove sized to the space, on a proper chimney, with a CO alarm.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#comfort-glow-cgws1500"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 7 Stoves
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="2.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#power-outage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Heat With No Power</a>
          <a href="#epa" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. EPA Certification</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Wood Stoves</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Size You Need</a>
          <a href="#install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Clearances, Chimney and Permits</a>
          <a href="#co-safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. CO Alarms and Fire Safety</a>
          <a href="#bills" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cutting Heating Bills</a>
          <a href="#wood-vs-pellet" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Wood vs Pellet Stove</a>
          <a href="#firewood" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Firewood That Burns Clean</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Plate Steel vs Cast Iron</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people shop for a wood stove by the biggest heating number, then spend the winter running it choked down and smoky. The best wood stove is EPA certified, sized to the rooms you actually heat and installed on a proper chimney. It then heats your home with no electricity at all, through any outage. Here are seven real stoves and how to choose.
        </p>

