                    <td class="px-4 py-4 font-black text-gray-900">Kitchen</td>
                    <td class="px-4 py-4 text-gray-700">Workable with care</td>
                    <td class="px-4 py-4 text-gray-700">Good fit</td>
                    <td class="px-4 py-4 text-gray-700">Either laminate, plus a leak alarm</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Powder room</td>
                    <td class="px-4 py-4 text-gray-700">Risky</td>
                    <td class="px-4 py-4 text-gray-700">Good fit</td>
