---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Water Filter Pitchers",
    "url": "/best-water-filter-pitcher/"
  },
  {
    "title": "Best Under-Sink Water Filters",
    "url": "/best-under-sink-water-filter/"
  },
  {
    "title": "Best Faucet Water Filters",
    "url": "/best-faucet-water-filter/"
  },
  {
    "title": "Best Countertop Water Filters",
    "url": "/best-countertop-water-filter/"
  },
  {
    "title": "Best Refrigerator Brands",
    "url": "/best-refrigerator-brands/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Refrigerator Water Filters in 2026: Part Numbers and NSF 53/401 Certification";
const description =
  "The best refrigerator water filters for Whirlpool, GE, Samsung, LG and Frigidaire, grouped by part number and compared on NSF 42, 53 and 401 certification.";

const PRODUCTS = [
  {
    "id": "everydrop-filter-1-edr1rxd1",
    "name": "everydrop by Whirlpool Filter 1 (EDR1RXD1)",
    "category": "Genuine Whirlpool, NSF 42/53/401, 70 Contaminants, 6-Month Life",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Certified to NSF 42, 53 and 401, per the listing",
      "Listed to reduce 70 contaminants, including 99% of microplastics",
      "Coconut shell carbon core with three-stage filtration",
      "Official filter for Whirlpool, Maytag, KitchenAid, Amana and JennAir",
      "Genuine part, so fit and seal are not a gamble"
    ],
    "cons": [
      "Costs more than certified third-party Filter 1 replacements",
      "Only fits refrigerators that take Filter 1 (EDR1RXD1)",
      "Six-month life means two cartridges a year"
    ],
    "bottomLine": "The benchmark refrigerator water filter: genuine, triple-certified and the right part for millions of Whirlpool-family fridges.",
    "description": "If your fridge carries a Whirlpool, Maytag, KitchenAid, Amana or JennAir badge and the old cartridge says Filter 1 or EDR1RXD1, this is the filter to beat. everydrop is Whirlpool's own filter brand, and its listing describes the Filter 1 as the official filter for those five brands. The spec that matters is certification. The listing says it is independently certified to three NSF standards, 42, 53 and 401, and points out that many generic brands stop at one. NSF 42 covers chlorine taste and odor; 53 covers health-related contaminants such as lead; 401 covers emerging contaminants such as some pharmaceuticals. everydrop lists 70 contaminants in total, including 99 percent of microplastics, using a coconut shell carbon core and a three-stage design. Filter 1 sits in the top-left corner of the fresh-food compartment on most side-by-side and French-door Whirlpool-family models, and it is rated for six months. The trade-off is price. Certified third-party Filter 1 replacements cost less, and if you change the filter on schedule, a well-certified generic is a reasonable saving. Check the part number before you buy: Filter 1 is not Filter 2, 3, 4 or 5, and those look nothing alike. If your fridge takes Filter 4 (UKF8001) instead, the Waterdrop Plus below is the certified alternative."
  },
  {
    "id": "ge-rpwfe",
    "name": "GE RPWFE Refrigerator Water Filter",
    "category": "Genuine GE, NSF 42/53/372/401, Lead, PFOA/PFOS, Microplastics",
    "badge": "Best for GE French-Door Fridges",
    "amazonUrl": "#",
    "pros": [
      "Certified to NSF/ANSI 42, 53, 372 and 401, per the listing",
      "Listed to reduce 70+ impurities, including lead and PFOA/PFOS",
      "Fits select GE, GE Profile, Cafe and Monogram French-door models",
      "No tools and no water shutoff needed to change it",
      "Genuine part avoids chip and fit problems"
    ],
    "cons": [
      "Only fits fridges that specify RPWFE",
      "Priced above third-party RPWFE replacements",
      "Six-month replacement interval"
    ],
    "bottomLine": "The right filter for GE French-door fridges, with the broadest certification list of any genuine filter here.",
    "description": "GE's RPWFE is the filter for a large share of GE, GE Profile, Cafe and Monogram French-door refrigerators, and it has one of the strongest certification lists in this guide. The listing says it is certified to NSF/ANSI 42, 53, 372 and 401 and reduces more than 70 impurities, naming lead, chlorine, PFOA and PFOS, microplastics and select pharmaceuticals. For anyone worried about PFAS in municipal water, that PFOA/PFOS claim is the spec that matters, because a filter only certified to NSF 42 makes no such promise. Installation is the usual quarter turn, with no tools and no water shutoff, and GE rates it for six months. One detail sets RPWFE apart from most fridge filters: third-party RPWFE replacements on Amazon advertise a built-in chip so the refrigerator recognises them, which tells you the fridge checks the cartridge. A genuine filter avoids any question about whether that chip will be read correctly, and GE backs it with a guaranteed fit for its listed models. The trade-off is cost: genuine RPWFE cartridges cost more than chipped generics, and the generics we found list NSF 42 and 372 only, not 53 or 401. Check the part number first. RPWF (without the E) and RPWFE are not the same listing, and older GE side-by-side models use other filters such as MWF or XWF."
  },
  {
    "id": "samsung-haf-qin",
    "name": "Samsung HAF-QIN/EXP Genuine Refrigerator Water Filter",
    "category": "Genuine Samsung, Carbon Block, Authentication Tag, 6-Month Life",
    "badge": "Best for Samsung Fridges",
    "amazonUrl": "#",
    "pros": [
      "Genuine Samsung filter for HAF-QIN (DA97-17376B) housings",
      "Ultra-high-grade carbon block, listed to reduce 99% of harmful contaminants",
      "Authentication tag lets you confirm it is not a counterfeit",
      "Fits many Samsung French-door and side-by-side models",
      "Samsung says only its filters are guaranteed against leaks in its fridges"
    ],
    "cons": [
      "The listing does not name the NSF standards it meets",
      "Does not fit HAF-CIN (DA29-00020B) refrigerators",
      "Costs more than certified third-party HAF-QIN replacements"
    ],
    "bottomLine": "The safe, genuine choice for Samsung fridges that take the square HAF-QIN filter.",
    "description": "Samsung uses several filter styles, and HAF-QIN is the square cartridge found in many recent French-door and side-by-side models. Third-party listings cross-reference it as DA97-17376B and warn that it does not fit the round HAF-CIN (DA29-00020B), which is the single most common Samsung filter mix-up, so read the label on your old cartridge first. The genuine Samsung filter uses what Samsung calls an ultra-high-grade carbon block, listed to reduce 99 percent of potentially harmful contaminants, and it is rated for six months. Its most useful feature is the authentication tag: you place the tag over a supplied magnet and green stripes appear if the filter is genuine. That matters because counterfeit Samsung filters are a known problem, and a fake cartridge can leak or filter poorly. Samsung's listing says only its own filters are guaranteed to perform correctly with its refrigerators and avoid water damage. The trade-off is transparency. This listing does not spell out which NSF standards the filter meets, while the Waterdrop Plus replacement for the same housing lists NSF 42, 53 and 401. If you want a published certification list for lead and emerging contaminants, that Waterdrop is the better-documented choice; if you want the factory part and a counterfeit check, buy this one."
  },
  {
    "id": "lg-lt1000p",
    "name": "LG LT1000P Refrigerator Water Filter",
    "category": "Genuine LG, NSF 42/53/401, 6 Months or 200 Gallons",
    "badge": "Best for LG Fridges",
    "amazonUrl": "#",
    "pros": [
      "Certified to NSF 42, 53 and 401, per the listing",
      "Listed to remove 99.99% of cysts and 99% of asbestos",
      "Reduces lead, mercury, benzene and some pharmaceuticals",
      "Rated for six months or 200 gallons",
      "Genuine part keeps LG's warranty position clear"
    ],
    "cons": [
      "Only fits LG models that take LT1000P (ADQ74793501 and related numbers)",
      "Costs more than third-party LT1000P replacements",
      "Third-party versions we found list NSF 42 and 372 only"
    ],
    "bottomLine": "The genuine, triple-certified filter for LG fridges that take LT1000P, and worth the premium over generics.",
    "description": "LG's LT1000P fits a wide range of LG French-door and Kenmore models built by LG, and the listing names its alternate part numbers: ADQ74793501, ADQ75795105, AGF80300704 and AGF80300705. If any of those is printed on your current cartridge, this is the match. LG lists the filter as certified by NSF International to NSF 42, 53 and 401, and claims it removes 99.99 percent of cysts, 99 percent of asbestos and almost all mercury, lead and benzene, plus some herbicides, pesticides, pharmaceuticals and insect repellent. It is rated for six months or 200 gallons, whichever comes first. The spec that matters here is the gap between genuine and generic. The third-party LT1000P replacements we found on Amazon list NSF 42 and 372: chlorine taste and odor, plus lead-free materials. Neither standard covers lead reduction in the water, which is what NSF 53 adds. LG's listing also warns that third-party filters can cause fit problems and are not covered under its warranty. So for an LG fridge, the genuine filter is the one we recommend, even though it costs more. If your LG fridge is a newer model, check whether it takes LT1000P or a different cartridge such as LT800P or LT700P before ordering; they look alike in photos but are not interchangeable."
  },
  {
    "id": "frigidaire-eptwfu01",
    "name": "Frigidaire PureSource Ultra II EPTWFU01 Water Filter",
    "category": "Genuine Frigidaire, Carbon Filter, Push-and-Twist, 6-Month Life",
    "badge": "Best for Frigidaire Fridges",
    "amazonUrl": "#",
    "pros": [
      "Genuine PureSource Ultra II for Frigidaire and many Electrolux-built fridges",
      "Listed to reduce chlorine taste, lead, mercury, cysts and asbestos",
      "Also lists pesticides, BPA and pharmaceuticals",
      "Push-and-twist install takes under a minute",
      "Frigidaire warns against counterfeits and sells the genuine part directly"
    ],
    "cons": [
      "The listing does not name its NSF standard numbers",
      "Reminder light must be reset by hand",
      "Only fits fridges that take EPTWFU01 (also cross-referenced as EWF02)"
    ],
    "bottomLine": "The genuine filter for Frigidaire fridges that take PureSource Ultra II, with a broad contaminant list.",
    "description": "Frigidaire's PureSource Ultra II, part number EPTWFU01, is the filter for many current Frigidaire and Frigidaire Gallery refrigerators, and third-party listings cross-reference it as EWF02. If your old cartridge says PureSource Ultra II or EPTWFU01, this is the genuine part. Frigidaire describes a carbon-based filter that removes the taste of chlorine and reduces common tap-water impurities. The two-pack listing gives the longer list: chlorine taste and odor, Class I particulates, cysts, lead, mercury, pesticides, insecticides, BPA, asbestos and pharmaceuticals. That is the spec that matters, because many cheap EPTWFU01 replacements list chlorine reduction under NSF 42 and nothing more. Installation is a push and a quarter turn: turn the old filter 90 degrees counterclockwise to remove it, slide the new one in with the grip horizontal, push firmly and turn 90 degrees to the right until it clicks. The reminder light does not reset itself; on most models you hold the Water Filter button for three seconds. The trade-off is that this listing does not print the NSF standard numbers the way everydrop, GE and LG do, so if you want to verify a specific claim, look the part up in NSF's online listings. Older Frigidaire models use PureSource 2 or PureSource 3 instead, so match the number on the cartridge you are replacing."
  },
  {
    "id": "waterdrop-plus-ukf8001",
    "name": "Waterdrop Plus UKF8001 Replacement Filter (WDP-F07)",
    "category": "Third-Party, NSF 42/53/401/372, Fits Filter 4 / EDR4RXD1 / UKF8001",
    "badge": "Best Certified Third-Party",
    "amazonUrl": "#",
    "pros": [
      "Certified to NSF/ANSI 401, 53, 42 and 372, per the listing",
      "Replaces everydrop Filter 4 (EDR4RXD1), UKF8001 and Kenmore 9006",
      "Listed to reduce PFAS",
      "Coconut shell carbon block",
      "Multi-pack with reminder stickers to track change dates"
    ],
    "cons": [
      "Not a genuine Whirlpool part",
      "Fit is only guaranteed for the listed cross-reference numbers",
      "Sold in multi-packs, so the up-front spend is higher"
    ],
    "bottomLine": "A third-party fridge filter that carries the same NSF 42, 53 and 401 coverage as the best genuine filters.",
    "description": "Most third-party refrigerator filters on Amazon are certified only to NSF 42 for chlorine taste and NSF 372 for lead-free materials. The Waterdrop Plus line is the exception worth knowing about, and this UKF8001 version shows why. Waterdrop's listing says the WDP-F07 is certified by NSF against NSF/ANSI 401, 53, 42 and 372, covering each component and the finished cartridge. That puts it on the same certification footing as everydrop's own filters, which is the one spec that justifies buying a generic over the genuine part. It replaces the Whirlpool and Maytag UKF8001, everydrop Filter 4 (EDR4RXD1), Kenmore 9006 and Puriclean II, which covers many bottom-freezer and French-door models with the filter in the upper-right corner or the base grille. Waterdrop lists PFAS reduction and uses coconut shell carbon from Sri Lanka, and includes stickers so you can write the change date on the cartridge. The trade-offs: this is not a genuine Whirlpool part, so if your fridge is under warranty and you want no argument, buy everydrop Filter 4. It only fits the part numbers listed, so check your cartridge rather than your fridge's brand name. And it comes in multi-packs. If your Whirlpool-family fridge takes Filter 1 rather than Filter 4, buy the everydrop Filter 1 above instead."
  },
  {
    "id": "waterdrop-plus-samsung-da97-17376b",
    "name": "Waterdrop Plus Replacement for Samsung DA97-17376B (HAF-QIN)",
    "category": "Third-Party, NSF 42/53/401, Fits HAF-QIN / DA97-17376B",
    "badge": "Best Value for Samsung",
    "amazonUrl": "#",
    "pros": [
      "Certified against NSF/ANSI 401, 53 and 42, per the listing",
      "Lists 99.2% reduction of BPA, ibuprofen and other NSF 401 contaminants",
      "Fits Samsung HAF-QIN, HAF-QIN/EXP and DA97-08006C housings",
      "Coconut shell carbon block",
      "Three-pack covers about 18 months of changes"
    ],
    "cons": [
      "Not a genuine Samsung filter, so no authentication tag",
      "Its PFOA/PFOS figure comes from a third-party lab, not an NSF certification",
      "Does not fit HAF-CIN (DA29-00020B) fridges"
    ],
    "bottomLine": "The better-documented way to filter a Samsung HAF-QIN fridge, at a lower cost per cartridge than genuine.",
    "description": "Samsung's genuine HAF-QIN filter does not publish its NSF standard numbers, and this Waterdrop Plus replacement does, which is the main reason to consider it. The listing says it is certified against NSF/ANSI 401 for 99.2 percent reduction of bisphenol A, phenytoin, estrone, ibuprofen and naproxen, and against NSF/ANSI 53 and 42. Waterdrop also cites a 95.3 percent reduction in PFOA and PFOS, but notes that figure comes from a third-party laboratory rather than an NSF certification, so treat it as a manufacturer claim. It fits the square Samsung DA97-17376B housing, listed as HAF-QIN, HAF-QIN/EXP and DA97-08006C, used in many Samsung French-door and side-by-side refrigerators. Like every HAF-QIN replacement, it does not fit the round HAF-CIN (DA29-00020B), so check your old cartridge. The carbon block is coconut shell carbon, and the three-pack covers roughly a year and a half at the six-month interval most fridge makers recommend. Install it the same way as the genuine filter and flush a few gallons before drinking. Who should buy it: Samsung owners who want a published certification list and a lower cost per filter. Who should not: anyone who wants Samsung's authentication tag and its leak guarantee, or whose fridge is still under warranty and wants no dispute. For those, the genuine Samsung HAF-QIN above is the safer purchase."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Refrigerator Water Filters",
          item: "https://www.thehonestreviewers.com/best-refrigerator-water-filter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best refrigerator water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best refrigerator water filter is the genuine filter for your fridge's part number, or a third-party replacement with the same NSF 42, 53 and 401 certification. For Whirlpool-family fridges, everydrop Filter 1 is our top pick; GE owners should buy RPWFE, LG owners LT1000P. Match the part number on your old cartridge before comparing anything else."
          }
        },
        {
          "@type": "Question",
          "name": "Are off-brand refrigerator water filters safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Certified ones are. A third-party filter certified to NSF 53 and 401, such as Waterdrop's Plus line, offers the same certified reduction as many genuine filters. Uncertified or NSF 42-only generics are safe to drink through but only improve taste, and poorly made ones can leak. Check the exact certification and the part number before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know which water filter my refrigerator uses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Read the part number on your current filter, such as EDR1RXD1, HAF-QIN, LT1000P or RPWFE. If the filter is missing, find the model number on the sticker inside the fresh-food compartment and look it up in the owner's manual or the maker's parts site. Replacement listings also print the fridge models each filter fits."
          }
        },
        {
          "@type": "Question",
          "name": "Do refrigerator water filters remove lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only filters certified to NSF/ANSI 53 for lead are proven to reduce it. Genuine filters from LG, GE and Whirlpool's everydrop list lead reduction, and the Waterdrop Plus replacements list NSF 53. Many cheap generics are certified only to NSF 42 for taste and odor, which makes no claim about lead in the water."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if you don't change your refrigerator water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The carbon block saturates and stops reducing contaminants, flow slows as sediment builds up, and the water and ice can start to taste stale. An overdue filter does not usually make water dangerous, but it no longer does what it is certified to do. Change it every six months or at its rated gallons."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use my refrigerator without a water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many fridges work without a filter if you install the bypass plug that came with the refrigerator, or one sold for your model. Without a plug, some models will not dispense water at all. Running unfiltered also means sediment reaches the ice maker and valve, so use a bypass only as a temporary measure."
          }
        },
        {
          "@type": "Question",
          "name": "Is refrigerator filtered water as good as bottled water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A refrigerator filter certified to NSF 42, 53 and 401 gives you water that tastes clean and has reduced levels of chlorine, lead and many other contaminants, at a fraction of the cost of bottled water. It does not remove dissolved minerals the way reverse osmosis does. For most city water, a certified fridge filter is entirely adequate."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "refrigerator water filter",
      "best refrigerator water filter",
      "best fridge water filter",
      "fridge water filter replacement",
      "refrigerator water filter NSF 401",
      "OEM vs generic fridge filter"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Refrigerator Water Filters</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Genuine and certified third-party filters for Whirlpool, GE, Samsung, LG and Frigidaire fridges, grouped by part number, with what NSF 42, 53 and 401 actually mean.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#everydrop-filter-1-edr1rxd1"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Find Your Filter
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#part-number" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Find Your Part Number</a>
          <a href="#nsf-certification" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. NSF 42, 53 and 401</a>
          <a href="#oem-vs-generic" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. OEM vs Third-Party</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The 7 Best Fridge Filters</a>
          <a href="#by-brand" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Which Filter Fits My Fridge</a>
          <a href="#how-often" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How Often to Change It</a>
          <a href="#replace" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How to Replace It</a>
