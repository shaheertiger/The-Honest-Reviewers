const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: "2026-08-06",
      dateModified: "2026-08-06",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
