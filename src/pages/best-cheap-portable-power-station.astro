---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Portable Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Jackery Power Stations",
    "url": "/best-jackery-power-station/"
  },
  {
    "title": "Best DJI Power Stations",
    "url": "/best-dji-power-station/"
  },
  {
    "title": "Best Solar Power Banks",
    "url": "/best-solar-power-bank/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Cheap Portable Power Stations in 2026: Wh, LiFePO4";
const description =
  "The best cheap portable power stations on Amazon from OUPES, VTOMAN, Marbero, Pecron and ALLPOWERS, ranked on capacity, inverter output, LiFePO4 cycle life, charge time, ports and warranty rather than prices that change daily.";

const PRODUCTS = [
  {
    "id": "oupes-exodus-350",
    "name": "OUPES Exodus 350 Portable Power Station",
    "category": "288Wh LiFePO4, 350W Pure Sine (600W Surge), 3000+ Cycles, 9.2 lb",
    "badge": "Best Overall Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "288Wh LiFePO4 battery rated for 3000+ cycles to 80%, per the listing",
      "350W pure sine wave inverter with 600W surge",
      "Up to 240W solar input, listed at 0-80% in 69 minutes",
      "140W PD USB-C port runs most laptops directly",
      "Light at 9.2 lbs, with Wi-Fi and Bluetooth app control"
    ],
    "cons": [
      "350W continuous rules out kettles, heaters and hair dryers",
      "The listing does not state a warranty length",
      "The title calls 600W the UPS figure while the features call it surge, so read the spec sheet"
    ],
    "bottomLine": "The best small budget power station for most people: LiFePO4 cells, a pure sine inverter, a strong USB-C port and fast solar charging in a 9.2 lb box.",
    "description": "Most people searching for a cheap power station need something to keep phones, a laptop, a router, lights and maybe a CPAP running through a weekend or a short outage, and the OUPES Exodus 350 covers that job with the spec sheet of a much pricier unit. Its listing describes a 288Wh LiFePO4 battery rated for more than 3,000 cycles to 80 percent, which is the single spec that separates a budget unit that lasts a decade from one that fades in a few seasons. The inverter is pure sine wave at 350W continuous and 600W surge, so it suits CPAP machines, laptop bricks and small fans. Two details lift it above most small stations: a 140W PD USB-C port that charges a laptop without its power brick, and up to 240W of solar input, which OUPES says takes it from 0 to 80 percent in 69 minutes. It weighs 9.2 lbs and has an app with over-the-air firmware updates. The trade-offs are real. 350W will not run a coffee maker, kettle or space heater, the listing does not state a warranty term, and its title describes 600W as a UPS limit while the features call it surge, so check the maker's spec sheet before relying on it as a backup supply. If you need to run a small fridge for a day, buy the Pecron E500LFP instead."
  },
  {
    "id": "vtoman-flashspeed-300",
    "name": "VTOMAN FlashSpeed 300 Portable Power Station",
    "category": "230Wh LiFePO4, 300W (600W Peak), 3000 Cycles, 7.4 lb",
    "badge": "Best Lightweight LiFePO4",
    "amazonUrl": "#",
    "pros": [
      "230Wh LiFePO4 battery rated for over 3000 cycles, per the listing",
      "Only 7.4 lbs, with a built-in LED light and SOS mode",
      "100W PD USB-C works as both input and output",
      "Two AC outlets, 300W continuous and 600W peak",
      "Four ways to charge: wall, solar, 12V/24V car and USB-C"
    ],
    "cons": [
      "Wall charging is listed at about 2.5 hours, slower than the OUPES",
      "The title says 6 outputs while the features list 7 ports",
      "No warranty length stated on the listing"
    ],
    "bottomLine": "A light, LiFePO4 entry unit for campers and anyone who wants a long-lived battery in the smallest size class.",
    "description": "If the Exodus 350 is still more than you need, the VTOMAN FlashSpeed 300 is the lightest unit here with a LiFePO4 battery, which is why it is our pick for camping, tailgating and the go-bag. VTOMAN lists 230Wh of capacity, 300W continuous output with a 600W peak, and a battery rated for more than 3,000 cycles, which the maker says is six times longer than conventional batteries. At 7.4 lbs it is easy to carry to a campsite one-handed. The port mix is practical for small loads: two AC outlets, a 100W USB-C port, three USB-A ports and a DC port, plus a built-in LED light with steady, strobe and SOS modes that earns its place in an outage. The 100W USB-C port also works as an input, so you can top it up from a USB-C charger, and VTOMAN lists about two hours to 80 percent that way, about 2.5 hours from the wall, plus solar and 12V or 24V car charging. The trade-offs: 230Wh is the smallest LiFePO4 capacity in this guide, so it will run a CPAP for a night or two rather than a week, and the listing's title says six outputs while the features count seven, so confirm the port list on arrival. The listing also gives no warranty term. Buy the OUPES Exodus 350 instead if you want faster solar charging and a stronger USB-C port."
  },
  {
    "id": "marbero-m823-237wh",
    "name": "MARBERO M823 300W Portable Power Station (237Wh)",
    "category": "237Wh Lithium (Not LiFePO4), 300W (375W Peak) Pure Sine, 4.6 lb",
    "badge": "Lightest Entry Pick",
    "amazonUrl": "#",
    "pros": [
      "Very light at 4.6 lbs and backpack-sized (8.15 x 5.83 x 3.90 in)",
      "Pure sine wave AC outlets, 300W with 375W peak",
      "Eight outputs including two QC3.0 USB-A and a 12V DC port",
      "Two LED lights with SOS mode",
      "BMS with short-circuit, overload and temperature protection"
    ],
    "cons": [
      "Lithium battery, not LiFePO4, and no cycle rating is listed",
      "Slow charging: about 6 hours from the wall and 8 from the car",
      "USB-C is only 18W, too slow for most laptops"
    ],
    "bottomLine": "The lightest pure sine unit here, for phones, lights, small fans and a CPAP night, if you accept a shorter-lived lithium battery.",
    "description": "The MARBERO M823 is the pick for people who want the smallest, lightest AC power station they can find, and who will use it occasionally rather than every day. Marbero lists 237Wh of capacity, two pure sine wave AC outlets rated at 300W with a 375W peak, and a body that weighs 4.6 lbs and measures about 8 by 6 by 4 inches, small enough for a backpack. That makes it the lightest unit in this guide by a wide margin. It has eight outputs, including two QC3.0 USB-A ports, two standard USB-A ports, a USB-C port and a 12V DC port, plus two LED lights with SOS mode. The trade-offs are where its lower-cost design shows. The listing describes a lithium battery, not LiFePO4, and its capacity is quoted at 3.7V, which points to standard lithium-ion cells; it gives no cycle rating, so expect it to age faster than the LiFePO4 units here. Charging is slow, about six hours from the wall and eight from a car outlet, with solar input capped at about 2.7A. The USB-C port is only 18W, so it will not charge most laptops at full speed; use the AC outlet instead. The listing does not state a warranty. Buy the VTOMAN FlashSpeed 300 instead if you will cycle it often and want a battery that lasts thousands of cycles."
  },
  {
    "id": "pecron-e500lfp",
    "name": "Pecron E500LFP Portable Power Station",
    "category": "576Wh LiFePO4, 600W Pure Sine, 1.5-Hour AC Charge, 1+1 Year Warranty",
    "badge": "Best Mid-Size Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "576Wh LiFePO4, double the capacity of the small units",
      "600W pure sine wave AC output",
      "Full charge in 1.5 hours with 500W AC fast charging, per the listing",
      "Nine outputs including two DC5525 ports and a cigarette port",
      "1+1 year warranty and 24/7 customer service listed"
    ],
    "cons": [
      "No cycle rating is stated on the listing",
      "600W will not run a microwave or full-size kettle",
      "Weight and solar wattage limits are not spelled out on the listing"
    ],
    "bottomLine": "The capacity sweet spot for budget buyers: enough LiFePO4 for a mini fridge, CPAP and router through a short outage.",
    "description": "Small 200-300Wh units run out quickly once you add a mini fridge or a few nights of CPAP use, and the Pecron E500LFP is the step up that most budget buyers should consider. It doubles the capacity of the small picks to 576Wh, uses LiFePO4 cells and has a 600W pure sine wave inverter, which is enough for a dorm fridge, a CPAP, a router and a laptop together. Pecron lists a full charge in 1.5 hours with 500W AC fast charging, which matters before a forecast storm, plus USB-C charging in about six hours, solar and car charging, with the solar panel sold separately. The outputs are well chosen for camping and RV use: two AC outlets, two USB-A ports, a USB-C port, a cigarette lighter port, two DC5525 barrel ports and a top charger. Pecron also lists overcharge, over-voltage, overheat, overload and short-circuit protection, and a 1+1 year warranty with 24/7 customer service, which is one of the few clearly stated support promises among the smaller budget brands. The trade-offs: the listing does not give a cycle rating or a weight, so check the spec sheet if either matters, and 600W rules out microwaves, toasters and space heaters. If you need to run kitchen appliances, step up to the OUPES Mega 1 Lite. If you only charge phones and lights, the smaller OUPES or VTOMAN units are lighter and do the job."
  },
  {
    "id": "vtoman-flashspeed-1100",
    "name": "VTOMAN FlashSpeed 1100 (FS1100) Portable Power Station",
    "category": "460.8Wh LiFePO4, 1100W (2200W Peak), Expandable to 2008.8Wh, 30-Min 0-80%",
    "badge": "Best Expandable Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "1100W continuous and 2200W peak from a 460.8Wh LiFePO4 unit",
      "0-80% in 30 minutes with 700W AC input, per the listing",
      "Expandable to 2008.8Wh with the FlashSpeed 1500 Extra Battery",
      "Two 100W USB-C PD ports among eight outputs",
      "3000+ cycle rating and a built-in cable storage box"
    ],
    "cons": [
      "460.8Wh drains fast at its full 1100W rating",
      "The title says UPS under 10ms; the features say under 20ms",
      "18.74 lbs, and the listing gives no warranty length"
    ],
    "bottomLine": "A compact unit with a big inverter and an upgrade path: start small, add the extra battery later.",
    "description": "The VTOMAN FS1100 suits buyers who want to start with a smaller, lower-cost unit but expect to need more later. Its 460.8Wh LiFePO4 battery is modest, but the inverter is not: VTOMAN lists 1100W continuous and 2200W peak from a pure sine wave inverter, enough for a toaster, small heater or coffee maker for a short time. The real hook is expansion. Add the VTOMAN FlashSpeed 1500 Extra Battery, sold separately, and capacity rises to 2008.8Wh, so the same station can grow from a camping unit into a meaningful home-backup battery. Charging is quick: VTOMAN lists 0 to 80 percent in 30 minutes from a 700W AC input, and up to 300W of solar input. There are eight outputs, including two 100W USB-C ports for laptops, two QC3.0 USB-A ports, a DC5521 port and a 12V car port, plus an LCD that shows remaining runtime and a top box that stores cables. The listing cites a 10-layer BMS and more than 3,000 cycles. Watch three things. A 460.8Wh battery runs a 1,000W load for well under half an hour, so the big inverter is for short bursts. The title promises UPS switchover under 10ms while the features say under 20ms, and no warranty term is given. At 18.74 lbs it is a two-hand carry. Buy the Pecron E500LFP instead for more base capacity in a lighter class."
  },
  {
    "id": "oupes-mega-1-lite",
    "name": "OUPES Mega 1 Lite Portable Power Station",
    "category": "1024Wh LiFePO4, 2000W (4500W Surge), 46-Min Full Charge, 5-Year Warranty",
    "badge": "Best Budget 1kWh Unit",
    "amazonUrl": "#",
    "pros": [
      "1024Wh LiFePO4 rated for 3,500+ cycles to 80%, per the listing",
      "2000W rated, 4500W surge pure sine output",
      "0-100% in 46 minutes from a 1400W AC input",
      "Up to 800W solar input through an Anderson port",
      "Two 140W USB-C ports and a 5-year warranty listed"
    ],
    "cons": [
      "26.7 lbs is a real carry",
      "Nine ports is fewer than many 1kWh stations",
      "UPS switchover is listed at under 20ms, slower than some"
    ],
    "bottomLine": "The most power per unit of capacity among the budget brands: a 1kWh LiFePO4 station that runs kitchen appliances and recharges in under an hour.",
    "description": "When a cheap power station needs to handle a refrigerator, microwave or coffee maker, the small units stop being cheap in any useful sense, because they simply cannot run those loads. The OUPES Mega 1 Lite is the budget-brand answer at the 1kWh level. OUPES lists 1024Wh of LiFePO4 capacity rated for more than 3,500 cycles to 80 percent, a 2000W rated pure sine inverter with 4500W surge, and a 1400W AC input that recharges from 0 to 100 percent in 46 minutes. That is the spec set of a mainstream 1kWh flagship, which is exactly why it belongs in a budget guide: it lets you rank on what you get rather than the badge. Solar input runs up to 800W through an Anderson port, so three panels can refill it in about 70 minutes in good sun, according to OUPES. Two 140W USB-C ports charge laptops at full speed, the app lets you set a 700W quiet charge, and the box includes a five-year warranty, the joint longest stated here. The trade-offs: 26.7 lbs is heavy for camping, nine ports is fewer than some rivals, and the under-20ms UPS switchover may not be fast enough for some desktop PCs. This listing does not mention expansion batteries. Buy the ALLPOWERS P1800 kit instead if you want a solar panel in the box, or the Pecron E500LFP if 576Wh is enough."
  },
  {
    "id": "allpowers-p1800-100w-solar",
    "name": "ALLPOWERS P1800 Portable Power Station with 100W Solar Panel",
    "category": "1024Wh LiFePO4, 1800W (3600W Surge), 4000+ Cycles, 100W Panel Included, 5-Year Warranty",
    "badge": "Best Budget Solar Generator Kit",
    "amazonUrl": "#",
    "pros": [
      "Comes with a 100W solar panel in the box",
      "1024Wh LiFePO4 rated for 4,000+ cycles, per the listing",
      "1800W rated, 3600W surge, with four AC outlets",
      "Up to 650W solar input, plus wall and 12V/24V car charging",
      "Two 140W USB-C ports, app control and a 5-year warranty"
    ],
    "cons": [
      "28.7 lbs before you add the panel",
      "A single 100W panel refills a 1kWh battery slowly",
      "20ms UPS switchover and a -10 to 40 C operating range"
    ],
    "bottomLine": "The simplest way into an affordable solar generator: a 1kWh LiFePO4 station and a matching panel in one listing.",
    "description": "Search for an affordable solar generator and you mostly find power stations sold with or without a panel. The ALLPOWERS P1800 listing here includes a 100W solar panel, which makes it the easiest complete kit for someone starting from nothing. The station itself is solid for the class: ALLPOWERS lists a 1024Wh LiFePO4 battery rated for more than 4,000 cycles, the highest cycle rating in this guide, with 1800W rated output, 3600W surge and four AC outlets, enough for a refrigerator, a laptop and lights together. Solar input runs up to 650W through an 11-60V MPPT controller, so you can add more panels later, and it also charges from the wall and from 12V or 24V car outlets. Two 140W USB-C ports, two 18W USB-A ports and a 120W car outlet cover small devices, the LCD shows remaining time and the app offers fast, standard and silent charging modes. ALLPOWERS lists a five-year warranty and a 20ms UPS function. Be realistic about the bundle: a single 100W panel delivers well under 100W in real sun, so it takes most of two sunny days to refill 1,024Wh from empty; it is a trickle source, not a fast one. The station weighs 28.7 lbs and is rated for -10 to 40 C. Buy the OUPES Mega 1 Lite instead if you already own panels and want faster charging."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cheap Portable Power Stations",
          item: "https://www.thehonestreviewers.com/best-cheap-portable-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cheap portable power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the OUPES Exodus 350 is the best budget power station: 288Wh of LiFePO4 rated for 3,000+ cycles, a 350W pure sine inverter, 140W USB-C and fast solar charging at 9.2 lbs. If you need more capacity, the Pecron E500LFP doubles it. Prices change daily, so check the current Amazon price."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best budget portable power station for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look at 500Wh or larger. The Pecron E500LFP runs a router, CPAP and mini fridge through a short outage. For kitchen appliances or a full-size fridge, the OUPES Mega 1 Lite or ALLPOWERS P1800 offer 1,024Wh of LiFePO4 and 1800-2000W inverters. The VTOMAN FS1100 can expand later."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cheapest portable power station worth buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look at the smallest class with a pure sine AC outlet, around 230-240Wh, such as the VTOMAN FlashSpeed 300 or Marbero M823. Choose the VTOMAN for a LiFePO4 battery that lasts thousands of cycles, or the Marbero if light weight matters more than battery life. Compare today's prices on both listings."
          }
        },
        {
          "@type": "Question",
          "name": "Is Pecron as good as Jackery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On specs, Pecron's E500LFP is competitive: 576Wh of LiFePO4, a 600W pure sine inverter and a listed 1.5-hour AC charge. Jackery generally offers more established support and documentation. Pecron lists a 1+1 year warranty with 24/7 service. Compare the warranty and today's price for the capacity you need."
          }
        },
        {
          "@type": "Question",
          "name": "Are cheap power stations safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Units from established budget brands with a battery management system and stated protections are generally safe when used within their ratings. Follow the maker's instructions, keep vents clear, avoid overloading and never connect one to house wiring without a proper transfer switch. Avoid unbranded listings with no model number or warranty."
          }
        },
        {
          "@type": "Question",
          "name": "Is an affordable solar generator worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A solar generator bundle, such as the ALLPOWERS P1800 with a 100W panel, is a convenient start. Expect small panels to refill large batteries slowly: a single 100W panel takes most of two sunny days to fill a 1kWh station. Add panels up to the station's solar input limit for faster charging."
          }
        },
        {
          "@type": "Question",
          "name": "How long do cheap power stations last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends mostly on chemistry. LiFePO4 units in this guide list 3,000 to 4,000 cycles to about 80 percent capacity, which is many years of regular use. Lithium-ion units age faster and rarely list a cycle rating. Store either kind partly charged in a cool place to extend its life."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best cheap portable power station",
      "best budget portable power station",
      "cheap portable power station",
      "cheap power station",
      "affordable solar generator",
      "pecron vs jackery",
      "cheapest portable power station"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Cheap Portable Power Stations</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven lower-cost power stations from OUPES, VTOMAN, Marbero, Pecron and ALLPOWERS, ranked on what you get: watt-hours, inverter output, LiFePO4 cycle life, charge time and warranty.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#oupes-exodus-350"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Size Class?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#specs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Rank the Specs, Not the Sticker</a>
          <a href="#size-classes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Budget Size Classes</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Cheap Power Stations</a>
          <a href="#lifepo4" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. LiFePO4 vs Lithium-Ion</a>
