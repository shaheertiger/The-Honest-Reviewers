];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-18", modified: "2026-10-18" });
const title = "6 Best Pickleball Paddles for Beginners: Forgiving Picks Under $120";
const description =
  "Six beginner pickleball paddles and sets under about $120, chosen for forgiveness, mid weight and a wide sweet spot, with sizing, grip and upgrade advice.";

const PRODUCTS = [
  {
    "id": "selkirk-slk-neo-2-set",
    "name": "Selkirk SLK Neo 2.0 Pickleball Paddle Set",
