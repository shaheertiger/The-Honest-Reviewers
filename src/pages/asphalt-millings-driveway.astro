                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rough installed cost</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Asphalt millings</td>
                    <td class="px-4 py-4 text-gray-700">$2-$5 per sq ft</td>
                    <td class="px-4 py-4 text-gray-700">Depends on supply, base work and compaction</td>
