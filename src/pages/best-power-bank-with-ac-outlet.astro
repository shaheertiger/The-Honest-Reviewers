];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "6 Best Power Banks with AC Outlet in 2026: Watts, Not Hype";
const description =
  "The best power banks with an AC outlet, from a 100W carry-on pack to 600W mini stations, with honest limits on what each one can actually plug in and run.";

const PRODUCTS = [
  {
    "id": "anker-solix-c300",
    "name": "Anker SOLIX C300 (AC)",
    "category": "288Wh LiFePO4, 300W AC (600W Surge), 2x 140W USB-C",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "288Wh LiFePO4 battery is rated for thousands of cycles and ages slowly in storage",
      "300W AC with 600W surge covers laptops, CPAPs, routers, TVs and small lamps",
      "Two 140W USB-C ports charge laptops directly, without the inverter loss",
      "USB-C ports work both ways, so a laptop charger can refill it",
      "Compact cylinder-like footprint fits a backpack side pocket or a car door well"
    ],
    "cons": [
      "About 9 lb, so it is a carry item rather than a pocket item",
      "Make sure you buy the AC version: Anker also sells a C300 DC with no outlets at all"
    ],
    "bottomLine": "The best balance of real AC output, strong USB-C and long-life chemistry for anyone who wants one battery for outages, travel and the occasional campsite.",
    "description": "The Anker SOLIX C300 is what most people actually mean when they search for a power bank with an outlet: a battery small enough to carry with one hand that still delivers genuine wall-style power. Anker rates it at 288Wh with a LiFePO4 battery, and the inverter is rated for 300W continuous with a 600W surge. That covers nearly everything a sensible person would plug into a battery this size, including laptops with brick chargers, CPAP machines, Wi-Fi routers and modems, small TVs, LED lamps, camera and drone battery chargers and a fan. What sets it apart from rivals is the USB-C side. Two ports are rated at 140W each, which is enough to charge most laptops at full speed directly, and that matters because USB-C skips the inverter and gets noticeably more runtime out of the same battery. Those USB-C ports also accept input, so in a pinch you can refill the C300 from a laptop charger or a USB-C wall adapter rather than hunting for its own cable. There is a 12V car socket for a cooler or tire inflator, and solar input on the order of 100W, which is enough to keep pace with phones and a laptop on a sunny day. LiFePO4 chemistry is the quiet win here. It tolerates being stored at partial charge and handles thousands of cycles, so this is a battery you can leave in a closet for storm season and still trust in five years. The catch is the name. Anker sells a C300 DC with no AC outlets, so check the listing before you buy."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow River 3",
    "category": "245Wh LiFePO4, 300W AC (600W X-Boost), UPS Under 20ms",
    "badge": "Best for Outages",
    "amazonUrl": "#",
    "pros": [
      "UPS mode switches over in under 20ms, fast enough to keep a router or desktop running",
      "Recharges from a wall outlet in about an hour, per EcoFlow's rating",
      "LiFePO4 battery rated for thousands of cycles",
      "X-Boost lets resistive loads like a small kettle run at reduced power up to 600W",
      "About 7.8 lb with a carry handle and quiet operation"
    ],
    "cons": [
      "245Wh is the smallest capacity among the power-station picks",
      "Solar input tops out around 110W, so a large panel is wasted on it"
    ],
    "bottomLine": "If your main job is keeping a router, modem and laptop alive through outages, the River 3's UPS mode and one-hour recharge make it the easiest pick.",
    "description": "The EcoFlow River 3 earns its place on a power bank list because it behaves like an outlet you can leave plugged in. EcoFlow rates it at 245Wh with a LiFePO4 battery and 300W of pure sine wave AC, and its party trick is UPS mode. Leave the River 3 plugged into the wall with your router, modem or desktop plugged into it, and when the grid drops it takes over in under 20 milliseconds, per EcoFlow's rating. That is quick enough that most networking gear and many computers never notice, which means your internet stays up and you do not lose unsaved work. A typical router and modem combo draws 15 to 25W, so the River 3 can keep a household online for roughly eight to ten hours on a full charge after inverter losses. X-Boost deserves an honest explanation. It lets the River 3 run some heating-element devices rated up to 600W by lowering the voltage it supplies, so a small kettle or hot plate runs slowly rather than tripping the inverter. It does not turn the River 3 into a 600W power station, and it does nothing for motors or compressors. Recharging is a strength: EcoFlow rates a full wall recharge at about an hour, so the unit refills quickly between outages or when power comes back briefly. Solar input is modest at around 110W, so pair it with a 100W panel rather than something larger. At about 7.8 lb, it is easy to move from the office to the bedroom for a CPAP. The tradeoff is capacity, which is the lowest of the power-station picks here."
  },
  {
    "id": "mophie-powerstation-pro-ac",
    "name": "mophie powerstation pro AC",
    "category": "27,000mAh (just under 100Wh), 100W AC, 60W USB-C",
    "badge": "Best Carry-On Pack",
    "amazonUrl": "#",
    "pros": [
      "One of the few true power banks with a built-in AC outlet",
      "Just under 100Wh, so it fits the standard airline carry-on limit without approval",
      "100W AC outlet runs most laptop bricks and small chargers",
      "60W USB-C plus a 20W USB-C and a 20W USB-A port",
      "About 2.1 lb, light enough for a laptop bag"
    ],
    "cons": [
      "100W AC ceiling rules out CPAP humidifiers, TVs and anything with a motor",
      "Stock comes and goes, and it costs far more per watt-hour than a small power station"
    ],
    "bottomLine": "The pick for travelers who need a real wall outlet in a carry-on bag; everyone else gets more for the money from a 250-300Wh station.",
    "description": "The mophie powerstation pro AC is one of the last genuine power banks with an AC outlet still sold by a major brand, and it exists for one kind of buyer: someone who needs to plug a wall charger into a battery while traveling. It holds 27,000mAh at the cell level, which works out to just under 100Wh, so it fits the standard airline carry-on rule for lithium batteries without needing airline approval. Small power stations cannot do that; everything in the 245Wh to 288Wh range on this list is too large to fly. The AC outlet is rated for 100W. That is enough for most laptop power bricks, a camera or drone battery charger, a small LED lamp, an electric toothbrush charger or a portable monitor. It is not enough for a TV, a CPAP with its heated humidifier running, a mini fridge or anything with a motor, and you should not try. Beside the outlet, mophie includes a 60W USB-C port, a second 20W USB-C and a 20W USB-A, with total output shared across them. If your laptop charges over USB-C, use the 60W port instead of the outlet; you will get more runtime because you skip the inverter's conversion loss. Recharging takes a few hours from a 60W USB-C charger, according to owner reports. At about 2.1 lb, it is heavy for a power bank but light next to any power station. The honest caveat is value. Per watt-hour it costs several times what a LiFePO4 station does, so buy it only if the airline limit or the weight genuinely matters to you."
  },
  {
    "id": "jackery-explorer-240-v2",
    "name": "Jackery Explorer 240 v2",
    "category": "256Wh LiFePO4, 300W Pure Sine AC (600W Surge)",
    "badge": "Simplest to Use",
    "amazonUrl": "#",
    "pros": [
      "256Wh LiFePO4 battery rated for about 3,000 cycles",
      "300W pure sine wave AC with 600W surge",
      "Fast wall recharge in roughly an hour, per Jackery's rating",
      "100W USB-C port for laptops and phones",
      "Very simple controls and an app for monitoring"
    ],
    "cons": [
      "Single AC outlet, so a power strip is needed for more than one plug",
      "No expansion and modest solar input"
    ],
    "bottomLine": "A no-fuss 300W battery for people who want to press one button and plug one thing in, especially a CPAP or a laptop.",
    "description": "The Jackery Explorer 240 v2 is the friendliest unit on this list. Jackery rates it at 256Wh with a LiFePO4 battery good for roughly 3,000 cycles, and the inverter delivers 300W of pure sine wave power with a 600W surge rating. There is one AC outlet rather than two or three, which sounds like a limitation until you remember what a battery this size is for. Most owners plug in exactly one thing at a time: a CPAP overnight, a laptop brick at a campsite, a router during an outage or a camera charger in the car. If you need more, a short power strip works fine as long as the total stays under 300W. Beside the outlet is a 100W USB-C port, which charges most laptops directly and should be your first choice whenever a device accepts it. Jackery rates a full wall recharge at around an hour in its fast-charging mode, which puts it level with the River 3. Solar charging is supported, though modest, so a 100W panel is the sensible match. What the 240 v2 does well is simplicity. The display is clear, the buttons are labeled and the app is optional rather than required. That makes it a good choice for an older relative's CPAP backup or a kit that lives in a closet and gets used twice a year. What it does not do is expand. There is no extra battery option, and 256Wh is the ceiling. If you think you might want more runtime later, look at the River 3 Plus instead."
  },
  {
    "id": "bluetti-eb3a",
    "name": "BLUETTI EB3A",
    "category": "268Wh LiFePO4, 600W Pure Sine AC (1,200W Surge)",
    "badge": "Most AC Power",
    "amazonUrl": "#",
    "pros": [
      "600W pure sine inverter, double the 300W units, with 1,200W surge",
      "Power Lifting mode runs resistive loads up to 1,200W at reduced power",
      "Up to 200W solar input and up to 430W combined AC plus solar charging",
      "Two AC outlets plus USB-C, USB-A, car port and wireless charging pad",
      "LiFePO4 battery for long cycle life"
    ],
    "cons": [
      "About 10 lb, the heaviest pick here",
      "268Wh drains quickly if you actually use the 600W ceiling"
    ],
    "bottomLine": "Buy it when the 300W limit is the problem: it handles a blender, a small CPAP plus laptop combination or a mini fridge's startup that 300W units can't.",
    "description": "The BLUETTI EB3A is on this list for buyers who keep running into the 300W ceiling. BLUETTI rates it at 268Wh with a LiFePO4 battery, but the inverter is the story: 600W continuous pure sine wave with a 1,200W surge. That doubles what the River 3, Jackery 240 v2 and Anker C300 can deliver, and it changes what you can plug in. A small blender, a 400W mini fridge startup surge, a laptop plus a CPAP plus a lamp at the same time, or a power tool battery charger that pulls 200 to 300W all fit comfortably. Power Lifting mode works like EcoFlow's X-Boost: it can run heating-element devices rated up to 1,200W by reducing voltage, so a small kettle runs slowly instead of shutting the unit down. It will not make a hair dryer or a space heater practical, and with only 268Wh on board it would not run them long anyway. Charging is a genuine strength. BLUETTI rates solar input at up to 200W, roughly double some rivals, and combined AC and solar charging at up to 430W, which makes the EB3A a good pick for anyone pairing it with a folding panel. The port selection is generous for the size, with two AC outlets, USB-C, USB-A, a 12V car port and a wireless charging pad on top. The tradeoffs are weight and the math. At around 10 lb, it is the heaviest unit here, and running a 500W load would drain it in roughly half an hour. The 600W inverter is headroom, not an invitation to run big loads all day."
  },
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow River 3 Plus",
    "category": "286Wh LiFePO4, 600W AC (1,200W X-Boost), Expandable",
    "badge": "Best Expandable",
    "amazonUrl": "#",
    "pros": [
      "286Wh base capacity, expandable to about 858Wh with an add-on battery",
      "600W AC, with X-Boost up to 1,200W for resistive loads",
      "UPS switchover rated under 10ms",
      "LiFePO4 rated for 3,000 cycles to 80 percent capacity",
      "Rated under 30dB, quiet enough for a bedroom"
    ],
    "cons": [
      "About 10.4 lb before you add the extra battery",
      "Add-on battery names vary by region and seller, so match the model carefully"
    ],
    "bottomLine": "The pick if you suspect you'll outgrow a 300Wh pack: start small and bolt on more capacity when a CPAP or longer outages demand it.",
    "description": "The EcoFlow River 3 Plus is where a power bank with an outlet stops being a power bank and starts being a small home backup system. The base unit holds 286Wh in a LiFePO4 battery rated for 3,000 cycles to 80 percent capacity, and the inverter delivers 600W continuous, with X-Boost stretching that to 1,200W for heating-element loads at reduced power. That alone puts it in the EB3A's class. The reason to choose it over the EB3A is expansion. EcoFlow sells an add-on battery that clips onto the unit and raises total capacity to roughly 858Wh in the largest configuration, so a buyer who starts with laptop and router duty can later add enough capacity to run a CPAP for two or three nights without humidification, or a small fridge for most of a day. UPS switchover is rated at under 10 milliseconds, faster than the standard River 3, which makes it a strong choice for a desk setup with a desktop PC, monitor and router. EcoFlow also rates it under 30dB, so the fan is unlikely to keep anyone awake. At about 10.4 lb, it is portable but not something you carry casually, and once the extra battery is attached it becomes a stay-in-one-place unit. The expansion battery is sold under slightly different names in different markets, so match the model number to your River 3 Plus before ordering. If you know you will only ever charge laptops and phones, the standard River 3 or the Anker C300 is lighter and cheaper."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Power Banks with AC Outlet",
          item: "https://www.thehonestreviewers.com/best-power-bank-with-ac-outlet/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best power bank with an AC outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the Anker SOLIX C300 is the best pick: 288Wh of LiFePO4, a 300W pure sine outlet and two 140W USB-C ports in a carry-friendly size. If you need to fly with it, the mophie powerstation pro AC is one of the few true power banks with an outlet under the 100Wh carry-on limit."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power bank with an outlet run a CPAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it has a pure sine inverter and enough capacity. A CPAP without humidifier usually draws 30 to 60W, so a 245 to 288Wh station covers roughly one night, longer on DC power. With a heated humidifier, consumption can double or triple, so consider a 600W expandable unit or a DC cord that skips the inverter."
          }
        },
        {
          "@type": "Question",
          "name": "How many watts do I need in a battery pack with an outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add the watts of everything you will run at the same time and add about 20 percent headroom. Laptops, routers, lamps and CPAPs without humidifiers fit a 300W unit. A mini fridge, blender or CPAP plus laptop together points to 600W. Anything that heats with electricity needs far more than this category offers."
          }
        },
        {
          "@type": "Question",
          "name": "Is a power bank with an AC outlet allowed on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is 100Wh or less, which allows it in carry-on bags without airline approval under FAA guidance. Batteries between 100 and 160Wh need airline approval, and larger units are not allowed. Power banks are never permitted in checked luggage. Every 245Wh-plus power station on this list stays home."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable power outlet run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not for long. A small efficient fridge may start and run on a 600W station, but the compressor startup surge can exceed 400W and a 288Wh battery would only last several hours. A full-size kitchen fridge needs a 1,000Wh class power station or larger, ideally with solar or wall recharging between runs."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a power bank with an outlet and a power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mostly size and chemistry. AC power banks are usually under 100Wh with lithium-ion cells and 60 to 100W outlets. Small power stations start around 245Wh, use longer-lived LiFePO4 cells and offer 300 to 600W pure sine output. Stations cost more per unit but much less per watt-hour, and they do not fly."
          }
        },
        {
          "@type": "Question",
          "name": "Is pure sine wave necessary for a plug in battery pack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For laptops and phone chargers, not strictly, since they convert power to DC immediately. For CPAPs, fans, tool chargers, audio gear and anything with a motor, yes. Modified sine wave can cause heat, buzzing or failure to start. Every station on our list is rated pure sine wave, which is one reason to avoid no-name packs."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "power bank with outlet",
      "power bank with ac outlet",
      "battery pack with outlet",
      "portable power with outlet",
      "portable power outlet",
      "portable electric outlet",
      "plug in battery pack"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          6 Best <span class="text-[#38BDF8]">Power Banks with AC Outlet</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A battery with a wall-style outlet sounds like it should run anything with a plug. It will not. These are the packs that deliver real AC power, and the wattage line where each one stops.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-solix-c300"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 6 Top Picks Reviewed</a>
          <a href="#ac-wattage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. AC Output Limits: 100W to 600W</a>
          <a href="#pure-sine" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Pure Sine Wave and Why It Matters</a>
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What You Can and Can't Plug In</a>
          <a href="#runtime-math" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Runtime Math That Actually Works</a>
          <a href="#bank-vs-station" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Power Bank or Small Power Station?</a>
          <a href="#usb-c-first" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Use USB-C Before the Outlet</a>
          <a href="#travel-safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Flying, Storage and Safety</a>
          <a href="#how-to-choose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. How to Choose in Five Questions</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
