---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Electric Space Heaters",
    "url": "/best-electric-space-heater/"
  },
  {
    "title": "Can a Portable Power Station Run a Space Heater?",
    "url": "/can-a-portable-power-station-run-a-space-heater/"
  },
  {
    "title": "Best Garage Heaters",
    "url": "/best-garage-heater/"
  },
  {
    "title": "Best Mini Split Heat Pumps",
    "url": "/best-mini-split-heat-pump/"
  },
  {
    "title": "Best Warm Mist Humidifiers",
    "url": "/best-warm-mist-humidifier/"
  },
  {
    "title": "Ceiling Fan Direction in Summer and Winter",
    "url": "/ceiling-fan-direction-summer-and-winter/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Battery Powered Heaters in 2026: What Actually Works";
const description =
  "The best rechargeable battery powered heaters, honestly ranked: tool-battery propane heaters, heated vests and blankets, and power stations, with real runtime math.";

const PRODUCTS = [
  {
    "id": "dewalt-dxh12b-cordless-radiant-heater",
    "name": "DEWALT DXH12B 20V MAX Cordless Propane Radiant Heater",
    "category": "Propane radiant, 6,000/12,000 BTU, 20V battery fan",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Real heat: up to 12,000 BTU/hr, roughly the output of a 3,500W electric heater",
      "Oxygen depletion sensor and tip-over shutoff",
      "Runs on any DEWALT 20V MAX or FLEXVOLT battery you already own",
      "Burns 1 lb propane cylinders, so no outlet and no generator needed",
      "Radiant design warms people and objects directly, which suits drafty rooms"
    ],
    "cons": [
      "The battery runs the fan and light; propane makes all the heat",
      "Battery sold separately, and indoor use is restricted in some places, including Massachusetts and Canada"
    ],
    "bottomLine": "The closest thing to a true battery space heater you can buy: a tool battery for the fan, propane for the heat, and the safety shutoffs that make careful indoor use possible.",
    "description": "If you came here looking for a heater that runs on a rechargeable battery and actually warms a room, this is the honest answer. The DXH12B is built for DEWALT by the company behind the Mr. Heater Buddy line, and it pairs a 20V MAX battery with a propane radiant burner rated at 6,000 or 12,000 BTU per hour. For context, 12,000 BTU is about what a 3,500W electric heater would put out, more than double a standard 1,500W plug-in model. No lithium battery small enough to carry could deliver that for more than a few minutes. The trick is that the battery is not the energy source. It runs the fan that pushes warm air forward and the work light, while propane from 1 lb cylinders does the heating. That split is what makes the heater useful in an outage, a shop or a hunting blind: your 5Ah tool battery lasts a long time when it only powers a small fan. The heater carries an oxygen depletion sensor and a tip-over switch, the two safeguards that separate an indoor-rated propane heater from a patio unit. It is sold for indoor use in most of the US, but some jurisdictions, including Massachusetts and Canada, restrict it to outdoor use, so read the label for your location. Even where it is allowed indoors, you still need a cracked window for fresh air and a working carbon monoxide alarm. Runtime per cylinder depends on the setting, and a 1 lb cylinder holds only about 21,600 BTU of fuel, so plan on a box of cylinders or a hose to a larger tank for long use."
  },
  {
    "id": "ryobi-pcl801-hybrid-propane-heater",
    "name": "RYOBI 18V ONE+ Hybrid Forced Air Propane Heater (PCL801B)",
    "category": "Forced-air propane, 30,000-60,000 BTU, 18V or AC",
    "badge": "Best for Garages and Job Sites",
    "amazonUrl": "#",
    "pros": [
      "Up to 60,000 BTU, enough to take the bite out of a two-car garage",
      "Runs the fan on any RYOBI 18V ONE+ battery or on an extension cord",
      "Variable dial from 30,000 to 60,000 BTU",
      "Hose and regulator included for a 20 lb propane tank",
      "Usually among the cheapest battery-assisted forced-air heaters"
    ],
    "cons": [
      "Forced-air propane heaters are for ventilated work spaces, not living rooms or bedrooms",
      "Loud fan and a noticeable propane smell at startup"
    ],
    "bottomLine": "The best value for RYOBI owners who need serious heat in a garage, barn or job site, but it is a ventilated-space tool, not an indoor room heater.",
    "description": "RYOBI's hybrid propane heater is the purest example of how tool-battery heaters really work. An 18V ONE+ battery spins the fan and runs the ignition, and a 20 lb propane tank feeds a burner rated from 30,000 to 60,000 BTU. RYOBI says that covers up to 2,500 square feet, which is optimistic for an uninsulated garage in January, but it is genuinely a lot of heat: 60,000 BTU is roughly what seventeen 1,500W space heaters would produce together. The hybrid part means you can also run it from an extension cord, which is how most owners use it for an all-day session, saving the battery for when no outlet is handy. Because the fan draws modest power, a 4Ah ONE+ pack lasts much longer than it would in a drill or a saw. Here is the blunt part. A forced-air propane heater, sometimes called a torpedo heater, is designed for well-ventilated spaces such as construction sites, open garages and barns. It does not have the low-emission radiant design of an indoor-rated Buddy heater, and it should never be the thing you run in a closed living room during a power outage. It also needs ventilation for the combustion air it consumes. Use it with a garage door cracked, a carbon monoxide alarm nearby, and nothing flammable in front of the outlet. If you are already in the RYOBI ecosystem and work in a cold garage, it is a strong buy. If you want to heat a bedroom, look at the DEWALT radiant model or a heated blanket instead. Our garage heater guide covers vented and electric alternatives."
  },
  {
    "id": "milwaukee-m18-0801-propane-heater",
    "name": "Milwaukee M18 Forced Air Propane Heater (0801-20)",
    "category": "Forced-air propane, up to 70,000 BTU, M18 or AC",
    "badge": "Most Powerful",
    "amazonUrl": "#",
    "pros": [
      "Up to 70,000 BTU from a variable dial, the highest output here",
      "Runs on any M18 battery or an AC cord",
      "Controls on top and onboard hose storage make it easy to move around a site",
      "Hose and regulator included for a standard propane tank",
      "Rugged job-site build typical of Milwaukee"
    ],
    "cons": [
      "Availability has been spotty, and some retailers list it as discontinued",
      "Like any forced-air propane heater, it is for ventilated work areas only"
    ],
    "bottomLine": "If you already run M18 and can find one in stock, it is the most heat you can put behind a tool battery, but buy it for a job site, not your house.",
    "description": "Milwaukee's M18 heater is what people usually mean when they search for an M18 heater: a forced-air propane unit whose fan runs on the same battery as your impact driver. It is rated from 30,000 up to 70,000 BTU through a variable dial, it weighs about 14.5 pounds without a battery, and it accepts either an M18 pack or an AC cord. Milwaukee's own launch materials talked about a full workday of runtime on a larger M18 battery, which tracks with the fact that the battery only powers the fan, igniter and controls while propane supplies the heat. The engineering is good. Controls sit on top where you can reach them in gloves, the hose wraps onto the frame, and the shell is built to take job-site abuse. The problem in late 2026 is finding one. The heater launched in 2023 and stock has been inconsistent since, with some retailers marking it discontinued. If you can buy one at a fair price and you are already invested in M18, it is an excellent garage and site heater. If you cannot, the RYOBI hybrid does the same job for less money, and DEWALT owners should look at DEWALT's own propane line. The same safety caveat applies as with every torpedo-style heater. This is a tool for open, ventilated work areas. It is not designed to warm a closed room during a winter outage, and it should never run in a basement, bedroom or tent. Use a carbon monoxide alarm whenever it is running anywhere near people."
  },
  {
    "id": "ororo-heated-vest",
    "name": "ORORO Men's or Women's Heated Vest with Battery",
    "category": "7.4V battery, 3-4 heating zones, about 35Wh pack",
    "badge": "Best Wearable Heat",
    "amazonUrl": "#",
    "pros": [
      "Puts heat directly on your core, where it does the most good",
      "Rated up to about 10 hours on low from the included pack, depending on the model",
      "USB port on the battery doubles as a phone charger in an outage",
      "Zero combustion, zero carbon monoxide, safe to wear while you sleep in a cold house",
      "Machine washable once the battery is removed"
    ],
    "cons": [
      "Warms only the wearer, not the room",
      "High setting drains the pack in about 3 hours"
    ],
    "bottomLine": "For most people searching for a rechargeable battery heater, a heated vest delivers more useful warmth per watt-hour than any battery space heater ever could.",
    "description": "A heated vest sounds like a dodge on a page about battery heaters, but it is the most efficient battery-powered heating you can buy. The math explains why. ORORO's standard pack holds about 35Wh. Pushed into a space heater, that would last about 80 seconds at 1,500W. Spread across carbon-fiber panels sitting against your chest and back, it lasts hours, because you are heating a few pounds of fabric and skin instead of thousands of cubic feet of air. ORORO is the reputable name in a category flooded with no-name copies. Its vests use a 7.4V battery and three or four heating zones, typically across the chest, upper back and sometimes the collar or pockets, with three heat levels. ORORO rates most models at about 3 hours on high, 5 to 6 hours on medium and 8 to 10 hours on low with the included battery, and a spare battery doubles that. In a winter power outage, a vest under a sweater lets you keep a house at 50 degrees without feeling miserable, and it is completely safe to wear while you sleep, which no combustion heater is. The battery's USB-A output can also top up a phone. The limitations are obvious. It heats one person, and the high setting burns through the pack quickly. Recharge it from a power bank, a power station or a car. If you are already in a tool ecosystem, Makita's DCJ205Z heated jacket and Milwaukee's M12 heated gear do the same thing using tool batteries that last far longer than a vest pack. For everyone else, buy an ORORO vest and a second battery."
  },
  {
    "id": "ocoopa-ut3-lite-hand-warmers",
    "name": "OCOOPA UT3 Lite Rechargeable Hand Warmers (2-Pack)",
    "category": "Two magnetic warmers, about 5,000mAh total",
    "badge": "Best Pocket Warmer",
    "amazonUrl": "#",
    "pros": [
      "Two warmers snap together magnetically and split for each pocket",
      "Three heat levels, with the top setting around 125 degrees F",
      "Rated up to about 8 hours on low",
      "USB-C charging, rechargeable hundreds of times instead of tossing chemical packs",
      "Small enough for a coat pocket, a glove or a sleeping bag"
    ],
    "cons": [
      "Real-world runtime on high is closer to 3 to 4 hours",
      "Cannot charge a phone like larger single-unit warmers can"
    ],
    "bottomLine": "Cheap, rechargeable and effective for hands and pockets; the right supplement to a vest or blanket, not a replacement for one.",
    "description": "Rechargeable hand warmers are the smallest legitimate battery heaters, and the OCOOPA UT3 Lite is the version we would buy. The set is two flat warmers that click together with magnets for charging and storage, then separate so each hand or pocket gets one. Combined capacity is about 5,000mAh, and OCOOPA rates them for up to roughly 8 hours on the low setting. Owners commonly report 4 to 7 hours depending on heat level and outdoor temperature, and you should expect the short end on high, which tops out around 125 degrees F. Charging is over USB-C, so the same power bank or power station that keeps your phone alive keeps these going. Why include hand warmers on a heater list at all? Because cold hands are what make people reach for a dangerous heat source during an outage, and keeping your extremities warm makes a cold room far more tolerable. Drop one in a sleeping bag 20 minutes before bed and it pre-warms the footbox. Tuck one in a jacket's chest pocket and it adds noticeable warmth to your core. They are also a far better long-term buy than disposable chemical packs if you hunt, fish, attend outdoor games or walk the dog at 6 a.m. The category is full of cheap clones with inflated mAh claims, and we prefer OCOOPA because it has been around long enough to have a track record and real customer support. Do not expect miracles: a hand warmer will not keep a room warm, and it is not meant to. As a 20-dollar-class add-on, though, it earns a place in every winter outage kit."
  },
  {
    "id": "stalwart-12v-heated-blanket",
    "name": "Stalwart 12V Electric Heated Blanket",
    "category": "12V car-socket blanket, 59 x 43 in, roughly 40-50W",
    "badge": "Best Battery-Friendly Blanket",
    "amazonUrl": "#",
    "pros": [
      "Draws only about 40 to 50 watts, per owners measuring it on power stations",
      "Plugs into a car socket or the 12V port on a power station, no inverter needed",
      "Large enough at 59 x 43 inches to wrap a seated adult",
      "Simple, cheap and easy to store in a car or outage kit",
      "No flame, no fumes, safe for sleeping under with sensible use"
    ],
    "cons": [
      "Basic on/off control on most versions, without fine temperature settings",
      "Lower heat output than a 120V plug-in electric blanket"
    ],
    "bottomLine": "Paired with any power station's 12V outlet, this is the longest-running battery heat source on the list: well over a night on a 1kWh unit.",
    "description": "The 12V heated blanket is the unsung hero of battery heating. Designed for cars, trucks and RVs, it runs from a cigarette-lighter style socket, which means it plugs straight into the 12V car port found on nearly every portable power station. That matters because it skips the inverter, which wastes power converting DC to AC. Stalwart does not publish an official wattage, but owners who have watched the draw on their power station screens consistently report about 40 to 50 watts. Do the arithmetic with a 1,024Wh station at about 85 percent usable, and you get roughly 17 to 22 hours of blanket time, compared with about 35 minutes for a 1,500W space heater. That is the whole case for heating yourself instead of the room in a single number. At 59 by 43 inches, the blanket covers a seated adult from shoulders to feet or lies over a sleeping bag. It is not as warm as a household 120V electric blanket on high, and it lacks a fancy controller, but it gets noticeably warm within minutes and holds that heat under a regular comforter. It also lives happily in a trunk as part of a winter car kit, where it can run off the car's battery while the engine idles. Do not run it from a parked car with the engine off for hours, or you may not start the car. The category has dozens of near-identical blankets under different brand names. We point to Stalwart because it is widely sold by mainstream retailers, but the key specs to check on any alternative are a 12V plug, a fuse in the plug and an automatic shutoff timer if you can get one."
  },
  {
    "id": "ecoflow-delta-2",
    "name": "EcoFlow DELTA 2 Portable Power Station",
    "category": "1,024Wh LiFePO4, 1,800W AC output",
    "badge": "Best Power Station for Heat",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh LiFePO4 battery rated for thousands of cycles",
      "1,800W AC output can technically start a 1,500W heater",
      "12V car port runs a heated blanket without inverter losses",
      "Expandable with an extra battery for longer outages",
      "Recharges from the wall in about an hour or from solar panels"
    ],
    "cons": [
      "Runs a 1,500W space heater for only about 35 minutes",
      "At about 27 lb, it is a carry-to-the-car item, not a backpack item"
    ],
    "bottomLine": "The right battery for blankets, vests and a low-watt heater on short bursts; pair it with personal heat, not a full-size space heater.",
    "description": "If you want an electric heater that runs on a rechargeable battery, a power station is the only battery big enough to try, and the DELTA 2 is the one we recommend for this job. It stores 1,024Wh in LiFePO4 cells, delivers 1,800W continuous from its AC outlets, weighs about 27 pounds and can be expanded with an add-on battery. It will run a 1,500W space heater. The catch is for how long. With about 85 percent of capacity usable through the inverter, you get roughly 870Wh, which is about 35 minutes of a heater on high. Drop the heater to a 750W low setting and you get a little over an hour. That is useful for taking the chill off a room before bed or warming a baby's room for a feeding, and it is not a plan for a night. We run the numbers in detail in our guide to whether a power station can run a space heater. Where the DELTA 2 shines is pairing it with low-draw heat. The 12V car outlet runs a 45W heated blanket for most of a day. The USB ports recharge heated vests and hand warmers many times over. A 60W household electric blanket on a low setting lasts well over 12 hours from the AC side. That combination keeps people warm through a long outage without combustion, fumes or fuel. LiFePO4 chemistry also makes it a safe battery to keep indoors. Recharge is fast from the wall when power returns, and solar panels can top it up during a multi-day outage. If you need more capacity, the DELTA 2 Max and DELTA Pro class are the next steps up."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Battery Powered Heaters",
          item: "https://www.thehonestreviewers.com/best-battery-powered-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is there a space heater that runs on a rechargeable battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not one that heats a room for long on battery alone. A 1,500W heater would drain a large tool battery in about five minutes. Heaters sold as battery powered either use the battery for a fan while propane makes the heat, like the DEWALT DXH12B, or produce only 10 to 60 watts. A power station can run a real heater briefly."
          }
        },
        {
          "@type": "Question",
          "name": "How long can a power station run a space heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide usable watt-hours by the heater's wattage. A 1,024Wh station with about 870Wh usable runs a 1,500W heater for roughly 35 minutes and a 750W setting for about 70 minutes. A 3,840Wh unit manages a little over two hours on high. That is fine for short bursts, not overnight heat."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best battery powered heater for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households, a mix: heated vests and a heated blanket for each person, powered by a power station, plus an indoor-rated radiant propane heater like the DEWALT DXH12B or a Mr. Heater Buddy for short, supervised room heat with a carbon monoxide alarm and a cracked window. That keeps people warm without depending on one fuel."
          }
        },
        {
          "@type": "Question",
          "name": "Is the DEWALT cordless propane heater safe indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It has an oxygen depletion sensor and a tip-over shutoff and is sold for indoor use in most of the US, but some places, including Massachusetts and Canada, restrict it to outdoor use. Indoors, keep a window cracked, keep three feet of clearance, never sleep with it running and always use a carbon monoxide alarm."
          }
        },
        {
          "@type": "Question",
          "name": "Does the Milwaukee M18 heater work without propane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The Milwaukee M18 forced-air heater, like the RYOBI and DEWALT models, uses its battery only for the fan, ignition and controls. Propane supplies all of the heat. Without a propane tank connected, it will just blow room-temperature air. It is also designed for ventilated work areas, not living spaces."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a heated vest battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ORORO rates most of its vests at about 3 hours on high, 5 to 6 hours on medium and 8 to 10 hours on low with the included 7.4V battery, which holds roughly 35Wh. Cold weather and using all zones on high shorten that. A second battery doubles runtime, and a power station can recharge a pack many times."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 12V heated blanket run from a power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is one of the most efficient ways to stay warm on battery. Plug it into the station's 12V car port to skip inverter losses. Owners commonly measure about 40 to 50 watts, so a 1,024Wh station runs one for roughly 17 to 22 hours, compared with about 35 minutes for a space heater."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "rechargeable battery powered heater",
      "heaters with rechargeable batteries",
      "battery powered room heaters",
      "battery space heater",
      "space heater battery powered",
      "battery powered electric heater",
      "battery power heater"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Battery Powered Heaters</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A true battery space heater barely exists, because room heat takes 1,500 watts and batteries run out in minutes. Here is what actually works: tool-battery propane heaters, heated wearables and blankets, and power stations used the smart way.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dewalt-dxh12b-cordless-radiant-heater"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
