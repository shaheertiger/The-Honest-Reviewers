    id: "thoroseal-waterproof-coating",
    name: "Thoroseal Waterproof Coating",
    category: "Cementitious Waterproof Coating",
    badge: "Best for Hydrostatic Pressure",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 5900,
    pros: [
