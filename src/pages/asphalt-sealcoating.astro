                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr class="bg-[#1E90FF]/5">
                                <td class="p-4 font-bold text-gray-900">DIY</td>
                                <td class="p-4 font-bold text-green-700">$80–150</td>
                                <td class="p-4">~6 hrs / weekend</td>
                                <td class="p-4">$0.13–0.25</td>
                            </tr>
