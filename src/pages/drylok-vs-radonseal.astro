---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Basement Wall Sealer",
    "url": "/best-basement-wall-sealer/"
  },
  {
    "title": "DRYLOK Review",
    "url": "/drylok-review/"
  },
  {
    "title": "DRYLOK vs Flex Seal",
    "url": "/drylok-vs-flex-seal/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-14", modified: "2026-09-14" });
const title = "DRYLOK vs RadonSeal: Which Basement Waterproofer Do You Need?";
const description =
  "DRYLOK coats the surface; RadonSeal penetrates and reacts inside the concrete. They solve different problems, and using the wrong one is why basement waterproofing fails.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "DRYLOK vs RadonSeal",
          item: "https://www.thehonestreviewers.com/drylok-vs-radonseal/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the difference between DRYLOK and RadonSeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DRYLOK is a waterproofing coating that forms a film on the surface of masonry and blocks water there. RadonSeal is a penetrating sodium silicate sealer that soaks in and reacts with the concrete to narrow the capillary pores from inside. One is visible and can peel; the other is invisible and cannot."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for a basement, DRYLOK or RadonSeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the wall and the problem. For concrete block walls where you also want a finished look, DRYLOK — it bridges variable porosity and can be tinted. For sound poured concrete that is simply transmitting moisture, RadonSeal is more durable because there is no film to fail."
          }
        },
        {
          "@type": "Question",
          "name": "Can DRYLOK stop water under hydrostatic pressure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Within its published rating, on sound masonry, it holds. But the film is only as strong as its weakest point, so a pinhole or thin spot concentrates the pressure and fails. If water actively enters after rain, the real fix is drainage — gutters, grading or the footing drain — not a coating."
          }
        },
        {
          "@type": "Question",
          "name": "Does RadonSeal actually reduce radon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sealing concrete closes one entry path for soil gas, and RadonSeal is formulated and marketed for that. It is not a mitigation system. If a radon test comes back high, sub-slab depressurisation installed by a certified contractor is the remedy; a sealer is a supporting measure at best."
          }
        },
        {
          "@type": "Question",
          "name": "Can I apply either over painted basement walls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Both require bare, clean masonry. A coating applied over old paint bonds to the paint rather than the wall, and the paint then becomes the failure point. A penetrating sealer cannot pass through paint at all. Strip back to bare masonry first or you are decorating rather than waterproofing."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint over DRYLOK or RadonSeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, both, once fully cured. DRYLOK is also available tinted, which saves a step if you want colour. With RadonSeal the concrete looks unchanged afterwards, so a finish coat is purely cosmetic and can be applied whenever the reaction is complete."
          }
        },
        {
          "@type": "Question",
          "name": "Will either fix a crack that leaks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A crack is a pathway rather than a porosity problem, and it needs routing and filling, or polyurethane injection if it is actively leaking. Sealing over a crack works until the next time it moves, which on a settlement crack may be the next wet season."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

