                <p class="text-gray-400 text-xs mt-1">Cost of a quality sealer</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">$4,000+</p>
                <p class="text-gray-400 text-xs mt-1">Avg granite countertop replacement</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">15min</p>
                <p class="text-gray-400 text-xs mt-1">Application time</p>
              </div>
              <div>
