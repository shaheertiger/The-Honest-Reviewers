  },
  {
    "id": "remington-solar-20w-attic-fan",
    "name": "Remington Solar 20 Watt Roof Mount Solar Attic Fan",
    "category": "Roof Mount, 20 W Solar",
    "badge": "Best for Small Attics and Garages",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 240,
    "pros": [
      "Sized for spaces up to 1,400 square feet, including garages and sheds",
      "Same brushless DC motor and powder-coated steel housing as the larger model",
