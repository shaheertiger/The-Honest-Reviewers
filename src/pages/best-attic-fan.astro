  {
    "id": "quietcool-afr-smt-es-2-0",
    "name": "QuietCool AFR SMT ES-2.0 Smart Roof Mount Attic Fan",
    "category": "Roof Mount, Plug-In, 3-Speed ECM",
    "badge": "Best Roof-Mount",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 130,
    "pros": [
      "Rated 1,950 / 1,394 / 889 CFM, with HVI-916 figures of 1,480 / 1,010 / 590 CFM",
