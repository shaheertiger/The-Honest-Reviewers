---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import SocialProof from '../components/SocialProof.astro';
import ScarcityBadge from '../components/ScarcityBadge.astro';
import UrgencyTimer from '../components/UrgencyTimer';
import ProductGallery from '../components/ProductGallery';

const PRODUCTS = [
  {
    id: 'mangroomer-platinum',
    name: 'Mangroomer Ultimate Pro',
    category: 'Electric Back Shaver',
    price: 49.99,
    rating: 4.8,
    reviewCount: 12450,
    badge: 'Best Overall',
    images: Array.from({ length: 12 }, (_, i) => `/images/mangroomer/gallery-${i + 1}.jpg`),
    amazonUrl: 'https://amzn.to/4hFfjcg',
    pros: ['Extendable arm reaches essentially anywhere', 'Shock absorber flex neck preventing irritation', 'Two distinct heads: Trimmer & Foil', 'Power boost button for thick patches'],
    cons: ['Charging can take up to 8 hours', 'Plastic build feels slightly hollow'],
    specs: {
      'Reach': 'Extends to 135 degrees',
      'Power': 'Lithium Max Battery',
      'Blade Type': 'Hypoallergenic Foil + Trimmer',
      'Warranty': '2 Years'
    },
    bottomLine: "The 'Swiss Army Knife' of back shavers. If you want one tool to do it all without asking for help, this is it.",
    description: "The Mangroomer Ultimate Pro isn't just a shaver; it's an engineering solution to the solitary man's problem. Its signature feature is the 'Power Burst' button—think of it as a turbo mode for particularly dense forests. Unlike manual razors that require you to learn the geography of your back muscles, the Mangroomer's multi-flex neck pivots to maintain contact with your skin, drastically reducing the 'yoga' required to reach that spot between your shoulder blades."
  },
  {
    id: 'bro-shaver-3',
    name: 'Bro Shaver 3.0',
    category: 'Manual Back Shaver',
    price: 13.99,
    rating: 4.5,
    reviewCount: 3200,
    badge: 'Best Budget Pick',
    images: ['https://placehold.co/600x400/333333/white?text=Bro+Shaver+3.0'],
    amazonUrl: 'https://amzn.to/4j3Y9Gy',
    pros: ['Uses standard DE safety razor blades (cheap refills)', 'Widest cutting head in class', 'Zero battery anxiety', 'Waterproof (because it’s manual)'],
    cons: ['Higher learning curve (can nick if careless)', 'No flex neck'],
    specs: {
      'Reach': '20-inch Handle',
      'Refills': 'Standard DE Blades (Pennies)',
      'Blade Type': '3-Blade Tech',
      'Warranty': '60-Day Money Back'
    },
    bottomLine: "The most economical choice long-term. Almost free to run, but requires a steady hand.",
    description: "The Bro Shaver 3.0 strips away the gimmicks. It is, effectively, a giant rake for your back. But that's its genius. By utilizing standard Double Edge (DE) safety razor blades, it solves the biggest scam in grooming: expensive proprietary cartridges. While competitors charge $20 for a refill pack, the Bro Shaver costs pennies to reload. It features a massive blade span, meaning fewer passes, but be warned: it lacks the safety guards of electric models, so respect the blade."
  },
  {
    id: 'bakblade-2',
    name: 'bakblade 2.0 Elite',
    category: 'Manual Back Shaver',
    price: 29.95,
    rating: 4.7,
    reviewCount: 8500,
    badge: 'Smoothest Shave',
    images: ['https://placehold.co/600x400/FF4500/white?text=bakblade+2.0'],
    amazonUrl: 'https://amzn.to/4j0CSNP',
    pros: ['DRYglide blades allow dry shaving without irritation', 'S-shaped ergonomic handle', 'Blades detach to use on chest/arms', 'Safety teeth technology'],
    cons: ['Proprietary blades are pricey', 'Bulky head can miss contours'],
    specs: {
      'Reach': '18-inch S-Shape',
      'Refills': 'Patented Cartridges',
      'Blade Type': 'DryGlide Technology',
      'Warranty': '30-Day Money Back'
    },
    bottomLine: "The closest you'll get to a barber's razor finish at home. The 'DryGlide' tech actually works.",
    description: "If the Bro Shaver is a rake, the bakblade 2.0 is a precision instrument. Its claim to fame is 'DryGlide' technology, designed to be used without shaving cream or water. Does it work? Surprisingly, yes. The patented blade cartridges are shielded by unique safety teeth that flatten the skin before the blade cuts the hair, mimicking the mechanics of a high-end safety razor. The S-shaped handle provides better leverage than straight sticks, allowing you to apply pressure exactly where needed."
  },
  {
    id: 'philips-norelco-5000',
    name: 'Philips Norelco Bodygroom 5000',
    category: 'Electric Body Groomer',
    price: 69.96,
    rating: 4.6,
    reviewCount: 35000,
    badge: 'Best For Sensitive Skin',
    images: ['https://placehold.co/600x400/228B22/white?text=Philips+Bodygroom+5000'],
    amazonUrl: 'https://amzn.to/4iDcI3V',
    pros: ['Truly waterproof (shower safe)', 'Rounded tips prevent scratches', 'Dual-sided design', ' Lithium-ion battery (1 hour run time)'],
    cons: ['Back attachment is a bit shorter than others', 'Takes longer than wide-blade manuals'],
    specs: {
      'Reach': 'Modular Extension Arm',
      'Power': 'Lithium-ion',
      'Blade Type': 'Hypoallergenic Foil',
      'Warranty': '5 Years'
    },
    bottomLine: "The gentle giant. Ideally suited for men with sensitive skin or prone to 'backne'.",
    description: "The Philips Norelco Bodygroom 5000 takes a different approach. Instead of raw cutting power, it prioritizes skin safety. It uses a hypoallergenic foil head with rounded tips, making it virtually impossible to cut yourself, even on moles or acne. While it may take a few more passes than the Mangroomer to clear a dense patch, the post-shave feel is unparalleled—zero burn, zero itch. Plus, it's fully waterproof, so you can handle your business in the shower where hot water softens the bristles."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://thehonestreviewers.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Best Lists",
          "item": "https://thehonestreviewers.com/best-of/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Best Back Shavers",
          "item": "https://thehonestreviewers.com/best-mens-back-shavers/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does shaving your back make the hair grow back thicker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. This is a common myth. Shaving blunts the tip of the hair, which may make it feel coarser as it grows out, but it does not alter the follicle's growth rate or thickness."
          }
        },
        {
          "@type": "Question",
          "name": "Is electric or manual better for back shaving?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manual shavers (like bakblade) offer a closer shave but have a higher risk of nicks. Electric shavers (like Mangroomer) are faster and safer for sensitive skin but may leave slight stubble."
          }
        }
      ]
    },
    ...PRODUCTS.map((product, index) => ({
      "@type": "Product",
      "name": product.name,
      "image": product.images[0],
      "description": product.description,
      "brand": {
        "@type": "Brand",
        "name": product.name.split(' ')[0]
      },
      "offers": {
        "@type": "Offer",
        "price": product.price,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": product.amazonUrl
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": product.rating,
        "reviewCount": product.reviewCount
      }
    }))
  ]
};
---

<Layout
  title="Best Back Shavers 2026: Goodbye Back Hair | The Honest Reviewers"
  description="We tested the top 4 manual and electric back shavers to find the only ones that don't require yoga to use. Detailed analysis, safety tests, and top picks."
  jsonLd={schema}
  stickyCta={{ text: "See #1 Top Pick", link: "#mangroomer-platinum" }}
>
  <!-- Hero Section -->
  <div class="relative bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="relative z-10 pb-8 bg-white sm:pb-16 md:pb-20 lg:max-w-2xl lg:w-full lg:pb-28 xl:pb-32">
        <main class="mt-10 mx-auto max-w-7xl px-4 sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
          <div class="sm:text-center lg:text-left">
            <TrustBadge />
            <h1 class="mt-4 text-3xl tracking-tight font-extrabold text-gray-900 sm:text-5xl md:text-6xl">
              <span class="block xl:inline">Ban Back Hair</span>
              <span class="block text-[#1E90FF] xl:inline">Without the Contortions</span>
            </h1>
            <p class="mt-3 text-base text-gray-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0">
              We tested the top contenders of 2026 to find the only tools that effectively clear the "impossible zone" between your shoulder blades—no flexible yoga partner required.
            </p>
            <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start gap-4">
              <div class="rounded-md shadow">
                <a href="#mangroomer-platinum" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-[#FF4500] hover:bg-[#E63E00] md:py-4 md:text-lg md:px-10 no-underline">
                  Reveal Top Pick
                </a>
              </div>
              <div class="mt-3 sm:mt-0 sm:ml-3">
                <a href="#comparison-table" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-[#1E90FF] bg-[#1E90FF]/10 hover:bg-[#1E90FF]/20 md:py-4 md:text-lg md:px-10 no-underline">
                  Compare All 4
                </a>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
    <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
      <img class="h-64 w-full object-cover sm:h-72 md:h-96 lg:w-full lg:h-full" src="https://placehold.co/800x600/333333/white?text=Confident+Man+Smiling" alt="Man with smooth back smiling confidently" />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Comparison Table -->
    <section id="comparison-table" class="mb-24 scroll-mt-24">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-black text-gray-900">Quick Comparison</h2>
        <UrgencyTimer client:visible />
      </div>
      <div class="overflow-x-auto rounded-xl shadow-lg border border-gray-200">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-widest text-gray-500">
              <th class="p-6 font-bold">Product</th>
              <th class="p-6 font-bold">Reach</th>
              <th class="p-6 font-bold">Blade Type</th>
              <th class="p-6 font-bold">Our Verdict</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            {PRODUCTS.map((p, i) => (
              <tr class={i === 0 ? "bg-blue-50/30" : "border-t border-gray-100"}>
                <td class="p-6">
                  <div class="font-bold text-gray-900 text-lg">{p.name}</div>
                  <div class="text-[#FF4500] font-bold">${p.price}</div>
                </td>
                <td class="p-6 text-sm text-gray-600 font-medium">{p.specs.Reach}</td>
                <td class="p-6 text-sm text-gray-600 font-medium">{p.specs['Blade Type']}</td>
                <td class="p-6">
                   <a href={`#${p.id}`} class="text-[#1E90FF] hover:underline font-bold text-sm">Read Review &rarr;</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Reviews -->
    <div class="space-y-32">
      {PRODUCTS.map((product, index) => (
        <section id={product.id} class="scroll-mt-24">
          <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Sticky Image Column -->
            <div class="lg:col-span-5 lg:sticky lg:top-24">
              <ProductGallery 
                client:visible 
                images={product.images} 
                productName={product.name} 
                badge={product.badge} 
              />
              
              <div class="mt-8 bg-gray-50 rounded-2xl p-6 border border-gray-200">
                <h4 class="font-bold text-gray-900 mb-4 uppercase tracking-widest text-xs">Technical Specs</h4>
                <dl class="space-y-3 divide-y divide-gray-200">
                  {Object.entries(product.specs).map(([key, value]) => (
                    <div class="pt-3 flex justify-between text-sm">
                      <dt class="text-gray-500 font-medium">{key}</dt>
                      <dd class="text-gray-900 font-bold">{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>

            <!-- Content Column -->
            <div class="lg:col-span-7">
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-4">
                 <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">{product.name}</h2>
              </div>

               <div class="flex items-center gap-4 mb-8">
                <div class="flex text-yellow-400">
                  {[...Array(5)].map((_, i) => (
                    <svg class={`w-5 h-5 ${i < Math.floor(product.rating) ? 'fill-current' : 'text-gray-300'}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="text-gray-500 font-medium">{product.reviewCount.toLocaleString()} Reviews on Amazon</span>
              </div>

              <!-- The Bottom Line Box -->
              <div class="bg-[#1E90FF]/5 border-l-4 border-[#1E90FF] p-6 mb-10 rounded-r-xl">
                <h3 class="flex items-center gap-2 text-[#1E90FF] font-black uppercase tracking-widest text-sm mb-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                  The Bottom Line
                </h3>
                <p class="text-gray-800 text-lg font-medium italic leading-relaxed">
                  "{product.bottomLine}"
                </p>
              </div>

              <div class="prose prose-lg text-gray-600 mb-10">
                <p>{product.description}</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <div>
                  <h4 class="font-bold text-green-700 flex items-center gap-2 mb-4 bg-green-50 p-2 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    Why We Love It
                  </h4>
                  <ul class="space-y-3">
                    {product.pros.map(pro => (
                      <li class="flex items-start gap-3 text-sm text-gray-700">
                        <span class="mt-1 w-1.5 h-1.5 bg-green-500 rounded-full flex-shrink-0"></span>
                        {pro}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-bold text-red-700 flex items-center gap-2 mb-4 bg-red-50 p-2 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    Dealbreakers
                  </h4>
                  <ul class="space-y-3">
                    {product.cons.map(con => (
                      <li class="flex items-start gap-3 text-sm text-gray-700">
                        <span class="mt-1 w-1.5 h-1.5 bg-red-400 rounded-full flex-shrink-0"></span>
                        {con}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- CTA Area -->
              <div class="flex flex-col sm:flex-row gap-4 items-center bg-gray-50 p-6 rounded-2xl border border-gray-100">
                <div class="flex-1">
                  <div class="text-3xl font-black text-gray-900 mb-1">${product.price}</div>
                  <SocialProof users="1,240+" />
                </div>
                <a href={product.amazonUrl} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transform transition hover:-translate-y-0.5 no-underline flex items-center justify-center gap-2">
                  Check Amazon Price
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                </a>
              </div>
              {product.id === 'bro-shaver-3' && <div class="mt-4"><ScarcityBadge count={5} /></div>}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Buying Guide -->
    <section class="mt-32 border-t border-gray-200 pt-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-gray-900 mb-12 text-center">Back Shaving Science 101</h2>
        
        <div class="grid gap-12">
          <div class="bg-blue-50 p-8 rounded-3xl">
            <h3 class="text-2xl font-bold mb-4 flex items-center gap-3">
              <span class="bg-blue-200 text-blue-800 p-2 rounded-lg">⚡</span>
              Electric vs. Manual: The Pain Equation
            </h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              The choice isn't just about price; it's about skin tolerance. Manual shavers like the <strong>Bro Shaver</strong> use open blades. They essentially exfoliate while they shave. If you have "backne" (back acne) or moles, this is a bloodbath waiting to happen.
            </p>
            <p class="text-gray-700 leading-relaxed">
              <strong>Electric shavers</strong> like the Mangroomer float over imperfections. They won't get as close—you'll feel stubble a day sooner—but you won't look like you wrestled a jaguar.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
             <div>
               <h3 class="text-xl font-bold mb-3">The "Reach" Factor</h3>
               <p class="text-gray-600">
                 The average human arm has a limited range of motion. To reach the T4 vertebrae (direct center of back), a handle needs to be at least 18 inches long with a 135-degree pivot. Anything less encourages "contortionist shaving," which leads to uneven pressure and cuts.
               </p>
             </div>
             <div>
               <h3 class="text-xl font-bold mb-3">Wet vs. Dry</h3>
               <p class="text-gray-600">
                 Common logic says "shave in the shower." For the back, this is tricky because mirrors fog up. The <strong>bakblade</strong> is designed specifically for dry shaving (no cream). It sounds insane, but the blade tech works better on dry, stiff hair than wet, limp hair.
               </p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-24 pt-16 border-t border-gray-200">
       <div class="max-w-3xl mx-auto">
         <h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Frequently Asked Questions</h2>
         <div class="space-y-6">
           <details class="group bg-gray-50 p-6 rounded-2xl cursor-pointer">
             <summary class="list-none flex justify-between items-center font-bold text-lg text-gray-900">
               Does hair grow back thicker?
               <span class="transition group-open:rotate-180">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
               </span>
             </summary>
             <p class="text-gray-600 mt-4 leading-relaxed">
               No. That is an old wives' tale. Shaving creates a blunt tip on the hair, which *feels* sharper as it emerges, but the actual diameter and density of the follicle remain unchanged.
             </p>
           </details>
            <details class="group bg-gray-50 p-6 rounded-2xl cursor-pointer">
             <summary class="list-none flex justify-between items-center font-bold text-lg text-gray-900">
               Can I do this myself or do I need help?
               <span class="transition group-open:rotate-180">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
               </span>
             </summary>
             <p class="text-gray-600 mt-4 leading-relaxed">
               All the tools on this list are designed for DIY use. The Mangroomer and bakblade are specifically engineered with extension arms so you never have to ask your partner (who likely hates doing it anyway) for help.
             </p>
           </details>
         </div>
       </div>
    </section>

  </div>
</Layout>
