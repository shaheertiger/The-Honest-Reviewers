                    <td class="px-4 py-4 text-gray-700">Moderate to high</td>
                    <td class="px-4 py-4 text-gray-700">Spas, occasional use, cold climates</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Propane</td>
                    <td class="px-4 py-4 text-gray-700">Fast (hours)</td>
                    <td class="px-4 py-4 text-gray-700">Strong</td>
                    <td class="px-4 py-4 text-gray-700">Highest</td>
                    <td class="px-4 py-4 text-gray-700">Homes with no gas line</td>
                  </tr>
