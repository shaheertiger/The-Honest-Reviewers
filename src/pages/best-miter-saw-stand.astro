  },
  {
    "title": "Best Bench Vises",
    "url": "/best-bench-vise/"
  },
  {
    "title": "Best Drill Presses",
    "url": "/best-drill-press/"
  },
  {
    "title": "Best Benchtop Planers",
    "url": "/best-benchtop-planer/"
