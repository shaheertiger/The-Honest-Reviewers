---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Exterior Caulk",
    "url": "/best-exterior-caulk/"
  },
  {
    "title": "Polyurethane vs Silicone Caulk",
    "url": "/polyurethane-vs-silicone-caulk/"
  },
  {
    "title": "Silicone vs Latex Caulk",
    "url": "/silicone-vs-latex-caulk/"
  },
  {
    "title": "Caulk vs Sealant",
    "url": "/caulk-vs-sealant/"
  },
  {
    "title": "How to Remove Old Caulk",
    "url": "/how-to-remove-old-caulk/"
  },
  {
    "title": "Best Caulk Guns",
    "url": "/best-caulk-gun/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Gutter Sealants for Seams, End Caps and Downspout Leaks";
const description =
  "Seven gutter sealants compared on aluminum, vinyl and steel, including which bond to damp metal, why silicone is a poor choice, and when to replace instead.";

const PRODUCTS = [
  {
    "id": "geocel-2320-gutter-seal",
    "name": "Geocel 2320 Tripolymer Gutter Seal",
    "category": "Tripolymer, 10.3 oz, Aluminum Gray / Clear / White",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 900,
    "pros": [
      "Formulated specifically for gutter seams, end caps and outlets rather than adapted from a general caulk",
      "Bonds to aluminum, galvanized steel, copper and vinyl without a primer",
      "Can be applied to damp surfaces, so you are not waiting for a dry week",
      "Flows slightly into seams, which gets sealant into the lap rather than just over it",
      "Aluminum gray color blends with most gutters, and it is paintable once cured"
    ],
    "cons": [
      "Solvent-based, with a strong odor and mineral-spirits cleanup",
      "Slow to reach full cure in cold weather, so avoid flushing the gutter for several days"
    ],
    "bottomLine": "The sealant we would reach for first on any leaking gutter seam or end cap, on any common gutter material.",
    "description": "Most gutter leaks happen at joints that sit in water, move with every temperature swing and are exposed to sun on one side and shade on the other, and a sealant has to handle all of that at once. Geocel formulated 2320 specifically for that job. It is a tripolymer, a solvent-based blend that stays elastic, resists ultraviolet light far better than acrylic caulk and bonds to aluminum, galvanized steel, copper and vinyl without a primer. That last point matters more than it sounds, because many homes have a mix of original steel sections and newer aluminum or vinyl repairs. The consistency is the other reason it leads. It is looser than a standard construction sealant, and on a horizontal seam it flows into the lap and around rivet heads rather than sitting on top as a ridge. That is exactly where a seam leaks. It will adhere to damp metal, so a gutter that has not fully dried after a rain is not a problem, although standing water and debris still need to come out. It skins over quickly but reaches full strength slowly, especially in cold weather, so give it several days before you flush the gutter with a hose. The drawbacks are the usual solvent ones: a strong smell and cleanup with mineral spirits rather than water."
  },
  {
    "id": "sashco-through-the-roof-sealant",
    "name": "Sashco Through the Roof Sealant",
    "category": "Synthetic Rubber, 10.5 oz, Clear",
    "badge": "Best for Wet Weather",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 2500,
    "pros": [
      "Sashco says it can be applied to wet surfaces and even during rain",
      "Can be applied at surface temperatures down to 0 degrees, well below most sealants",
      "Stays highly elastic, with a service range from about minus 25 to 180 degrees",
      "Dries clear, so it disappears on any gutter color",
      "Works on gutters, flashing, vents and chimneys, so one tube covers several roof-edge repairs"
    ],
    "cons": [
      "Stringy and sticky to apply, and messy without gloves and a solvent rag",
      "Clear finish looks glossy on a matte painted gutter"
    ],
    "bottomLine": "The pick when you need to stop a leak in wet or freezing weather and cannot wait for a dry, mild day.",
    "description": "Sashco markets Through the Roof as a sealant you can apply in the rain, and that is the case for owning a tube. It is a synthetic rubber sealant that bonds to wet surfaces and can be applied at surface temperatures from 0 to 120 degrees, which covers the late autumn and early winter period when gutter leaks tend to show up and most sealants are simply too cold to cure. Its service range runs from about minus 25 to 180 degrees, and it stays highly elastic after curing, so it moves with an aluminum gutter through a winter of freeze and thaw rather than tearing away at the edges. It dries clear, which makes it forgiving on white, brown or gray gutters alike, and Sashco lists gutters and downspouts alongside flashing, vents and skylights among its intended uses. A 10.5-ounce cartridge covers about 26 linear feet with a standard bead, which is enough for several seams and end caps. The downside is handling. It is stringy coming out of the tube and very sticky, so wear gloves, keep a rag with mineral spirits nearby and tool it quickly. On a matte painted gutter the clear glossy finish is noticeable up close. For a dry-weather repair we slightly prefer Geocel 2320, but when the leak cannot wait, this is the one to buy."
  },
  {
    "id": "dap-butyl-flex-gutter-sealant",
    "name": "DAP Butyl-Flex Gutter & Flashing Sealant",
    "category": "Butyl Rubber, 10.1 oz, Aluminum Gray / White",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1200,
    "pros": [
      "Butyl rubber grips metal tenaciously and stays tacky and flexible for years",
      "Covers about 56 linear feet with a 3/16-inch bead, excellent value per tube",
      "Performs from about minus 20 to 180 degrees",
      "Meets ASTM C1085, the standard specification for butyl rubber sealants",
      "Widely stocked and one of the least expensive gutter sealants available"
    ],
    "cons": [
      "Needs a dry surface; it will not bond reliably to wet or damp metal",
      "Picks up dirt and weathers faster in direct sun than a tripolymer"
    ],
    "bottomLine": "A solid, inexpensive choice for dry-day seam repairs on metal gutters, if you accept a shorter service life in full sun.",
    "description": "Butyl rubber has been sealing gutter seams and flashing for decades, and DAP Butyl-Flex is the most widely available version. Its strength is adhesion to metal. Butyl stays slightly tacky and very flexible, so it grips aluminum and galvanized steel and moves with them rather than cracking or pulling loose. DAP rates it for performance from about minus 20 to 180 degrees, and it meets ASTM C1085, the specification for butyl rubber sealants. It is also excellent value: DAP lists coverage of about 56 linear feet with a 3/16-inch bead, far more than you will need for a typical repair. Butyl has two real limits, and both are relevant to gutters. First, it needs a clean, dry surface. It does not have the damp-surface tolerance of tripolymers or synthetic rubber sealants, so pick a dry day and dry the joint with a rag before applying. Second, butyl picks up dirt and degrades faster in direct sunlight. Inside a gutter, where the sealant is shaded by the back wall and often covered by debris or a guard, that matters less than on exposed flashing. The consistency is stringy, so tool it quickly with a gloved finger dipped in mineral spirits. For a homeowner sealing a few seams on a dry autumn afternoon on a tight budget, it does the job well."
  },
  {
    "id": "amerimax-seamermate-gutter-sealant",
    "name": "Amerimax SeamerMate Gutter Sealant",
    "category": "Tripolymer, 10 oz, Gray",
    "badge": "Best for Inside Seams",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 500,
    "pros": [
      "Made by one of the largest residential gutter manufacturers, for its own products",
      "Semi-self-leveling, so it settles into horizontal seams and around connectors",
      "Amerimax says it can be applied in wet conditions",
      "UV resistant and paintable after about 24 hours",
      "Inexpensive and stocked alongside gutter parts in most home centers"
    ],
    "cons": [
      "Runny consistency makes it a poor choice for vertical joints such as downspout connections",
      "Gray is the only common color"
    ],
    "bottomLine": "A good match for sealing inside the trough, especially on Amerimax gutter systems, but not for vertical joints.",
    "description": "Amerimax makes a large share of the vinyl and aluminum gutter parts sold at home centers, and SeamerMate is the sealant it sells alongside them. Amerimax describes it as a tripolymer and as semi-self-leveling, and that consistency is both its strength and its limitation. On a horizontal joint inside the gutter trough, such as a slip connector, an end cap or the base of an outlet, it settles into the seam and flows around the edges of the connector, creating a continuous seal without much tooling. That is useful when you are working from a ladder and cannot easily reach in with a finger to press sealant into the joint. Amerimax says it can be applied in wet conditions, and it is UV resistant and paintable after about 24 hours. On a vertical joint, the same flow works against you. On the connection between a downspout and an elbow, or on the face of an end cap, it will sag and run before it skins over. For those joints, a non-sag sealant such as Geocel 2300 is the better choice. It is widely available next to the gutter parts in most home centers, which is convenient if you are replacing a connector or end cap at the same time. If your gutters are Amerimax, using its matched sealant is a sensible default."
  },
  {
    "id": "geocel-2300",
    "name": "Geocel 2300 Construction Tripolymer Sealant",
    "category": "Tripolymer, 10.3 oz, Non-Sag",
    "badge": "Best for Downspouts",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 2000,
    "pros": [
      "Non-sag body stays put on vertical joints, end cap faces and downspout connections",
      "Bonds to building surfaces even when damp",
      "Bridges gaps up to about 1/2 inch, wider than most gutter sealants",
      "Service range from about minus 40 to 180 degrees",
      "Resealable, so a later repair can go directly over it"
    ],
    "cons": [
      "Thicker consistency does not flow into horizontal seams as well as a gutter-specific sealant",
      "Solvent odor and slower cure than water-based products"
    ],
    "bottomLine": "The heavier, non-sag partner to Geocel 2320, and the better choice for vertical joints and wider gaps.",
    "description": "Geocel 2300 is the general-purpose version of the tripolymer used in 2320, and on a gutter job it is the product for the joints where a flowing sealant fails. It is a non-sag construction sealant, so it stays where you put it on vertical surfaces: the face of an end cap, the joint between a downspout and an elbow, or the connection where an outlet tube meets the downspout. Geocel lists a gap span of about 1/2 inch, which is wider than most gutter sealants handle, and a service range from about minus 40 to 180 degrees. Like 2320, it adheres to damp surfaces and resists ultraviolet light well, and it is resealable, meaning a future repair can go directly over it without scraping it all out. That is a real advantage over silicone, which nothing sticks to. The trade-off is flow. On a horizontal seam inside the gutter trough, 2300 sits on top of the joint unless you work it in firmly with a tool or gloved finger, and a gutter-specific sealant like 2320 or SeamerMate gets into the lap more easily. It is also a general construction sealant, useful for siding, trim and flashing repairs, so a tube rarely goes to waste. If you only buy one sealant for both horizontal seams and vertical downspout joints, this is the more versatile choice."
  },
  {
    "id": "red-devil-gutter-foundation-sealant",
    "name": "Red Devil Gutter & Foundation Butyl Rubber Sealant",
    "category": "Butyl Rubber, 10.1 oz, Gray",
    "badge": "Best Cold-Weather Butyl",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 400,
    "pros": [
      "Rated for a wide service range of about minus 40 to 225 degrees",
      "Butyl adhesion to aluminum and galvanized steel",
      "Skins over in about 2 hours, faster than many butyls",
      "Also useful below grade and on foundation joints, so one tube serves several jobs",
      "Budget-priced"
    ],
    "cons": [
      "Takes about 7 days to fully cure",
      "Like all butyls, needs a dry surface and weathers in direct sun"
    ],
    "bottomLine": "A dependable budget butyl with a wide temperature range, best for dry-day seam repairs you will not see.",
    "description": "Red Devil sells this butyl as a gutter and foundation sealant, and it makes a sensible alternative to DAP Butyl-Flex, particularly in cold climates. Red Devil rates it for a service range from about minus 40 to 225 degrees, which is wider than most butyl products, and the formulation stays flexible enough to handle the constant expansion and contraction of a metal gutter through a northern winter. It becomes tack-free in about 2 hours, which is quicker than many butyls, but full cure takes about 7 days. For a gutter repair, that means avoiding heavy rain for the first day and not flushing the gutter with a hose until it has cured. A 10.1-ounce cartridge covers about 30 linear feet. Like DAP Butyl-Flex, it needs a clean, dry surface to bond reliably, and it will collect dirt and weather faster than a tripolymer if it sits in direct sun. Inside the gutter, where most seams are shaded and hidden, that is acceptable. Its other advantage is versatility: it also works below grade, on basement and foundation joints, masonry and concrete. Cleanup is with mineral spirits. If you already have a tube for a foundation job, it is a perfectly good gutter sealant; if you are buying specifically for gutters, a tripolymer is the better investment."
  },
  {
    "id": "flex-tape-gutter-repair",
    "name": "Flex Tape Rubberized Waterproof Tape",
    "category": "Rubberized Patch Tape, 4, 8 and 12 in Widths",
    "badge": "Best for Holes",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 30000,
    "pros": [
      "Covers holes and rust-through spots that sealant alone cannot bridge",
      "Can be applied to wet surfaces",
      "Available in 4, 8 and 12-inch widths, wide enough to wrap a whole gutter cross-section",
      "Rated for application from about 20 to 120 degrees",
      "Quick and clean compared with cutting and riveting a metal patch"
    ],
    "cons": [
      "A temporary-to-medium-term fix; the thick backing can collect debris and eventually lift at the edges",
      "Black color is highly visible on white or light gutters"
    ],
    "bottomLine": "The fastest way to stop a leak through a hole or rusted spot, as a bridge until you can patch or replace the section.",
    "description": "Sealant is for joints. When a gutter has a hole, a split or a patch of rust-through, there is nothing solid for a bead of sealant to bridge, and that is where Flex Tape earns its place. It is a thick, rubberized tape with an aggressive adhesive that can be applied to wet surfaces, and it comes in 4, 8 and 12-inch widths, so a strip can be laid across a hole or wrapped around the entire cross-section of a gutter to cover a failed joint. Flex Seal rates it for application from about 20 to 120 degrees. For gutters, the value is speed. You can clean the area, press on a patch and stop a leak that is soaking the fascia or pouring onto a door step, all in about ten minutes. Be realistic about how long it lasts. The thick backing sits proud of the gutter floor, where it can catch leaves and grit, and on a gutter that is also rusting underneath, the edges eventually lift. In our view it is a very good medium-term bridge, not a permanent structural repair. For a lasting fix on aluminum, cut an aluminum flashing patch, set it in tripolymer sealant and rivet it. On a steel gutter with widespread rust, replace the section. The black tape is also very visible on white gutters."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gutter Sealants",
          item: "https://www.thehonestreviewers.com/best-gutter-sealant/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best sealant for gutter seams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tripolymer sealant made for gutters, such as Geocel 2320, is the best all-round choice. It stays flexible, bonds to aluminum, steel, copper and vinyl, and tolerates damp surfaces. For wet or freezing weather, Sashco Through the Roof is the better pick, and butyl sealants such as DAP Butyl-Flex are a good budget alternative on dry days."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use silicone to seal gutters?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We do not recommend it. Silicone bonds poorly to oxidized aluminum and dirty metal without a primer, cannot be painted and leaves a residue that no sealant sticks to. If it fails, every trace must be removed before a proper repair. Tripolymer and synthetic rubber gutter sealants are better suited to the job and easier to reseal later."
          }
        },
        {
          "@type": "Question",
          "name": "Can you apply gutter sealant when the gutter is wet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some products are designed for it. Sashco Through the Roof can be applied to wet surfaces, and Geocel tripolymers bond to damp metal. Butyl and silicone need a dry surface. With any product, remove standing water and debris and wipe the joint first; wet-tolerant means damp metal, not a puddle of sludge."
          }
        },
        {
          "@type": "Question",
          "name": "How long does gutter sealant last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A good tripolymer or synthetic rubber sealant applied to clean, bare metal can last many years, often ten or more on a shaded seam. Butyl tends to degrade sooner in direct sun. The biggest factor is preparation: sealant applied over dirt, oxide or old caulk may fail within a single winter regardless of the product."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal gutters from the inside or outside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "From the inside. Water fills the gutter from above and pushes against the inside of every joint, so a bead on the outside is forced off. Clean the inside of the joint, apply the sealant across the seam and up both walls, and press it in so it bonds to both pieces."
          }
        },
        {
          "@type": "Question",
          "name": "How do I fix a leaking gutter end cap?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean out the gutter end, scrape out the old sealant and wire brush the joint to bright metal. If the cap is loose, secure it with two or three aluminum pop rivets. Then run a bead of gutter sealant around the full inside perimeter of the cap, press it into the crimp, and seal over the rivet heads."
          }
        },
        {
          "@type": "Question",
          "name": "When should I replace a gutter instead of sealing it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Replace a section when the problem is widespread rather than local: rust-through at several points, cracked or brittle vinyl, several seams failing at once, sagging, or a gutter that holds standing water because it has lost its slope. Sealant is the right fix for one or two failed joints in otherwise sound gutter."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "best gutter sealant",
      "gutter seam sealer",
      "gutter leak repair",
      "tripolymer sealant",
      "butyl gutter sealant",
      "gutter end cap sealant"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Sealants Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Gutter Sealants</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A gutter seam that drips after one winter was usually sealed with the wrong product over a dirty joint. We compared tripolymer, butyl and rubber sealants on the three leaks that matter: seams, end caps and downspout outlets.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#geocel-2320-gutter-seal"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Find Your Leak Type
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#leak-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Find Your Leak Type First</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Tripolymer vs Butyl vs Silicone</a>
          <a href="#materials" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Aluminum, Vinyl, Steel and Copper</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cleaning and Prep</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How to Seal Seams, End Caps and Outlets</a>
          <a href="#wet-weather" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Sealing Wet, Dirty or Cold Gutters</a>
          <a href="#patch-vs-replace" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Patch or Replace the Section?</a>
          <a href="#make-it-last" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Making the Repair Last</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
