---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Gutter Guards", url: "/best-gutter-guards/" },
    { title: "Wet Basement Solutions", url: "/wet-basement-solutions/" },
    { title: "Best Pressure Washers", url: "/best-pressure-washer/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "How to Clean Gutters Before Winter";
const description =
  "Clogged gutters cause ice dams, overflowing water at the foundation and torn fascia. When to clean, how to do it safely, and the checks that matter more than the scooping.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "How to Clean Gutters Before Winter", item: "https://www.thehonestreviewers.com/how-to-clean-gutters-before-winter/" },
      ],
    },
    {
      "@type": "HowTo",
      name: "How to clean gutters before winter",
      totalTime: "PT3H",
      step: [
        { "@type": "HowToStep", name: "Set the ladder safely", text: "Use a stable ladder on firm level ground at roughly a 4:1 angle, with a stand-off so it rests on the roof rather than crushing the gutter." },
        { "@type": "HowToStep", name: "Scoop the debris", text: "Work from the downspout outward with a scoop or gloved hands, dropping debris into a bucket rather than onto the ground." },
        { "@type": "HowToStep", name: "Flush with a hose", text: "Flush from the far end toward the downspout and watch the flow to confirm the fall is correct and there are no leaks." },
        { "@type": "HowToStep", name: "Clear the downspouts", text: "Check every downspout runs freely, and clear blockages from the bottom with a hose or a drain auger." },
        { "@type": "HowToStep", name: "Inspect and repair", text: "Check hangers, seams, the fascia behind the gutter and the pitch, and fix what you find before the first freeze." },
        { "@type": "HowToStep", name: "Check the discharge point", text: "Confirm every downspout discharges well away from the foundation, not against the wall or onto a path that will ice over." },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "When should you clean gutters before winter?",
          acceptedAnswer: { "@type": "Answer", text: "After the last leaves have fallen but before the first hard freeze, which in most temperate climates means late autumn. Cleaning too early means doing it twice, and leaving it until the gutters are full of frozen debris means doing it in dangerous conditions or not at all. If you have heavy tree cover, plan on two visits: one mid-autumn and one after the leaves finish." },
        },
        {
          "@type": "Question",
          name: "What happens if you do not clean gutters before winter?",
          acceptedAnswer: { "@type": "Answer", text: "Three things, in ascending order of cost. Water overflows the gutter and lands at the foundation, which is a leading cause of basement water problems. Trapped water freezes, and the weight of ice pulls hangers loose and tears fascia. And blocked drainage at the eaves contributes to ice dams, where meltwater backs up under the shingles and into the roof structure." },
        },
        {
          "@type": "Question",
          name: "Do gutter guards mean you never clean gutters?",
          acceptedAnswer: { "@type": "Answer", text: "No, they reduce the frequency rather than eliminating the job. Guards keep out leaves and larger debris well, but fine grit, shingle granules, pine needles and seed pods accumulate underneath or on top of most designs, and the guards themselves need clearing. Expect to inspect annually and clean every two or three years rather than every autumn." },
        },
        {
          "@type": "Question",
          name: "Can you clean gutters with a pressure washer?",
          acceptedAnswer: { "@type": "Answer", text: "You can, with a gutter cleaning attachment operated from the ground, and it is far safer than working from a ladder with a wand in your hands. Two cautions: high pressure can damage seams, loosen sealant and drive water up under shingles at the eaves, and it makes an enormous mess. Scoop the bulk out first and use the washer for the final flush at moderate pressure." },
        },
        {
          "@type": "Question",
          name: "How do you stop ice dams forming?",
          acceptedAnswer: { "@type": "Answer", text: "Ice dams are primarily an attic heat problem rather than a gutter problem. Heat escaping into the attic melts snow on the upper roof, the meltwater runs down to the cold eave and refreezes, and the resulting ridge of ice backs water up under the shingles. The real fixes are attic insulation and air sealing plus adequate ventilation. Clear gutters help meltwater drain but will not prevent a dam on their own." },
        },
        {
          "@type": "Question",
          name: "Should downspouts be disconnected in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Not disconnected, but check where they discharge. An extension that dumps water onto a walkway creates an ice hazard, and one that discharges at the foundation feeds a basement water problem all winter. Route the discharge at least a metre and a half from the wall, onto ground that slopes away, and away from paths and steps." },
        },
        {
          "@type": "Question",
          name: "How often should gutters be cleaned?",
          acceptedAnswer: { "@type": "Answer", text: "Twice a year is the standard advice — spring and late autumn — but tree cover decides it. A house surrounded by deciduous trees or pines may need three or four visits a year, and a house with no overhanging trees may manage with one. The reliable test is to look: if you can see debris above the gutter line from the ground, it is overdue." },
        },
        {
          "@type": "Question",
          name: "Is it safe to clean your own gutters?",
          acceptedAnswer: { "@type": "Answer", text: "On a single-storey house with firm level ground and a good ladder, most people can do it safely with sensible precautions. On a two-storey house, on sloping or soft ground, or on a steep roof, the risk changes considerably — ladder falls are a leading cause of serious home-maintenance injuries. Hiring this one out is a reasonable decision, not a failure of nerve." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
