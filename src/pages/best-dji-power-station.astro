---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Portable Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Jackery Power Stations",
    "url": "/best-jackery-power-station/"
  },
  {
    "title": "Best EcoFlow Power Stations",
    "url": "/best-ecoflow-power-station/"
  },
  {
    "title": "Best Anker Power Stations",
    "url": "/best-anker-power-station/"
  },
  {
    "title": "Best Bluetti Power Stations",
    "url": "/best-bluetti-power-station/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "How Long Does It Take to Charge a Portable Power Station?",
    "url": "/how-long-does-it-take-to-charge-a-portable-power-station/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator?",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-24", modified: "2026-11-24" });
const title = "6 Best DJI Power Station Buys in 2026: Stations and Add-Ons";
const description =
  "The best DJI power station for camping, drones and home backup: Power 500, Power 1000, Power 1000 V2 and Power 2000 compared on capacity, output, charging and expansion.";

const PRODUCTS = [
  {
    "id": "dji-power-1000-v2",
    "name": "DJI Power 1000 V2",
    "category": "1024Wh LFP, 2600W Output, 0-80% in 37 Min, 10ms UPS",
    "badge": "Best Overall DJI",
    "amazonUrl": "#",
    "pros": [
      "2,600W stable output, per the listing, the most of any 1kWh DJI unit",
      "Recharges from 0 to 80 percent in 37 minutes on wall power, DJI says",
      "Seamless UPS with a 10 ms switch time, listed as twice as fast as the original Power 1000",
      "Dual 140W USB-C ports (280W total) for laptops and camera gear",
      "LFP battery with a listed 10-year lifespan and a 5-year warranty"
    ],
    "cons": [
      "MPPT and car charging modules are not built in; solar and car charging need an adapter",
      "The listing does not state weight, so check DJI's spec sheet",
      "The listing does not mention expansion batteries"
    ],
    "bottomLine": "The DJI Power station most people should buy: 1kWh, 2,600W, very fast wall charging and a quick UPS switchover.",
    "description": "The Power 1000 V2 is the DJI power station that fits the widest range of buyers. Its listing gives it a 1,024Wh LFP battery and 2,600W of stable output, which is more output than most 1kWh power stations from any brand and enough, by DJI's account, to run kettles, cookers, projectors, saws and drills. The spec that matters most for everyday use is charging speed: DJI lists 0 to 80 percent in 37 minutes from a wall outlet, so a unit that ran your fridge overnight can be most of the way full again before lunch. For home use, the V2 adds a seamless UPS function with a listed 10 ms switch time, which DJI says is twice as fast as the original Power 1000. That makes it a sensible battery backup for a router, desktop or CPAP. Content creators get dual 140W USB-C ports and SDC Super Fast Charging for select DJI drone batteries. The trade-offs are worth knowing. Solar panels and car sockets need a separate DJI adapter, because the listing says the MPPT and car charging modules are not built in. The listing also gives no weight, and it does not mention expansion, so treat 1kWh as the total. Buy the Power 2000 instead if you want expandable home backup, or the Power 500 if you only charge devices."
  },
  {
    "id": "dji-power-2000",
    "name": "DJI Power 2000",
    "category": "2048Wh LFP, 3000W Output, Expands to 22.5kWh, 15 Ports",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh LFP battery and 3,000W stable output, per the listing",
      "Expands to 22.5kWh with expansion batteries sold separately",
      "Recharges to 80 percent in 55 minutes, DJI says",
      "15 ports including dual SDC ports, for a whole camp or household",
      "Connects to the DJI Home app wirelessly, no Power Dongle needed"
    ],
    "cons": [
      "Solar and car charging need a separate adapter, per the listing",
      "Listed noise floor of 30 dB is the highest in the DJI lineup",
      "Weight is not on the listing and it is the biggest DJI unit"
    ],
    "bottomLine": "The DJI to buy for outages: 2kWh, 3,000W, a 10 ms UPS and room to grow to 22.5kWh.",
    "description": "The Power 2000 is DJI's home backup unit, and it is the only model here built to grow. Its listing gives it a 2,048Wh LFP battery and 3,000W of stable output, enough for a refrigerator, a microwave or a power tool, and it supports expansion up to 22.5kWh with DJI expansion batteries sold separately. DJI says a fully expanded system can power essential home devices for four to six days during a blackout; that figure depends heavily on what you plug in, so use it as an upper bound, not a promise. The spec that matters for outages is the combination of capacity and the UPS. The 10 ms switch time, listed as twice as fast as the original Power 1000, means a fridge, router or sump-pump controller keeps running when the grid drops. Wall charging is listed at 80 percent in 55 minutes, and there are 15 outputs, including dual SDC ports, plus wireless control through the DJI Home app without a separate dongle. The trade-offs: like the V2, it needs a separate adapter for solar panels and car charging; its listed minimum noise of 30 dB is louder than the smaller DJI units; and it is the largest model, though the listing does not state its weight. Buy the Power 1000 V2 instead if you need to carry it often."
  },
  {
    "id": "dji-power-500",
    "name": "DJI Power 500",
    "category": "512Wh LFP, 1000W Max Output, Full Recharge in 70 Min",
    "badge": "Best for Camping and Creators",
    "amazonUrl": "#",
    "pros": [
      "512Wh LFP battery rated for up to 4,000 cycles, per the listing",
      "Full recharge from the wall in 70 minutes, DJI says",
      "Dual two-way USB-C ports at up to 100W each",
      "Fast charges select DJI drone batteries with separately sold cables",
      "Listed as low as 25 dB while recharging"
    ],
    "cons": [
      "1,000W maximum output rules out kettles and most microwaves",
      "Half the capacity of the 1000-series units",
      "Drone charging cables are sold separately"
    ],
    "bottomLine": "The small DJI for weekend camping, drone shoots and charging devices, not for running a fridge for long.",
    "description": "The Power 500 is the DJI to buy when your loads are phones, laptops, cameras, drone batteries, lights and a small fan, rather than kitchen appliances. Its listing gives it a 512Wh LFP battery rated for up to 4,000 cycles and an approximately 10-year service life, with 1,000W of maximum output. That output figure is the one to check against your plans. It covers a laptop, a CPAP, a projector or a 12V cooler with room to spare, but a 1,500W kettle, a hair dryer or most microwaves will trip its protection. DJI lists a full recharge from the wall in 70 minutes and a solar recharge in 1.8 hours at maximum charging speed, which makes it easy to top up between campsites. Creators get dual two-way USB-C ports at up to 100W each, which also work as charging inputs, and the ability to fast charge select DJI drone batteries, such as the Mavic 3 and Air 3 series, with separately sold cables. DJI lists it as low as 25 dB while recharging. As a rough planning figure, 512Wh at 85 percent usable runs a 120W-average fridge for about three and a half hours, so it is not a home backup unit. Buy the Power 1000 V2 instead if you want to run appliances, or a 1kWh unit if you need two nights of CPAP with a heated humidifier."
  },
  {
    "id": "dji-power-1000",
    "name": "DJI Power 1000",
    "category": "1024Wh LFP, 2200W Output, Full Recharge in 70 Min, 800W Solar",
    "badge": "Best Original Model",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh LFP battery rated for up to 4,000 cycles, per the listing",
      "2,200W maximum continuous output",
      "Listed solar recharge in 1.35 hours with up to 800W input",
      "As low as 23 dB while recharging, the quietest figure in the lineup",
      "Five-year warranty by default, per the listing"
    ],
    "cons": [
      "Slower wall charging and UPS switchover than the V2",
      "Needs a separate adapter for solar and car charging",
      "Expansion requires a firmware update through DJI Assistant 2"
    ],
    "bottomLine": "The first-generation 1kWh DJI, still a capable unit when it costs clearly less than the V2.",
    "description": "The original Power 1000 is still sold new, and it remains a capable 1kWh power station. Its listing gives it a 1,024Wh LFP battery rated for up to 4,000 cycles and about 10 years of service life, 2,200W of maximum continuous output, and a full recharge from the wall in 70 minutes. Solar is listed at up to 800W of input for a 1.35-hour recharge at maximum speed, though, like the V2, the MPPT and car charging modules are not built in, so panels need a separate adapter. DJI also lists it as low as 23 dB while recharging, the quietest figure of any model here, and it passed SGS noise and product certification tests, according to the listing. The reason to buy it is simple: if it costs clearly less than the V2, you give up only a little. The V2 has 400W more output, recharges to 80 percent in 37 minutes, and has a UPS switchover DJI calls twice as fast, which matters for desktops and network gear. The original has the same capacity, so runtime is the same. One more point for future buyers: the DJI Expansion Battery 2000 listing names the Power 1000 as compatible, after a firmware update through DJI Assistant 2. Buy the V2 instead if prices are close, or if UPS use for computers is the main job."
  },
  {
    "id": "dji-power-1000-v2-car-combo",
    "name": "DJI Power 1000 V2 Car Charging & Storage Bag Combo",
    "category": "1024Wh LFP, 2600W, Car Charging Cable and Protective Bag Included",
    "badge": "Best for Road Trips",
    "amazonUrl": "#",
    "pros": [
      "Same 1,024Wh, 2,600W Power 1000 V2, per the listing",
      "Includes a Car Power Outlet to SDC Power Cable (12V/24V)",
      "Includes the DJI Power 1000 Protective Storage Bag",
      "Recharges from 0 to 80 percent in 37 minutes on wall power",
      "5-year warranty, per the listing"
    ],
    "cons": [
      "A car outlet charges far more slowly than a wall outlet",
      "Costs more than the bare V2; only worth it if you need both extras",
      "Still needs a separate adapter for solar panels"
    ],
    "bottomLine": "The Power 1000 V2 with the two extras van and car campers end up buying anyway: a 12V/24V car cable and a padded bag.",
    "description": "This is the same Power 1000 V2 as our top pick, sold as a separate listing with two accessories that road trippers usually need. The listing says the box includes the Power 1000 V2, the AC power cable, the DJI Power 1000 Protective Storage Bag and a DJI Power Car Power Outlet to SDC Power Cable rated for 12V and 24V. That matters because the V2's listing says car charging modules are not built in, so without a DJI cable you cannot recharge it from a vehicle at all. With this combo, the station can top up while you drive between campsites, then run lights, a laptop, a projector or a coffee maker when you stop. Everything else matches the standalone V2: a 1,024Wh LFP battery, 2,600W of output, 0 to 80 percent in 37 minutes from a wall outlet, a 10 ms UPS switchover, dual 140W USB-C ports and SDC fast charging for select DJI drone batteries, plus a listed 5-year warranty. The realistic caveat is speed. A car outlet supplies far less power than a wall socket, so think of driving as a steady top-up rather than a quick refill; the listing does not give a car charging time. It also costs more than the bare unit, so buy the standalone V2 instead if you will rarely charge from a vehicle."
  },
  {
    "id": "dji-expansion-battery-2000-combo",
    "name": "DJI Expansion Battery 2000 Combo",
    "category": "2048Wh LFP Add-On for Power 1000/2000, Stacks to 22.5kWh",
    "badge": "Best Add-On Capacity",
    "amazonUrl": "#",
    "pros": [
      "Adds 2,048Wh in a 23.5-liter body, per the listing",
      "Stack up to ten for capacity options from 3,072 to 22,528Wh",
      "1,500W input charges 1,024Wh in 46 minutes, DJI says",
      "Ports on one side for neat stacking",
      "Rated for 4,000 cycles"
    ],
    "cons": [
      "Not a standalone power station: it must connect to a Power 1000 or Power 2000",
      "Power 1000 owners need a firmware update through DJI Assistant 2 first",
      "The listing does not confirm compatibility with the Power 1000 V2"
    ],
    "bottomLine": "The way to turn a Power 2000 or original Power 1000 into multi-day backup without buying a second station.",
    "description": "The Expansion Battery 2000 is not a power station on its own, and that is the first thing to understand before buying it. Its listing says it must be used with a DJI Power 1000 or Power 2000; it has no outlets of its own. What it does is add 2,048Wh of LFP capacity in a 23.5-liter body, about the size of the Power 1000, and it stacks: DJI lists up to ten batteries for capacity options from 3,072Wh to 22,528Wh. The 3,072Wh figure is a Power 1000 plus one expansion battery. For home backup, that is the number that matters. As a rough planning figure, a Power 2000 plus one expansion battery holds about 4kWh, enough at 85 percent usable to run a 120W-average refrigerator for well over a day. DJI lists 1,500W of charging input, enough to put 1,024Wh into it in 46 minutes, and 4,000 cycles. The listing's 3,000W output figure refers to the system, so the station you pair it with sets your real output. Read the compatibility notes carefully. Power 1000 owners must update firmware through the DJI Assistant 2 desktop software over a wired connection first, while the Power 2000 does not need that step. The listing does not name the Power 1000 V2, so check DJI's compatibility list before buying one for a V2."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best DJI Power Stations",
          item: "https://www.thehonestreviewers.com/best-dji-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best DJI power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the DJI Power 1000 V2 is the best DJI power station. Its listing gives 1,024Wh of LFP capacity, 2,600W of output, 0 to 80 percent charging in 37 minutes and a 10 ms UPS switchover. Choose the Power 2000 for expandable home backup, or the Power 500 if you mainly charge devices and drone batteries."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the DJI Power 1000 and 1000 V2?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both hold 1,024Wh. The V2 is listed at 2,600W of output against 2,200W, recharges to 80 percent in 37 minutes against a full recharge in 70 for the original, and has a UPS switchover DJI calls twice as fast. The V2 listing also highlights dual 140W USB-C ports. Runtime for a given load is the same."
          }
        },
        {
          "@type": "Question",
          "name": "Is the DJI Power 2000 expandable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The DJI Power 2000 listing says it supports expansion up to 22.5kWh with DJI expansion batteries, which are sold separately. Each Expansion Battery 2000 adds 2,048Wh, and up to ten can be stacked. Expansion adds runtime only; the Power 2000's own 3,000W inverter still sets how much you can run at once."
          }
        },
        {
          "@type": "Question",
          "name": "Can a DJI power station run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the 1000-series and Power 2000 can. As a rough planning figure, a 120W-average fridge runs about seven hours on a 1kWh unit and about fourteen on the Power 2000, assuming 85 percent usable capacity. The Power 500 can run one only briefly. Check your fridge's actual draw; older models use much more."
          }
        },
        {
          "@type": "Question",
          "name": "Do DJI power stations have built-in solar charging?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They charge from solar, but the Power 1000, 1000 V2 and 2000 listings say the MPPT and car charging modules are not built in. You need DJI's separate solar panel adapter module between the panels and the station's SDC port. Include that adapter in your budget when comparing DJI with other brands."
          }
        },
        {
          "@type": "Question",
          "name": "Is the DJI Power 1000 Mini sold on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not find a new Amazon US listing for the DJI Power 1000 Mini when we checked, only accessories for it. DJI's website lists it at 1,008Wh. If it becomes available, compare its output and ports with the Power 1000 V2, which has the same class of capacity and a listed 2,600W output."
          }
        },
        {
          "@type": "Question",
          "name": "How long do DJI power stations last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Power 500 and Power 1000 listings rate their LFP batteries for up to 4,000 cycles and about 10 years of service life, and the Power 1000 V2 listing also cites a 10-year lifespan. Most listings include a 5-year warranty. Storing the unit cool and partly charged helps the battery last."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best dji power station",
      "dji power 1000",
      "dji power 2000",
      "dji power 1000 v2",
      "dji power 500",
      "dji power station",
      "dji power 1000 mini",
      "dji generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">DJI Power Stations</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          DJI's Power series grew out of drone charging and now runs fridges and home offices. Every DJI Power station sold new on Amazon, compared on output, charging speed and expansion.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dji-power-1000-v2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which DJI Size?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#lineup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The DJI Lineup Compared</a>
          <a href="#1000-vs-v2" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Power 1000 vs 1000 V2</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 6 Best DJI Buys</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Which Size You Need</a>
          <a href="#home-backup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Home Backup</a>
          <a href="#solar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Solar Charging</a>
          <a href="#drones" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Charging DJI Drones</a>
          <a href="#road-trips" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Car Charging</a>
          <a href="#vs-brands" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. DJI vs Other Brands</a>
          <a href="#warranty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Warranty and Care</a>
          <a href="#generator" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Is It a Generator?</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          DJI makes four power stations sold new on Amazon in the US, plus an expansion battery, and the differences between them come down to output, charging speed and whether you can add capacity later. This guide compares the Power 500, Power 1000, Power 1000 V2 and Power 2000, explains the solar adapter catch, then ranks six real listings.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The DJI Power Lineup Compared: 500, 1000, 1000 V2 and 2000
          </h2>

          <p>
            DJI came to portable power from drones, and its Power series still shows it: every model fast charges select DJI drone batteries through its SDC ports. But the bigger units are general-purpose power stations that compete with Jackery, EcoFlow, Anker and Bluetti for camping and home backup. Four stations are sold new on Amazon in the US, plus an expansion battery. All use LFP (lithium iron phosphate) cells, the long-life chemistry that is now standard for power stations.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">DJI Power 500</h3>

          <p>
            The entry model holds 512Wh and puts out 1,000W at most, per its listing. It is a device charger and camping unit, not an appliance runner.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">DJI Power 1000 and 1000 V2</h3>

