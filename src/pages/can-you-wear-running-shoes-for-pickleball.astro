                    <td class="px-4 py-4 text-gray-700">Flat, wide, multidirectional pattern</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Designed for</td>
                    <td class="px-4 py-4 text-gray-700">Repeated forward strides</td>
