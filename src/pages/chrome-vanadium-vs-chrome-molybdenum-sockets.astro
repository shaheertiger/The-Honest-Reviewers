                    <td class="px-4 py-4 font-black text-gray-900">Typical finish</td>
                    <td class="px-4 py-4 text-gray-700">Polished chrome</td>
                    <td class="px-4 py-4 text-gray-700">Black oxide or phosphate</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Driven by</td>
                    <td class="px-4 py-4 text-gray-700">Hand ratchets, breaker bars, torque wrenches</td>
                    <td class="px-4 py-4 text-gray-700">Impact wrenches, air tools, impact drivers</td>
                  </tr>
