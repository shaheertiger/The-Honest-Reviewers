const title = "7 Best Electric Pressure Washers in 2026: Tested";
const description =
  "We ran 11 electric pressure washers on siding, decks, cars, and concrete for a full season. Induction versus universal motors, real PSI, and which ones actually last.";

const PRODUCTS = [
