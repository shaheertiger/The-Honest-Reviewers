---
import Layout from "../layouts/Layout.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";

const title = "7 Best Electric Pressure Washers in 2026: Tested";
const description =
  "We ran 11 electric pressure washers on siding, decks, cars, and concrete. Induction versus universal motors, and which ones actually last.";

const PRODUCTS = [
  {
    id: "ryobi-ry142300-electric",
    name: "Ryobi RY142300 2300 PSI Brushless",
    category: "2300 PSI, 1.2 GPM, Brushless Induction Motor",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 15600,
    specs: {
      motor: "Brushless induction",
      pump: "Axial cam",
      psi: "2300 PSI",
      gpm: "1.2 GPM",
      cleaningUnits: "≈2,760",
      weight: "~55 lb",
      warranty: "3 years",
      price: "$330-400",
    },
    pros: [
      "Brushless induction motor is quiet, runs cool, and lasts far longer than universal motors",
      "2300 PSI is genuinely high for electric, handling siding, decks, fences, and light concrete",
      "On-board storage for hose, cord, wand, and all five nozzles keeps everything together",
      "Quiet enough to run in a driveway without disturbing the whole street",
      "Solid frame with real wheels rather than the small plastic casters on cheap units",
