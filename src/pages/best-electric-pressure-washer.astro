const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Electric Pressure Washers",
          item: "https://www.thehonestreviewers.com/best-electric-pressure-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best electric pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Ryobi RY142300 is the best overall, combining 2300 PSI with a brushless induction motor that runs quiet and lasts far longer than the universal motors in budget machines. For the most cleaning power, the Greenworks Pro GPW3000 at 3000 PSI genuinely handles concrete. For vehicles and delicate surfaces, the Karcher K5 Premium Smart Control is the safest and most refined.",
          },
        },
        {
          "@type": "Question",
          name: "Are electric pressure washers powerful enough?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For siding, fences, decks, patio furniture, and vehicles, absolutely. A quality electric machine at 2000 PSI and above handles all of that comfortably and more safely than a high-output gas unit. Large flat concrete is where they fall short, because their 1.2 to 2.0 GPM water volume is well below a gas machine 2.4 to 3.5 GPM.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between induction and universal motors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Universal motors use carbon brushes, spin fast, and are light and cheap, but they run hot and loud and typically last a few seasons of regular use. Induction motors are brushless, heavier, quieter, run cool, and last for thousands of hours. Motor type is the strongest predictor of how long an electric pressure washer lasts.",
          },
        },
        {
          "@type": "Question",
          name: "Why is my pressure washer pulsing or losing pressure?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Almost always inadequate water supply causing cavitation. Check that the spigot is fully open, that the garden hose is at least 5/8-inch and not kinked or excessively long, and that the inlet screen is not clogged with grit. Purge air from the system by squeezing the trigger before starting the machine.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to winterize an electric pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. There is no engine, but the pump still holds water, and water freezing inside cracks the housing, which is a terminal failure on most consumer machines. Draw pump saver antifreeze through the unit after the last use of the season and store it above freezing where possible.",
          },
        },
        {
          "@type": "Question",
          name: "What PSI is safe for washing a car?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 1,500 PSI or less with a 40-degree nozzle, held at least two feet from the surface, and never aimed directly at seals, badges, or trim. Machines with surface-specific pressure control, like the Karcher Smart Control system, set an appropriate level automatically and make accidental damage much less likely.",
          },
        },
        {
          "@type": "Question",
          name: "What does PSI Max mean on a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "PSI Max and GPM Max are marketing figures some brands measure inside the machine rather than at the nozzle, so you never experience them while cleaning. Look instead for PWMA or CETA certification, which means an independent standard governs how the pressure and flow figures were measured and reported.",
          },
        },
        {
          "@type": "Question",
          name: "What are cleaning units on a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Cleaning units are PSI multiplied by GPM, and they are the single best number for comparing two machines because they account for both pressure and water volume. Most electric pressure washers land between 2,800 and 6,000 cleaning units, while entry-level gas machines start around 6,000.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: "2026-08-23",
      dateModified: "2026-08-23",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---
<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-08-23",
    modifiedTime: "2026-08-23",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "electric pressure washer",
      "pressure washer",
      "induction motor",
      "car washing",
      "siding cleaning",
      "home improvement",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Electric Pressure Washers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We ran 11 electric pressure washers across siding, decks, vehicles, and concrete for a full season, measuring real output and watching which motors survived. Only 7 earned a spot.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ryobi-ry142300-electric"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#cleaning-units"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Induction vs Universal Motors
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">August 23, 2026</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
