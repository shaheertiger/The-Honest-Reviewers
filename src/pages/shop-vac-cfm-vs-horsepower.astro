const moreInCategory = [
  {
    "title": "Best Shop Vacs Tested and Ranked",
    "url": "/best-shop-vac/"
  },
  {
    "title": "Shop Vac vs Regular Vacuum",
    "url": "/shop-vac-vs-regular-vacuum/"
  },
  {
    "title": "Best Drywall Sander",
    "url": "/best-drywall-sander/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-11", modified: "2026-09-11" });
const title = "Shop Vac CFM vs Horsepower: Which Numbers Actually Matter";
const description =
  "Peak horsepower on a shop vac is a stalled-motor lab figure that exceeds what your outlet can supply. Here is what CFM, water lift and air watts really tell you.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Shop Vac CFM vs Horsepower",
          item: "https://www.thehonestreviewers.com/shop-vac-cfm-vs-horsepower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is peak horsepower on a shop vac real?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in any useful sense. Peak horsepower is measured at the moment the motor stalls, with no hose, filter or tank restriction. A standard 120V 15-amp outlet can only supply about 2.4 horsepower in theory, so any claim above that describes a laboratory condition rather than the machine you plug in. Compare CFM and water lift instead."
          }
        },
        {
          "@type": "Question",
          "name": "What is more important, CFM or water lift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the job. CFM \u2014 airflow \u2014 is what carries bulk debris such as wood chips, leaves and general mess up the hose, and it matters most for everyday cleanup. Water lift is sealed suction, and it matters when the air path is restricted: pulling water out of carpet, or extracting through a narrow power tool port."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good CFM for a shop vac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eighty to 130 CFM covers general garage and household work. Under 80 suits fine dust and car interiors only. Above 130 handles wood chips, leaves and water comfortably, and 180 or more is job-site territory. Remember published figures are measured without a hose, so a narrow hose will cost a significant share of it."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good water lift figure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sixty to 80 inches of water lift is the practical sweet spot for household and garage use. Forty to 60 is budget territory and will feel weak pulling water. Eighty to 100 inches suits wet extraction and power tool dust collection, where the air path is restricted and sealed suction matters more than raw airflow."
          }
        },
        {
          "@type": "Question",
          "name": "What are air watts on a vacuum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Air watts combine airflow and suction into one figure representing the work the machine does on air, which makes it more honest than either number alone and far more honest than peak horsepower. Roughly, 200 air watts is modest, 350 is solid for home use, and 500-plus is professional. It is still a clean-filter laboratory figure."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my shop vac seem weaker than its specs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Almost always the filter. A cartridge loaded with fine dust can halve airflow, and it happens faster than people expect on sanding or drywall work. After that, check for a partially blocked hose, a full tank, a loose hose cuff or a perished tank gasket \u2014 air leaking into the system never reaches the nozzle."
          }
        },
        {
          "@type": "Question",
          "name": "Do more amps mean a better shop vac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not reliably. Amperage describes what the motor draws, not what it delivers, and an inefficient 12-amp motor can move less air than an efficient 10-amp one. It is a useful sanity check against inflated horsepower claims, but airflow, water lift and air watts are the figures that describe performance."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
