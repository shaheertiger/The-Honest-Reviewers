      "30-inch deck is about 40 percent wider than a 21-inch mower",
      "Personal Pace self-propel matches your walking speed",
      "Handles slopes and tight spaces better than riders",
      "Far cheaper and easier to store than a riding mower"
    ],
    "cons": [
      "Still a walk, so tiring past about an acre",
      "140 lb is heavy to maneuver in tight corners",
      "1.2-quart tank lasts about an hour, per Toro"
    ],
    "bottomLine": "For half an acre to an acre, especially with slopes, the TimeMaster 30 is the smarter buy than a riding mower."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
