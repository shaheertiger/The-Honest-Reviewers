    "title": "What Size Riding Mower Do I Need?",
    "url": "/what-size-riding-mower-do-i-need/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Lawn Mowers for Large Yards: Picks From Half an Acre to Four Acres";
const description =
  "The best lawn mowers for large yards, matched by acreage: a wide walk-behind, lawn and garden tractors, a gas zero-turn and two battery riders rated past two acres.";

const PRODUCTS = [
  {
