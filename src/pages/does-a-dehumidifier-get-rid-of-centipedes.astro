                    <td class="px-4 py-4 text-gray-700">Clean drains, dry the source</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Centipedes only</td>
                    <td class="px-4 py-4 text-gray-700">Small resident population</td>
