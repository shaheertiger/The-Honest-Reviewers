const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Garage Floor Crack Repair",
          item: "https://www.thehonestreviewers.com/garage-floor-crack-repair/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do I have to fix garage floor cracks before epoxy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For anything wider than a hairline, yes. Epoxy films are thin and follow the surface exactly, so open cracks show through as lines or dips and are common starting points for peeling. Hairline cracks can often be handled by the primer coat, but cracks you can catch a fingernail in should be chased, filled and ground flush first."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best filler for garage floor cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For dormant cracks under a coating, a rigid two-part epoxy or a fast polyurea crack filler that is rated to be ground and coated over. For control joints and cracks that are still moving, a flexible polyurea or polyurethane joint filler is better. Our pillar guide ranks specific crack fillers by the kind of crack they suit."
          }
        },
        {
          "@type": "Question",
          "name": "Should I fill the control joints in my garage floor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can fill them, but not with rigid epoxy. Use a semi-rigid or flexible joint filler that allows movement, or coat into the joint and leave it open. Some installers fill, coat over for a seamless look and then saw-cut the joint again. Bridging a joint with rigid material usually causes a new crack in the coating."
          }
        },
        {
          "@type": "Question",
          "name": "How long should crack filler cure before coating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends entirely on the product and the slab temperature. Fast polyurea fillers often grind cleanly within about an hour at room temperature, while two-part epoxies usually need overnight or longer in a cold garage. Cement-based patches can need days. Follow the label, and measure the floor temperature rather than the air."
          }
        },
        {
          "@type": "Question",
          "name": "Will cracks come back through new epoxy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dormant cracks that are chased, filled and ground flush usually stay hidden. Cracks that are still moving will reflect through any rigid coating, typically appearing as a new hairline along the repair. If a crack reopens after one repair, treat it as an active crack and switch to a flexible joint treatment."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use regular concrete caulk on a garage floor I plan to coat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Many flexible caulks and self-leveling sealants are not designed to be coated over, and some prevent epoxy from bonding at all. They are excellent for exposed joints and outdoor slabs. Under a coating, use a crack filler the coating manufacturer approves, or test a small area before committing the whole floor."
          }
        },
        {
          "@type": "Question",
          "name": "When is a garage floor crack a structural problem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Worry when one side sits more than about 1/8 inch higher than the other, when cracks widen over months, when a section of floor is visibly sinking, or when the door no longer seals at the bottom. Those point to settlement, heave or washed-out fill beneath the slab, which need attention before any cosmetic repair or coating."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
