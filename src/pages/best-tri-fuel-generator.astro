  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Tri-Fuel Generators",
          item: "https://www.thehonestreviewers.com/best-tri-fuel-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best tri-fuel generator in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The DuroMax XP13000HXT is our overall pick — roughly 10,000 peak watts even on natural gas, enough for near whole-panel coverage including a well pump and central air. For most households, the Firman T07571 offers a better balance of output and price, and the Champion 8750 is the choice if long-term parts and service support matter most.",
          },
        },
        {
          "@type": "Question",
          name: "How much power do you lose on natural gas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically 20-25% below the gasoline rating, the largest derate of the three fuels, because natural gas delivers the least energy per unit volume to the cylinder. A generator rated 13,000 peak watts on gasoline delivers roughly 10,000 on natural gas. Always size against the natural gas figure, since that is the fuel you will use during long outages.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to connect a generator to natural gas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically $400-900 for a licensed gas fitter to run a properly sized line to an outdoor quick-connect near the generator's location, plus permit fees. Cost rises with distance from the meter. If your meter cannot supply the generator's demand on top of existing appliances, a utility meter upgrade may be needed.",
          },
        },
        {
          "@type": "Question",
          name: "Is a tri-fuel generator better than a standby generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It costs far less — roughly $1,500-3,000 all in versus $9,000-13,000 installed for a standby unit — and connected to natural gas it offers the same unlimited runtime. What you give up is automation: you must go outside, start it, and switch circuits manually. For households willing to do that, the value is genuinely strong.",
          },
        },
        {
          "@type": "Question",
          name: "Can I connect a generator to my barbecue gas line?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. A large generator consumes many times what a grill does, and a barbecue quick-connect and its supply line are not sized for that demand. An undersized line produces a generator that starts and then stumbles under load. You need a properly sized line and fitting installed by a licensed gas fitter, using the generator's specification sheet.",
          },
        },
        {
          "@type": "Question",
          name: "What happens if natural gas service is interrupted?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "That is exactly why tri-fuel is more useful than a natural-gas-only generator. Earthquakes, severe storms, and infrastructure damage can interrupt gas service, and utilities sometimes shut it off preemptively in disaster areas. Keep two or three propane tanks on hand as backup so a gas interruption does not leave you without power.",
          },
        },
        {
          "@type": "Question",
          name: "Do tri-fuel generators need a transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In practice, yes. A generator plumbed to a fixed gas connection is effectively a permanent installation, which makes extension cords through a window impractical and limiting. A manual transfer switch or interlock kit — $500-1,500 installed — lets it power hardwired circuits like the furnace and well pump, and it is the only safe and legal way to connect to house wiring.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Emergency Preparedness",
    tags: [
      "best tri fuel generator",
      "tri fuel generator",
      "natural gas generator",
      "propane generator",
      "portable generator",
      "emergency power"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 5 Best <span class="text-[#38BDF8]">Tri-Fuel Generators</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Gasoline for maximum output, propane for storage, natural gas for unlimited runtime from your house line. We tested five on all three fuels.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#duromax-xp13000hxt"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#natural-gas-hookup"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Natural Gas Hookup Guide
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-tri-fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why Tri-Fuel</a>
          <a href="#fuel-comparison" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Fuel Comparison</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 5 Top Picks</a>
          <a href="#natural-gas-hookup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Natural Gas Hookup</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Sizing Guide</a>
          <a href="#fuel-costs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Fuel Cost Comparison</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Safety & Maintenance</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A tri-fuel generator adds one capability to the dual fuel formula, and it is the most valuable one: the ability to run on natural gas from your existing house line. That single feature removes refueling from the equation entirely — no gas cans, no tank swaps, no rationing during a five-day outage. It is the closest a portable generator gets to a standby system, for a fraction of the installed cost. Here are the five worth buying, and exactly what the natural gas hookup involves.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- SECTION 1: Why the Third Fuel Changes Everything -->
        <div id="why-tri-fuel" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Why the Third Fuel Changes Everything
          </h2>

          <p>
            Portable generators have one universal weakness during long outages: someone has to keep feeding them. A 9,000-watt unit burns through a full tank of gasoline in 10 to 12 hours at moderate load, which in a five-day outage means ten or more refueling trips, at least half of them at night, using fuel from stations that may not have power to pump.
          </p>

          <p>
            Natural gas eliminates that entirely. Connected to your home's existing gas line, the generator runs continuously for as long as the outage lasts, because gas service almost always stays up when electric service does not — the distribution system is underground and largely independent of the grid. You start it once and it runs.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Output by Fuel</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">100%</p>
                <p class="text-gray-400 text-xs mt-1">Rated output on gasoline</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~90%</p>
                <p class="text-gray-400 text-xs mt-1">Typical output on propane</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">~78%</p>
                <p class="text-gray-400 text-xs mt-1">Typical output on natural gas</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">$400-900</p>
                <p class="text-gray-400 text-xs mt-1">Typical natural gas hookup cost</p>
              </div>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Cost of the Third Fuel</h3>
          <p>
            Natural gas carries the largest derate of the three fuels — typically 20-25% below the gasoline rating, because it delivers the least energy per unit volume to the cylinder. A generator rated 13,000 peak watts on gasoline might deliver around 10,000 on natural gas. That is a real reduction and it must be accounted for in sizing, because natural gas will be the fuel you actually use during a long outage.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Tri-Fuel vs a Standby Generator</h3>
          <p>
            A tri-fuel portable connected to natural gas does most of what a standby generator does — unlimited runtime, whole-panel capability through a transfer switch — for roughly $1,500-3,000 all in, against $9,000-13,000 installed for a standby unit. What you give up is automation: you still have to go outside, start it, and switch circuits over. For households willing to do that, the value proposition is genuinely strong.
          </p>
        </div>

        <!-- SECTION 2: The Three Fuels Compared -->
        <div id="fuel-comparison" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Three Fuels Compared
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gasoline</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Propane</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Natural Gas</th>
