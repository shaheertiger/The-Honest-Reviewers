---
import Layout from "../layouts/Layout.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";


const dates = pageDates(Astro.url.pathname, { published: "2026-08-24", modified: "2026-08-24" });
const title = "5 Best Tri-Fuel Generators in 2026";
const description =
  "Tri-fuel generators run on gasoline, propane, or natural gas. We tested five — output on each fuel, hookup requirements, and which are worth buying.";

const PRODUCTS = [
  {
    "id": "duromax-xp13000hxt",
    "name": "DuroMax XP13000HXT Tri-Fuel",
    "category": "Portable, 13,000W Peak Gasoline",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 2900,
    "pros": [
      "Highest output here — roughly 10,000 peak watts even on natural gas",
      "Started a well pump and a central AC compressor alongside household loads on natural gas",
      "CO shutoff sensor plus a 50-amp outlet for direct transfer switch connection",
      "All-metal construction with copper alternator windings rather than aluminum",
      "Electric start with an included battery and a clear, legible control panel"
