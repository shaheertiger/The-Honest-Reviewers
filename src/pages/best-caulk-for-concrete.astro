const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Caulks for Concrete: Self-Leveling and Non-Sag Joint Sealants";
const description =
  "The best caulk for concrete cracks, driveway expansion joints and walls: self-leveling and non-sag polyurethane, hybrid and acrylic sealants compared by spec.";

