  },
  {
    "id": "honda-eu2200i-companion-lpg",
    "name": "Honda EU2200i (with LPG conversion kit)",
    "category": "Premium, 2,200W Peak",
    "badge": "Best Reliability",
    "amazonUrl": "#",
    "rating": 4.9,
    "reviewCount": 15600,
