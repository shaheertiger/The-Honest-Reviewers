---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best Concrete Floor Paint", url: "/best-concrete-floor-paint/" },
    { title: "Best Driveway Paints & Sealers", url: "/best-driveway-paint-reviews/" },
    { title: "Best Garage Floor Coating: Compared", url: "/best-garage-floor-coating/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-31", modified: "2026-08-31" });
const title = "Should You Pressure Wash a Driveway Before Sealing?";
const description =
  "Yes — but the pressure setting matters more than the decision. Too much PSI strips aggregate and ruins the surface you are about to seal. Here are the right numbers.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "How-To Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Pressure Wash Before Sealing",
          item: "https://www.thehonestreviewers.com/pressure-wash-driveway-before-sealing/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Should you pressure wash a driveway before sealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Sealer bonds to whatever it touches, and a swept-but-unwashed driveway retains a film of fine dust that sealer adheres to instead of the asphalt. On asphalt, use moderate pressure of roughly 1,500 to 2,500 PSI with a 25 or 40 degree fan tip, or a rotating surface cleaner attachment.",
          },
        },
        {
          "@type": "Question",
          name: "What PSI should I use to pressure wash an asphalt driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 1,500 to 2,500 PSI with a wide fan tip held about a foot from the surface. Nozzle choice matters as much as machine rating — never use a zero-degree tip on asphalt, as it cuts the binder and blasts aggregate loose. A rotating surface cleaner is the safest and fastest option.",
          },
        },
        {
          "@type": "Question",
          name: "How long after pressure washing can you seal a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Allow at least 24 hours of dry weather, and longer in cool or humid conditions. Asphalt is porous and holds moisture in cracks, shaded strips and low spots long after the open surface appears dry. Sealer applied over residual moisture will not bond and peels within weeks.",
          },
        },
        {
          "@type": "Question",
          name: "Can pressure washing damage an asphalt driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if the pressure is too high, the tip too narrow or the jet held in one place. Asphalt is aggregate bound in a petroleum binder, and a concentrated jet cuts that binder and lifts stones, leaving permanent scoured patches. Concrete tolerates far more aggression than asphalt does.",
          },
        },
        {
          "@type": "Question",
          name: "Can I seal a driveway without pressure washing it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, provided you get it genuinely clean another way. A driveway cleaner or degreaser agitated with a stiff push broom and rinsed thoroughly with a hose will clean most residential driveways adequately. What is not sufficient is sweeping or blowing alone, which leaves the bonded dust film that causes adhesion failure.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to remove oil stains before sealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and pressure washing alone will not do it. Sealer cannot bond over petroleum contamination, so untreated oil spots become peeling patches within weeks. Apply a degreaser, let it dwell, scrub with a stiff brush, and use an oil spot primer on anything that has soaked deep into the asphalt.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best nozzle for pressure washing an asphalt driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 25-degree green tip is the general-purpose choice, with a 40-degree white tip for aged or fragile surfaces. Better still is a rotating surface cleaner attachment, which distributes the force evenly under a shroud, eliminates wand striping and cuts the job time substantially. Never use a zero-degree red tip on asphalt.",
          },
        },
        {
          "@type": "Question",
          name: "Should I use a driveway cleaner as well as pressure washing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On a heavily soiled, mossy or stained driveway, yes. A dedicated cleaner loosens material that pressure alone will not lift, which means you can work at lower pressure overall — a real advantage on asphalt, where high pressure risks cutting the binder and releasing aggregate.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete",
    tags: [
      "pressure wash driveway before sealing",
      "clean driveway before sealing",
      "driveway surface prep",
      "driveway & concrete",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Driveway Cleaners",
    link: "/best-driveway-cleaner/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Surface Prep
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Should You Pressure Wash <span class="text-[#38BDF8]">Before Sealing?</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Washing is the difference between sealer that bonds and sealer that peels. Doing it at the wrong pressure is the difference between a clean driveway and a damaged one.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#settings"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Pressure Settings
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#the-answer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Answer</a>
          <a href="#settings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Pressure Settings and Tips</a>
          <a href="#process" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Full Cleaning Process</a>
          <a href="#drying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Drying Time Before Sealing</a>
          <a href="#alternatives" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. If You Cannot Pressure Wash</a>
          <a href="#concrete-difference" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Concrete vs Asphalt Washing</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Sealer bonds to what it touches. If it touches a film of dust, it bonds to the dust — and the whole coat is only as attached to your driveway as that dust layer is. Washing is not optional, but on asphalt the pressure you use is a genuine risk in its own right.
        </p>

        <div id="the-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Answer: Yes, With Caveats
          </h2>

          <p>
            You should wash a driveway before sealing it, and a pressure washer is the most practical way to do that on any surface larger than a garden path. Sweeping alone leaves a bonded film of fine dust that sweeping cannot lift, and that film is exactly what a fresh coat of sealer will adhere to instead of the asphalt.
          </p>

          <p>
            The caveat is specific to asphalt. Asphalt is aggregate held in a petroleum binder, and a high-pressure jet at close range will cut that binder away and blast the stones loose. Concrete tolerates far more aggression than asphalt does, and most driveway damage from pressure washing comes from people applying concrete-appropriate settings to an asphalt surface.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Two Numbers That Matter</p>
            <p class="text-xl font-bold text-white mb-3">Moderate pressure, wide fan, and keep moving.</p>
            <p class="text-gray-300 leading-relaxed m-0">On asphalt, work in the region of 1,500 to 2,500 PSI with a 25 or 40 degree fan tip held roughly a foot from the surface, and never let the jet dwell in one spot. If you are seeing individual stones lift or a darker scoured patch appear, back off immediately — you are removing driveway, not dirt.</p>
          </div>
        </div>

        <div id="settings" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Right Pressure, Tip and Distance
          </h2>

          <p>
            Nozzle choice matters as much as the machine’s rating, because the tip determines how concentrated the force is when it lands. A 4,000 PSI machine with a wide fan can be gentler in practice than a 2,000 PSI machine with a zero-degree jet.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Nozzle</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spray Angle</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Use on Asphalt?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Red</td>
                    <td class="px-4 py-4 text-gray-700">0°</td>
                    <td class="px-4 py-4 text-gray-700">Never</td>
                    <td class="px-4 py-4 text-gray-700">Concentrated jet; cuts binder and lifts aggregate instantly</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Yellow</td>
                    <td class="px-4 py-4 text-gray-700">15°</td>
                    <td class="px-4 py-4 text-gray-700">Spot use only</td>
                    <td class="px-4 py-4 text-gray-700">Stubborn stains, brief passes, held well back</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Green</td>
                    <td class="px-4 py-4 text-gray-700">25°</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">The general-purpose choice for asphalt washing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">White</td>
                    <td class="px-4 py-4 text-gray-700">40°</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Gentlest effective option; best on aged or fragile surfaces</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Surface cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Rotating</td>
                    <td class="px-4 py-4 text-gray-700">Yes, preferred</td>
                    <td class="px-4 py-4 text-gray-700">Even coverage, no wand streaks, much faster</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            A rotating surface cleaner attachment is the single best upgrade for this job. It encloses two spinning jets under a shroud, distributes the force evenly and eliminates the striping that a hand-held wand leaves across a large area. It is also several times faster, which matters when you are washing several hundred square feet and then waiting for it to dry.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Reading the Surface as You Go</h3>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Start in an inconspicuous corner and check the result before committing to the whole driveway.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the wand moving at a steady walking pace; dwelling in one spot is what causes damage.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Hold the tip roughly 12 inches from asphalt, closer only with the widest fans.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Watch for loose aggregate appearing in the runoff — that is your signal to reduce pressure.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Work in overlapping passes in one direction so you can see what has been covered.</span>
            </li>
          </ul>
        </div>

        <div id="process" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Full Cleaning Sequence
          </h2>

          <p>
            Pressure washing is one step in a sequence, and doing it out of order wastes effort — washing before you have treated oil stains simply spreads them.
          </p>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Sweep the whole surface first</p>
                <p class="text-gray-700 text-sm m-0">Remove leaves, loose stones and debris. Washing over loose material just relocates it, and larger debris can be fired across the yard by the jet.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Kill weeds and clear vegetation from cracks</p>
                <p class="text-gray-700 text-sm m-0">Treat growth and give it time to die back. Roots below the pavement need removing, not just the tops cutting off.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Treat oil and grease spots individually</p>
                <p class="text-gray-700 text-sm m-0">Apply degreaser, let it dwell per the label, and scrub with a stiff brush. Sealer will not bond over petroleum contamination, and pressure alone does not remove it.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Apply a driveway cleaner to the general surface</p>
                <p class="text-gray-700 text-sm m-0">For a heavily soiled or mossy driveway, a dedicated cleaner loosens what pressure alone will not, and lets you use less pressure overall.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Pressure wash with a wide fan or surface cleaner</p>
                <p class="text-gray-700 text-sm m-0">Work systematically in overlapping passes. Rinse toward the street so dirty runoff does not track back across cleaned areas.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Spot-treat anything remaining</p>
                <p class="text-gray-700 text-sm m-0">Re-treat stubborn stains rather than escalating the pressure across the whole driveway.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">7</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Let it dry completely</p>
                <p class="text-gray-700 text-sm m-0">This is not optional. Sealer will not bond to damp asphalt, and cracks and shaded areas hold water long after the open surface looks dry.</p>
              </div>
            </div>
          </div>
        </div>

        <div id="drying" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. How Long to Wait After Washing
          </h2>

          <p>
            Allow a full 24 hours of dry weather between washing and sealing, and longer in cool or humid conditions. This single point causes more failed sealing jobs than the washing itself.
          </p>

          <p>
            The reason is that asphalt is porous and holds water in places that are not visible from standing height. The open field of the driveway may look bone dry within a few hours of a wash on a warm day, while cracks, edges, shaded strips beside a fence or hedge, and any low spot that collected runoff are still holding moisture. Sealer applied over those areas cannot bond, and the result is a patchwork of adhesion failures that show up as peeling within weeks.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check shaded areas and the north side of the driveway, which dry slowest.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check inside any cracks you have not yet filled — they hold water longest of all.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A cool, humid day can easily double the drying time over a warm breezy one.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>If rain falls during the drying window, restart the clock.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Fill cracks after the wash and after drying, and let the filler cure before sealing.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Realistic Project Timeline</p>
            <p class="text-xl font-bold text-white mb-3">Washing pushes sealing to a three-day job.</p>
            <p class="text-gray-300 leading-relaxed m-0">Day one: sweep, degrease and wash. Day two: let it dry, then fill cracks and let the filler cure. Day three: first coat of sealer, second coat once dry to the touch. Then 24 to 48 hours before driving on it. Compressing this into a single weekend afternoon is where most people go wrong.</p>
          </div>
        </div>

        <div id="alternatives" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What to Do If You Do Not Have a Pressure Washer
          </h2>

          <p>
            A pressure washer is the efficient tool but not the only route to a surface clean enough to seal. The requirement is a bonded-dust-free surface, not a particular machine.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Hose, Cleaner and a Stiff Broom</h3>

          <p>
            A driveway cleaner or degreaser applied across the surface, agitated with a stiff-bristled push broom and rinsed thoroughly with a hose nozzle will get most residential driveways genuinely clean. It takes longer and it is more physical, but the scrubbing action does real work that pressure alone does not, particularly on ground-in dirt.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Renting Rather Than Buying</h3>

          <p>
            Pressure washers are widely available to rent by the day, and for a job you do every two to three years that is usually better economics than owning one. Rent the surface cleaner attachment at the same time, and check the machine’s PSI rating so you can select tips appropriately for asphalt.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">What Is Not Sufficient</h3>

          <p>
            Sweeping alone is not enough. A blower is not enough. Both move loose debris and leave the bonded film of fine dust and traffic residue that is the actual bonding problem. If you run a hand across a swept driveway and it comes back grey, sealer applied to that surface is bonding to the grey rather than to the asphalt.
          </p>
        </div>

        <div id="concrete-difference" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Washing Concrete Is a Different Job
          </h2>

          <p>
            Almost everything above is specific to asphalt, because asphalt is the fragile case. If your driveway is concrete, the constraints loosen considerably and the risks change shape.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Asphalt</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Concrete</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Typical working pressure</td>
                    <td class="px-4 py-4 text-gray-700">1,500-2,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">2,500-3,500 PSI</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Safe nozzle</td>
                    <td class="px-4 py-4 text-gray-700">25° or 40° fan</td>
                    <td class="px-4 py-4 text-gray-700">15°, 25° or surface cleaner</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Main risk</td>
                    <td class="px-4 py-4 text-gray-700">Cutting binder, lifting aggregate</td>
                    <td class="px-4 py-4 text-gray-700">Etching, wand striping</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Recovery from damage</td>
                    <td class="px-4 py-4 text-gray-700">Effectively permanent</td>
                    <td class="px-4 py-4 text-gray-700">Also permanent, but less likely</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Drying before sealing</td>
                    <td class="px-4 py-4 text-gray-700">24 hours minimum</td>
                    <td class="px-4 py-4 text-gray-700">Often 24-48 hours; slab holds moisture</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Concrete tolerates higher pressure because its binder is portland cement rather than a petroleum product, and cement does not cut or soften under a water jet the way bitumen does. The failure mode is different too: over-aggressive washing on concrete etches the surface and leaves visible wand stripes rather than releasing aggregate wholesale.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Moisture Point Is More Important on Concrete</h3>

          <p>
            Concrete is a substantial mass that absorbs and holds a great deal of water, and it releases it slowly. A slab that looks dry on the surface can still be releasing moisture from within for days after a thorough wash. That matters enormously if you are applying a film-forming sealer, because trapped moisture beneath an acrylic or epoxy film causes clouding, blushing and eventual peeling.
          </p>

          <p>
            For that reason, allow longer on concrete than on asphalt — commonly 24 to 48 hours and more in cool or humid conditions. Penetrating silane and siloxane sealers are more forgiving here because they do not form a film that can trap anything, which is one more reason they suit exposed driveways.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            7. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using a Zero-Degree Tip on Asphalt</h3>
              <p class="text-gray-700 text-sm m-0">
                A red zero-degree nozzle concentrates the machine’s full force into a pencil-thin jet that cuts through the petroleum binder and blasts aggregate loose within seconds. It leaves scoured stripes that are permanent and that no amount of sealer disguises. Use a 25 or 40 degree fan, or a surface cleaner attachment.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealing Before the Surface Has Fully Dried</h3>
              <p class="text-gray-700 text-sm m-0">
                Asphalt holds water in cracks, shaded strips and low spots long after the open surface looks dry. Sealer applied over residual moisture cannot bond and peels within weeks in exactly those areas. Allow a full 24 dry hours after washing, and longer in cool or humid conditions.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Washing Before Treating Oil Stains</h3>
              <p class="text-gray-700 text-sm m-0">
                Pressure does not remove petroleum contamination — it spreads it into a wider, thinner stain. Degrease and scrub oil spots first, let the degreaser do its work, then wash the whole surface. Anything that has soaked in also needs an oil spot primer before sealing.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Holding the Wand in One Place</h3>
              <p class="text-gray-700 text-sm m-0">
                Even an appropriate pressure and tip will damage asphalt if the jet dwells. Damage happens through exposure time as much as through pressure. Keep the wand moving at a steady walking pace and treat stubborn spots with chemistry rather than by pausing over them.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming Sweeping Is Enough</h3>
              <p class="text-gray-700 text-sm m-0">
                Sweeping and blowing remove loose debris but leave the bonded film of fine dust and traffic residue that actually prevents adhesion. Run a hand across a swept driveway — if it comes back grey, any sealer applied there will bond to that layer rather than to the pavement.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should you pressure wash a driveway before sealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes. Sealer bonds to whatever it touches, and a swept-but-unwashed driveway retains a film of fine dust that sealer adheres to instead of the asphalt. On asphalt, use moderate pressure of roughly 1,500 to 2,500 PSI with a 25 or 40 degree fan tip, or a rotating surface cleaner attachment.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI should I use to pressure wash an asphalt driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Around 1,500 to 2,500 PSI with a wide fan tip held about a foot from the surface. Nozzle choice matters as much as machine rating — never use a zero-degree tip on asphalt, as it cuts the binder and blasts aggregate loose. A rotating surface cleaner is the safest and fastest option.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long after pressure washing can you seal a driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Allow at least 24 hours of dry weather, and longer in cool or humid conditions. Asphalt is porous and holds moisture in cracks, shaded strips and low spots long after the open surface appears dry. Sealer applied over residual moisture will not bond and peels within weeks.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can pressure washing damage an asphalt driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, if the pressure is too high, the tip too narrow or the jet held in one place. Asphalt is aggregate bound in a petroleum binder, and a concentrated jet cuts that binder and lifts stones, leaving permanent scoured patches. Concrete tolerates far more aggression than asphalt does.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I seal a driveway without pressure washing it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, provided you get it genuinely clean another way. A driveway cleaner or degreaser agitated with a stiff push broom and rinsed thoroughly with a hose will clean most residential driveways adequately. What is not sufficient is sweeping or blowing alone, which leaves the bonded dust film that causes adhesion failure.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I need to remove oil stains before sealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, and pressure washing alone will not do it. Sealer cannot bond over petroleum contamination, so untreated oil spots become peeling patches within weeks. Apply a degreaser, let it dwell, scrub with a stiff brush, and use an oil spot primer on anything that has soaked deep into the asphalt.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the best nozzle for pressure washing an asphalt driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A 25-degree green tip is the general-purpose choice, with a 40-degree white tip for aged or fragile surfaces. Better still is a rotating surface cleaner attachment, which distributes the force evenly under a shroud, eliminates wand striping and cuts the job time substantially. Never use a zero-degree red tip on asphalt.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should I use a driveway cleaner as well as pressure washing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                On a heavily soiled, mossy or stained driveway, yes. A dedicated cleaner loosens material that pressure alone will not lift, which means you can work at lower pressure overall — a real advantage on asphalt, where high pressure risks cutting the binder and releasing aggregate.
              </p>
            </div>
          </div>
        </div>

