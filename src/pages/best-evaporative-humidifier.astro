                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Wick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Maker's replacement guidance</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Listed price</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vornado Evap40</td>
                    <td class="px-4 py-4 text-gray-700">MD1-0034 (uses two)</td>
