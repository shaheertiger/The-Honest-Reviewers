                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Ryobi</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Greenworks</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Budget corded</td>
