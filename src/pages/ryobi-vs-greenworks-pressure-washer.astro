                    <td class="px-4 py-4 font-black text-gray-900">Cordless flagship</td>
                    <td class="px-4 py-4 text-gray-700">40V HP Whisper: 2,000 PSI, 1.2 GPM</td>
                    <td class="px-4 py-4 text-gray-700">60V and 80V: 3,000 PSI max, 2.0 GPM max</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Corded warranty</td>
                    <td class="px-4 py-4 text-gray-700">3 years</td>
                    <td class="px-4 py-4 text-gray-700">3 years tool, 10 years brushless motor</td>
                  </tr>
                </tbody>
              </table>
            </div>
