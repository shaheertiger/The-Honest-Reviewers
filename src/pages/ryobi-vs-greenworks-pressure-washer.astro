                    <td class="px-4 py-4 text-gray-700">1,800 PSI 1.1 GPM and 1,900 PSI 1.2 GPM, universal</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Mid corded, brushless</td>
                    <td class="px-4 py-4 text-gray-700">RY142500: 2,500 PSI, 1.2 GPM</td>
