---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Splitting Mauls",
    "url": "/best-splitting-maul/"
  },
  {
    "title": "Best Log Splitters",
    "url": "/best-log-splitter/"
  },
  {
    "title": "Best Chainsaws",
    "url": "/best-chainsaw/"
  },
  {
    "title": "Best Moisture Meters",
    "url": "/best-moisture-meter/"
  },
  {
    "title": "Best Wood Stoves",
    "url": "/best-wood-stove/"
  },
  {
    "title": "Best Hookaroons",
    "url": "/best-hookaroon-reviews/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-28", modified: "2026-11-28" });
const title = "7 Best Firewood Racks in 2026: Dry Wood, Not Just Stacked";
const description =
  "A firewood rack does not season wood; airflow, sun and a top-only cover do, and a full tarp traps moisture. Seven real racks and hoops, cord math, covers and placement.";

const PRODUCTS = [
  {
    "id": "woodhaven-8ft-raised-firewood-rack",
    "name": "Woodhaven 8-Foot Raised Firewood Rack with Cover (Black)",
    "category": "8 ft, 1/2 Cord of 24-in Logs, 16-Gauge Steel, Top Cover, Made in USA",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Holds 1/2 cord (64 cubic feet) of 24-inch logs, per the listing",
      "Heavy-duty 16-gauge U.S. steel with a powder-coated finish",
      "Cover is designed to keep the top rows dry while the sides breathe",
      "Raised design keeps the bottom row off wet ground",
      "Lifetime structural warranty and stainless steel hardware, per the listing"
    ],
    "cons": [
      "Built for 24-inch-deep stacks, so 16-inch logs fill it less",
      "Costs more than imported tube racks",
      "An 8-foot rack needs a long, level spot"
    ],
    "bottomLine": "The rack that gets seasoning right: a deep, raised steel frame with a top cover that keeps rain off and lets air move.",
    "description": "Most firewood racks ship with a cover that wraps the whole stack. Woodhaven takes the approach that actually dries wood, which is why it is our top pick for anyone who burns a serious amount every winter. The listing describes a cover designed to keep the top rows of wood completely dry while allowing airflow, so the exposed sides keep seasoning. That is the single feature that matters most on a rack, because wood dries through moving air and sun, not by being wrapped up. Woodhaven lists this 8-foot model as holding 1/2 cord, or 64 cubic feet, of 24-inch logs, and the math checks out: 8 feet long by 4 feet high by 2 feet deep is 64 cubic feet. The frame is heavy-duty 16-gauge U.S. steel with a powder-coated finish, and the rack is raised to keep the bottom course off damp ground. The maker lists stainless steel nuts and bolts, about 30 minutes of assembly with no special tools, and a lifetime structural warranty. The trade-offs are real. If you cut 16-inch logs, a 24-inch-deep frame holds less than its rating, it costs more than imported racks, and it needs a long, level spot. If you burn only on weekends, a 4-foot rack or the Pleasant Hearth will do the job for less."
  },
  {
    "id": "pleasant-hearth-32mm-8ft-log-rack",
    "name": "Pleasant Hearth 32mm Heavy Duty Log Rack, 8 Feet",
    "category": "8 ft, 32mm Steel Tube, 96 x 13.5 x 49 in, Outdoor Use, No Cover",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Simple, open 8-foot frame that lets air through the whole stack",
      "32mm heavy steel tube, per the title",
      "Listed dimensions of 96 x 13.5 x 49 inches suit standard 16-inch logs",
      "Plain black finish that blends in by a fence or shed",
      "Pleasant Hearth sells a matching 8-foot cover separately"
    ],
    "cons": [
      "The listing is thin: no weight rating or wall thickness given",
      "Outdoor use only, per the maker",
      "No cover included"
    ],
    "bottomLine": "A plain, open 8-foot rack at a fair price for anyone who just needs a full row of wood off the ground.",
    "description": "If you want a rack that does one job, holding a row of split wood off the ground in open air, the Pleasant Hearth 32mm Heavy Duty Log Rack is the sensible buy. Pleasant Hearth lists heavy steel construction, a black finish and assembled dimensions of 96 inches long, 13.5 inches deep and 49 inches tall, and the title gives the tube size as 32mm. That depth suits standard 16-inch firewood, with logs overhanging a little on each side, which actually helps the ends dry. The listing says the rack holds up to 1/2 cord. Be careful with that figure: by cord math, an 8 by 4 foot stack 16 inches deep is one face cord, about a third of a full cord. You only reach half a cord with logs about 24 inches long. The open frame and no cover are a feature if you stack it in the sun with a top-only cover or under an eave. The trade-offs: the listing is thin, with no weight rating, steel gauge or tube wall thickness, so check Pleasant Hearth's own spec sheet if those matter. It is listed for outdoor use only, and the cover is sold separately. Buy the Woodhaven instead if you want deeper capacity, a heavier frame and a cover included."
  },
  {
    "id": "amagabeli-8ft-firewood-rack-cover",
    "name": "Amagabeli 8ft Firewood Log Rack with Cover",
    "category": "8 ft (Adjusts to 6 or 4 ft), 1.2mm Steel Tube, 3,400 lb, 600D Cover, 6.7 in Off Ground",
    "badge": "Best Rack and Cover Kit",
    "amazonUrl": "#",
    "pros": [
      "Removable sections convert it from 8 feet to 6 or 4 feet",
      "Listed 3,400 lb capacity with multi-leg support",
      "1.2mm thick steel tubes and double-layer powder coat, per the listing",
      "Raised 6.7 inches off the ground with downward air vents",
      "600D Oxford cover with velcro openings to grab wood without unwrapping it"
    ],
    "cons": [
      "The full cover must stay vented or open in fair weather to let wood dry",
      "14-inch depth means a face cord, not a true half cord, of 16-inch logs",
      "Cover fabric will wear before the steel does"
    ],
    "bottomLine": "A complete rack-and-cover kit that resizes from 8 to 4 feet, best for already-seasoned wood near the house.",
    "description": "The Amagabeli 8ft Firewood Log Rack with Cover is the pick for buyers who want everything in one box and a rack that can shrink when the woodpile does. Amagabeli lists 1.2mm thick steel tubes with a double-layer powder coating, a 3,400 lb capacity and multi-leg support for uneven ground, and you can remove one or two sections to turn the 8-foot rack into a 6-foot or 4-foot one. The rack measures 96 by 14 by 48 inches and sits 6.7 inches off the ground, per the listing, and the cover is 600D PU-coated Oxford fabric with an elastic hem, buckle straps and velcro openings so you can reach wood without pulling the whole cover off. Amagabeli says downward air vents promote airflow and reduce condensation. Here is the honest caveat: a cover that wraps the whole stack is best for wood that is already seasoned. Green wood under a full cover dries slowly, so roll the front up or leave the sides open in dry weather and close it before storms. The listing rates it at 1/2 cord, but at 14 inches deep it holds about one face cord of 16-inch logs. Choose the Woodhaven instead if you are drying fresh-split wood, since its top-only cover is designed for seasoning."
  },
  {
    "id": "shelter-slra-adjustable-log-rack",
    "name": "Shelter SLRA Adjustable Length Firewood Rack (Made in USA)",
    "category": "Adjustable Length with 2x4s, 1.25-in Tubular Steel, 13 in D x 45 in H, Made in USA",
    "badge": "Best Custom Length",
    "amazonUrl": "#",
    "pros": [
      "Length set by the 2x4s you add, so it fits any wall or space",
      "Heavy-duty 1-1/4 inch tubular steel ends",
      "Made in the USA, per the listing",
      "Weatherproof black powder coat that resists chipping and corrosion",
      "Open-air design for ventilation"
    ],
    "cons": [
      "2x4s not included, and wood rails eventually need replacing",
      "Capacity depends on your lumber length; no weight rating given",
      "No cover included"
    ],
    "bottomLine": "Sturdy American-made tube ends that turn two 2x4s into a rack of whatever length your space allows.",
    "description": "A fixed 8-foot rack is wrong for plenty of yards: too long for the gap beside the shed, too short for a year of wood. The Shelter SLRA solves that by giving you the steel ends and letting the lumber set the length. Per the listing, you add 2x4s to the 1-1/4 inch tubular steel ends, and the finished rack stands 45 inches tall and 13 inches deep, so it suits standard 16-inch splits. Shelter lists it as made in the USA, with a weatherproof black powder coat that resists chipping and corrosion and an open-air design that lets air through the stack and helps prevent dampness and mold. Because you choose the length, you can build a short rack for a porch or a 12-foot run along a fence for a full season of wood. The trade-offs come from the wood half of the rack. The 2x4s are not included, the listing gives no weight rating, and a wooden base rail sitting near the ground will eventually rot and need replacing. Long spans also sag if overloaded, so do not stretch the lumber further than it can carry. Buy a complete steel rack like the Woodhaven or Amagabeli if you want no lumber at all, or the Mr IRONSTONE kit for the cheapest custom build."
  },
  {
    "id": "mr-ironstone-firewood-rack-bracket-kit",
    "name": "Mr IRONSTONE Firewood Rack Bracket Kit, Adjustable to Any Length",
    "category": "Bracket Kit, 13 GA (2.95mm) Steel Plate, 13 x 3.8 x 6 in Brackets, Uses 2x4s",
    "badge": "Best Budget DIY",
    "amazonUrl": "#",
    "pros": [
      "Thick 13-gauge (2.95mm) steel plate brackets, per the listing",
      "Build a rack of any length with your own 2x4s",
      "Electrostatic black powder coat for rust resistance",
      "Includes two brackets, two end plates and 32 screws",
      "Keeps logs off the ground for better drying"
    ],
    "cons": [
      "2x4s not included, so the full cost includes lumber",
      "Wooden rails need replacing as they weather",
      "No weight rating or cover in the listing"
    ],
    "bottomLine": "The cheapest way into a custom-length rack: heavy plate brackets plus 2x4s from the lumber yard.",
    "description": "If you have a saw and a few 2x4s, the Mr IRONSTONE bracket kit is the least expensive way to build a firewood rack of exactly the size you need. Per the listing, each bracket measures 13 by 3.8 by 6 inches, weighs 5.3 pounds and is cut from 13 gauge, or 2.95mm, steel plate. That is notably thick steel for a bracket, which matters because the brackets carry the full weight of the stack at the corners. The kit includes two brackets, two end plates and 32 screws, and you screw them to 2x4s from a building supply store. The steel is coated with electrostatic black powder paint to resist rust and chipping, and Mr IRONSTONE lists it for porches, decks, sheds, garages and cabins. The design lifts the bottom row off the ground so air can move under it. The trade-offs come with any bracket rack. Lumber is extra, wooden rails weather and need replacing in time, and the listing gives no weight capacity. Size the uprights and base so the rack is no taller than it is stable, and anchor or brace a tall build. Buy the Shelter SLRA instead if you prefer tubular steel ends that are made in the USA, or a complete rack if you would rather not cut lumber."
  },
  {
    "id": "sunnydaze-48in-round-firewood-rack",
    "name": "Sunnydaze 48-Inch Round Indoor or Outdoor Firewood Rack",
    "category": "48-in Double-Hoop, 1/2 Face Cord, 700 lb, Powder-Coated Tubular Steel, No Cover",
    "badge": "Best Decorative Hoop",
    "amazonUrl": "#",
    "pros": [
      "Holds up to 700 pounds, about 1/2 face cord, per the listing",
      "Double-hoop shape looks good on a porch, deck or patio",
      "Raised, open design lets air circulate around the logs",
      "Light at about 10.8 pounds, so it is easy to move",
      "Works indoors beside a stove or outdoors by a fire pit"
    ],
    "cons": [
      "Half a face cord is a few weeks of steady burning, not a season",
      "No cover included; Sunnydaze recommends covering it outdoors",
      "A round stack is slower to load than a straight row"
    ],
    "bottomLine": "A good-looking hoop for the week's wood by the door or the fire pit, not for a winter's supply.",
    "description": "A long straight rack is the right tool for a season of wood, but it is not something you want on a front porch. The Sunnydaze 48-Inch Round Firewood Rack is for the supply you keep close at hand: by the back door, on the deck or beside a fire pit. Sunnydaze lists it as holding up to 700 pounds of split firewood, about 1/2 face cord, in a double-hoop frame of black powder-coated tubular steel. It measures 53 inches tall and 15.5 inches deep and weighs about 10.8 pounds, so you can move it between the patio and an indoor hearth. The open hoop lifts wood off the ground and lets air move around the logs, and the open front makes loading and grabbing wood easy. Be realistic about capacity: half a face cord is a few weeks of steady burning in a wood stove, so this is a staging rack, filled from your main stack. Sunnydaze notes that a cover is recommended for outdoor use, and a cover is not included. Bolt-together assembly is simple. If you need to store a winter's supply, buy an 8-foot rack such as the Woodhaven or Pleasant Hearth, and if you want a smaller hoop for indoor use, the UniFlame 36-inch ring takes up less floor."
  },
  {
    "id": "uniflame-w-1836-log-hoop",
    "name": "UniFlame 36-Inch Firewood Log Hoop Rack (W-1836)",
    "category": "36-in Ring, 1/2-in Solid Steel Stock, 14 x 36 x 39 in, Collapsible, Indoor/Outdoor",
    "badge": "Best Indoor Log Holder",
    "amazonUrl": "#",
    "pros": [
      "1/2-inch solid steel stock rather than thin tube, per the title",
      "Ships fully assembled: unfold the frame and it is ready",
      "Compact 14 x 36 x 39 inch footprint for a hearth or porch",
      "Simple black finish that suits most rooms",
      "Rated for indoor or outdoor use"
    ],
    "cons": [
      "Small capacity, a few days to a week of wood",
      "No weight rating or capacity figure in the listing",
      "Bare steel feet may need pads on a finished floor"
    ],
    "bottomLine": "A small, solid hoop for the wood you bring inside, ready to use out of the box.",
    "description": "Indoor log holders are about convenience and keeping the room tidy, and the UniFlame W-1836 is a no-fuss way to do it. The title lists 1/2-inch solid steel stock, which gives the ring a sturdier feel than many hollow-tube hoops, and the listing gives a 36-inch ring diameter with overall dimensions of 14 inches deep, 36 inches wide and 39 inches tall. It arrives fully assembled: you pull the collapsible frame open and it is ready to load, with no bolts to tighten. UniFlame rates it for indoor or outdoor use and describes it as suited to storing, drying or displaying firewood. Indoors, its job is to hold a day or two of seasoned splits brought in from the main rack, so you are not walking out in the snow every hour. Keep it outside the stove or fireplace maker's stated clearance from the firebox, and bring in only wood that is already dry, since wet wood indoors adds moisture and can carry insects. The trade-offs: capacity is small, the listing gives no weight rating, and bare steel feet may mark a soft floor, so a hearth pad or felt helps. For more wood near the door, the Sunnydaze 48-inch hoop holds roughly three times as much."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Firewood Racks",
          item: "https://www.thehonestreviewers.com/best-firewood-rack/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best firewood rack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most wood-burning homes, the Woodhaven 8-Foot Raised Firewood Rack is the best firewood rack. Woodhaven lists 16-gauge U.S. steel, a capacity of 1/2 cord of 24-inch logs and a cover designed to keep the top rows dry while the sides breathe, which is how wood actually seasons. The Pleasant Hearth 8-foot rack is a simpler, open alternative for less money."
          }
        },
        {
          "@type": "Question",
          "name": "Should a firewood rack be covered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cover the top, not the whole stack. A top cover keeps rain and snow off the upper rows while the open sides let moisture escape so the wood keeps drying. A tarp or full cover wrapped around the sides traps moisture and can leave wood damp and moldy. Full covers suit wood that is already seasoned, and should be opened on dry days."
          }
        },
        {
          "@type": "Question",
          "name": "How far should a firewood rack be from the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common pest-control and extension advice is to keep the main woodpile well away from the house, often 20 feet or more, because stacked wood shelters termites, carpenter ants and rodents. Never stack wood against siding or a foundation. Keep only a small supply near the door and bring wood indoors only as you burn it."
          }
        },
        {
          "@type": "Question",
          "name": "How much wood does an 8 foot firewood rack hold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on depth. An 8-foot rack 4 feet tall and about 14 inches deep holds roughly a face cord of 16-inch logs, about a third of a full cord. A rack built for 24-inch-deep stacks, like the Woodhaven, holds 64 cubic feet, a half cord. A full cord is 4 by 4 by 8 feet, or 128 cubic feet."
          }
        },
        {
          "@type": "Question",
          "name": "How long does firewood need to season on a rack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "General guidance is six to twelve months after splitting, and longer for dense hardwoods such as oak. Wood is usually considered ready below about 20 percent moisture content. Split wood dries much faster than whole rounds, and a sunny, breezy spot with a top-only cover speeds it up. Check a freshly split face with a moisture meter."
          }
        },
        {
          "@type": "Question",
          "name": "Is it OK to keep firewood indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keep only a day or a few days of seasoned wood inside, in a holder placed outside the clearances your stove or fireplace maker specifies. Wood stored indoors for weeks can release insects as it warms, and wet wood adds moisture to the room. Store the main supply outdoors on a raised rack, away from the house."
          }
        },
        {
          "@type": "Question",
          "name": "Is a metal or wood firewood rack better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Powder-coated steel racks last longer outdoors and do not rot. Bracket kits that use 2x4s are cheaper and can be built to any length, but the wooden rails weather and need replacing over time. Pressure-treated lumber lasts longer for rails, but some brackets do not fit it, so check the listing, and never burn treated lumber."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Tools & Equipment",
    tags: [
      "best firewood rack",
      "firewood rack",
      "outdoor firewood rack",
      "indoor firewood rack",
      "log rack",
      "firewood rack with cover",
      "firewood storage rack"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Firewood Racks</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A rack does not dry your wood. Airflow, sun and a cover on top only do, and a tarp wrapped round the stack keeps it wet. Here are seven racks and hoops that hold wood the way it dries, and how to size, cover and place them.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#woodhaven-8ft-raised-firewood-rack"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Does a Rack Dry Wood?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="4.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#seasoning-truth" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Does a Rack Dry Wood?</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Type Fits</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Firewood Racks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Cords and Face Cords</a>
          <a href="#covers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Top-Only Covers</a>
          <a href="#placement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Where to Put the Rack</a>
          <a href="#seasoning-time" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How Long to Season</a>
          <a href="#build-quality" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Steel and Powder Coat</a>
          <a href="#indoor" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Indoor Log Holders</a>
          <a href="#stacking" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. How to Stack</a>
          <a href="#firewood-workflow" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. The Full Firewood Setup</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

