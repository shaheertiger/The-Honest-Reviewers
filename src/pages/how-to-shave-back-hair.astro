              <p class="text-3xl font-black text-[#38BDF8]">5 min</p>
              <p class="text-gray-400 text-xs mt-1">average solo shave time</p>
            </div>
            <div>
              <p class="text-3xl font-black text-white">$14-$50</p>
              <p class="text-gray-400 text-xs mt-1">one-time tool investment</p>
            </div>
            <div>
              <p class="text-3xl font-black text-[#FF4500]">0%</p>
              <p class="text-gray-400 text-xs mt-1">chance shaving makes hair thicker</p>
            </div>
          </div>
