const title = "Deck Stain vs Sealer: Which Does Your Deck Need?";
const description =
  "Sealer repels water. Stain repels water and blocks UV. The difference is pigment, and it decides whether your deck greys in one season or five.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Deck Stain vs Sealer",
          item: "https://www.thehonestreviewers.com/deck-stain-vs-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between deck stain and deck sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A sealer is a clear water repellent. A stain is a water repellent carrying pigment. Both keep water out; only the pigmented one blocks ultraviolet light, which is what actually turns a deck grey. Almost every modern deck stain contains a sealer within it, so the choice is not stain or sealer but how much pigment you want.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to seal a deck after staining it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not. Nearly all deck stains sold for exterior use already contain the water repellent, so adding a clear sealer on top is redundant and can trap the stain or leave a film that peels. The exception is a few solid-colour systems that specify a matched clear topcoat; if the label does not call for one, do not add one.",
          },
        },
        {
          "@type": "Question",
          name: "Is clear deck sealer a waste of money?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not a waste, but it is often misunderstood. Clear sealer does exactly one job well, which is stopping liquid water from soaking into the wood. It does nothing about UV, so the deck still greys on the normal timetable. It makes sense on new premium hardwood you want to keep looking natural, and on wood you plan to recoat every year.",
          },
        },
        {
          "@type": "Question",
          name: "How long does deck sealer last compared to stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A clear sealer typically holds its water repellency for about one to two years on a horizontal deck surface. A semi-transparent stain generally runs two to three years, and a solid stain three to five. The pattern tracks pigment, because pigment is what shields the wood fibres and the binder from the sunlight that breaks both down.",
          },
        },
        {
          "@type": "Question",
          name: "Can you put stain over a deck that was sealed?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only once the sealer has worn off or been stripped. A fresh water repellent does exactly what it was bought to do and stops the stain from penetrating, so the stain sits on top and dries blotchy. Sprinkle water on the deck: if it beads, the sealer is still working and the stain will not soak in.",
          },
        },
        {
          "@type": "Question",
          name: "Which is better for a pressure-treated deck, stain or sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Stain, in almost every case. The chemical treatment in pressure-treated lumber protects against rot and insects but does nothing about UV or water, so the wood still checks, cups and greys. A semi-transparent stain gives it both the repellency and the pigment it lacks; a clear sealer only gives it half.",
          },
        },
        {
          "@type": "Question",
          name: "Does deck sealer stop the wood going grey?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Greying is ultraviolet damage to the lignin in the surface fibres, and a clear film has nothing in it to absorb or reflect UV. A deck under clear sealer stays water-resistant while it greys, which is why people are so often surprised by the result. Only pigment slows the colour change.",
          },
        },
        {
          "@type": "Question",
          name: "Should a new deck get sealer or stain first?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Whichever you choose, the first question is whether the wood is dry enough to accept it. New pressure-treated lumber is often still wet from the treatment plant and will reject both. Sprinkle water on it: if it beads, wait. If it soaks in within a minute or two, the wood is ready.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
