---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Zero Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Residential Zero Turn Mowers",
    "url": "/best-residential-zero-turn-mower/"
  },
  {
    "title": "Zero Turn vs Riding Mower",
    "url": "/zero-turn-vs-riding-mower/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  },
  {
    "title": "Best Lawn Mower Blades",
    "url": "/best-lawn-mower-blades/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "7 Best Commercial Zero Turn Mowers in 2026: Drive, Deck and Warranty Compared";
const description =
  "The best commercial zero turn mowers from Scag, Exmark, Hustler, Gravely, Ferris, John Deere and Kubota, compared on drive system, deck steel and warranty hours.";

const PRODUCTS = [
  {
    "id": "scag-turf-tiger-ii",
    "name": "Scag Turf Tiger II Commercial Zero Turn (52/61/72 in.)",
    "category": "Commercial, Pump and Wheel Motor Drive, Velocity Plus Deck",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Separate drive: two 16cc Hydro-Gear pumps feeding two 18 cubic inch Parker wheel motors",
      "Velocity Plus deck in 52, 61 and 72 inch widths with a tri-plate front edge Scag says totals nearly half an inch of steel",
      "Widest engine menu here: Kohler, Kawasaki, Vanguard, Kubota diesel and Kohler propane",
      "Scag lists 12 mph forward on gas, a 12 gallon tank and a 1.5 to 6 inch cut range",
      "Four-point iso-mounted torsion-spring suspension seat on a double-tube steel frame"
    ],
    "cons": [
      "Scag's warranty page lists a 2-year commercial machine warranty, shorter than Hustler or Gravely",
      "Dealer-only, no published national price, and a heavy machine for a light trailer"
    ],
    "bottomLine": "The mower to buy if it will run all day, every day: a hose-and-wheel-motor drive, a deck built for stump strikes, and an engine for every fuel a fleet runs.",
    "description": "The Turf Tiger II is Scag's flagship stand-on-the-gas machine, and its spec sheet reads like a list of everything that separates commercial from prosumer. Drive is not an integrated transaxle at all: Scag lists dual 16cc Hydro-Gear pumps driving dual 18 cubic inch Parker wheel motors, the layout used where a mower is expected to log well over a thousand hours. The Velocity Plus deck comes in 52, 61 and 72 inch widths, and Scag describes a tri-plate construction of three steel plates totaling nearly half an inch at the front edge, with reinforcement at the spindles, cast-iron spindle housings and tapered roller bearings. Cut height runs 1.5 to 6 inches in quarter-inch steps. The engine list is the broadest on this page: Kohler Command PRO EFI at 26 or 38 hp, a liquid-cooled 31 hp Kawasaki FD DFI, Vanguard BIG BLOCK at 33 or 40 hp, a 25 hp liquid-cooled Kubota diesel and a 25 hp Kohler propane option. Scag lists 12 mph forward on gas or propane, 10 mph on diesel, and a 12 gallon tank. The operator sits on a four-point iso-mounted torsion-spring suspension seat over a double-tube steel main frame. The weak spot is the paperwork: Scag's warranty page lists a 2-year commercial machine warranty, so read the owner's manual terms before comparing it with the five-year coverage elsewhere here."
  },
  {
    "id": "exmark-lazer-z-x-series",
    "name": "Exmark Lazer Z X-Series LRX921GKA606Q1 (60 in., Kawasaki FX921V)",
    "category": "Commercial, Parker Unitized Drive, UltraCut Series 6 Deck",
    "badge": "Best Cut Quality",
    "amazonUrl": "#",
    "pros": [
      "UltraCut Series 6 deck: listings describe a 10-gauge welded top with 7-gauge side skirt and spindle mounts",
      "Exmark-exclusive Parker unitized pump and wheel motor systems with no hoses and spin-on filters",
      "Cut height adjusts from 1 to 5.5 inches in quarter-inch steps from the seat",
      "Long-travel full suspension operator seat",
      "60, 72 and 96 inch (rear-discharge Flex-Wing) deck options across the series"
    ],
    "cons": [
      "Exmark's own site lists a $20,199 cash price for this configuration, the most expensive pick here",
      "11.5 mph top speed is slower than the Hustler's 14 mph"
    ],
    "bottomLine": "The finish-quality pick for crews whose customers judge them on stripes and clean edges, priced accordingly.",
    "description": "The Lazer Z X-Series is Exmark's top sit-down line, and the 60 inch LRX921GKA606Q1 is the configuration most crews would pick: a 31 hp Kawasaki FX921V on a 60 inch UltraCut Series 6 deck. That deck is the reason people pay for it. Dealer listings describe it as a 10-gauge top that is formed and continuously seam welded, with a 7-gauge side skirt and 7-gauge spindle mounting areas, so the steel is thickest where curbs and stumps hit. Cut height runs from 1 to 5.5 inches in quarter-inch steps and is set from the seat, which matters to a crew changing heights between properties. Drive comes from two Parker unitized pump and wheel motor systems that Exmark describes as having no hoses, integrated cooling fans and spin-on filters, removing the hose fittings that are a common leak point on older pump-and-motor designs. Exmark lists 11.5 mph, a 12 gallon tank and a long-travel full suspension seat. The cost is hard to ignore: Exmark's own product page lists a $20,199 cash price for this exact model, several thousand dollars above the Gravely or Kubota. Wider 72 inch and 96 inch rear-discharge versions exist for open turf. Warranty terms were not stated on the product page, so get them in writing from the dealer before you sign."
  },
  {
    "id": "hustler-super-z",
    "name": "Hustler Super Z Commercial Zero Turn (54/60/72 in.)",
    "category": "Commercial, Pump and Wheel Motor Drive, 7-Gauge VX4 Deck",
    "badge": "Best Warranty",
    "amazonUrl": "#",
    "pros": [
      "Hustler lists a 5-year / 1,200-hour mower warranty with no hour limit in the first 2 years",
      "Hydro-Gear 21cc PY pumps with Parker TG wheel motors and stainless Seal-Loc lines",
      "Up to 14 mph forward, the fastest rated machine on this list",
      "Fabricated 7-gauge VX4 deck in 54, 60 and 72 inch widths",
      "I3M suspension seat with 3 inches of travel and a 12 gallon dual-tank setup"
    ],
    "cons": [
      "Engine and drive system carry separate 3-year limited terms inside that 5-year headline",
      "14 mph is only usable on open turf; most residential-size lots never let it get there"
    ],
    "bottomLine": "The best-warrantied pump-and-motor mower here, and the fastest, for crews that cover open acreage all day.",
    "description": "Hustler has built the Super Z around two numbers: up to 14 mph forward and a warranty Hustler lists as five years or 1,200 hours, with no hour limit in the first two years. Read the small print, because the engine and drive system each carry a 3-year limited term inside that headline, but it is still the longest machine coverage on this page alongside the Gravely. The drive is a full commercial pump-and-motor layout: Hydro-Gear 21cc PY pumps feeding Parker TG wheel motors, plumbed with stainless steel Parker Seal-Loc lines, a 3 gallon hydraulic reservoir and an oil cooler with an 8 inch fan. Bigger pumps than the 16cc units on the Scag help explain the higher rated speed. The deck is Hustler's fabricated 7-gauge VX4 in 54, 60 and 72 inch widths, with rear-discharge versions of the 60 and 72. Engines are all Kawasaki: the 27 hp FX850 (852cc) on the 54 and 60, the 35 hp FX1000 (999cc) on the 60 and 72, and a 38.5 hp FX1000 EFI on the 72. Hustler lists a 12 gallon total dual fuel tank and an I3M high-back suspension seat with 3 inches of travel. Hustler publishes a starting MSRP only through dealers, so price it locally. For a crew mowing big open properties, the speed and warranty are a strong pair."
  },
  {
    "id": "gravely-pro-turn-260",
    "name": "Gravely Pro-Turn 260 Kawasaki 992551 (60 in.)",
    "category": "Commercial, Hydro-Gear ZT-5400, 7-Gauge X-Factor 2 Deck",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Hydro-Gear ZT-5400 transaxles, a serviceable heavy-duty commercial unit",
      "Fabricated 7-gauge X-Factor 2 deck backed by a limited lifetime deck warranty",
      "Five-year / 1,250-hour limited warranty with no hour limit for the first two years",
      "13 mph top speed and Kawasaki FX850 or FX921 power across the Pro-Turn 200 line",
      "1.5 x 3 inch tubular steel frame and a high-back seat with lumbar support and armrests"
    ],
    "cons": [
      "Integrated transaxles instead of separate pumps and wheel motors",
      "No suspension platform, only suspension seat cushions"
    ],
    "bottomLine": "The most commercial mower per dollar here: ZT-5400s, a 7-gauge fabricated deck and five years of coverage without the pump-and-motor price.",
    "description": "Gravely reintroduced the Pro-Turn 200 as its entry commercial zero turn, and the 60 inch Pro-Turn 260 Kawasaki (model 992551) is the one to look at. Trade coverage of the relaunch lists Hydro-Gear ZT-5400 transaxles, Kawasaki FX850 and FX921 engine options, a 13 mph top speed and 52 and 60 inch deck widths. The ZT-5400 is an integrated transaxle rather than separate pumps and wheel motors, but it is a heavy-duty commercial unit with serviceable fluid and a filter, and it is what keeps this machine thousands below the pump-and-motor mowers. The deck is the 7-gauge X-Factor 2, which Gravely describes as fabricated from top to bottom and covers with a limited lifetime warranty. The frame is 1.5 by 3 inch tubular steel, and the seat is a high back with lumbar support and padded armrests on suspension seat cushions, not a suspended platform. The warranty is the strongest argument: a five-year or 1,250-hour limited warranty with no hour limit for the first two years. Gravely does not publish a national price; get dealer quotes. For an owner-operator or a homeowner with serious acreage, the Pro-Turn 260 gets most of the way to a top-tier mower and leaves money for a trailer."
  },
  {
    "id": "ferris-isx-2200",
    "name": "Ferris ISX 2200 Zero Turn with ForeFront Suspension (52/60 in.)",
    "category": "Commercial, Hydro-Gear ZT-4400, Full Suspension",
    "badge": "Best Ride",
    "amazonUrl": "#",
    "pros": [
      "ForeFront suspension: independent front and rear with coil-over shocks",
      "Ferris lists a 10-year suspension warranty",
      "Dual commercial Hydro-Gear ZT-4400 transaxles with 8.3 inch cooling fans",
      "Premium high-back suspension seat with adjustable armrests, lumbar and recline",
      "Vanguard 810cc EFI with Oil Guard or Kawasaki FX781V EVO engine options"
    ],
    "cons": [
      "Machine warranty is 2 years unlimited hours or 4 years / 500 hours, well short of Hustler or Gravely",
      "0-10 mph top speed and an 11 gallon tank are a step down from the pump-and-motor mowers"
    ],
    "bottomLine": "Buy it for the operator's back: the only full chassis suspension on this list, backed by a 10-year suspension warranty.",
    "description": "Every machine here has a suspension seat. The ISX 2200 suspends the whole chassis. Ferris's ForeFront system uses independent front and rear suspension with coil-over shocks, and Ferris lists a 10-year warranty on it, which tells you how much the brand trusts it. For an operator who spends six hours a day on rough lawns, a suspended frame keeps the deck steadier over bumps and spares the operator, and it is the main reason to choose this mower. Underneath, Ferris lists dual commercial Hydro-Gear ZT-4400 transaxles with 8.3 inch cooling fans, one step below the ZT-5400 on the Gravely but still a serviceable commercial unit. Engine choices are the Vanguard 810cc EFI with Oil Guard, which extends oil change intervals, or the Kawasaki FX781V EVO. Deck widths are 52 and 60 inches on Ferris's iCD 2-belt cutting system. Ferris lists 0 to 10 mph forward, 0 to 5 reverse and an 11 gallon tank. The seat is a premium high back with adjustable armrests, lumbar and recline. The warranty on the rest of the machine is 2 years unlimited hours or 4 years and 500 hours, whichever comes first, noticeably shorter than the Hustler or Gravely. For ride comfort over rough ground, though, nothing else here comes close."
  },
  {
    "id": "john-deere-z930m",
    "name": "John Deere Z930M ZTrak (54/60 in. 7-Iron PRO Deck)",
    "category": "Commercial, 7-Gauge Stamped Deck, Dealer Network",
    "badge": "Best Dealer Support",
    "amazonUrl": "#",
    "pros": [
      "7-Iron PRO deck stamped from 7-gauge (0.179 inch) steel in 54 and 60 inch widths",
      "3-year / 1,200-hour warranty, no hour limit in the first 24 months",
      "25.5 hp Kawasaki FX801V engine",
      "Deere's dealer network makes parts and warranty service easy to find in most of the country",
      "Mulch On Demand deck option for crews that switch between mulching and discharge"
    ],
    "cons": [
      "Smallest engine of the commercial picks at 25.5 hp gross",
      "Deere does not publish the transmission model or a consumer list price for it on its product page"
    ],
    "bottomLine": "The commercial mower for buyers who value a nearby service bay over the last spec-sheet win.",
    "description": "The Z930M is the middle of Deere's Z900 commercial line, and its deck is a useful counterpoint to the fabricated-deck pitch every other brand makes. Deere's 7-Iron PRO deck is stamped, pressed from one piece of 7-gauge steel, about 0.179 inch thick, rather than welded from plate. Stamped is usually the residential shortcut, but at 7 gauge the deck is as thick as the fabricated decks on the Hustler and Gravely, and a one-piece shell has no weld seams to crack. It comes in 54 and 60 inch widths, with Mulch On Demand available at extra cost. Deere rates the engine, a Kawasaki FX801V, at 25.5 hp gross at 3,600 rpm, the smallest here, which is adequate on a 54 or 60 inch deck but not generous in tall wet grass. Deere lists the warranty as 36 months or 1,200 hours, whichever comes first, with no hour limit in the first 24 months. Deere's product pages did not name the hydrostatic drive units, so ask the dealer which transmission the unit you are quoted uses. What you are really buying is the dealer network: in much of rural America the nearest service bay that stocks commercial mower parts is green, and that counts for a lot when a mower is down in June."
  },
  {
    "id": "kubota-z781kwti-60",
    "name": "Kubota Z781KWTi-60 Z700 Series Zero Turn (60 in.)",
    "category": "Commercial, Parker HTG14 Transmissions, Kawasaki EFI",
    "badge": "Best Published Price",
    "amazonUrl": "#",
    "pros": [
      "Kubota USA lists an MSRP from $14,849, one of the few commercial mowers with a published price",
      "Dual Parker HTG14 transmissions, each with an integrated pump and motor",
      "29.5 hp Kawasaki FX850V EFI (852cc)",
      "11.6 gallon tank and an 11.2 mph forward rating",
      "Deep commercial deck in 48, 54 and 60 inch widths across the Z700 line"
    ],
    "cons": [
      "Published warranty terms conflict between sources; confirm current US coverage with the dealer",
      "At 1,285 pounds listed weight, it needs a real trailer"
    ],
    "bottomLine": "A straightforward commercial machine from a tractor dealer you may already use, with a price you can check before walking in.",
    "description": "Kubota is better known for compact tractors, and that is the case for the Z700 Series: if you already take a tractor to a Kubota dealer, the mower can go to the same service bay. The Z781KWTi-60 pairs a 60 inch commercial deck with a 29.5 hp Kawasaki FX850V EFI engine of 852cc. Drive is a pair of Parker HTG14 hydrostatic transmissions, which Kubota describes as integrating a pump and motor in each unit, a design meant to simplify service. Kubota lists 11.2 mph forward and 5.6 mph reverse, an 11.6 gallon fuel tank and a weight of 1,285 pounds. The Z700 deck is a deep commercial design offered in 48, 54 and 60 inch widths across the series. The rare thing here is a published price: Kubota USA lists an MSRP from $14,849 for this model, which makes it a useful reference when a dealer quotes a different brand. Warranty is less clear. Kubota Canada lists three years, while launch coverage of the Z700 described two years with unlimited hours, so get the current US terms from the dealer before you buy. It is not the fastest or the best-equipped machine here, but it is a solid, fairly priced commercial mower from a dealer network with deep roots in farm country."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Commercial Zero Turn Mower",
          item: "https://www.thehonestreviewers.com/best-commercial-zero-turn-mower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best commercial zero turn mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For full-time crew use, the Scag Turf Tiger II is our top pick for its pump-and-wheel-motor drive, heavy Velocity Plus deck and wide engine choice. The Gravely Pro-Turn 260 is the best value, pairing Hydro-Gear ZT-5400 transaxles and a 7-gauge fabricated deck with a five-year, 1,250-hour warranty. The Ferris ISX 2200 rides best thanks to its suspended chassis."
          }
        },
        {
          "@type": "Question",
          "name": "What makes a zero turn mower commercial grade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for a serviceable heavy-duty drive, either Hydro-Gear ZT-4400 or ZT-5400 class transaxles or separate pumps and wheel motors, a deck built from 7-gauge steel or reinforced plate, a commercial engine such as a Kawasaki FX or Vanguard BIG BLOCK, a suspension seat, and a warranty written in 1,000-plus hours rather than a few hundred."
          }
        },
        {
          "@type": "Question",
          "name": "How many hours does a commercial zero turn mower last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturers do not publish a lifespan, but their warranties show what they expect: Hustler and Gravely write five-year terms of 1,200 and 1,250 hours, and John Deere three years or 1,200 hours. Owners commonly report commercial machines running well beyond those figures when hydraulic fluid, filters and engine oil are changed on schedule."
          }
        },
        {
          "@type": "Question",
          "name": "Is a pump and wheel motor drive better than a ZT-5400 transaxle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For very high hours, pump-and-motor systems like Scag's and Hustler's are easier to service piece by piece and are what the most expensive mowers use. For an owner-operator or a homeowner, a ZT-5400 is a serviceable commercial unit that will rarely be worn out, and it keeps the machine's price several thousand dollars lower."
          }
        },
        {
          "@type": "Question",
          "name": "Can you buy a commercial zero turn mower on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not new from the major commercial brands. Scag, Exmark, Hustler, Gravely, Ferris, John Deere and Kubota sell commercial zero turns through authorized dealers, who handle delivery, setup and warranty service. Amazon listings under those brand names are almost always parts, blades and covers, not the mowers."
          }
        },
        {
          "@type": "Question",
          "name": "Is a commercial zero turn worth it for a homeowner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Above about five acres of regular mowing, or on rough rural ground, often yes: a 7-gauge deck, a suspension seat and a commercial drive make long mows easier and last for decades. Under four acres, a good residential or prosumer machine does the job for a fraction of the price, and the commercial durability goes unused."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a commercial zero turn mower cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most brands only quote through dealers. Two that publish prices give a sense of the range: Kubota USA lists the Z781KWTi-60 from $14,849, and Exmark's site lists $20,199 for the 60 inch Lazer Z X-Series LRX921GKA606Q1. Entry commercial machines from Gravely and Ferris are typically quoted below the Exmark."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn & Yard Care",
    tags: [
      "best commercial zero turn mower",
      "commercial zero turn mower",
      "commercial grade zero turn",
      "commercial lawn mower",
      "zero turn mower"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Commercial Zero Turn Mowers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A commercial zero turn earns its price in the drive system, the deck steel and the warranty hours, not the decal. Here are seven worth buying, and what each one's spec sheet actually gets you.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#scag-turf-tiger-ii"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-makes-commercial" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Makes It Commercial</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 7 Best, Ranked</a>
          <a href="#drive-systems" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Transaxles vs Wheel Motors</a>
          <a href="#decks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Deck Steel and Gauge</a>
          <a href="#engines" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Engine Class</a>
          <a href="#comfort" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Suspension and Fatigue</a>
