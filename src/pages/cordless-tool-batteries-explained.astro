const title = "Cordless Tool Batteries Explained: Volts, Amp-Hours, Platforms";
const description =
  "Volts set the power, amp-hours set the runtime, and the platform you pick outlives every tool you buy. Here is what the numbers actually mean.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Cordless Tool Batteries Explained",
          item: "https://www.thehonestreviewers.com/cordless-tool-batteries-explained/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between 18V and 20V MAX tools?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nothing. Both describe the same five-cell lithium pack. Eighteen volts is the nominal voltage under load, and twenty volts is the peak voltage of a fully charged pack before any work is done. It is a labelling choice rather than an engineering difference.",
          },
        },
        {
          "@type": "Question",
          name: "What do amp-hours mean on a tool battery?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amp-hours measure capacity, which translates directly into runtime. A 4.0Ah pack holds roughly twice the energy of a 2.0Ah pack at the same voltage, so it runs about twice as long. It does not make the tool more powerful, only longer-lasting.",
          },
        },
        {
          "@type": "Question",
          name: "Do higher amp-hour batteries make tools more powerful?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Slightly, but not the way people expect. Larger packs use more or better cells that can deliver current with less voltage sag, so demanding tools hold their output better. On a drill the difference is marginal; on a circular saw or a grinder it is noticeable.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use any brand's battery in my tool?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Every manufacturer uses its own battery footprint and communication protocol, and packs are not cross-compatible between brands. This is the single most important thing to understand before buying, because it locks you into an ecosystem for years.",
          },
        },
        {
          "@type": "Question",
          name: "How long do cordless tool batteries last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically three to five years, or several hundred charge cycles, before capacity drops noticeably. Heat is the main enemy, so packs stored in hot vehicles or charged immediately after heavy use age fastest. Calendar ageing continues even on a shelf.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy 12V or 18V cordless tools?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Twelve-volt tools are lighter, shorter and far more comfortable for overhead or cabinet work, and are plenty for assembly and light drilling. Eighteen-volt tools handle everything including heavy drilling, saws and grinders. Most people want 18V as their main platform and some add 12V later.",
          },
        },
        {
          "@type": "Question",
          name: "Is it bad to leave a battery on the charger?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Modern chargers stop charging when full, so it is not dangerous, but leaving packs at one hundred per cent for months does age them faster. For long storage, take them off at around half charge and keep them somewhere cool.",
          },
        },
        {
          "@type": "Question",
          name: "Why won't my battery charge in cold weather?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Charging a lithium pack below freezing damages it permanently, so the charger and the pack refuse until it warms up. This is protection working correctly. Bring the battery indoors, let it reach room temperature, and it will charge normally.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

