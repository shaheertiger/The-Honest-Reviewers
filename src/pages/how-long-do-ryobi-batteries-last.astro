                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Draw</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">2.0 Ah</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">4.0 Ah</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">6.0 Ah</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Work light</td>
