                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Grain visible?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Film thickness</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical failure</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Recoat</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Semi-transparent stain</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Penetrates, minimal film</td>
                    <td class="px-4 py-4 text-gray-700">Fades and wears gradually</td>
                    <td class="px-4 py-4 text-gray-700">Clean and recoat</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solid stain</td>
                    <td class="px-4 py-4 text-gray-700">Texture only</td>
                    <td class="px-4 py-4 text-gray-700">Thin film</td>
                    <td class="px-4 py-4 text-gray-700">Peels on horizontal boards when it fails</td>
                    <td class="px-4 py-4 text-gray-700">Clean, scrape loose spots, recoat</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Deck paint / resurfacer</td>
