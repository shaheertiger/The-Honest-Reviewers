      "best solid deck stain",
      "solid color deck stain",
      "opaque deck stain",
      "solid stain for decks",
      "deck staining"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
