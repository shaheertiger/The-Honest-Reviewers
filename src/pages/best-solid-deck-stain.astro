const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Solid Deck Stain",
          item: "https://www.thehonestreviewers.com/best-solid-deck-stain/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best solid deck stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most decks, Cabot's Solid Color Decking Stain, a water-based acrylic made specifically for decks, with coverage of 400 to 500 square feet per gallon on smooth wood and a 4 to 6 hour recoat window. Olympic Maximum is the better choice for cool or unreliable weather, since it is rated down to 35°F."
          }
        },
        {
          "@type": "Question",
          "name": "Does solid deck stain peel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can, because it forms a film. Peeling usually comes from staining damp wood, staining over a weak or failing surface, or building the film too thick with heavy coats or too many recoats. Clean, dry wood and two thin coats prevent most failures."
          }
        },
        {
          "@type": "Question",
          "name": "How long does solid deck stain last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On a deck floor, typically several years before it needs recoating, longer on rails and fences. Thompson's, for example, is listed with a 6-year guarantee on decks and 15 years on fences and siding, which shows how much harder foot traffic and standing water are on a finish."
          }
        },
        {
          "@type": "Question",
          "name": "Is solid stain the same as deck paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Solid stain is thinner and leaves the wood's texture visible, and it needs sound wood. Deck paint and resurfacers build a thicker film that hides texture and can bridge small cracks. Paint peels in larger sheets when it fails, and is harder to remove."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put solid stain over semi-transparent stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, once the old stain has weathered and the deck has been cleaned. Solid stains cover semi-transparents well. You cannot go the other way: a semi-transparent will not cover or penetrate through a solid stain, which has to be stripped first."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of solid deck stain do you need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two thin coats on deck floors is the standard most manufacturers specify, with the first allowed to dry for the label's recoat time. One-coat products like Wolman DuraStain exist, but they lay down a thicker single film, which suits rails and fences better than busy floors."
          }
        },
        {
          "@type": "Question",
          "name": "Is oil-based or water-based solid stain better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most decks, water-based acrylic: it dries in hours, cleans up with water, holds colour well and stays flexible. Oil-based solid stains penetrate a little more and tend to wear rather than peel, but they dry slowly, need solvent cleanup and come in fewer colours."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
