---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Milwaukee vs DeWalt",
    "url": "/milwaukee-vs-dewalt/"
  },
  {
    "title": "DeWalt vs Makita",
    "url": "/dewalt-vs-makita/"
  },
  {
    "title": "Best Table Saws",
    "url": "/best-table-saw/"
  },
  {
    "title": "Best Jigsaws",
    "url": "/best-jigsaw/"
  },
  {
    "title": "Cordless Tool Batteries Explained",
    "url": "/cordless-tool-batteries-explained/"
  },
  {
    "title": "Best Cordless Tool Brand",
    "url": "/best-cordless-tool-brand/"
  },
  {
    "title": "Ryobi 18V vs 40V",
    "url": "/ryobi-18v-vs-40v/"
  },
  {
    "title": "Best Miter Saws",
    "url": "/best-miter-saw/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Cordless Circular Saws for Framing, Decks and Sheet Goods";
const description =
  "Seven cordless circular saws compared on blade size, battery draw and cuts per charge, plus when a 6-1/2-inch saw is enough and a rear-handle saw is worth it.";

const PRODUCTS = [
  {
    "id": "dewalt-dcs573-circular-saw",
    "name": "DeWalt 20V MAX 7-1/4-Inch Brushless Circular Saw with FLEXVOLT Advantage (DCS573B)",
    "category": "20V MAX Brushless, 7-1/4 in Sidewinder",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1100,
    "pros": [
      "5,500 RPM brushless motor with an electric brake",
      "57-degree bevel capacity and a 2-inch depth of cut at 45 degrees",
      "Recognises a FlexVolt battery and draws substantially more power from it",
      "Runs on any DeWalt 20V MAX battery, one of the largest platforms",
      "2-9/16-inch depth at 90 degrees clears 2x lumber with room to spare"
    ],
    "cons": [
      "Needs a large or FlexVolt battery to reach its potential",
      "Bare tool pricing sits in the premium tier"
    ],
    "bottomLine": "The best cordless circular saw for most people, and the easiest recommendation for anyone on DeWalt 20V.",
    "description": "The DCS573 is DeWalt's mainstream 7-1/4-inch brushless saw, and it earns the top spot by being good at everything rather than extreme at anything. DeWalt rates it at 5,500 RPM, with a 57-degree bevel, a 2-9/16-inch cut at 90 degrees and 2 inches at 45 degrees, which clears 2x lumber at a bevel with margin to spare. It has an electric brake, and in our testing it cross-cut 2x10 framing and ripped 3/4-inch plywood steadily on a 6.0Ah pack. What sets it apart is FlexVolt Advantage. It is a 20V MAX tool that runs on any DeWalt 20V battery, but when you fit a FlexVolt pack it recognises it and draws more power; DeWalt claims up to 77 percent more with a 6.0Ah FlexVolt battery compared with a 5.0Ah 20V pack. In practice that means one saw that is light and manageable on a normal battery and noticeably stronger on a big one, which suits people who cut occasionally but sometimes need to rip wet lumber. On a small 2.0Ah pack it runs, but it bogs down in thick stock, as every saw here does. If you already own DeWalt 20V batteries, this is the saw to buy. If you are starting fresh, budget for at least one large battery alongside it."
  },
  {
    "id": "milwaukee-2834-20-circular-saw",
    "name": "Milwaukee M18 FUEL 7-1/4-Inch Circular Saw (2834-20)",
    "category": "18V Brushless, 7-1/4 in Sidewinder",
    "badge": "Best for Milwaukee Owners",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 400,
    "pros": [
      "6,000 RPM, among the fastest no-load speeds on this list",
      "Up to 750 cuts per charge on an M18 FORGE HD12.0 battery, by Milwaukee's figure",
      "57-degree bevel with detents at 22.5 and 45 degrees",
      "2-5/8-inch depth of cut handles 3x material in one pass",
      "About 7.9 lb bare, light for a full-size saw, with an electric brake"
    ],
    "cons": [
      "Needs a large high-output M18 battery to live up to its claims",
      "Premium pricing, and the big batteries add significantly to it"
    ],
    "bottomLine": "A powerful, well-built saw that belongs at the top of any M18 owner's list.",
    "description": "Milwaukee's current M18 FUEL 7-1/4-inch sidewinder is one of the strongest cordless circular saws you can buy. Milwaukee rates it at 6,000 RPM with a 2-5/8-inch depth of cut, enough to go through 3x material in a single pass, and a 57-degree bevel with detents at 22.5 and 45 degrees. At about 7.9 pounds bare it is light for a full-size saw, and it has an electric brake. In our testing on a large high-output battery it cut through 2x10 fir and ripped plywood without bogging, and it cut steadily through wet pressure-treated decking where smaller-battery saws slowed. Milwaukee claims up to 750 cuts per charge, but that figure uses its large M18 FORGE HD12.0 battery, and the saw is at its best on high-output packs of that class. On a mid-size battery it is still strong, but it runs down noticeably faster. The main case against it is cost: the saw itself is premium, and the batteries that bring out its best are expensive. For existing M18 owners, especially those who already own high-output packs, it is the obvious choice. It is listed with the blade on the right, which suits you if that is the layout you are used to; if you prefer a left blade and a rear handle, look at Milwaukee's rear-handle saw instead."
  },
  {
    "id": "makita-xsh06-circular-saw",
    "name": "Makita 36V (18V X2) LXT Brushless 7-1/4-Inch Circular Saw (XSH06Z)",
    "category": "18V X2 (36V) Brushless, 7-1/4 in",
    "badge": "Best for Makita Owners",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1300,
    "pros": [
      "Runs on two 18V LXT batteries for 36V of power without a new battery system",
      "6,000 RPM with a 2-5/8-inch depth of cut at 90 degrees",
      "Up to 610 crosscuts in 2x4 per charge with two 5.0Ah packs, by Makita's figure",
      "56-degree bevel with positive stops at 22.5, 45 and 56 degrees",
      "Electronically controlled brushless motor matches torque and speed to the cut"
    ],
    "cons": [
      "Needs two charged batteries to run at all",
      "Heavier with both batteries fitted than single-battery saws"
    ],
    "bottomLine": "The most powerful way to cut on Makita 18V batteries, and an excellent saw in its own right.",
    "description": "Makita's answer to the power demands of a 7-1/4-inch saw is to use two of its 18V LXT batteries at once. The XSH06 runs at 36V, and the result is a saw that feels closer to a corded model than most single-battery designs. Makita rates it at 6,000 RPM with a 2-5/8-inch depth of cut at 90 degrees and a bevel range to 56 degrees, with positive stops at 22.5, 45 and 56 degrees. Makita claims up to 610 crosscuts in 2x4 SPF per charge with two 5.0Ah batteries. In our testing it ripped plywood and cross-cut framing lumber with a steadiness that only the Milwaukee and the FlexVolt DeWalt matched. The dual-battery design has a practical advantage for existing Makita owners: you do not need to buy into a new, higher-voltage battery line to get this power, only to own two LXT packs, which most Makita users already do. The drawbacks follow from the same design. You must have two charged batteries to use it at all, and with both fitted it is heavier than the single-battery saws here. Makita also sells a 40V XGT saw, the GSH01, with similar speed and bevel figures, but for existing LXT owners the XSH06 is the smarter buy because it needs no new batteries or charger."
  },
  {
    "id": "dewalt-dcs578-flexvolt-circular-saw",
    "name": "DeWalt FLEXVOLT 60V MAX Brushless 7-1/4-Inch Circular Saw with Brake (DCS578B)",
    "category": "60V FlexVolt Brushless, 7-1/4 in",
    "badge": "Most Powerful",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1500,
    "pros": [
      "60V FlexVolt power, rated at 5,800 RPM",
      "Electric brake stops the blade quickly after trigger release",
      "57-degree bevel with stops at 22.5 and 45 degrees",
      "2-9/16-inch depth of cut at 90 degrees",
      "The most corded-like feel we found in wet and dense lumber"
    ],
    "cons": [
      "Only runs on FlexVolt batteries, which are large and expensive",
      "Heavier and bulkier than 20V saws once the battery is fitted"
    ],
    "bottomLine": "The saw for people who cut a lot of heavy material and want to leave the corded saw at home.",
    "description": "If you want a cordless saw that behaves like a corded one in the toughest material, this is it. The DCS578 runs on DeWalt's 60V FlexVolt batteries only, and DeWalt rates it at 5,800 RPM with a 2-9/16-inch depth of cut, a 57-degree bevel with stops at 22.5 and 45 degrees, and an electric brake. In our testing it was the saw least bothered by long rips through wet pressure-treated lumber, holding its speed where 20V saws on smaller packs slowed down. The catch is the battery. FlexVolt packs are large, heavy and expensive, and this saw will not run on a standard 20V pack at all. The good news is that FlexVolt batteries also run every DeWalt 20V MAX tool, so they are not wasted on other work, though they make a drill or impact driver front-heavy. For most homeowners, the DCS573 with a FlexVolt battery gets surprisingly close to this saw's performance while keeping the option of running on light 20V packs, which is why that saw takes our top spot. The DCS578 makes sense for people who frame, build decks or cut sheet goods in volume, and who would otherwise be dragging a cord across the job site every day."
  },
  {
    "id": "skil-cr5429b-rear-handle-saw",
    "name": "SKIL PWRCORE 20 Brushless 2x20V 7-1/4-Inch Rear Handle Circular Saw Kit (CR5429B-20)",
    "category": "2x20V (40V) Rear-Handle, 7-1/4 in",
    "badge": "Best Rear-Handle Value",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 300,
    "pros": [
      "Rear-handle layout with the long body and sight line framers prefer",
      "Runs on two PWRCORE 20 batteries for 40V of power, rated at 5,300 RPM",
      "Up to 600 cuts per charge with the two included 5.0Ah batteries, by Skil's figure",
      "Electric brake, LED light, rafter hook and a 0-53 degree bevel",
      "Kit includes two 5.0Ah batteries and a dual-port charger, with a 5-year warranty"
    ],
    "cons": [
      "Skil's PWRCORE 20 platform is smaller than the big professional brands",
      "Heavy and long, like every rear-handle saw"
    ],
    "bottomLine": "The most affordable way to get a cordless rear-handle saw with real power, provided you are happy to start the Skil platform.",
    "description": "Cordless rear-handle saws from the professional brands are expensive, which is what makes Skil's version interesting. It is sold as a kit with two PWRCORE 20 5.0Ah batteries and a dual-port charger, and the saw uses both batteries at once for 40V of power. Skil rates it at 5,300 RPM, with a 2-9/16-inch depth of cut, a 0 to 53 degree bevel and an electric brake, and claims up to 600 cuts per charge with the included batteries. The layout is the point. The motor sits behind the blade, the handle is at the back, and the saw is long enough to track straight along a line, which is why framers who learned on worm-drive saws prefer this style. In our testing it tracked well on long rips and cross-cut 2x10s with little fuss. The dual-port charger tops up both batteries together, and Skil says it brings them to 25 percent in about 15 minutes, which is handy when you are waiting on a battery mid-job. The trade-offs are the usual rear-handle ones, weight and bulk, plus a platform question: Skil's PWRCORE 20 catalog is decent for home use but smaller than DeWalt's or Milwaukee's. If you want the rear-handle layout without professional prices, this is the one to buy. Professionals on M18 should look at Milwaukee's 2930-20 rear-handle saw instead."
  },
  {
    "id": "makita-xsh03-circular-saw",
    "name": "Makita 18V LXT Brushless 6-1/2-Inch Circular Saw (XSH03Z)",
    "category": "18V LXT Brushless, 6-1/2 in",
    "badge": "Best Compact",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 1100,
    "pros": [
      "Lighter and easier to control one-handed than any 7-1/4-inch saw here",
      "Automatic Speed Change adjusts speed and torque as the load increases",
      "Runs on a single 18V LXT battery and copes well on mid-size packs",
      "2-1/4-inch depth at 90 degrees cross-cuts 2x lumber square with ease",
      "Smaller blade draws less current, so it cuts longer on the same battery"
    ],
    "cons": [
      "Only 1-5/8 inches deep at 45 degrees, so bevels through 2x lumber are marginal",
      "5,000 RPM is slower than current 7-1/4-inch saws"
    ],
    "bottomLine": "The saw for sheet goods, trim and light carpentry, where a smaller, lighter saw is simply easier to use.",
    "description": "Not everyone needs a 7-1/4-inch saw, and the Makita XSH03 is the best argument for going smaller. It uses a 6-1/2-inch blade with a 2-1/4-inch depth of cut at 90 degrees and 1-5/8 inches at 45 degrees, and Makita rates it at 5,000 RPM. That depth cross-cuts 2x lumber square with ease but makes a 45-degree bevel through it marginal, so this is not the saw for stair stringers or rafters. What it is good at is nearly everything else. It is noticeably lighter and more compact than the full-size saws here, which makes it easier to control on plywood, sheathing, fence boards and trim, and easier to use one-handed or at awkward angles. Makita's Automatic Speed Change technology adjusts speed and torque as the load increases, and in our testing it kept cutting through 3/4-inch plywood rips on a single mid-size LXT battery without the stalling a 7-1/4-inch saw showed on the same pack. It has been on sale for several years, and its 5,000 RPM figure is lower than current full-size saws, but for the jobs it is designed for that makes little practical difference. If you mostly break down sheet goods and do light carpentry, and you own Makita batteries, it is the most pleasant saw on this list to use."
  },
  {
    "id": "ryobi-pblcs300-circular-saw",
    "name": "Ryobi ONE+ HP 18V Brushless 7-1/4-Inch Circular Saw (PBLCS300B)",
    "category": "18V ONE+ HP Brushless, 7-1/4 in",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 700,
    "pros": [
      "Full 7-1/4-inch capacity at a budget price",
      "0-56 degree bevel range",
      "2-7/16-inch depth at 90 degrees and 1-3/4 inches at 45 degrees",
      "Runs on the huge ONE+ battery system shared with hundreds of tools",
      "Ryobi claims more than 325 cuts per charge"
    ],
    "cons": [
      "4,300 RPM is the slowest here, and it bogs in wet or dense lumber",
      "Needs an HP high-output battery to perform well"
    ],
    "bottomLine": "The best circular saw for occasional DIY use on a budget, especially for existing ONE+ owners.",
    "description": "Ryobi's ONE+ HP saw is the budget pick because it gives homeowners full 7-1/4-inch capability at a much lower price than the professional brands. Ryobi rates it at 4,300 RPM with a 2-7/16-inch depth of cut at 90 degrees and 1-3/4 inches at 45 degrees, enough to bevel through 2x lumber, and a bevel range from 0 to 56 degrees. Ryobi claims more than 325 cuts per charge. In our testing it cross-cut 2x10s and ripped plywood competently on a large high-output ONE+ battery, but it was the slowest saw here and bogged down in wet pressure-treated lumber where the brushless professional saws kept going. That is the honest trade: this is a saw for occasional projects, such as a shed, a fence repair or a few sheets of plywood, rather than for building a deck every weekend. The battery matters more than usual. On a standard compact ONE+ pack it struggles; on an HP high-output pack it is a genuinely useful saw. The platform is the other reason to buy it. ONE+ batteries also run Ryobi's drills, drivers, lawn tools and a long list of household tools, and if you already own them, this saw is a sensible and inexpensive addition to the kit."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cordless Circular Saws",
          item: "https://www.thehonestreviewers.com/best-cordless-circular-saw/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cordless circular saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, it is the 7-1/4-inch brushless saw from the battery platform they already own. If you are starting fresh, the DeWalt DCS573 is our top pick for its balance of power, weight and features. The Milwaukee M18 FUEL 2834-20 and the Makita XSH06 are equally strong choices for owners of those batteries, and the Ryobi PBLCS300 is the budget pick."
          }
        },
        {
          "@type": "Question",
          "name": "Is a cordless circular saw as powerful as a corded one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Close, with the right battery. Current brushless 7-1/4-inch saws on large high-output packs cut 2x lumber and plywood about as fast as a typical corded saw. They still fall behind on long rips through wet or dense lumber, where a corded saw never tires and never needs a battery swap. For most home projects, the difference is small."
          }
        },
        {
          "@type": "Question",
          "name": "What size battery do I need for a cordless circular saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At least 5.0Ah for a 7-1/4-inch saw, and preferably a high-output pack. Smaller batteries will run the saw, but it bogs down in thick material and needs recharging often. A 6-1/2-inch saw can manage on a mid-size pack. Owning two batteries, so one is always charging, is the practical minimum for a full day of cutting."
          }
        },
        {
          "@type": "Question",
          "name": "Should I get a 6-1/2 or 7-1/4 inch circular saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Get 7-1/4 inches if you will bevel-cut 2x lumber, build decks or do any framing. Get 6-1/2 inches if you mainly cut plywood, trim and fence boards and want a lighter saw. The larger size is more versatile and uses the most widely available blades, which is why it is our default recommendation for a first saw."
          }
        },
        {
          "@type": "Question",
          "name": "Is a rear-handle circular saw better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not better, just different. Rear-handle saws track straighter on long cuts and give right-handed users a clear view of a left-side blade, which is why framers like them. They are also heavier and bulkier. For general DIY use, a sidewinder is easier to handle and store. Buy a rear-handle saw if you frame in volume or already prefer the layout."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need an electric brake on a circular saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We would not buy a saw without one. An electric brake stops the blade within a couple of seconds of releasing the trigger, which prevents injuries from a coasting blade and saves time between cuts. Most brushless saws from the major brands include one, so choosing a saw with a brake rarely costs anything extra."
          }
        },
        {
          "@type": "Question",
          "name": "Can a cordless circular saw replace a table saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For breaking down sheet goods and rough cuts, yes, especially with a straightedge guide. For repeated, precise rip cuts, no; a table saw is faster, more accurate and safer for that work. Many DIYers use a circular saw to cut full sheets down to a manageable size and then a table saw for the finished dimensions."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "best cordless circular saw",
      "cordless circular saw",
      "battery circular saw",
      "rear handle circular saw",
      "7-1/4 circular saw",
      "brushless circular saw"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Saws Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Cordless Circular Saws</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We cross-cut 2x10s, ripped plywood and bevel-cut decking with seven battery saws to find out which ones genuinely replace a corded saw, and which battery you need to make them do it.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dewalt-dcs573-circular-saw"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Choose
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#blade-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. 6-1/2 vs 7-1/4 Inch</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
