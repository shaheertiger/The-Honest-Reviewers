const title = "How to Paint a Concrete Floor: Test, Prep, Prime and Roll Two Thin Coats";
const description =
  "Paint a concrete floor in six steps: moisture test, degrease, etch or grind, fix cracks, prime if needed, then two thin rolled coats. Tools, timing and traps.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Paint a Concrete Floor",
          item: "https://www.thehonestreviewers.com/how-to-paint-a-concrete-floor/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do I need to etch concrete before painting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes, unless the surface is already rough and porous. Smooth, troweled concrete is often too dense for paint to grip, and etching or grinding opens it up. Do the water-drop test: if water soaks in quickly, the surface may already be porous enough. Check the paint label, since many floor paints specifically require etching or grinding on smooth slabs."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint concrete without primer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes. Many floor paints are self-priming on clean, properly profiled concrete, often with a slightly thinned first coat. Others require a primer on bare, porous, chalky or previously coated floors, or when switching from oil-based to water-based paint. The label is the deciding authority. When in doubt, a concrete bonding primer from the same brand is cheap insurance."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of paint does a concrete floor need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two thin coats is the standard. The first coat soaks into the porous concrete and often looks uneven; the second gives uniform color and the full film thickness the floor needs for durability. A third coat is rarely necessary and can make the film too thick. Very porous or rough floors may need a primer instead of an extra coat."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint concrete floors with regular wall paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not a good idea. Interior wall paint is not formulated for foot traffic, abrasion or the alkalinity and moisture of concrete, and it will scuff and wear through quickly. Use a paint labeled for concrete or porch and floor use, or a one-part epoxy-acrylic floor paint, which are designed to bond to masonry and resist wear."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint over old concrete floor paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the old paint is well bonded. Clean and degrease it, scuff-sand the surface to dull any gloss, vacuum, and use a primer if the new paint label requires one or if you are switching from oil-based to water-based. If the old paint fails a tape test or is peeling, remove the loose paint first, or the new coat will fail with it."
          }
        },
        {
          "@type": "Question",
          "name": "What roller should I use to paint a concrete floor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 3/8-inch nap roller works well on smooth concrete, and a 1/2-inch nap is better on rougher or more porous surfaces because it pushes paint into the texture. Use a sturdy frame on an extension pole so you can roll standing up with even pressure. A high-quality, lint-free cover avoids shedding fibers into the finish."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal concrete after painting it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Floor paint is designed to be the finished surface, and most clear sealers are not tested over paint and may not bond or may cloud. Some manufacturers offer a compatible clear topcoat for extra wear resistance in garages. If you want one, use only a topcoat the paint manufacturer approves and follow its timing instructions."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
