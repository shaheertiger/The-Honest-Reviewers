---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Prepare a Driveway for Winter", url: "/how-to-prepare-a-driveway-for-winter/" },
    { title: "Driveway Crack Repair", url: "/driveway-crack-repair/" },
    { title: "How to Fix a Crumbling Asphalt Driveway", url: "/how-to-fix-crumbling-asphalt-driveway/" },
    { title: "Driveway Resurfacing Cost", url: "/driveway-resurfacing-cost/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "How to Fix Puddles in an Asphalt Driveway";
const description =
  "Standing water is the fastest way to destroy asphalt. How to tell a surface depression from a base failure, and the four repairs that suit each depth.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Fix Puddles in an Asphalt Driveway", item: "https://www.thehonestreviewers.com/how-to-fix-puddles-in-an-asphalt-driveway/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why does my asphalt driveway hold puddles?",
          acceptedAnswer: { "@type": "Answer", text: "Either the surface has settled into a low spot, or the base underneath has failed and the asphalt has sagged with it. Settlement over a soft or poorly compacted base is the most common cause, followed by inadequate slope from the original build, a section that was patched and compacted below grade, and tree roots or utility trenches disturbing the base. The depth of the puddle usually tells you which." },
        },
        {
          "@type": "Question",
          name: "Is standing water bad for an asphalt driveway?",
          acceptedAnswer: { "@type": "Answer", text: "It is the single most destructive thing that happens to asphalt short of heavy vehicles. Water sitting on the surface strips the binder from the aggregate, softening the asphalt and leading to ravelling and potholes. Worse, it soaks through to the base, saturating and weakening it, and in freezing climates it expands as ice and lifts the surface apart. A puddle that returns after every rain will produce a pothole." },
        },
        {
          "@type": "Question",
          name: "How do you fix a low spot in an asphalt driveway?",
          acceptedAnswer: { "@type": "Answer", text: "For depressions under about half an inch, a skim of asphalt-based patching or a driveway resurfacer feathered out to the edges works. Between half an inch and an inch and a half, cold patch or hot mix compacted properly is the answer. Deeper than that, the base has almost certainly failed and the correct repair is to cut out the section, rebuild the base, and lay new asphalt." },
        },
        {
          "@type": "Question",
          name: "Can you just fill a puddle with driveway sealer?",
          acceptedAnswer: { "@type": "Answer", text: "No, and it is the most common mistake here. Sealer is a coating a fraction of a millimetre thick, not a filler. Poured into a depression it pools, cures unevenly, stays soft in the middle, and often stays tacky for weeks — while the low spot remains exactly as low as it was. Fix the level with a patching material first, then seal the whole driveway afterwards." },
        },
        {
          "@type": "Question",
          name: "How much slope does an asphalt driveway need to drain?",
          acceptedAnswer: { "@type": "Answer", text: "A minimum of about one to two percent — roughly an eighth to a quarter inch of fall per foot — and more is better on a long run. Below that, surface tension and minor irregularities are enough to hold water. If a whole area of your driveway is flat rather than dipped, no patch will fix it, because there is nowhere for the water to go once the low spot is filled." },
        },
        {
          "@type": "Question",
          name: "Should you fix puddles before sealing a driveway?",
          acceptedAnswer: { "@type": "Answer", text: "Always. Sealer applied over a depression pools there, cures slowly and unevenly, and can stay soft and tacky through the season. Repair the level first, allow the patch material to cure for the time the manufacturer specifies — often 24 to 72 hours for cold patch and up to 30 days for some hot mix — then seal the whole surface." },
        },
        {
          "@type": "Question",
          name: "How deep does a puddle have to be before it is a base problem?",
          acceptedAnswer: { "@type": "Answer", text: "As a rule of thumb, more than about an inch and a half of standing water, or any depression that keeps getting deeper year on year, points to the base rather than the surface. Other tells are cracking in a rough circle or web around the low spot, asphalt that feels soft or springy underfoot when warm, and edges that have started to crumble." },
        },
        {
          "@type": "Question",
          name: "How much does it cost to fix a low spot in a driveway?",
          acceptedAnswer: { "@type": "Answer", text: "A DIY skim or cold patch repair on a small depression costs $30 to $100 in materials. A professional infrared patch on a single low area typically runs $300 to $800. A full cut-out and base rebuild is $8 to $15 per square foot, and resurfacing the whole driveway to correct multiple low areas usually starts around $3 to $7 per square foot." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveways & Asphalt",
    tags: ["asphalt driveway puddles", "driveway low spot", "asphalt drainage", "driveway repair"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Crack Fillers", link: "/best-driveway-crack-filler/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Repair</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">How to Fix <span class="text-[#38BDF8]">Puddles</span> in an Asphalt Driveway</h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Standing water is not a cosmetic complaint. It is the mechanism by which asphalt driveways fail — and the depth of the puddle tells you which repair you need.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#diagnose" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">Measure It First</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="7.9k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-it-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why Puddles Destroy Asphalt</a>
          <a href="#diagnose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Measuring and Diagnosing</a>
          <a href="#causes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Why It Is Low</a>
          <a href="#shallow" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Shallow: Skim Patching</a>
          <a href="#medium" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Medium: Cold or Hot Patch</a>
          <a href="#deep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Deep: Cut Out and Rebuild</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When Slope Is the Problem</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Everybody treats a birdbath in the driveway as an appearance problem that can wait. It cannot. Water sitting on asphalt is actively dismantling it, and the pothole that appears in three years will be exactly where the puddle was.
        </p>

        <div id="why-it-matters" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Why Puddles Destroy Asphalt</h2>

          <p>
            Asphalt is aggregate held together by bitumen binder. Water attacks that bond directly through a process called stripping — the binder loses its grip on the stone, and the surface begins shedding aggregate. That is what ravelling is, and it always starts where water sits longest.
          </p>

          <p>
            Underneath, the damage is worse. Asphalt is permeable enough that standing water works down into the aggregate base, and a saturated base loses much of its bearing strength. Every vehicle that then parks on that spot pushes the softened base down further, which deepens the depression, which holds more water. It is a feedback loop, and it accelerates.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">In Freezing Climates It Is Faster</p>
            <p class="text-xl font-bold text-white mb-3">Water in the base expands roughly nine percent when it freezes, lifting the asphalt above it — then leaves a void when it thaws.</p>
            <p class="text-gray-300 leading-relaxed m-0">Repeated through a winter, that cycle breaks the surface apart from underneath. A driveway that holds water in November is measurably worse in March, which is why fixing a low spot before winter is worth considerably more than fixing it in spring.</p>
          </div>

          <p>
            The practical implication is that a puddle is a deadline rather than a blemish. Repaired while it is a shallow depression, it is an afternoon and $50. Left for three seasons, it becomes a soft, cracked, crumbling area needing a cut-out and base rebuild — the failure described in <a href="/how-to-fix-crumbling-asphalt-driveway/">how to fix a crumbling asphalt driveway</a>.
          </p>
        </div>

        <div id="diagnose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Measuring and Diagnosing</h2>

          <p>
            Do this after rain, while the puddle is there, because a dry driveway hides low spots remarkably well.
          </p>

          <p>
            Measure the deepest point with a ruler stood in the water. Then, once dry, lay a straight board — an eight-foot level or a straight length of timber — across the depression and measure the gap underneath at its worst point. That second number is the one that decides the repair, because it tells you how far below grade the surface has dropped independent of how the water spread.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Depth</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Likely Cause</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Repair</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Under 1/4"</td>
                    <td class="px-4 py-4 text-gray-700">Surface irregularity or flat slope</td>
                    <td class="px-4 py-4 text-gray-700">Often leave it; check slope</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/4" - 1/2"</td>
                    <td class="px-4 py-4 text-gray-700">Minor settlement</td>
                    <td class="px-4 py-4 text-gray-700">Skim patch or resurfacer</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/2" - 1.5"</td>
                    <td class="px-4 py-4 text-gray-700">Settlement over a soft spot</td>
                    <td class="px-4 py-4 text-gray-700">Cold patch or hot mix, compacted</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Over 1.5"</td>
                    <td class="px-4 py-4 text-gray-700">Base failure</td>
                    <td class="px-4 py-4 text-gray-700">Cut out, rebuild base, repave</td>
                  </tr>
                  <tr class="bg-white">
                    <td class="px-4 py-4 font-black text-gray-900">Any depth, growing yearly</td>
                    <td class="px-4 py-4 text-gray-700">Active base failure</td>
                    <td class="px-4 py-4 text-gray-700">Cut out and rebuild</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Alongside depth, look for three signs that the base rather than the surface is the problem: cracking in a rough ring or web around the depression, asphalt that feels soft or springy underfoot on a warm day, and edges that have begun to crumble. Any of those, at any depth, moves you down to the bottom row. Web cracking specifically is covered in <a href="/how-to-fix-alligator-cracks-in-asphalt-driveway/">how to fix alligator cracks</a>.
          </p>
        </div>

        <div id="causes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Why That Spot Is Low</h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Poor base compaction at construction.</strong> The most common cause by far. A patch of base that was never properly compacted settles under traffic over the first few years.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>A backfilled trench underneath.</strong> Utility, drainage or irrigation trenches settle for years afterwards, and the low spot usually runs in a suspiciously straight line.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>A previous patch compacted below grade.</strong> Cold patch that was never properly compacted keeps consolidating under traffic, ending up lower than the surface around it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Insufficient slope from the original build.</strong> Not a dip at all — a flat area that never drained. Filling it achieves nothing because the water has nowhere to go.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Concentrated load in one place.</strong> A trailer tongue jack, a skip, or years of parking the same heavy vehicle on the same square metre.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Water arriving from elsewhere.</strong> A downspout discharging onto the drive, or runoff from a slope, undermines the base from the side and washes fines out of it.</span>
            </li>
          </ul>

          <p>
            That last one is worth checking before any repair, because it is both the easiest to fix and the one most likely to destroy your work. If a downspout is discharging near the low spot, extending it away from the driveway costs $20 and removes the cause.
          </p>
        </div>

        <div id="shallow" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Shallow Depressions: Skim Patching</h2>

          <p>
            For anything up to about half an inch, an asphalt-based patching compound or a driveway resurfacer applied as a skim is the right tool. These are trowelable materials designed to feather to nothing at the edges, which matters because a hard edge becomes a trip hazard and a place for water to sit again.
          </p>

          <p>
            Clean the area thoroughly first — sweep, then wash, then let it dry completely. Any dust or loose aggregate under the patch becomes a bond breaker. Some products call for a primer or a tack coat; use it if specified, because adhesion is the whole game on a thin repair.
          </p>

          <p>
            Apply with a squeegee or trowel, working from the centre of the depression outward and feathering the edges to nothing. Build up in thin lifts rather than one thick application; a resurfacer applied too thick will crack as it cures. Most products want 24 to 48 hours before traffic and longer before sealing.
          </p>

          <p>
            One realistic expectation: a skim repair is a surface correction and will not last forever if the underlying cause is still active. On a stable driveway it is a durable fix; on one that is still settling, it buys you a few years and will need repeating. Our guide to <a href="/driveway-sealer-vs-resurfacer/">sealer versus resurfacer</a> covers which product class does what.
          </p>
        </div>

        <div id="medium" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Medium Depressions: Cold Patch or Hot Mix</h2>

          <p>
            Between roughly half an inch and an inch and a half, you need a material with aggregate in it that can be compacted. Skimming a depression this deep with a resurfacer produces a soft, cracking repair that fails within a season.
          </p>

          <p>
            <strong>Cold patch</strong> is the DIY option — a pre-mixed asphalt that stays workable at ambient temperature. Clean the area, remove any loose or crumbling material, and fill in lifts of no more than an inch at a time, compacting each thoroughly. Compaction is where cold patch repairs succeed or fail, and it needs far more than treading it down: a hand tamper worked hard, a plate compactor if you can rent one, or at minimum driving over it repeatedly with a vehicle after tamping. Overfill by about a quarter inch before compacting, because it will consolidate.
          </p>

          <p>
            <strong>Hot mix</strong> is what a contractor uses, and it makes a substantially better repair because it bonds properly and compacts to a denser finish. It is not realistically a DIY material for a small area, since it must be laid and compacted while hot. If you have a contractor coming anyway, a hot mix patch on a low area is money well spent.
          </p>

          <p>
            <strong>Infrared patching</strong> is worth asking about for a medium depression. The contractor heats the existing asphalt in place until it is workable, adds material, relevels and recompacts — producing a seamless repair with no cold joint at the perimeter for water to exploit. It typically runs $300 to $800 for a single area and is the best-value professional repair for exactly this problem. More on cold-weather material choices is in <a href="/cold-patch-asphalt/">cold patch asphalt</a>.
          </p>
        </div>

        <div id="deep" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Deep Depressions: Cut Out and Rebuild</h2>

          <p>
            Past about an inch and a half, or wherever the depression is growing year on year, the base has failed and no surface repair addresses that. Filling the dip puts new material on top of the same soft base, and it settles again — usually within two years, and usually deeper than before.
          </p>

          <p>
            The correct repair is a full-depth patch. Saw-cut a square or rectangular section extending at least a foot beyond the failed area into sound asphalt, remove the asphalt, then excavate and inspect the base. Wet, muddy or fine-heavy base material comes out. Replace it with properly graded aggregate placed and compacted in lifts, then lay new asphalt in two lifts and compact each.
          </p>

          <p>
            This is genuinely a contractor job in most cases, both for the saw cutting and because achieving proper compaction needs plate or roller equipment. Budget $8 to $15 per square foot. It is the most expensive option on this page and the only one that actually solves a base failure, which makes it cheaper than doing the wrong repair three times.
          </p>

          <p>
            If several areas need this treatment, get a resurfacing quote alongside the patch quotes. Once you are into multiple full-depth patches, an overlay across the whole driveway sometimes costs little more and corrects the levels everywhere at once — <a href="/driveway-resurfacing-cost/">driveway resurfacing cost</a> covers the numbers.
          </p>
        </div>

        <div id="drainage" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. When Slope Is the Real Problem</h2>

          <p>
            There is a version of this problem that no patch can solve. If the water is sitting on a broad flat area rather than in a defined dip, the driveway simply lacks the slope to shed it. Asphalt needs about one to two percent fall — an eighth to a quarter inch per foot — and below that, water stays put.
          </p>

          <p>
            You can confirm this with a long straightedge and a level: if the board sits flat on the surface with no meaningful gap and the water still pools, there is no depression to fill. Adding material here just relocates the flat spot slightly.
          </p>

          <p>
            The real options are an overlay graded to create fall, which means a contractor and a design conversation about where the water should go; a trench drain or channel drain installed across the low area and piped away, which is often the neatest answer near a garage door; or regrading the surrounding ground so water at least has somewhere to leave to. None of these is cheap, which is why it is worth establishing early whether you have a dip or a flat.
          </p>

          <p>
            Whatever the fix, deal with the water arriving from elsewhere first. Downspouts discharging onto the drive, a neighbouring slope shedding onto it, or a lawn edge higher than the asphalt will each defeat good drainage on their own — and each is far cheaper to correct than regrading.
          </p>
        </div>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">8. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Filling a Low Spot With Driveway Sealer</h3>
              <p class="text-gray-700 text-sm m-0">Sealer is a coating a fraction of a millimetre thick, not a filler. Poured into a depression it pools, cures unevenly, stays soft and tacky for weeks, and leaves the low spot exactly as low. Level with a patching material first, then seal the whole surface.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Under-Compacting Cold Patch</h3>
              <p class="text-gray-700 text-sm m-0">Treading it down is not compaction. Under-compacted patch keeps consolidating under traffic and ends up lower than the surface around it — recreating the puddle you were fixing. Fill in one-inch lifts, overfill slightly, and tamp hard or hire a plate compactor.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Patching Over a Failed Base</h3>
              <p class="text-gray-700 text-sm m-0">A depression deeper than an inch and a half, or one that grows every year, means the base is gone. New material laid over it settles again within a couple of years. Cut out, rebuild and recompact, or accept that you will be back.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Ignoring Where the Water Comes From</h3>
              <p class="text-gray-700 text-sm m-0">A downspout discharging onto the drive undermines the base continuously and will destroy any repair you make. Check for it before you buy materials — an extension costs $20 and removes the cause rather than the symptom.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealing Before the Patch Has Cured</h3>
              <p class="text-gray-700 text-sm m-0">Cold patch needs 24 to 72 hours and some hot mix wants up to 30 days before it will take sealer properly. Sealing too soon traps volatiles, leaves a soft spot, and produces exactly the tacky patch that gets tracked into the garage.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does my driveway hold puddles?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Either the surface settled into a low spot or the base failed and the asphalt sagged with it. Common causes are poor base compaction, inadequate slope from the original build, a previous patch compacted below grade, and trenches or roots disturbing the base.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is standing water bad for asphalt?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">It is the most destructive thing that happens to asphalt short of heavy vehicles. Water strips binder from aggregate, causing ravelling, and soaks into the base, weakening it. In freezing climates it expands as ice and breaks the surface apart from below.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you fix a low spot?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Under half an inch, a skim of asphalt patching or resurfacer feathered to the edges. Half an inch to an inch and a half, cold patch or hot mix properly compacted. Deeper than that, the base has failed and the section needs cutting out and rebuilding.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you fill a puddle with sealer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">No — it is the most common mistake here. Sealer is a thin coating, not a filler. In a depression it pools, cures unevenly, stays soft, and the low spot remains. Fix the level with a patching material first, then seal the whole driveway.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much slope does a driveway need?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">One to two percent minimum — an eighth to a quarter inch of fall per foot. Below that, minor irregularities hold water. If a whole area is flat rather than dipped, patching will not help, because filled or not the water has nowhere to go.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Fix puddles before sealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Always. Sealer over a depression pools, cures unevenly, and can stay tacky all season. Repair the level, let the patch cure for the specified time — often 24 to 72 hours for cold patch, up to 30 days for some hot mix — then seal.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">When is it a base problem?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Over about an inch and a half of standing water, or any depression deepening year on year. Other tells are cracking in a ring or web around the low spot, asphalt that feels springy underfoot when warm, and crumbling edges.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What does it cost to fix?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">DIY skim or cold patch on a small area, $30 to $100 in materials. A professional infrared patch, $300 to $800. A full cut-out and base rebuild, $8 to $15 per square foot. Resurfacing to correct multiple low areas usually starts at $3 to $7 per square foot.</p>
            </div>
          </div>
        </div>

