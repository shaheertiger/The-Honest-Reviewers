                    <td class="px-4 py-4 text-gray-700">Mid-range and premium electrics</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Life expectation</td>
                    <td class="px-4 py-4 text-gray-700">Fine for light use</td>
                    <td class="px-4 py-4 text-gray-700">Usually outlasts the pump</td>
