                <td class="px-4 py-4 text-gray-700">$9,600</td>
              </tr>
              <tr class="bg-white">
                <td class="px-4 py-4 font-black text-gray-900">Rural drive, 12 x 125</td>
                <td class="px-4 py-4 text-gray-700">1,500</td>
                <td class="px-4 py-4 text-gray-700">$6,000</td>
