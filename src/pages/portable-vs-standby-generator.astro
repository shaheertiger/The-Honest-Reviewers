---
import Layout from "../layouts/Layout.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Portable vs Standby Generator: Which Is Better?";
const description =
  "A standby unit starts itself and runs the house. A portable costs a fraction and needs you home to run it. Here is which one fits your outages.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Comparisons",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Portable vs Standby Generator",
          item: "https://www.thehonestreviewers.com/portable-vs-standby-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is a standby generator better than a portable?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For long or unattended outages, yes — it starts itself within seconds, runs off the gas main with no refuelling, and has the capacity for central air conditioning. For occasional short outages while someone is home, a portable delivers most of the practical benefit at a fraction of the cost.",
          },
        },
        {
          "@type": "Question",
          name: "Can a portable generator power a whole house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not the whole house, but it can power the essentials. A 7,500W portable connected through a transfer switch typically runs a refrigerator, freezer, furnace blower, sump pump and lighting comfortably. What it generally cannot do is start a three-ton central air conditioner, which surges to 9,000-12,000 watts.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a transfer switch for a portable generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You need one for any hardwired load — a furnace, sump pump or well pump cannot be reached by extension cord. A manual transfer switch or an interlock kit is a modest addition to the cost and dramatically expands what the generator can do. Never backfeed the panel through a wall outlet.",
          },
        },
        {
          "@type": "Question",
          name: "How long can a portable generator run continuously?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically eight to twelve hours on a tank under load, after which it needs refuelling by hand. Most manufacturers also recommend shutting down periodically to check oil and let the unit cool. That refuelling cycle is the practical limit on portables during multi-day outages.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a standby generator cost to install?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The installation frequently approaches or exceeds the price of the unit itself, because it involves an electrician, a gas connection, a concrete pad, an automatic transfer switch, and usually permits and inspection. Cost varies substantially with how far the unit sits from the electrical panel and the gas meter.",
          },
        },
        {
          "@type": "Question",
          name: "Will a standby generator run my air conditioning?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually yes. Standby units generally start at around 10,000 watts and commonly run to 22,000 or more, which is enough to handle the 9,000 to 12,000 watt surge of a three-ton central air conditioner alongside other household loads. This is one of the clearest advantages over a portable.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: "2026-08-31",
      dateModified: "2026-08-31",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

