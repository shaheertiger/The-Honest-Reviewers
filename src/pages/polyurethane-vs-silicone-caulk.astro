      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between polyurethane and silicone caulk?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Polyurethane bonds exceptionally well to concrete and masonry, can be painted, and resists abrasion, which makes it the construction sealant for expansion joints and horizontal surfaces. Silicone bonds better to glass, tile and metal, resists ultraviolet light far longer, and is the right choice in wet areas — but it cannot be painted.",
          },
        },
