const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Concrete Degreaser",
          item: "https://www.thehonestreviewers.com/best-concrete-degreaser/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best concrete degreaser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most garages, Oil Eater Original 1 Gallon is the best all-round concrete degreaser: water-based, non-flammable and diluted to suit anything from a whole-floor wash to a fresh oil drip. For a whole driveway, Zep ZUCON128 is cheaper per gallon of solution, and for pressure washers the Krud Kutter 385466 concentrate is made to be drawn through the machine."
          }
        },
        {
          "@type": "Question",
          "name": "Will a degreaser remove old oil stains from concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not completely. A degreaser cleans oil on and just below the surface, so it lightens an old stain by removing the dirt and surface oil on top of it. Oil that has wicked deep into the slab needs a poultice that draws it out as it dries, or a microbial product that digests it over several weeks."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a degreaser in my pressure washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the product is labeled for it or the maker gives pressure washer instructions. Krud Kutter 385466 is formulated for pressure washers, and Simple Green gives pre-mix and siphon directions for Pro HD. Check your washer's manual before running citrus or solvent products through the pump, and always apply detergent with the low-pressure soap nozzle."
          }
        },
        {
          "@type": "Question",
          "name": "Does degreaser damage concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Alkaline degreasers do not etch concrete, which is itself strongly alkaline; etching is done by acids. A cleaned spot can look lighter than the surrounding floor because it is simply cleaner. Solvent degreasers can, however, soften asphalt and some acrylic sealers, so test on sealed or coated surfaces before using them broadly."
          }
        },
        {
          "@type": "Question",
          "name": "Is Oil Eater safe for asphalt driveways?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oil Eater is water-based and listings describe it as free of petroleum solvents, which makes it gentler on asphalt than citrus or solvent products. Use a lighter ratio on blacktop, do not let it sit long or dry, and rinse thoroughly. For fresh oil on asphalt, absorbing the spill quickly matters more than which degreaser you choose."
          }
        },
