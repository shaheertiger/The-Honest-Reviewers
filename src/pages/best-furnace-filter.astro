  {
    "id": "filtrete-mpr-1900-merv-13",
    "name": "Filtrete MPR 1900 MERV 13 Air Filter (16x25x1)",
    "category": "MERV 13 / MPR 1900, Pleated, 3-Month, Actual 15.62 x 24.62 x 0.78 in",
