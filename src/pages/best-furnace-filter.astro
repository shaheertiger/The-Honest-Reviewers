import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Air Purifiers for Allergies",
    "url": "/best-air-purifier-for-allergies/"
  },
  {
    "title": "Best Air Purifiers for Home",
