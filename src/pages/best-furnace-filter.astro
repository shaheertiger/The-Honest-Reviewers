        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Furnace Filters",
          item: "https://www.thehonestreviewers.com/best-furnace-filter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
