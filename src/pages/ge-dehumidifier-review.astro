---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best 50 Pint Dehumidifiers",
    "url": "/best-50-pint-dehumidifier/"
  },
  {
    "title": "Best Smart Dehumidifiers",
    "url": "/best-smart-dehumidifier/"
  },
  {
    "title": "Midea Cube Dehumidifier Review",
    "url": "/midea-cube-dehumidifier-review/"
  },
  {
    "title": "Best Dehumidifiers With a Pump",
    "url": "/best-dehumidifier-with-pump/"
  },
  {
    "title": "Best Dehumidifier for Basement",
    "url": "/best-dehumidifier-for-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "GE Dehumidifier Review: The 25, 35 and 50 Pint Models Compared";
const description =
  "GE's ADHE dehumidifiers compared: 25, 35 and 50 pint, the pump and Wi-Fi versions, bucket size, Smart Dry, warranty, the ADSE successor and who should skip GE.";

const PRODUCTS = [
  {
    "id": "ge-adhe50bwf",
    "name": "GE 50 Pint Dehumidifier with Smart Dry (ADHE50BWF)",
    "badge": "Best Overall",
    "category": "50 Pints/Day, 15 Pint Bucket, No Pump",
    "amazonUrl": "#",
    "description": "The ADHE50BWF is the GE most people should buy. It is rated at 50 pints a day under the DOE test, and Total Home Supply's listing gives it a 15 pint front bucket, three fan speeds with 160 and 200 CFM of airflow, a 30 to 70 percent humidistat in 5 percent steps, a 41 degree minimum operating temperature, a 24 hour timer, auto restart, a permanent mesh filter with a 250 hour reminder and R32 refrigerant. It measures 24.1 by 14.4 by 11.4 inches and weighs 41.1 pounds, on casters with pocket handles, and that retailer lists it as ENERGY STAR certified. Smart Dry adjusts the fan to the room's humidity. It has no Wi-Fi and no pump, but it has a garden-hose continuous drain, which is the best way to run it. GE's site lists it as no longer manufactured, and the warranty is a one-year replacement.",
    "pros": [
      "50 pints/day with Smart Dry fan control",
      "Garden-hose continuous drain",
      "Three fan speeds, 30-70% humidistat",
      "Listed as ENERGY STAR by Total Home Supply"
    ],
    "cons": [
      "15 pint bucket fills fast at full output",
      "One-year replacement warranty",
      "Marked no longer manufactured on GE's site"
    ],
    "bottomLine": "The default GE for a damp basement with a drain nearby: all the drying of the range, without paying for a pump or an app."
  },
  {
    "id": "ge-adhe50pwf",
    "name": "GE 50 Pint Dehumidifier with Built-In Pump (ADHE50PWF)",
    "badge": "Best With a Pump",
    "category": "50 Pints/Day, Built-In Pump, 16 ft Hose",
    "amazonUrl": "#",
    "description": "The ADHE50PWF is the GE 50 pint with a built-in pump and an included hose, for basements with no floor drain. GE's dealer store says it can drain to a location up to 16 feet away, and the Amazon listing describes pumping 15 feet vertically with a 16 foot hose. It keeps the standard continuous drain connector as a fallback. The same dealer listing gives it a 15 pint bucket, three fan speeds at 160 and 200 CFM, automatic defrost, Smart Dry, a 24 hour timer, auto restart, a 10 second full-bucket alarm and a permanent mesh filter. It measures 24.1 by 14.4 by 11.4 inches and weighs 44 pounds. Two cautions: the dealer store lists its Integrated Energy Factor at 1.6, below the 2.01 of current ENERGY STAR 50 pint models, and its warranty is a limited one-year exchange with no labor. Best Buy lists it at 51 decibels.",
    "pros": [
      "Built-in pump with included hose",
      "Gravity drain connector as a backup",
      "Smart Dry and automatic defrost",
      "Same footprint as the non-pump 50"
    ],
    "cons": [
      "Listed IEF of 1.6 L/kWh",
      "Pump faults are a common owner complaint",
      "One-year exchange-only warranty"
    ],
    "bottomLine": "Buy it only if gravity drainage is impossible; otherwise the ADHE50BWF and a hose is simpler and more efficient."
  },
  {
    "id": "ge-adhe50wwf",
    "name": "GE 50 Pint Wi-Fi Smart Dehumidifier (ADHE50WWF)",
    "badge": "Best Smart GE",
    "category": "50 Pints/Day, SmartHQ Wi-Fi, No Pump",
    "amazonUrl": "#",
    "description": "The ADHE50WWF is the ADHE50BWF with built-in Wi-Fi. Through GE's SmartHQ app you can check humidity, change the target and switch it on or off from your phone, and the Amazon listing mentions Alexa and Google voice control. Otherwise Total Home Supply's specs match the basic model: 50 pints a day, a 15 pint front bucket, three fan speeds, a 30 to 70 percent humidistat, a 41 degree minimum, a 24 hour timer, auto restart, a filter reminder at about 250 hours, 24.1 by 14.4 by 11.4 inches and 41.1 pounds, with ENERGY STAR certification and a one-year replacement warranty. That retailer says it replaces the AWYR50LC. It has no pump, so drainage is by bucket or garden hose. If the unit lives in a basement or second home you rarely visit, the app earns its keep; if you set it once and forget it, buy the B model.",
    "pros": [
      "SmartHQ app control over Wi-Fi",
      "Alexa and Google voice control per Amazon listing",
      "Same drying and controls as the ADHE50BWF",
      "Listed as ENERGY STAR"
    ],
    "cons": [
      "App adds nothing if you never use it",
      "No pump",
      "One-year replacement warranty"
    ],
    "bottomLine": "The GE to buy if you will genuinely check humidity from your phone; otherwise save money with the ADHE50BWF."
  },
  {
    "id": "ge-adhe35bwf",
    "name": "GE 35 Pint Dehumidifier with Smart Dry (ADHE35BWF)",
    "badge": "Best Mid-Size",
    "category": "35 Pints/Day, Compact Chassis",
    "amazonUrl": "#",
    "description": "The ADHE35BWF is GE's middle size, rated at 35 pints a day, and its appeal is the smaller body. GE lists it at 19.4 by 13.2 by 9.9 inches, almost 5 inches shorter than the 50 pint models, and AJ Madison gives a net weight of 36 pounds. Retailer listings describe three fan speeds, digital controls, Smart Dry and low temperature operation, and GE's Amazon listing pitches it for spaces up to 3,000 square feet with a continuous drain option, bucket-full alarm and auto restart. We could not find a published bucket capacity for this model. It suits a large but only moderately humid lower level, a laundry room or an open main floor where a 50 would cycle off constantly. For a musty basement, though, the 50 costs little extra in size and weight and has more headroom. GE's site marks this model as no longer manufactured.",
    "pros": [
      "Shorter, lighter chassis than the 50s",
      "Smart Dry and three fan speeds",
      "Continuous drain option"
    ],
    "cons": [
      "Bucket capacity not published",
      "Less headroom for a truly damp basement",
      "Marked no longer manufactured on GE's site"
    ],
    "bottomLine": "A good fit for a moderately humid space where size matters; for a musty basement, buy the 50."
  },
  {
    "id": "ge-adhe25bwf",
    "name": "GE 25 Pint Dehumidifier with Smart Dry (ADHE25BWF)",
    "badge": "Smallest GE",
    "category": "25 Pints/Day, Single Room",
    "amazonUrl": "#",
    "description": "The ADHE25BWF is GE's smallest current model, rated at 25 pints a day and pitched on its Amazon listing for spaces up to 1,500 square feet. GE lists the same 19.4 by 13.2 by 9.9 inch chassis as the 35 pint model. Retailer listings describe Smart Dry, an empty-bucket alarm, a 24 hour on and off timer and auto restart after a power failure, and the Amazon listing mentions a continuous drain option and humidistat control. GE did not publish a bucket size or weight that we could find. Our hesitation is availability and value: GE's own page says it is no longer manufactured, and because it shares a body with the 35, you give up capacity without saving space. For a single bedroom or office, it does the job; for anything larger, the 35 is a better buy at a similar size.",
    "pros": [
      "Right capacity for one room",
      "Smart Dry, timer and auto restart",
      "Continuous drain option"
    ],
    "cons": [
      "Same size as the 35 pint model",
      "Bucket and weight not published",
      "Discontinued by GE; stock is thinning"
    ],
    "bottomLine": "Fine for a single room at a clearance price, but the 35 gives more capacity in the same box."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "GE Dehumidifier Review",
          item: "https://www.thehonestreviewers.com/ge-dehumidifier-review/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which GE dehumidifier is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the 50 pint ADHE50BWF. It has Smart Dry, three fan speeds, a 15 pint bucket and a garden-hose drain, and Total Home Supply lists it as ENERGY STAR certified. Choose the ADHE50PWF if you need a pump, and the ADHE50WWF if you want SmartHQ app control."
          }
        },
        {
          "@type": "Question",
          "name": "Does the GE 50 pint dehumidifier have a pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only the ADHE50PWF. GE's dealer store says its built-in pump can drain to a location up to 16 feet away, and the Amazon listing describes 15 feet of vertical lift with a 16 foot hose. The ADHE50BWF and ADHE50WWF drain by bucket or by a garden hose running downhill to a drain."
          }
        },
        {
          "@type": "Question",
          "name": "How big is the GE dehumidifier bucket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 50 pint ADHE models have a 15 pint bucket, a little under two gallons, according to Total Home Supply and GE's dealer store. We could not find a published bucket size for the 25 and 35 pint models. At full output a 50 pint unit fills 15 pints quickly, so plan on a hose."
          }
        },
        {
          "@type": "Question",
          "name": "Are GE dehumidifiers discontinued?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ADHE models are being phased out. GE Appliances' pages mark the ADHE25BWF, ADHE35BWF, ADHE50BWF and ADHE50PWF as no longer manufactured, at clearance prices. ENERGY STAR lists a newer ADSE series certified in November 2025. GE is still in the dehumidifier business; the lineup is changing generations."
          }
        },
        {
          "@type": "Question",
          "name": "What is GE Smart Dry?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Smart Dry is GE's automatic fan control. GE's listings describe it as adjusting fan speed based on room humidity, so the unit runs faster when the room is well above your target and slows as it gets close. That reduces noise and energy once a space is near its set point."
          }
        },
        {
          "@type": "Question",
          "name": "What warranty do GE dehumidifiers have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GE's dealer store lists the ADHE50PWF with a limited one-year exchange-only parts warranty and no labor, and Total Home Supply describes a one-year replacement for the basic and Wi-Fi 50 pint models. In short, GE replaces a unit that fails in the first year rather than repairing it."
          }
        },
        {
          "@type": "Question",
          "name": "Is a GE dehumidifier better than a Midea Cube?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in drying power; current 50 pint models from both brands carry similar ENERGY STAR ratings. GE offers a conventional shape, three fan speeds and Smart Dry. The Midea Cube offers a much larger bucket, up to 4.25 gallons, and nests for storage. If you drain by hose, either works well."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "ge dehumidifier",
      "ge dehumidifier 50 pint",
      "ge 50 pint dehumidifier",
      "ge 50-pint dehumidifier with built-in pump",
      "general electric 50 pint dehumidifier",
      "ge dehumidifier 50 pints"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Dehumidifiers
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          GE Dehumidifier Review: <span class="text-[#38BDF8]">Which Model to Buy</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          GE's current 25, 35 and 50 pint dehumidifiers, plus the pump and Wi-Fi versions, compared on certified capacity, bucket, drainage, controls and the warranty most buyers never read.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ge-adhe50bwf"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the GE Models
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-chose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Researched It</a>
          <a href="#lineup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How GE's Lineup Works</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 5 GE Models</a>
          <a href="#which-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. 25 vs 35 vs 50 Pint</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Bucket, Hose or Pump</a>
          <a href="#smart-dry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Smart Dry, Wi-Fi and Controls</a>
          <a href="#warranty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Warranty and Reliability</a>
          <a href="#who-should" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Who Should and Shouldn't Buy</a>
          <a href="#vs-others" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. GE vs Midea and Frigidaire</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Keeping a GE Running</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          GE dehumidifiers are solid, unglamorous machines, and the 50 pint ADHE50BWF is the one most people should buy. Two things are worth knowing before you order: the ADHE models on Amazon are the outgoing generation, which GE's own site now marks as no longer manufactured, and GE's warranty is a one-year exchange, not a repair.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-chose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Researched GE's Dehumidifiers
          </h2>

          <p>
            GE's dehumidifier range turns over quickly. Over the last few years the same basic 50 pint machine has been sold as the ADEL50LZ, APER50LZ, ADHR50LB, APHR50LB, ADYR50LC, AWYR50LC and others, with each prefix marking a generation or a feature such as a pump or Wi-Fi. Search results and older reviews still mention most of them. We started from the models GE and authorized retailers currently list, then kept only those we could match to a live Amazon listing by exact model number.
          </p>

          <p>
            That left the ADHE family: the ADHE25BWF, ADHE35BWF, ADHE50BWF, the Wi-Fi ADHE50WWF and the pump ADHE50PWF. Specifications for each come from GE's dealer store, GE Appliances product pages and authorized appliance retailers such as Total Home Supply and AJ Madison. Where a figure appears only on one retailer's page, we name it. Where nobody publishes a number, such as an official decibel rating for most of the range, we say so rather than estimate.
          </p>

          <p>
            We also checked the ENERGY STAR product database, which matters here for a reason we explain in the next section: GE's newest certified models are not the ones on Amazon. Owner complaints come from retailer review pages and are described as patterns, not failure rates. We did not test these units ourselves for this page.
          </p>

          <p>
            If you have not settled on GE, our <a href="/best-dehumidifier-for-home/">best dehumidifier for home</a> guide compares dehumidifiers across brands by capacity, drainage and controls. This page is for readers who already lean toward GE, often because they own GE appliances or saw one at a big-box store, and want to know which model to buy and what it will be like to live with.
          </p>
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. How GE's Lineup Works Right Now
          </h2>

          <p>
            The ADHE models are the ones you can buy on Amazon and through many GE dealers. The number in the middle is the capacity in pints a day under the 2019 DOE test: 25, 35 or 50. The letter after it marks the version. On the 50 pint machine, B is the basic model, W adds built-in Wi-Fi and P adds a built-in pump. GE's dealer listings describe the ADHE50BWF as replacing the older ADYR50LC and the ADHE50WWF as replacing the AWYR50LC.
          </p>

          <p>
            Here is the part most buyers miss. When we checked GE Appliances' product pages for the ADHE25BWF, ADHE35BWF, ADHE50BWF and ADHE50PWF, each was marked as no longer being manufactured and listed at clearance pricing, often out of stock online. That does not make them bad buys. It means they are the outgoing generation, and stock will thin over the next season.
          </p>

          <p>
            Their successor appears in the ENERGY STAR database as the ADSE series, which GE certified in November 2025: an ADSE25 rated at 24.71 pints a day, an ADSE35 at 35.34 and an ADSE50 at 49.64, with the 50 pint covering basic, pump, Wi-Fi and pump-plus-Wi-Fi variants. A Home Depot listing for an ADSE50XWT describes a 50 pint unit with a built-in pump and Wi-Fi. We could not find ADSE models on Amazon when we checked, so we have not ranked them, but if you see one at a similar price, it is the newer machine.
          </p>

          <p>
            What about GE Profile? GE uses the Profile name on premium appliances and on some air purifiers, but we could not find a current GE Profile-branded dehumidifier, so the smart choice in GE's portable range is the ADHE50WWF. Some listings also still show the GE ADYR22LC, an older 22 pint model we cover in our <a href="/best-dehumidifier-for-bedroom/">bedroom dehumidifier guide</a> for its low maker-rated noise; it is not part of the current ADHE family.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE SHORT VERSION</p>
            <p class="text-xl font-bold text-white mb-3">On Amazon, buy the ADHE50BWF unless you need a pump or an app.</p>
            <p class="text-gray-300 leading-relaxed m-0">The 50 pint basic model has the same 15 pint bucket, controls and Smart Dry as its siblings. Step to the ADHE50PWF only if you have no drain below the unit, and to the ADHE50WWF only if you will actually use SmartHQ.</p>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The 5 GE Dehumidifiers Worth Comparing
          </h2>

          <p>
            These are the five GE models we could match to a live Amazon listing by exact model number, ordered by how many buyers they suit. Specifications come from GE's own dealer store, GE Appliances product pages and authorized retailer listings, and we flag every place a figure is missing or sources disagree. We researched these from published specifications and owner reports; we did not run our own tests on these units for this page. The links below are affiliate links, which do not change the order or what we say about each model's weaknesses.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
