const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Power Banks for Travel in 2026: Airline-Safe Picks";
const description =
  "The 7 best power banks for travel in 2026, from 150g pocket packs to 99Wh laptop banks, with the TSA 100Wh rule, Qi2 and built-in cable picks explained.";

const PRODUCTS = [
  {
    "id": "anker-nano-power-bank-a1259",
    "name": "Anker Nano Power Bank (30W, Built-In USB-C Cable)",
    "category": "10,000mAh, 30W USB-C, Built-In Cable",
    "badge": "Best Overall for Travel",
    "amazonUrl": "#",
    "pros": [
      "Built-in USB-C cable doubles as the recharge cable, so there is nothing to forget",
      "About 215g and roughly the size of a deck of cards",
      "30W USB-C fast-charges any current iPhone, Pixel or Galaxy",
      "Around 37Wh, far below every airline limit",
      "Small display shows the exact remaining percentage"
    ],
    "cons": [
      "Roughly two phone charges, not enough for a long trip without wall access",
      "Combined output drops when charging two devices at once"
    ],
    "bottomLine": "The pocket bank most travelers should buy: no cable to lose, no airline questions, two full phone charges.",
    "description": "This is the bank we would put in a carry-on before anything else, and the reason is the cable. The Anker Nano has a short USB-C cable built into the body, and that same cable recharges the bank when you plug it into a wall charger. That sounds like a small thing until you are at a gate with a dead phone and realize the cable you meant to pack is still on your nightstand. With this one there is nothing to forget. Anker rates it at 10,000mAh, about 37Wh, and the USB-C side delivers up to 30W, which is enough to fast-charge every current iPhone, Pixel and Galaxy phone at or near the speed they accept from a wall brick. There is also a USB-A port for an older cable or a pair of earbuds, though output is shared when both ports are busy. At around 215g it disappears into a jacket pocket or a sling bag, and the small screen shows the remaining percentage instead of four vague dots. Realistically, after conversion losses, you get about two full charges of a modern flagship phone, a little more for a smaller phone. That covers a long travel day and an evening of maps and photos, but not a week of camping. The tradeoff of a built-in cable is that if it ever frays, the bank is done, and owners commonly mention babying the cable joint. For phone-first travelers who want one thing that always works, it is still the easiest recommendation in the category."
  },
  {
    "id": "anker-maggo-power-bank-10k",
    "name": "Anker MagGo Power Bank (10K)",
    "category": "10,000mAh, Qi2 15W Magnetic Wireless",
    "badge": "Best for iPhone",
    "amazonUrl": "#",
    "pros": [
      "Qi2 certified, so it snaps on and charges at up to 15W on iPhone 12 and later",
      "Fold-out kickstand turns it into a stand for video on a tray table",
      "Display shows percentage and estimated time to full",
      "USB-C port charges a second device or a non-magnetic phone",
      "Pass-through charging tops up bank and phone from one wall plug"
    ],
    "cons": [
      "Wireless charging wastes more energy, so expect fewer full charges than a cabled 10K bank",
      "Heavier and thicker than slim magnetic packs"
    ],
    "bottomLine": "The best cable-free iPhone power bank: magnetic, Qi2-fast and genuinely useful on a plane with the kickstand.",
    "description": "If you carry an iPhone, a magnetic bank changes how you use a power bank. Instead of a phone tethered to a brick by a cable, the MagGo snaps onto the back of the phone and charges while you keep using it, which is far more practical in a crowded airport or on a walking tour. Anker's MagGo 10K is Qi2 certified, so it aligns magnetically and charges at up to 15W on iPhone 12 and newer models, and on Android phones that support Qi2 or use a magnetic case. Capacity is 10,000mAh, around 37Wh, so it is comfortably carry-on legal. The fold-out kickstand is the feature owners mention most: prop the phone up on a seat-back tray or a hotel nightstand and watch a show while it charges. A small display shows the remaining percentage and estimated time to full, and a USB-C port lets you charge a second device by cable or recharge the bank itself, with pass-through so one wall outlet can top up both overnight. The honest caveat is wireless efficiency. Charging through the coil loses more energy as heat than a cable does, so where a cabled 10K bank gives about two flagship charges, a magnetic one typically gives closer to one and a half. Wireless charging also runs warmer, and phones may throttle charging speed in hot weather. At about 250g it is heavier than the Anker Nano, and the bulk on the back of a Pro Max is noticeable in a pocket. For iPhone users who value convenience over maximum capacity, it is the best magnetic option we found."
  },
  {
    "id": "anker-laptop-power-bank-25k-165w",
    "name": "Anker Laptop Power Bank (25K, 165W, Built-In Retractable Cables)",
    "category": "25,000mAh, 165W, Two Built-In USB-C Cables",
    "badge": "Best All-in-One Travel Bank",
    "amazonUrl": "#",
    "pros": [
      "Two built-in USB-C cables, one retractable, one that doubles as a carry strap",
      "Up to 100W per USB-C, enough for most laptops",
      "Around 90Wh, under the 100Wh carry-on limit with no airline approval needed",
      "Charges up to four devices at once",
      "Display shows capacity and live wattage"
    ],
    "cons": [
      "About 595g, heavy for a day bag",
      "Built-in cables are a single point of failure if damaged"
    ],
    "bottomLine": "One brick that charges a laptop, phone and earbuds with no cables to pack, and still clears airline rules.",
    "description": "This is the bank for travelers who carry a laptop and hate packing cables. Anker built two USB-C cables into the body: one retracts into the housing, and the other loops around as a carry strap that Anker rates to hold 44 pounds. Add the extra USB-C and USB-A ports and it charges up to four devices at once. Capacity is 25,000mAh, roughly 90Wh, which keeps it below the 100Wh line that U.S. and most international airlines use for carry-on power banks without airline approval. Each built-in cable can deliver up to 100W, so a 13- or 14-inch laptop charges at full speed, a phone and tablet charge alongside, and total output tops out at 165W with two devices connected and lower when you load all four. In practical terms, after conversion losses that 90Wh gives a MacBook Air one full charge with room left for a couple of phone charges, or roughly five full phone charges on its own. The display shows remaining capacity and wattage so you can tell what is actually drawing power. The weight is the price: about 595g, more than a pound and a quarter, which you will notice in a small backpack. It is overkill for someone who only carries a phone. And like any bank with built-in cables, a damaged cable cannot be swapped, so treat the retractable mechanism gently. For laptop-plus-phone travelers, it replaces a bank and three cables in one object, and that is worth the weight."
  },
  {
    "id": "ugreen-nexode-power-bank-25000-145w",
    "name": "UGREEN Nexode Power Bank 25,000mAh 145W",
    "category": "25,000mAh, 145W, 2x USB-C + USB-A",
    "badge": "Best Value High-Capacity",
    "amazonUrl": "#",
    "pros": [
      "About 90Wh for noticeably less money than the Anker equivalents",
      "Up to 140W on a single USB-C port for laptops and tablets",
      "Two USB-C and one USB-A port",
      "Display shows remaining charge",
      "Lighter than most 25,000mAh banks at about 513g"
    ],
    "cons": [
      "No built-in cables, so you pack your own",
      "Recharge input is slower than flagship banks, so a full refill takes hours"
    ],
    "bottomLine": "The capacity of a premium laptop bank at a lower price, as long as you remember your cables.",
    "description": "The UGREEN Nexode is the bank to buy when you want maximum carry-on capacity without paying flagship prices. UGREEN rates it at 25,000mAh, about 90Wh, so it sits under the 100Wh limit with room to spare. Output is strong: the main USB-C port is rated up to 140W, enough to charge most laptops at their normal speed, with a second USB-C and a USB-A port for a phone and earbuds, and a combined maximum of 145W. A small display shows the remaining charge. At around 513g it is lighter than most banks of this capacity, though it is still a dense brick roughly the size of a paperback. In travel terms, 90Wh is about five full charges of a modern flagship phone after losses, or one laptop charge plus a phone, which makes it a good pick for long-haul flights, multi-day trips with patchy outlets, or a family sharing one bank. The compromises are sensible ones. There are no built-in cables, so you need to pack a USB-C cable rated for the wattage you want, a 240W or 100W cable for a laptop. Recharge input is slower than flagship banks like the Anker Prime, so a full refill takes a few hours rather than about one, which matters if you only get a short layover at an outlet. Plan to recharge overnight in the hotel. For travelers who prioritize capacity per dollar and are organized about cables, it is the smartest buy on the list."
  },
  {
    "id": "anker-prime-power-bank-26k-300w",
    "name": "Anker Prime Power Bank (26K, 300W)",
    "category": "26,250mAh, 300W Total, 140W per USB-C",
    "badge": "Most Powerful Under 100Wh",
    "amazonUrl": "#",
    "pros": [
      "99.75Wh, the most capacity you can legally carry without airline approval",
      "Up to 140W on each USB-C port, 300W total",
      "Charges two laptops at full speed at once",
      "Fast recharge, especially with the optional charging base",
      "Detailed display shows per-port wattage"
    ],
    "cons": [
      "Expensive for what most travelers need",
      "About 600g, the heaviest pocketable bank here"
    ],
    "bottomLine": "The no-compromise travel bank for people carrying a big laptop, but overkill for phones.",
    "description": "The Anker Prime 26K is what you buy when you want every watt-hour the airline rules allow and enough output to treat it like a portable wall charger. Anker rates it at 26,250mAh, which is 99.75Wh, just under the 100Wh line. That is the practical ceiling for a bank you can carry on almost any airline without asking permission. Output is the headline: each of the two USB-C ports can deliver up to 140W, and total output reaches 300W across three devices. That means a 16-inch MacBook Pro charges at its full 140W rate while a second laptop or tablet charges alongside, something few banks can do. The display shows remaining capacity and live wattage for each port, which is genuinely useful for knowing whether a laptop is actually charging or just slowing its drain. Recharging is fast, and the optional charging base raises input further so the bank refills in roughly the time it takes to have dinner. Independent testing has found usable output in the 80 to 90Wh range, which is about what you should expect from any bank this size after conversion losses. The downsides are price and weight. At around 600g it is heavier than a can of soda, and it costs much more than the UGREEN for similar capacity. If you only carry a phone and earbuds, it is wasted money. If you travel with a power-hungry laptop and need to work through a long-haul flight or a day without outlets, it is the best pocketable bank available."
  },
  {
    "id": "nitecore-nb10000-gen2",
    "name": "Nitecore NB10000 Gen 2",
    "category": "10,000mAh, 20W USB-C, 150g Carbon Fiber",
    "badge": "Lightest Pick",
    "amazonUrl": "#",
    "pros": [
      "About 150g, among the lightest 10,000mAh banks sold",
      "Only about 11mm thick, slips into any pocket",
      "IPX5 water resistance for hiking and rain",
      "20W USB-C is enough for most phones",
      "Carbon fiber shell is tough for its weight"
    ],
    "cons": [
      "Total output drops to 15W when two ports are in use",
      "Too slow for laptops and tablets"
    ],
    "bottomLine": "The bank for backpackers and minimalists who count every gram and only need to charge a phone.",
    "description": "Hikers and ultralight travelers have carried the Nitecore NB10000 for years, and the Gen 2 is the version to buy now. The draw is weight. Nitecore rates it at about 150g for a 10,000mAh, roughly 38Wh pack, which makes it noticeably lighter than most banks of the same capacity, and at about 11mm thick it slides into a hip-belt pocket or the back of a thin sling bag. The shell uses carbon fiber, so it stays rigid despite the weight savings, and an IPX5 rating means rain and splashes are not a concern on a trail or a ferry deck. The Gen 2 raised USB-C output to 20W, which charges an iPhone or Pixel quickly, and there is a USB-A port for a headlamp or GPS. The limits are real. When both ports are in use, total output drops to 15W, so two phones charge slowly. Twenty watts is not enough for a laptop or to fast-charge a tablet, and there is no display, only indicator lights. There is also no built-in cable, so you still need to pack one. In practice, it gives about two charges of a typical flagship phone, the same as other 10K banks, and it is easily under every airline limit. If you are trekking, bikepacking, or simply want the lightest possible insurance against a dead phone on a long sightseeing day, nothing at this capacity is lighter for the money. For anyone carrying a laptop, look higher on this list."
  },
  {
    "id": "jackery-explorer-100-plus",
    "name": "Jackery Explorer 100 Plus",
    "category": "99Wh LiFePO4, 128W, Airline-Friendly Mini Station",
    "badge": "Best for Road Trips",
    "amazonUrl": "#",
    "pros": [
      "LiFePO4 chemistry rated for about 2,000 cycles to 80% capacity",
      "99.2Wh, under the 100Wh carry-on limit",
      "Two 100W USB-C PD ports for laptops",
      "Car outlet port for a 12V cooler or tire inflator",
      "Can recharge from a small solar panel"
    ],
    "cons": [
      "About 2 pounds, far heavier than a power bank of similar capacity",
      "No AC outlet despite the power station styling"
    ],
    "bottomLine": "A rugged, long-lived battery for car trips and camping that still flies, if you can live with the weight.",
    "description": "The Explorer 100 Plus sits between a power bank and a power station, and it makes sense for a specific traveler: someone who road-trips, camps or works from a car and wants a battery that will last for years. Jackery rates it at 99.2Wh with LiFePO4 cells, the same long-life chemistry used in larger power stations, and claims about 2,000 cycles before capacity falls to 80 percent. Most lithium-ion power banks are rated for a few hundred to around 1,000 cycles, so if you charge and drain it often this one will outlast several ordinary banks. Because it is under 100Wh, it is still within the standard carry-on allowance, and Jackery markets it as airline friendly. It has two USB-C PD ports at up to 100W each, enough for most laptops, a USB-A port, and a car outlet socket that can run a small 12V cooler, a tire inflator or a CPAP with the right DC cable. Total output is rated around 128W. It can also take solar input, so a small folding panel keeps it topped up at a campsite. The catch is weight. LiFePO4 is heavier per watt-hour than standard lithium cells, and at roughly 2 pounds it weighs about twice as much as a 90Wh pocket bank. It does not fit in a pocket and is overkill for a city break. Despite looking like a mini power station, it has no AC outlet. For campers and van travelers it is a great fit; for flights-only travelers, the UGREEN or Anker banks are lighter for the same energy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Power Banks for Travel",
          item: "https://www.thehonestreviewers.com/best-power-bank-for-travel/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can I bring a power bank on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in your carry-on only. Power banks up to 100Wh, which covers nearly every bank up to about 27,000mAh, are allowed without airline approval. Banks from 101 to 160Wh need airline approval and you can carry two at most. Anything over 160Wh is prohibited, and no power bank may go in checked luggage on any airline."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best power bank size for travel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most travelers, 10,000mAh is the right size. It weighs about 150 to 250g, gives roughly two full charges of a modern flagship phone, and is far below every airline limit. Step up to 20,000 to 25,000mAh if you also need to charge a tablet or laptop, or if two people share one bank on long trips."
          }
        },
        {
          "@type": "Question",
          "name": "How many mAh is 100Wh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the typical 3.6 to 3.7V cell voltage, 100Wh is about 27,000mAh. Multiply mAh by voltage and divide by 1,000 to get watt-hours. A 20,000mAh bank is about 74Wh and a 26,250mAh bank is about 99.75Wh. The Wh figure should be printed on the case, and security staff check that label, not the mAh."
          }
        },
        {
          "@type": "Question",
          "name": "Is a MagSafe or Qi2 power bank worth it for iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If convenience matters more than capacity, yes. A Qi2 bank snaps on and charges an iPhone 12 or later at up to 15W without a cable, which is great while walking or navigating. The cost is efficiency: a 10,000mAh magnetic bank usually delivers about one and a half charges rather than two. Avoid uncertified magnetic banks; look for the Qi2 logo."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use my power bank during the flight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the airline. FAA rules allow it, but some carriers have restricted in-flight use since 2025. Southwest requires banks to stay visible while in use, and Emirates and several Asian airlines ban using or charging power banks onboard entirely. Check your airline's current policy before you fly, and keep the bank where you can see it."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a voltage converter for my power bank abroad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The bank runs on its own battery, and nearly every modern USB-C wall charger is rated 100 to 240V, so it works worldwide with only a plug adapter. Check the input rating printed on your wall charger to confirm. Never plug a universal USB charger into a voltage converter; it is unnecessary and can damage the charger."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a power bank hold its charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quality lithium-ion bank loses only a few percent per month in storage, so a full bank is still useful after several months in a drawer. For best battery life, store it around 40 to 60 percent between trips and top it up every few months. Most banks last a few hundred to about 1,000 charge cycles before capacity noticeably drops."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best power bank for travel",
      "best portable charger for travel",
      "best travel power bank",
      "best power banks 2025",
      "iphone power bank best",
      "cell phone power bank",
      "tsa power bank rules"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Power Banks for Travel</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right travel power bank is small enough to always carry, fast enough to matter on a layover, and legal on every flight. These are the ones worth packing, and the airline rules you need to know first.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-nano-power-bank-a1259"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Read the Airline Rules
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 7 Top Picks Reviewed</a>
          <a href="#airline-rules" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. TSA and Airline Rules</a>
          <a href="#capacity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. How Much Capacity You Need</a>
          <a href="#usb-c-pd" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. USB-C PD and Charging Speed</a>
          <a href="#magsafe-qi2" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. MagSafe, Qi2 and Wireless</a>
