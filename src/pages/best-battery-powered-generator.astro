---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Portable Power Station vs Generator",
    "url": "/portable-power-station-vs-generator/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best Small Generators for Home",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Are Portable Power Stations Safe Indoors?",
    "url": "/are-portable-power-stations-safe-indoors/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "Best Home Battery Backup Systems",
    "url": "/best-home-battery-backup-system/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator?",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Battery Powered Generators in 2026: Gas-Free Picks";
const description =
  "Seven battery powered generators that replace a gas generator, from a 600W camp unit to 240V home backup, sized by running watts, surge and runtime.";

const PRODUCTS = [
  {
    "id": "anker-solix-f3800-plus",
    "name": "Anker SOLIX F3800 Plus",
    "category": "3,840Wh LiFePO4, 6,000W, 120/240V",
    "badge": "Best Whole-Home Replacement",
    "amazonUrl": "#",
    "pros": [
      "6,000W continuous output at 120V and 240V covers loads that only a mid-size gas portable used to handle",
      "3,840Wh of LiFePO4 capacity runs a fridge, internet and lights for well over a day",
      "Expands with BP3800 batteries to about 26.9kWh on one unit",
      "Up to 3,200W of solar input through dual high-voltage inputs",
      "Wheels and a telescoping handle make the weight manageable on flat ground"
    ],
    "cons": [
      "Roughly 137 pounds, so it lives in one place rather than going camping",
      "Costs several times more than a gas generator with the same running watts"
    ],
    "bottomLine": "The closest thing to a gas portable generator in battery form: 240V, 6,000W and enough capacity to matter. Buy it if you want to retire a 5,000-7,000W gas unit for short outages and can afford the price.",
    "description": "Most battery generators hit a wall the moment you plug in a well pump, a 240V dryer circuit or a central furnace blower plus a fridge plus a microwave. The F3800 Plus is one of the few that does not. It is rated for 6,000W continuous and outputs split-phase 120/240V, which means it can feed a properly installed transfer switch or inlet the same way a 7,000W gas portable would, and it can start a 240V well pump that every 120V unit on this list simply cannot. The 3,840Wh LiFePO4 battery is the other half of the story. At about 85% usable, that is roughly 3,260Wh of real energy: a 150W-average refrigerator, a 20W router and 60W of LED lighting together draw about 230W, so the base unit carries that load for around 14 hours, and with one BP3800 expansion battery you are past a full day. Anker quotes expansion to about 26.9kWh on a single unit and around 53.8kWh by pairing two units, which is genuine whole-home battery territory. Solar input is rated up to 3,200W through two high-voltage inputs, enough that a large array can refill a meaningful chunk of the battery on a sunny afternoon. The weight is the honest drawback: around 137 pounds puts it firmly in the roll-it-around-the-garage category, and the price is far beyond a gas generator with the same running watts. You are paying for silence, zero carbon monoxide and no fuel to store. For anyone who keeps a large gas portable for two or three outages a year and hates dragging it out, it is the best battery replacement we would point to."
  },
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow DELTA Pro 3",
    "category": "4,096Wh LiFePO4, 4,000W, 120/240V",
    "badge": "Best 240V Alternative",
    "amazonUrl": "#",
    "pros": [
      "4,096Wh capacity is the largest base battery on this list",
      "4,000W continuous with 120/240V output, including a 30A twist-lock outlet",
      "Up to 2,600W of solar input split across high- and low-voltage ports",
      "Charges at up to 1,800W from a 120V outlet and up to 3,600W from a 240V outlet",
      "Expandable with extra batteries, and two units can be linked for larger systems"
    ],
    "cons": [
      "4,000W continuous is lower than the Anker F3800 Plus for big simultaneous loads",
      "Around 113 pounds, so it is also a roll-in-place unit"
    ],
    "bottomLine": "A slightly more compact 240V battery generator with the biggest base battery here. Pick it over the Anker if capacity and fast 240V charging matter more to you than raw output.",
    "description": "The DELTA Pro 3 is EcoFlow's answer to the same buyer as the Anker F3800 Plus: someone who wants a battery generator that can feed a transfer switch at 120/240V and run real household loads, not just phones and a fan. Its 4,096Wh LiFePO4 battery is the largest base capacity on this list, and its 4,000W continuous rating, with EcoFlow's X-Boost mode stretching resistive loads further, covers a fridge, freezer, furnace blower, sump pump and a microwave in sequence without drama. The outlet panel includes a 30A twist-lock that works with common generator transfer switches, and the 240V capability means a 240V well pump is on the table where 120V-only units cannot help at all. Charging is where it pulls ahead of most rivals. It accepts up to 1,800W from an ordinary 120V outlet and up to 3,600W from a 240V source such as a dryer or EV-style circuit, so a near-empty battery can be refilled in a couple of hours when grid power returns or a gas generator runs briefly. Solar input is rated up to 2,600W across a high-voltage and a low-voltage port, which gives flexibility in how you wire panels. Run the arithmetic: at 85% usable, about 3,480Wh is real energy, enough for a 230W essentials load for roughly 15 hours. The trade-off against the Anker is output. If you need to run a 240V pump and a microwave and an air handler at once, 6,000W gives more margin than 4,000W. At around 113 pounds it is lighter than the Anker but still not something you carry."
  },
  {
    "id": "bluetti-ac200l",
    "name": "BLUETTI AC200L",
    "category": "2,048Wh LiFePO4, 2,400W, 120V",
    "badge": "Best 2kWh Generator Replacement",
    "amazonUrl": "#",
    "pros": [
      "2,048Wh of LiFePO4 capacity is a real overnight battery for a fridge and essentials",
      "2,400W continuous output matches the running watts of a typical 3,000W inverter generator",
      "Expands to 8,192Wh with BLUETTI expansion batteries",
      "Fast AC charging and up to 1,200W of solar input",
      "Power Lifting mode runs resistive loads like kettles and heaters up to 3,600W"
    ],
    "cons": [
      "120V only, so no 240V well pumps or 240V transfer switch circuits",
      "Around 62 pounds, heavier than it looks in photos"
    ],
    "bottomLine": "The sweet spot for most households replacing a 2,000-3,000W inverter generator. Enough capacity for a night, enough output for a fridge and a microwave, at a far lower price than the 240V units.",
    "description": "If you were going to buy a 2,200-3,000W inverter generator for outages, the AC200L is the battery unit that most closely matches what you would have used it for. Its 2,400W continuous inverter covers the running load of a refrigerator, a chest freezer, a CPAP, lights, a router and a microwave used one at a time, which is the realistic outage list for most homes. The 2,048Wh LiFePO4 battery gives roughly 1,740Wh of usable energy at 85% efficiency: a 230W essentials load runs about 7.5 hours, and a lighter overnight load of fridge plus CPAP plus router, around 180W average, runs closer to 9-10 hours. BLUETTI's Power Lifting mode lets purely resistive loads such as a kettle or space heater run up to 3,600W by dropping voltage, which is useful but not a surge rating for motors, so do not plan a well pump around it. The bigger advantage is expandability: add BLUETTI expansion batteries and capacity climbs to 8,192Wh, which turns a one-night unit into a multi-day one without replacing the inverter. Solar input up to 1,200W means a few 400W panels can put back most of a day's usage in good sun, and fast AC charging refills it quickly when power returns. The limits are clear. It is 120V only, so it will not run a 240V well pump or feed both legs of a transfer switch, and at about 62 pounds it is a two-handed lift. For a household that wants generator-level usefulness without the noise or fuel, this is the pick we would steer most people toward first."
  },
  {
    "id": "ecoflow-delta-2",
    "name": "EcoFlow DELTA 2",
    "category": "1,024Wh LiFePO4, 1,800W, 120V",
    "badge": "Best Value 1kWh",
    "amazonUrl": "#",
    "pros": [
      "1,800W continuous output starts most refrigerators and runs a small microwave",
      "1,024Wh LiFePO4 battery rated for thousands of cycles",
      "Expandable with an extra battery to 2kWh or 3kWh depending on the add-on",
      "Up to 500W of solar input",
      "About 27 pounds, so one person can carry it to the kitchen or the car"
    ],
    "cons": [
      "1kWh runs a fridge for hours, not days, without recharging",
      "Older platform than some newer EcoFlow models, with slower solar input than the bigger units"
    ],
    "bottomLine": "A proven, widely discounted 1kWh battery generator. It replaces a small 2,000W gas inverter for short outages and camping, and the expansion port keeps it useful as needs grow.",
    "description": "The DELTA 2 has been around long enough that it is frequently discounted, and that makes it the value pick for someone who wants a real battery generator without paying for 2kWh or more. It carries a 1,024Wh LiFePO4 battery and an 1,800W continuous inverter, with EcoFlow's X-Boost mode letting resistive loads like a coffee maker or hair dryer run higher by lowering voltage. For practical purposes that output covers a full-size refrigerator, a 700-900W microwave, a CPAP, lights and charging, which is about what a 2,000W-class gas inverter would be asked to do in a short outage. Capacity is the thing to understand. At roughly 85% usable, about 870Wh is real energy: a refrigerator averaging 120W runs around 7 hours on its own, and a fridge plus router plus a few lights at 180W runs about 5 hours. That is a good length for the typical outage of a few hours, but not for a two-day storm without a way to recharge. The expansion port fixes part of that problem, since EcoFlow sells extra batteries that take total capacity to about 2kWh or 3kWh depending on which one you add. Solar input is rated up to 500W, enough to put back a good portion of the battery on a clear day with two or three panels. At about 27 pounds it is easy to carry from the garage to the kitchen. It is not the newest platform and the bigger units recharge from solar faster, but for the price it is still one of the easiest gas generator replacements to recommend."
  },
  {
    "id": "anker-solix-c1000",
    "name": "Anker SOLIX C1000",
    "category": "1,056Wh LiFePO4, 1,800W, 120V",
    "badge": "Fastest-Recharging 1kWh",
    "amazonUrl": "#",
    "pros": [
      "Recharges from a wall outlet in about 58 minutes in UltraFast mode",
      "1,800W continuous, with SurgePad mode for resistive loads up to 2,400W",
      "1,056Wh LiFePO4 battery",
      "Up to 600W of solar input",
      "Optional expansion battery doubles capacity to about 2.1kWh"
    ],
    "cons": [
      "Around 27 pounds with a fixed handle design that is bulky in a car trunk",
      "SurgePad helps heaters and kettles, not motor starts"
    ],
    "bottomLine": "The 1kWh battery generator to buy if you will recharge it often, whether from the grid between rolling outages or from a gas generator run briefly. Under an hour to full is a real advantage.",
    "description": "Recharge time is the most underrated spec on a battery generator, and the SOLIX C1000 is the 1kWh unit that takes it most seriously. In UltraFast mode it refills from a standard wall outlet in about 58 minutes, which changes how you use it. During rolling blackouts or an outage that flickers on and off, an hour of grid power is enough to bring it back to full. Paired with a small gas generator in a hybrid setup, it means you run the gas engine for an hour instead of all night. The 1,056Wh LiFePO4 battery and 1,800W continuous inverter put it in the same class as the EcoFlow DELTA 2: enough to run a refrigerator, a CPAP, lights, a router and a small microwave, but not all at full tilt at once. Anker's SurgePad mode lets resistive loads such as a kettle or a hair dryer run up to 2,400W, which is handy but does not help a compressor or pump start. Usable energy is about 900Wh at 85% efficiency, so a 120W-average fridge runs about 7.5 hours and a 60W CPAP with humidifier off runs around 15 hours. Solar input up to 600W is generous for this size, enough to refill the battery in a few hours of strong sun with the right panels. An optional expansion battery doubles capacity to roughly 2.1kWh when you want more runtime. At around 27 pounds it is portable, though the shape is boxy. For anyone who values getting back to full quickly, this is the 1kWh pick."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2",
    "category": "1,070Wh LiFePO4, 1,500W, 120V",
    "badge": "Lightest 1kWh",
    "amazonUrl": "#",
    "pros": [
      "About 23.8 pounds, the lightest 1kWh-class unit on this list",
      "1,070Wh LiFePO4 battery",
      "1,500W continuous with a 3,000W surge rating for motor starts",
      "Roughly one-hour emergency charging from AC when enabled in the app",
      "Simple, well-labeled interface that suits people who will not read a manual"
    ],
    "cons": [
      "1,500W continuous is the lowest output among the 1kWh picks",
      "Not expandable, so capacity is fixed at 1,070Wh"
    ],
    "bottomLine": "The easiest 1kWh battery generator to carry and use. Choose it for portability and simplicity, and choose the EcoFlow or Anker if you need more continuous output or expansion.",
    "description": "Jackery built its name on simple, portable power stations, and the Explorer 1000 v2 keeps that focus while moving to LiFePO4 cells. At about 23.8 pounds it is the lightest 1kWh-class unit on this list, which matters more than spec sheets suggest: a battery generator you can carry with one hand gets used for camping, tailgating and job sites as well as outages, while a heavier one sits in the garage. The 1,070Wh battery gives about 910Wh usable at 85% efficiency. That runs a 120W-average refrigerator for roughly 7.5 hours, a 40W CPAP without heated humidification for over 20 hours, or a 10W router and a few LED lamps for well over a day. The 1,500W continuous inverter is the lowest of the 1kWh picks, and it has a 3,000W surge rating that helps refrigerators and small pumps start. In practice, 1,500W runs a fridge and a modest microwave, but you will need to avoid stacking big loads together. Jackery's app enables an emergency charge mode that refills the battery in about an hour from a wall outlet, useful during intermittent outages. The interface is plain and clearly labeled, which suits family members who will never read the manual. The trade-offs are capacity and growth: the Explorer 1000 v2 is not expandable, so if you later want two days of fridge runtime you will be buying a second unit or moving up a size. As a light, straightforward replacement for a small gas inverter for short outages, it is a good choice."
  },
  {
    "id": "bluetti-eb3a",
    "name": "BLUETTI EB3A",
    "category": "268Wh LiFePO4, 600W, 120V",
    "badge": "Best Small Battery Generator",
    "amazonUrl": "#",
    "pros": [
      "About 10 pounds, easy to keep in a closet or a car",
      "600W continuous runs a CPAP, fan, lights, router and laptop",
      "Power Lifting mode handles resistive loads up to 1,200W",
      "LiFePO4 cells rated for thousands of cycles",
      "Fast AC charging plus solar input for a small panel"
    ],
    "cons": [
      "268Wh will not run a refrigerator for long",
      "Not expandable and too small to be anyone's main outage plan for a whole house"
    ],
    "bottomLine": "The right small electric generator for CPAP users, apartment dwellers and anyone who only needs lights, internet and phones during an outage. Not a fridge generator.",
    "description": "Plenty of people shopping for a small generator do not need to run a refrigerator at all. They need a CPAP through the night, a router so the house still has Wi-Fi, a lamp, a fan and phones that stay charged. For that job a 1,000W gas suitcase generator is overkill, loud and impossible to run in an apartment, and the BLUETTI EB3A is a better answer. It weighs about 10 pounds, carries a 268Wh LiFePO4 battery and outputs 600W continuous, with a Power Lifting mode that runs resistive loads up to 1,200W by dropping voltage. Do the arithmetic before you buy: at 85% usable, about 228Wh is real energy. A CPAP drawing 40W without a heated humidifier runs about 5.5 hours, which covers most of a night; a 10W router plus a 10W LED lamp runs over 11 hours; a phone charge uses about 15Wh. With the humidifier on, CPAP draw often doubles or triples, and runtime drops accordingly, so turn it off on battery. What it will not do is carry a refrigerator through an outage. A fridge averaging 120W drains it in under two hours, and that is the clearest line between a small battery generator and a 1kWh unit. Charging is quick from AC, and a small portable panel can top it up during the day. For apartment renters, CPAP users and anyone who wants a quiet power source for the essentials that matter overnight, it is the small pick we recommend, and it costs a fraction of the bigger units."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Battery Powered Generators",
          item: "https://www.thehonestreviewers.com/best-battery-powered-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is a battery powered generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a portable power station marketed as a generator: a large lithium battery, an inverter that outputs household AC power, and charging inputs for wall, car and solar. Unlike a gas generator it makes no fumes or engine noise, so it can be used indoors, but it stores a fixed amount of energy rather than producing power from fuel."
          }
        },
        {
          "@type": "Question",
          "name": "Can a battery generator replace a gas generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For short outages and essentials, yes. A 1-2kWh unit replaces a small 2,000-3,000W inverter generator for an evening or a night. To replace a 5,000-7,000W gas portable for a full day you need a 4kWh, 240V unit. For week-long outages with heavy loads, gas or a hybrid setup still makes more sense."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a battery generator run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide usable capacity by the fridge's average draw. At about 85% usable, a 1,024Wh unit has roughly 870Wh, so a fridge averaging 120W runs about 7 hours. A 2,048Wh unit runs it about 14 hours, and a 3,840Wh unit about 27 hours. Older or larger fridges draw more and shorten those times."
          }
        },
        {
          "@type": "Question",
          "name": "Are battery generators safe to use indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. They produce no carbon monoxide, so they can run in a living room or bedroom, which a gas generator never can. Keep vents clear, avoid charging in extreme heat, use LiFePO4 models where possible and follow the manufacturer's spacing guidance. A gas generator used to recharge one must still stay outdoors."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better, Predator or EcoFlow power stations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Harbor Freight's Predator line is priced aggressively and uses LiFePO4 cells, with a 2,000W model rated around 1,545Wh. EcoFlow offers a longer track record, a polished app, expansion batteries, 240V models and broad solar accessories. If you want expansion or 240V later, EcoFlow is safer; for a one-time coupon deal, Predator can be reasonable."
          }
        },
        {
          "@type": "Question",
          "name": "Does Home Depot or Lowe's sell battery generators?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Both shelve battery power stations next to gas generators, typically from EcoFlow, Jackery, Anker and Westinghouse, though stock varies by store. Big-box stores are useful for buying the day before a storm, while online retailers and manufacturer sites usually carry more sizes, 240V models, expansion batteries and solar bundles."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a battery powered generator cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small 250-300Wh units run roughly a couple hundred dollars, 1kWh units commonly sell in the several-hundred range on sale, 2kWh units cost more, and 4kWh 240V units run into the low thousands before expansion batteries. Per watt, that is several times a gas generator, offset by no fuel, no oil and far lower running costs."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "battery powered generator",
      "battery generator",
      "battery based generator",
      "battery run generators",
      "battery powered electric generator",
      "small electric generator",
      "power generator portable",
      "predator power station",
      "harbor freight power station",
      "lowe's generators",
      "electric generator home depot"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Battery Powered Generators</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Quiet, fume-free alternatives to a gas generator, sized from a 600W camp unit to a 240V home backup, with an honest look at where gas still wins.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-solix-f3800-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Battery vs Gas
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="14.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
