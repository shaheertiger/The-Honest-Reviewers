---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Exterior Caulk", url: "/best-exterior-caulk/" },
    { title: "How to Caulk Exterior Windows", url: "/how-to-caulk-exterior-windows/" },
    { title: "Where Not to Caulk", url: "/where-not-to-caulk/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "Why Does Exterior Caulk Keep Cracking or Pulling Away?";
const description =
  "Joints that fail every year usually fail for one of five reasons — the wrong product, three-sided adhesion, a bead too deep, poor prep, or a joint that should not be caulked.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Why Exterior Caulk Cracks", item: "https://www.thehonestreviewers.com/why-does-exterior-caulk-keep-cracking/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why does my exterior caulk keep cracking?",
          acceptedAnswer: { "@type": "Answer", text: "Usually because the joint moves more than the caulk can stretch. Common causes are a low-movement product such as acrylic latex on a joint that moves seasonally, three-sided adhesion where the caulk is bonded to the back of the joint as well as both sides, a bead applied too deep, poor surface preparation, and joints that should never have been caulked at all." },
        },
        {
          "@type": "Question",
          name: "What is three-sided adhesion and why does it cause failure?",
          acceptedAnswer: { "@type": "Answer", text: "It is when caulk bonds to the back of a joint as well as to both faces. A bead bonded on two sides can stretch and compress as the joint moves; one bonded on three sides cannot deform freely, so movement tears it. This is why backer rod matters — it fills the depth and gives the caulk a surface it deliberately does not stick to." },
        },
        {
          "@type": "Question",
          name: "How deep should a caulk joint be?",
          acceptedAnswer: { "@type": "Answer", text: "About half its width, with a minimum of around an eighth of an inch and a maximum of half an inch. A half-inch joint wants a quarter-inch depth of caulk. Deeper beads are not stronger — they cure more slowly, they hold more stress, and they crack sooner. Backer rod is what sets that depth correctly in a wide joint." },
        },
        {
          "@type": "Question",
          name: "What is the most flexible exterior caulk?",
          acceptedAnswer: { "@type": "Answer", text: "Silicone and polyurethane sealants offer the highest movement capability, typically rated for 25 to 50 percent joint movement, against roughly 7.5 to 12.5 percent for acrylic latex. Elastomeric and siliconised acrylics sit in between. For any joint that moves seasonally, the movement rating on the tube matters far more than the brand." },
        },
        {
          "@type": "Question",
          name: "Can you caulk over old cracked caulk?",
          acceptedAnswer: { "@type": "Answer", text: "It rarely lasts. The new bead bonds to a failing material rather than to the substrate, so it inherits the old joint's failure and cracks along the same line, often within a season. Remove the old caulk completely, clean the joint back to sound material, and start again — the removal is most of the work but it is what makes the repair last." },
        },
        {
          "@type": "Question",
          name: "What temperature should you apply exterior caulk?",
          acceptedAnswer: { "@type": "Answer", text: "Most products want 40 to 80°F, and the surface temperature matters more than the air temperature. Just as important is where the joint is in its seasonal cycle: caulking a gap in midsummer means the joint is at its narrowest, so it will open in winter and stretch the bead to its limit. Spring and autumn put the joint mid-range." },
        },
        {
          "@type": "Question",
          name: "Why does caulk pull away from the siding but not the window?",
          acceptedAnswer: { "@type": "Answer", text: "Because adhesion has failed on one substrate rather than both, and the two materials are usually different. Vinyl, PVC trim and powder-coated aluminium are all difficult surfaces for many caulks, and they also expand and contract far more than wood or masonry. Check that your product is rated for that specific material, and clean it with a solvent wipe rather than just brushing it." },
        },
        {
          "@type": "Question",
          name: "Are there places you should not caulk on the exterior?",
          acceptedAnswer: { "@type": "Answer", text: "Yes, and caulking them causes more damage than leaving them open. Weep holes in windows, the bottom edge of horizontal siding laps, the underside of window sills and the gap beneath a drip cap all exist to let water escape. Sealing them traps moisture inside the wall, where it rots framing rather than draining harmlessly away." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Caulk & Sealants",
    tags: ["exterior caulk cracking", "caulk failure", "backer rod", "caulk troubleshooting"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Exterior Caulks", link: "/best-exterior-caulk/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Troubleshooting</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">Why Exterior Caulk Keeps <span class="text-[#38BDF8]">Cracking</span></h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          If you are recaulking the same joints every year, the caulk is not the problem — the joint is asking for something the product cannot give it.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#five-causes" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">The Five Causes</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="6.4k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#five-causes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Five Causes</a>
          <a href="#movement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Movement Capability</a>
          <a href="#three-sided" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Three-Sided Adhesion</a>
          <a href="#geometry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Joint Geometry</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Surfaces and Prep</a>
          <a href="#not-caulk" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Joints That Should Not Be Caulked</a>
          <a href="#doing-it-right" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Doing It Once</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A caulked joint is a small engineering problem. Two materials move independently, at different rates, through a forty-degree seasonal temperature swing, and something flexible has to bridge the gap without tearing. Most failures are a design mismatch rather than a bad tube.
        </p>

        <div id="five-causes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. The Five Causes</h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Symptom</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cause</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fix</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Split down the middle of the bead</td>
                    <td class="px-4 py-4 text-gray-700">Not enough movement capability</td>
                    <td class="px-4 py-4 text-gray-700">Silicone or polyurethane</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Torn in a ragged line, bead deformed</td>
                    <td class="px-4 py-4 text-gray-700">Three-sided adhesion</td>
                    <td class="px-4 py-4 text-gray-700">Backer rod or bond-breaker tape</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cracked, and the bead is very thick</td>
                    <td class="px-4 py-4 text-gray-700">Applied too deep</td>
                    <td class="px-4 py-4 text-gray-700">Rod to set depth at half the width</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pulled cleanly away from one side</td>
                    <td class="px-4 py-4 text-gray-700">Adhesion failure on that substrate</td>
                    <td class="px-4 py-4 text-gray-700">Clean properly; check compatibility</td>
                  </tr>
                  <tr class="bg-white">
                    <td class="px-4 py-4 font-black text-gray-900">Fails yearly, water damage nearby</td>
                    <td class="px-4 py-4 text-gray-700">Joint should not be caulked</td>
                    <td class="px-4 py-4 text-gray-700">Leave it open to drain</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The distinction in the first two rows is worth learning to read, because it points to two different fixes. A bead that has split down its middle with clean edges was stretched beyond what the material could take. A bead that is torn raggedly, or that has deformed into a strange shape, was prevented from stretching freely — which is the three-sided adhesion problem.
          </p>
        </div>

        <div id="movement" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Movement Capability Is the Number That Matters</h2>

          <p>
            Every sealant is rated for how much joint movement it can accommodate, expressed as a percentage of joint width. That number, not the price or the brand, is what determines whether a joint survives a winter.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Movement</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Use For</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Acrylic latex</td>
                    <td class="px-4 py-4 text-gray-700">7.5-12.5%</td>
                    <td class="px-4 py-4 text-gray-700">Static trim joints that get painted</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Siliconised acrylic</td>
                    <td class="px-4 py-4 text-gray-700">12.5-25%</td>
                    <td class="px-4 py-4 text-gray-700">Moderate movement, paintable</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Polyurethane</td>
                    <td class="px-4 py-4 text-gray-700">25-50%</td>
                    <td class="px-4 py-4 text-gray-700">High movement, paintable, durable</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Silicone</td>
                    <td class="px-4 py-4 text-gray-700">25-50%</td>
                    <td class="px-4 py-4 text-gray-700">High movement — but not paintable</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Put that against reality. A quarter-inch gap between wood trim and vinyl siding can easily open and close by a sixteenth of an inch across a year, which is twenty-five percent of the joint. Acrylic latex rated at twelve percent will split, every year, no matter how carefully you tool it.
          </p>

          <p>
            Polyurethane is the usual answer for demanding exterior joints because it combines high movement capability with paintability and good adhesion to most substrates. Silicone matches it for movement but cannot be painted, which rules it out where the bead sits in a painted trim line. The differences are set out in <a href="/silicone-vs-latex-caulk/">silicone versus latex caulk</a> and <a href="/polyurethane-vs-silicone-caulk/">polyurethane versus silicone</a>.
          </p>
        </div>

        <div id="three-sided" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Three-Sided Adhesion</h2>

          <p>
            This is the failure that professionals watch for and homeowners have usually never heard of, and it explains a great many joints that fail despite the right product being used.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Two Sides Good, Three Sides Bad</p>
            <p class="text-xl font-bold text-white mb-3">A bead bonded only to the two facing surfaces can stretch and compress as the joint moves. One also bonded to the back cannot deform, so movement tears it apart.</p>
            <p class="text-gray-300 leading-relaxed m-0">This is the entire purpose of backer rod. It is not filler to save caulk — it is a deliberate bond breaker that gives the bead a back surface it will not stick to, plus the correct depth. Closed-cell polyethylene rod costs a few dollars for a long roll and doubles the life of a joint.</p>
          </div>

          <p>
            Size the rod about 25 percent larger than the joint width so it compresses into place and stays put, and push it in with a blunt tool to the depth you want rather than a screwdriver, which can puncture closed-cell rod and cause bubbling in the cured bead.
          </p>

          <p>
            In a shallow joint where rod will not fit, bond-breaker tape does the same job — a strip of thin PTFE or polyethylene tape laid along the back of the joint before caulking. It is a small extra step that turns a two-year joint into a ten-year one.
          </p>
        </div>

        <div id="geometry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Joint Geometry: Half the Width</h2>

          <p>
            The right depth for a caulk bead is roughly half its width, with a floor of about an eighth of an inch and a ceiling of about half an inch. A half-inch joint wants a quarter-inch of caulk depth; a quarter-inch joint wants an eighth.
          </p>

          <p>
            The instinct is that more caulk means a stronger joint, and the opposite is true. A deep bead has more material resisting the same movement, so stress concentrates rather than distributing across a thin flexible section. It also cures more slowly from the inside, and some products never fully cure at depth. Deep beads crack sooner and more dramatically than correctly sized ones.
          </p>

          <p>
            Width has a floor too. A joint narrower than about a quarter inch cannot accommodate meaningful movement no matter what is in it, because even a highly flexible sealant is being asked to stretch a large percentage of a tiny dimension. On a gap that keeps failing and is very narrow, the honest fix is sometimes to open it up slightly rather than to keep filling it.
          </p>

          <p>
            The hourglass profile — thin in the middle, thicker where it meets each face — is what you are aiming for when you tool the bead, and it is why tooling matters beyond appearance. A properly tooled joint concentrates flex in the thin centre and keeps good contact area at the bond lines.
          </p>
        </div>

        <div id="prep" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Surfaces and Preparation</h2>

          <p>
            When a bead has pulled cleanly away from one side while staying attached to the other, that is adhesion failure rather than movement failure, and it is nearly always about the substrate.
          </p>

          <p>
            <strong>Remove the old caulk completely.</strong> New sealant bonded to old sealant fails along the same line, usually within a season. Cut both bond lines with a utility knife, pull the old bead out, and scrape the residue. A caulk removal tool and a solvent appropriate to the old product make this far quicker — the method is in <a href="/how-to-remove-old-caulk/">how to remove old caulk</a>.
          </p>

          <p>
            <strong>Clean beyond brushing.</strong> Dust, chalking paint, mildew, pollen and the film on new vinyl all break adhesion. Wipe the bond surfaces with denatured alcohol or the solvent the manufacturer recommends, and let it flash off before caulking. On chalky old paint, brush hard first — the caulk cannot be stronger than the chalk layer it is stuck to.
          </p>

          <p>
            <strong>Check substrate compatibility.</strong> Vinyl, PVC trim, powder-coated aluminium and some composites are demanding surfaces, and not every product bonds to them. The tube states which materials it is rated for; that list is worth reading rather than assuming. These materials also move far more than wood or masonry with temperature, which compounds the problem.
          </p>

          <p>
            <strong>Get the timing right.</strong> Most products want 40 to 80°F, and surface temperature matters more than air temperature. Season matters as much: caulking in midsummer means filling a joint at its narrowest, so it opens in winter and stretches the bead to its limit. Spring and autumn put the joint mid-range, which halves the demand on the sealant.
          </p>
        </div>

        <div id="not-caulk" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Joints That Should Not Be Caulked At All</h2>

          <p>
            Some joints fail repeatedly because they were never meant to be sealed. A house wall is a drained assembly rather than a sealed box: water gets behind cladding, and the design assumes it will run down and out.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Window and door weep holes.</strong> Small slots along the bottom of the frame that drain the track. Sealing them backs water up into the frame.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>The bottom edge of horizontal siding laps.</strong> That gap lets the wall cavity breathe and drain. Caulking it traps moisture against sheathing.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Under a window sill nose.</strong> The drip edge is designed to shed water clear of the wall. Sealing beneath it directs water into the joint instead.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Beneath a drip cap or head flashing.</strong> Flashing works by draining outward; a bead under it turns it into a dam.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Structural gaps that keep growing.</strong> A joint opening year on year is movement or settlement, and sealant is not a structural repair.</span>
            </li>
          </ul>

          <p>
            The diagnostic here is a joint that fails annually while showing water staining or rot nearby. That combination usually means the caulk is trapping water rather than excluding it — and the correct action is to remove the bead and leave the joint open. <a href="/where-not-to-caulk/">Where not to caulk</a> covers the full list.
          </p>
        </div>

        <div id="doing-it-right" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. Doing It Once</h2>

          <p>
            Remove every trace of the old bead and clean both bond surfaces with the appropriate solvent. Fit backer rod sized 25 percent over the joint width, set so the caulk depth will be about half the width. Choose a sealant rated for the movement the joint actually sees — polyurethane for anything demanding and paintable, silicone where paint is not needed.
          </p>

          <p>
            Cut the nozzle to match the joint width, at an angle, and gun a continuous bead with steady pressure, pushing rather than pulling so material is forced into the joint. Tool it immediately with a wet finger or a jointing tool to press it into contact with both faces and leave a slightly concave profile.
          </p>

          <p>
            Then leave it alone for the full cure — often several days for polyurethane, and longer in cold or humid conditions. Do not paint until the manufacturer's overpaint time has passed. Full guidance for the most common case is in <a href="/how-to-caulk-exterior-windows/">how to caulk exterior windows</a>, and product picks in <a href="/best-exterior-caulk/">best exterior caulk</a>.
          </p>
        </div>

        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">How Long Should Exterior Caulk Actually Last?</h2>
        <p>
          Setting expectations matters here, because part of the frustration comes from comparing real performance against an imagined standard. A correctly specified, correctly installed exterior joint should give ten to twenty years from a polyurethane or silicone sealant, and five to ten from a good siliconised acrylic on a low-movement joint. Acrylic latex on a static, painted interior-grade trim joint can go a decade; on anything exterior that moves, two years is normal and is not a defect.
        </p>
        <p>
          Against that, a joint failing annually is telling you something specific rather than being unlucky. One year means a fundamental mismatch — wrong product class, three-sided adhesion, or a joint that should be draining. Three to five years usually means the right idea with imperfect execution, most often depth or preparation. Ten years and counting means it was done properly.
        </p>
        <p>
          It is also worth inspecting rather than waiting for obvious failure. Walk the exterior each spring and press a fingernail into the beads at the most exposed joints — the south and west elevations, and anywhere below a roofline that sheds water. Caulk that has gone hard and glassy has lost its flexibility and will crack at the next cold snap even if it looks intact today. Replacing a section on your own schedule, in mild weather, with the joint at mid-range width, is a far better job than replacing it in February because water is getting in.
        </p>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">8. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using Acrylic Latex on a Moving Joint</h3>
              <p class="text-gray-700 text-sm m-0">Rated for around twelve percent movement against a joint that flexes twenty-five percent seasonally, it will split every year regardless of technique. Read the movement rating on the tube and match it to what the joint actually does.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Skipping Backer Rod</h3>
              <p class="text-gray-700 text-sm m-0">Without it the bead bonds to the back of the joint and cannot deform, so movement tears it. Rod is a bond breaker as much as a filler, it sets the correct depth, and it costs a few dollars for a roll that does a whole house.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Caulking Over the Old Bead</h3>
              <p class="text-gray-700 text-sm m-0">The new sealant bonds to failing material rather than the substrate, so it cracks along the same line within a season. Cutting the old bead out is most of the work and it is the part that makes the repair last.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Filling the Joint Full Depth</h3>
              <p class="text-gray-700 text-sm m-0">More caulk is not stronger. Depth should be about half the width, capped at half an inch. Deep beads concentrate stress, cure slowly from the inside, and crack sooner than a correctly proportioned bead.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealing Drainage Paths</h3>
              <p class="text-gray-700 text-sm m-0">Weep holes, siding lap bottoms and the underside of sills and drip caps are meant to be open. Caulking them traps water inside the wall, where it rots framing. A joint that fails yearly next to water staining is usually one of these.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does exterior caulk keep cracking?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Usually the joint moves more than the caulk can stretch. Common causes are a low-movement product on a seasonal joint, three-sided adhesion, a bead applied too deep, poor surface prep, and joints that should never have been caulked at all.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is three-sided adhesion?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Caulk bonded to the back of a joint as well as both faces. A bead bonded on two sides can stretch and compress; one bonded on three cannot deform freely, so movement tears it. Backer rod fills the depth and gives the caulk a surface it deliberately will not stick to.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How deep should a caulk joint be?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">About half its width, minimum an eighth of an inch and maximum half an inch. A half-inch joint wants a quarter-inch depth. Deeper beads are not stronger — they cure slowly, hold more stress and crack sooner. Backer rod sets that depth in a wide joint.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the most flexible exterior caulk?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Silicone and polyurethane, typically rated for 25 to 50 percent joint movement against 7.5 to 12.5 percent for acrylic latex. Siliconised acrylics sit between. For any seasonal joint, the movement rating matters far more than the brand.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you caulk over old cracked caulk?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">It rarely lasts. The new bead bonds to failing material rather than the substrate and cracks along the same line, often within a season. Remove the old caulk completely, clean back to sound material, and start again.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What temperature should you caulk at?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Most products want 40 to 80°F, and surface temperature matters more than air. Season matters as much: caulking in midsummer fills a joint at its narrowest, so it opens in winter and stretches the bead to its limit. Spring and autumn are better.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does it pull away from siding but not the window?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Adhesion has failed on one substrate. Vinyl, PVC trim and powder-coated aluminium are difficult surfaces for many caulks and move far more than wood or masonry. Check the tube is rated for that material, and clean it with a solvent wipe rather than a brush.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Are there places you should not caulk?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes — weep holes, the bottom edge of siding laps, the underside of window sills and beneath drip caps all exist to let water escape. Sealing them traps moisture inside the wall, where it rots framing instead of draining away harmlessly.</p>
            </div>
          </div>
        </div>

