---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Mini-Split Heat Pumps",
    "url": "/best-mini-split-heat-pump/"
  },
  {
    "title": "Best Evaporative Coolers",
    "url": "/best-evaporative-cooler/"
  },
  {
    "title": "How Long Do Mini-Splits Last?",
    "url": "/how-long-do-mini-splits-last/"
  },
  {
    "title": "Can a Power Station Run an Air Conditioner?",
    "url": "/can-a-portable-power-station-run-an-air-conditioner/"
  },
  {
    "title": "Best Dehumidifiers for Bedrooms",
    "url": "/best-dehumidifier-for-bedroom/"
  },
  {
    "title": "Best Whole House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Best Attic Fans",
    "url": "/best-attic-fan/"
  },
  {
    "title": "Best Ceiling Fans with Lights",
    "url": "/best-ceiling-fans-with-lights/"
  },
  {
    "title": "Best Caulk for Windows",
    "url": "/best-caulk-for-windows/"
  },
  {
    "title": "What Size Generator Runs Central Air?",
    "url": "/what-size-generator-runs-central-air-conditioning/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "6 Best Narrow Window Air Conditioners in 2026: Ranked";
const description =
  "The best narrow window air conditioners for small double-hung, slider and casement windows, with window measurements, BTU sizing, inverter picks and install tips.";

const PRODUCTS = [
  {
    "id": "midea-u-shaped-8000-inverter",
    "name": "Midea U-Shaped 8,000 BTU Smart Inverter Window AC (MAW08V1QWT)",
    "category": "Inverter window AC, fits 22 to 36 in. double-hung openings",
    "badge": "Best Overall (Double-Hung)",
    "amazonUrl": "#",
    "pros": [
      "U-shaped body straddles the sash, so the window can still open and close above it",
      "Inverter compressor ramps up and down instead of cycling on and off, which is quieter and more efficient",
      "Midea lists a 22 to 36 inch window width range and a 13.75 inch minimum height",
      "Rated for rooms up to about 350 sq. ft., with Wi-Fi and app control",
      "Most of the noisy machinery sits outside the window"
    ],
    "cons": [
      "Needs a double-hung (vertical-sliding) window; it does not fit casements or horizontal sliders",
      "Model numbers change often (U1 vs V1 suffixes), and stock moves between retailers"
    ],
    "bottomLine": "If your narrow window is a standard double-hung that is at least 22 inches wide, this is the quietest, most efficient unit you can put in it.",
    "description": "The Midea U is the window air conditioner that changed what a small window unit can be, and it is our first pick for any narrow window that is a standard double-hung at least 22 inches wide. Instead of a box that sits in the opening, the unit is shaped like a U: the indoor half and outdoor half are joined by a channel that the lower sash closes down into. The window seals tighter than with an accordion panel, you can still open the window above the unit, and most of the compressor noise ends up outdoors, with a thick pane of glass between it and you. The 8,000 BTU model is rated for rooms up to about 350 square feet. It uses an inverter compressor, which runs continuously at variable speed rather than slamming on and off, so the room holds a steadier temperature and the noise is a low hum instead of a cycle of clunks. Midea's published window range is 22 to 36 inches wide with a minimum opening height of 13.75 inches; some listings for the 10,000 BTU version quote a slightly wider 23-inch minimum, so check the manual for the exact size you buy. That 22-inch minimum is the catch. It is narrower than many units, but not the narrowest, and it will not go into a casement or a horizontal slider at all. Midea also refreshes model numbers often, with U1 and V1 variants and a Costco version, so compare the window ranges on the specific listing. For a narrow double-hung, nothing here is quieter."
  },
  {
    "id": "lg-lw6023ivsm-dual-inverter",
    "name": "LG 6,000 BTU Dual Inverter Smart Window AC (LW6023IVSM)",
    "category": "Compact inverter window AC, 250 sq. ft.",
    "badge": "Best Small Inverter Unit",
    "amazonUrl": "#",
    "pros": [
      "Dual Inverter compressor for quieter, more efficient part-load running",
      "Compact chassis for small bedrooms and offices up to about 250 sq. ft.",
      "Wi-Fi and app control with LG ThinQ, plus remote",
      "Minimum window opening height of about 13 inches",
      "Conventional box shape fits a standard installation kit and side panels"
    ],
    "cons": [
      "Retailers list roughly a 22-inch minimum window width; confirm the exact figure on LG's spec sheet",
      "Costs noticeably more than a basic 6,000 BTU unit"
    ],
    "bottomLine": "The best compact inverter unit for a small bedroom with a narrow double-hung window when the Midea U will not fit or is out of stock.",
    "description": "LG's 6,000 BTU Dual Inverter unit is the compact inverter alternative to the Midea U for people who want a conventional box-style window AC. It is sized for small bedrooms, nurseries and home offices up to roughly 250 square feet, and its inverter compressor gives it the same core advantage as the Midea: rather than switching fully on and off every few minutes, it slows down once the room is cool and holds the temperature with a low, steady hum. For a bedroom, that difference is more noticeable than any decibel figure on a box. It connects to LG's ThinQ app, has a remote, and installs like any standard window unit with expandable side panels. Best Buy lists a minimum window opening height of 13 inches and a maximum width of 36 inches. Minimum width is where we have to be careful: retailer spec tables list about 22 inches, but at least one listing pairs that figure with dimensions that look like they belong to another model, so check LG's own installation sheet against your tape measure before you order. Do not confuse this model with the LW6024R, a cheaper non-inverter 6,000 BTU unit with two fan speeds. The LW6024R is fine for a guest room; the LW6023IVSM is the one to buy for a room you sleep in. The main downside is price, since you are paying a real premium for the inverter over a basic 6,000 BTU box. If your window is 22 inches or wider and the U shape does not suit it, this is the pick."
  },
  {
    "id": "lg-lw5016-5000-btu",
    "name": "LG 5,000 BTU Window Air Conditioner (LW5016)",
    "category": "Small window AC, fits 21 to 35 in. openings",
    "badge": "Smallest Standard Window Unit",
    "amazonUrl": "#",
    "pros": [
      "Retailer listings cite a 21 inch minimum window width, among the narrowest of standard window units",
      "Minimum window height of about 12 inches",
      "Cabinet is only about 17.3 inches wide, 11 inches tall and 14.4 inches deep",
      "Simple mechanical controls with nothing to program or pair",
      "Inexpensive and light enough for one person to lift"
    ],
    "cons": [
      "5,000 BTU is only enough for about 150 sq. ft.",
      "Fixed-speed compressor cycles on and off audibly; availability varies by retailer"
    ],
    "bottomLine": "The smallest window air conditioner most people can buy for a narrow double-hung, as long as the room is small.",
    "description": "If your window is narrower than the 22 inches the inverter units need, LG's LW5016 is where most people end up. Retailer listings cite a window opening range of 21 to 35 inches wide and a minimum height of about 12 inches, and the cabinet itself measures only around 17.3 inches wide, 11 inches tall and 14.4 inches deep. That makes it one of the smallest window air conditioners sold by a major brand, and it slots into openings that defeat most 6,000 and 8,000 BTU units. It is a basic machine: 5,000 BTU, rated for about 150 square feet, with mechanical knobs for temperature and fan speed. There is no app, no remote and no inverter, which is precisely why it is cheap and why there is little to break. The compressor cycles on and off, and you will hear it; light sleepers may find it more intrusive than the Midea or the LG inverter. For a small bedroom, a dorm, a home office or a room where the window is simply too narrow for anything else, it does the job. Two realities to plan around. First, 5,000 BTU is a small-room unit, so a 200-square-foot room with western sun will struggle on the hottest afternoons. Second, retailers rotate stock and LG refreshes model numbers periodically; one retailer marks this listing discontinued while others still sell it, so if it is unavailable, any major-brand 5,000 BTU unit with a 21-inch minimum width is the equivalent to look for."
  },
  {
    "id": "frigidaire-fhwc054te1-5000-btu",
    "name": "Frigidaire 5,000 BTU Window Air Conditioner (FHWC054TE1)",
    "category": "Small window AC, fits 23 to 36 in. openings",
    "badge": "Best Budget Small Window AC",
    "amazonUrl": "#",
    "pros": [
      "Frigidaire's spec sheet lists a 23 to 36 inch window width range",
      "Minimum window height of 13 inches suits short sash openings",
      "Rated for about 150 sq. ft., ideal for small bedrooms and offices",
      "Simple controls and a widely available, inexpensive unit",
      "Frigidaire's service network and parts availability"
    ],
    "cons": [
      "The 23 inch minimum width is two inches wider than the LG LW5016",
      "Fixed-speed compressor, so it is noisier than inverter units"
    ],
    "bottomLine": "A cheap, dependable small window AC for a 23-inch or wider double-hung in a small room.",
    "description": "Frigidaire's FHWC054TE1 is the budget workhorse of small window units, and the one to choose if your window is at least 23 inches wide and you want a dependable small air conditioner without paying for an inverter or an app. Frigidaire's own specification sheet lists a window width range of 23 to 36 inches and a minimum window height of 13 inches, and the rest of Frigidaire's current 5,000 BTU family shares the same 23-inch minimum. It is rated for about 150 square feet, which suits a small bedroom, a home office or a dorm. Installation is the standard window-unit routine: set the unit on the sill, extend the side panels, close the sash down onto the top rail and secure it. Like every basic window air conditioner, it uses a fixed-speed compressor that cycles on and off, so expect an audible click and hum each time it starts. Inverter units are smoother and more efficient, but they cost two to three times as much, and in a room that only needs cooling a few weeks a year the payback never arrives. Why it ranks below the LG LW5016: two inches. If your opening measures 21 or 22 inches, the LG fits and this does not. If it measures 23 or more, the two are close substitutes, and the choice comes down to price on the day and which brand's service you trust. Frigidaire's broad dealer network makes warranty service and parts easier to find than with many smaller brands."
  },
  {
    "id": "frigidaire-ffrs0822se-casement",
    "name": "Frigidaire 8,000 BTU Slider/Casement Window AC (FFRS0822SE)",
    "category": "Vertical slider/casement AC, 15.5 in. minimum width",
    "badge": "Best Casement and Slider Unit",
    "amazonUrl": "#",
    "pros": [
      "Tall, narrow cabinet fits openings as narrow as 15.5 inches",
      "Built for horizontal sliding windows and casement windows that standard units cannot fit",
      "8,000 BTU capacity, enough for a mid-size bedroom",
      "Multi-speed fan, 24-hour timer and sleep mode",
      "Accommodates walls up to about 8.5 inches thick"
    ],
    "cons": [
      "Casement installs need a filler panel and some carpentry or a sash removal",
      "Frigidaire has discontinued several earlier slider/casement models; stock is uneven"
    ],
    "bottomLine": "One of the few real air conditioners made for casement and horizontal slider windows. If you have one, buy it while you can find it.",
    "description": "Casement and slider windows are the hardest windows to air-condition, and Frigidaire's FFRS0822SE is one of the few mainstream units built for them. A standard window air conditioner is wider than it is tall, which works in a double-hung window that opens vertically. A horizontal slider or a casement opens sideways, so the opening is tall and narrow. This unit flips the shape: the cabinet is roughly 14.2 inches wide, 20.25 inches tall and 23.5 inches deep, and it needs a window opening as narrow as 15.5 inches. Frigidaire's installation instructions give a casement width range of about 15.5 to 16.25 inches, a minimum height of roughly 21.5 inches, and a maximum wall thickness of about 8.5 inches. Sliders use an included panel to fill the space above the unit. Casements need more work. The window cranks outward, so the usual approach is to install the unit in the opening with a rigid filler panel, often plexiglass or a cut panel, around it, and in some cases remove the sash entirely for the season. Budget an afternoon and a helper, and think about security on ground-floor windows. At 8,000 BTU it suits a bedroom of around 300 to 350 square feet. Retailers describe it as not suitable for standard double-hung installation, so do not buy it for a normal window. The bigger issue is availability. Frigidaire has discontinued earlier slider/casement models such as the FFRS0822S1 and FHSC082WB1, and stock of this one varies by retailer. If you see it in stock and your window measures right, do not wait."
  },
  {
    "id": "frigidaire-ffrs1022re-casement",
    "name": "Frigidaire 10,000 BTU Slider/Casement Window AC (FFRS1022RE)",
    "category": "Vertical slider/casement AC, 15.5 in. minimum width",
    "badge": "Best Casement Unit for Larger Rooms",
    "amazonUrl": "#",
    "pros": [
      "Same 15.5 inch minimum opening width as the 8,000 BTU model",
      "10,000 BTU handles living rooms and larger bedrooms",
      "Remote control, timer and multi-speed fan",
      "Designed for both horizontal sliding and casement windows",
      "Frigidaire spec sheet lists a maximum wall thickness of 8.5 inches"
    ],
    "cons": [
      "Heavier and deeper than standard units, so support matters",
      "Minimum height is listed at 21.5 to 22.5 inches depending on source; measure carefully"
    ],
    "bottomLine": "The bigger sibling for casement and slider windows in rooms that an 8,000 BTU unit cannot keep up with.",
    "description": "The FFRS1022RE is the 10,000 BTU version of Frigidaire's slider/casement design, and it exists for one reason: rooms with casement or horizontal slider windows that are too big for 8,000 BTU. It shares the tall, narrow cabinet and the 15.5-inch minimum window width of the smaller model, so it fits the same openings, but it adds the capacity to cool a living room or a large primary bedroom of roughly 400 to 450 square feet. Frigidaire's spec sheet lists a minimum window height of 21.5 inches and a maximum wall thickness of 8.5 inches, while Frigidaire Canada and some retailers list a 22.5-inch minimum height for closely related versions, so measure your opening height carefully and use the larger figure if you are close. It comes with a remote, a timer and a multi-speed fan. Installation is the same as the 8,000 BTU unit, with one difference worth respecting: it is heavier and deeper, and much of its weight hangs outside the wall. Use a proper exterior support bracket, especially on upper floors, and make sure the sill can carry the load. Like the smaller model, it is not meant for standard double-hung windows. Availability is the recurring problem in this category; Frigidaire has retired earlier versions like the FFRS1022R1, and stock appears and disappears. If it is not available, a portable air conditioner with a casement window kit or a ductless mini-split are the realistic alternatives, and we cover both below."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Narrow Window Air Conditioners",
          item: "https://www.thehonestreviewers.com/best-narrow-window-air-conditioner/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the smallest window air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among standard window units, the LG LW5016 is one of the smallest, with retailers listing a 21-inch minimum window width and a cabinet about 17.3 inches wide. For even narrower openings, Frigidaire's slider/casement units need only 15.5 inches of width, but they are tall, so the opening needs about 21.5 to 22.5 inches of height."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put a window AC in a casement window?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only a casement-specific unit, or a standard unit with a fully built filler panel, which is less secure and seals poorly. Casement units like Frigidaire's slider/casement models sit in the open frame with a rigid panel around them. Many people find a portable air conditioner with a casement window kit or a ductless mini-split simpler."
          }
        },
        {
          "@type": "Question",
          "name": "Will the Midea U fit a narrow window?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If the window is a double-hung at least 22 inches wide and 13.75 inches tall, yes. The U shape lets the window close into the unit, which seals better and keeps most noise outside. It will not fit a casement or a horizontal sliding window, and some listings for larger models quote a 23-inch minimum width."
          }
        },
        {
          "@type": "Question",
          "name": "What size air conditioner do I need for a small bedroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 to 150 square feet, 5,000 BTU is usually enough. For 150 to 250 square feet, step up to 6,000 BTU. Add about 10 percent for a sunny room and roughly 600 BTU for each extra regular occupant beyond two. Avoid oversizing, which leaves the room cold but clammy."
          }
        },
        {
          "@type": "Question",
          "name": "Are inverter window air conditioners worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a bedroom you use most nights through the summer, usually yes. Inverter units run quietly and steadily instead of cycling, hold the temperature better and use less energy over a season. For a guest room or an office cooled only a few weeks a year, a basic unit costs far less and the savings never repay the difference."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a support bracket for a small window AC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Above the ground floor, we strongly recommend one. Even a 5,000 BTU unit weighs around 35 to 40 pounds, mostly hanging outside the window. Some cities and many buildings require proper support for window units on upper floors. A bracket screwed into solid framing or masonry is inexpensive insurance."
          }
        },
        {
          "@type": "Question",
          "name": "What if no window AC fits my window?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Consider a portable air conditioner with a window kit, which fits almost any window but is louder and less efficient; a through-the-wall unit, which needs a wall opening; or a ductless mini-split, which costs more up front but is the quietest and most efficient option and leaves the window free."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "narrow window air conditioner",
      "narrow window ac",
      "smallest window air conditioner",
      "casement window air conditioner",
      "slider window air conditioner",
      "small window ac unit"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          6 Best <span class="text-[#38BDF8]">Narrow Window Air Conditioners</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The smallest standard window units, the quietest inverter models for narrow double-hungs, and the few real air conditioners made for casement and slider windows, matched to the opening you actually have.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#midea-u-shaped-8000-inverter"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 6 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#measure" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How to Measure</a>
          <a href="#window-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Window Types</a>
          <a href="#btu-sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. BTU Sizing</a>
          <a href="#inverter" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Inverter vs Standard</a>
          <a href="#noise" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Noise</a>
          <a href="#install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Installation and Brackets</a>
          <a href="#efficiency" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Running Costs and Care</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A narrow window rules out most air conditioners before you compare a single feature. If your double-hung opening is 22 inches or wider, an inverter unit like the Midea U is the quiet, efficient choice. Between 21 and 22 inches, you are looking at a small basic unit. Below that, or with a slider or casement, you need a tall vertical unit, and there are only a few left. Here is how to measure, size and choose.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Narrow Window Air Conditioners, Ranked
