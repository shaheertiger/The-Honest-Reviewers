const title = "Why Is My Pressure Washer Pulsing? Surging, Cycling and How to Stop It";
const description =
  "Pulsing is usually a starved water supply or air in the line; on/off cycling is often a leak. Diagnose surging, nozzles, unloaders and worn valves in order.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Why Is My Pressure Washer Pulsing",
          item: "https://www.thehonestreviewers.com/why-is-my-pressure-washer-pulsing/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is it normal for a pressure washer to surge when I first pull the trigger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A brief surge or stutter at the moment you squeeze the trigger is normal on many electric machines with total stop, because the motor is starting and pressure is building. It should settle within a second or two. If the surging continues throughout the spray, or the motor stops and starts while you hold the trigger, there is a fault to diagnose."
          }
        },
        {
          "@type": "Question",
          "name": "Can a garden hose cause pressure washer pulsing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is one of the most common causes. A long hose, a narrow 1/2 inch hose, kinks, or a cracked hose washer can starve the pump or let air in. A shorter 5/8 inch hose, fully opened faucet and fresh washers fix many cases. Check the manual for the supply hose length and size it allows."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my pressure washer pulse with one nozzle but not others?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That points to the nozzle. A partly blocked narrow tip restricts flow, raises pressure and makes the unloader cycle, which feels like pulsing. Clean the tip with the cleaning tool or a fine wire and back-flush it. If it still pulses, replace it. If every nozzle pulses, the problem is elsewhere in the system."
          }
        },
        {
          "@type": "Question",
          "name": "Will a pulsing pressure washer damage itself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can. Pulsing from a starved supply usually means cavitation, where vapor bubbles collapse inside the pump and erode the valves and seals. The longer you work through it, the more damage builds. Stop and fix the supply or air problem before continuing, and the pump will usually recover without lasting harm."
          }
        },
        {
          "@type": "Question",
          "name": "How do I stop my electric pressure washer from turning on and off?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Find the pressure leak. With the motor stopped and the trigger released, check the quick-connects at both ends of the high-pressure hose, the spray gun and the hose itself for drips. Replace worn O-rings and tighten connections. If nothing leaks externally, a worn check valve or unloader inside the pump is the likely cause and needs repair."
          }
        },
        {
          "@type": "Question",
          "name": "Can low water pressure at the house cause pulsing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The pump needs a steady supply that meets or exceeds its rated gallons per minute. Homes on wells, with pressure-reducing valves, or with old pipes may not deliver enough flow, especially if other water is being used at the same time. Time a 5-gallon bucket fill to measure what your faucet actually delivers and compare it with the label."
          }
        },
        {
          "@type": "Question",
          "name": "Does detergent cause a pressure washer to pulse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can contribute. Thick cleaners, or products not designed for pressure washers, can leave residue on the unloader and valves that makes them sluggish. Drawing detergent through a siphon tube that has a leak can also pull air into the system. Use pressure-washer detergents, and flush with clean water for a few minutes afterward."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
