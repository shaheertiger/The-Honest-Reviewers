const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "7 Best Paintable Caulks in 2026: Paint-Ready Times, Shrinkage and Trim Picks";
const description =
  "The best paintable caulk for interior and exterior trim, comparing acrylic latex, siliconized acrylic, hybrid and paintable silicone on paint-ready time and movement.";

const PRODUCTS = [
  {
    "id": "dap-alex-flex-18542",
    "name": "DAP Alex Flex Premium Molding & Trim Siliconized Sealant 18542, 10.1 oz",
    "category": "Siliconized Acrylic Latex, Interior Trim, ASTM C920 Class 12.5",
    "badge": "Best for Interior Trim",
    "amazonUrl": "#",
    "pros": [
      "Made specifically for molding and trim joints",
      "Paint-ready in 30 minutes with latex or oil-based paint, per DAP",
      "Rated to ASTM C920 Class 12.5, with a listed dynamic movement of plus or minus 12.5%",
