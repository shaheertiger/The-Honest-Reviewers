import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Exterior Caulk",
    "url": "/best-exterior-caulk/"
  },
  {
    "title": "Silicone vs Latex Caulk",
    "url": "/silicone-vs-latex-caulk/"
