---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Milwaukee vs DeWalt",
    "url": "/milwaukee-vs-dewalt/"
  },
  {
    "title": "Best Cordless Tool Brand",
    "url": "/best-cordless-tool-brand/"
  },
  {
    "title": "Best Impact Wrenches",
    "url": "/best-impact-wrench/"
  },
  {
    "title": "What Drive Size Socket Set Do I Need?",
    "url": "/what-drive-size-socket-set-do-i-need/"
  },
  {
    "title": "Ryobi ONE+ 18V Tools Review",
    "url": "/ryobi-tools-review/"
  },
  {
    "title": "Best Torque Wrenches",
    "url": "/best-torque-wrench/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Cordless Ratchets in 2026: Drive Size, Speed and Head Size";
const description =
  "The best cordless ratchets from Milwaukee, DeWalt, Makita and Ryobi, compared on 1/4 vs 3/8 vs 1/2 drive, 12V vs 20V, high-speed RPM, ft-lb ratings and head size for tight spaces.";

const PRODUCTS = [
  {
    "id": "milwaukee-2567-20-m12-fuel-3-8-high-speed",
    "name": "Milwaukee 2567-20 M12 FUEL 3/8 in. High Speed Ratchet (Tool Only)",
    "category": "12V Brushless, 3/8 in. Drive, 450 RPM, 35 ft-lbs, 0.75 in. Head",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Up to 450 RPM, per the listing, for fast run-down on long threads",
      "0.75-inch head profile for tight engine bays",
      "Steel yoke housing for durability",
      "Works as a manual ratchet without engaging the motor",
      "Runs on the huge M12 battery platform"
    ],
    "cons": [
      "35 ft-lbs will not break loose seized bolts",
      "Tool only: battery and charger sold separately",
      "3/8-inch drive only, so 1/4-inch work needs an adapter"
    ],
    "bottomLine": "The cordless ratchet most mechanics and DIYers should buy first: fast, slim and on the most popular 12V platform.",
    "description": "The Milwaukee 2567-20 is the cordless ratchet we would hand to most people, because it gets the two things that matter in an engine bay right: speed and head size. The listing specifies up to 450 RPM, which is close to double the 250 RPM of older 12V ratchets, so spinning a long bolt or a stack of valve cover fasteners takes seconds rather than a minute of thumb work. The head profile is listed at 0.75 inch, slim enough to slip between a radiator and a fan shroud or behind an alternator bracket. Torque is rated up to 35 ft-lbs, which is the right number for a run-down tool: enough to snug and remove most small and medium fasteners, not enough to strip threads by accident. Milwaukee lists a steel yoke housing, the part that takes the abuse when the tool is used as a breaker, and the ratchet can be turned by hand without engaging the motor for the final click or the first crack. The trade-offs are real. Thirty-five ft-lbs will not break loose a rusted exhaust nut or a caliper bracket bolt, the tool ships without a battery, and it is 3/8-inch only. Buy the DeWalt DCF510B instead if you need 1/2-inch drive and more torque, or the Makita XRW01Z if you live on 18V Makita batteries."
  },
  {
    "id": "dewalt-dcf510b-20v-3-8-1-2-sealed-head",
    "name": "DEWALT DCF510B 20V MAX XR 3/8 in. and 1/2 in. Sealed Head Ratchet (Tool Only)",
    "category": "20V Brushless, Swappable 3/8 & 1/2 in. Anvils, 75 ft-lbs, 0-300 RPM",
    "badge": "Most Torque",
    "amazonUrl": "#",
    "pros": [
      "75 ft-lbs of max torque, per the listing",
      "Interchangeable 3/8-inch and 1/2-inch anvils",
      "Glass-filled nylon housing resists oils and solvents",
      "Brushless motor on the 20V MAX platform",
      "Variable speed trigger and LED light"
    ],
    "cons": [
      "Heavier and longer than any 12V ratchet",
      "300 RPM is slower than the high-speed models",
      "Tool only: battery sold separately"
    ],
    "bottomLine": "The cordless ratchet for bigger fasteners and 1/2-inch sockets, if you already own DeWalt 20V batteries.",
    "description": "Most cordless ratchets top out around 35 ft-lbs, and the DeWalt DCF510B is the one for people who keep running into that ceiling. The listing rates it at 75 ft-lbs of max torque, more than double the 12V tools in this guide, which means suspension fasteners, larger brackets and stubborn bolts that a compact ratchet stalls on are within reach once you have cracked them loose by hand. Its standout feature is the interchangeable anvil: you swap between 3/8-inch and 1/2-inch square drives, so one tool covers both socket sets without adapters adding length and wobble. DeWalt specifies a brushless motor, a 0-300 RPM variable speed trigger and an on-board LED, plus a glass-filled nylon housing that is meant to stand up to automotive oils and solvents, which matters on a tool that lives in a greasy drawer. The trade-off is size. A 20V ratchet with a 20V battery is longer and heavier than an M12 tool, so it will not reach as deep behind an engine, and at 300 RPM it is slower than the high-speed models on long threads. It is also sold bare. Buy it if you own DeWalt 20V batteries and work on trucks, mowers or equipment with bigger hardware. For tight engine bays, pick the Milwaukee 2567-20 or the DeWalt DCF520B instead."
  },
  {
    "id": "makita-xrw01z-18v-3-8-1-4-ratchet",
    "name": "Makita XRW01Z 18V LXT 3/8 in. / 1/4 in. Sq. Drive Ratchet (Tool Only)",
    "category": "18V LXT, Swappable 3/8 & 1/4 in. Anvils, 35 ft-lbs, 0-800 RPM",
    "badge": "Fastest Run-Down",
    "amazonUrl": "#",
    "pros": [
      "0-800 RPM variable speed, per the listing",
      "Interchangeable 3/8-inch and 1/4-inch anvils",
      "Electric brake stops the socket quickly",
      "Usable as a manual ratchet when the motor is off",
      "Runs on Makita's 18V LXT batteries"
    ],
    "cons": [
      "35 ft-lbs is modest for an 18V tool",
      "18V battery makes it bulkier than 12V ratchets",
      "Very high speed needs a light trigger finger near the end"
    ],
    "bottomLine": "The fastest ratchet here for spinning fasteners on and off, and the obvious choice for Makita 18V owners.",
    "description": "If you mostly use a cordless ratchet to spin fasteners that are already loose, speed matters more than torque, and the Makita XRW01Z has the highest speed rating in this guide. The listing specifies a variable speed range of 0-800 RPM, well above the 450 RPM of the high-speed 12V models, so long bolts, threaded rod and stacks of panel fasteners come off almost as fast as you can line up the socket. Makita pairs that speed with an electric brake, which stops the socket quickly when you let go of the trigger, so you are less likely to over-spin or cross-thread a fastener once it seats. The interchangeable anvils swap between 3/8-inch and 1/4-inch square drives, which covers both of the socket sets used on most car interior, engine and appliance work, and the tool can be turned as a manual ratchet when the motor is not engaged. The trade-offs: max torque is rated at 35 ft-lbs, the same as compact 12V tools, so the 18V battery adds size and weight without adding breaking power. At 800 RPM you also need a light touch as a bolt bottoms out. Buy it if you already own Makita 18V LXT batteries. If you want the same tool in a smaller package, the Makita RW01Z runs on 12V CXT batteries with the same listed torque and speed."
  },
  {
    "id": "dewalt-dcf520b-20v-1-4-3-8-high-speed",
    "name": "DEWALT DCF520B 20V MAX XR 1/4 in. and 3/8 in. Sealed Head Ratchet (Tool Only)",
    "category": "20V Brushless, 3/8 & 1/4 in. Square + 1/4 in. Hex Anvils, 450 RPM, 50 ft-lbs",
    "badge": "Best 20V High Speed",
    "amazonUrl": "#",
    "pros": [
      "Up to 450 RPM, DeWalt's highest-speed 20V ratchet per the listing",
      "50 ft-lbs of max torque",
      "Three anvils: 3/8-inch square, 1/4-inch square and 1/4-inch hex",
      "Sealed head with an easy-to-reach direction switch",
      "Integrated trigger lock prevents accidental starts"
    ],
    "cons": [
      "Larger than 12V ratchets with a 20V pack fitted",
      "No 1/2-inch anvil",
      "Tool only: battery and charger sold separately"
    ],
    "bottomLine": "The best all-rounder for DeWalt 20V owners: high-speed, more torque than 12V tools, and three drive options in one.",
    "description": "The DCF520B is DeWalt's answer to the high-speed 12V ratchets, and for anyone already running DeWalt 20V batteries it is the more versatile of the two DeWalts here. The listing calls it the brand's highest-speed 20V ratchet, at up to 450 RPM, and rates it at 50 ft-lbs of max torque, which sits usefully between the 35 ft-lb compact tools and the 75 ft-lb DCF510B. That combination means it spins bolts quickly but has some reserve left when a fastener is a little tight. The interchangeable anvil design is the clever part: you swap between a 3/8-inch square drive, a 1/4-inch square drive and a 1/4-inch low-profile hex anvil, so the same tool runs your two most-used socket sets and can also drive hex bits for appliance and interior work. DeWalt specifies a sealed-head design with the forward and reverse switch placed for easy reach in tight spaces, and a trigger lock to stop accidental starts in a toolbag. The trade-offs: with a 20V battery on the end it is longer and heavier than an M12 ratchet, there is no 1/2-inch anvil, and it is sold bare. Buy it for general automotive and equipment work on the DeWalt platform. If you need 1/2-inch drive, choose the DCF510B; if you are not committed to DeWalt, the Milwaukee 2567-20 is slimmer."
  },
  {
    "id": "milwaukee-2457-20-m12-3-8-ratchet",
    "name": "Milwaukee 2457-20 M12 3/8 in. Sub-Compact Ratchet (Tool Only)",
    "category": "12V Brushed, 3/8 in. Drive, 35 ft-lbs, 250 RPM, Variable Speed",
    "badge": "Best Budget M12",
    "amazonUrl": "#",
    "pros": [
      "35 ft-lbs of torque, the same rating as the FUEL model",
      "Low-profile head for engine bay work",
      "Recessed direction switch prevents accidental changes",
      "On-board fuel gauge and LED light",
      "Long-running, widely owned M12 design"
    ],
    "cons": [
      "250 RPM is slow next to high-speed ratchets",
      "Brushed motor, not brushless",
      "Head is bulkier than the 2567-20's 0.75-inch profile"
    ],
    "bottomLine": "The cheaper way into an M12 ratchet for occasional DIY work, if you can live with the slower speed.",
    "description": "The Milwaukee 2457-20 is the original M12 ratchet, and it is still a sensible buy for occasional DIY use when the FUEL model's speed is more than you need. The listing rates it at 35 ft-lbs of torque, the same as the 2567-20, so on fastener size there is no difference between the two. Where it falls behind is speed: 250 RPM is about half the high-speed models, which you will notice on long bolts but not much on short ones, and the variable speed trigger lets you feather the last few turns. Milwaukee describes a low-profile head for engine bay work and a recessed forward and reverse switch on the back of the head, which prevents you from flipping direction by accident halfway through a job. An on-board fuel gauge shows remaining charge, an LED lights the work area, and Milwaukee's RedLink electronics communicate with the battery to protect against overloading and overheating. The trade-offs are the brushed motor, the slower speed and a head that is not as slim as the newer FUEL design, so very tight spots may still need the 2567-20. It is sold as a bare tool. Buy it if you already own M12 batteries and want a ratchet for brakes, interiors and small engine work a few times a year. If you use a ratchet daily, spend more on the 2567-20."
  },
  {
    "id": "makita-rw01z-12v-cxt-3-8-1-4-ratchet",
    "name": "Makita RW01Z 12V max CXT 3/8 in. / 1/4 in. Sq. Drive Ratchet (Tool Only)",
    "category": "12V max CXT, Swappable 3/8 & 1/4 in. Anvils, 35 ft-lbs, 0-800 RPM",
    "badge": "Best Compact 12V Alternative",
    "amazonUrl": "#",
    "pros": [
      "0-800 RPM variable speed, per the listing",
      "Interchangeable 3/8-inch and 1/4-inch anvils",
      "Electric brake for quick stops",
      "Works as a manual ratchet without the motor",
      "Smaller 12V CXT battery keeps it light"
    ],
    "cons": [
      "35 ft-lbs ceiling, like other compact ratchets",
      "Makita's 12V CXT range is smaller than M12",
      "Tool only: battery and charger sold separately"
    ],
    "bottomLine": "A compact, high-speed ratchet with two drive sizes, best for anyone already on Makita's 12V CXT batteries.",
    "description": "The Makita RW01Z is the 12V twin of the XRW01Z, and it makes more sense for most ratchet work because the smaller battery keeps the tool shorter and lighter in the hand. The listing gives it the same headline numbers: 35 ft-lbs of max torque and a 0-800 RPM variable speed range, which is the fastest speed rating among the 12V tools in this guide. An electric brake stops the socket quickly when you release the trigger, and the tool can be used as a manual ratchet when the motor is not engaged, for that final snug or the first crack of a stuck fastener. The interchangeable anvils switch between 3/8-inch and 1/4-inch square drives, so you can run small interior and trim fasteners on 1/4-inch sockets and engine bay hardware on 3/8-inch without carrying two tools or stacking an adapter. The trade-offs are about the platform as much as the tool. Makita's 12V max CXT line is smaller than Milwaukee's M12 range, so if you are starting from scratch you will find fewer companion tools. The 35 ft-lb limit also means stubborn bolts still need a breaker bar. Buy it if you own Makita CXT batteries or want both drive sizes in a compact tool. If you are starting fresh on 12V, the Milwaukee 2567-20 is the bigger ecosystem."
  },
  {
    "id": "ryobi-pcl280k1-18v-multi-size-ratchet-kit",
    "name": "RYOBI PCL280K1 18V ONE+ Multi-Size Ratchet Kit with 1.5 Ah Battery and Charger",
    "category": "18V ONE+, Swappable 1/2, 3/8 & 1/4 in. Anvils, 35 ft-lbs, 260 RPM, Kit",
    "badge": "Best Starter Kit",
    "amazonUrl": "#",
    "pros": [
      "Three anvils: 1/2-inch, 3/8-inch and 1/4-inch drive",
      "1/2-inch anvil also has a 1/4-inch hex insert for bits",
      "4-position rotating head for awkward angles",
      "Dual LED worklights",
      "Kit includes a 1.5 Ah battery and charger"
    ],
    "cons": [
      "260 RPM is slow for long threads",
      "35 ft-lbs, even on the 1/2-inch anvil",
      "Bulkier head than the compact 12V ratchets"
    ],
    "bottomLine": "The easiest first cordless ratchet for homeowners: everything in the box and every drive size covered.",
    "description": "The Ryobi PCL280K1 is the pick for homeowners who do not already own a battery platform, or who already have Ryobi ONE+ tools in the garage. It is listed as a kit, so the 1.5 Ah battery and charger come in the box and you can use it the day it arrives. Its party trick is drive size: the multi-size anvils accept 1/2-inch, 3/8-inch and 1/4-inch drive sockets, and the 1/2-inch anvil also has a built-in 1/4-inch hex insert for driving bits. That covers every socket set most households own. The listing rates it at up to 35 ft-lbs and 260 RPM, and adds a 4-position rotating head, which lets you angle the ratchet around obstacles when a straight tool will not line up, plus dual LED worklights. The honest trade-offs: 260 RPM is about half the high-speed tools, so long bolts take longer, and 35 ft-lbs is the ceiling even on the 1/2-inch anvil, so do not expect it to remove lug nuts or suspension bolts. Treat the 1/2-inch drive as a convenience for running sockets, not as a source of extra torque. The head is also larger than the slim 12V designs. Buy it for mower maintenance, furniture, bikes and light car work. If you need speed or reach deep into an engine, choose the Milwaukee 2567-20."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cordless Ratchets",
          item: "https://www.thehonestreviewers.com/best-cordless-ratchet/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cordless ratchet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the Milwaukee 2567-20 M12 FUEL 3/8-inch high-speed ratchet is the best cordless ratchet. The listing rates it at 450 RPM and 35 ft-lbs with a 0.75-inch head profile, so it is fast and slim enough for tight engine bays. DeWalt 20V owners should look at the DCF520B, and anyone needing 1/2-inch drive and more torque at the DCF510B."
          }
        },
        {
          "@type": "Question",
          "name": "Should I get a 1/4 or 3/8 cordless ratchet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Get a 3/8-inch cordless ratchet unless most of your work is small interior and trim fasteners. A 3/8-inch drive covers the bulk of car, mower and household hardware and has the widest socket choice. A 1/4-inch tool suits fasteners under about 14 mm. Ratchets with swappable anvils, like the Makita XRW01Z and RW01Z, cover both sizes in one tool."
          }
        },
        {
          "@type": "Question",
          "name": "Can a cordless ratchet remove lug nuts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Lug nuts are usually tightened well beyond the 35 to 75 ft-lbs that cordless ratchets are rated for, and using the motor to break them loose wears out the tool. Crack lug nuts loose with a breaker bar or use an impact wrench. A cordless ratchet can spin them off once they are loose, though an impact wrench is faster."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 12V or 20V cordless ratchet better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 12V cordless ratchet is better for most people because it is shorter, lighter and slimmer, which matters in tight spaces. A 20V ratchet can carry a higher torque rating, like the DeWalt DCF510B's 75 ft-lbs, but it is bulkier. The battery platform you already own is often the deciding factor, since a bare tool costs far less than a new system."
          }
        },
        {
          "@type": "Question",
          "name": "Are high-speed cordless ratchets worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-speed ratchets are worth it if you often remove long bolts or many fasteners at once. Rated speeds of 450 RPM or more cut run-down time roughly in half compared with 250 RPM tools. The trade-off is control as a bolt seats, so use a light trigger finger. For occasional short fasteners, a standard-speed ratchet like the Milwaukee 2457-20 is fine."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a cordless ratchet manually?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, most can. The Milwaukee 2567-20 and both Makita ratchets are listed as usable as manual ratchets without engaging the motor. This is useful for cracking a stuck fastener loose or giving a final snug turn. Do not put a cheater bar on a cordless ratchet, though, because the head and yoke are not built to take breaker-bar loads."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need impact sockets for a cordless ratchet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A cordless ratchet turns smoothly rather than hammering, so standard chrome sockets are fine and their thinner walls help in tight spaces. Impact sockets are only needed for impact wrenches and impact drivers. Use six-point sockets on fasteners you crack loose by hand, and keep extensions short so the tool's torque reaches the fastener."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Tools & Equipment",
    tags: [
      "cordless ratchet",
      "best cordless ratchet",
      "best cordless ratchet wrench",
      "best 3/8 cordless ratchet",
      "high speed cordless ratchet",
      "electric ratchet"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Cordless Ratchets</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A cordless ratchet spins fasteners in places an impact wrench will never fit. Seven real models from Milwaukee, DeWalt, Makita and Ryobi, ranked on drive size, speed, torque and head size.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#milwaukee-2567-20-m12-fuel-3-8-high-speed"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Drive Size?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#drive-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. 1/4, 3/8 or 1/2 Drive</a>
          <a href="#voltage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. 12V vs 18V/20V</a>
