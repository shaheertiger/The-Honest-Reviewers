---
import Layout from "../layouts/Layout.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";

const title =
    "The Brutal Truth About Back Hair (2026)";
const description =
    "Ignoring back hair silently kills confidence. Learn why specialized back shavers are the only real solution for hygiene, hygiene, and self-esteem.";

const schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    author: {
        "@type": "Person",
        name: "Alex Rivers",
    },
    datePublished: "2026-02-19",
    publisher: {
        "@type": "Organization",
        name: "The Honest Reviewers",
    },
};
---

<Layout
    title={title}
    description={description}
    ogType="article"
    jsonLd={schema}
    stickyCta={{
        text: "See Top-Rated Back Shavers",
        link: "/best-mens-back-shavers/",
    }}
>
    <article class="relative overflow-hidden">
        <!-- Hero Section -->
