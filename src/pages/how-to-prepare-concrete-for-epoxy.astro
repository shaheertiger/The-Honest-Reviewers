    { title: "How Long Does Driveway Sealer Last?", url: "/how-long-does-driveway-sealer-last/" },
    { title: "How Much Does It Cost to Seal a Driveway? (2026 Price Guide)", url: "/how-much-does-it-cost-to-seal-a-driveway/" },
    { title: "How to Apply Garage Floor Epoxy", url: "/how-to-apply-garage-floor-epoxy/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-25", modified: "2026-08-25" });
const title = "How to Prepare Concrete for Epoxy: Grinding vs Etching";
const description =
  "Diamond grinding, acid etching, moisture testing and CSP profiles — the prep that decides whether an epoxy floor lasts or peels.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Garage Floors", item: "https://www.thehonestreviewers.com/best-of/" },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Prepare Concrete for Epoxy",
          item: "https://www.thehonestreviewers.com/how-to-prepare-concrete-for-epoxy/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you have to grind concrete before epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Grinding is the professional standard and the only prep that reliably removes old sealer, curing compound and laitance while opening the surface. Acid etching can work on bare, porous, uncoated concrete, but it does nothing to a sealed slab and leaves a shallower profile. If the floor has ever been sealed or coated, grinding is not optional.",
          },
        },
        {
          "@type": "Question",
          name: "How do you know if concrete is sealed?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sprinkle water in several places across the slab. If it soaks in and darkens the concrete within a minute, the surface is open and porous. If it beads or sits on top, there is a sealer or curing compound present and it must be ground off before any coating goes down.",
          },
        },
        {
          "@type": "Question",
          name: "What grit should you use to grind concrete for epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 30 to 40 grit metal-bond diamond is the usual choice for coating prep, producing roughly a CSP 2 to CSP 3 profile. Finer resin-bond diamonds polish the surface, which is the opposite of what a coating needs. For a thick self-leveling system, a shot blaster or a coarser profile is better.",
          },
        },
        {
          "@type": "Question",
          name: "How long does concrete need to cure before applying epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "New concrete needs a minimum of 28 days, and the reason is moisture rather than strength. A slab that still holds construction water will drive vapor into the back of the coating and cause blisters or delamination. Test with a calcium chloride or relative humidity probe before coating anything younger than a few months.",
          },
        },
        {
          "@type": "Question",
          name: "Is acid etching good enough for epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is adequate for thin one-part garage floor paints on bare, porous concrete and marginal for a real two-part epoxy. Etching only reaches an open surface, must be neutralized and rinsed completely, and leaves a profile roughly equivalent to 120 grit sandpaper. Most kit failures we see trace to etching a slab that should have been ground.",
          },
        },
        {
          "@type": "Question",
          name: "How do you test concrete for moisture before epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The quick screen is a plastic sheet test: tape an 18-inch square of plastic to the slab on all four sides and check it after 24 hours. Condensation underneath or a darkened patch of concrete means moisture is moving. For a definitive number, use an ASTM F1869 calcium chloride kit or an ASTM F2170 in-slab humidity probe.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to prep a garage floor for epoxy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A weekend grinder rental runs $100 to $250 plus $50 to $150 for diamond segments and a dust shroud, so a DIY prep on a two-car garage lands around $200 to $400. Professional surface preparation is typically quoted at $1 to $3 per square foot depending on what has to come off.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
