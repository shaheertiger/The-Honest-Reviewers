                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Material</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Approach</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Watch For</th>
                  </tr>
                </thead>
