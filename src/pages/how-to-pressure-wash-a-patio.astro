                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Poured concrete</td>
                    <td class="px-4 py-4 text-gray-700">Surface cleaner at normal gas washer pressure</td>
                    <td class="px-4 py-4 text-gray-700">Etching if tool lingers</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stamped or coloured concrete</td>
                    <td class="px-4 py-4 text-gray-700">Lower pressure, gentle cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Stripping colour or sealer</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete pavers</td>
                    <td class="px-4 py-4 text-gray-700">Surface cleaner at reduced pressure</td>
                    <td class="px-4 py-4 text-gray-700">Joint sand loss</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Granite, dense slate</td>
                    <td class="px-4 py-4 text-gray-700">Moderate pressure, wide fan or deck</td>
                    <td class="px-4 py-4 text-gray-700">Joints and mortar</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Limestone, sandstone, travertine</td>
                    <td class="px-4 py-4 text-gray-700">Low pressure, cleaner does the work</td>
                    <td class="px-4 py-4 text-gray-700">Surface erosion</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brick</td>
                    <td class="px-4 py-4 text-gray-700">Low to moderate pressure</td>
                    <td class="px-4 py-4 text-gray-700">Mortar damage</td>
                  </tr>
