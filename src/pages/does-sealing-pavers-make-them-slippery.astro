                    <td class="px-4 py-4 font-black text-gray-900">Satin film</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Noticeable reduction</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Gloss / wet look</td>
                    <td class="px-4 py-4 text-gray-700">Strong</td>
                    <td class="px-4 py-4 text-gray-700">Substantial reduction</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Gloss with anti-slip additive</td>
                    <td class="px-4 py-4 text-gray-700">Strong</td>
                    <td class="px-4 py-4 text-gray-700">Small reduction</td>
                  </tr>
                </tbody>
