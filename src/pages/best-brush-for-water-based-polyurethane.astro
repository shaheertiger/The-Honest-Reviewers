const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Brushes for Water-Based Polyurethane",
          item: "https://www.thehonestreviewers.com/best-brush-for-water-based-polyurethane/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What type of brush is best for water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Synthetic bristle brushes — specifically nylon, polyester, or nylon/polyester blends — are best for water-based polyurethane. Natural bristle brushes (China bristle, ox hair) absorb water and go limp, losing their shape and leaving heavy brush marks. The Wooster Silver Tip nylon/polyester blend is the best overall choice for furniture and trim, while the Purdy Nylox Glide (100% nylon) is best for flat surfaces.",
          },
        },
        {
          "@type": "Question",
          name: "How do you avoid brush marks with water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a high-quality synthetic bristle brush, apply thin coats rather than thick ones, maintain a wet edge by working quickly, and tip off each section by lightly dragging just the bristle tips across the surface in long, straight strokes. Adding 5-10% Floetrol conditioner can extend the working time. Between coats, lightly sand with 220-grit sandpaper to knock down any raised grain or minor imperfections.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a foam brush for water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and for flat surfaces, foam brushes actually produce smoother results than bristle brushes because there are no individual filaments to leave tracks. Dense foam brushes like the Jen Manufacturing Poly Foam Brush are excellent for final thin coats on flat surfaces. However, foam brushes hold less finish, wear out quickly, and cannot navigate corners or detailed profiles. They are best used as a finishing tool rather than a primary applicator.",
          },
        },
        {
          "@type": "Question",
          name: "Should I use a natural bristle brush for water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Natural bristle brushes — including China bristle, ox hair, and badger hair — should never be used with water-based polyurethane. Natural bristles are hollow and absorbent, meaning they soak up water from the finish, swell, and lose their shape. The result is a floppy, uncontrollable brush that leaves heavy, uneven marks. Natural bristle brushes are designed for oil-based finishes and solvent-based products only.",
          },
        },
        {
          "@type": "Question",
          name: "What is Chinex bristle and why does it matter for water-based finishes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Chinex is a synthetic filament developed by DuPont that resists the softening and swelling that standard nylon bristles experience when soaked in water-based products. Regular nylon absorbs water over time and gradually loses its stiffness, making the brush feel limp after extended use. Chinex maintains its firmness and edge definition throughout a long finishing session, making it ideal for detail work, trim, and precision edges where brush control matters.",
          },
        },
        {
          "@type": "Question",
          name: "How many coats of water-based polyurethane should I apply?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Three coats is the standard recommendation for most interior wood surfaces. The first coat seals the wood and raises the grain. After sanding with 220-grit, the second coat builds the protective film. The third coat provides the final smooth, durable surface. High-traffic surfaces like floors, stair treads, and kitchen tables may benefit from a fourth coat. Always sand lightly between coats with 220-grit and remove all dust before applying the next coat.",
          },
        },
        {
          "@type": "Question",
          name: "How do you clean brushes after using water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Clean immediately after use — water-based polyurethane hardens quickly and becomes nearly impossible to remove once dry. Rinse the brush under warm running water, working the bristles with your fingers to push out finish trapped deep in the bristle pack. Then wash with mild dish soap, working up a lather and rinsing until the water runs completely clear. Shape the bristles back to their original profile and either hang the brush to dry or lay it flat. Never store a brush standing on its bristles, as this permanently bends the tips.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: "2026-03-15",
      dateModified: "2026-03-15",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: product.amazonUrl,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
