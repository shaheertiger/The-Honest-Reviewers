import TrustBadge from "../components/TrustBadge.astro";
import productImages from "../data/product-images.json";

const title = "7 Best Brushes for Water-Based Polyurethane in 2026: No Brush Marks";
const description =
  "We tested 15+ brushes with water-based polyurethane on floors, furniture, and cabinets. Only 7 eliminate brush marks completely.";

