---
import Layout from "../layouts/Layout.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";


const dates = pageDates(Astro.url.pathname, { published: "2026-08-24", modified: "2026-08-24" });
const title = "Driveway Resurfacing Cost in 2026: Asphalt & Concrete Prices";
const description =
  "What driveway resurfacing costs per square foot for asphalt and concrete, when resurfacing beats replacement, and how to avoid overpaying.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Cost Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Driveway Resurfacing Cost",
          item: "https://www.thehonestreviewers.com/driveway-resurfacing-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does it cost to resurface a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Asphalt overlay runs $3-7 per square foot, putting a typical 600 square foot two-car driveway at $1,800-4,200. Concrete resurfacing runs $4-10 per square foot, or $2,400-6,000 for the same driveway. Decorative stamped overlays cost $8-18 per square foot. Full replacement, by comparison, runs $8-20 per square foot.",
          },
        },
        {
          "@type": "Question",
          name: "Is resurfacing a driveway worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, when the base underneath is still sound — it delivers a like-new driveway for 40-60% less than replacement, lasting 10-15 years for asphalt and 10-20 for concrete. It is not worth it when you have alligator cracking, settlement, potholes that return, or standing water, because those are base failures that will telegraph straight through a new overlay.",
          },
        },
        {
          "@type": "Question",
          name: "How do I know if my driveway needs resurfacing or replacing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Look for alligator cracking — an interconnected web resembling reptile skin. That means the base has lost load-bearing capacity and needs excavation, not an overlay. Also replace if you see settlement, heaving, recurring potholes, cracks over half an inch, or water that stands for more than a day. Fading, shallow isolated cracks, and surface spalling are resurfacing candidates.",
          },
        },
        {
          "@type": "Question",
          name: "How long does driveway resurfacing last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "An asphalt overlay of proper 1.5-2 inch compacted thickness lasts 10-15 years, and sealcoating every 3-4 years extends that. A concrete overlay lasts 10-20 years depending on the system and climate. Both figures assume the base beneath is sound and drainage is correct; either problem cuts the life dramatically.",
          },
        },
        {
          "@type": "Question",
          name: "Can you resurface a driveway yourself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Concrete resurfacer is genuinely DIY-able at roughly $0.60-1.50 per square foot in materials, though it is a full weekend of real work for a two-car driveway. Asphalt overlay is not — hot mix must be placed and compacted at temperature with a paver and roller, and without proper compaction it ravels within a season.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between resurfacing and sealcoating?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Resurfacing adds a new structural wearing layer — typically 1.5-2 inches of asphalt or a quarter-inch-plus concrete overlay — and costs $3-10 per square foot. Sealcoating applies a thin protective film at $0.15-0.35 per square foot; it restores appearance and slows oxidation on an intact surface but repairs nothing structural.",
          },
        },
        {
          "@type": "Question",
          name: "How thick should an asphalt overlay be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Two inches compacted is the residential standard, with 1.5 inches acceptable for light-duty driveways. Below 1.5 inches an overlay struggles under turning loads and thermal cycling and fails early. Always get compacted thickness stated in the contract, because it cannot be verified after the work is finished.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete",
    tags: [
      "driveway resurfacing cost",
      "resurface asphalt driveway",
      "concrete driveway resurfacing",
      "driveway overlay",
      "driveway repair cost",
      "home improvement"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Cost Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Driveway <span class="text-[#38BDF8]">Resurfacing Cost</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Resurfacing costs a fraction of replacement — when the base underneath is still sound. Here is what it really costs per square foot, and how to tell whether your driveway is a candidate.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#cost-tables"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Cost Tables
          </a>
          <a
            href="#resurface-vs-replace"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Resurface or Replace?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="15.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#cost-tables" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Cost at a Glance</a>
          <a href="#resurface-vs-replace" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Resurface vs Replace</a>
          <a href="#asphalt-resurfacing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Asphalt Resurfacing</a>
          <a href="#concrete-resurfacing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Concrete Resurfacing</a>
          <a href="#cost-factors" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Cost Factors</a>
          <a href="#diy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. DIY Options</a>
          <a href="#getting-quotes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Getting Quotes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Resurfacing puts a new wearing layer over an existing driveway, and when the base beneath is still sound it delivers a driveway that looks and performs like new for roughly a third to a half of replacement cost. When the base has failed, it is money poured onto a problem that will reappear within two years. Everything about this decision comes down to diagnosing which situation you are in, and this guide walks through both the pricing and the diagnosis.
        </p>

        <!-- SECTION 1: Driveway Resurfacing Cost at a Glance -->
        <div id="cost-tables" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Driveway Resurfacing Cost at a Glance
          </h2>

          <p>
            <strong>Driveway resurfacing cost</strong> is quoted per square foot, and it varies by material, thickness, and how much prep work the existing surface needs. These are 2026 figures for professionally installed work.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Method</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per Sq Ft</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">600 Sq Ft Driveway</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Lifespan</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Asphalt overlay</td>
                  <td class="px-4 py-4 text-gray-700">$3-7</td>
                  <td class="px-4 py-4 text-gray-700">$1,800-4,200</td>
                  <td class="px-4 py-4 text-gray-700">10-15 yr</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Concrete overlay</td>
                  <td class="px-4 py-4 text-gray-700">$4-10</td>
                  <td class="px-4 py-4 text-gray-700">$2,400-6,000</td>
                  <td class="px-4 py-4 text-gray-700">10-20 yr</td>
                </tr>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Decorative/stamped overlay</td>
                  <td class="px-4 py-4 text-gray-700">$8-18</td>
                  <td class="px-4 py-4 text-gray-700">$4,800-10,800</td>
                  <td class="px-4 py-4 text-gray-700">10-20 yr</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Sealcoating (not resurfacing)</td>
                  <td class="px-4 py-4 text-gray-700">$0.15-0.35</td>
                  <td class="px-4 py-4 text-gray-700">$90-210</td>
                  <td class="px-4 py-4 text-gray-700">2-4 yr</td>
                </tr>
                <tr class="bg-white">
                  <td class="px-4 py-4 font-black text-gray-900">Full replacement</td>
                  <td class="px-4 py-4 text-gray-700">$8-20</td>
                  <td class="px-4 py-4 text-gray-700">$4,800-12,000</td>
                  <td class="px-4 py-4 text-gray-700">20-35 yr</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">The Numbers That Matter</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">40-60%</p>
                <p class="text-gray-400 text-xs mt-1">Savings vs full replacement</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">1.5-2"</p>
                <p class="text-gray-400 text-xs mt-1">Standard asphalt overlay thickness</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">600</p>
                <p class="text-gray-400 text-xs mt-1">Sq ft of a typical two-car driveway</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">25%</p>
                <p class="text-gray-400 text-xs mt-1">Cracking above which resurfacing fails</p>
              </div>
            </div>
          </div>

          <p>
            Note that sealcoating is included above only because it is frequently confused with resurfacing. Sealcoating is a thin protective coating that costs a tenth as much and fixes nothing structural — it protects an intact surface, it does not restore a damaged one.
          </p>
        </div>

        <!-- SECTION 2: Should You Resurface or Replace? -->
        <div id="resurface-vs-replace" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Should You Resurface or Replace?
          </h2>

          <p>
            This is the entire decision, and it hinges on one question: is the failure in the surface, or in the base underneath?
          </p>

          <p>
            A driveway is a wearing surface over a compacted aggregate base. Surface problems — oxidation, shallow cracks, minor spalling, faded appearance — are exactly what resurfacing fixes. Base problems — settlement, alligator cracking, potholes that return, drainage failure — will telegraph straight through a new overlay within a season or two, because the overlay does nothing to address what is moving beneath it.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Resurface If You See</h3>
          <p>
            Faded, gray, oxidized asphalt with no structural damage. Cracks under about a quarter inch wide that are isolated rather than interconnected. Surface spalling or scaling on concrete where the underlying slab remains solid. Uneven color or a patchy appearance from past repairs. Total cracked area under roughly 25% of the surface. In these cases resurfacing gives you a driveway that looks and performs as new for a fraction of replacement cost.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Replace If You See</h3>
          <p>
            Alligator cracking — an interconnected web resembling reptile skin — which is the definitive sign the base has failed and can no longer support load. Potholes that return after being patched. Sections that have visibly settled or heaved. Standing water that does not drain within a day. Cracks wider than half an inch, especially if they run the full depth. Concrete slabs with vertical displacement at the joints. Any of these means the base needs excavation and rebuilding, and an overlay is money thrown at a symptom.
          </p>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-amber-800 mb-2">The Alligator Cracking Test</p>
            <p class="text-sm text-amber-700">
              If you see interconnected cracking that looks like scales or a dried lakebed, the base beneath has lost its load-bearing capacity — usually from water intrusion. No overlay fixes this. A contractor who quotes resurfacing over visible alligator cracking without proposing to remove and rebuild those sections is selling you two years of appearance and then the same problem, plus the cost of the failed overlay.
            </p>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Partial Option</h3>
          <p>
            Many driveways are mostly sound with localized base failure — often at the street apron where truck loads concentrate, or a low spot that holds water. The right answer there is full-depth patching of the failed areas, allowing them to cure, then overlaying the whole surface. It costs more than a straight overlay and far less than replacement, and it is the option a good contractor proposes when the situation warrants it.
          </p>
        </div>

        <!-- SECTION 3: Asphalt Driveway Resurfacing Cost in Detail -->
        <div id="asphalt-resurfacing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Asphalt Driveway Resurfacing Cost in Detail
          </h2>

          <p>
            Asphalt resurfacing means laying a new layer of hot-mix asphalt — typically 1.5 to 2 inches compacted — over the cleaned and prepared existing surface.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Line Item</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Cost</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Cleaning and prep</td>
                  <td class="px-4 py-4 text-gray-700">$0.30-0.80/sq ft</td>
                  <td class="px-4 py-4 text-gray-700">Sweeping, vegetation removal, blowing</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Crack filling</td>
                  <td class="px-4 py-4 text-gray-700">$1-4/linear ft</td>
                  <td class="px-4 py-4 text-gray-700">Hot-pour rubberized filler</td>
                </tr>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Full-depth patching</td>
                  <td class="px-4 py-4 text-gray-700">$4-10/sq ft</td>
                  <td class="px-4 py-4 text-gray-700">For localized base failures only</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Tack coat</td>
                  <td class="px-4 py-4 text-gray-700">$0.10-0.25/sq ft</td>
                  <td class="px-4 py-4 text-gray-700">Bonding layer — never skip this</td>
                </tr>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Asphalt overlay, 1.5-2"</td>
                  <td class="px-4 py-4 text-gray-700">$2.50-5/sq ft</td>
                  <td class="px-4 py-4 text-gray-700">Material plus placement and rolling</td>
                </tr>
                <tr class="bg-gray-50">
                  <td class="px-4 py-4 font-black text-gray-900">Milling (if needed)</td>
                  <td class="px-4 py-4 text-gray-700">$1-3/sq ft</td>
                  <td class="px-4 py-4 text-gray-700">Required where height at garage is tight</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Why Thickness Matters More Than Price</h3>
          <p>
            A 1-inch overlay costs less and fails faster. Two inches compacted is the standard for a residential driveway that will see regular vehicle traffic; anything under 1.5 inches struggles to hold up under turning loads and thermal cycling. Get the specified compacted thickness in writing — this is the easiest place for a contractor to save money invisibly, and you cannot measure it after the fact.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Height Problem at the Garage</h3>
          <p>
            Adding two inches of asphalt raises the driveway surface by two inches, which can create problems where the driveway meets a garage floor, a walkway, or a street apron. The solution is milling — grinding down the existing surface at those transitions before overlaying. If your garage threshold is already close to grade, expect milling to appear in the quote, and be suspicious if it does not.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Timing and Cure</h3>
          <p>
            Asphalt overlays are placed in warm weather — most contractors will not lay hot mix below roughly 50°F. You can typically drive on it within 24-48 hours, but it stays soft for several weeks and should not have heavy point loads (motorcycle kickstands, jack stands, trailer tongues) on it during that period. Wait 6-12 months before sealcoating a new overlay so the oils can cure out.
          </p>
        </div>

        <!-- SECTION 4: Concrete Driveway Resurfacing Cost in Detail -->
        <div id="concrete-resurfacing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Concrete Driveway Resurfacing Cost in Detail
          </h2>

          <p>
            Concrete resurfacing uses a polymer-modified cementitious overlay bonded to the existing slab — typically a quarter inch to an inch thick depending on system and finish.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Overlay Type</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per Sq Ft</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Standard resurfacer</td>
                  <td class="px-4 py-4 text-gray-700">$4-7</td>
                  <td class="px-4 py-4 text-gray-700">Restoring worn, scaled surfaces</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Broom or textured finish</td>
                  <td class="px-4 py-4 text-gray-700">$5-9</td>
                  <td class="px-4 py-4 text-gray-700">Slip resistance on slopes</td>
                </tr>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Stamped overlay</td>
                  <td class="px-4 py-4 text-gray-700">$8-18</td>
                  <td class="px-4 py-4 text-gray-700">Decorative stone or brick appearance</td>
                </tr>
                <tr class="bg-gray-50">
                  <td class="px-4 py-4 font-black text-gray-900">Stained and sealed overlay</td>
                  <td class="px-4 py-4 text-gray-700">$9-16</td>
                  <td class="px-4 py-4 text-gray-700">Color and a finished look</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Surface Prep Is Everything</h3>
          <p>
            Concrete overlays fail by delaminating, and delamination is almost always a prep failure. The existing slab must be mechanically profiled — shot blasting, grinding, or aggressive pressure washing depending on the system — to give the overlay something to grip, and it must be free of oil, sealer, and curing compound. Any oil-contaminated area needs degreasing and usually grinding, because overlays do not bond to oil. If a quote does not specify a surface preparation method, ask.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Cracks Telegraph Through</h3>
          <p>
            An existing crack in the slab will reappear in the overlay above it, usually within a year. Good installers address this by routing and filling moving cracks and by honoring existing control joints in the new surface — the overlay gets saw-cut joints directly over the slab's joints. An installer who plans to overlay straight across existing joints is setting up random cracking.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Freeze-Thaw Considerations</h3>
          <p>
            In cold climates, thin overlays are vulnerable to freeze-thaw damage and to de-icing salts, particularly in the first winter. Use a system rated for exterior freeze-thaw exposure, seal it as the manufacturer specifies, and avoid chloride de-icers on a new overlay for at least the first season — sand for traction instead.
          </p>
        </div>

        <!-- SECTION 5: What Drives Your Quote Up or Down -->
        <div id="cost-factors" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What Drives Your Quote Up or Down
          </h2>

          <p>
            Two identical-looking driveways can differ by 50% in quoted price, and the reasons are usually predictable.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Size and Access</h3>
          <p>
            Cost per square foot drops as area increases, because mobilization — getting crew, paver, and roller on site — is a fixed cost spread over the job. A tiny driveway can cost double per foot what a large one does. Access matters too: a driveway a paving machine can reach costs far less than one requiring hand placement because of a narrow gate or a tight turn.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Condition of the Existing Surface</h3>
          <p>
            Every square foot of full-depth patching, every linear foot of crack filling, and any milling required all add up quickly. A driveway needing patching across 15% of its area can cost 40% more to resurface than one needing none.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Drainage Work</h3>
          <p>
            If water pools on the existing driveway, resurfacing without correcting the grade recreates the problem on day one, and standing water is the mechanism that destroys driveways. Correcting a low spot means building up the overlay in that area or, in bad cases, removing and regrading. This can add $500-2,000 and is money well spent.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Season and Regional Rates</h3>
          <p>
            Asphalt prices track oil markets, and both asphalt and concrete crews are busiest in summer. Late spring and early fall often bring better pricing and more attentive crews than the July peak. Winter is not an option for asphalt in cold climates.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Traveling-Crew Warning</h3>
          <p>
            Door-to-door asphalt crews offering a resurfacing deal with "leftover material from a job down the street" are the most persistent scam in this trade. Legitimate contractors do not have leftover hot mix, do not price by the truckload, and do not require a decision on the spot. Get a written quote per square foot with a specified thickness from an established local company with a physical address.
          </p>
        </div>

        <!-- SECTION 6: DIY Driveway Resurfacing: What Is Realistic -->
        <div id="diy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. DIY Driveway Resurfacing: What Is Realistic
          </h2>

          <p>
            The DIY question splits cleanly by material, and the honest answers are quite different.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Asphalt Overlay: Not a DIY Project</h3>
          <p>
            Hot-mix asphalt arrives at roughly 300°F, must be placed and compacted before it cools, and requires a paver and a roller to achieve proper density. Without compaction equipment you get a surface that ravels within a season. Cold-patch products exist for filling potholes, not for overlaying an entire driveway. This one belongs to a contractor.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Concrete Resurfacer: Genuinely DIY-Able</h3>
          <p>
            Bagged polymer-modified concrete resurfacer is designed for homeowner application and costs roughly $0.60-1.50 per square foot in materials — a fraction of professional pricing. It is real work: pressure washing, mixing to a consistent slurry, spreading with a squeegee, and finishing with a broom, all within a working time of about 20 minutes per batch. For a 600 square foot driveway, plan a full weekend with a helper.
          </p>

          <p>
            The two things that determine success are surface prep and working in manageable sections. Clean the slab thoroughly and saturate it so it does not pull water out of the mix, then work section to section between control joints rather than trying to keep a wet edge across the whole driveway. Do it in mild weather — not in direct sun, not above about 85°F, and not with rain forecast within 24 hours.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Sealcoating: Easy and Frequently Sufficient</h3>
          <p>
            If your asphalt driveway is structurally fine and simply looks tired and gray, sealcoating restores appearance and adds protection for roughly $0.15-0.35 per square foot in materials. It is a straightforward DIY job with a squeegee and a couple of days of dry weather, and for many driveways it is genuinely what is needed rather than resurfacing.
          </p>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-amber-800 mb-2">Do Not Sealcoat a Damaged Driveway</p>
            <p class="text-sm text-amber-700">
              Sealcoat is a thin surface film, not a structural repair. Applied over cracks, potholes, or alligator cracking, it hides them briefly and changes nothing. Fill cracks first with a proper hot-pour or rubberized filler, patch potholes, and only then sealcoat an otherwise sound surface.
            </p>
          </div>
        </div>

        <!-- SECTION 7: How to Get and Compare Quotes -->
        <div id="getting-quotes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. How to Get and Compare Quotes
          </h2>

          <p>
            Quotes in this trade are frequently written in a way that makes comparison impossible. Insist on the details that matter.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Require Thickness in Writing</h3>
          <p>
            "Asphalt overlay" is not a specification. Require compacted thickness — 1.5 or 2 inches — stated in the contract. This is the single most common place where a low bid is actually a thinner, shorter-lived driveway, and it is invisible once the work is done.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Get Prep Work Itemized</h3>
          <p>
            Cleaning, crack filling, patching, milling, and tack coat should each appear as separate lines. A quote that lumps everything into a single number cannot be compared against another, and prep is where the real difference in outcomes lies.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Ask What Happens to Drainage</h3>
          <p>
            If water currently pools anywhere on your driveway, ask specifically how the quote addresses it. "The new surface will take care of it" is not an answer. Standing water is what destroys driveways, and an overlay that preserves a low spot has a shortened life built in from day one.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Verify the Contractor Is Local and Insured</h3>
          <p>
            Ask for a physical business address, proof of liability insurance, and references from work done two or more years ago — recent references tell you nothing about durability. Established local contractors are still there when something goes wrong; traveling crews are not.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Get Three Quotes and Ignore Both Extremes</h3>
          <p>
            The very lowest bid usually means thinner material, skipped prep, or a crew that will not be reachable next year. The highest is not automatically the best. Three quotes give you a defensible middle, and any bid far outside the cluster deserves a specific explanation.
          </p>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            8. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to resurface a driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Asphalt overlay runs $3-7 per square foot, putting a typical 600 square foot two-car driveway at $1,800-4,200. Concrete resurfacing runs $4-10 per square foot, or $2,400-6,000 for the same driveway. Decorative stamped overlays cost $8-18 per square foot. Full replacement, by comparison, runs $8-20 per square foot.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is resurfacing a driveway worth it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, when the base underneath is still sound — it delivers a like-new driveway for 40-60% less than replacement, lasting 10-15 years for asphalt and 10-20 for concrete. It is not worth it when you have alligator cracking, settlement, potholes that return, or standing water, because those are base failures that will telegraph straight through a new overlay.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I know if my driveway needs resurfacing or replacing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Look for alligator cracking — an interconnected web resembling reptile skin. That means the base has lost load-bearing capacity and needs excavation, not an overlay. Also replace if you see settlement, heaving, recurring potholes, cracks over half an inch, or water that stands for more than a day. Fading, shallow isolated cracks, and surface spalling are resurfacing candidates.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does driveway resurfacing last?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                An asphalt overlay of proper 1.5-2 inch compacted thickness lasts 10-15 years, and sealcoating every 3-4 years extends that. A concrete overlay lasts 10-20 years depending on the system and climate. Both figures assume the base beneath is sound and drainage is correct; either problem cuts the life dramatically.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you resurface a driveway yourself?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Concrete resurfacer is genuinely DIY-able at roughly $0.60-1.50 per square foot in materials, though it is a full weekend of real work for a two-car driveway. Asphalt overlay is not — hot mix must be placed and compacted at temperature with a paver and roller, and without proper compaction it ravels within a season.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the difference between resurfacing and sealcoating?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Resurfacing adds a new structural wearing layer — typically 1.5-2 inches of asphalt or a quarter-inch-plus concrete overlay — and costs $3-10 per square foot. Sealcoating applies a thin protective film at $0.15-0.35 per square foot; it restores appearance and slows oxidation on an intact surface but repairs nothing structural.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How thick should an asphalt overlay be?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Two inches compacted is the residential standard, with 1.5 inches acceptable for light-duty driveways. Below 1.5 inches an overlay struggles under turning loads and thermal cycling and fails early. Always get compacted thickness stated in the contract, because it cannot be verified after the work is finished.
              </p>
            </div>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Costly Mistakes in Driveway Resurfacing
          </h2>

          <p>
            Resurfacing goes wrong in predictable ways, and nearly all of them are decided before the first truck arrives.
          </p>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Overlaying a Failed Base</h3>
              <p class="text-gray-700 text-sm m-0">
                Alligator cracking, settlement, and recurring potholes mean the base beneath has failed. An overlay placed on top will crack in the same pattern within a season or two, and you will have spent thousands to delay the replacement you needed. Diagnose the base first.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Accepting an Unspecified Thickness</h3>
              <p class="text-gray-700 text-sm m-0">
                A quote that says 'asphalt overlay' without a compacted thickness is a quote that can be met with one inch of material. Two inches is the residential standard. Get the number in the contract, because you cannot measure it once the roller has left.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Ignoring Standing Water</h3>
              <p class="text-gray-700 text-sm m-0">
                Water that pools on the old driveway will pool on the new one unless grade is corrected, and standing water is the single biggest destroyer of both asphalt and concrete. Ask specifically how the quote addresses drainage before you sign.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Hiring a Traveling Crew</h3>
              <p class="text-gray-700 text-sm m-0">
                Door-to-door asphalt crews with 'leftover material from a job down the street' are the most persistent scam in this trade. Legitimate contractors have no leftover hot mix and do not require a decision on the spot. Use an established local company with a physical address and two-year-old references.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealcoating a New Overlay Too Soon</h3>
              <p class="text-gray-700 text-sm m-0">
                A fresh asphalt overlay needs 6-12 months to cure before sealcoating. Sealing too early traps oils in the surface and can leave it soft and prone to scuffing and tracking. Wait a full season.
              </p>
            </div>
          </div>
        </div>

