                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Venting type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">How exhaust leaves</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Combustion air</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Needs power</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical vent pipe</th>
                  </tr>
                </thead>
