---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Top Rated Mattresses",
    "url": "/best-mattress/"
  },
  {
    "title": "Best Mattress for Back Pain",
    "url": "/best-mattress-for-back-pain/"
  },
  {
    "title": "Best Mattress for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattress Toppers",
    "url": "/best-mattress-topper/"
  },
  {
    "title": "Best Mattress Protectors",
    "url": "/best-mattress-protector/"
  },
  {
    "title": "Best Mattress for Heavy People",
    "url": "/best-mattress-for-heavy-people/"
  },
  {
    "title": "Best Mattress for Seniors",
    "url": "/best-mattress-for-seniors/"
  },
  {
    "title": "Mattress Prices and Deals",
    "url": "/mattress-prices-and-deals/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "7 Best Mattress Brands in 2026: Trials, Warranties and Builds";
const description =
  "The best mattress brands sold on Amazon, with one representative model from each and their stated trials, warranties and signature construction compared.";

const PRODUCTS = [
  {
    "id": "nectar-classic-hybrid-12",
    "name": "Nectar Classic Hybrid 12\" Mattress",
    "category": "Brand: Nectar. Hybrid, Memory Foam Over Coils, Medium Firm",
    "badge": "Best Overall Brand",
    "amazonUrl": "#",
    "pros": [
      "Nectar states a 365-night trial, the longest of any brand here",
      "Forever Warranty named in the listing title",
      "Medium-firm feel that suits back and combination sleepers",
      "Memory foam over innerspring coils for bounce and airflow",
      "Nectar runs its own Amazon storefront with every size"
    ],
    "cons": [
      "Returns on Amazon orders can involve both Amazon and Nectar",
      "Memory foam top still sleeps warmer than a grid or latex bed",
      "Some older listings show as unavailable, so check the size you want"
    ],
    "bottomLine": "The brand with the most generous stated policy, and a medium-firm hybrid that suits most sleepers.",
    "description": "Nectar earns the top spot because its policy is the strongest of any brand sold on Amazon. Nectar states a 365-night home trial and a Forever Warranty on its mattresses, and both appear in its Amazon listing titles. For a product you cannot try first, a full year to decide is worth more than any foam claim. Nectar built its name on the all-foam Classic, and the Classic Hybrid is the model we would pick from the range: the same medium-firm memory foam comfort feel over a core of innerspring coils, with a cooling top layer, in a 12-inch profile. The coils are the reason to choose the hybrid over the foam version. They add bounce, make the bed easier to move on, and let more air through, which matters to anyone who finds all-foam beds warm. Medium firm suits most back sleepers and many combination sleepers. The trade-off with any memory foam top is heat and a slower response than latex or a grid, and owners occasionally report that returning an Amazon order means coordinating between the brand and Amazon. Nectar runs an official Amazon storefront, which is the safest place to buy. If you want the softest pressure relief for side sleeping, look at the Casper; if you want the cheapest bed from a reputable brand, look at Zinus."
  },
  {
    "id": "casper-original-hybrid-brand",
    "name": "Casper Original Hybrid Mattress",
    "category": "Brand: Casper. Zoned Foam Over Encased Coils, 11 Inch",
    "badge": "Best for Zoned Support",
    "amazonUrl": "#",
    "pros": [
      "Zoned support: softer under the shoulders, firmer under the hips, per Casper",
      "Encased coils limit motion transfer between partners",
      "Firmer perimeter for sitting on the edge",
      "Casper lists a 100-night trial and a 10-year limited warranty",
      "Sold in every size from twin to California king on Amazon"
    ],
    "cons": [
      "Priced well above budget hybrid brands",
      "Shorter stated trial than Nectar",
      "Listings disagree on medium vs medium firm"
    ],
    "bottomLine": "The original mattress-in-a-box brand, and still the one to choose for zoned support in a hybrid.",
    "description": "Casper is the brand that made the mattress in a box mainstream, and its Original Hybrid is the clearest example of what it does well: zoned support. Casper uses softer foam under the shoulders and firmer foam under the hips, waist and lower back, then puts that over a core of individually encased coils. The zoning is the brand's signature, and it is the reason the Original Hybrid suits both side and back sleepers, because the shoulder can sink while the heavier hips stay level. The encased coils add bounce and airflow and keep a partner's movement from travelling across the bed, and Casper lists a firmer perimeter so the edge holds up when you sit on it. The 11-inch bed is sold in every size on Amazon, with CertiPUR-US certified foams, a 100-night trial and a 10-year limited warranty as Casper states them. The trade-off is price. Casper sits in the premium tier, and you can get pocketed coils for much less from Ashley or Novilla, without the zoning or the brand's support. Its trial is also shorter than Nectar's. Choose Casper if you share a bed, change positions through the night, or want a well-known brand with a long track record; choose Nectar if the length of the trial matters most."
  },
  {
    "id": "purple-plus",
    "name": "Purple Plus Mattress",
    "category": "Brand: Purple. 2\" GelFlex Grid Over Foam, 11 Inch",
    "badge": "Best for Hot Sleepers",
    "amazonUrl": "#",
    "pros": [
      "Patented GelFlex Grid that Purple says does not trap heat",
      "Open grid columns relieve pressure without deep sink",
      "Purple states a 100-night trial and 10-year limited warranty",
      "11-inch Plus adds comfort foam over the original 9.25-inch design",
      "Official Purple storefront on Amazon"
    ],
    "cons": [
      "The grid feel is unlike foam and does not suit everyone",
      "Purple asks for at least 21 nights before a return",
      "Premium pricing across the range"
    ],
    "bottomLine": "The one brand with a genuinely different comfort material, and the strongest choice for people who sleep hot.",
    "description": "Purple is the only brand on this list with its own comfort material. Instead of memory foam, every Purple mattress uses the GelFlex Grid, a patented stretchy polymer formed into more than a thousand open columns. Purple says the columns collapse under the shoulders and hips, stay supportive elsewhere, and leave open channels for air, so the bed does not trap heat the way dense foam can. The Purple Plus is the model we would pick from the range: it keeps the 2-inch grid but builds the bed up to 11 inches with extra comfort foam, so it feels a little softer and fuller than the original 9.25-inch Purple Mattress. Purple describes the Plus as medium. The spec to understand before you buy is the feel. The grid is springy and slightly squishy, with almost no sink, and people tend to love it or not. Purple states a 100-night trial and a 10-year limited warranty, and asks owners to spend at least 21 nights on the mattress before starting a return, which gives the body time to adjust. The trade-off is cost: Purple is a premium brand at every size. If the grid sounds odd but you sleep hot, a hybrid from Casper or Tuft & Needle offers more airflow than foam with a familiar feel. Buy from Purple's official Amazon storefront."
  },
  {
    "id": "tuft-needle-original-hybrid",
    "name": "Tuft & Needle Original Hybrid Mattress",
    "category": "Brand: Tuft & Needle. Adaptive Foam Over Wrapped Coils, 12 Inch",
    "badge": "Best Mid-Price Brand",
    "amazonUrl": "#",
    "pros": [
      "T&N Adaptive foam over individually wrapped coils",
      "Medium feel with more bounce than T&N's all-foam Original",
      "Listed as fiberglass free and CertiPUR-US certified",
      "T&N lists a 100-night trial and a 10-year limited warranty",
      "Simple range: firm foam, medium foam, and this hybrid"
    ],
    "cons": [
      "Less contouring than a memory foam bed",
      "Listings name different manufacturing companies, which can confuse warranty claims",
      "Some versions carry a Legacy label, so check you have the current model"
    ],
    "bottomLine": "A straightforward mid-priced brand with a simple range and a hybrid that balances bounce and cooling.",
    "description": "Tuft & Needle built its name on simplicity: a short range, plain materials and fair prices. The brand's signature is its T&N Adaptive foam, a responsive polyfoam that is infused with graphite and cooling gel and feels bouncier and less sinking than memory foam. The Original Hybrid is the model we would pick. It puts that foam over individually wrapped coils in a 12-inch, six-layer build that T&N describes as medium, and the coils give it more bounce, airflow and edge support than the brand's all-foam Original. The spec that matters is the foam itself. Adaptive foam pushes back quickly, so you sleep on top of the bed rather than in it, which combination sleepers and people who dislike the memory foam hug usually prefer. T&N lists the mattress as fiberglass free, CertiPUR-US certified and covered by a 100-night trial and a 10-year limited warranty. The trade-off is less deep contouring at the shoulder than a memory foam bed, so lighter side sleepers may find it firm. The brand also has a quirk worth knowing: Amazon listings name different manufacturing companies, including Serta Simmons Bedding, and some older versions carry a Legacy label, so check the listing title. If you want a firm all-foam bed instead, T&N's Original Firm is the simpler, cheaper option."
  },
  {
    "id": "serta-sleeptrue-medium-hybrid",
    "name": "Serta Sleeptrue Medium 12\" Hybrid Mattress",
    "category": "Brand: Serta. Foam Over Zoned Wrapped Coils, 12 Inch",
    "badge": "Best Legacy Brand Value",
    "amazonUrl": "#",
    "pros": [
      "Three support zones of individually wrapped coils, per Serta",
      "Medium feel suits back, side and combination sleepers",
      "Serta lists a 100-night trial and a 10-year limited warranty",
      "CertiPUR-US certified foams",
      "Made in the USA with global components, per the listing"
    ],
    "cons": [
      "Serta says to allow up to 72 hours to expand and one to two weeks to air out",
      "Sleeptrue is Serta's online range, not its showroom lines",
      "Fewer owner reviews than the long-running online brands"
    ],
    "bottomLine": "A household-name brand's online hybrid with zoned coils, at a price close to the direct-to-consumer brands.",
    "description": "Serta is one of the oldest mattress brands in the United States, and the Sleeptrue range is how it competes with the online brands: mattresses built for shipping in a box and sold on Amazon at prices close to theirs. The Sleeptrue Medium 12-inch Hybrid is the model we would pick. Serta describes three support zones built from custom, individually wrapped coils under its comfort foams, which is the same idea Casper uses with foam: firmer support under the hips and more give elsewhere. The medium feel suits most back sleepers and many side and combination sleepers. The spec that matters is the zoned coil core, because it is what you are paying a legacy brand for: decades of coil engineering in a bed that costs less than a showroom model. Serta lists a 100-night trial, a 10-year limited warranty, CertiPUR-US certified foams and US manufacture with global components. Serta also states that its boxed beds need up to 72 hours to expand and one to two weeks to air out, so plan around that. The trade-off is that Sleeptrue is a separate online line, not the iMattress or Perfect Sleeper lines you would see in a store, so do not expect the same bed. If you want firm all-foam from Serta, the Sleeptrue Firm 12-inch is in our main top rated mattresses guide."
  },
  {
    "id": "sealy-dreamlife-12-hybrid",
    "name": "Sealy Dreamlife 12\" Hybrid Mattress-in-a-Box",
    "category": "Brand: Sealy. Gel Memory Foam Over Encased Coils, 12 Inch",
    "badge": "Best for Edge Support",
    "amazonUrl": "#",
    "pros": [
      "2-inch SealyComfort gel memory foam over 2.25-inch transition foam, per the listing",
      "SealyResponsive encased coils with dedicated edge coils",
      "Surface-Guard antimicrobial treatment on the cover, per Sealy",
      "Sealy lists a 10-year limited warranty",
      "Medium-firm feel suits back and combination sleepers"
    ],
    "cons": [
      "Heavy, about 80 pounds for a queen per the listing",
      "Trial terms are not stated in the listing, so check before ordering",
      "Sealy's Posturepedic showroom beds are a different product"
    ],
    "bottomLine": "The biggest legacy brand's mattress in a box, with edge coils for people who sit on the side of the bed.",
    "description": "Sealy is among the largest mattress makers in the world, and the Dreamlife range is its line built to ship in a box. The Dreamlife 12-inch Hybrid is the one we would pick. The listing describes 2 inches of SealyComfort gel memory foam over 2.25 inches of SealySupport transition foam, on a core of SealyResponsive encased coils with additional coils around the edge. Sealy rates the feel medium firm. The spec that matters is that edge. Sealy says the advanced edge coils add airflow and durability, and a reinforced perimeter is what lets you sit on the side of the bed to put on shoes without sliding off, and use the whole width of the mattress. That makes it a strong choice for couples who sleep near the edges and for older sleepers who push off from the side to stand. The cover carries Sealy's Surface-Guard antimicrobial treatment, the foams are CertiPUR-US certified, and Sealy lists a 10-year limited warranty. The trade-offs: the queen weighs about 80 pounds, so carry it up the stairs while it is still rolled, and the trial terms are not stated in the listing, so check the seller's return policy first. Do not confuse it with Sealy's Posturepedic beds sold in stores; Dreamlife is a separate line. For a lighter alternative, consider the Serta."
  },
  {
    "id": "zinus-green-tea-cooling-12",
    "name": "Zinus 12 Inch Green Tea Cooling Memory Foam Mattress",
    "category": "Brand: Zinus. Gel and Green Tea Infused Memory Foam, 12 Inch",
    "badge": "Best Budget Brand",
    "amazonUrl": "#",
    "pros": [
      "One of the least expensive brand-name foam beds on Amazon",
      "Gel cooling foam plus green tea infusion, per Zinus",
      "Medium feel suits most guest-room sleepers",
      "Listed as fiberglass free and CertiPUR-US certified",
      "Zinus sells a wide range of frames and foundations to match"
    ],
    "cons": [
      "Lower-density foam is likely to soften sooner than premium brands",
      "Owners commonly report a new-foam smell for several days",
      "Zinus sells several similar Green Tea models, which is easy to mix up"
    ],
    "bottomLine": "The budget brand that made mattresses in a box cheap, and still the one to buy when price comes first.",
    "description": "Zinus is the brand most responsible for cheap mattresses in a box. Its Green Tea memory foam beds have been among Amazon's best-selling mattresses for years, and the brand also sells the frames and foundations that go under them. The Green Tea Cooling 12-inch is the model we would pick from the range, because it adds gel cooling foam to the green tea infused memory foam of the original, for a few dollars more. Zinus describes the feel as medium, and lists the foams as CertiPUR-US certified and the mattress as fiberglass free. The spec that matters at a budget price is the 12-inch thickness: it gives enough foam above the base that most average-weight adults do not feel the bottom, which is the weakness of the thinner versions. The trade-off is durability. Budget brands use lower-density foam, which tends to soften and form body impressions sooner than the foams in Nectar, Casper or Serta beds, so plan on fewer years of use. Owners also commonly report a new-foam smell at unboxing that fades over several days with ventilation. Zinus sells several similar Green Tea models, including Essential and original versions, so check the word Cooling in the title. Buy it for a guest room, a child's room or a first apartment, not as a ten-year main bed."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Mattress Brands",
          item: "https://www.thehonestreviewers.com/best-mattress-brands/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best mattress brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers on Amazon, Nectar is the best mattress brand overall because it states a 365-night trial and a Forever Warranty, and its medium-firm beds suit most sleepers. Casper is the best for zoned support, Purple for hot sleepers, Sealy for edge support, and Zinus for the lowest price. Choose the model by firmness first."
          }
        },
        {
          "@type": "Question",
          "name": "What are the top 5 mattress brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among brands sold on Amazon, five strong choices are Nectar, Casper, Purple, Tuft & Needle and Sealy. Nectar leads on trial length, Casper on zoned support, Purple on cooling, Tuft & Needle on simple mid-priced hybrids and Sealy on edge support. Serta and Zinus are close behind for value. The best of them for you depends on the model."
          }
        },
        {
          "@type": "Question",
          "name": "Are online mattress brands as good as store brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Online brands built the long sleep trial into their business, and many sell hybrids with the same kinds of foam and coils as store beds. Legacy brands like Sealy and Serta now sell boxed lines online too. The main difference is that you cannot try a boxed mattress first, so the trial and return terms matter more."
          }
        },
        {
          "@type": "Question",
          "name": "Which mattress brand has the best warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Of the brands here, Nectar states the strongest warranty, its Forever Warranty, along with a 365-night trial. Casper, Purple, Tuft & Needle, Serta and Sealy list ten-year limited warranties. Read what each covers: most cover defects and sagging beyond a stated depth, and exclude normal softening, stains and damage from an unsupportive base."
          }
        },
        {
          "@type": "Question",
          "name": "Is Zinus a good mattress brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zinus is a good budget brand. Its Green Tea memory foam mattresses are among the most popular on Amazon, list CertiPUR-US certified foam and cost far less than premium brands. The trade-off is lower-density foam that tends to soften sooner, and owners commonly report a new-foam smell at first. It suits guest rooms, kids and first apartments best."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Tuft & Needle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amazon listings for Tuft & Needle mattresses name Serta Simmons Bedding as the manufacturer on some models and Fosbrooke, Inc. doing business as Tuft & Needle on others. In practice the brand still sells its own range with its stated 100-night trial and 10-year limited warranty. Keep your receipt and listing in case you need to make a warranty claim."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a mattress brand on Amazon or direct?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Either can work. Most brands here run official Amazon storefronts, and buying from the brand or Amazon itself usually keeps the brand's trial and warranty. Buying direct can make returns simpler, because only one company is involved. Compare the price, the return process and the seller before ordering, and avoid unauthorized third-party sellers."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Bedroom & Sleep",
    tags: [
      "mattress brands",
      "best mattress brands",
      "top mattress brands",
      "mattress brand comparison"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Mattress Brands</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven brands sold on Amazon, one representative model from each, and the trial, warranty and signature build that set them apart.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#nectar-classic-hybrid-12"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Brands
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Separates the Best Brands</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 7 Best Mattress Brands</a>
          <a href="#online-vs-legacy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Online vs Legacy Brands</a>
          <a href="#trials" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Trials and Warranties Compared</a>
          <a href="#by-sleeper" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Best Brand by Sleep Style</a>
          <a href="#price-tiers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Brand Price Tiers</a>
          <a href="#setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Setting Up a Boxed Mattress</a>
          <a href="#model-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Brand vs Model</a>
          <a href="#buying-amazon" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Buying on Amazon</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most mattress brands buy from the same suppliers. What separates the good ones is the trial they stand behind, the warranty they write, and the one thing each of them builds better than the rest.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-matters" class="scroll-mt-24">
