---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Epoxy Garage Floor Peeling", url: "/epoxy-garage-floor-peeling/" },
    { title: "How to Prepare Concrete for Epoxy", url: "/how-to-prepare-concrete-for-epoxy/" },
    { title: "Best Epoxy Garage Floor Kits", url: "/best-epoxy-garage-floor-kit/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "Can You Apply Epoxy Over Existing Epoxy?";
const description =
  "Recoating old epoxy works if the existing coat is sound and you abrade it properly. The adhesion test that decides it, and when removal is the only honest answer.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Epoxy Over Existing Epoxy", item: "https://www.thehonestreviewers.com/can-you-apply-epoxy-over-existing-epoxy/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you apply epoxy over existing epoxy?",
          acceptedAnswer: { "@type": "Answer", text: "Yes, provided the existing coating is fully bonded to the concrete and you mechanically abrade the surface first. Cured epoxy is glass-smooth and chemically inert, so a new coat has nothing to grip until you scuff it. What you cannot do is coat over epoxy that is peeling, bubbling or lifting anywhere, because the new layer inherits that failure and comes off with it." },
        },
        {
          "@type": "Question",
          name: "How do you know if old epoxy is sound enough to recoat?",
          acceptedAnswer: { "@type": "Answer", text: "Do two tests. First, tap across the floor with a screwdriver handle and listen for hollow spots, which indicate delamination even where the surface looks fine. Second, score an X through the coating with a utility knife, press strong tape hard over it and rip it off — if coating lifts at the cut edges, the bond has failed and recoating will not fix it." },
        },
        {
          "@type": "Question",
          name: "Do you have to sand epoxy before recoating?",
          acceptedAnswer: { "@type": "Answer", text: "You have to abrade it, and sanding is one way. On a garage floor the practical options are a floor buffer with 60 to 80 grit screens, an orbital sander for small areas, or diamond grinding for a heavily glossed floor. The target is a uniformly dull surface with no shine left anywhere — any remaining gloss is a spot where the new coat will not bond." },
        },
        {
          "@type": "Question",
          name: "Can you put a different brand of epoxy over an old one?",
          acceptedAnswer: { "@type": "Answer", text: "Usually, since adhesion depends on mechanical key rather than chemical compatibility once the old coat is fully cured. The real compatibility questions are different: never put a water-based epoxy over a solvent-based one without testing, and never assume a polyaspartic or polyurea topcoat will bond to old epoxy without the manufacturer's guidance. Test a hidden square metre and wait a week." },
        },
        {
          "@type": "Question",
          name: "How long does epoxy over epoxy last?",
          acceptedAnswer: { "@type": "Answer", text: "As long as the weakest layer in the stack, which is the original bond to the concrete. A recoat over a genuinely sound floor performs like a fresh installation and gives five to ten years in a domestic garage. A recoat over a marginal original coat fails when that original coat does, taking your new work with it — which is why the testing matters more than the product." },
        },
        {
          "@type": "Question",
          name: "When should you remove old epoxy instead of coating over it?",
          acceptedAnswer: { "@type": "Answer", text: "When any meaningful area is peeling, hollow-sounding or lifting; when moisture is coming up through the slab; when the floor has had hot tire pickup, which signals a bond that is already marginal; or when the coating has failed twice before. In those cases the problem lies underneath, and adding a layer on top only postpones the same outcome at greater cost." },
        },
        {
          "@type": "Question",
          name: "Can you recoat epoxy without grinding?",
          acceptedAnswer: { "@type": "Answer", text: "Not reliably. Some manufacturers offer a chemical bonding primer for recoats, and those help, but nothing substitutes for a mechanically abraded surface on a floor that will see vehicle tires. Skipping abrasion is the single most common reason a recoat delaminates in the first year, and the failure usually appears as sheets lifting where the tires sit." },
        },
        {
          "@type": "Question",
          name: "How soon can you apply a second coat of epoxy?",
          acceptedAnswer: { "@type": "Answer", text: "During the original installation, within the manufacturer's recoat window — usually 12 to 24 hours, while the first coat is tacky enough to bond chemically. Miss that window and the coat has fully cured, and the recoat becomes the abrasion job described here rather than a simple second coat. Read the recoat window before you start, not after." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Garage Flooring",
    tags: ["epoxy over existing epoxy", "recoat garage floor epoxy", "epoxy garage floor", "garage floor coating"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Epoxy Kits", link: "/best-epoxy-garage-floor-kit/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Compatibility</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">Can You Apply Epoxy Over <span class="text-[#38BDF8]">Existing Epoxy</span>?</h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Yes — if the old coat is genuinely bonded and you take the shine off it properly. Two tests decide which job you actually have.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#tests" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">Run the Tests First</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="8.4k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Answer</a>
          <a href="#tests" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Two Tests That Decide It</a>
          <a href="#recoat-window" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Recoat Window You Missed</a>
          <a href="#abrasion" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Abrasion Is the Whole Job</a>
          <a href="#process" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The Full Process</a>
          <a href="#compatibility" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Product Compatibility</a>
          <a href="#when-remove" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When to Remove Instead</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Cured epoxy is one of the least welcoming surfaces in a garage. It is glass-smooth, chemically inert and specifically engineered to reject anything that lands on it. That is exactly what you paid for, and it is exactly the problem when you want to add another coat.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. The Short Answer</h2>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Verdict</p>
            <p class="text-xl font-bold text-white mb-3">Yes, if the existing coating is fully bonded everywhere and you mechanically abrade every square inch of it. No, if any meaningful area is peeling, hollow or lifting.</p>
            <p class="text-gray-300 leading-relaxed m-0">A recoat is only as good as the layer beneath it. Coating over a floor whose original bond has failed does not repair anything — it adds an expensive new layer to something already on its way off the slab.</p>
          </div>

          <p>
            Recoating is genuinely the right call more often than not. A garage floor coated eight years ago that has simply worn thin in the tire tracks, gone dull, or picked up scuffs and stains is a good candidate, and recoating costs a fraction of removal and reinstallation while giving comparable service life.
          </p>

          <p>
            What makes this decision go wrong is that the two situations look similar from standing height. A worn floor and a floor whose bond is quietly failing both read as "tired epoxy" until you get down on your knees and test. The tests take twenty minutes and they are the entire difference between a good weekend and a wasted one.
          </p>
        </div>

        <div id="tests" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Two Tests That Decide It</h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Sounding Test</h3>
          <p>
            Tap steadily across the whole floor with the handle of a screwdriver or a small hammer, listening rather than looking. A well-bonded coating gives a solid, dead tap. A delaminated area gives a distinctly hollow, drummy note — and it does so well before anything is visible on the surface.
          </p>
          <p>
            Work a grid so you cover everything, paying particular attention to where the car's tires sit, along the edges of the slab, and around any control joints. Mark hollow areas with chalk as you find them. If they add up to more than a few small patches, you are looking at a removal job rather than a recoat.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Cross-Hatch Tape Test</h3>
          <p>
            In an inconspicuous corner, cut an X through the coating down to the concrete with a sharp utility knife. Press a strip of strong packing tape hard over the cut, run a thumbnail along it to ensure full contact, and rip it off sharply at an angle.
          </p>
          <p>
            Coating that stays put means the bond is sound. Coating that lifts along the cut edges — or comes away in flakes on the tape — means the original installation is holding on by very little, and any new layer will simply add weight to a failure already in progress. Repeat the test in two or three separate areas, because bond quality often varies across a floor depending on how well the concrete was prepared in each part.
          </p>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-amber-800 mb-2">Check for Moisture Before Anything Else</p>
            <p class="text-sm text-amber-700">
              If the original coating failed, moisture rising through the slab is the most likely reason, and it will defeat a recoat exactly as it defeated the first attempt. Tape a two-foot square of plastic sheet to the floor, seal all four edges, and leave it 24 to 72 hours. Condensation underneath means vapour transmission, and that has to be addressed before any coating goes down. The method is in <a href="/epoxy-garage-floor-moisture-test/" class="text-amber-900 underline">the epoxy moisture test guide</a>.
            </p>
          </div>
        </div>

        <div id="recoat-window" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. The Recoat Window You Probably Missed</h2>

          <p>
            There is a version of this question with a much easier answer, and it applies only during the original installation. Most epoxies specify a recoat window — commonly 12 to 24 hours — during which the first coat is cured enough to walk on but still chemically active enough to bond with the next one. Coat inside that window and the two layers cross-link into what is effectively one coating.
          </p>

          <p>
            Miss it, and the chemistry closes. A fully cured epoxy has no reactive sites left at its surface, so the only bond available to a new coat is mechanical — physically keying into a roughened surface. That is the situation almost everyone reading this is in, and it is why abrasion stops being optional.
          </p>

          <p>
            The practical lesson for next time is to read the recoat window before starting rather than after, and to plan the whole installation around it. A two-coat system applied inside its window is a fundamentally stronger floor than the same two coats applied a year apart. Our guide to <a href="/how-to-apply-garage-floor-epoxy/">applying garage floor epoxy</a> works through that timing.
          </p>
        </div>

        <div id="abrasion" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Abrasion Is the Whole Job</h2>

          <p>
            On a recoat, ninety percent of the outcome is decided before you open the resin. The goal is simple to state and tedious to achieve: a uniformly dull surface with no gloss remaining anywhere.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Method</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Floor buffer with sanding screens</td>
                    <td class="px-4 py-4 text-gray-700">Whole garage, 60-80 grit</td>
                    <td class="px-4 py-4 text-gray-700">Rental, fastest for open floor area</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Diamond grinder</td>
                    <td class="px-4 py-4 text-gray-700">Heavy gloss or thick coatings</td>
                    <td class="px-4 py-4 text-gray-700">Most thorough; dust extraction essential</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orbital sander, 60-80 grit</td>
                    <td class="px-4 py-4 text-gray-700">Edges, corners, small garages</td>
                    <td class="px-4 py-4 text-gray-700">Slow across a full floor but precise</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Acid etching</td>
                    <td class="px-4 py-4 text-gray-700">Bare concrete only</td>
                    <td class="px-4 py-4 text-gray-700">Does nothing to cured epoxy — skip it</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            That last row matters because acid etching is so strongly associated with epoxy preparation that people reach for it reflexively. Etching works by reacting with the alkaline cement paste in bare concrete. Cured epoxy is not concrete, does not react, and comes out of the process exactly as glossy as it went in. The comparison in full is in <a href="/acid-etching-vs-grinding-garage-floor/">acid etching versus grinding</a>.
          </p>

          <p>
            The test for adequate abrasion is visual and unforgiving: look across the floor at a low angle with a light behind you. Any area still throwing a reflection has not been abraded, and that area is where your new coating will let go first. Edges, corners and the strip along the garage door are where this is habitually missed, because the buffer will not reach them and nobody enjoys doing them by hand.
          </p>
        </div>

        <div id="process" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. The Full Process</h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Degrease Before You Abrade</h3>
          <p>
            Oil and grease on the surface get driven into the abrasion scratches if you sand first, which contaminates exactly the surface you are trying to prepare. Degrease thoroughly with a dedicated concrete degreaser, rinse and let it dry, and treat any deep oil spots individually. Hot tire marks and rubber transfer need attention here too.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Repair Failures First</h3>
          <p>
            Cut out and remove any hollow or peeling areas back to a sound, well-adhered edge, feathering the perimeter so there is no step. Fill low spots and any exposed damaged concrete with a compatible patching compound and let it cure fully. A recoat cannot bridge a defect; it can only follow the surface it is given.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Abrade Everything, Then Vacuum Twice</h3>
          <p>
            Work the whole floor to a uniform dull finish, hand-sanding the perimeter and corners. Then vacuum, wipe with a damp microfibre or a solvent recommended by the manufacturer, and vacuum again. Epoxy dust is fine, clings, and will sit between your two layers as a release agent if any is left behind.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Test a Square Metre and Wait a Week</h3>
          <p>
            Coat a metre square in a corner, let it cure for a full seven days, then attack it — cross-hatch it, tape it, drag something heavy across it, park on it if the area allows. A week of patience here is worth considerably more than any amount of confidence about the product.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Coat Thin, and Respect the Cure</h3>
          <p>
            Apply at the manufacturer's stated coverage rate rather than generously. On a recoat you are building total film thickness on top of an existing layer, and thick stacks are more prone to cracking and to hot tire pickup. Then keep vehicles off for the full cure period — usually five to seven days, not the 24 to 48 hours that make it walkable. Driving on a green coating is a leading cause of <a href="/hot-tire-pickup-epoxy-garage-floor/">hot tire pickup</a>.
          </p>
        </div>

        <div id="compatibility" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Product Compatibility</h2>

          <p>
            Once the old coating is fully cured and properly abraded, adhesion is mechanical, so brand-to-brand recoating generally works. The compatibility questions that genuinely matter are narrower than most people assume.
          </p>

          <p>
            <strong>Water-based over solvent-based</strong> is the pairing to be careful with. Solvent-based epoxies can leave a surface that water-based products struggle to wet out properly, producing fisheyes and poor flow. Test it rather than assume it.
          </p>

          <p>
            <strong>Polyaspartic or polyurea over old epoxy</strong> is common and often excellent — these are the fastest-curing and most abrasion-resistant topcoats available — but they are also less forgiving of preparation. Follow the manufacturer's guidance specifically for recoating over cured epoxy, and do not improvise. The differences are covered in <a href="/epoxy-vs-polyaspartic-garage-floor/">epoxy versus polyaspartic</a> and <a href="/epoxy-vs-polyurea-garage-floor-coating/">epoxy versus polyurea</a>.
          </p>

          <p>
            <strong>Epoxy over garage floor paint</strong> is a different question entirely, and usually a worse one, because most floor paints form a much weaker film than epoxy and become the weak link in the stack. That case is covered in <a href="/can-you-epoxy-over-a-painted-garage-floor/">can you epoxy over a painted garage floor</a>.
          </p>

          <p>
            One practical note on appearance: a recoat over a coloured or flaked floor will shift the look. A clear topcoat deepens the existing colour and restores gloss; a new pigmented coat covers the old colour but may telegraph the texture of any flake underneath. If the aim is a specific finished look rather than protection, test the actual combination on your actual floor.
          </p>
        </div>

        <div id="when-remove" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. When Removal Is the Only Honest Answer</h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Peeling or lifting over any real area.</strong> The bond has failed, and a new layer inherits the failure rather than fixing it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Widespread hollow sounding.</strong> Delamination you cannot see yet is still delamination, and it will surface within a year of recoating.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Moisture coming through the slab.</strong> Vapour pressure lifts coatings from below, and no amount of surface preparation addresses it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Existing hot tire pickup.</strong> Tires lifting the coating means the bond is already marginal at the points of greatest stress.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Two previous failures.</strong> At that point the slab itself is telling you something, and a third attempt on the same basis is optimism rather than a plan.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Total film already very thick.</strong> Stacked coatings crack and chip more readily; at some point taking it back to concrete is the sounder engineering.</span>
            </li>
          </ul>

          <p>
            Removal means diamond grinding or shot blasting back to sound concrete, which is genuinely a bigger job — but it is a bigger job you do once, rather than a smaller one you do repeatedly. <a href="/epoxy-garage-floor-peeling/">Why epoxy garage floors peel</a> covers diagnosing the underlying cause so the next installation is the last one.
          </p>
        </div>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">8. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Coating Over Gloss</h3>
              <p class="text-gray-700 text-sm m-0">Cured epoxy is inert and smooth, and a new coat has nothing to grip. Any patch still throwing a reflection after abrasion is where the recoat lets go first — usually within a year, usually where the tires sit. Check at a low angle with a light behind you.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Acid Etching an Epoxy Floor</h3>
              <p class="text-gray-700 text-sm m-0">Etching reacts with cement paste in bare concrete. Cured epoxy is not concrete and does not react, so the floor comes out just as glossy and you have added moisture to the job. Abrade mechanically or not at all.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Recoating Over Failing Areas</h3>
              <p class="text-gray-700 text-sm m-0">Hollow or peeling patches do not stabilise under a new layer; they take the new layer with them. Cut them out to a sound edge and feather the perimeter before anything else, and if they are widespread, remove the whole coating instead.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sanding Before Degreasing</h3>
              <p class="text-gray-700 text-sm m-0">Abrading an oily surface drives contamination into the scratches you just created, which is precisely the surface the new coating has to bond to. Degrease first, rinse, dry, then abrade.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Parking on It Too Soon</h3>
              <p class="text-gray-700 text-sm m-0">Walkable at 24 to 48 hours is not cured. Vehicles need five to seven days off a fresh coat, and warm tires on a green surface are the classic route to hot tire pickup — on a recoat, that failure takes both layers.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you apply epoxy over existing epoxy?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes, if the existing coating is fully bonded and you mechanically abrade it first. Cured epoxy is glass-smooth and inert, so a new coat has nothing to grip until it is scuffed. You cannot coat over epoxy that is peeling or lifting — the new layer inherits that failure.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you know if old epoxy is sound?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Two tests. Tap across the floor with a screwdriver handle listening for hollow spots, which show delamination before it is visible. Then cut an X through the coating, press strong tape over it and rip it off — coating lifting at the cut edges means the bond has failed.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do you have to sand epoxy before recoating?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">You have to abrade it, and sanding is one way — a floor buffer with 60 to 80 grit screens, an orbital sander for edges, or diamond grinding for heavy gloss. The target is a uniformly dull surface. Any remaining shine is where the new coat will not bond.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you use a different brand?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Usually, since adhesion is mechanical once the old coat has cured. The real questions are narrower: test before putting water-based over solvent-based, and follow manufacturer guidance for polyaspartic or polyurea over old epoxy. Test a square metre and wait a week.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does epoxy over epoxy last?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">As long as the weakest layer — which is the original bond to the concrete. Over a genuinely sound floor a recoat performs like a fresh installation, giving five to ten years domestically. Over a marginal original coat it fails when that does.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">When should you remove instead?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">When any real area is peeling or hollow, when moisture is rising through the slab, when the floor has had hot tire pickup, or when a coating has failed twice. In those cases the problem is underneath, and another layer only postpones it at greater cost.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you recoat without grinding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Not reliably. Some manufacturers offer chemical bonding primers for recoats and they help, but nothing substitutes for mechanical abrasion on a floor that sees vehicle tires. Skipping it is the leading cause of a recoat delaminating in its first year.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How soon can you apply a second coat?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">During the original install, inside the recoat window — usually 12 to 24 hours, while the first coat can still bond chemically. Miss that and the coat is fully cured, so the job becomes the abrasion process described here. Read the window before starting.</p>
            </div>
          </div>
        </div>

