const title = "6 Best Battery Backup Sump Pumps for Power Outages and Pump Failures";
const description =
  "Six backup sump pumps compared on flow at real head, switches and monitoring, with runtime math, AGM vs lithium, and when a water-powered backup is the better buy.";

const PRODUCTS = [
