---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Washing Vinyl Siding", url: "/how-to-pressure-wash-vinyl-siding/" },
    { title: "Nozzle Colors Explained", url: "/pressure-washer-nozzle-colors-explained/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "What Not to Pressure Wash: 15 Things to Avoid";
const description =
  "Roof shingles, AC fins, electrical fittings, old mortar and lead paint: the surfaces where the damage costs more than the machine did.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Not to Pressure Wash",
          item: "https://www.thehonestreviewers.com/what-not-to-pressure-wash/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What should you never pressure wash?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Roof shingles, lead paint predating 1978, electrical fittings and outlets, AC condenser fins, old or soft mortar, windows with old glazing, stucco and EIFS, and asphalt shingle siding. On all of these, no pressure setting is the correct setting and the damage costs more than the cleaning was worth.",
          },
        },
        {
          "@type": "Question",
          name: "Can I pressure wash my roof?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Asphalt shingles carry mineral granules that provide their UV protection and most of their service life, and pressure strips them permanently. The damage is invisible from the ground, so the only sign is a roof that fails years early. Use a low-pressure chemical roof treatment instead.",
          },
        },
        {
          "@type": "Question",
          name: "Can you pressure wash composite decking?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many manufacturers allow it at a low maximum pressure with a wide tip, and exceeding that figure voids the warranty and scars the surface permanently, since composite cannot be sanded like timber. Look up the specific figure for your product rather than assuming a general number.",
          },
        },
        {
          "@type": "Question",
          name: "Is it safe to pressure wash windows?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not directly. A stream forces water past seals and old glazing putty, which lets water into the frame and the wall. Rinse from several feet with a 40 degree tip if you must, keep the stream off the frame junctions entirely, and hand wash the glass itself.",
          },
        },
        {
          "@type": "Question",
          name: "Can I pressure wash my air conditioner?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a garden hose instead. Condenser fins are thin aluminium that flattens under pressure, and flattened fins reduce airflow and cooling efficiency permanently. Turn the unit off at the disconnect and spray from the inside of the coil outward so debris exits the way it entered.",
          },
        },
        {
          "@type": "Question",
          name: "What is soft washing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Applying cleaning chemistry at roughly garden hose pressure and letting it do the work, then rinsing gently. It is what professionals use on roofs, stucco, old masonry and anything fragile. On organic growth it works better than pressure, because algae and mildew are killed rather than knocked off.",
          },
        },
        {
          "@type": "Question",
          name: "Can a pressure washer really injure you?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, seriously. A stream at even 1,500 PSI can cut skin, and the wound is not a normal cut: it injects water, dirt and detergent beneath the surface, causing infection and tissue damage far beyond its apparent size. Any pressure washer laceration should be treated as urgent.",
          },
        },
        {
          "@type": "Question",
          name: "Can I pressure wash a bicycle or motorcycle?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is best avoided. Water goes straight past hub, bottom bracket and headset seals and washes out the grease, so the machine looks immaculate while the bearings run dry. A garden hose and a brush cleans just as well without shortening the life of every bearing on the bike.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "what not to pressure wash",
      "pressure washer damage",
      "pressure washing safety",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Safety
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          What Not to <span class="text-[#38BDF8]">Pressure Wash</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A pressure washer finds weaknesses rather than working around them. On most of this list the damage is invisible on the day and expensive by the following spring.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#never"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the List
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="15.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#never" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Never List</a>
          <a href="#wood-and-soft" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Wood and Paint</a>
          <a href="#building-envelope" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Building Envelope</a>
          <a href="#masonry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Older Masonry</a>
          <a href="#vehicles-and-machinery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Vehicles and Machinery</a>
          <a href="#people-and-pets" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. People and Plants</a>
          <a href="#soft-washing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Soft Washing</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Pressure washing assumes an intact surface. Where the surface is already compromised, by failing paint, soft mortar, loose boards or bad flashing, pressurised water finds the weakness instead of cleaning around it.
        </p>

        <div id="never" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Never List
          </h2>

          <p>
            These are the surfaces where no pressure setting is the right setting. Every one produces damage that costs more to repair than the cleaning was worth.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What Happens</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Do This Instead</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Roof shingles</td>
                    <td class="px-4 py-4 text-gray-700">Strips protective mineral granules permanently</td>
                    <td class="px-4 py-4 text-gray-700">Low-pressure chemical roof treatment</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lead paint, pre-1978</td>
                    <td class="px-4 py-4 text-gray-700">Disperses lead chips and dust across the site</td>
                    <td class="px-4 py-4 text-gray-700">Lead-safe removal practices</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Electrical fittings and outlets</td>
                    <td class="px-4 py-4 text-gray-700">Forces water past weatherproofing</td>
                    <td class="px-4 py-4 text-gray-700">Cover, and turn off the circuit</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC condenser fins</td>
                    <td class="px-4 py-4 text-gray-700">Flattens fins and cuts efficiency</td>
                    <td class="px-4 py-4 text-gray-700">Garden hose from the inside out</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Old or soft mortar</td>
                    <td class="px-4 py-4 text-gray-700">Washes the joints out of the wall</td>
                    <td class="px-4 py-4 text-gray-700">Soft wash with chemistry only</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Windows and old glazing</td>
                    <td class="px-4 py-4 text-gray-700">Forces water past seals and putty</td>
                    <td class="px-4 py-4 text-gray-700">Hand wash, or rinse from a distance</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Asphalt shingle siding</td>
                    <td class="px-4 py-4 text-gray-700">Same granule loss as a roof</td>
                    <td class="px-4 py-4 text-gray-700">Soft wash</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stucco and EIFS</td>
                    <td class="px-4 py-4 text-gray-700">Chips and drives water into the system</td>
                    <td class="px-4 py-4 text-gray-700">Low-pressure soft wash</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Roof, Specifically</p>
            <p class="text-xl font-bold text-white mb-3">The damage is invisible from the ground and permanent.</p>
            <p class="text-gray-300 leading-relaxed m-0">Asphalt shingles carry a layer of mineral granules that provide UV protection and most of their service life. Pressure strips them, and you cannot see the result standing on the lawn. The roof simply ages faster from that day, and the failure arrives years early. Roof cleaning is a low-pressure chemical job, and it is a different job from washing a house.</p>
          </div>
        </div>

        <div id="wood-and-soft" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Wood, Paint and Soft Materials
          </h2>

          <p>
            These can be pressure washed, carefully, and they are where most avoidable damage actually happens because the surface looks robust and is not.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Peeling or failing paint strips in sheets, which turns a cleaning job into a scraping and repainting job.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Wood decking furs and raises the grain above 1,800 PSI or wherever the wand pauses, and only sanding fixes it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Cedar and other soft timbers mark far more easily than pressure-treated pine at the same setting.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Composite decking scars and voids its warranty on many products, so check the manufacturer figure first.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Painted wood siding lifts at edges and seams, especially where the paint is already tired.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Aluminium siding dents and chalks, and once the finish is chalked it cannot be restored by washing.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Outdoor fabric, cushions and shade sails delaminate and tear at surprisingly low pressure.</span>
            </li>
          </ul>

          <p>
            The composite decking point catches people out most often. It looks like a hard, maintenance-free surface, and many manufacturers specify a low maximum pressure with a wide tip, above which the warranty is void. Look up the figure for your product rather than assuming, because they vary widely.
          </p>

          <p>
            On any wood, the technique matters as much as the number. Keep the wand moving in steady overlapping passes, work with the grain, and let a deck cleaner do the chemical work first. Our guide to <a href="/best-deck-cleaner/">deck cleaners</a> covers the products that make low pressure sufficient.
          </p>
        </div>

        <div id="building-envelope" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Anywhere Water Can Get Into the Building
          </h2>

          <p>
            This is the category that produces the most expensive repairs, because none of it shows on the day. Water driven into a wall has nowhere to dry, and the consequences appear months later as damp, mould or rot.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never spray upward under lap siding. The overlap sheds rain from above and offers no protection against a jet from below.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never drive water into soffit vents, which open directly into the roof space.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not spray at window and door trim junctions, where flashing and sealant are the only barrier.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Avoid utility penetrations: dryer vents, cable entries, hose bib escutcheons, meter boxes.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not wash over loose or cracked siding boards, which are simply holes in the envelope.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep away from gutter joints and seams, which separate under a directed stream.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not spray into weep holes on brick, which exist to let water out rather than in.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Delayed Failure</p>
            <p class="text-xl font-bold text-white mb-3">Nothing looks wrong when you pack the machine away.</p>
            <p class="text-gray-300 leading-relaxed m-0">That is precisely why this mistake gets repeated. Water forced behind siding soaks sheathing and insulation, and the wall has no way to dry out. The visible result, a damp patch inside or a soft board outside, arrives a season or two later, by which time nobody connects it to an afternoon of washing. Keep the stream angled downward or level on any vertical surface.</p>
          </div>
        </div>

        <div id="masonry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Masonry That Is Older Than It Looks
          </h2>

          <p>
            Brick, stone and pavers all tolerate real pressure. What sits between them frequently does not, and the joints are what hold the structure together.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">The Vulnerable Part</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Warning Sign</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brick wall</td>
                    <td class="px-4 py-4 text-gray-700">The mortar joints</td>
                    <td class="px-4 py-4 text-gray-700">Sand or grit in the runoff</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete pavers</td>
                    <td class="px-4 py-4 text-gray-700">Joint sand, polymeric or otherwise</td>
                    <td class="px-4 py-4 text-gray-700">Sand appearing between the pavers</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Natural stone paving</td>
                    <td class="px-4 py-4 text-gray-700">Pointing and the stone face itself</td>
                    <td class="px-4 py-4 text-gray-700">Fine particles washing off</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stamped concrete</td>
                    <td class="px-4 py-4 text-gray-700">The sealer and colour layer</td>
                    <td class="px-4 py-4 text-gray-700">Patchy dull areas appearing</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Spalling concrete</td>
                    <td class="px-4 py-4 text-gray-700">The already-failing surface</td>
                    <td class="px-4 py-4 text-gray-700">Flakes lifting as you work</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Historic or lime mortar</td>
                    <td class="px-4 py-4 text-gray-700">Everything</td>
                    <td class="px-4 py-4 text-gray-700">Do not use pressure at all</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Retaining wall blocks</td>
                    <td class="px-4 py-4 text-gray-700">The sand and the drainage behind</td>
                    <td class="px-4 py-4 text-gray-700">Water running out of the joints</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The warning sign column is the useful one. In every case the material tells you before the damage is serious, and stopping at that point costs nothing. Sand in the runoff on a paver patio means you are washing out the joints, and continuing means re-sanding the whole area afterwards.
          </p>

          <p>
            If you do wash out paver joints, that is a repair rather than a disaster, and it is worth doing properly. Our guides to <a href="/how-to-use-polymeric-sand/">using polymeric sand</a> and <a href="/why-is-my-polymeric-sand-washing-out/">why polymeric sand washes out</a> cover the reinstatement.
          </p>
        </div>

        <div id="vehicles-and-machinery" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Vehicles, Machinery and Equipment
          </h2>

          <p>
            Cars can be pressure washed safely, and there are specific parts of them that cannot. The same applies to garden machinery and outdoor equipment.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Engine bays are weatherproof against rain, not a directed jet. Water in connectors, sensors and modules causes intermittent faults that are miserable to diagnose.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Radiator and condenser fins flatten under pressure, and a flattened fin is lost cooling capacity.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Existing stone chips and peeling lacquer will lift further, because the stream gets under the edge.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Badges, trim strips and wraps are held on with adhesive that a jet will find the edge of.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Wheel bearings, CV boots and suspension bushes should not be blasted at close range.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Lawnmower and generator engines have air filters, ignition components and bearings that dislike direct water.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Bicycle and motorcycle bearings and seals are easily driven past, which shortens their life considerably.</span>
            </li>
          </ul>

          <p>
            For bicycles in particular the standard advice among mechanics is a hose rather than a pressure washer, because the water goes straight past hub, bottom bracket and headset seals and washes the grease out. The bike looks immaculate and the bearings are dry, and the second thing is the expensive one.
          </p>

          <p>
            Where a car is concerned, the safe approach is well established: under 1,500 PSI with a 40 degree tip, two to three feet back, foam and dwell time rather than force. Our guide to <a href="/how-to-pressure-wash-a-car/">washing a car properly</a> covers the whole method.
          </p>
        </div>

        <div id="people-and-pets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. People, Pets and Plants
          </h2>

          <p>
            Worth stating plainly, because the risk here is routinely underestimated on electric machines specifically.
          </p>

          <p>
            Electric machines are gentler than gas, not harmless. A stream at even 1,500 PSI can cut skin, and a pressure washer laceration injects water and debris under the surface, which is why these injuries are treated far more seriously in an emergency department than they look. They can require surgical cleaning.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never point a wand at anyone, and never hold a hand in front of the nozzle to check flow.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Wear eye protection and closed-toe shoes; debris comes back off the surface at speed.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the trigger locked when repositioning, and keep children and pets well clear of the work area.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never wash a pet with a pressure washer, at any setting, including a power cleaner.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pre-wet plants and shrubs before using any detergent, and rinse them thoroughly afterwards.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never operate from a ladder; the recoil is exactly the force that causes falls.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Watch your footing, because the surface you are cleaning becomes slippery as you clean it.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Injury People Do Not Expect</p>
            <p class="text-xl font-bold text-white mb-3">A pressure washer cut is not a normal cut.</p>
            <p class="text-gray-300 leading-relaxed m-0">The stream injects water, dirt and whatever detergent you were using beneath the skin, where it causes infection and tissue damage out of all proportion to the size of the wound. Medical guidance is to treat any pressure washer laceration as urgent rather than minor, even when it looks trivial. That is the reason for the trigger lock and the eye protection, not excessive caution.</p>
          </div>
        </div>

        <div id="soft-washing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Soft Washing: What to Do Instead
          </h2>

          <p>
            Most items on this list still need cleaning. The alternative is not leaving them dirty; it is soft washing, which is what professionals use on anything fragile.
          </p>

          <p>
            Soft washing means applying cleaning chemistry at roughly garden hose pressure and letting it do all the work, then rinsing gently. It is slower and it removes organic growth more thoroughly than pressure does, because algae and mildew die chemically rather than being knocked off.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Soft Wash Approach</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Roof shingles</td>
                    <td class="px-4 py-4 text-gray-700">Dedicated roof treatment, applied low pressure, rinsed gently</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stucco and EIFS</td>
                    <td class="px-4 py-4 text-gray-700">House wash solution, dwell, gentle rinse</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Old brick and soft mortar</td>
                    <td class="px-4 py-4 text-gray-700">Masonry cleaner, soft brush, gentle rinse</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Painted wood siding</td>
                    <td class="px-4 py-4 text-gray-700">House wash, dwell, rinse at 1,200-1,500 PSI with a 40&deg; tip</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Composite decking</td>
                    <td class="px-4 py-4 text-gray-700">Deck cleaner and a brush, minimal pressure</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Windows and frames</td>
                    <td class="px-4 py-4 text-gray-700">Hand wash, or rinse from several feet with a wide tip</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC condenser</td>
                    <td class="px-4 py-4 text-gray-700">Garden hose, spraying from the inside outward</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The AC entry is worth a note, because it is a job people do want to do. Condenser fins are thin aluminium and flatten under any real pressure, and flattened fins reduce airflow and cooling efficiency permanently. Use a garden hose, spray from the inside of the coil outward so debris exits the way it came in, and turn the unit off at the disconnect first.
          </p>

          <p>
            The general principle holds across this whole list: chemistry plus dwell time removes organic soiling better than force, and it does it without finding the weaknesses in what you are cleaning. Our guide to <a href="/how-to-use-detergent-in-a-pressure-washer/">using detergent properly</a> covers how to apply it through the machine you already own.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Washing the Roof While You Are Up There Anyway</h3>
              <p class="text-gray-700 text-sm m-0">
                Asphalt shingles carry mineral granules that provide UV protection and most of their service life, and pressure strips them permanently. You cannot see the damage from the ground; the roof simply ages faster from that day. Roof cleaning is a low-pressure chemical job and a completely different task.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Spraying Upward Under Siding Laps</h3>
              <p class="text-gray-700 text-sm m-0">
                Lap siding overlaps downward to shed rain and offers no defence against a jet from below. Water forced behind the boards soaks sheathing and insulation with no way to dry, and the damp or rot appears a season or two later, when nobody connects it to the washing.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Cleaning an AC Unit With the Pressure Washer</h3>
              <p class="text-gray-700 text-sm m-0">
                Condenser fins are thin aluminium and flatten under any real pressure, which permanently reduces airflow and cooling efficiency. Turn the unit off at the disconnect and use a garden hose, spraying from the inside of the coil outward so debris leaves the way it came in.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming Composite Decking Is Indestructible</h3>
              <p class="text-gray-700 text-sm m-0">
                It looks like a hard maintenance-free surface and many manufacturers specify a low maximum pressure with a wide tip, above which the warranty is void. Scarring is permanent and cannot be sanded out the way timber can. Look up the figure for your specific product before you start.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Treating a Pressure Washer Cut as Minor</h3>
              <p class="text-gray-700 text-sm m-0">
                The stream injects water, dirt and detergent beneath the skin, causing infection and tissue damage far out of proportion to the size of the wound. Medical guidance is to treat any pressure washer laceration as urgent even when it looks trivial, which is why the trigger lock matters.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What should you never pressure wash?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Roof shingles, lead paint predating 1978, electrical fittings and outlets, AC condenser fins, old or soft mortar, windows with old glazing, stucco and EIFS, and asphalt shingle siding. On all of these, no pressure setting is the correct setting and the damage costs more than the cleaning was worth.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I pressure wash my roof?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Asphalt shingles carry mineral granules that provide their UV protection and most of their service life, and pressure strips them permanently. The damage is invisible from the ground, so the only sign is a roof that fails years early. Use a low-pressure chemical roof treatment instead.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you pressure wash composite decking?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Many manufacturers allow it at a low maximum pressure with a wide tip, and exceeding that figure voids the warranty and scars the surface permanently, since composite cannot be sanded like timber. Look up the specific figure for your product rather than assuming a general number.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is it safe to pressure wash windows?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Not directly. A stream forces water past seals and old glazing putty, which lets water into the frame and the wall. Rinse from several feet with a 40 degree tip if you must, keep the stream off the frame junctions entirely, and hand wash the glass itself.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I pressure wash my air conditioner?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Use a garden hose instead. Condenser fins are thin aluminium that flattens under pressure, and flattened fins reduce airflow and cooling efficiency permanently. Turn the unit off at the disconnect and spray from the inside of the coil outward so debris exits the way it entered.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is soft washing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Applying cleaning chemistry at roughly garden hose pressure and letting it do the work, then rinsing gently. It is what professionals use on roofs, stucco, old masonry and anything fragile. On organic growth it works better than pressure, because algae and mildew are killed rather than knocked off.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can a pressure washer really injure you?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, seriously. A stream at even 1,500 PSI can cut skin, and the wound is not a normal cut: it injects water, dirt and detergent beneath the surface, causing infection and tissue damage far beyond its apparent size. Any pressure washer laceration should be treated as urgent.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I pressure wash a bicycle or motorcycle?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is best avoided. Water goes straight past hub, bottom bracket and headset seals and washes out the grease, so the machine looks immaculate while the bearings run dry. A garden hose and a brush cleans just as well without shortening the life of every bearing on the bike.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Pressure Washer Guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/best-electric-pressure-washer/" class="bg-gray-50 border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow no-underline group">
