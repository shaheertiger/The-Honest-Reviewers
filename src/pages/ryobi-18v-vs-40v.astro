    tags: [
      "ryobi 18v vs 40v",
      "ryobi one+ vs 40v",
      "which ryobi platform",
      "ryobi 40v worth it",
      "ryobi battery platform choice"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Tested Ryobi ONE+ Tools",
    link: "/best-ryobi-one-plus-tools/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
