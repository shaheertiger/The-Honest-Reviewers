        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-residential-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Residential Means</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 6 Best, Ranked</a>
          <a href="#decks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Stamped vs Fabricated</a>
          <a href="#transmissions" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Transmissions Explained</a>
          <a href="#acreage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Matching 1-4 Acres</a>
          <a href="#hills" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Hills</a>
          <a href="#comfort" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Seats and Suspension</a>
          <a href="#prices" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. What $500 Buys</a>
          <a href="#buying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Where to Buy</a>
          <a href="#fit" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Gates and Storage</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
        </nav>
