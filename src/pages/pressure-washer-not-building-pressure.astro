---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Water Supply Requirements", url: "/pressure-washer-water-supply-requirements/" },
    { title: "PSI vs GPM Explained", url: "/pressure-washer-psi-vs-gpm/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "Pressure Washer Not Building Pressure: How to Fix It";
const description =
  "Weak or pulsing pressure is nearly always the water supply, not the pump. The diagnostic order that solves most cases in under five minutes.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Not Building Pressure",
          item: "https://www.thehonestreviewers.com/pressure-washer-not-building-pressure/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why is my pressure washer not building pressure?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nearly always the water supply. Check four things in order: that the spigot is fully open, that the hose is 5/8 or 3/4 inch and short, that nothing is kinked, and that the inlet screen is clean. Those account for the large majority of cases and all are free to fix.",
          },
        },
        {
          "@type": "Question",
          name: "Why is my pressure washer pulsing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The pump is drawing air along with water because the supply cannot deliver the volume it needs. That is cavitation, and it erodes seals and valves while you keep working, so stop and fix the supply rather than pushing through. It is the most informative symptom in the category.",
          },
        },
        {
          "@type": "Question",
          name: "Where is the inlet screen on a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In the water inlet fitting where the garden hose connects. It is a small mesh filter, usually removable with needle-nose pliers or a hook. Rinse it from the clean side outward, hold it up to the light to confirm it is clear, and refit it the right way round.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my pressure washer lose power after 20 minutes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "That is heat fade on a universal motor rather than a pump fault. Those motors run hot by design and output drops as they heat-soak, recovering after a break. If pressure is strong at the start of every session, the pump is fine and the motor simply needs to cool.",
          },
        },
        {
          "@type": "Question",
          name: "How do I get air out of my pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Leave the water connected and fully open, switch the motor off, remove the nozzle, then squeeze and hold the trigger until water flows completely steadily. Give it thirty seconds or more on a long hose. Only then switch the motor on with the trigger still held.",
          },
        },
        {
          "@type": "Question",
          name: "Can a garden hose cause low pressure?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Frequently. A long or narrow hose throttles the supply, and the pump cannot ask for more than it is given. Use 5/8 or 3/4 inch, no longer than about 25 feet. Expandable and coiled hoses often have a narrow bore, so test one before relying on it.",
          },
        },
        {
          "@type": "Question",
          name: "Can a worn nozzle cause low pressure?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Orifices erode over years of use and widen gradually, which drops pressure slowly enough that nobody notices until it is significant. A partly blocked tip does the same thing faster. Testing with a different nozzle is the quickest way to isolate it.",
          },
        },
        {
          "@type": "Question",
          name: "Is a pressure washer pump worth repairing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On most consumer electric machines, no. The pump is not sold as a serviceable part and replacing it costs close to a new machine. Genuine pump damage usually shows as low pressure that does not respond to any supply change, often with a leak or a rougher running noise.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "pressure washer not building pressure",
      "pressure washer low pressure",
      "pressure washer pulsing",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Troubleshooting
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Pressure Washer Not <span class="text-[#38BDF8]">Building Pressure</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most machines replaced for weak pressure were not broken. Four checks on the water side resolve the large majority of cases, and all of them are free.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#first-four"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            Start Diagnosing
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="19.7k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#first-four" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The First Four</a>
          <a href="#symptoms" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Reading the Symptom</a>
          <a href="#nozzles" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Nozzle Problems</a>
          <a href="#air-lock" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Air in the System</a>
          <a href="#bypass" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Bypass Damage</a>
          <a href="#full-sequence" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Full Sequence</a>
          <a href="#prevention" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Prevention</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Electric pressure washer pumps almost always misbehave for reasons unrelated to the electrical side. Work the water supply first, in order, before you conclude anything is wrong with the machine.
        </p>

        <div id="first-four" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The First Four Checks
          </h2>

          <p>
            Do these in this order every time. Between them they account for most low-pressure complaints, they take about two minutes, and none of them costs anything.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Check</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What to Look For</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why It Matters</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1. The spigot</td>
                    <td class="px-4 py-4 text-gray-700">Is it opened all the way?</td>
                    <td class="px-4 py-4 text-gray-700">A partly open tap starves the pump invisibly</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2. The hose</td>
                    <td class="px-4 py-4 text-gray-700">Bore and length</td>
                    <td class="px-4 py-4 text-gray-700">Long or narrow hose throttles the supply</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">3. Kinks</td>
                    <td class="px-4 py-4 text-gray-700">Anywhere along the supply hose</td>
                    <td class="px-4 py-4 text-gray-700">A kink stops flow instantly, not gradually</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">4. The inlet screen</td>
                    <td class="px-4 py-4 text-gray-700">Pull it and hold it to the light</td>
                    <td class="px-4 py-4 text-gray-700">Clogs gradually with no other symptom</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Use a 5/8-inch or 3/4-inch garden hose no longer than about 25 feet, connected to a spigot opened all the way. That single sentence prevents most water-side problems, and getting it wrong is the most common cause of the symptoms people bring to this question.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Screen Nobody Knows About</p>
            <p class="text-xl font-bold text-white mb-3">There is a filter at the water inlet, and it is probably blocked.</p>
            <p class="text-gray-300 leading-relaxed m-0">A small screen sits in the inlet fitting to catch grit before it reaches the pump, and it clogs gradually over a season with sediment and hose debris. A partially blocked screen starves the pump with no symptom other than reduced pressure, which owners almost always blame on the machine wearing out. Pull it with pliers, rinse it from the clean side, and hold it to the light.</p>
          </div>
        </div>

        <div id="symptoms" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Reading the Symptom
          </h2>

          <p>
            The exact behaviour narrows the cause considerably, and distinguishing these three is most of the diagnosis.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Symptom</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Most Likely Cause</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pulsing or surging pressure</td>
                    <td class="px-4 py-4 text-gray-700">Starved supply: spigot, hose, kink or screen</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weak but steady pressure</td>
                    <td class="px-4 py-4 text-gray-700">Wrong nozzle, worn nozzle, or a partly blocked tip</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure fades partway through a long session</td>
                    <td class="px-4 py-4 text-gray-700">A hot universal motor, not the pump</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">No pressure at all, water trickles out</td>
                    <td class="px-4 py-4 text-gray-700">Air in the system, or a badly blocked inlet</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure fine, then drops suddenly</td>
                    <td class="px-4 py-4 text-gray-700">A kink that just formed, or a tip blockage</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Leaking at a fitting</td>
                    <td class="px-4 py-4 text-gray-700">Loose connection or a failed O-ring</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weak since it came out of winter storage</td>
                    <td class="px-4 py-4 text-gray-700">Freeze damage, or old detergent in the system</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Pulsing is the most informative symptom, because it points almost exclusively at supply. When the supply cannot deliver the volume the pump wants, the pump draws air along with water. That is cavitation, and it erodes seals and valves rapidly, so a pulsing machine should be stopped and diagnosed rather than worked through.
          </p>

          <p>
            Fade during a long session is the one that is not a fault at all. Universal motors run hot by design, and output drops as they heat-soak, recovering after a break. If the pressure is fine at the start of every session and poor twenty minutes in, that is the motor rather than the pump. Our guide to <a href="/induction-vs-universal-motor-pressure-washer/">induction versus universal motors</a> explains why.
          </p>
        </div>

        <div id="nozzles" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Nozzle Problems That Look Like Pump Problems
          </h2>

          <p>
            Once the supply checks out, the nozzle is the next place to look, and it is responsible for a surprising share of weak-pressure complaints.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The wrong tip is fitted. The black soap nozzle is a low-pressure tip by design, and it is very easy to leave on after applying detergent.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A wider tip is fitted than you think. A 40 degree white tip is meant to feel gentle, and it will feel like a failure if you were expecting 25 degrees.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The tip is partly blocked. Grit or mineral deposit narrows the orifice, which reduces flow and produces an uneven pattern.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The tip is worn. Orifices erode over years of use, widening and dropping pressure gradually enough that nobody notices.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The quick-connect is not fully seated, which can leak or hold the tip in a partly engaged position.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The tip is the wrong size for the machine. Nozzles are sized to flow rating, and an oversized one drops pressure.</span>
            </li>
          </ul>

          <p>
            Clear a blocked tip with the wire tool supplied with most machines, or a paperclip, working from the outlet side. Then flush it by running the wand without the nozzle briefly, which pushes any remaining debris out rather than back in.
          </p>

          <p>
            Testing with a different nozzle is the fastest way to isolate this. If a green tip produces strong pressure and a white one feels weak, nothing is wrong. If every tip is weak, the problem is upstream. Our <a href="/pressure-washer-nozzle-colors-explained/">nozzle guide</a> covers what each tip should actually feel like.
          </p>
        </div>

        <div id="air-lock" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Air in the System
          </h2>

          <p>
            A machine that produces almost nothing, or that surges violently from the first pull of the trigger, is frequently air-locked rather than faulty. It is the most common problem on the first use of the season.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Switch the machine off and leave the water supply connected and fully open.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Squeeze the trigger and hold it. Let water run through the wand until the flow is completely steady and free of spitting.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Remove the nozzle while doing this, which lets air escape far more easily.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Give it thirty seconds or more. Long hoses take longer to purge than people expect.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Only then switch the motor on, with the trigger still held.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check every connection for a loose fitting, which will keep drawing air in no matter how long you purge.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Never Start It Dry</p>
            <p class="text-xl font-bold text-white mb-3">Water on first, air purged, motor last. Every time.</p>
            <p class="text-gray-300 leading-relaxed m-0">Pump seals rely on water for lubrication and cooling, so running dry damages them even briefly. Connect the hose, open the spigot fully, purge air through the wand until the flow is steady, and only then switch on. This is both the fix for an air lock and the habit that prevents most of the pump wear that leads to genuine low pressure years later.</p>
          </div>
        </div>

        <div id="bypass" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Damage You May Already Have Done
          </h2>

          <p>
            If the supply is right, the nozzle is right and the system is purged, the next question is whether the pump has been damaged by how the machine has been used.
          </p>

          <p>
            Running in bypass is the leading cause of pump failure across every kind of pressure washer. With the motor on and the trigger released, water circulates inside the pump with nowhere to go and heats up quickly. Sustained bypass cooks the seals, and the damage is cumulative rather than sudden.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A Total Stop System shuts the machine off automatically when you release the trigger, which removes the risk entirely.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Without one, switch off during any pause longer than a minute rather than leaving it running.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Cavitation from a starved supply causes the same kind of erosion by a different route.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Freeze damage cracks the pump housing outright, and usually shows as a leak as well as low pressure.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Grit reaching the pump through a torn or missing inlet screen scores the internals over time.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>None of these are repairable on most consumer machines, since the pump is not a serviceable part.</span>
            </li>
          </ul>

          <p>
            A machine with genuine pump damage typically shows low pressure that does not improve with any supply change, often with a leak or a rougher running noise. At that point the honest answer on most consumer electric machines is replacement, because the pump costs close to a new unit. Our <a href="/best-electric-pressure-washer/">electric pressure washer guide</a> covers what to look for, including which machines have a Total Stop System.
          </p>
        </div>

        <div id="full-sequence" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. The Full Diagnostic Sequence
          </h2>

          <p>
            Work down this list and stop when the pressure comes back. It is ordered by how likely each cause is and how cheap it is to check.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Open the spigot fully. Confirm it, do not assume it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check the supply hose bore and length: 5/8 or 3/4 inch, ideally no more than 25 feet.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Walk the hose looking for kinks, including behind you and under the machine.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pull the inlet screen, rinse it from the clean side, hold it to the light, and refit it the right way round.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Run the bucket test: if the tap takes more than two and a half minutes to fill five gallons, it may not feed the machine.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check which nozzle is fitted, and try a different one to compare.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Clear the nozzle orifice with the wire tool, working from the outlet side.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Purge air with the motor off, nozzle removed, trigger held until the flow is steady.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check every fitting and O-ring for leaks, which draw air in as well as letting water out.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Consider whether the symptom is heat fade on a universal motor rather than a pressure fault.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Only then conclude the pump is damaged.</span>
            </li>
          </ul>

          <p>
            The bucket test is the one that settles arguments. Time how long the spigot takes to fill a five-gallon bucket, using the hose you actually use, with the tap fully open. Two and a half minutes is roughly 2 GPM. If the supply cannot deliver what the machine is rated to move, no machine will perform properly on that tap. Our guide to <a href="/pressure-washer-water-supply-requirements/">water supply requirements</a> covers the figures.
          </p>

          <p>
            Note how far down the list the pump appears. That ordering reflects what actually goes wrong: this is a water-supply category with an electrical component, not the other way round, and most machines sent to landfill for weak pressure had a blocked screen or a half-open tap.
          </p>
        </div>

        <div id="prevention" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Keeping It From Coming Back
          </h2>

          <p>
            Every cause above has a habit that prevents it, and none of them take real time.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Habit</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Prevents</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Spigot fully open, short wide hose</td>
                    <td class="px-4 py-4 text-gray-700">Cavitation and pulsing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rinse the inlet screen a few times a season</td>
                    <td class="px-4 py-4 text-gray-700">Gradual unexplained pressure loss</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Water on and air purged before the motor</td>
                    <td class="px-4 py-4 text-gray-700">Seal damage from dry running</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Switch off rather than idle in bypass</td>
                    <td class="px-4 py-4 text-gray-700">The leading cause of pump failure</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flush detergent through after each use</td>
                    <td class="px-4 py-4 text-gray-700">A blocked injector and soap system</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pump antifreeze before winter</td>
                    <td class="px-4 py-4 text-gray-700">A cracked pump, which ends the machine</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Store nozzles together and check them</td>
                    <td class="px-4 py-4 text-gray-700">Blocked and worn tips going unnoticed</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The winter item is the one that ends machines rather than merely annoying you. Water left in the pump over a freeze cracks the housing, and on most consumer machines the pump is not economically replaceable. If a machine comes out of storage weak or leaking, that is very often the cause. Our <a href="/how-to-winterize-a-pressure-washer/">winterizing guide</a> covers the ten-minute routine.
          </p>

          <p>
            And if you are diagnosing a machine that has never performed well since new, check the specification against your expectations before chasing a fault. A 2,300 PSI machine moving 1.2 GPM produces fewer cleaning units than a 2,030 PSI machine moving 1.76 GPM, so a disappointing machine may be working perfectly. Our guide to <a href="/pressure-washer-psi-vs-gpm/">PSI versus GPM</a> works through that arithmetic.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming the Pump Has Failed</h3>
              <p class="text-gray-700 text-sm m-0">
                It is the last item on the diagnostic list for a reason. A partly open spigot, a narrow or kinked hose, and a clogged inlet screen account for most low-pressure complaints, and all three are free to fix. Plenty of working machines are replaced every year for a blocked screen.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Working Through a Pulsing Machine</h3>
              <p class="text-gray-700 text-sm m-0">
                Pulsing means the pump is drawing air along with water, which is cavitation, and it erodes seals and valves while you continue. It is the one symptom that gets worse the longer you ignore it. Stop, fix the supply, and only then carry on with the job.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting the Black Soap Nozzle Is Still Fitted</h3>
              <p class="text-gray-700 text-sm m-0">
                It is a low-pressure tip by design, and leaving it on after applying detergent produces exactly the symptoms of a failing machine. Swapping to a different tip takes five seconds and is the fastest way to rule the nozzle in or out before investigating anything else.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Mistaking Motor Heat Fade for a Pump Fault</h3>
              <p class="text-gray-700 text-sm m-0">
                Pressure that is fine at the start of each session and poor twenty minutes in is a hot universal motor, not a pump problem. It recovers after a break, which is the tell. Diagnosing it as a pump fault leads people to replace a machine that only needed a rest.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Starting the Motor Before the Water</h3>
              <p class="text-gray-700 text-sm m-0">
                Pump seals rely on water for lubrication and cooling, so dry running damages them even briefly, and it also traps air that produces exactly the surging you are trying to fix. Connect, open the spigot fully, purge through the wand until steady, then switch on.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why is my pressure washer not building pressure?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Nearly always the water supply. Check four things in order: that the spigot is fully open, that the hose is 5/8 or 3/4 inch and short, that nothing is kinked, and that the inlet screen is clean. Those account for the large majority of cases and all are free to fix.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why is my pressure washer pulsing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The pump is drawing air along with water because the supply cannot deliver the volume it needs. That is cavitation, and it erodes seals and valves while you keep working, so stop and fix the supply rather than pushing through. It is the most informative symptom in the category.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Where is the inlet screen on a pressure washer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                In the water inlet fitting where the garden hose connects. It is a small mesh filter, usually removable with needle-nose pliers or a hook. Rinse it from the clean side outward, hold it up to the light to confirm it is clear, and refit it the right way round.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does my pressure washer lose power after 20 minutes?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                That is heat fade on a universal motor rather than a pump fault. Those motors run hot by design and output drops as they heat-soak, recovering after a break. If pressure is strong at the start of every session, the pump is fine and the motor simply needs to cool.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I get air out of my pressure washer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Leave the water connected and fully open, switch the motor off, remove the nozzle, then squeeze and hold the trigger until water flows completely steadily. Give it thirty seconds or more on a long hose. Only then switch the motor on with the trigger still held.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can a garden hose cause low pressure?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Frequently. A long or narrow hose throttles the supply, and the pump cannot ask for more than it is given. Use 5/8 or 3/4 inch, no longer than about 25 feet. Expandable and coiled hoses often have a narrow bore, so test one before relying on it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can a worn nozzle cause low pressure?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes. Orifices erode over years of use and widen gradually, which drops pressure slowly enough that nobody notices until it is significant. A partly blocked tip does the same thing faster. Testing with a different nozzle is the quickest way to isolate it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is a pressure washer pump worth repairing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                On most consumer electric machines, no. The pump is not sold as a serviceable part and replacing it costs close to a new machine. Genuine pump damage usually shows as low pressure that does not respond to any supply change, often with a leak or a rougher running noise.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Pressure Washer Guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
