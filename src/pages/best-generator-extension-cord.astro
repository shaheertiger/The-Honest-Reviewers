---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Generator Extension Cord Size",
    "url": "/generator-extension-cord-size/"
  },
  {
    "title": "Best Generator Inlet Boxes",
    "url": "/best-generator-inlet-box/"
  },
  {
    "title": "Best Manual Transfer Switches",
    "url": "/best-manual-transfer-switch/"
  },
  {
    "title": "How to Hook Up a Generator to Your House",
    "url": "/how-to-hook-up-a-generator-to-your-house/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Generator Cords in 2026: L14-30, TT-30 and 50 Amp, Matched to Your Outlet";
const description =
  "The best generator cord for your home: L14-30 vs TT-30 vs 50 amp cords, 10 gauge vs 12 gauge, the right length for safety and voltage drop, and inlet box cords vs splitter cords, with picks from Champion, PlugSaf, RVGUARD, CircleCord and Iron Forge Cable.";

const PRODUCTS = [
  {
    "id": "champion-25ft-l14-30-transfer-switch-cord",
    "name": "Champion Power Equipment 25-Foot 30-Amp 250-Volt Generator Power Cord (L14-30P to L14-30R)",
    "category": "L14-30P to L14-30R, 10-Gauge SJTW, 25 ft, 250V",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "L14-30 at both ends: the standard 30-amp inlet and transfer switch cord",
      "10-gauge wire for the full 30-amp rating",
      "25 feet keeps the generator out of the CO danger zone near the house",
      "Weather-resistant SJTW insulation stays flexible in heat and cold, per the listing",
      "1-year limited warranty and free lifetime technical support"
    ],
    "cons": [
      "SJTW jacket is lighter than an STW cord",
      "25 feet only; no shorter or longer versions in this listing",
      "No lighted ends or storage strap"
    ],
    "bottomLine": "The best generator cord for most homes: a 25-foot, 10-gauge L14-30 cord from a major generator maker, made to feed an inlet box or manual transfer switch.",
    "description": "Most homeowners who connect a portable generator to the house do it through a 30-amp L14-30 inlet box or manual transfer switch, and this is the cord that job calls for. Champion's listing describes a 25-foot, 30-amp cord with an L14-30P plug on one end and an L14-30R connector on the other, built from 10-gauge wire rated for 250-volt use and wrapped in service-grade, abrasion- and weather-resistant SJTW insulation that stays flexible in extreme temperatures. The spec that matters is the combination of 10 gauge and 25 feet. Ten-gauge copper is what a 30-amp, 240-volt circuit needs, and 25 feet is the sweet spot for most houses: long enough to keep the generator well away from doors, windows and vents, where carbon monoxide becomes the real danger, and short enough to keep voltage drop small. Coming from Champion, one of the largest portable generator makers, it also matches the L14-30R outlet on most of its 7,000 to 9,000 watt models and those from other brands. The trade-offs: SJTW is a lighter jacket than STW, the listing offers only one length, and there are no lighted ends. Buy the PlugSaf 50-foot cord instead if your inlet is far from a safe generator spot, or the RVGUARD 10-foot cord if it is close."
  },
  {
    "id": "plugsaf-50ft-l14-30-stw",
    "name": "PlugSaf 50FT 30 Amp Generator Cord 4 Prong (L14-30P/L14-30R, 10AWG STW)",
    "category": "L14-30P to L14-30R, 10 AWG STW, 50 ft, 125/250V, ETL Listed",
    "badge": "Best Long L14-30 Cord",
    "amazonUrl": "#",
    "pros": [
      "50 feet of 10 AWG for inlets far from a safe generator spot",
      "STW jacket, a heavier service rating than SJTW",
      "IP65 waterproof rating and weather resistance, per the listing",
      "Twist-lock plug with strain relief at both ends",
      "ETL listed; also sold in 10 and 25-foot lengths"
    ],
    "cons": [
      "Heavy and bulky to coil at 50 feet",
      "Longer cords add voltage drop under heavy loads",
      "Lesser-known brand than Champion or Generac"
    ],
    "bottomLine": "A 50-foot, STW-jacketed L14-30 cord for homes where the inlet box is far from the only safe place to run the generator.",
    "description": "Not every house has a safe generator spot close to the inlet box. Townhouses, homes with small side yards and houses with the electrical panel on the wrong wall often need the generator farther away, and that is where the PlugSaf 50-foot cord fits. Its listing describes a 50-foot, 4-prong 30-amp cord with NEMA L14-30P to L14-30R twist-lock ends, 10 AWG conductors and an STW jacket rated 125/250 volts and 3,750/7,500 watts, ETL listed. The spec that matters is the jacket as much as the length. STW is a service-grade jacket rated for 600 volts with thicker insulation than the junior-service SJTW cords most generator cords use, which helps a long cord that will be dragged across gravel and left out in rain. PlugSaf lists an IP65 waterproof rating and weather resistance in sunlight, rain and low temperatures, plus a twist-lock plug with strain relief at both ends. The trade-offs come with the length. Fifty feet of 10-gauge cord is heavy to coil, and every extra foot adds voltage drop, which matters when the generator is near its full output. It is also a smaller brand than Champion. Buy the Champion 25-foot cord instead if 25 feet reaches a safe spot, and see our sizing guide before going longer than 50 feet."
  },
  {
    "id": "rvguard-10ft-l14-30-sjtw",
    "name": "RVGUARD 4 Prong 30 Amp 10 Foot Generator Extension Cord (L14-30P/L14-30R, 10 Gauge SJTW)",
    "category": "L14-30P to L14-30R, 10 Gauge SJTW, 10 ft, 125/250V up to 7,500W, ETL Listed",
    "badge": "Best Short Cord",
    "amazonUrl": "#",
    "pros": [
      "10 feet: minimal voltage drop and easy to handle",
      "10-gauge pure copper conductors, per the listing",
      "Twist-lock plug and strain relief resist pulling loose",
      "Storage bag and cord organizer with carry handle included",
      "ETL listed"
    ],
    "cons": [
      "Too short for most houses unless the inlet is on a safe wall",
      "SJTW jacket rather than STW",
      "Short length tempts people to run the generator too close to the house"
    ],
    "bottomLine": "A short, tidy L14-30 cord for inlet boxes mounted on a wall where the generator can sit safely nearby, and a good spare.",
    "description": "Some houses have the inlet box mounted on a detached wall, a fence post or a garage away from windows and doors, so the generator can sit close to it safely. For those, a 10-foot cord is easier to handle and store than a 25-foot one, and the RVGUARD is a well-made example. The listing describes a 10-foot, 4-prong 30-amp cord with NEMA L14-30P and L14-30R twist-lock ends, 10-gauge SJTW cable rated 125/250 volts and up to 7,500 watts, ETL listed. RVGUARD lists pure copper conductors, a twist-lock plug and strain relief so the cord does not pull out, and an all-weather, water-resistant jacket. A colorful storage bag and cord organizer with a carrying handle are included, which keeps the cord together with the generator in the garage. The spec that matters is the length, in both directions. Ten feet keeps voltage drop negligible, but it also means the generator sits within 10 feet of the inlet. If the inlet is on the house wall next to a window or door, that is too close; the CDC recommends running generators at least 20 feet from the house. The trade-offs are that limitation and an SJTW jacket instead of STW. Buy the Champion 25-foot cord instead if your inlet is on an occupied wall."
  },
  {
    "id": "champion-25ft-l14-30-duplex-splitter",
    "name": "Champion Power Equipment 25-Foot 30-Amp 125/250-Volt Duplex-Style Generator Extension Cord (L14-30P to four 5-20R)",
    "category": "Splitter: L14-30P to Four 5-20R Outlets, 10-Gauge, 25 ft, Dust Covers",
    "badge": "Best Splitter Cord",
    "amazonUrl": "#",
    "pros": [
      "Turns the generator's 30-amp locking outlet into four 20-amp household outlets",
      "10-gauge wire over 25 feet, per the listing",
      "Dust covers protect the outlets when not in use",
      "One heavy cord crosses the yard instead of several thin ones",
      "1-year limited warranty and free lifetime technical support"
    ],
    "cons": [
      "Not for an inlet box or transfer switch: appliances only",
      "Outlet box must be kept dry and off wet ground",
      "No 240-volt outlet at the far end"
    ],
    "bottomLine": "The best way to run several appliances from a generator without a transfer switch: one heavy cord out, four household outlets at the far end.",
    "description": "If you do not have a transfer switch or inlet box, the alternative is running appliances directly from the generator on extension cords. The usual mess is four thin cords snaking from the generator into the house. Champion's duplex-style cord solves that. The listing describes a 25-foot, 30-amp, 125/250-volt cord with an L14-30P plug that converts the generator's locking outlet to four 20-amp household outlets (5-20R) at the far end, using cold- and heat-resistant 10-gauge wire with service-grade, weather-resistant insulation and dust covers for the outlets. The spec that matters is the L14-30 plug feeding household outlets. It draws from the generator's largest outlet, which carries far more power than a single 20-amp outlet on the panel, then splits it close to where you need it, so the refrigerator, freezer, a lamp and a phone charger can each have their own outlet through one heavy cord. Shorter, lighter cords then run from the box into the house. The trade-offs: it cannot feed an inlet box or transfer switch, the outlet end must stay dry and off wet ground, and there is no 240-volt outlet for a well pump. Champion also sells a fan-style version and an L5-30 version for 120-volt generators. Buy the Champion L14-30 cord instead if you have an inlet box."
  },
  {
    "id": "circlecord-50a-50ft-14-50-ss2-50",
    "name": "CircleCord UL Listed 50 Amp 50 Feet RV/Generator Cord (14-50P to SS2-50R, 6/3+8/1 STW)",
    "category": "50 Amp: 14-50P to SS2-50R Twist Lock, 6/3+8/1 Gauge STW, 50 ft, 125/250V, UL Listed",
    "badge": "Best 50 Amp Generator Cord",
    "amazonUrl": "#",
    "pros": [
      "Full 50-amp rating: 12,500 watts at 250 volts, per the listing",
      "6/3+8/1 gauge pure copper conductors",
      "UL listed, with a heavy-duty flame-retardant, UV-resistant PVC jacket",
      "SS2-50R twist-locking connector matches common 50-amp inlet boxes",
      "90-degree right-angle plug reduces stress at the generator"
    ],
    "cons": [
      "Only works with a generator that has a 14-50R outlet",
      "Heavy and stiff at 6 gauge and 50 feet",
      "Overkill if your generator tops out around 7,500 watts"
    ],
    "bottomLine": "A UL listed, 6-gauge 50-amp cord for large generators with a 14-50 outlet feeding a 50-amp inlet box.",
    "description": "Large portable generators in the 10,000 to 15,000 watt class often carry a 14-50R outlet, and to use all of that power at the house you need a 50-amp cord and a 50-amp inlet box. The CircleCord is a solid version. Its listing describes a 50-foot cord with a 14-50P plug and an SS2-50R twist-locking connector, built from 6/3+8/1 gauge pure copper STW cable and rated 50 amps, 6,250 watts at 125 volts and 12,500 watts at 250 volts. It is UL listed, with a heavy-duty, flame-retardant, heat- and UV-resistant PVC jacket, and the plug has a 90-degree right angle to reduce stress where it meets the generator. The spec that matters is the conductor size. A 50-amp circuit needs 6-gauge conductors, and this cord uses three 6-gauge wires plus an 8-gauge ground, which is what carries a large generator's full output without overheating. The SS2-50R connector is the twist-lock style found on many 50-amp generator inlet boxes, so check that yours matches before ordering. The trade-offs are weight and stiffness, especially in cold weather, and the fact that it only makes sense with a generator that has a 14-50R outlet. Buy the Champion L14-30 cord instead if your generator's largest outlet is an L14-30."
  },
  {
    "id": "plugsaf-25ft-tt-30-10awg",
    "name": "PlugSaf 25 FT 30 Amp NEMA TT-30P/R RV Extension Cord (10AWG STW)",
    "category": "TT-30P to TT-30R, 10 AWG STW, 25 ft, 125V 3,750W, ETL Listed",
    "badge": "Best TT-30 Cord",
    "amazonUrl": "#",
    "pros": [
      "Matches the TT-30R outlet on many inverter and RV-ready generators",
      "10 AWG STW cable for the full 30-amp, 125-volt rating",
      "Ergonomic grip handle for plugging and unplugging",
      "IP65 waterproof rating and cold resistance, per the listing",
      "Cord organizer included; ETL listed"
    ],
    "cons": [
      "120 volts only: will not feed a 240-volt L14-30 inlet",
      "Not a twist-lock connection",
      "Primarily an RV cord, so check the fit for home use"
    ],
    "bottomLine": "A heavy 25-foot TT-30 cord for running an RV, or a 30-amp splitter, from an inverter generator's RV outlet.",
    "description": "Many inverter generators and RV-ready portables have a TT-30R outlet, the 30-amp, 120-volt RV plug, rather than an L14-30. If yours does, this PlugSaf cord extends it. The listing describes a 25-foot, 3-prong cord with a NEMA TT-30P plug and a TT-30R socket, 10 AWG STW cable rated 125 volts, 30 amps and 3,750 watts, ETL and cETL listed. PlugSaf lists an IP65 waterproof rating, weather resistance in sunlight, rain and cold, an ergonomic grip handle and an adjustable cord organizer. The spec that matters is the voltage. TT-30 is a 120-volt connection, so this cord carries up to 3,750 watts on a single leg. That is fine for an RV, a camper or a 30-amp splitter, but it cannot feed a standard 240-volt L14-30 inlet box or a well pump. Ten-gauge STW cable is the correct size for 30 amps at 25 feet, and the STW jacket is heavier than the SJTW used on many generator cords. The trade-offs: it is 120 volts only, the plug is a straight-blade connection that can be pulled loose more easily than a twist lock, and it is primarily marketed for RVs. Buy the Champion L14-30 cord instead if your generator has a twist-lock 240-volt outlet and you are feeding the house."
  },
  {
    "id": "iron-forge-cable-12-gauge-50ft",
    "name": "Iron Forge Cable 12 Gauge Heavy Duty Extension Cord, 50 Ft (12/3 SJTW, Lighted End)",
    "category": "12/3 SJTW, 5-15P to 5-15R, 50 ft, 15A 125V 1,875W, Lighted End, UL",
    "badge": "Best 12 Gauge Appliance Cord",
    "amazonUrl": "#",
    "pros": [
      "12-gauge wire for a single appliance from a generator's household outlet",
      "Lighted end shows the cord is live, per the listing",
      "Reinforced blades resist bending and cracking",
      "Rated -40°F to +140°F; UL certified",
      "Bright yellow jacket is easy to see in the dark and in snow"
    ],
    "cons": [
      "15 amps and 1,875 watts maximum: one appliance per cord",
      "Single outlet at the far end",
      "Not for an inlet box or transfer switch"
    ],
    "bottomLine": "The right single cord for running a refrigerator, freezer or sump pump from a generator's household outlet, with enough gauge for 50 feet.",
    "description": "Even with a splitter cord, most people still need a few ordinary cords to reach appliances inside the house, and those are where generator setups usually cut corners. A thin 16-gauge cord that powers holiday lights is the wrong cord for a refrigerator. The Iron Forge Cable 12-gauge cord is the right kind. The listing describes a 50-foot, 12/3 SJTW cord with 5-15 plug and outlet, rated 15 amps, 125 volts and 1,875 watts, UL certified, with a lighted end that shows when power is on, reinforced blades that resist bending and cracking, and a temperature range of -40°F to +140°F. The spec that matters is the 12 gauge. Fifty feet is a long run for a refrigerator, freezer or sump pump, and motors suffer when voltage sags at start-up. Twelve-gauge copper keeps the drop over that length far lower than 14 or 16-gauge cords, so the compressor starts cleanly. The bright yellow jacket also helps on a dark night when the cord crosses a lawn. The trade-offs are that it carries one appliance at 15 amps, has a single outlet, and cannot feed an inlet box. Iron Forge is a veteran-owned US brand. Buy the Champion splitter cord instead if you need several outlets near the house."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Generator Cord",
          item: "https://www.thehonestreviewers.com/best-generator-extension-cord/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best generator cord?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the best generator cord is the Champion Power Equipment 25-Foot 30-Amp L14-30 cord. It uses 10-gauge wire, matches the L14-30 outlet on most portable generators and the L14-30 inlet box on most homes, and is long enough to keep the generator a safe distance from the house. Larger generators with a 14-50 outlet need a 50-amp cord instead."
          }
        },
        {
          "@type": "Question",
          "name": "What gauge cord do I need for a 30 amp generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 30-amp generator cord should be 10 gauge. Ten-gauge copper carries 30 amps safely at typical generator cord lengths of 25 to 50 feet, which is why reputable L14-30, L5-30 and TT-30 cords all use it. A 12-gauge cord is too thin for a 30-amp connection. For long runs, check voltage drop in a sizing guide."
          }
        },
        {
          "@type": "Question",
          "name": "How long can a generator cord be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most homes need 25 feet, and 50 feet is common where the safe generator spot is farther away. Longer cords work but add voltage drop, which makes motors run warmer, so a 100-foot run may need a heavier gauge. Always choose the length that keeps the generator at least 20 feet from the house rather than the shortest cord available."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between L14-30 and TT-30?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L14-30 is a 4-prong, 30-amp, 125/250-volt twist-lock connection that carries both legs of power and suits home inlet boxes and transfer switches. TT-30 is a 3-prong, 30-amp, 125-volt RV connection that carries one leg. A TT-30 cord suits RVs and 120-volt splitters but cannot properly feed a 240-volt house inlet."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 50 amp generator cord?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if your generator has a 14-50R outlet and your house has a 50-amp inlet box. A 50-amp cord carries up to about 12,000 watts and suits generators of roughly 12,000 watts and up. If your generator's largest outlet is an L14-30, a 30-amp cord is correct, and a 50-amp cord adds nothing but weight and cost."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a regular extension cord with a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for running individual appliances from the generator's household outlets, as long as the cord is outdoor rated and heavy enough. Use at least 12 gauge for a refrigerator, freezer or sump pump at 25 to 50 feet. Regular cords cannot connect a generator to house wiring; that needs a twist-lock cord, an inlet box and a transfer switch or interlock."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to plug a generator into a wall outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Plugging a generator into a wall or dryer outlet with a double-male cord backfeeds the house wiring, leaves live prongs exposed and can send power into utility lines, endangering line workers. It is illegal in most places. The safe way to power house circuits is an inlet box with a transfer switch or interlock kit, installed to code."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "generator cord",
      "best generator extension cord",
      "L14-30 generator cord",
      "30 amp generator cord",
      "50 amp generator cord",
      "generator power cord for transfer switch"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best Generator Cords for 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right generator cord matches your generator's largest outlet, uses enough copper for the amps and reaches a safe spot without going farther. Here are the connector types, the gauge rules and the seven cords worth buying.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-25ft-l14-30-transfer-switch-cord"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="4.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#which-cord" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Which Cord You Need</a>
          <a href="#inlet-vs-splitter" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Inlet Cord vs Splitter Cord</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Generator Cords</a>
