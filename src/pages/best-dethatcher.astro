---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Grass Seed",
    "url": "/best-grass-seed/"
  },
  {
    "title": "Best Fertilizer for Grass",
    "url": "/best-fertilizer-for-grass/"
  },
  {
    "title": "Best Leaf Blowers",
    "url": "/best-leaf-blower/"
  },
  {
    "title": "Best Lawn Mower Blades",
    "url": "/best-lawn-mower-blades/"
  },
  {
    "title": "Best Mulching Mowers",
    "url": "/best-mulching-mower/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Dethatchers for Lawns With More Than Half an Inch of Thatch";
const description =
  "Seven dethatchers compared, electric, cordless, tow-behind and a rake, plus the half-inch thatch rule, dethatcher vs scarifier, timing and how to overseed after.";

const PRODUCTS = [
  {
    "id": "greenworks-27022-dethatcher",
    "name": "Greenworks 10 Amp 14-Inch Corded Dethatcher 27022",
    "category": "14-Inch Corded Electric Dethatcher",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 9000,
    "pros": [
      "10 amp motor with a 14-inch dethatching path",
      "3-position depth adjustment, from a light comb to a deeper pull",
      "Stainless steel tines that hold up well",
      "Light enough to lift over edging and carry to the back yard",
      "Padded grip and adjustable handle"
    ],
    "cons": [
      "Corded, so you manage an outdoor extension cord across the lawn",
      "Only three depth settings, fewer than the Sun Joe models"
    ],
    "bottomLine": "The simplest, most proven electric dethatcher for typical suburban lawns, with enough width to finish in a reasonable time.",
    "description": "The Greenworks 27022 is the dethatcher we would hand to most people with a quarter-acre lawn or less, and its huge base of owner reviews on Amazon backs that up. It pairs a 10 amp motor with a 14-inch path, which is noticeably wider than the 12- to 13-inch budget machines and cuts the number of passes on a typical lawn. The tines are stainless steel, and the depth adjusts through three positions. That is fewer settings than the Sun Joe machines offer, but in practice most people use one setting for a light spring pass and one deeper setting for a proper dethatch, so three is enough. The machine is light enough to lift over bed edging and carry up steps, and the padded grip and adjustable handle make a long session more comfortable. Greenworks backs it with a 4-year warranty, which is longer than several rivals. As with any corded tool, plan the cord first: start near the outlet, work away from it, and keep the cord on the finished side of the lawn so you do not run over it. What it does not do is scarify. It is a spring-tine dethatcher, which combs out dead material rather than slicing into the soil. That is what most lawns need. If you want to scarify before overseeding, look at the Sun Joe AJ801E or AJ805E."
  },
  {
    "id": "sun-joe-aj801e-scarifier",
    "name": "Sun Joe AJ801E 12 Amp Electric Scarifier and Dethatcher",
    "category": "12.6-Inch 2-in-1 Corded Dethatcher/Scarifier",
    "badge": "Best Budget 2-in-1",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 4000,
    "pros": [
      "Includes both a spring-tine dethatching reel and a bladed scarifying reel",
      "27 spring steel tines, and 20 slicing blades on the scarifier",
      "5-position depth knob from about 0.4 in above to 0.4 in below the soil",
      "Collection bag catches much of the thatch",
      "Light and compact for small lawns"
    ],
    "cons": [
      "The collection bag fills quickly on a thatchy lawn",
      "12.6-inch path makes larger lawns a slow job"
    ],
    "bottomLine": "The cheapest way to get both dethatching and scarifying in one machine, best on small lawns where the narrow path and small bag do not matter.",
    "description": "The Sun Joe AJ801E is the entry point to 2-in-1 machines, and on a small lawn it is hard to beat for value. It comes with two interchangeable reels. The dethatching reel carries 27 spring steel tines that comb out dead grass and moss, and the scarifying reel carries 20 fixed blades that slice into the thatch and the top of the soil. Having both matters: you can do a light dethatch in spring and a scarify before overseeding in fall without buying a second tool. The motor is 12 amps and the path is 12.6 inches wide, which is narrow, so we would keep it to lawns up to a few thousand square feet. The depth knob has five positions, spanning about 0.4 inch above to 0.4 inch below the soil surface. That range is the useful part; the highest settings are for a light comb, and the lowest are for scarifying. A collection bag catches a good share of the material, which saves raking, though owners consistently report that it fills fast on a thatchy lawn and has to be emptied often. On heavy thatch, it is often easier to remove the bag and rake or blow the debris afterward. Sun Joe backs it with a 2-year warranty, and replacement tines and blades are available, which matters because scarifier blades wear on sandy or stony ground."
  },
  {
    "id": "sun-joe-aj805e-dethatcher",
    "name": "Sun Joe AJ805E 13 Amp 15-Inch Electric Dethatcher and Scarifier",
    "category": "15-Inch 2-in-1 Corded Dethatcher/Scarifier",
    "badge": "Best for Mid-Size Lawns",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1500,
    "pros": [
      "Wider 15-inch path and a 13 amp motor",
      "Both a dethatching reel and a scarifying reel included",
      "5-position depth control from about 0.4 in above to 0.4 in below the soil",
      "Larger head and collection bag than the AJ801E",
      "Replacement tines and scarifier blades are sold separately"
    ],
    "cons": [
      "Bulkier and heavier to store than the smaller Sun Joe",
      "Still corded, which gets awkward on the largest lawns"
    ],
    "bottomLine": "The corded 2-in-1 to buy if your lawn is too big for the AJ801E but not big enough for a tractor.",
    "description": "The AJ805E is the bigger sibling of the AJ801E, and on a mid-size lawn the difference is worth paying for. Sun Joe gives it a 13 amp motor and a 15-inch working path, the widest of the corded machines here, with a larger head and collection bag intended to clear medium-size yards without constant stops. Like the smaller model, it comes with two reels: a dethatcher with 27 spring steel tines for combing out dead material and moss, and a scarifying cylinder with fixed blades for slicing through thatch and scoring the soil surface before overseeding. Depth is set with a five-position knob across roughly 0.4 inch above to 0.4 inch below the soil, which covers everything from a gentle spring pass to a proper scarify. The extra width means fewer passes, and because a thorough dethatch involves going over the lawn twice in different directions, that saving adds up quickly on a lawn of a quarter acre or so. The trade-offs are size and the cord. It takes up more space in the garage, and on a larger lawn, managing 100 feet of extension cord takes some attention. Sun Joe backs it with a 2-year warranty and sells replacement tines and blades. If your lawn is small, the AJ801E does the same work for less; if it is much larger than a quarter acre, look at a tow-behind."
  },
  {
    "id": "greenworks-40v-dt1504-dethatcher",
    "name": "Greenworks 40V 15-Inch Brushless Dethatcher/Scarifier",
    "category": "15-Inch Cordless 2-in-1 Dethatcher/Scarifier",
    "badge": "Best Cordless",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 300,
    "pros": [
      "No cord to drag, trip over or cut",
      "Brushless motor with a 15-inch path",
      "Quick-swap reels for dethatching and scarifying",
      "5-position depth adjustment with separate ranges for each reel",
      "Runs on the same 40V batteries as a wide range of Greenworks tools"
    ],
    "cons": [
      "The most expensive walk-behind here, especially with battery and charger",
      "Greenworks quotes around 45 minutes of runtime on the 5.0Ah battery, so a large lawn may need a second battery"
    ],
    "bottomLine": "Worth the premium if you already own Greenworks 40V batteries or have a lawn where running a cord is a genuine nuisance.",
    "description": "Cordless is the one real improvement in walk-behind dethatchers in recent years, and the Greenworks 40V model is the one we would buy. It uses a brushless motor with a 15-inch path, and it is a 2-in-1: quick-swap reels switch between a spring-tine dethatcher and a bladed scarifier. Greenworks gives each reel its own depth range across five positions, roughly from 1/10 inch below to 3/4 inch above the surface for dethatching, and from 1/2 inch below to 1/5 inch above for scarifying. Greenworks sells it as a kit with a 5.0Ah battery and rapid charger, model DT1504, and quotes about 45 minutes of runtime. That is enough for a typical suburban lawn at one pass, but a thorough two-direction dethatch on a bigger lawn may need a second battery or a recharge break. The case for it is convenience. Not having a cord means you can work in any direction, cross beds and paths freely, and never worry about cutting the cord with the reel. If you already own Greenworks 40V batteries, the bare tool closes much of the price gap with corded machines. If you do not, the kit is a premium purchase for a tool you will use once or twice a year, and the corded Greenworks 27022 does the dethatching part of the job just as well."
  },
  {
    "id": "brinly-dt-48bh-dethatcher",
    "name": "Brinly DT-48BH 48-Inch Tow-Behind Dethatcher",
    "category": "48-Inch Tow-Behind Spring-Tine Dethatcher",
    "badge": "Best Tow-Behind",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1200,
    "pros": [
      "48-inch width with 24 independently flexing spring steel tines in two rows",
      "Triple-coil 3/16-inch tines stay flexible and resist breaking",
      "Safety rod catches a broken tine before it can reach mower blades",
      "Adjustable drawbar mounting to suit different hitch heights",
      "Universal hitch pin fits most riders, tractors, ZTRs and ATVs"
    ],
    "cons": [
      "Spring-tine design combs thatch up but does not collect it",
      "Needs added weight on the tray for deeper thatch"
    ],
    "bottomLine": "The tow-behind dethatcher to buy for large lawns, well built and wide enough to make a half-acre job quick.",
    "description": "For a lawn of half an acre or more, a tow-behind dethatcher is the practical choice, and the Brinly DT-48BH is the one we would buy. It is a simple tool done well: a 48-inch steel frame carrying two staggered rows of 12 spring steel tines, 24 in all, each one a triple-coil 3/16-inch tine that flexes independently over bumps. That independence is what keeps it from gouging on uneven ground. A safety rod sits behind the tines to catch one if it ever breaks, so it cannot be flung into your mower deck. The drawbar mounts at different heights to match your tractor's hitch, and the universal hitch pin fits most riders, lawn tractors, zero-turns and ATVs. There is a weight tray on top; load it with blocks or sandbags when you need the tines to dig deeper. Keep in mind what a tow-behind spring-tine dethatcher does. It is a large power-less rake. It lifts and loosens thatch and brings it to the surface, where you then collect it with a bagging mower, a lawn sweeper or a rake. It does not slice into soil like a scarifier, and on very thick, matted thatch it will do a partial job. For moderate thatch across a big lawn, though, it is quick, effective and nearly maintenance-free. Brinly makes it in the USA."
  },
  {
    "id": "agri-fab-45-0294-dethatcher",
    "name": "Agri-Fab 45-0294 40-Inch Tow Dethatcher",
    "category": "40-Inch Tow-Behind Spring-Tine Dethatcher",
    "badge": "Best Budget Tow-Behind",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 2000,
    "pros": [
      "20 heat-treated 3/16-inch spring tines across a 40-inch width",
      "Weight tray takes up to 70 lb for deeper raking",
      "Cantilever transport handle to lift tines for turns and crossings",
      "Universal hitch fits any brand of lawn tractor",
      "Light at about 33 lb assembled, easy to hang up and store"
    ],
    "cons": [
      "Lower weight capacity than the Brinly limits how deep it bites",
      "Narrower than the Brinly, so more passes on a large lawn"
    ],
    "bottomLine": "A lighter, simpler tow-behind that suits quarter- to half-acre lawns with moderate thatch and smaller tractors.",
    "description": "The Agri-Fab 45-0294 is the more affordable tow-behind dethatcher, and it is the right choice for a tractor owner with a moderately sized lawn and moderate thatch. It carries 20 heat-treated spring tines, each 3/16 inch in diameter, across a 40-inch width, and a 40-inch weight tray that holds up to 70 lb. That is a lower weight limit than the Brinly's, which matters on firm ground where more weight means deeper raking, but it is enough for most lawns with a thatch problem rather than a thatch crisis. The practical touch we like is the cantilever transport handle, which lifts the tines clear of the ground from the tractor seat when you turn at the end of a row or cross a path. That saves both the turf and the tines. Semi-pneumatic 7-inch tires carry it between jobs, and at about 33 lb assembled it is easy to hang on a garage wall. The universal hitch fits any lawn tractor regardless of brand, and Agri-Fab backs it with a 3-year limited warranty. It shares the limits of every spring-tine tow dethatcher: it pulls thatch to the surface but does not collect it, so plan to follow up with a bagging mower, a lawn sweeper or a leaf blower and rake. Where it earns its place is speed. A 40-inch pass covers ground far faster than any walk-behind."
  },
  {
    "id": "ames-2915100-thatch-rake",
    "name": "Ames 15-Inch Adjustable Thatch Rake 2915100",
    "category": "Manual Thatch Rake",
    "badge": "Best Manual",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1000,
    "pros": [
      "15-inch head with 19 curved steel tines",
      "Long hardwood handle, 54 inches, with a cushion grip",
      "Self-cleaning head sheds thatch as you work",
      "No cord, battery or storage headache",
      "Precise for spot work around beds, trees and edges"
    ],
    "cons": [
      "Hard physical work on anything more than a small lawn",
      "Cannot match a machine for depth on heavy, matted thatch"
    ],
    "bottomLine": "All a small lawn or a few thatchy patches really need, and a useful partner to any machine for edges and corners.",
    "description": "A thatch rake is the oldest dethatching tool, and for a small lawn it is still a sensible one. The Ames 2915100 has a 15-inch head with 19 curved steel tines on a 54-inch North American hardwood handle, with a 10-inch cushion grip. The curved tines are the key difference from a leaf rake or a garden rake. They are shaped to dig into the thatch layer and drag it up as you pull, and the head is designed to shed the material rather than clog, so you are not stopping every few strokes to pick it clean. Used with short, firm pulls in one direction and then across, it will open up a thatchy lawn well. It is also where we would start on a lawn you are not sure needs a machine: rake a test patch, see how much comes up and how the grass looks a couple of weeks later. The limits are your back and your time. Raking a small city lawn is a reasonable weekend job. Raking a quarter acre is punishing, and on thick, matted thatch a machine will do more in less time. Even if you buy a machine, a thatch rake earns its place. It reaches along fences, into corners and around trees and beds where a dethatcher cannot go, and it is handy for scratching up the surface of bare patches before reseeding."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dethatchers",
          item: "https://www.thehonestreviewers.com/best-dethatcher/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best dethatcher for most lawns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For lawns up to about a quarter acre, a corded electric dethatcher like the Greenworks 27022 is the best balance of width, weight and value. If you also want to scarify before overseeding, choose a 2-in-1 like the Sun Joe AJ801E or AJ805E. For half an acre or more with a tractor, a tow-behind like the Brinly DT-48BH is far faster."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know if my lawn needs dethatching?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cut a small wedge of turf a few inches deep and look at the side. Measure the brown, spongy layer between the green grass and the soil. Under half an inch is healthy and should be left alone. Over half an inch is worth dethatching, and over an inch usually calls for a rented power rake or a staged job."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a dethatcher and a scarifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A dethatcher combs out loose dead material with flexible spring tines and is fairly gentle. A scarifier, or verticutter, slices down through thatch and into the soil with fixed blades, which is more aggressive and better for matted thatch and overseeding preparation. Many electric machines include both reels so you can switch between them."
          }
        },
        {
          "@type": "Question",
          "name": "Should I dethatch or aerate first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dethatch first, then aerate, then seed and fertilize. Removing thatch lets aerator tines reach the soil and lets seed land on soil instead of dead material. If your thatch is only moderate, aeration alone may be enough, because the soil plugs help break thatch down naturally without the stress of dethatching."
          }
        },
        {
          "@type": "Question",
          "name": "Do tow-behind dethatchers work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for moderate thatch on large lawns. They are spring-tine rakes pulled by a tractor, so they lift and loosen thatch quickly but do not slice into it or collect it. Add weight to the tray for deeper action, and follow up with a bagging mower, sweeper or blower. For thick, matted thatch, rent a power rake instead."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I dethatch my lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only when thatch is over about half an inch, which for many lawns means every two to three years, and for some never. Lawns of creeping grasses like Kentucky bluegrass, bermudagrass and zoysia build thatch faster and may need it more often. Measure every year rather than dethatching on a fixed schedule."
          }
        },
        {
          "@type": "Question",
          "name": "Can I dethatch in the spring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but keep it light. For cool-season grass, fall is better, because a hard spring dethatch opens the soil just as crabgrass germinates and leaves little recovery time before summer heat. For warm-season grass, late spring to early summer is the right time, once the lawn is fully green and actively growing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best dethatcher",
      "electric dethatcher",
      "tow behind dethatcher",
      "dethatcher vs scarifier",
      "thatch rake",
      "when to dethatch lawn"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Dethatchers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Dethatchers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A little thatch is good for a lawn and a lot of it starves the roots. Measure first, then pick the dethatcher that matches your lawn size and how aggressive the job needs to be.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#greenworks-27022-dethatcher"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Measure Your Thatch
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="10.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#what-is-thatch" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Thatch Is and the Half-Inch Rule</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#dethatcher-vs-scarifier" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Dethatcher vs Scarifier</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Electric vs Tow-Behind vs Manual Rake</a>
          <a href="#timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. When to Dethatch</a>
          <a href="#how-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How to Dethatch Without Wrecking the Lawn</a>
          <a href="#recovery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Recovery and Overseeding</a>
