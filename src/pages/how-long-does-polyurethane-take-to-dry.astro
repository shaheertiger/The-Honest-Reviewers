                    <td class="px-4 py-4 font-black text-gray-900">Light foot traffic (socks)</td>
                    <td class="px-4 py-4 text-gray-700">About 24 hours</td>
                    <td class="px-4 py-4 text-gray-700">About 24-48 hours</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Furniture back</td>
