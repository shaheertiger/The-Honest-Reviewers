                    <td class="px-4 py-4 text-gray-700">About 1-2 weeks</td>
                    <td class="px-4 py-4 text-gray-700">About 2-4 weeks</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Full cure</td>
                    <td class="px-4 py-4 text-gray-700">About 7 days to 2-4 weeks</td>
