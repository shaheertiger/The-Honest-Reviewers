                    <td class="px-4 py-4 font-black text-gray-900">Dry to the touch</td>
                    <td class="px-4 py-4 text-gray-700">About 1-2 hours</td>
                    <td class="px-4 py-4 text-gray-700">About 4-8 hours</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Recoat</td>
                    <td class="px-4 py-4 text-gray-700">About 2-4 hours</td>
                    <td class="px-4 py-4 text-gray-700">About 8-24 hours</td>
                  </tr>
