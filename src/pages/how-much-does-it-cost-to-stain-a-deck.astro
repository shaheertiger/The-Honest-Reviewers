---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Stain a Deck", url: "/how-to-stain-a-deck/" },
    { title: "How Much Deck Stain Do I Need?", url: "/how-much-deck-stain-do-i-need/" },
    { title: "Best Deck Stains", url: "/best-deck-stain-reviews/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "How Much Does It Cost to Stain a Deck in 2026?";
const description =
  "Real numbers for staining a deck: $2–$5 per square foot professionally, $150–$300 in materials for DIY, and the prep conditions that quietly double both.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Cost to Stain a Deck",
          item: "https://www.thehonestreviewers.com/how-much-does-it-cost-to-stain-a-deck/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does it cost to stain a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Professionally, most decks come in between $2 and $5 per square foot including cleaning and prep, which puts a typical 300 to 400 square foot deck at roughly $700 to $1,600. A straight recoat on a deck in good condition sits at the bottom of that band; a deck that needs stripping and sanding first can reach $6 to $8 per square foot. Doing it yourself costs $150 to $300 in materials for the same deck.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to stain a 12x12 deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 12x12 deck is 144 square feet. Professionally that runs about $300 to $700 depending on condition, though many contractors have a minimum job charge of $400 to $600 that a deck this size will simply hit. DIY, expect roughly $120 to $200 — two gallons of stain, a cleaner, a brightener and applicators.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a gallon of deck stain cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Between $35 and $70 a gallon in 2026, with most quality semi-transparent stains landing at $45 to $55 and five-gallon pails bringing the per-gallon figure down by roughly 15 to 20 percent. A gallon covers 200 to 300 square feet on smooth wood and as little as 100 to 150 on rough or weathered boards.",
          },
        },
        {
          "@type": "Question",
          name: "Is it cheaper to stain a deck yourself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Substantially, in cash terms. On a 300 square foot deck the material bill is around $200 against a professional quote of $700 to $1,500, so DIY saves $500 to $1,300. What you spend instead is a full weekend, and the risk is that poor prep produces a finish that fails in a season and has to be stripped — which costs more than the original quote.",
          },
        },
        {
          "@type": "Question",
          name: "Why are deck staining quotes so different from each other?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Because they usually describe different amounts of work. A $600 quote is often a wash and one coat; a $1,600 quote on the same deck may include stripping, sanding, a brightener, two coats and the railings and spindles priced separately. Ask every contractor to state the prep steps, the number of coats and whether railings are included, and the spread usually explains itself.",
          },
        },
        {
          "@type": "Question",
          name: "Do railings add much to the cost of staining a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "More than almost anyone expects. Railings and spindles are slow, fiddly brushwork, and contractors often price them separately at $3 to $8 per linear foot. A 40 foot run of railing can add $150 to $300 to a job, and on a deck with ornate balusters it can approach the cost of the deck floor itself.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to strip and restain a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Stripping adds roughly $1 to $3 per square foot to a professional job, taking the total to $4 to $8 per square foot. DIY, a stripper is $30 to $45 a gallon and covers 100 to 150 square feet, so a 300 square foot deck adds about $90 to $135 in materials plus most of an extra day.",
          },
        },
        {
          "@type": "Question",
          name: "How often will you pay this cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Every two to three years for a semi-transparent stain and three to five for a solid, which is the number that actually matters. A $1,200 job that lasts four years costs $300 a year; a $700 job that fails in eighteen months costs more than $450 a year and leaves you with a stripping bill. Compare quotes on cost per year of protection rather than on the headline price.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Stone & Wood Sealers",
    tags: [
      "cost to stain a deck",
      "deck staining cost",
      "deck stain price",
      "deck maintenance",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Deck Stains",
    link: "/best-deck-stain-reviews/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Cost Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            2026 Pricing
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How Much Does It Cost to <span class="text-[#38BDF8]">Stain a Deck</span>?
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          $2 to $5 per square foot with a contractor, $150 to $300 in materials on your own — and a condition problem that can double either figure before anyone opens a can.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#at-a-glance"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Numbers
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#at-a-glance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Cost at a Glance</a>
          <a href="#by-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Cost by Deck Size</a>
          <a href="#diy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The DIY Material Bill</a>
          <a href="#professional" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Contractors Charge</a>
          <a href="#drivers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. What Moves the Price</a>
          <a href="#quotes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Reading Three Quotes</a>
          <a href="#cost-per-year" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cost Per Year of Protection</a>
          <a href="#saving" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Where to Actually Save</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Costly Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Almost every quote you receive will be priced per square foot, and almost every one will assume a different amount of prep. That single ambiguity explains most of the spread between the cheapest and dearest number you are given.
        </p>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Cost at a Glance
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Scope of Work</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Professional</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">DIY Materials</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wash and one coat<br /><span class="font-normal text-gray-500 text-sm">Deck in sound condition</span></td>
                    <td class="px-4 py-4 text-gray-700">$1.75–$2.75/sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.45–$0.70/sq ft</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clean, brighten, two coats<br /><span class="font-normal text-gray-500 text-sm">The standard job</span></td>
                    <td class="px-4 py-4 text-gray-700">$2.50–$5.00/sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.60–$1.00/sq ft</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strip, sand, brighten, stain<br /><span class="font-normal text-gray-500 text-sm">Failed film finish</span></td>
                    <td class="px-4 py-4 text-gray-700">$4.00–$8.00/sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$1.10–$1.75/sq ft</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Railings and spindles<br /><span class="font-normal text-gray-500 text-sm">Priced separately</span></td>
                    <td class="px-4 py-4 text-gray-700">$3–$8/linear ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.75–$1.50/linear ft</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Typical 300 sq ft deck<br /><span class="font-normal text-gray-500 text-sm">Floor and railings, standard job</span></td>
                    <td class="px-4 py-4 text-gray-700">$900–$1,600</td>
                    <td class="px-4 py-4 text-gray-700">$180–$300</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Two things jump out of that table. The first is that the gap between DIY and professional pricing is almost entirely labour — the materials are the same products from the same shelf, and they account for something like fifteen to twenty percent of a contractor's price. The second is that the condition of the deck moves the number further than any other variable, including size. Stripping a failed finish can cost more than the original staining did.
          </p>

          <p>
            That is why a quote given over the phone, or from a photo, is close to meaningless. Whether your deck needs a wash or a strip is the single biggest line item, and nobody can tell which from a picture.
          </p>
        </div>

        <div id="by-size" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Cost by Deck Size
          </h2>

          <p>
            These figures assume the standard job — cleaned, brightened, two coats of a quality semi-transparent stain on the floor, with an average run of railing included.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Deck</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Area</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Professional</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">DIY</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">10 × 10</td>
                    <td class="px-4 py-4 text-gray-700">100 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$400–$650</td>
                    <td class="px-4 py-4 text-gray-700">$110–$170</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">12 × 12</td>
                    <td class="px-4 py-4 text-gray-700">144 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$450–$800</td>
                    <td class="px-4 py-4 text-gray-700">$120–$200</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">14 × 20</td>
                    <td class="px-4 py-4 text-gray-700">280 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$850–$1,500</td>
                    <td class="px-4 py-4 text-gray-700">$175–$290</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">16 × 24</td>
                    <td class="px-4 py-4 text-gray-700">384 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$1,100–$1,900</td>
                    <td class="px-4 py-4 text-gray-700">$220–$360</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">20 × 30</td>
                    <td class="px-4 py-4 text-gray-700">600 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$1,600–$2,900</td>
                    <td class="px-4 py-4 text-gray-700">$320–$520</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Multi-level, 800+ sq ft</td>
                    <td class="px-4 py-4 text-gray-700">800+ sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$2,200–$4,500</td>
                    <td class="px-4 py-4 text-gray-700">$420–$750</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Notice that the price per square foot falls as the deck grows. Setting up, masking siding, hooking up a washer and cleaning tools at the end takes the same two hours whether the deck is 100 square feet or 600, so a small deck carries that overhead on very few square feet. This is also why most contractors hold a minimum charge of $400 to $600: below a certain size the job is nearly all setup.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Measure the Real Area</p>
            <p class="text-xl font-bold text-white mb-3">Deck floor square footage is only part of what gets stained.</p>
            <p class="text-gray-300 leading-relaxed m-0">Add the stair treads, the fascia boards around the perimeter, the underside of the railing cap, and both faces of every spindle. On a deck with a 40 foot railing run, that hidden surface area is frequently equal to a third of the floor. Our guide to <a href="/how-much-deck-stain-do-i-need/" class="text-[#38BDF8]">how much deck stain you need</a> walks through measuring it properly.</p>
          </div>
        </div>

        <div id="diy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The DIY Material Bill
          </h2>

          <p>
            Here is the full shopping list for a 300 square foot deck with railings, done properly — cleaned, brightened and given two coats.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Item</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Cost</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Deck cleaner</td>
                    <td class="px-4 py-4 text-gray-700">$20–$35</td>
                    <td class="px-4 py-4 text-gray-700">One gallon concentrate covers most decks</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wood brightener</td>
                    <td class="px-4 py-4 text-gray-700">$20–$30</td>
                    <td class="px-4 py-4 text-gray-700">Neutralises the cleaner, opens the grain</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stain, 3–4 gallons</td>
                    <td class="px-4 py-4 text-gray-700">$105–$220</td>
                    <td class="px-4 py-4 text-gray-700">$35–$70/gal; five-gallon pails save 15–20%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stain pad, brushes, pole</td>
                    <td class="px-4 py-4 text-gray-700">$35–$70</td>
                    <td class="px-4 py-4 text-gray-700">Reusable across future recoats</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Masking, drop cloths, gloves</td>
                    <td class="px-4 py-4 text-gray-700">$20–$40</td>
                    <td class="px-4 py-4 text-gray-700">Siding and plants need covering</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure washer rental</td>
                    <td class="px-4 py-4 text-gray-700">$60–$100/day</td>
                    <td class="px-4 py-4 text-gray-700">Optional; a pump sprayer and brush also work</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sander and paper</td>
                    <td class="px-4 py-4 text-gray-700">$40–$80</td>
                    <td class="px-4 py-4 text-gray-700">Only if the boards are rough or splintering</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stripper, if needed</td>
                    <td class="px-4 py-4 text-gray-700">$90–$135</td>
                    <td class="px-4 py-4 text-gray-700">$30–$45/gal, covers 100–150 sq ft</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            A deck in sound condition therefore lands at about $180 to $300. Add a strip and the same deck becomes $280 to $450 and gains an entire day of work. If you already own a pressure washer and a sander — and many people buying a deck stain do — the recurring cost of every future recoat drops to the stain, the cleaner and the brightener, or roughly $150.
          </p>

          <p>
            The one line worth spending up on is the stain itself. The difference between a $35 gallon and a $55 gallon is about $60 on this deck, and it is routinely the difference between three years of service and eighteen months. Our <a href="/best-deck-stain-reviews/">tested deck stain picks</a> cover which products actually earn the premium.
          </p>
        </div>

        <div id="professional" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Contractors Actually Charge
          </h2>

          <p>
            A staining crew's price is built from labour hours, not from materials. A two-person crew on a 300 square foot deck typically spends half a day cleaning and rinsing, a full day waiting for the wood to dry, and most of a second day applying stain and cutting in the railings. That is roughly twelve to sixteen billable hours across two visits, and it is why the number lands where it does.
          </p>

          <p>
            Regional variation is real and follows local labour rates closely. Expect the low end of every band above in the rural South and Midwest, the middle across most suburban markets, and the top end — or 20 to 30 percent above it — in coastal metros and anywhere with a short staining season, where crews have to compress a year's work into a few months.
          </p>

          <p>
            Timing matters too. Quotes in late May and June, the peak of the season, are the highest of the year and come with the longest waits. The same crew in early September or late April is frequently 10 to 15 percent cheaper simply because the calendar has gaps in it — and as our guide to the <a href="/best-time-of-year-to-stain-a-deck/">best time of year to stain a deck</a> explains, those shoulder weeks often produce better results than midsummer anyway.
          </p>
        </div>

        <div id="drivers" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What Moves the Price
          </h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Whether the old finish has to come off.</strong> The single largest variable. A peeling film finish means stripping, neutralising and sanding, which can add 60 to 100 percent to the job.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Railings, spindles and lattice.</strong> Slow brushwork with no way to speed it up. Ornate balusters can double the labour hours on an otherwise simple deck.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Height and access.</strong> A second-storey deck needs ladders or staging for the fascia and understructure, and the safety overhead shows up in the quote.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Number of coats.</strong> A second coat on a penetrating stain is not always appropriate, but where it is specified it adds most of a day's labour and 40 percent of the material.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Repairs found during prep.</strong> Popped nails, a soft board, a cracked tread. Individually small, but they turn up on most decks over ten years old and are billed on top.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Stain grade.</strong> A premium stain on a large deck can add $150 to $250 in material. It is almost always the cheapest way to buy an extra year.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Understructure and stair stringers.</strong> Rarely included by default, and worth asking about explicitly if the deck is visible from below.</span>
            </li>
          </ul>

          <p>
            Only two of those are within your control by the time you are collecting quotes: the stain grade and the number of coats. The rest were decided years ago by how the deck was built and how it has been maintained — which is the strongest argument for recoating on schedule rather than waiting until stripping becomes unavoidable.
          </p>
        </div>

        <div id="quotes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Reading Three Quotes on the Same Deck
          </h2>

          <p>
            A 320 square foot deck with 44 linear feet of railing, eight years old, semi-transparent finish worn through in the walkways. Three quotes:
          </p>

          <div class="space-y-6 my-8">
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-gray-900 mt-0 mb-2">$675 — "Pressure wash and stain"</h3>
              <p class="text-gray-700 text-sm m-0">
                One coat, no brightener, railings included but not itemised. This is a real service and on a deck in genuinely good shape it can be the right answer. On a deck with worn walkways it means new stain going onto surfaces with two different absorption rates, and the walkways will look different from the edges within a season.
              </p>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-gray-900 mt-0 mb-2">$1,180 — "Clean, brighten, two coats, railings"</h3>
              <p class="text-gray-700 text-sm m-0">
                The standard job, itemised, with the stain named and the brand's coverage rate quoted. Works out at about $3.30 per square foot with railings folded in, which is squarely mid-market. This is the quote against which the others should be judged.
              </p>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-gray-900 mt-0 mb-2">$2,340 — "Strip, sand, brighten, two coats"</h3>
              <p class="text-gray-700 text-sm m-0">
                Not a rip-off — it is simply a different job. Whether it is the right job depends on one test: sprinkle water on the sheltered edges. If it beads there and soaks in on the walkways, the deck has two finishes on it and stripping genuinely is the durable answer. If water soaks in everywhere, the film is already gone and you are paying to remove nothing.
              </p>
            </div>
          </div>

          <p>
            The lesson is that the quotes are not competing on price so much as describing three different decks. Do the water test yourself before the estimators arrive, in several places, and you will know which of the three descriptions is accurate. Our guide to <a href="/how-often-to-stain-a-deck/">how often to stain a deck</a> covers running that test properly.
          </p>
        </div>

        <div id="cost-per-year" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Cost Per Year of Protection
          </h2>

          <p>
            The headline price is the wrong comparison. Deck finishes are a recurring expense, and the only figure that survives contact with reality is what each option costs per year of service.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approach</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Service Life</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Per Year</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Budget pro, one coat</td>
                    <td class="px-4 py-4 text-gray-700">$675</td>
                    <td class="px-4 py-4 text-gray-700">1.5–2 years</td>
                    <td class="px-4 py-4 text-gray-700">$340–$450</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Standard pro job</td>
                    <td class="px-4 py-4 text-gray-700">$1,180</td>
                    <td class="px-4 py-4 text-gray-700">3–4 years</td>
                    <td class="px-4 py-4 text-gray-700">$295–$395</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DIY, quality stain</td>
                    <td class="px-4 py-4 text-gray-700">$230</td>
                    <td class="px-4 py-4 text-gray-700">2.5–3.5 years</td>
                    <td class="px-4 py-4 text-gray-700">$65–$90</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DIY, cheapest stain</td>
                    <td class="px-4 py-4 text-gray-700">$165</td>
                    <td class="px-4 py-4 text-gray-700">1–2 years</td>
                    <td class="px-4 py-4 text-gray-700">$85–$165</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The cheapest professional job is the most expensive way to own a deck, because it buys the least time. And the cheapest stain is not meaningfully cheaper than the good one once you divide by the years it lasts — while costing you a second weekend of labour that the table does not price at all.
          </p>

          <p>
            There is a real cost the table also omits on the DIY side: your time. Two full days for the average homeowner, plus the drying day in between. If a weekend is worth more to you than $500, the professional job is rational, and nobody should feel obliged to prove otherwise with a stain pad.
          </p>
        </div>

        <div id="saving" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            8. Where to Actually Save
          </h2>

          <p>
            Some savings are real and some just move the bill forward a year or two. The ones that hold up:
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Recoat before it fails.</strong> The largest saving available, and it costs nothing. A wash-and-coat deck never generates a stripping bill.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Do the prep, hire the staining.</strong> Some contractors will price a stain-only job if you clean and brighten the deck yourself, typically knocking 30 to 40 percent off. Confirm they will warrant it first.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Buy stain in five-gallon pails.</strong> Fifteen to twenty percent off the per-gallon price, and leftover stain keeps for years in a sealed pail for touch-ups.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Book in the shoulder season.</strong> April and September quotes run 10 to 15 percent under peak, with better crew availability.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Choose a longer-lasting opacity.</strong> Moving from semi-transparent to semi-solid buys a year or two per cycle for a few dollars a gallon.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Get the deck and the fence quoted together.</strong> One mobilisation, two surfaces. Crews will usually discount the second surface meaningfully.</span>
            </li>
          </ul>

          <p>
            The saving that never holds up is skipping the brightener, or the rinse, or the drying day. Every one of them shortens the life of the coat by more than it saved, and the whole cost of the job returns a year early.
          </p>
        </div>

        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">What About Sealing Instead?</h2>
        <p>
          A clear sealer is cheaper per gallon and faster to apply, and quotes for sealing typically come in 20 to 30 percent below staining. The catch is service life: with little or no pigment there is little UV protection, so a clear finish on an exposed deck is a one-to-two-year product. Per year of protection it is usually the most expensive option on the board, which is the trade our <a href="/deck-stain-vs-sealer/">deck stain versus sealer guide</a> takes apart in detail.
        </p>
        <p>
          Paint is the opposite trade. It costs about the same to apply, lasts four to seven years on a deck floor, and hides the grain entirely — but when it eventually fails it fails by peeling, and that means a full strip rather than a wash. The <a href="/deck-paint-vs-deck-stain/">paint versus stain comparison</a> covers where that bargain is worth taking.
        </p>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Costly Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Comparing Quotes That Describe Different Jobs</h3>
              <p class="text-gray-700 text-sm m-0">
                A one-coat wash-and-stain and a strip-sand-and-two-coats are not competing offers, and picking the cheaper number without reading the scope is how people end up paying twice inside two years. Ask each contractor for the prep steps, the coat count and whether railings are included.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Budgeting for the Floor Only</h3>
              <p class="text-gray-700 text-sm m-0">
                Railings, spindles, stairs and fascia routinely add a third to the surface area and rather more than a third to the labour. A quote that seems 30 percent under the others is frequently a quote for the deck floor alone.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Saving $60 on the Stain</h3>
              <p class="text-gray-700 text-sm m-0">
                On a typical deck the entire premium for a good stain is one restaurant meal, and it commonly buys an extra full year. Since the labour is the same either way, the cheap gallon is the most expensive line on the receipt when measured per year of service.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Paying to Strip a Deck That Does Not Need It</h3>
              <p class="text-gray-700 text-sm m-0">
                Stripping can add $1 to $3 per square foot. A penetrating stain that has worn away evenly needs a wash, not a strip, and the water test tells you which you have in about thirty seconds. Run it before you accept the higher quote.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Letting the Deck Go Grey First</h3>
              <p class="text-gray-700 text-sm m-0">
                A deck recoated on time costs a wash and a coat. The same deck left four extra years needs cleaning, brightening, sanding and sometimes board replacement, which is where deck maintenance stops being a few hundred dollars and starts being a few thousand.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            10. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to stain a deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Professionally, $2 to $5 per square foot including prep, so roughly $700 to $1,600 on a typical 300 to 400 square foot deck. A straight recoat sits at the bottom of that band; a deck needing stripping and sanding can reach $6 to $8 per square foot. DIY materials for the same deck run $150 to $300.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to stain a 12x12 deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                144 square feet works out at about $300 to $700 professionally, though most contractors carry a $400 to $600 minimum that a deck this size will simply hit. DIY, expect $120 to $200 for two gallons of stain, a cleaner, a brightener and applicators.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does a gallon of deck stain cost?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                $35 to $70, with most quality semi-transparent stains at $45 to $55 and five-gallon pails cutting 15 to 20 percent off the per-gallon price. Coverage is 200 to 300 square feet on smooth wood, and as little as 100 to 150 on rough or weathered boards.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is it cheaper to stain a deck yourself?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                In cash, substantially — around $200 in materials against a $700 to $1,500 quote. What you spend instead is a full weekend, and the risk is that thin prep produces a coat that fails in a season and needs stripping, which costs more than the original quote did.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why are deck staining quotes so different from each other?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Because they describe different work. A $600 quote is usually a wash and one coat; a $1,600 quote on the same deck may include stripping, sanding, a brightener, two coats and the railings. Ask each contractor to state prep steps, coat count and whether railings are included.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do railings add much to the cost?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                More than most people expect. They are slow brushwork and are often priced separately at $3 to $8 per linear foot, so a 40 foot run adds $150 to $300. On a deck with ornate balusters the railings can approach the cost of the floor.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to strip and restain a deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Stripping adds about $1 to $3 per square foot professionally, taking the job to $4 to $8 per square foot. DIY, stripper runs $30 to $45 a gallon covering 100 to 150 square feet, so a 300 square foot deck adds $90 to $135 and most of an extra day.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How often will you pay this cost?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Every two to three years for semi-transparent and three to five for solid. A $1,200 job lasting four years costs $300 a year; a $700 job that fails in eighteen months costs over $450 a year and leaves a stripping bill. Compare on cost per year, not headline price.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Deck Guides</h2>
