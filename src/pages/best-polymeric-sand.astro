<Layout
  title={`${title} | The Honest Reviewers`}
  description={description}
  ogImage="https://placehold.co/1200x630/374151/white?text=Best+Polymeric+Sand+2026"
  ogType="article"
  article={{
    publishedTime: "2026-07-17",
    modifiedTime: "2026-07-17",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "polymeric sand",
      "paver joint sand",
      "no haze polymeric sand",
      "paver sand",
      "hardscape jointing sand",
      "weed prevention pavers",
      "paver maintenance",
      "flagstone jointing sand",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
