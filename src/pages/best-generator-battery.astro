---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Battery Maintainers",
    "url": "/best-battery-maintainer/"
  },
  {
    "title": "Best Electric Start Generators",
    "url": "/best-electric-start-generator/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 26kW Generators",
    "url": "/best-26kw-generator/"
  },
  {
    "title": "How to Store a Portable Generator",
    "url": "/how-to-store-a-portable-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-26", modified: "2026-11-26" });
const title = "7 Best Generator Batteries in 2026: Group Size, CCA and Fit";
const description =
  "The best batteries for generators on Amazon, from group 26R batteries for home standby units to sealed U1, 18Ah and YTX14 batteries for electric-start portables, compared on size, terminals and CCA.";

const PRODUCTS = [
  {
    "id": "mighty-max-mm-g26r",
    "name": "Mighty Max MM-G26R Group 26R AGM Battery (12V 45Ah, 540 CCA)",
    "category": "Group 26R, Sealed AGM, 540 CCA, 45Ah, 80-Min Reserve",
    "badge": "Best for Home Standby",
    "amazonUrl": "#",
    "pros": [
      "Group 26R, 540 CCA and 45Ah, per the listing",
      "Sealed, spill-proof AGM: no water to top up",
      "80-minute reserve capacity",
      "Listing names compatibility with Generac Guardian residential standby units",
      "3-year warranty, per Mighty Max"
    ],
    "cons": [
      "Check your manual's minimum CCA before buying",
      "No wire harness or mounting hardware beyond screws",
      "Cannot be mounted upside down"
    ],
    "bottomLine": "The best battery for a home standby generator that takes a group 26R: sealed AGM, 540 CCA and a 3-year warranty.",
    "description": "Most air-cooled home standby generators start from a 12-volt car-style battery, and group 26R is one of the most common sizes their manuals call for. The Mighty Max MM-G26R is a sealed AGM battery in that size, and this listing names compatibility with Generac Guardian series residential standby generators. Mighty Max lists 12 volts, 45 amp-hours, 540 cold cranking amps and an 80-minute reserve capacity. The CCA figure is the one that matters: a standby generator may sit for weeks and then need to crank in a January ice storm, so compare 540 CCA with the minimum in your generator's manual and buy a battery that meets or beats it. AGM suits a standby enclosure because it is sealed and spill-proof, needs no watering, and Mighty Max says it can mount in any position except upside down. The listing gives dimensions of 8.25 by 6.87 by 7.43 inches, with the positive terminal on the right and the negative on the left, which is the reversed layout the R in 26R refers to. Mounting screws are included; a wire harness is not, so you reuse your existing cables. Mighty Max lists a 3-year warranty. Buy the Interstate MT-26R instead if you prefer a flooded battery from a store-backed brand with a core return."
  },
  {
    "id": "interstate-mt-26r",
    "name": "Interstate Batteries MT-26R Group 26R Battery (12V, 550 CCA)",
    "category": "Group 26R, Flooded Lead-Acid, 550 CCA, 90-Min Reserve",
    "badge": "Best Flooded 26R",
    "amazonUrl": "#",
    "pros": [
      "550 CCA and 90 minutes of reserve capacity, per the listing",
      "Group 26R, the size many standby generators call for",
      "High electrolyte-to-lead ratio for hot to moderate climates, Interstate says",
      "24-month warranty",
      "Interstate recycles old batteries and refunds a core deposit"
    ],
    "cons": [
      "Flooded, not sealed: it vents gas and needs upright mounting",
      "Price includes a core deposit you reclaim in person",
      "Listed as a car battery, so confirm the fit with your generator manual"
    ],
    "bottomLine": "A conventional flooded 26R from a long-established brand, with the highest CCA and reserve here.",
    "description": "If your standby generator's manual specifies a conventional group 26R battery, or you simply prefer a familiar brand with physical stores, the Interstate MT-26R is the flooded choice. Interstate lists it at 550 cold cranking amps and 90 minutes of reserve capacity, the highest of the 26R batteries here, and describes it as its better flooded, non-AGM battery with a high electrolyte-to-lead ratio meant to resist heat. That matters for a battery that lives in a metal generator enclosure in the sun all summer. The listing is written for cars, trucks and SUVs, so ignore the vehicle fit tool and check the group size, terminal layout and minimum CCA in your generator manual instead. A flooded battery is the traditional, lower-cost design, but it has trade-offs in a generator. It releases hydrogen gas while charging, so it must sit upright in a ventilated enclosure, which a standby generator housing is designed for, and it should never go indoors in a closed space. The price includes a refundable core deposit, which Interstate returns when you bring your old battery to one of its All Battery Centers, and the company says it recycles more batteries than it sells. The warranty is 24 months. Buy the Mighty Max MM-G26R instead for a sealed, spill-proof AGM with a longer warranty."
  },
  {
    "id": "uplus-u1-360cca",
    "name": "UPLUS U1 AGM Battery (12V 26Ah, 360 CCA)",
    "category": "Group U1, Sealed AGM, 360 CCA, 26Ah, Positive Left",
    "badge": "Best U1 for Large Portables",
    "amazonUrl": "#",
    "pros": [
      "360 CCA and 26Ah, the most cranking power of the small batteries here",
      "Sealed AGM, maintenance free, per the listing",
      "Starts at -22 degrees F, UPLUS says",
      "Calcium-calcium plates for low self-discharge",
      "15-month warranty and a 60-day refund window"
    ],
    "cons": [
      "Positive terminal on the left: generators needing U1R reversed terminals need a different battery",
      "Marketed for mowers, so check dimensions against your generator tray",
      "Larger than the compact batteries many portables use"
    ],
    "bottomLine": "A strong group U1 AGM for large electric-start portable generators whose manuals call for a U1.",
    "description": "Larger electric-start portable generators, and many dual fuel models, use a group U1 battery, the same size as a riding mower. The UPLUS U1 is a sealed AGM version listed at 12 volts, 26 amp-hours and 360 cold cranking amps, the most cranking power of the small batteries in this guide. UPLUS says it can start equipment at -22 degrees F and uses calcium-calcium plates with a low self-discharge rate, which helps a generator battery that sits for months between outages. It also says its batteries use 99.99 percent pure primary lead. The listing gives dimensions of 7.68 by 4.92 by 6.93 inches and, importantly, a terminal layout with the positive on the left and the negative on the right. That is the detail to check. U1 batteries come in two layouts, and a generator built for a U1R, with the terminals reversed, may have cables that will not reach or that stretch across the battery, so match the layout to your old battery and manual. The listing is written for John Deere, Cub Cadet, Husqvarna and other mowers rather than generators, so compare the dimensions with your battery tray before buying. UPLUS lists a 15-month warranty and a 60-day refund window. Buy the Mighty Max ML18-12 instead if your generator takes a smaller 18Ah nut-and-bolt battery."
  },
  {
    "id": "mighty-max-ml18-12-champion",
    "name": "Mighty Max ML18-12 12V 18Ah Battery for Champion Generators",
    "category": "12V 18Ah Sealed AGM, Nut and Bolt Terminals, UL Certified",
    "badge": "Best for Champion Portables",
    "amazonUrl": "#",
    "pros": [
      "12V 18Ah sealed AGM, listed for Champion 9000 and 7000 generators",
      "UL certified, per the listing",
      "Nut-and-bolt terminals for ring connectors",
      "Mounts in any position and resists vibration",
      "Screws included"
    ],
    "cons": [
      "The listing gives no CCA rating",
      "One-year warranty",
      "No wire harness or mounting hardware"
    ],
    "bottomLine": "A sealed 18Ah replacement for electric-start portable generators like Champion's larger models.",
    "description": "Many mid-size and large electric-start portable generators use a compact 12-volt sealed lead acid battery in the 18 amp-hour range rather than a car battery, and this Mighty Max listing names Champion 9000 and 7000 generators. The ML18-12 is a 12-volt, 18Ah sealed AGM battery that Mighty Max lists as UL certified, maintenance free and mountable in any position, with resistance to shock and vibration. That last point matters on a generator, where the engine shakes the battery tray every time it runs. The listing gives dimensions of 7.17 by 3.03 by 6.57 inches and nut-and-bolt terminals, which suit the ring connectors on most generator battery cables. Screws are included; a wire harness and mounting accessories are not. The trade-off is that the listing gives an amp-hour rating but no cold cranking amp figure, so you cannot compare starting power directly with a powersport battery. For a generator that specifies a 12V 18Ah battery that is not a problem, but if your manual lists a CCA minimum, ask the seller or check Mighty Max's spec sheet first. Confirm that your generator model takes this size, since Champion builds many models with different batteries. Mighty Max lists a one-year warranty. Buy the UPLUS U1 instead if your manual calls for a group U1 battery."
  },
  {
    "id": "mighty-max-ml9-12-generac",
    "name": "Mighty Max ML9-12NB 12V 9Ah Battery for Generac XG8000E",
    "category": "12V 9Ah Sealed AGM, Nut and Bolt Terminals, UL Certified",
    "badge": "Best Compact Battery",
    "amazonUrl": "#",
    "pros": [
      "Listed as a replacement for the Generac XG8000E portable generator",
      "Compact 12V 9Ah sealed AGM",
      "UL certified, per the listing",
      "Nut-and-bolt terminals",
      "Mounts in any position"
    ],
    "cons": [
      "No CCA rating in the listing",
      "Small capacity: not a substitute for a larger specified battery",
      "One-year warranty and no wiring included"
    ],
    "bottomLine": "A compact sealed replacement for portable generators that use a small 12V 9Ah starting battery.",
    "description": "Not every electric-start generator needs a big battery. Some portable models, including the Generac XG8000E this Mighty Max listing names, use a small 12-volt, 9 amp-hour sealed battery, and fitting anything larger can mean it will not go into the tray. The ML9-12NB is that compact size: the listing gives dimensions of 5.94 by 2.56 by 3.94 inches, nut-and-bolt terminals, and a UL certified, maintenance-free sealed lead acid AGM design that mounts in any position and resists shock and vibration. That is what you want in a small battery bolted next to a running engine. Because electric start on these generators only needs to spin a single-cylinder engine for a few seconds, a 9Ah battery is enough when it is kept charged, and the recoil starter is still there if the battery is flat. The trade-offs are the same as with the larger Mighty Max: there is no cold cranking amp rating in the listing, so you are matching size and voltage rather than comparing starting power, and the warranty is one year. Do not use a small battery like this in a generator whose manual specifies a larger one, because it may not crank the engine reliably in the cold. Confirm your exact generator model, then buy the ML18-12 or UPLUS U1 instead if it takes a bigger battery."
  },
  {
    "id": "chrome-igel-ytx14-bs",
    "name": "Chrome Battery S Pro iGel YTX14-BS (12V 16Ah, 210 CCA)",
    "category": "YTX14-BS Size, Gel Electrolyte, 210 CCA, LCD Voltage Display",
    "badge": "Best With Voltage Display",
    "amazonUrl": "#",
    "pros": [
      "Built-in display shows the battery's voltage at a glance",
      "210 CCA and 16Ah, per the listing",
      "Gel-infused electrolyte for vibration resistance and standby life, Chrome says",
      "Nut-and-bolt (T3) terminals",
      "24-month warranty and US-based support"
    ],
    "cons": [
      "Listing calls it both iGel and AGM, so the chemistry wording is muddled",
      "Marketed for ATVs and motorcycles: confirm your generator takes a YTX14 size",
      "Smaller capacity than a U1"
    ],
    "bottomLine": "A YTX14-size starting battery with a voltage display, so you can see it is charged before an outage.",
    "description": "Some portable generators use a powersport-size battery in the YTX14 footprint, and the Chrome S Pro iGel is the one to pick if you want to know its state of charge at a glance. Its built-in display shows the battery's voltage, which answers the most common generator question, whether the battery is charged, before the power goes out rather than when you press the start button. Chrome lists 12 volts, 16 amp-hours and 210 cold cranking amps, with dimensions of 5.91 by 3.39 by 5.71 inches and nut-and-bolt T3 terminals. The company describes its iGel design as a gel-infused electrolyte that gives greater vibration resistance and longer standby life than standard AGM. One caution about the listing: it calls the battery iGel in some places and AGM starter power in others, so treat it as a sealed, maintenance-free battery and do not read too much into the label. It is also written for ATVs, motorcycles and jet skis, with a long list of vehicle fits but no generators, so confirm that your generator manual or old battery calls for the YTX14-BS size and terminal layout before ordering. Chrome lists a 24-month warranty and a 60-day refund policy for US orders. Buy the Yuasa YTX14-BS instead if you want the original-equipment powersport brand."
  },
  {
    "id": "yuasa-ytx14-bs",
    "name": "Yuasa YTX14-BS Maintenance Free Battery with Acid Pack",
    "category": "YTX14-BS Size, AGM, 200 CCA, 12.6Ah, Supplied Dry With Acid",
    "badge": "Best Premium Small Battery",
    "amazonUrl": "#",
    "pros": [
      "Yuasa, a long-established original-equipment powersport battery maker",
      "200 CCA and 12.6Ah, per the listing",
      "Sealed AGM once filled: never needs water",
      "Lead-calcium design holds its charge longer than conventional batteries, Yuasa says",
      "Fresh when you activate it, since it ships dry"
    ],
    "cons": [
      "Ships dry: you must fill it with the included acid before use",
      "Filling needs eye protection, gloves and care",
      "Lower CCA than the Chrome in the same size"
    ],
    "bottomLine": "The brand-name YTX14-BS for generators that take this size, if you are comfortable filling it yourself.",
    "description": "Yuasa makes original-equipment batteries for many motorcycles and powersport machines, and its YTX14-BS is a premium choice for a portable generator that takes this size. The listing gives 12 volts, 12.6 amp-hours and 200 cold cranking amps. Once activated it is a totally sealed, spill-proof AGM battery, with all the acid absorbed in the plates and glass mat separators, so you never add water. Yuasa says its lead-calcium design holds its specific gravity more than three times longer than conventional batteries, which is the property a generator battery needs: it sits for months and still has to start the engine. The real trade-off is that this battery is supplied dry with a separate acid bottle. You fill each cell yourself, seal it and give it an initial charge before installing it. That means it is fresh when you activate it, but it also means handling sulfuric acid, so wear eye protection and gloves, work outdoors on a stable surface, follow Yuasa's filling instructions exactly, and keep children and pets away. The listing describes the fit type as vehicle specific and gives no generator models, so confirm that your manual calls for the YTX14-BS size. Buy the Chrome S Pro iGel instead if you want a battery that arrives ready to install, with a voltage display."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Generator Batteries",
          item: "https://www.thehonestreviewers.com/best-generator-battery/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best battery for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best battery for a generator is the size your manual specifies. For home standby generators that take a group 26R, the Mighty Max MM-G26R is our pick: a sealed AGM listed at 540 CCA with a 3-year warranty. For electric-start portables, match the size: the Mighty Max ML18-12, UPLUS U1 or a YTX14-BS battery like the Chrome S Pro iGel."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best 26R battery for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Mighty Max MM-G26R is the best 26R battery for most standby generators: sealed AGM, 540 CCA, 45Ah and an 80-minute reserve, per its listing, with a 3-year warranty. If you prefer a flooded battery from a brand with stores and core returns, the Interstate MT-26R lists 550 CCA and 90 minutes of reserve. Check your manual's minimum CCA first."
          }
        },
        {
          "@type": "Question",
          "name": "What size battery does my generator take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your generator's owner's manual lists the battery group size or dimensions, voltage, terminal layout and sometimes a minimum CCA. The label on the old battery shows the same details. Home standby generators commonly use a group 26R, while portables use anything from a 12V 9Ah sealed battery to a group U1. Match the size and terminal orientation exactly."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a trickle charger for my generator battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a portable generator, yes, unless you run it regularly. Its battery only charges while the engine runs and drains in storage, so a smart battery maintainer keeps it ready; our best battery maintainer guide covers good ones. Home standby generators have a built-in charger in the controller and do not need a separate trickle charger."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a car battery in a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is the group size your generator specifies. Home standby generators are designed for car-style batteries such as a group 26R, so a matching car battery works. Portable generators usually use small sealed batteries, and a car battery will not fit their tray or mounts. Never connect an oversized battery with jumper leads or improvised cables."
          }
        },
        {
          "@type": "Question",
          "name": "Is an AGM or flooded battery better for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most generators, AGM is the better choice. It is sealed, spill-proof, needs no water and resists vibration and self-discharge. A flooded battery costs less and works well in a ventilated standby enclosure, but it vents hydrogen while charging and must stay upright. Follow your generator manual if it specifies a type."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a generator battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generator batteries typically last about three to five years, depending on heat, how well they are kept charged and how long they sit discharged. Replace a battery that cranks slowly, will not hold a charge, fails a load test or shows a swollen case before storm season, rather than waiting for it to fail during an outage."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best battery for generator",
      "best generator battery",
      "26r battery for generator",
      "best 26r battery for generator",
      "best portable generator battery",
      "generator battery",
      "standby generator battery"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Generator Batteries</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          An electric-start generator is only as reliable as its battery. Seven batteries on Amazon, from group 26R for home standby units to compact sealed batteries for portables.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#mighty-max-mm-g26r"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Size Fits?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Portable or Standby</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Size, Terminals and CCA</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Generator Batteries</a>
          <a href="#26r" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Best 26R Battery</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. AGM, Flooded, Gel or Lithium</a>
          <a href="#replace" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Replacing It Safely</a>
          <a href="#charging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Trickle Chargers</a>
          <a href="#lifespan" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. How Long It Lasts</a>
          <a href="#storage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Storing Between Outages</a>
          <a href="#recycling" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Disposing of the Old One</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The right generator battery matches your generator's group size, terminal layout and cranking needs, then stays charged between outages. This guide explains sizes, 26R batteries, AGM vs flooded, safe replacement and charging, then ranks seven real batteries.
