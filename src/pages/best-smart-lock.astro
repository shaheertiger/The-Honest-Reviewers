const dates = pageDates(Astro.url.pathname, { published: "2026-10-30", modified: "2026-10-30" });
const title = "7 Best Smart Locks in 2026: Ranked for Real Homes";
const description =
  "Seven smart locks ranked for real front doors: keypad, retrofit, Wi-Fi, fingerprint and Apple Home Key, with an honest guide to choosing and installing one.";

const PRODUCTS = [
