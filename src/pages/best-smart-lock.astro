          <SocialProof users="18.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-a-smart-lock-does" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What a Smart Lock Does</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Our 7 Top Picks</a>
          <a href="#how-to-choose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. How to Choose</a>
          <a href="#security-grades" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Security & BHMA Grades</a>
          <a href="#installation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Installation Guide</a>
          <a href="#power-and-failure" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Batteries & Failure Modes</a>
          <a href="#smart-home-integration" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Smart Home Integration</a>
          <a href="#cost-and-deals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Cost & Deals</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
