const title = "5 Best Acoustic Caulks in 2026: Sealants That Close the Gaps Sound Uses";
const description =
  "The best acoustic caulk for drywall perimeters, outlet boxes and double-drywall walls, with published STC data, coverage math and what sealant can't fix.";

