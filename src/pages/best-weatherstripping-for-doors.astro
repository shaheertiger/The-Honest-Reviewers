---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Window Insulation Kits",
    "url": "/best-window-insulation-kit/"
  },
  {
    "title": "Best Garage Door Insulation Kits",
    "url": "/best-garage-door-insulation-kit/"
  },
  {
    "title": "Best Garage Door Bottom Seals",
    "url": "/best-garage-door-bottom-seal/"
  },
  {
    "title": "Best Pipe Insulation",
    "url": "/best-pipe-insulation/"
  },
  {
    "title": "Best Smart Thermostats",
    "url": "/best-smart-thermostat/"
  },
  {
    "title": "Best Oil-Filled Radiator Heaters",
    "url": "/best-oil-filled-radiator-heater/"
  },
  {
    "title": "Best Caulk for Windows",
    "url": "/best-caulk-for-windows/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Weatherstripping for Doors in 2026: Seal the Right Gap";
const description =
  "The best weatherstripping for doors on Amazon from Frost King, M-D and Duck, compared: rubber D-profile, silicone, V-strip and foam seals, door sweeps and interior door bottoms, plus how to find drafts and weatherstrip a door.";

const PRODUCTS = [
  {
    "id": "frost-king-v25wa-d-section",
    "name": "Frost King V25WA D-Section Rubber Self-Stick Weatherseal Tape",
    "category": "Self-Stick Rubber D-Profile, 5/16 in W x 1/4 in T x 17 ft, White",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Hollow D-profile rubber compresses and springs back each time the door closes",
      "5/16 inch wide and 1/4 inch thick, a common size for door stops",
      "17 feet is enough for the top and both sides of a standard door",
      "Peel-and-stick, so no tools beyond scissors",
      "Country of origin listed as the United States"
    ],
    "cons": [
      "The listing is thin: dimensions only, no temperature range or gap range",
      "Self-stick adhesive needs a clean, dry, warm surface",
      "Too thick for a door that already closes tight against its stop"
    ],
    "bottomLine": "The default fix for a drafty exterior door: hollow rubber D-profile tape that seals the top and sides of most doors.",
    "description": "If your exterior door closes properly but you can feel air around the edges, a hollow rubber D-profile seal on the door stop is the repair most homes need, and Frost King's V25WA is the plain, widely sold version. The title lists the dimensions: 5/16 inch wide, 1/4 inch thick and 17 feet long, which covers the head and both jambs of a standard 36 by 80 inch door with a little to spare. The D shape matters more than the material name. Because the profile is hollow, it squashes flat when the door closes on it and recovers when the door opens, so it seals a gap that varies along the frame instead of only the tightest spot. Rubber also recovers better over time than open-cell foam. Stick it to the face of the door stop, where the door meets it, not on the jamb surface the door slides past. The trade-offs: this listing gives dimensions and country of origin and little else, so there is no stated temperature range or gap range; check Frost King's own spec sheet if that matters. At 1/4 inch thick it can stop a tight door from latching. If your gap is smaller, Frost King's P-section tape is thinner; if your old seal sits in a slot in the frame, buy a kerf-style replacement instead."
  },
  {
    "id": "md-silicone-gasket-seal",
    "name": "M-D Building Products Silicone Gasket Seal for Doors and Windows, 20 ft",
    "category": "Peel-and-Stick Silicone Rubber Gasket, 20 ft, White, UL Listed Smoke and Draft Control",
    "badge": "Best Silicone Seal",
    "amazonUrl": "#",
    "pros": [
      "Silicone rubber, which M-D says stays flexible in extreme cold and heat",
      "UL Listed for smoke and draft control, per the title",
      "20 feet covers a standard door with length to spare",
      "Peel-and-stick install with no hardware",
      "Rated for indoor and outdoor use, including sheds and garages"
    ],
    "cons": [
      "The listing gives no profile dimensions or gap range",
      "No numeric temperature range is stated",
      "Usually costs more per foot than EPDM or foam tape"
    ],
    "bottomLine": "A silicone door seal for frames that see hard winters and hot sun, from a long-established weatherstripping maker.",
    "description": "Silicone is the material to choose when a door faces the weather head-on, and this M-D gasket is the branded silicone seal we would buy. The listing describes premium silicone rubber that remains flexible in both extreme cold and heat without cracking, and the title says it is UL Listed for smoke and draft control, which is a stronger credential than most self-adhesive seals carry. It installs by peeling the liner and pressing it onto the door stop, with no hardware, and M-D says it works indoors and outdoors, including on sheds and garages. Twenty feet is enough for the head and both jambs of a standard door. Why silicone over cheaper rubber or foam? Doors on south- and west-facing walls bake in summer and freeze in winter, and foam in particular hardens, crumbles or takes a permanent set. Silicone holds its shape longer through that cycle, so the seal still springs back after a few seasons. The trade-offs are information and price. The listing does not give the profile's width, thickness or the gap it seals, and it gives no numeric temperature range, so compare the gap you measured against M-D's product page before you order. Silicone also tends to cost more per foot. Buy the Frost King D-section instead for a lower-cost seal on a sheltered door."
  },
  {
    "id": "md-v-flex-3525",
    "name": "M-D Building Products 3525 V-Flex Weather-Strip with Adhesive Back",
    "category": "Polypropylene V-Strip, 17 ft x 7/8 in per Pack, 2 Pack, White",
    "badge": "Best V-Strip",
    "amazonUrl": "#",
    "pros": [
      "V-shape springs open to fill gaps that vary in width",
      "Installs around the top and sides of a door, per M-D",
      "Polypropylene does not compress and stay flat like foam",
      "Adhesive back, cut to length",
      "Two 17-foot packs, enough for two doors"
    ],
    "cons": [
      "Can make a door harder to close if fitted on the wrong side",
      "Needs a flat, smooth jamb to bond to",
      "Plastic V-strip is less forgiving of big, uneven gaps than thick foam"
    ],
    "bottomLine": "The V-strip to buy for doors with a gap that changes along the frame, and it hides inside the jamb when the door is shut.",
    "description": "V-strip, also called tension seal, is a folded strip that sits in the gap between the edge of the door and the jamb and springs outward to close it. M-D's V-Flex is the best-known version, and this 3525 listing gives 17 feet by 7/8 inch per pack, in polypropylene with an adhesive back, sold as a two-pack. M-D says the flexible design expands and contracts to seal varying size gaps and installs around the top and sides of a door. That variable-gap behaviour is the reason to choose it. Older wood doors rarely have an even gap: tight at the hinge side, wider near the latch, wider still at the top corner. A D-profile seal on the stop can only seal where the door presses on it, but a V-strip keeps pushing outward wherever the gap opens up. Because it sits inside the jamb rather than on the face of the stop, it is also nearly invisible when the door is closed. The trade-offs: fit it with the open side of the V facing the outdoors so wind pressure opens it rather than flattening it, and expect the door to close a little firmer at first. It needs a smooth, flat surface; on a rough or curved jamb, use the D-section rubber instead."
  },
  {
    "id": "duck-max-strength-expanding-foam-seal",
    "name": "Duck Max Strength Expanding Foam Seal for Doors and Windows, 20 ft",
    "category": "Self-Adhesive Expanding Foam, 0.5 x 0.5 in x 20 ft, Fills 1/8 to 1/2 in Gaps",
    "badge": "Best Foam / Renters",
    "amazonUrl": "#",
    "pros": [
      "Expands to fill uneven gaps from 1/8 inch up to 1/2 inch, per Duck",
      "Clean removal, which Duck says makes it safe for renters",
      "Half-inch square profile seals bigger gaps than thin tape",
      "20-foot roll, cut to size with scissors",
      "Duck says it helps reduce noise and keeps out dust, insects and pollen"
    ],
    "cons": [
      "Apply above 50 degrees F, per the instructions, which rules out a cold doorframe in winter",
      "Foam compresses over time and is not as long-lived as rubber or silicone",
      "Half an inch is too thick for a door with a small gap"
    ],
    "bottomLine": "The easy-off foam seal for renters and for doors with big, uneven gaps.",
    "description": "Foam tape is the cheapest and simplest weatherstripping, and Duck's Max Strength expanding foam is the version that handles the wide, uneven gaps that defeat thinner tape. The listing gives a half-inch by half-inch profile on a 20-foot roll and says the foam fills gaps from 1/8 inch up to 1/2 inch, expanding to fit where the gap is wider. Duck also states it removes cleanly, which it says makes it safe for renters and temporary living spaces, and that it helps reduce noise and keep out dust, insects and pollen. That clean removal is the main reason to choose it. If you rent, you usually cannot screw a kit to the frame or leave adhesive residue on paint, and this lets you seal a drafty door for the winter and peel it off when you move out. The trade-offs are real. Duck's instructions say to apply it to a clean, dry surface above 50 degrees F, so on a cold day warm the frame first with the heating on, or wait. Foam also takes a set and loses its spring after a season or two, faster than rubber or silicone, so treat it as a replaceable seal. On a door with a gap under 1/8 inch, a half-inch foam strip will stop it from closing; use the Frost King D-section instead."
  },
  {
    "id": "md-door-seal-kit-aluminum",
    "name": "M-D Building Products Door Seal Kit, Screw-On Top and Sides, Silver",
    "category": "Aluminum and Vinyl Jamb Kit, One 36 in and Two 84 in Pieces, Fits Up to 36 in Doors",
    "badge": "Best Screw-On Kit",
    "amazonUrl": "#",
    "pros": [
      "Aluminum and vinyl, screwed on rather than stuck on",
      "Three pieces: one 36-inch head and two 84-inch sides",
      "Fits doors up to 36 inches wide, per the listing",
      "Slotted holes let you adjust the seal against the door",
      "Screws included; cut to length with a hacksaw"
    ],
    "cons": [
      "Visible silver strip on the interior face of the frame",
      "Needs a drill or screwdriver and a hacksaw",
      "Each piece is 1-1/8 inch wide, so check your stop has room"
    ],
    "bottomLine": "A screw-on aluminum and vinyl jamb kit that outlasts any adhesive seal on a hard-used entry or garage-entry door.",
    "description": "Adhesive seals eventually let go, especially on a busy back door or the door from the garage. M-D's screw-on kit avoids that: it is an aluminum strip carrying a vinyl seal, fastened to the frame so the vinyl presses against the face of the closed door. The listing describes three pieces, one 36 inch head and two 84 inch sides, each 1-1/8 inch wide and 1/4 inch high, for doors up to 36 inches wide, with screws included. You cut each piece to length with a hacksaw. The feature that matters is the slotted screw holes. They let you slide each piece toward the door until the vinyl just compresses, then tighten the screws, so you can tune the seal to a door that has sagged or a frame that is out of square. Adhesive tape cannot be adjusted once it is down. Done well, this seals the head and jambs on a door where tape keeps peeling. The trade-offs: the silver aluminum is visible on the interior side of the frame, which some people dislike on a front door. It takes a drill, a screwdriver and a hacksaw, and roughly half an hour of careful work. M-D also sells a white version with a vinyl-coated foam insert. For a quick fix with no tools, use the Frost King D-section or M-D silicone tape."
  },
  {
    "id": "frost-king-a59-36h-door-sweep",
    "name": "Frost King A59/36H Premium Aluminum and Vinyl Door Sweep, 2-Pack",
    "category": "Screw-On Door Sweep, 1-5/8 x 36 in, Hard-Anodized Aluminum and Vinyl, Gaps Up to 3/4 in",
    "badge": "Best Door Sweep",
    "amazonUrl": "#",
    "pros": [
      "Seals gaps up to 3/4 inch under the door, per the listing",
      "Hard-anodized aluminum and vinyl construction",
      "Slotted holes for easy height adjustment",
      "Mounts on the inside face of entry doors; screws included",
      "Two sweeps per pack, so you can do two doors"
    ],
    "cons": [
      "The vinyl can drag on thick rugs or a raised threshold",
      "Screws into the door face, which leaves holes if you remove it",
      "Does not replace a worn threshold or a missing door bottom"
    ],
    "bottomLine": "A simple screw-on sweep that closes the gap under most entry doors, sold as a pair.",
    "description": "The gap under an exterior door is often the biggest single leak in the doorway, and no amount of jamb weatherstripping fixes it. A screw-on sweep like Frost King's A59/36H is the standard answer. The listing gives a 1-5/8 by 36 inch sweep in hard-anodized aluminum with a vinyl seal, designed for gaps up to 3/4 inch, and installed on the inside of the door with the screws provided. It is sold as a two-pack. The slotted screw holes are the detail to use well. Close the door, slide the sweep down until the vinyl just touches the threshold, mark it, then fix it. Too low and the door drags; too high and light still shows under it. Because it is adjustable, you can lower it again as the vinyl wears. Mounting it on the inside face keeps the aluminum out of the rain and lets the door swing over the threshold normally. The trade-offs: if your entry has a thick mat or a raised saddle, the vinyl can drag, and on an outswinging door it has to go on the outside. It screws into the door, leaving small holes if you remove it. If the gap is caused by a worn threshold or a missing kerf-style door bottom, fix those first; a sweep will not reach a gap over 3/4 inch."
  },
  {
    "id": "md-cinch-interior-under-door-seal",
    "name": "M-D Building Products Cinch Slide-On Interior Under Door Seal, 32 in, White",
    "category": "Slide-On Vinyl and Rubber, Dual Seals, Gaps 1/2 to 1-1/2 in, Fits 32 x 1-3/8 in Doors",
    "badge": "Best for Interior Doors",
    "amazonUrl": "#",
    "pros": [
      "Slides on with no screws or adhesive",
      "Seals gaps from 1/2 inch to 1-1/2 inches under the door, per M-D",
      "Dual independent seals adjust to different floor heights",
      "Coated rubber seals reduce friction and drag",
      "Blocks light and reduces sound as well as drafts"
    ],
    "cons": [
      "Sized for 32 inch wide, 1-3/8 inch thick interior doors",
      "Not meant for exterior doors that face rain",
      "Cutting to length takes a hacksaw and scissors"
    ],
    "bottomLine": "A no-tools draft stopper that slides onto the bottom of an interior door, for cold bedrooms, basements and noisy rooms.",
    "description": "Not every draft comes from outside. A bedroom over an unheated garage, a basement door or an office next to a noisy room often has a wide gap under an interior door, and a fabric draft snake slides out of place every time the door moves. M-D's Cinch slide-on seal fixes that without tools. The listing describes a 32 inch vinyl body with two premium rubber seals that slides onto the bottom of a standard 32 inch wide, 1-3/8 inch thick interior door and seals gaps from 1/2 inch to 1-1/2 inches. The two seals sit on either side of the door and move independently, so it copes when the floor on one side is carpet and the other is tile or a threshold. The rubber is coated to reduce friction and drag, and M-D says it blocks light and reduces sound as well. That fit is the trade-off to check first. It is made for 1-3/8 inch interior doors; most exterior doors are 1-3/4 inch thick and need an exterior door bottom instead. It is cut to length with a hacksaw for the body and scissors for the rubber, so measure carefully. It is not designed for exterior doors exposed to rain. For an entry door, buy the Frost King A59/36H sweep instead."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Weatherstripping for Doors",
          item: "https://www.thehonestreviewers.com/best-weatherstripping-for-doors/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best weatherstripping for doors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most exterior doors, a hollow rubber D-profile tape such as the Frost King V25WA on the door stops is the best weatherstripping: it springs back each time the door closes and outlasts foam. Choose M-D's silicone gasket for doors facing harsh weather, M-D V-Flex for uneven gaps, and add a sweep like the Frost King A59/36H for the gap under the door."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best way to weatherstrip a door?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Find the gaps first with the light and paper tests, then measure them. Remove the old seal, clean the door stop with rubbing alcohol, and apply the new seal to the face of the stop, starting at the head and working down each side without stretching it. Finish with a sweep or new door bottom, and check that the door still latches."
          }
        },
        {
          "@type": "Question",
          "name": "Is V-strip better than foam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For doors that are opened every day, V-strip usually lasts longer, because polypropylene or metal keeps its spring while foam flattens and hardens. V-strip also handles gaps that change along the frame. Foam is cheaper and easier to fit, and better on rough surfaces and for big, irregular gaps. Many people use foam as a quick fix and V-strip or rubber as the lasting one."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a door sweep and a threshold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A threshold is the strip on the floor that the door closes over. A door sweep is attached to the face of the door and brushes against the threshold to seal the gap. A door bottom is a seal attached to the bottom edge of the door. If the threshold is damaged, fix it first; a sweep only seals against a sound threshold."
          }
        },
        {
          "@type": "Question",
          "name": "Is silicone or rubber weatherstripping better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Silicone generally stays flexible across a wider temperature range and resists taking a set, so it suits doors exposed to hard frost or strong sun. EPDM rubber is cheaper, widely available in D- and P-profiles, and lasts well on most doors. On a sheltered door, rubber is fine; on a south-facing or exposed door, silicone is worth the extra cost."
          }
        },
        {
          "@type": "Question",
          "name": "How do I stop a draft under my front door?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If light shows under the door, add a screw-on sweep set so the seal just brushes the threshold. If the door has a torn kerf-style door bottom, replace it with a matching part. Adjustable thresholds can be raised with the screws under the cap. A gap larger than about 3/4 inch usually means the threshold needs repair or replacement."
          }
        },
        {
          "@type": "Question",
          "name": "Can you weatherstrip a door in winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but adhesive seals need a clean, dry, reasonably warm surface. Duck, for example, says to apply its foam above 50 degrees F. Heat the room first, clean the stop with rubbing alcohol, and press the tape firmly. Screw-on kits and sweeps can be fitted in any weather, which makes them a good choice for a cold doorframe."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best weatherstripping for doors",
      "door weatherstripping",
      "weatherstripping for doors",
      "door sweep",
      "door draft stopper",
      "how to weatherstrip a door",
      "v-strip weatherstripping"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Weatherstripping for Doors</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A drafty door usually leaks in two or three places, and each needs a different seal. Seven branded seals, sweeps and door bottoms on Amazon, matched to the gap you have.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#frost-king-v25wa-d-section"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Type?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="4.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#find-drafts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How to Find Drafts</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. V-Strip, Foam, Silicone or Rubber</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Door Seals</a>
          <a href="#sweep-vs-threshold" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Door Sweep vs Threshold</a>
          <a href="#how-to-weatherstrip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How to Weatherstrip a Door</a>
          <a href="#door-sweep-install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How to Install a Door Sweep</a>
          <a href="#which-door" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Best Seal for Each Door</a>
          <a href="#renters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Weatherstripping When You Rent</a>
