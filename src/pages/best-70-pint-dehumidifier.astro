---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best 50 Pint Dehumidifiers",
    "url": "/best-50-pint-dehumidifier/"
  },
  {
    "title": "Best Crawl Space Dehumidifiers",
    "url": "/best-crawl-space-dehumidifier/"
  },
  {
    "title": "Best Whole House Dehumidifiers",
    "url": "/best-whole-house-dehumidifier/"
  },
  {
    "title": "What Size Dehumidifier for a Basement",
    "url": "/what-size-dehumidifier-for-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "7 Best 70 Pint Dehumidifiers in 2026: Old Ratings vs New, Explained";
const description =
  "The best 70 pint dehumidifiers, with old and new pint ratings explained: true 70 pint crawl space units from AprilAire and Santa Fe, and current-test portables.";

const PRODUCTS = [
  {
    "id": "aprilaire-e070-dehumidifier",
    "name": "AprilAire E070 70-Pint Crawl Space Dehumidifier",
    "category": "70 PPD at AHAM (80°F/60%), 53 PPD at 73°F, Gravity Drain",
    "badge": "Best True 70 Pint",
    "amazonUrl": "#",
    "pros": [
      "Spec sheet publishes a second, cooler figure: 53 pints a day at 73°F and 60% RH",
      "12.5 by 12.5 by 25 inches, sized to fit between joists or through a hatch",
      "10 feet of drain tubing and a barbed fitting in the box",
      "Washable MERV 8 filter and a 5-year warranty listed by retailers"
    ],
    "cons": [
      "Spec sheet lists a 50°F inlet air minimum, so it is not for a near-freezing crawl space",
      "No built-in pump on the standard E070 (the E070PZ adds one)"
    ],
    "bottomLine": "The cleanest answer to \"I want a real 70 pint dehumidifier\": a contractor-grade unit whose 70 pints is an AHAM figure, with an honest cooler-air number printed beside it.",
    "description": "The E070 is the dehumidifier most HVAC contractors would reach for if you asked for a genuine 70 pint machine, and its spec sheet is unusually candid about what 70 means. AprilAire rates it at 70 pints per day at the AHAM condition of 80°F and 60% relative humidity, the same conditions the old DOE test used, and then prints a second figure of 53 pints per day at 73°F and 60%. That second number is the one to plan around in a summer basement. The cabinet is 12.5 inches wide, 12.5 inches tall and 25 inches long, weighs about 56 pounds, and draws 5.8 amps on a 120 volt circuit. Airflow is listed at 200 CFM with no ductwork attached, falling to 140 CFM at 0.4 inches of static pressure, so it can push dry air down a short duct run. The box includes 10 feet of drain tubing and a barbed fitting for a gravity drain; there is no pump on this version, though AprilAire sells an E070PZ with one and an E070W with Wi-Fi. The spec sheet gives an inlet air range of 50°F to 104°F with a 40°F minimum dew point, which rules it out for an unheated crawl space that drops into the 40s."
  },
  {
    "id": "santa-fe-compact70-crawl-space",
    "name": "Santa Fe Compact70 Dehumidifier (4044110)",
    "category": "70 PPD at 80°F/60%, 43.7 PPD at 65°F, 12 x 12 x 21 in",
    "badge": "Most Efficient 70 Pint",
    "amazonUrl": "#",
    "pros": [
      "Submittal sheet lists 43.7 pints a day at 65°F, the current DOE condition, as well as 70 at 80°F",
      "12 by 12 by 21 inches and 55 pounds, the smallest true 70 pint cabinet we found",
      "Retailers describe an ENERGY STAR Most Efficient designation",
      "Retailers list a 6-year component warranty"
    ],
    "cons": [
      "Rated to a 49°F minimum, the highest floor in this group",
      "No pump; Santa Fe sells a separate condensate pump"
    ],
    "bottomLine": "The 70 pint unit to buy for a sealed crawl space or mechanical room that stays above 50°F, and the only one here that tells you what it does at the 65°F DOE condition.",
    "description": "Santa Fe is the Therma-Stor brand that waterproofing contractors have installed for years, and the Compact70 is its smallest machine. The current 4044110 version uses R-454B refrigerant, and its submittal sheet does something the rest of this list does not: it gives capacity at both test points. At 80°F and 60% relative humidity, the AHAM condition, it is rated at 70 pints per day. At 65°F and 60%, the condition the Department of Energy has used for portables since 2019, Santa Fe lists 43.7 pints per day and an efficiency of 4.1 pints per kWh. That is the clearest single illustration of why a 70 pint crawl space unit and a 50 pint portable are closer than the labels suggest. The cabinet is 12 by 12 by 21 inches and weighs 55 pounds, the blower moves 150 CFM, and Santa Fe lists an average sound level of 55 dBA and a 49°F to 95°F operating range. Retailers describe an ENERGY STAR Most Efficient designation and an 8-foot drain hose in the box. It has no pump, so you need a floor drain, sump or a separate condensate pump."
  },
  {
    "id": "frigidaire-fhdd5034y1",
    "name": "Frigidaire FHDD5034Y1 50-Pint Dehumidifier with Wi-Fi",
    "category": "50 PPD (2019 DOE), the Old 70 Pint Class, Wi-Fi, 2.7 Gallon Bucket",
    "badge": "Best Portable (Old 70 Pint Class)",
    "amazonUrl": "#",
    "pros": [
      "50 pints a day on the 2019 DOE test, the size the old 70 pint portables became",
      "2.7 gallon bucket, large for a conventional design",
      "Three fan speeds with published noise of 47, 49 and 51 dBA",
      "ENERGY STAR with a listed integrated energy factor of 2.01 L/kWh"
    ],
    "cons": [
      "No pump; continuous drainage needs a hose to a drain below the unit",
      "Rated to 41°F, so it slows down in a cold basement"
    ],
    "bottomLine": "If you were shopping for the classic 70 pint portable, this is today's equivalent: a 50 pint unit on the current test, with a big bucket and an app at no extra cost.",
    "description": "The wheeled 70 pint portables that filled store shelves before 2019 are now sold as 50 pint units, and the FHDD5034Y1 is the best current example we found of that class. Frigidaire rates it at 50 pints per day under the 2019 Department of Energy test at 65°F, which is the honest top of the portable range; the same machine would have scored roughly 70 on the old 80°F test. It is not a smaller dehumidifier than the old 70s, it is the same size of machine with a more realistic label. The spec sheet lists a 2.7 gallon bucket with automatic shut-off, a 35% to 85% humidity setting range, three fan speeds moving 174, 191 and 235 CFM, and published noise of 47 dBA on low rising to 51 dBA on high. It is rated for low-temperature operation down to 41°F, draws 470 watts at 8.8 amps, and carries an integrated energy factor of 2.01 liters per kWh under ENERGY STAR. A continuous drain port takes a garden hose to a floor drain. The cabinet is about 24.7 inches tall and weighs around 41 pounds on casters. Wi-Fi through the Frigidaire app adds schedules and humidity targets, plus Alexa and Google Home. There is no pump; the pump pick below covers basements without a drain."
  },
  {
    "id": "honeywell-tpfit50pwk-pump",
    "name": "Honeywell TPFIT50PWK 50-Pint Dehumidifier with Pump",
    "category": "49.66 PPD (ENERGY STAR, 2019 DOE), Built-In Pump, 16.4 ft Pump Tube",
    "badge": "Best Portable With a Pump",
    "amazonUrl": "#",
    "pros": [
      "ENERGY STAR record lists 49.66 pints a day on the current test and 516 kWh a year",
      "Ships with a 16.4-foot pump tube and a 3.28-foot gravity drain hose",
      "Laundry mode and auto-comfort mode",
      "About 40.5 pounds"
    ],
    "cons": [
      "Honeywell does not publish a pump lift height on the listings we found",
      "Coverage is marketed at 4,000 square feet, which is optimistic for a wet basement"
    ],
    "bottomLine": "The old 70 pint class portable with a pump, for a basement with no floor drain: about 50 pints by today's test, and both hoses in the box.",
    "description": "Honeywell kept the old figure in the model numbers of its TP70 portables, which were sold as 70 pints under the 2012 test and 50 under the 2019 test, and those are now hard to find in stock. The TPFIT50PWK is the Honeywell to buy instead, and it is the same size class, labelled the current way. Its ENERGY STAR certification lists a water removal capacity of 49.66 pints per day under the current 65°F procedure, with annual energy use of 516 kWh. For a basement without a floor drain, the important part is the built-in pump. The box includes a 16.4-foot pump tube for sending water up to a laundry sink or out a window, and a separate 3.28-foot continuous drain hose for gravity drainage to a floor drain, so you can use whichever route your basement allows. The listing adds a laundry mode for drying hung clothes and an auto-comfort mode. The cabinet measures 24.1 inches tall, 15.35 wide and 10.55 deep and weighs 40.48 pounds. What is missing is a published pump lift height, so measure the rise to your sink or window before relying on it. Honeywell markets it for 4,000 square feet, a figure we would cut by more than half in a genuinely damp basement."
  },
  {
    "id": "alorair-sentinel-hd90-crawl-space",
    "name": "ALORAIR Sentinel HD90 Crawl Space Dehumidifier",
    "category": "90 PPD at AHAM, 198 PPD Saturation, ~47.7 PPD at 60°F",
    "badge": "When 70 Isn't Enough",
    "amazonUrl": "#",
    "pros": [
      "90 pints a day at AHAM conditions, the most capacity on this list",
      "Retailers list a cooler-air figure of about 47.7 pints a day at 60°F",
      "Sized by AlorAir for up to about 2,600 square feet",
      "Auto defrost and a low-temperature rating for cold crawl spaces"
    ],
    "cons": [
      "Bigger and heavier than the 70 pint units: about 23 by 15 by 18 inches",
      "HD90 and HDi90 listings are often mixed up; only some versions have a pump"
    ],
    "bottomLine": "Buy it when a real 70 pint unit would be undersized: a large or not-yet-sealed crawl space, or a big basement in a humid climate.",
    "description": "Sometimes the honest answer to a 70 pint search is that you need more than 70. The Sentinel HD90 is AlorAir's large crawl space and basement unit, rated at 90 pints per day at the AHAM condition of 80°F and 60% relative humidity and 198 pints at saturation. Saturation is 90°F and 90% humidity, conditions you will not see outside a flooded room, so ignore the 198. The more useful number is the one AlorAir's retailers publish for 60°F and 60%: about 47.7 pints per day. That is what a big crawl space dehumidifier really delivers in a cool crawl space in spring, and it is a good reminder of how much rated capacity falls away as the air cools. AlorAir sizes it for up to about 2,600 square feet, listings give dimensions of roughly 23 by 15 by 18 inches, and spec tables list a minimum operating temperature of about 34°F with automatic defrost, so it keeps working in crawl spaces where the Santa Fe and AprilAire units would stop. The HD90 drains by gravity through a hose; the HDi90 adds a pump. Many listings use the two names interchangeably, so confirm which one you are buying."
  },
  {
    "id": "alorair-sentinel-hd55s",
    "name": "ALORAIR Sentinel HD55S Crawl Space Dehumidifier",
    "category": "55 PPD at AHAM, 120 PPD Saturation, 34.5 PPD at 60°F",
    "badge": "Best Budget Crawl Space Unit",
    "amazonUrl": "#",
    "pros": [
      "Rated from 33.8°F to 104°F with auto defrost",
      "Spec sheet lists 55 pints at AHAM and 34.53 pints at 60°F/60%",
      "4.1 amps and 2.4 L/kWh, ENERGY STAR and cETL listed",
      "About a third the price of the true 70 pint units"
    ],
    "cons": [
      "At AHAM it is a 55 pint machine, smaller than the 70s",
      "Gravity drain only; the HD55P or HDi65S adds a pump"
    ],
    "bottomLine": "The value pick for a cold crawl space of up to about 1,300 square feet, as long as you read its 120 pints as marketing and plan on the 55.",
    "description": "Search Amazon for a 70 pint dehumidifier and AlorAir's Sentinel units appear near the top with 120 pints in the title. That number is a saturation rating at 90°F and 90% humidity, and it is not comparable with anything else in this guide. AlorAir's own spec sheet for the HD55S gives the useful figures: 55 pints per day at the AHAM condition of 80°F and 60%, and 34.53 pints per day at 60°F and 60%. So by the measure used for the AprilAire and Santa Fe units, this is a 55 pint machine, and it is in this guide because it is the best value way to get a genuine low-grain crawl space dehumidifier, not because it is a 70. What it does well is cold. The spec sheet rates it from 33.8°F to 104°F with an auto defrost system, lower than either 70 pint unit above. It draws 4.1 amps, delivers 2.4 liters per kWh, weighs 44 pounds and measures 19.2 by 12.2 by 13.3 inches, and it is ENERGY STAR and cETL listed. AlorAir sizes it for about 1,300 square feet. Condensate leaves by gravity through a drain hose, so it needs a floor drain, a sump or a slope."
  },
  {
    "id": "alorair-sentinel-hdi65s-garage-dehumidifier",
    "name": "ALORAIR Sentinel HDi65S Dehumidifier with Pump",
    "category": "55 PPD at AHAM, 120 PPD Saturation, Built-In Pump",
    "badge": "Best Crawl Space Unit With a Pump",
    "amazonUrl": "#",
    "pros": [
      "Built-in condensate pump; one retailer lists a 19.6-foot drain height",
      "Rated to operate from 33.8°F to 104°F",
      "Compact 19.2 by 12.2 by 13.3 inch cabinet, 44 pounds",
      "Wi-Fi version available"
    ],
    "cons": [
      "Same 55 pint AHAM capacity as the HD55S, for more money",
      "Warranty terms differ between listings, so confirm with AlorAir"
    ],
    "bottomLine": "The HD55S with a pump: the right buy for a cold crawl space or basement corner where gravity drainage is impossible.",
    "description": "The HDi65S is the answer to the most common problem with crawl space dehumidifiers: there is nowhere for the water to run. It is built on the same platform as the HD55S, and AlorAir rates it the same way, at 55 pints per day at the AHAM condition of 80°F and 60% humidity and 120 pints at saturation. Like the HD55S, read it as a 55 pint machine by the standard that matters, and do not compare the 120 with anything else on this page. The difference is the built-in condensate pump, which pushes water up and out through a drain line; one retailer lists the drain height at 19.6 feet, which is enough to clear the rim joist of most crawl spaces or reach a sink upstairs. AlorAir's listing gives an operating range of 33.8°F to 104°F, airflow of 130 CFM, a cabinet of 19.2 by 12.2 by 13.3 inches and a weight of 44 pounds, and sizes it for about 1,300 square feet. A Wi-Fi version is sold alongside the standard model. Warranty wording varies between listings, from five years to six years with the first two fully covered, so check the current terms before you buy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 70 Pint Dehumidifier",
          item: "https://www.thehonestreviewers.com/best-70-pint-dehumidifier/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do they still make 70 pint dehumidifiers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not as portables on the current scale. Since the 2019 DOE test change, the old 70 pint portables are rated at about 50 pints, and 50 is now the largest portable size. Units still marketed as 70 pints are old-rating portables like Honeywell's TP70 series, crawl space units rated at 70 pints under the AHAM 80°F test, or compact units whose 70 is a saturation figure."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 70 pint dehumidifier the same as a 50 pint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For portables, usually yes. A unit rated at 70 pints under the 2012 DOE test at 80°F scores about 50 pints under the 2019 test at 65°F. Honeywell labelled its TP70AWKN as 50 pints (70 pint 2012 DOE standard). A crawl space unit rated at 70 pints AHAM is a larger machine, but still on the warmer test."
          }
        },
        {
          "@type": "Question",
          "name": "How many square feet does a 70 pint dehumidifier cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturers size the true 70 pint crawl space units at about 1,800 to 2,600 square feet of sealed crawl space or basement, and market old-rating portables for 4,000 square feet. Treat both as optimistic. For a genuinely damp basement, plan on 1,500 to 2,500 square feet per unit and measure humidity afterwards."
          }
        },
        {
          "@type": "Question",
          "name": "What is a high capacity dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually a unit rated above 50 pints on the current test or 70 pints at AHAM conditions: crawl space, basement and whole-house machines such as the AprilAire E070, Santa Fe Compact70 or AlorAir HD90. They have no bucket, need a drain or pump, often accept ductwork and are built for continuous duty in cooler air."
          }
        },
        {
          "@type": "Question",
          "name": "Why is a 70 pint crawl space dehumidifier so expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because it is built differently. Units like the AprilAire E070 and Santa Fe Compact70 use larger coils, heavier cabinets, defrost systems and blowers strong enough for ductwork, and they carry five to six year warranties. A household portable is built to a much lower price for intermittent use and is not designed to run for years in a crawl space."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a 70 pint dehumidifier in a cold basement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the model. The Santa Fe Compact70 is rated to 49°F and AprilAire lists a 50°F inlet minimum for the E070, while AlorAir rates its Sentinel HD55S and HDi65S down to 33.8°F. Household portables are typically rated to about 41°F but lose much of their output well before that point."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a 70 pint dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A unit drawing about 700 watts, like the AprilAire E070 at 5.8 amps, uses about 7 kWh in 10 hours of running, roughly $1.19 a day at 17 cents per kWh. The Santa Fe Compact70 draws 444 watts at 65°F according to Santa Fe, about 75 cents for the same run time. Setting 50% humidity keeps run time down."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "70 pint dehumidifier",
      "high capacity dehumidifier",
      "best 70 pint dehumidifier",
      "70 pint dehumidifier for basement",
      "honeywell 70 pint dehumidifier",
      "70 pint crawl space dehumidifier",
      "aprilaire 70 pint dehumidifier"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">70 Pint Dehumidifiers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most "70 pint" portables are 50 pint machines under the 2019 DOE test. Here are seven high capacity dehumidifiers worth buying, with every pint figure labelled by the test it comes from.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#aprilaire-e070-dehumidifier"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#rating-change" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Old vs New Ratings</a>
          <a href="#do-you-need-70" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Do You Need 70 Pints?</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best, Ranked</a>
          <a href="#lgr-vs-portable" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Crawl Space Units vs Portables</a>
          <a href="#real-capacity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Real Capacity Compared</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Drainage</a>
          <a href="#running-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Running Cost</a>
          <a href="#placement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Placement and Ducting</a>
          <a href="#which-to-buy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Which to Buy</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

