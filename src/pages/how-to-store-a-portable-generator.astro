---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How Often to Change Generator Oil", url: "/how-often-to-change-generator-oil/" },
    { title: "Best Portable Generators", url: "/best-portable-generator/" },
    { title: "Why Your Generator Runs But Produces No Power", url: "/generator-runs-but-no-power/" },
    { title: "Best Gas Generators", url: "/best-gas-generator/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "How to Store a Portable Generator Between Outages";
const description =
  "A stored generator fails for one of four reasons, and all four are preventable. Fuel strategy, the monthly exercise run, battery care and where to keep it.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "How to Store a Portable Generator", item: "https://www.thehonestreviewers.com/how-to-store-a-portable-generator/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How should you store a portable generator between outages?",
          acceptedAnswer: { "@type": "Answer", text: "Pick one fuel strategy and stick to it — either a full tank of stabilised fuel run through the carburetor, or a completely dry fuel system with the bowl drained. Then store it somewhere dry and unheated but protected, keep the battery on a maintainer if it has electric start, and run it under load for twenty to thirty minutes every month. Those four habits prevent almost every no-start failure." },
        },
        {
          "@type": "Question",
          name: "Should you store a generator with fuel in it or empty?",
          acceptedAnswer: { "@type": "Answer", text: "Either works; the middle ground is what fails. A full tank of stabilised fuel with the stabiliser run through the carburetor minimises condensation in the tank and keeps seals wet. A completely dry system removes any chance of varnish. What ruins carburetors is half a tank of untreated fuel sitting for eight months, which is how most generators are stored." },
        },
        {
          "@type": "Question",
          name: "How often should you run a generator in storage?",
          acceptedAnswer: { "@type": "Answer", text: "Once a month, for twenty to thirty minutes, with an actual load connected — a space heater or a couple of work lights will do. Running it unloaded is better than nothing but does not exercise the alternator or bring the engine up to full operating temperature, which is what burns off moisture and keeps everything moving freely." },
        },
        {
          "@type": "Question",
          name: "Can you store a generator outside?",
          acceptedAnswer: { "@type": "Answer", text: "Not uncovered. Rain and condensation corrode the control panel, outlets and electrical connections, and the alternator windings absorb moisture that can cause problems at start-up. A shed, garage or purpose-made weatherproof cover on a raised platform is the minimum. Never store it under a tarp draped directly on the machine, which traps condensation against it." },
        },
        {
          "@type": "Question",
          name: "Do you need to change the oil before storing a generator?",
          acceptedAnswer: { "@type": "Answer", text: "Change it before long-term storage rather than after, because used oil carries acidic combustion by-products that attack bearing surfaces while the engine sits. If the generator ran hard through an outage, change the oil once it has cooled and before it goes away for the season. Fresh oil in a stored engine is one of the cheapest forms of insurance there is." },
        },
        {
          "@type": "Question",
          name: "How long does fuel last in a stored generator?",
          acceptedAnswer: { "@type": "Answer", text: "Three to six months with stabiliser, and as little as a month without it in summer heat. Ethanol blends absorb moisture from the air and can separate in the tank, leaving a corrosive layer and depositing residue that varnishes the carburetor. Ethanol-free fuel stores considerably longer and is worth seeking out for a machine that sits." },
        },
        {
          "@type": "Question",
          name: "Should you keep the generator battery on a charger?",
          acceptedAnswer: { "@type": "Answer", text: "Yes, if it has electric start and is stored somewhere unheated. Small starting batteries self-discharge over months and lose cranking capacity sharply in cold, so a battery that seemed fine in October can be flat in January — exactly when you need it. A trickle maintainer costs around $30 and removes the problem entirely." },
        },
        {
          "@type": "Question",
          name: "What should you check before an outage season starts?",
          acceptedAnswer: { "@type": "Answer", text: "Run it under load, check and change the oil if due, inspect the air filter, confirm the spark plug is clean and correctly gapped, test the recoil starter even if the machine has electric start, check that cords and outlets are undamaged, and verify you have fuel, oil and a funnel to hand. Do it in early autumn, not on the day the forecast turns." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Emergency Preparedness",
    tags: ["generator storage", "generator maintenance", "portable generator", "emergency power"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Portable Generators", link: "/best-portable-generator/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Maintenance</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">How to <span class="text-[#38BDF8]">Store a Generator</span> Between Outages</h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A backup generator spends about fifty-one weeks a year doing nothing, then is asked to work in the worst conditions of the year. Those fifty-one weeks decide whether it does.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#fuel" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">Start With Fuel</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="8.1k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-they-fail" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why Stored Generators Fail</a>
          <a href="#fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Pick a Fuel Strategy</a>
          <a href="#shutdown" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Shutting It Down Properly</a>
          <a href="#exercise" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Monthly Exercise Run</a>
          <a href="#battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Battery and Electrics</a>
          <a href="#where" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Where to Keep It</a>
          <a href="#season-check" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. The Pre-Season Check</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The most common generator problem is not a broken generator. It is a perfectly serviceable machine that will not start, because of decisions made eight months earlier by somebody who was tired and wanted to put it away.
        </p>

        <div id="why-they-fail" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Why Stored Generators Fail</h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Failure</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cause</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Prevention</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Will not start, cranks fine</td>
                    <td class="px-4 py-4 text-gray-700">Varnished carburetor from stale fuel</td>
                    <td class="px-4 py-4 text-gray-700">Fuel strategy plus monthly runs</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Will not crank at all</td>
                    <td class="px-4 py-4 text-gray-700">Flat or sulphated starting battery</td>
                    <td class="px-4 py-4 text-gray-700">Trickle maintainer</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Runs but makes no power</td>
                    <td class="px-4 py-4 text-gray-700">Lost residual magnetism, damp windings</td>
                    <td class="px-4 py-4 text-gray-700">Monthly runs under load, dry storage</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Corroded panel and outlets</td>
                    <td class="px-4 py-4 text-gray-700">Damp or uncovered outdoor storage</td>
                    <td class="px-4 py-4 text-gray-700">Dry, ventilated storage off the ground</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Every row is preventable, and every prevention takes minutes rather than hours. The first row alone accounts for the large majority of generator no-starts, and it comes down entirely to what was left in the tank.
          </p>

          <p>
            It is worth being blunt about the stakes. A generator that does not start during an outage is not an inconvenience to sort out later — it is the specific failure the machine exists to prevent, occurring at the only moment it matters. Fifteen minutes a month is a small premium against that.
          </p>
        </div>

        <div id="fuel" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Pick a Fuel Strategy and Commit to It</h2>

          <p>
            There are two valid approaches. The failure mode is the third option that most people default to without deciding: half a tank of untreated fuel, left alone.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Option A: Full and Stabilised</h3>
          <p>
            Fill the tank, add fuel stabiliser at the labelled dose, then run the engine for ten minutes so the treated fuel reaches and fills the carburetor. This matters — stabiliser sitting in the tank does nothing for the carburetor bowl, which is where varnish actually forms.
          </p>
          <p>
            A full tank also minimises the air space where condensation forms, which is why this approach suits unheated storage where temperatures swing. Expect to refresh the fuel every six months or so, and rotate the old fuel into a car rather than leaving it.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Option B: Completely Dry</h3>
          <p>
            Close the fuel valve with the engine running and let it run until it stops on its own, which empties the carburetor bowl. Then drain the tank, or run the tank down first and finish with the valve. Some carburetors have a bowl drain screw worth using as well.
          </p>
          <p>
            With nothing in the system there is nothing to go stale, which makes this the more robust option for a machine that will genuinely sit untouched. The trade is that you need fuel on hand to deploy it, and pouring fuel into a dry generator in the dark during a storm is a real inconvenience.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Ethanol Problem</p>
            <p class="text-xl font-bold text-white mb-3">Ethanol-blended petrol absorbs water from the air and can separate in the tank, leaving a corrosive layer at the bottom and depositing residue that varnishes the carburetor.</p>
            <p class="text-gray-300 leading-relaxed m-0">Ethanol-free fuel stores dramatically better and is worth seeking out for a machine that sits for months. If you can only get blended fuel, stabiliser is not optional — and a dual fuel machine sidesteps the whole issue, since propane never degrades at all.</p>
          </div>

          <p>
            If your generator runs on propane as well as petrol, use propane for the monthly exercise runs. It burns clean, leaves no varnish whatsoever, and means the carburetor stays pristine in a machine that mostly sits still. That single habit is the strongest practical argument for dual fuel, covered in <a href="/best-dual-fuel-generator/">our dual fuel testing</a>.
          </p>
        </div>

        <div id="shutdown" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Shutting It Down After an Outage</h2>

          <p>
            The end of an outage is when everyone is most tired and least inclined to do this properly, which is exactly why it is worth having a routine.
          </p>

          <p>
            <strong>Let it cool before touching fuel.</strong> Never drain or fill a hot engine. Give it at least fifteen to twenty minutes.
          </p>

          <p>
            <strong>Change the oil if it ran hard.</strong> A generator that worked through a multi-day outage has done more hours than it usually sees in a year. Used oil holds acidic combustion by-products that attack bearing surfaces while the machine sits, so changing it before storage rather than before the next use is the right order. These engines hold about a quart, so it is a five-minute job.
          </p>

          <p>
            <strong>Clean it down.</strong> Wipe fuel and oil off the housing, brush debris out of the cooling fins and air intake, and check the air filter — an outage often means dust, leaves and rain. A dirty filter that sits for a year is a filter that restricts airflow next time.
          </p>

          <p>
            <strong>Then apply your fuel strategy</strong> from the section above, coil the cords properly rather than dumping them, and note the hour meter reading somewhere you will find it.
          </p>
        </div>

        <div id="exercise" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. The Monthly Exercise Run</h2>

          <p>
            This is the single highest-value habit in generator ownership, and it takes half an hour a month.
          </p>

          <p>
            Run the machine for twenty to thirty minutes with a genuine load connected — a space heater, a couple of work lights, a shop vacuum. Loading it matters because it brings the engine to full operating temperature, which burns off moisture in the crankcase and exhaust, and because it exercises the alternator rather than just spinning it.
          </p>

          <p>
            Three things happen that you cannot get any other way. Fresh fuel moves through the carburetor, preventing deposits from establishing. The alternator's residual magnetism is maintained, which prevents the frustrating fault where a generator runs perfectly but produces no output — covered in <a href="/generator-runs-but-no-power/">why a generator runs but produces no power</a>. And you find out about problems in your own time rather than during a storm.
          </p>

          <p>
            Put it in the calendar on a fixed day — the first Saturday of the month works for most people. Every owner intends to do this; the ones who actually do it are the ones who scheduled it. Observe the same safety rules as always: outdoors, twenty feet from any window, door or vent, exhaust pointed away from the house.
          </p>
        </div>

        <div id="battery" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Battery and Electrics</h2>

          <p>
            If your generator has electric start, the battery is the second most likely thing to let you down after the carburetor. Small starting batteries self-discharge steadily over months, and their cranking capacity drops sharply in cold — so a battery that turned the engine over easily in October may not manage it in January.
          </p>

          <p>
            A trickle charger or battery maintainer costs around $30 and solves this completely. Leave it connected through the storage season if there is power where the machine lives, or bring the battery indoors and maintain it there. Check the terminals for corrosion while you are at it and clean them if needed.
          </p>

          <p>
            Also test the recoil starter, even on an electric-start machine, and especially if you have never pulled it. It is the backup for the exact failure you are trying to prevent, and a recoil spring that has seized in storage is worth discovering on a calm afternoon rather than in a blackout.
          </p>

          <p>
            Finally, look after the cords. Coil them loosely rather than tightly around the frame, keep them off a concrete floor where moisture wicks in, and inspect the plugs and outlets for corrosion during the pre-season check. A generator with a corroded outlet is a generator you cannot safely connect anything to.
          </p>
        </div>

        <div id="where" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Where to Keep It</h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Dry and ventilated beats warm.</strong> A garage or shed is ideal. Unheated is fine; damp is not, because moisture in the alternator windings causes start-up problems.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Off the floor.</strong> A pallet or a couple of timbers stops moisture wicking up from a concrete slab and keeps the machine clear of any water that gets in.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>A breathable cover, not a tarp.</strong> Plastic sheeting traps condensation against the machine. A purpose-made generator cover lets moisture out while keeping dust off.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Somewhere you can actually get it out of.</strong> A machine behind the bikes, the mower and four boxes is a machine that gets deployed late, if at all.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Fuel stored separately.</strong> Cans belong in a detached shed or garage, never in the house, in approved containers, dated and rotated.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Consider security.</strong> Generators are stolen frequently, and most in the days after a regional outage. A cable lock through the frame is worth the ten dollars.</span>
            </li>
          </ul>

          <p>
            Keep a small box beside it with the things you will otherwise hunt for in the dark: two heavy-gauge outdoor extension cords, a funnel, a head torch with fresh batteries, a quart of the correct oil, a spare spark plug and the manual. Assembling that once turns deployment into a five-minute job.
          </p>
        </div>

        <div id="season-check" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. The Pre-Season Check</h2>

          <p>
            Once a year, in early autumn before the weather turns, go through the machine properly rather than just running it.
          </p>

          <p>
            Change the oil if it is due or if it looks dark. Inspect and clean or replace the air filter. Pull the spark plug, check it for fouling, clean or replace it and confirm the gap. Look over the fuel line and any propane hose for cracking or hardening. Check the recoil pulls smoothly and the electric start turns over strongly. Inspect every outlet and the cords for damage or corrosion.
          </p>

          <p>
            Then run it under load for a good half hour and confirm the output — plug something in and check it actually works, rather than assuming. If you have a transfer switch, test the whole chain from generator to panel, because a switch that has sat for a year is another thing that can surprise you.
          </p>

          <p>
            Do this in September rather than when a storm is forecast. Parts are available, dealers are not busy, and you have time to fix whatever you find. A generator checked in the calm is a generator you can rely on in the storm, which is the entire point of owning one.
          </p>
        </div>

        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Long-Term Storage: A Year or More</h2>
        <p>
          If the machine is going away for a full year or longer — a second home closed for the season, a generator kept for a move, a unit inherited and not yet needed — a few extra steps are worth the twenty minutes.
        </p>
        <p>
          Go dry rather than stabilised, since no stabiliser is rated for a year in a hot shed. Drain the tank, run the carburetor empty, and drain the bowl with its screw if it has one. Change the oil so the engine sits on clean oil rather than acidic used oil. Then remove the spark plug, put a teaspoon of clean engine oil into the cylinder, pull the recoil slowly two or three times to spread it over the bore, and refit the plug — this coats the cylinder wall and prevents the surface rust that forms in a damp, unused engine.
        </p>
        <p>
          Finish by leaving the piston at top dead centre. Pull the recoil slowly until you feel compression resistance and stop there; that closes both valves and keeps moist air out of the combustion chamber. Remove the battery entirely and store it indoors on a maintainer. Block the exhaust and air intake loosely with rag or steel wool against mice, which nest in generator housings with remarkable enthusiasm, and note on the machine that you have done so.
        </p>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">8. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Storing It With Half a Tank of Untreated Fuel</h3>
              <p class="text-gray-700 text-sm m-0">The default, and the leading cause of no-starts. Ethanol blends absorb moisture and leave varnish in the carburetor. Choose full and stabilised, or completely dry — the undecided middle is what ruins carburetors.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Adding Stabiliser Without Running the Engine</h3>
              <p class="text-gray-700 text-sm m-0">Stabiliser in the tank does nothing for the carburetor bowl, which is where deposits actually form. Run the engine for ten minutes after adding it so treated fuel reaches the whole system.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Running It Unloaded for the Monthly Exercise</h3>
              <p class="text-gray-700 text-sm m-0">An unloaded run does not reach full operating temperature or exercise the alternator. Plug in a heater or work lights for twenty to thirty minutes so the run does what it is meant to.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Covering It With a Plastic Tarp</h3>
              <p class="text-gray-700 text-sm m-0">A tarp traps condensation against the machine, corroding the panel and dampening the windings. Use a breathable purpose-made cover, and keep the generator raised off a concrete floor on a pallet or timbers.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Leaving the Battery to Its Own Devices</h3>
              <p class="text-gray-700 text-sm m-0">Starting batteries self-discharge over months and lose cranking power in cold, so a battery fine in October can be flat in January. A $30 maintainer removes the problem — and test the recoil backup while you are at it.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How should you store a generator between outages?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Pick one fuel strategy — full and stabilised, or completely dry. Store it somewhere dry, unheated but protected, off the floor. Keep the battery on a maintainer if it has electric start. Run it under load for twenty to thirty minutes monthly.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">With fuel in it or empty?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Either works; the middle ground fails. A full tank of stabilised fuel run through the carburetor minimises condensation and keeps seals wet. A dry system removes any chance of varnish. Half a tank of untreated fuel for eight months is what ruins carburetors.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How often should you run it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Monthly, for twenty to thirty minutes, with a real load connected — a space heater or work lights. Running it unloaded does not reach full operating temperature or exercise the alternator, which is much of the point.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you store a generator outside?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Not uncovered. Rain and condensation corrode the panel, outlets and connections, and damp windings cause start-up problems. A shed, garage or purpose-made weatherproof cover on a raised platform is the minimum — never a tarp draped on the machine.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Change the oil before storing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes — before storage, not after. Used oil carries acidic combustion by-products that attack bearing surfaces while the engine sits. If it ran hard through an outage, change it once cool and before it goes away for the season.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does fuel last in storage?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Three to six months with stabiliser, as little as a month without in summer heat. Ethanol blends absorb moisture, can separate in the tank, and deposit residue that varnishes the carburetor. Ethanol-free fuel stores considerably longer.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Keep the battery on a charger?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes, if it has electric start and lives somewhere unheated. Small batteries self-discharge over months and lose cranking capacity in cold, so one that seemed fine in October can be flat in January. A maintainer is about $30.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What to check before outage season?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Run it under load, change the oil if due, inspect the air filter, check the spark plug, test the recoil starter even on an electric-start machine, inspect cords and outlets, and confirm fuel, oil and a funnel are on hand. Do it in early autumn.</p>
            </div>
          </div>
        </div>

