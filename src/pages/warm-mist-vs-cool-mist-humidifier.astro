                    <td class="px-4 py-4 text-gray-700">Ultrasonic vibration or evaporation through a wick</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Burn risk</td>
                    <td class="px-4 py-4 text-gray-700">Yes, hot water and steam</td>
                    <td class="px-4 py-4 text-gray-700">None from the water</td>
                  </tr>
