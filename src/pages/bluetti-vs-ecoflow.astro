---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Jackery vs EcoFlow",
    "url": "/jackery-vs-ecoflow/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "What Size Portable Power Station Do I Need",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How to Charge a Portable Power Station With Solar",
    "url": "/how-to-charge-a-portable-power-station-with-solar/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  },
  {
    "title": "Portable Power Station vs Generator",
    "url": "/portable-power-station-vs-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-02", modified: "2026-10-02" });
const title = "Bluetti vs EcoFlow: Every Size Class Compared, With a Clear Pick for Each Buyer";
const description =
  "Bluetti vs EcoFlow compared tier by tier, from 300 Wh to whole-home: output, charging, solar, cycles, UPS speed, weight and warranty, plus who should buy which.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Bluetti vs EcoFlow",
          item: "https://www.thehonestreviewers.com/bluetti-vs-ecoflow/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Bluetti or EcoFlow better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither wins outright. EcoFlow is better for most home backup buyers because of its faster wall charging, its 3000W expandable 2 kWh unit and its more mature home ecosystem. Bluetti is better if you want higher cycle ratings, the lightest 1 kWh unit, a 0 ms UPS mode on the Apex 300 or the lowest price per watt-hour when its units are discounted."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better, the Bluetti Elite 100 V2 or the EcoFlow DELTA 3 Plus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They share 1024 Wh, 1800W output, 4,000 cycles to 80 percent, 1000W of solar and sub-10 ms UPS. The Elite 100 V2 is 2.6 pounds lighter. The DELTA 3 Plus charges faster from the wall and expands to 5 kWh, which the Bluetti cannot. Choose the EcoFlow for backup that may grow, the Bluetti for portability."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Bluetti AC200L better than the EcoFlow DELTA 3 Max Plus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The DELTA 3 Max Plus has more output at 3000W against 2400W, a faster 10 ms class switchover and 13 pounds less weight. The AC200L has more solar input with a wider voltage window, a faster 2400W charger and a 30A RV outlet, and it is often discounted more deeply. Most backup buyers should prefer the EcoFlow; solar-heavy and budget buyers the Bluetti."
          }
        },
        {
          "@type": "Question",
          "name": "Do Bluetti and EcoFlow both use LiFePO4 batteries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every current model compared here uses LiFePO4 cells, and both brands rate cycle life to 80 percent of original capacity, so their numbers compare directly. EcoFlow quotes 3,000 to 4,000 cycles on current models and Bluetti 3,000 to 6,000. If you buy older or used units, check the spec sheet, since some early models from both brands used NMC cells."
          }
        },
        {
          "@type": "Question",
          "name": "Which charges faster, Bluetti or EcoFlow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EcoFlow at most sizes. The DELTA 3 Plus fills from empty in 56 minutes on a 1500W charger, while Bluetti's Elite 100 V2 and AC180 reach 80 percent in about 45 minutes. At 2 kWh the AC200L's 2400W input is the quickest on paper. On big home units, headline times assume more power than a standard 15A outlet supplies."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use Bluetti panels with EcoFlow or the other way round?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. Both brands accept third-party solar panels within each unit's voltage and wattage window, sometimes with an adapter cable for the connector. Expansion batteries are a different matter: they are brand and model specific, so an EcoFlow extra battery will not work with a Bluetti station, and not every battery works with every unit in the same brand."
          }
        },
        {
          "@type": "Question",
          "name": "Which brand has the better warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are effectively tied on paper at five years. EcoFlow describes its five years on current DELTA models as three standard plus two on app registration. Bluetti lists five years on its current AC, Elite and Apex models. In both cases, buy from the maker or an authorised retailer and register the unit promptly to secure the full term."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "bluetti vs ecoflow",
      "ecoflow vs bluetti",
      "bluetti or ecoflow",
      "bluetti elite 100 v2 vs ecoflow delta 3",
      "bluetti ac200l vs ecoflow delta 3 max plus",
      "bluetti apex 300 vs ecoflow delta pro 3"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Power Station Picks",
    link: "/best-portable-power-station/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Head to Head
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Bluetti vs <span class="text-[#38BDF8]">EcoFlow</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Both brands sell LiFePO4 power stations from a 300 Wh camping box to a 120/240V home system, and both rate their batteries to the same 80 percent standard. EcoFlow usually wins on charging speed, 2 kWh output and expansion. Bluetti usually wins on cycle ratings, 1 kWh weight and street price. Here is how each size class lines up.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#verdict"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            Get the Verdict
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#small" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Small: River 3 vs Elite 30 V2</a>
          <a href="#one-kwh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. 1 kWh: DELTA 3 Plus vs Elite 100 V2</a>
          <a href="#two-kwh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. 2 kWh: DELTA 3 Max Plus vs AC200L</a>
          <a href="#whole-home" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Whole Home: DELTA Pro 3 vs Apex 300</a>
          <a href="#ownership" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Charging, UPS, App and Warranty</a>
          <a href="#who-should-buy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Who Should Buy Which</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          If you want the fastest wall charging, the most output at 2 kWh and the most mature home-backup ecosystem, buy EcoFlow. If you want the lightest 1 kWh box, the longest cycle ratings and the lowest price per watt-hour on sale, buy Bluetti. Neither brand wins every size class, which is exactly why our power station rankings recommend models from both. Decide the size first, then let the one spec you care about most choose the brand.
        </p>

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            Bluetti and EcoFlow are the two brands most likely to end up on the same shortlist once a buyer has decided they want long-life LiFePO4 cells and a unit that can grow into home backup. Their catalogues mirror each other closely: a 300 Wh class box for camping, a 1 kWh unit for a fridge and a router, a 2 kWh unit for real outages, and a 120/240V system for a sub-panel. That makes this comparison unusually clean, because you can pair a model from one brand against a direct rival from the other at almost every size.
          </p>

          <p>
            It is also cleaner than our <a href="/jackery-vs-ecoflow/">Jackery vs EcoFlow comparison</a> in one important way. Jackery rates its battery cycles to 70 percent of original capacity, which makes its numbers hard to line up against anyone else. Bluetti and EcoFlow both rate cycles to 80 percent, so when Bluetti quotes 6,000 cycles and EcoFlow quotes 4,000, those numbers mean the same thing and you can compare them directly.
          </p>

          <p>
            Across the current lineups a consistent pattern appears. EcoFlow charges faster from the wall, puts more inverter into its expandable 2 kWh unit, carries less weight per kilowatt-hour at the 2 kWh size, and has the more developed home-backup ecosystem around its big units. Bluetti answers with higher cycle ratings on its newest models, the lightest 1 kWh box in this comparison, a 0 ms UPS mode on its Apex 300 home unit, and street prices that are frequently lower once both brands run their constant sales.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">The Numbers That Separate Them</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">6,000</p>
                <p class="text-gray-400 text-xs mt-1">Apex 300 cycles to 80%</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">4,000</p>
                <p class="text-gray-400 text-xs mt-1">DELTA Pro 3 cycles to 80%</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">3,000W</p>
                <p class="text-gray-400 text-xs mt-1">DELTA 3 Max Plus output</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">25 lb</p>
                <p class="text-gray-400 text-xs mt-1">Elite 100 V2 weight</p>
              </div>
            </div>
          </div>

          <p>
            That split is why our <a href="/best-portable-power-station/">best portable power station guide</a> names an EcoFlow as the best overall pick and a Bluetti, the AC200L, as the best high-capacity pick, with the EcoFlow River 3 and Bluetti EB3A covering the small end. Neither brand is simply better. Each one is better at particular jobs, and the rest of this page shows which jobs, size class by size class, using the makers' own published specifications.
          </p>

          <p>
            Two pieces of housekeeping before the detail. First, prices in this category move constantly, often by 30 to 50 percent during sale events, so every price on this page is a range rather than a quote; check the day you buy. Second, if you have not settled on a capacity yet, do that first with our guide to <a href="/what-size-portable-power-station-do-i-need/">what size portable power station you need</a>, because buying the right size matters far more than buying the right logo.
          </p>
        </div>

        <div id="small" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Small: EcoFlow River 3 vs Bluetti Elite 30 V2
          </h2>

          <p>
            The small class is for phones, laptops, camera batteries, camp lights, a CPAP for a night, and keeping a router alive through a short outage. It is not for fridges, kettles or space heaters, and buying a unit this size expecting it to back up a house is the single most common mistake in the category. EcoFlow's entries are the River 3 and the River 3 Plus. Bluetti's direct rival is the Elite 30 V2, with the older EB3A still on sale alongside it.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec (maker's figures)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow River 3</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow River 3 Plus</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Bluetti Elite 30 V2</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Capacity</td>
                    <td class="px-4 py-4 text-gray-700">245 Wh</td>
                    <td class="px-4 py-4 text-gray-700">286 Wh, expands to 858 Wh</td>
                    <td class="px-4 py-4 text-gray-700">288 Wh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chemistry and cycles</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4, 3,000 to 80%</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4, 3,000 to 80%</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4, 3,000 to 80%</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC output</td>
                    <td class="px-4 py-4 text-gray-700">300W, X-Boost 600W</td>
                    <td class="px-4 py-4 text-gray-700">600W, X-Boost 1200W</td>
                    <td class="px-4 py-4 text-gray-700">600W</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solar input</td>
                    <td class="px-4 py-4 text-gray-700">110W</td>
                    <td class="px-4 py-4 text-gray-700">220W</td>
                    <td class="px-4 py-4 text-gray-700">200W</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wall charging</td>
                    <td class="px-4 py-4 text-gray-700">About 1 hour</td>
                    <td class="px-4 py-4 text-gray-700">About 1 hour</td>
                    <td class="px-4 py-4 text-gray-700">80% in about 45 min</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">UPS switchover</td>
                    <td class="px-4 py-4 text-gray-700">Under 20 ms</td>
                    <td class="px-4 py-4 text-gray-700">Under 10 ms</td>
                    <td class="px-4 py-4 text-gray-700">10 ms</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weight</td>
                    <td class="px-4 py-4 text-gray-700">About 7.7 lb</td>
                    <td class="px-4 py-4 text-gray-700">10.4 lb</td>
                    <td class="px-4 py-4 text-gray-700">About 9.5 lb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Typical price range</td>
                    <td class="px-4 py-4 text-gray-700">Roughly $150-250</td>
                    <td class="px-4 py-4 text-gray-700">Roughly $230-320</td>
                    <td class="px-4 py-4 text-gray-700">Roughly $200-300</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The River 3 is the lightest and cheapest unit here, and it is the compact pick in our rankings for good reason: under eight pounds, long-life cells, and enough capacity for a weekend of devices. Its limit is the 300W inverter. X-Boost lets resistive loads like a small kettle run at reduced voltage, but anything with a motor or a sensitive power supply above 300W simply will not start. If the job is charging and lighting, that does not matter. If you want to run a blender or a small TV, it does.
          </p>

          <p>
            The Elite 30 V2 and River 3 Plus are the better comparison with each other. Both give you 600W of continuous output from roughly 290 Wh, both rate their cells to 3,000 cycles at 80 percent, and both quote 10 ms class UPS switchover, which is fast enough to keep a router, modem and most desktop computers running through a grid drop. The Bluetti is about a pound lighter. The EcoFlow takes a little more solar and, crucially, can add an extra battery to reach 858 Wh, which no other unit in this class offers.
          </p>

          <p>
            Bluetti's EB3A, the ultraportable pick in our main guide, remains a sensible buy if you find it discounted: 268 Wh and 600W at around ten pounds. It is the older design, though, and the Elite 30 V2 matches its output in a slightly larger battery with a faster UPS figure, so compare the two prices before choosing the EB3A by default.
          </p>

          <p>
            Our verdict at this size: the River 3 if you only need devices charged and want the least weight and cost. The River 3 Plus if you think you might want more capacity later. The Elite 30 V2 if you want 600W in the lightest box and know you will never need to expand. All three are genuine LiFePO4 units, so there is no wrong answer on battery life.
          </p>
        </div>

        <div id="one-kwh" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. 1 kWh: DELTA 3 Plus vs Elite 100 V2 and AC180
          </h2>

          <p>
            This is the size most people buy: enough to keep a fridge, a router and some lights going through an evening outage, or to run a campsite for a long weekend. EcoFlow's contender is the DELTA 3 family, of which the DELTA 3 Plus is the one to compare because it doubles the plain DELTA 3's solar input. Bluetti has two: the newer Elite 100 V2 and the older, heavier but slightly larger AC180.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec (maker's figures)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow DELTA 3 Plus</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Bluetti Elite 100 V2</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Bluetti AC180</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Capacity</td>
                    <td class="px-4 py-4 text-gray-700">1024 Wh</td>
                    <td class="px-4 py-4 text-gray-700">1024 Wh</td>
                    <td class="px-4 py-4 text-gray-700">1152 Wh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cycles to 80%</td>
                    <td class="px-4 py-4 text-gray-700">4,000</td>
                    <td class="px-4 py-4 text-gray-700">4,000</td>
                    <td class="px-4 py-4 text-gray-700">3,500</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC output</td>
                    <td class="px-4 py-4 text-gray-700">1800W, X-Boost 2200W</td>
                    <td class="px-4 py-4 text-gray-700">1800W, 2700W Power Lifting</td>
                    <td class="px-4 py-4 text-gray-700">1800W, 2700W Power Lifting</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wall charging</td>
                    <td class="px-4 py-4 text-gray-700">1500W, full in 56 min</td>
                    <td class="px-4 py-4 text-gray-700">1200W, 80% in 45 min</td>
                    <td class="px-4 py-4 text-gray-700">1440W, 80% in 45 min</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solar input</td>
                    <td class="px-4 py-4 text-gray-700">1000W, 2 x 500W</td>
                    <td class="px-4 py-4 text-gray-700">1000W, 12-60V</td>
