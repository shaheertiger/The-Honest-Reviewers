                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">45L compressor fridge (350Wh/day)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Thermoelectric cooler (1,200Wh/day)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">256-300Wh</td>
