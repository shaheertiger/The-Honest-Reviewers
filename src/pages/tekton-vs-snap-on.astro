                  <td class="py-3 px-4 text-green-400">Swapped at the truck, no downtime</td>
                </tr>
                <tr class="border-b border-gray-800">
                  <td class="py-3 px-4 font-semibold text-white">Where it is made</td>
                  <td class="py-3 px-4">Taiwan and China to US spec</td>
                  <td class="py-3 px-4">Largely United States</td>
                </tr>
