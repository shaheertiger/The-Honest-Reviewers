const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ryobi ONE+ Battery Compatibility",
          item: "https://www.thehonestreviewers.com/are-ryobi-one-plus-batteries-interchangeable/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Are all Ryobi ONE+ batteries interchangeable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every battery carrying the ONE+ badge fits every tool carrying it, going back to the original blue nickel-cadmium packs from 1996. The voltage and physical interface have never changed across three chemistries. What varies is how much current a pack can deliver, which decides how well a demanding tool performs."
          }
        },
        {
          "@type": "Question",
          "name": "Do old blue Ryobi batteries work in new tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Physically yes, they fit every ONE+ tool. Practically they are poor in anything demanding, because nickel-cadmium delivers less current and most surviving blue packs are long past their useful life. They are fine for a work light or an inflator and unsuitable for a brushless saw."
          }
        },
        {
          "@type": "Question",
          "name": "Are Ryobi ONE+ and ONE+ HP batteries interchangeable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in both directions. HP packs are still 18-volt ONE+ batteries with the same interface; what differs is higher-output cells and electronics. An HP pack works perfectly in an older tool and often runs cooler. A standard pack works in an HP tool but cannot let it reach its rated performance."
          }
        },
        {
          "@type": "Question",
          "name": "Will a Ryobi 40V battery fit a ONE+ tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The 40V platform is Ryobi's separate outdoor power equipment line, and its batteries are physically and electrically incompatible with 18V ONE+. There is no adapter that should be used between them. Check both tool and battery for the ONE+ badge before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need HP batteries for HP tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To get the performance you paid for, yes. A brushless HP tool runs on a standard green pack but cannot draw the current its motor can accept, so it underperforms in demanding work. In a hard cut the difference is obvious rather than marginal. For drills and drivers, a standard pack is perfectly adequate."
          }
        },
        {
          "@type": "Question",
          "name": "Can I charge a lithium Ryobi battery on an old charger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the charger is marked as dual chemistry. Chargers made for the original nickel-cadmium packs lack the circuitry lithium requires and should not be used for it. Most chargers from the lithium era handle both chemistries, but check the label on any charger inherited with old tools."
          }
        },
        {
          "@type": "Question",
          "name": "Is a bigger amp-hour battery more powerful?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not directly — amp-hours measure how long a pack runs, not how hard it can push. Larger packs do often deliver more current because they contain more cells sharing the load, which helps in demanding tools, but for the hardest jobs the HP designation matters more than raw capacity. Bigger packs are also heavier and unbalance a compact drill."
