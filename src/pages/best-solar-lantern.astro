---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Battery Powered Lanterns",
    "url": "/best-battery-powered-lantern/"
  },
  {
    "title": "Best Solar Power Banks",
    "url": "/best-solar-power-bank/"
  },
  {
    "title": "Best Emergency Radios",
    "url": "/best-emergency-radio/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-charger-for-power-outages/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best Solar Lanterns in 2026: Panel Size, Sun Hours and Real Runtime";
const description =
  "The best solar lanterns for power outages and camping, with the sun-hours math behind each panel, USB backup charging, lumens vs runtime and phone charging.";

const PRODUCTS = [
  {
    "id": "luminaid-max-2-in-1",
    "name": "LuminAID Max 2-in-1 Inflatable Solar Lantern & Phone Charger",
    "category": "Inflatable, 2,000 mAh, USB-A Phone Charging",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "2,000 mAh battery with a USB-A output for phone top-ups",
      "LuminAID lists up to 50 hours of runtime on the lowest setting",
      "Waterproof and floats, packs flat for storage",
      "USB recharge of about 1 to 2 hours per retailer listings"
    ],
    "cons": [
      "Solar refill rated at 16 to 20 hours of direct sun, slower than the Luci range",
      "Brightness is listed as 150 lumens on LuminAID's spec table and 200 on the Amazon listing",
      "USB-C phones need an adapter cable"
    ],
    "bottomLine": "The best balance of light, battery and phone charging for an outage kit, as long as you start it full from USB.",
    "description": "The LuminAID Max is the lantern we would put in an outage bin first. It folds flat, twists open into a diffused cube, and holds a 2,000 mAh battery that can either run the light or push a top-up into a phone through its USB-A port. LuminAID's spec table lists 150 lumens at the top setting (the current Amazon listing says 200) and a maximum runtime of 50 hours on low. The solar panel on the top face is rated to refill the battery in 16 to 20 hours of direct sun, which is three or four clear days, and retailer listings put a USB recharge at 1 to 2 hours. LuminAID says it can deliver one phone charge; in practice a full 2,000 mAh pack will add roughly a third to half of a modern phone's battery. It is waterproof and floats. The trade-offs are the slower solar rate compared with BioLite's Luci models and a USB-A port in a USB-C world, but for a light that doubles as an emergency phone charger it is the most complete package here."
  },
  {
    "id": "biolite-luci-charge-150",
    "name": "BioLite Luci Charge 150 Solar Lantern",
    "category": "Inflatable, 2,000 mAh / 7.4 Wh, USB-C and USB-A",
    "badge": "Best USB-C Pick",
    "amazonUrl": "#",
    "pros": [
      "USB-C input plus USB-C and USB-A outputs",
      "BioLite rates solar recharge at about 14 hours, faster than the LuminAID Max",
      "IP67 waterproof, 6.1 ounces",
      "Up to 50 hours on low, about 6 hours on high at 150 lumens"
