                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">BioLite Luci Charge 360</td>
                    <td class="px-4 py-4 text-gray-700">4,000 mAh / 14.8 Wh</td>
