  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Generator Transfer Switch",
          item: "https://www.thehonestreviewers.com/generator-transfer-switch-types-cost-and-installation/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do I need a transfer switch for a portable generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You need one for any hardwired load — a furnace, sump pump or well pump has no plug for an extension cord. A transfer switch or interlock kit is also the only safe way to power household circuits, because it physically prevents generator power flowing back onto the utility lines.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a generator transfer switch cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Hardware costs are modest, and the labour dominates. An interlock kit is the cheapest route, a manual transfer switch with a sub-panel is moderate, and an automatic transfer switch as part of a standby installation is the most expensive. Add an outdoor inlet box and a permit fee in most jurisdictions.",
          },
        },
        {
          "@type": "Question",
          name: "Can I install a transfer switch myself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In most jurisdictions no, and it is not advisable in any case. Installation means working inside a live panel and altering the connection between your home and the grid, and a mistake can electrocute a utility worker. It legally requires a licensed electrician and an inspection in most places.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between a manual and automatic transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A manual switch requires you to start the generator and flip it yourself, and pairs with a portable. An automatic switch senses the outage, starts the generator and transfers the load within seconds with nobody present, and is part of a standby installation.",
          },
        },
        {
          "@type": "Question",
          name: "How many circuits should a transfer switch cover?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically six to twelve for a residential manual switch. Prioritise the furnace, refrigerator and freezer, a sump or well pump, one or two lighting circuits and the outlet feeding your internet. Leave off electric ranges, dryers and water heaters, which exceed most portable generators.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a permit for a transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In most jurisdictions yes, and the inspection is worth having rather than avoiding. It verifies that the isolation between generator and utility supply actually works, which is the one safety function the whole device exists to provide.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-09-01",
      dateModified: "2026-09-01",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
