---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best Dual Fuel Generators",
    "url": "/best-dual-fuel-generator/"
  },
  {
    "title": "How Much Propane Does a Generator Use?",
    "url": "/how-much-propane-does-a-generator-use/"
  },
  {
    "title": "Best Generators for Camping",
    "url": "/best-generator-for-camping/"
  },
  {
    "title": "Best Tri-Fuel Generators",
    "url": "/best-tri-fuel-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best Propane Generators in 2026: Ranked on Real LP Output";
const description =
  "The best propane powered generators ranked on published propane watts, 20 lb tank runtime and cold-weather behaviour, with why propane-only units are now rare.";

const PRODUCTS = [
  {
    "id": "westinghouse-igen2550dfc",
    "name": "Westinghouse iGen2550DFc",
    "category": "Dual Fuel Inverter, 1,700W Running on Propane",
    "badge": "Best Small Propane Generator",
    "amazonUrl": "#",
    "pros": [
      "Westinghouse publishes propane ratings: 2,300 peak and 1,700 running watts",
      "About 43 lb dry, the lightest propane-capable unit here",
      "Rated as low as 52 dBA",
      "TT-30R RV outlet, 20A duplex and two USB ports",
      "CO sensor and parallel capability"
    ],
    "cons": [
      "1,700 propane running watts is essentials only",
      "Propane runtime figures are published without a stated tank size"
    ],
    "bottomLine": "The best small propane powered generator: clear published LP ratings, a weight one person can carry and an RV outlet built in.",
    "description": "The iGen2550DFc is our top small pick because Westinghouse does what too many brands skip and publishes separate propane ratings: 2,300 peak and 1,700 running watts on LP, against 2,550 and 1,900 on gasoline. That is a derate of about 10 percent on running watts, which is typical, and it is enough for a refrigerator, lights, a router and phone charging at home, or a trailer's converter and small appliances at a campsite. Westinghouse lists the dry weight at 43.2 lb and rates it as low as 52 dBA, so it is one of the few propane-capable generators that is genuinely portable and quiet. The panel has a TT-30R 30 amp RV outlet, a 20 amp duplex and two USB ports. Westinghouse lists up to 20 hours at 50 percent load and 25 hours at 25 percent load on propane but does not say what tank size those figures assume, so do your own math from a 20 lb cylinder rather than relying on them. It has a CO sensor that shuts the engine down if carbon monoxide builds up, and it can be paralleled with a second Westinghouse inverter for more power. It is a dual fuel unit rather than propane-only, which we explain below: for this size class, that is the honest choice on today's market."
  },
  {
    "id": "westinghouse-igen5000dfc",
    "name": "Westinghouse iGen5000DFc",
    "category": "Dual Fuel Inverter, 3,500W Running on Propane",
    "badge": "Best Mid-Size Propane",
    "amazonUrl": "#",
    "pros": [
      "Westinghouse lists 4,500 peak and 3,500 running watts on propane",
      "Enough on LP for a fridge, sump pump, furnace blower and lights together",
      "Electric push-button and wireless remote start",
      "TT-30R RV outlet, 20A duplex and USB",
      "CO sensor; parallel capable on units with the communication port"
    ],
    "cons": [
      "About 106 lb dry on Westinghouse's page; it rolls rather than lifts",
      "Noise ratings differ between Westinghouse's page and the Amazon listing",
      "No 240V outlet, so it cannot feed a 240V well pump"
    ],
    "bottomLine": "The propane generator for most home backup: enough LP watts for the essentials, inverter-clean power and remote start, without a 200 lb machine.",
    "description": "The iGen5000DFc is the propane generator we would point most homeowners to. Westinghouse rates it at 5,000 peak and 3,900 running watts on gasoline and 4,500 peak and 3,500 running watts on propane. Those 3,500 propane running watts cover a refrigerator, a sump pump, a gas furnace blower, lights, a router and a television together, which is what most households need in an outage. Because it is an inverter, power is clean enough for electronics, and it throttles down at light load, which stretches a 20 lb cylinder further overnight than an open-frame generator would. It has electric push-button and wireless remote start, so in a storm you start it from indoors, plus a TT-30R RV outlet, a 20 amp duplex, USB ports and a CO sensor. Westinghouse's page lists it at about 106 lb dry, so it rides on wheels. Noise figures are inconsistent: Westinghouse's own page lists 52 dBA while the Amazon listing says as low as 61, and we would plan on the higher figure. Parallel capability depends on the unit having a communication port, which the Amazon listing says not all do, so check the panel before buying a kit. It has no 240 volt outlet, so it cannot run a 240V well pump or feed a 240V transfer switch on both legs."
  },
  {
    "id": "westinghouse-wgen9500df",
    "name": "Westinghouse WGen9500DF",
    "category": "Dual Fuel Open Frame, 8,500W Running on Propane, 50A",
    "badge": "Best Large Propane",
    "amazonUrl": "#",
    "pros": [
      "Westinghouse lists 11,200 peak and 8,500 running watts on propane",
      "Up to 7 hours on a 20 lb propane cylinder, per Westinghouse",
      "120/240V 50 amp and 30 amp outlets for a transfer switch",
      "Remote electric start",
      "Handles a well pump, furnace and window AC together"
    ],
    "cons": [
      "211 lb dry and rated at 74 dBA",
      "Empties a 20 lb cylinder in one evening; plan on a 100 lb cylinder or several 20s",
      "Not an inverter; plug sensitive electronics in through a surge protector"
    ],
    "bottomLine": "The propane generator for whole-panel home backup through a transfer switch, as long as you plan propane storage to match its appetite.",
    "description": "When the job is backing up a house through a transfer switch, the WGen9500DF is the propane-capable portable we would buy. Westinghouse rates it at 12,500 peak and 9,500 running watts on gasoline, and 11,200 peak and 8,500 running watts on propane, roughly a 10 percent running derate. That 8,500 is enough for a 240 volt well pump, a furnace, a refrigerator, a freezer and a window air conditioner together. The panel includes a 120/240V 50 amp outlet and a 120/240V 30 amp locking outlet for a transfer switch or inlet box, plus four 20 amp GFCI household outlets, and it has remote electric start. Westinghouse lists up to 7 hours on a 20 lb propane cylinder and up to 12 hours on its 6.6 gallon gasoline tank. That cylinder figure is the important one: a machine this size will burn through a 20 lb tank in an evening, so if you plan to run on propane through a multi-day outage, budget for a 100 lb cylinder or several 20s and the regulator to suit. It is heavy at 211 lb dry and loud at 74 dBA, and it is a conventional open-frame generator rather than an inverter. It is a dual fuel unit, and at this size that is a strength: gasoline is the backup if a tank freezes up or runs dry in the middle of the night."
  },
  {
    "id": "champion-200988-4500-dual-fuel",
    "name": "Champion 200988 4500-Watt Dual Fuel Inverter",
    "category": "Dual Fuel Inverter, 3,150W Running on Propane, TT-30R",
    "badge": "Best for RV on Propane",
    "amazonUrl": "#",
    "pros": [
      "About 3,150 running watts on propane, enough for a 13,500 BTU camper AC",
      "TT-30R RV outlet",
      "Electric start",
      "Runs on the RV's existing propane supply with the right hose"
    ],
    "cons": [
      "Champion rates it at 61 dBA",
      "Close to 100 lb per the Amazon listing",
      "Several near-identical Champion model numbers make comparison shopping confusing"
    ],
    "bottomLine": "The propane generator for trailer owners who want to run air conditioning on LP without carrying gasoline.",
    "description": "Champion's 200988 is the pick for RV owners who already carry large propane tanks and want a generator that drinks from them. Champion rates it at 4,500 starting and 3,500 running watts on gasoline and about 3,150 running watts on propane, enough on LP alone to start and run a 13,500 BTU rooftop air conditioner along with the converter and a few small loads. It has a TT-30R outlet for a direct trailer connection and electric start, and it uses a 212cc engine. As an inverter, it throttles down when the air conditioner cycles off, which helps propane runtime. The downsides are the ones that come with this size of inverter. Champion rates it at 61 dBA, which is louder than the Westinghouse inverters here and over some campground limits, and the Amazon listing puts it at close to 100 lb, so it rides on its wheels. Champion sells several closely related models under numbers such as 200991 and 201319, so check exactly which one a listing is selling. It is dual fuel, not propane-only, and for RV use that is useful: when the onboard tank is low on a long trip, gasoline from any station keeps it running. If you want propane-fed air conditioning for a trailer and do not need the Westinghouse's remote start or extra watts, this is the cheaper way to get it."
  },
  {
    "id": "champion-2500-dual-fuel",
    "name": "Champion 201323 2500-Watt Dual Fuel Inverter",
    "category": "Dual Fuel Inverter, 1,850W Running (Gas)",
    "badge": "Best Budget Propane",
    "amazonUrl": "#",
    "pros": [
      "2,500 starting and 1,850 running watts on gasoline; runs on propane too",
      "About 43 lb per retailer listings",
      "CO Shield automatic shutoff",
      "Champion advertises cold start technology",
      "3-year limited warranty"
    ],
    "cons": [
      "We could not confirm Champion's exact propane rating for this model number",
      "No TT-30R outlet",
      "Essentials-only output on propane"
    ],
    "bottomLine": "A cheaper small propane portable generator for light loads, if you can live without the Westinghouse's published LP figures and RV outlet.",
    "description": "The 201323 is the budget route to a small propane portable generator. Champion rates it at 2,500 starting and 1,850 running watts on gasoline, and it runs on propane from a standard cylinder with lower output, as every dual fuel engine has. Earlier versions of this Champion 2,500 watt dual fuel inverter were rated at 1,665 running watts on propane, but we could not confirm the exact propane rating for the current 201323, so treat roughly 1,600 to 1,700 watts as a planning figure and check the label. That is enough for a refrigerator, lights and electronics, or a campsite's charging and small appliances. It has an 80cc engine, Champion's CO Shield shutoff, and cold start technology, which matters for propane in particular because cold weather makes small engines and small cylinders harder to work with. Retailers list it at about 43 lb. The panel has a covered 120V 20 amp outlet, a 12V outlet and a USB adapter, but no RV outlet. It usually costs less than the Westinghouse iGen2550DFc, and the Westinghouse is the better generator for the money if you need its RV outlet or want a published propane rating. Pick the Champion if price is the deciding factor and your loads are light."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Propane Generator",
          item: "https://www.thehonestreviewers.com/best-propane-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Are propane-only generators still sold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Very few. Generac's LP-series propane-only portables are discontinued, and when we checked, Sun Joe's SJG4100LP propane-only portable was listed as unavailable on both Amazon and Sun Joe's store. Small specialist brands sell 1,000 watt propane-only units elsewhere. Most buyers today get a dual fuel generator and run it on propane, keeping gasoline as a backup."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a generator run on a 20 lb propane tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on size and load. Westinghouse rates its large WGen9500DF at up to 7 hours per 20 lb cylinder. A mid-size portable typically gets around five to eight hours at moderate load, and a small inverter eight to twelve. Heavy loads cut those figures sharply, and exchange cylinders are often filled to only 15 lb."
          }
        },
        {
          "@type": "Question",
          "name": "Does a generator make less power on propane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Propane carries less energy per gallon than gasoline, so dual fuel generators are rated lower on propane, typically by about 10 percent on running watts. The Westinghouse WGen9500DF, for example, is rated at 9,500 running watts on gasoline and 8,500 on propane. Always size against the propane rating."
          }
        },
        {
          "@type": "Question",
          "name": "Is propane better than gasoline for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For storage and engine cleanliness, yes. Propane does not go stale, does not varnish carburettors and is safer to store in quantity. Gasoline makes more power, is easier to find after a storm in some areas and works better in extreme cold. That is why dual fuel, run on propane by default, is the best choice for most people."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a propane generator in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with planning. In freezing temperatures a small cylinder can struggle to supply vapour fast enough under heavy load, frosting over and losing pressure. Use a larger tank, such as a 100 lb cylinder, for bigger generators, keep it sheltered from wind, and never apply open flame. Electric start helps with cold starts."
          }
        },
        {
          "@type": "Question",
          "name": "Can I connect a portable generator to my house propane tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be done, but not with improvised fittings. A permanent house tank needs the correct regulator and an approved connection, normally installed by a propane supplier or licensed technician. A 100 lb cylinder is a simpler option for most portables; it usually connects with a longer hose or a propane-rated adapter matched to its valve."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between this and a dual fuel generator guide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our dual fuel roundup ranks machines mainly on gasoline output and whole-home backup. This guide ranks them on propane: published propane watts, propane runtime and cold-weather behaviour. If you plan to run mostly on propane, start here. If you plan to run mostly on gasoline, the dual fuel guide is the better fit."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "propane powered generator",
      "propane generator",
      "propane portable generator",
      "lp powered generator",
      "propane fueled generator",
      "lp generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Propane Generators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Five generators ranked on what they actually make on propane, not on gasoline, plus the tank math and cold-weather caveats that spec sheets leave out.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-igen2550dfc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 5 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 5 Propane Picks Reviewed</a>
          <a href="#propane-only" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Propane-Only vs Dual Fuel</a>
          <a href="#why-propane" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Why Propane</a>
          <a href="#derate" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The 10% Propane Derate</a>
          <a href="#tank-math" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. 20 lb Tank Runtime Math</a>
          <a href="#cold" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cold Weather Vapour Problems</a>
          <a href="#connections" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Hoses and Bigger Tanks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Sizing for Your House</a>
          <a href="#vs-standby" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Portable vs Standby</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A propane powered generator is the best answer to the one problem that kills most backup generators: fuel that went bad while it sat waiting. Propane keeps for years. The catch is that you get about 10 percent less power, a 20 lb tank goes faster than you think, and true propane-only portables have nearly vanished from the market.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 5 Best Propane Generators, Ranked
          </h2>

          <p>
            We compared propane-capable generators from Westinghouse and Champion on published propane running and starting watts, propane runtime, weight, outlets, start type, CO shutdown and noise ratings, and checked which propane-only models are still actually for sale. All five picks are dual fuel units, for reasons explained in the first section below; we ranked them on propane, not gasoline. All figures are manufacturer ratings, and where a retailer and the manufacturer disagree we say so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} reviews)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
