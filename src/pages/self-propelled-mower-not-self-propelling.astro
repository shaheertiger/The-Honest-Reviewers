                    <td class="px-4 py-4 text-gray-700">About $15 to $30 per wheel</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clicking or grinding when engaged</td>
                    <td class="px-4 py-4 text-gray-700">Stripped pinion or wheel gear</td>
                    <td class="px-4 py-4 text-gray-700">A few dollars per gear</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Input pulley turns, axle does not</td>
                    <td class="px-4 py-4 text-gray-700">Failed transmission</td>
                    <td class="px-4 py-4 text-gray-700">Roughly $75 to $200 on many models</td>
                  </tr>
