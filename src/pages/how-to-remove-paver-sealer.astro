---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "How Long After Polymeric Sand Can You Seal?", url: "/how-long-after-polymeric-sand-can-you-seal-pavers/" },
    { title: "Paver Sand vs Play Sand", url: "/paver-sand-vs-play-sand/" },
    { title: "Paver Sealer vs Concrete Sealer", url: "/paver-sealer-vs-concrete-sealer/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-01", modified: "2026-09-01" });
const title = "How to Remove Paver Sealer That Is Peeling or Cloudy";
const description =
  "Chemical stripping is the practical method. Pressure washing alone rarely works and can damage joints. Here is the process and what it costs you.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "How-To Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Remove Paver Sealer",
          item: "https://www.thehonestreviewers.com/how-to-remove-paver-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do you remove paver sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Chemical stripping is the practical method. Apply a stripper formulated for the sealer chemistry you have, let it dwell for the specified time, agitate with a stiff brush or floor scrubber, then collect the residue with a wet vacuum. Thick or multi-coat build-up often needs a second pass.",
          },
        },
        {
          "@type": "Question",
          name: "Can you pressure wash paver sealer off?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not effectively. Pressure alone does not remove a cured sealer film, and the pressure required to make any impression strips joint sand and can etch softer pavers. Pressure washing is useful as the rinse stage after chemical stripping, not as the removal method itself.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to remove old paver sealer before resealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if it is failing. A sound film that has simply worn thin can be cleaned and recoated. Peeling, flaking, heavily clouded or yellowed sealer must be stripped, because a new coat bonds to the old film and fails along with it.",
          },
        },
        {
          "@type": "Question",
          name: "Will stripping paver sealer damage the joints?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It will affect them. Chemical strippers can soften polymeric sand binders and the agitation and rinsing stages wash joint material out. Plan on re-sanding at least some joints afterwards, and follow the sequence of strip, dry, re-sand, cure for about 30 days, then reseal.",
          },
        },
        {
          "@type": "Question",
          name: "How long after stripping can I reseal pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Allow several dry days for the pavers and joints to release the moisture that stripping introduces, and check the joints separately since they dry far more slowly. If you re-sand with polymeric sand, add the usual 30-day cure on top of that before sealing.",
          },
        },
        {
          "@type": "Question",
          name: "Can cloudy paver sealer be fixed without stripping?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sometimes, if it is a recently applied water-based sealer. A light application of the manufacturer’s recommended solvent or a xylene wipe can re-flow the film and clear the haze on some products. Test a small area first and check the technical data sheet — it does not work on every sealer.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to strip paver sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The stripper itself is a moderate material cost, but the labour dominates — clearing the patio, applying, dwelling, agitating, vacuuming residue and often repeating on stubborn areas is a weekend or more. Factor in re-sanding joints afterwards and the 30-day cure before resealing.",
          },
        },
        {
          "@type": "Question",
          name: "Is it worth stripping paver sealer or should I replace the pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Stripping is almost always the better economics. Pavers themselves are durable and rarely the problem — it is the film on top that has failed. Replacement means lifting, re-basing and re-laying, which is vastly more work than a strip and reseal even accounting for the joint work.",
          },
        },
        {
          "@type": "Question",
          name: "Can I strip paver sealer in cold weather?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most strippers have a working temperature range and perform poorly in the cold, with dwell times becoming unpredictable. More importantly, the drying and re-sanding that follow need warmth. Stripping is a warm-season job, and starting it in autumn usually means the resealing waits until spring.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Paver & Masonry Sealers",
    tags: [
      "how to remove paver sealer",
      "strip paver sealer",
      "paver sealer removal",
      "paver & masonry sealers",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Paver Sealers",
    link: "/best-paver-sealer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Restoration Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How to Remove <span class="text-[#38BDF8]">Paver Sealer</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Stripping is a real job with real risk to the joints beneath. It is also the only genuine fix for a failing or clouded sealer — recoating over one just fails twice.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#methods"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Removal Methods
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.5k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#do-you-need-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Do You Actually Need To?</a>
          <a href="#methods" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Removal Methods</a>
          <a href="#process" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Stripping Process</a>
          <a href="#joints" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Protecting the Joints</a>
          <a href="#after" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. After Stripping</a>
          <a href="#identify" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Identifying the Old Sealer</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Recoating over a sealer that is peeling or clouded does not fix it — the new film bonds to the failing one and lifts with it. Removal is the honest answer, and it is worth understanding the job before you commit to it.
        </p>

        <div id="do-you-need-to" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. First: Do You Actually Need to Strip It?
          </h2>

          <p>
            Stripping is the most invasive thing you can do to a sealed patio short of lifting it, so it is worth confirming it is genuinely necessary. Several problems that look like sealer failure have easier fixes.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What You See</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Diagnosis</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dull, worn finish, film intact</td>
                    <td class="px-4 py-4 text-gray-700">Normal wear</td>
                    <td class="px-4 py-4 text-gray-700">Clean and recoat; no stripping</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">White haze soon after sealing</td>
                    <td class="px-4 py-4 text-gray-700">Trapped moisture</td>
                    <td class="px-4 py-4 text-gray-700">Sometimes clears; a solvent wipe may fix water-based</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Efflorescence under the film</td>
                    <td class="px-4 py-4 text-gray-700">Mineral salts from the paver</td>
                    <td class="px-4 py-4 text-gray-700">Often needs stripping to reach it</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Peeling or flaking</td>
                    <td class="px-4 py-4 text-gray-700">Bond or build-up failure</td>
                    <td class="px-4 py-4 text-gray-700">Strip; recoating fails with it</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cloudy and blotchy throughout</td>
                    <td class="px-4 py-4 text-gray-700">Sealed over moisture or dirt</td>
                    <td class="px-4 py-4 text-gray-700">Strip</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Yellowed film</td>
                    <td class="px-4 py-4 text-gray-700">UV degradation of the sealer</td>
                    <td class="px-4 py-4 text-gray-700">Strip; the colour is in the film</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wrong finish for your taste</td>
                    <td class="px-4 py-4 text-gray-700">Cosmetic</td>
                    <td class="px-4 py-4 text-gray-700">Strip if you want to change to a different look</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Try the Easy Fix First on Fresh Haze</p>
            <p class="text-xl font-bold text-white mb-3">Some clouding in a water-based sealer will re-dissolve.</p>
            <p class="text-gray-300 leading-relaxed m-0">If a water-based sealer clouded recently, a light application of the manufacturer’s recommended solvent or a xylene wipe can sometimes re-flow the film and clear the haze without stripping. It is worth a test patch before committing to a full strip, and it works only on some products, so check the technical data sheet.</p>
          </div>
        </div>

        <div id="methods" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Three Removal Methods Compared
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Method</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Effectiveness</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Risk</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chemical stripper</td>
                    <td class="px-4 py-4 text-gray-700">High</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">The practical method for most sealers</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure washing alone</td>
                    <td class="px-4 py-4 text-gray-700">Low to moderate</td>
                    <td class="px-4 py-4 text-gray-700">High to joints</td>
                    <td class="px-4 py-4 text-gray-700">Rarely removes cured film; strips joint sand</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Mechanical grinding</td>
                    <td class="px-4 py-4 text-gray-700">High</td>
                    <td class="px-4 py-4 text-gray-700">High to pavers</td>
                    <td class="px-4 py-4 text-gray-700">Last resort; can damage the paver face</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Chemical Stripping</h3>

          <p>
            The standard approach and the one that actually works. A stripper formulated for masonry sealers is applied, left to dwell for the specified time so it can soften the film through its thickness, then agitated and rinsed or vacuumed away. Products differ substantially — some target solvent-based acrylics, some water-based, some both — so identifying what is on your pavers matters before you buy.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Pressure Washing Alone</h3>

          <p>
            Tempting and largely ineffective. Pressure alone does not remove a properly cured sealer film, and the pressure required to make any impression on it will strip the joint sand out first and can etch softer pavers. Pressure washing has a role as the rinse stage after chemical stripping, not as the stripping method itself.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Mechanical Grinding</h3>

          <p>
            A genuine last resort for stubborn coatings that resist chemical stripping. It removes the sealer and a thin layer of the paver surface with it, which changes the appearance permanently and can expose aggregate. Reserve it for situations where the alternative is replacing the pavers, and test in an inconspicuous area first.
          </p>
        </div>

        <div id="process" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. How to Strip Paver Sealer Step by Step
          </h2>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Identify the sealer if you can</p>
                <p class="text-gray-700 text-sm m-0">Water-based or solvent-based, film-forming or penetrating. Strippers are formulated for specific chemistries, and the wrong one wastes a day.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Test in an inconspicuous area</p>
                <p class="text-gray-700 text-sm m-0">A square foot in a corner. Confirm the stripper works, check dwell time, and see what it does to the paver colour before committing.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Protect the surroundings</p>
                <p class="text-gray-700 text-sm m-0">Cover plants, lawn and adjacent surfaces. Stripper runoff harms vegetation and can damage other finishes.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Apply the stripper and let it dwell</p>
                <p class="text-gray-700 text-sm m-0">Follow the label timing exactly. Too short and the film is only softened at the surface; too long and some products dry out and become harder to remove.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Agitate the softened film</p>
                <p class="text-gray-700 text-sm m-0">A stiff brush or a floor scrubber works the stripper into the film and lifts it. This step does much of the actual work.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Remove the residue</p>
                <p class="text-gray-700 text-sm m-0">A wet vacuum is far better than hosing it across the patio, which redeposits dissolved sealer as it dries and can leave a film worse than the original.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">7</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Rinse and neutralise if required</p>
                <p class="text-gray-700 text-sm m-0">Some strippers need neutralising. Check the label. Residual stripper interferes with whatever you apply next.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">8</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Assess and repeat if needed</p>
                <p class="text-gray-700 text-sm m-0">Thick or multi-coat build-up frequently needs two passes. A second application on the stubborn areas is normal, not a sign of failure.</p>
              </div>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Collect the Residue, Do Not Hose It Away</p>
            <p class="text-xl font-bold text-white mb-3">Dissolved sealer redeposits as it dries.</p>
            <p class="text-gray-300 leading-relaxed m-0">Rinsing stripper across the patio and into a drain spreads dissolved sealer over the surface, where it dries back into a patchy film that is harder to remove than what you started with. It is also an environmental and often a regulatory problem. Use a wet vacuum and dispose of the residue properly.</p>
          </div>
        </div>

        <div id="joints" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Stripping Does to Your Joints
          </h2>

          <p>
            This is the part people are unprepared for. Stripping is hard on joint sand, and you should plan for the joints as part of the project rather than treating them as collateral damage.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Chemical strippers can soften or degrade polymeric sand binders, particularly with long dwell times.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The agitation and rinsing stages wash joint material out, especially where the sand had already eroded.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A pressure-washed rinse will strip joints aggressively if the pressure is not kept low.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Joints saturated during stripping stay wet for days, which delays everything that follows.</span>
            </li>
          </ul>

          <p>
            The realistic expectation is that you will be re-sanding at least some joints after a full strip, and possibly all of them. That is not a failure of the process — it is simply the shape of the job, and building it into the plan means the correct sequence follows naturally.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Correct Order After Stripping</h3>

          <p>
            Strip, clean, let everything dry, re-sand the joints, let the polymeric sand cure for about 30 days, then reseal. That last interval is the one people compress after all the effort of stripping, and sealing over sand that is still releasing moisture reproduces exactly the cloudy finish that may have prompted the strip in the first place.
          </p>
        </div>

        <div id="after" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Resealing After a Strip
          </h2>

          <p>
            A stripped patio is effectively a new installation as far as sealing goes, and it deserves the same care.
          </p>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Let the pavers dry thoroughly</p>
                <p class="text-gray-700 text-sm m-0">Stripping saturates everything. Allow several dry days, and check joints as well as the surface, which dry at very different rates.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Deal with efflorescence now</p>
                <p class="text-gray-700 text-sm m-0">Stripping often exposes mineral bloom that was trapped under the old film. Treat it with an efflorescence cleaner before it goes back under a new one.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Re-sand the joints</p>
                <p class="text-gray-700 text-sm m-0">Into dry joints at proper depth, watered correctly, with the paver faces cleared before watering.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Wait about 30 days for the sand to cure</p>
                <p class="text-gray-700 text-sm m-0">Then test with clear plastic taped over a joint overnight. Condensation means wait longer.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Choose your sealer deliberately</p>
                <p class="text-gray-700 text-sm m-0">A strip is the natural opportunity to change finish. Decide between penetrating and film-forming, and matte or wet look, now rather than later.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Apply thin and even in good weather</p>
                <p class="text-gray-700 text-sm m-0">One coat at the recommended coverage rate, in the product’s temperature range, with a dry window afterwards.</p>
              </div>
            </div>
          </div>

          <p>
            One genuine upside worth mentioning: stripping gives you a free choice of finish. If the old sealer was a high-gloss wet look you have come to dislike, or a film-forming product that kept clouding, this is the moment to move to a penetrating sealer that will not build film or yellow. Having done the hard part, it would be a shame to reapply the product that caused the problem.
          </p>
        </div>

        <div id="identify" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Identifying What Sealer You Are Removing
          </h2>

          <p>
            Strippers are formulated for particular chemistries, and buying the wrong one wastes a day and a container of product. If you did not apply the sealer yourself, these tests narrow it down.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Test</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Result</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Indicates</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Xylene on a cotton swab</td>
                    <td class="px-4 py-4 text-gray-700">Film softens or becomes tacky</td>
                    <td class="px-4 py-4 text-gray-700">Solvent-based acrylic</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Xylene on a cotton swab</td>
                    <td class="px-4 py-4 text-gray-700">No change</td>
                    <td class="px-4 py-4 text-gray-700">Water-based, urethane or penetrating</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Denatured alcohol</td>
                    <td class="px-4 py-4 text-gray-700">Film softens</td>
                    <td class="px-4 py-4 text-gray-700">Water-based acrylic</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Water droplet</td>
                    <td class="px-4 py-4 text-gray-700">Beads on a visible film</td>
                    <td class="px-4 py-4 text-gray-700">Film-forming sealer of some kind</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Water droplet</td>
                    <td class="px-4 py-4 text-gray-700">Beads with no visible film</td>
                    <td class="px-4 py-4 text-gray-700">Penetrating sealer</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Visible gloss or sheen</td>
                    <td class="px-4 py-4 text-gray-700">Present</td>
                    <td class="px-4 py-4 text-gray-700">Film-forming</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Penetrating Sealers Are a Different Problem</h3>

          <p>
            If your testing suggests a penetrating sealer, be aware that stripping is much harder and often not fully achievable — there is no surface film to lift, because the product is inside the pore structure of the paver. Fortunately penetrating sealers rarely need removing, since they do not peel, cloud or yellow the way films do. If the issue is that you want to change to a film-forming look, expect a thorough cleaning and a compatibility test rather than a strip.
          </p>

          <p>
            Where you genuinely cannot identify the product, work from the mildest option upward. Try the gentlest stripper rated for masonry first on a test patch, and escalate only if it fails. Starting with the most aggressive product risks damage you did not need to accept.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            7. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Recoating Over a Peeling Sealer</h3>
              <p class="text-gray-700 text-sm m-0">
                A new coat bonds to the failing film beneath it and lifts along with it, so you have spent time and money to arrive at the same problem with an extra layer on top. Peeling, flaking or heavily clouded sealer has to come off before anything new goes down.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Trying to Pressure Wash the Sealer Off</h3>
              <p class="text-gray-700 text-sm m-0">
                Pressure alone does not remove a cured sealer film, and the pressure needed to make any impression will strip joint sand out and can etch softer pavers. Pressure washing belongs at the rinse stage after chemical stripping, not as the stripping method.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Hosing Stripper Residue Across the Patio</h3>
              <p class="text-gray-700 text-sm m-0">
                Dissolved sealer carried across the surface redeposits as it dries, leaving a patchy film that is harder to remove than the original. It is also an environmental and often regulatory problem. Collect the residue with a wet vacuum and dispose of it properly.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Not Planning to Re-Sand the Joints</h3>
              <p class="text-gray-700 text-sm m-0">
                Strippers soften polymeric sand binders and the agitation and rinsing stages wash joint material out. Expect to re-sand at least some joints and possibly all of them, and build that into the plan so the sequence — strip, dry, sand, cure, seal — follows in the right order.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Resealing Too Soon After Stripping</h3>
              <p class="text-gray-700 text-sm m-0">
                Stripping saturates the pavers and the joints, and joints in particular hold that moisture for days. Sealing over it traps the moisture under the new film and produces the cloudy finish that may well have been why you stripped in the first place. Allow several dry days, and 30 days after re-sanding.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you remove paver sealer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Chemical stripping is the practical method. Apply a stripper formulated for the sealer chemistry you have, let it dwell for the specified time, agitate with a stiff brush or floor scrubber, then collect the residue with a wet vacuum. Thick or multi-coat build-up often needs a second pass.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you pressure wash paver sealer off?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Not effectively. Pressure alone does not remove a cured sealer film, and the pressure required to make any impression strips joint sand and can etch softer pavers. Pressure washing is useful as the rinse stage after chemical stripping, not as the removal method itself.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I need to remove old paver sealer before resealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Only if it is failing. A sound film that has simply worn thin can be cleaned and recoated. Peeling, flaking, heavily clouded or yellowed sealer must be stripped, because a new coat bonds to the old film and fails along with it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Will stripping paver sealer damage the joints?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It will affect them. Chemical strippers can soften polymeric sand binders and the agitation and rinsing stages wash joint material out. Plan on re-sanding at least some joints afterwards, and follow the sequence of strip, dry, re-sand, cure for about 30 days, then reseal.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long after stripping can I reseal pavers?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Allow several dry days for the pavers and joints to release the moisture that stripping introduces, and check the joints separately since they dry far more slowly. If you re-sand with polymeric sand, add the usual 30-day cure on top of that before sealing.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can cloudy paver sealer be fixed without stripping?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Sometimes, if it is a recently applied water-based sealer. A light application of the manufacturer’s recommended solvent or a xylene wipe can re-flow the film and clear the haze on some products. Test a small area first and check the technical data sheet — it does not work on every sealer.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to strip paver sealer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The stripper itself is a moderate material cost, but the labour dominates — clearing the patio, applying, dwelling, agitating, vacuuming residue and often repeating on stubborn areas is a weekend or more. Factor in re-sanding joints afterwards and the 30-day cure before resealing.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is it worth stripping paver sealer or should I replace the pavers?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Stripping is almost always the better economics. Pavers themselves are durable and rarely the problem — it is the film on top that has failed. Replacement means lifting, re-basing and re-laying, which is vastly more work than a strip and reseal even accounting for the joint work.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I strip paver sealer in cold weather?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Most strippers have a working temperature range and perform poorly in the cold, with dwell times becoming unpredictable. More importantly, the drying and re-sanding that follow need warmth. Stripping is a warm-season job, and starting it in autumn usually means the resealing waits until spring.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Paver Guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
