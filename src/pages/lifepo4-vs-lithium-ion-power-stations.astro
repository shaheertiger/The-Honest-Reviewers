    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Generators & Backup Power",
    tags: [
      "lifepo4 vs lithium ion",
      "power station battery",
      "LFP",
      "NMC",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Power Stations",
