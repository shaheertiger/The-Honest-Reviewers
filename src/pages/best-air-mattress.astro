---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Mattresses",
    "url": "/best-mattress/"
  },
  {
    "title": "Best Mattress Toppers",
    "url": "/best-mattress-topper/"
  },
  {
    "title": "Best Mattress Protectors",
    "url": "/best-mattress-protector/"
  },
  {
    "title": "Best Mattress Brands",
    "url": "/best-mattress-brands/"
  },
  {
    "title": "Mattress Prices and Deals",
    "url": "/mattress-prices-and-deals/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-26", modified: "2026-11-26" });
const title = "7 Best Air Mattresses in 2026: Pumps, Height and Holding Air";
const description =
  "The best air mattresses on Amazon from SoundAsleep, King Koil, Intex, Coleman and Bestway, compared on built-in pumps, height, weight capacity, queen vs twin size and how well they hold air, for guests and camping.";

const PRODUCTS = [
  {
    "id": "soundasleep-dream-series-queen",
    "name": "SoundAsleep Dream Series Queen Air Mattress",
    "category": "Queen, 19-in Raised, Built-In One-Click Pump, 40 Air Coils, 600 lb",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Patented one-click built-in pump inflates in under four minutes, per the listing",
      "19-inch double-height, dual-chamber design for a bed-like height",
      "40 internal air coils to keep the surface flat and firm",
      "Flocked top holds sheets and toppers; SureGrip bottom resists sliding",
      "80 x 60 x 19 inches and rated for up to 600 pounds"
    ],
    "cons": [
      "Needs a wall outlet for the built-in pump",
      "Heavier and bulkier to store than a low camping airbed",
      "Like any new PVC bed, it needs topping up over the first nights"
    ],
    "bottomLine": "The best air mattress for most homes: a tall, firm queen guest bed that inflates in minutes and stays put on hard floors.",
    "description": "If you need one air mattress that will spend most of its life in a closet and come out for holidays and visiting family, the SoundAsleep Dream Series is the one to buy. It is a queen guest bed that SoundAsleep lists at 80 by 60 by 19 inches with a 600-pound weight capacity, so two adults fit and the sleeping surface sits closer to a real bed than a floor mattress. The spec that matters most for a guest bed is how flat it stays, and here SoundAsleep relies on 40 internal air coils, which it says keep the surface firm and stable through the night rather than soft and saggy. Its patented one-click built-in pump is listed as inflating the bed in under four minutes and deflating it quickly, with easy firmness adjustment. Two practical details stand out. The flocked top helps stop sheets, blankets and toppers from shifting, and the SureGrip bottom helps stop the bed sliding on hardwood or tile. The listing describes puncture-resistant multilayer PVC and includes a carry bag. The trade-offs are the usual ones for raised beds: the pump needs a wall outlet, it is bulkier to store than a camping airbed, and new PVC stretches, so expect to top it up after the first night. Buy the King Koil instead if you want faster inflation and a higher listed weight capacity."
  },
  {
    "id": "king-koil-queen",
    "name": "King Koil Queen Air Mattress with Built-in Pump (20-inch)",
    "category": "Queen, 20-in Raised, Patented 120V Pump, About 2 Minutes, 650 lb",
    "badge": "Fastest Inflation",
    "amazonUrl": "#",
    "pros": [
      "Patented 120V pump inflates the queen in about 2 minutes, per the listing",
      "650-pound capacity, the highest of our queen guest beds",
      "Coil-beam support with a patented reinforced edge frame",
      "0.65 mm flocked top and 18-gauge PVC sides and bottom",
      "1-year warranty and at least 50% GRS-certified recycled material"
    ],
    "cons": [
      "Needs a wall outlet",
      "80 x 60 inches: measure the room before ordering, as King Koil advises",
      "The maker says to top it off after the first night as the material relaxes"
    ],
    "bottomLine": "The quickest raised queen to set up, with the highest listed weight capacity and a reinforced edge.",
    "description": "King Koil is a long-established mattress brand, and its raised airbed is the pick when speed and capacity matter most. The listing describes a queen that measures 80 by 60 inches and stands 20 inches off the floor, about the height of a regular bed, with a patented 120V built-in pump that King Koil says inflates the bed in about 2 minutes and deflates it with the turn of a dial. There is no separate motor or hand pump to lose. Its 650-pound capacity is the highest of the queen guest beds in this guide, which matters when two adults share it or one heavier guest sits on the edge to get up. King Koil credits internal air coils and a patented reinforced peripheral frame for spreading weight evenly from edge to edge. Materials are listed in more detail than most: a 0.65 mm flocked top that keeps sheets in place, 18-gauge puncture-resistant, waterproof PVC sides and bottom, and cold-crack-resistant material for use in any season. It contains at least 50% recycled material certified to the Global Recycled Standard and comes with a carry bag and a 1-year warranty. The trade-offs: it needs an outlet, it needs a clear 80-by-60-inch space, and King Koil itself tells buyers to top it off after the first night. Buy King Koil's 20-inch twin version instead for a single guest."
  },
  {
    "id": "intex-dura-beam-comfort-plush-queen",
    "name": "Intex Dura-Beam Comfort Plush 22-inch Queen Air Mattress (64417ED)",
    "category": "Queen, 22-in High-Rise, Built-In 110-120V Pump, About 4.75 Minutes, 600 lb",
    "badge": "Tallest Guest Bed",
    "amazonUrl": "#",
    "pros": [
      "22-inch bed height, the tallest in this guide",
      "Dual-layer air pocket system with a velvety top and sides",
      "Dura-Beam edge construction designed to resist sagging",
      "Built-in 110-120V pump inflates and deflates the bed",
      "600-pound capacity and a carry bag, per the listing"
    ],
    "cons": [
      "Approximate inflation time of 4.75 minutes is the slowest of the raised queens",
      "Length and width are not spelled out in the listing text",
      "Intex says the material stretches and the bed settles over 2-3 nights"
    ],
    "bottomLine": "The tallest raised queen here, for guests who want to sit down onto a bed rather than climb up off the floor.",
    "description": "Height is what makes an air mattress feel like a guest bed, and the Intex Comfort Plush is the tallest one in this guide at a listed 22 inches. That matters most for older guests or anyone who finds getting up from a low bed awkward, because they sit down onto it the way they would a regular bed. Intex builds it around its Dura-Beam system: horizontal beams made with Fiber-Tech construction, thousands of high-strength polyester fibers, which Intex says support the sleeper and help the edges resist sagging. A dual-layer air pocket system is described as contouring to the body, and the velvety top and sides are listed as soft to the touch and resistant to punctures and abrasions. A built-in 110-120V electric pump inflates and deflates the bed, with an approximate inflation time of 4.75 minutes, and the listed capacity is 600 pounds. A carry bag is included. Intex is unusually upfront about the issue that frustrates most new owners: the material stretches at first inflation, which can feel like a leak, and the bed fully settles within 2 to 3 nights. The trade-offs are the slower pump and a listing that gives height and capacity but not exact length and width, so check Intex's spec sheet. Buy the King Koil instead if quick setup matters more than the extra 2 inches."
  },
  {
    "id": "intex-dura-beam-deluxe-twin",
    "name": "Intex Dura-Beam Deluxe 18-inch Twin Air Mattress (64411ED)",
    "category": "Twin, 18-in Raised, Built-In 110-120V Pump, About 2.25 Minutes, 300 lb",
    "badge": "Best Twin",
    "amazonUrl": "#",
    "pros": [
      "Built-in 110-120V pump with an approximate 2.25-minute inflation time",
      "18-inch raised height in a twin footprint",
      "Dura-Beam Fiber-Tech construction with edge support",
      "Velvety top and sides, listed as puncture and abrasion resistant",
      "Carry bag included"
    ],
    "cons": [
      "300-pound capacity: one sleeper only",
      "Needs a wall outlet",
      "Expect stretching and top-ups over the first 2-3 nights, per Intex"
    ],
    "bottomLine": "A raised twin for one guest, a child's sleepover or a small room, with a quick built-in pump.",
    "description": "Not every spare room or home office has space for a queen, and a twin air mattress is often the better answer for one guest, a teenager on a sleepover or a small apartment. The Intex Dura-Beam Deluxe is our pick because it brings the same build as Intex's taller queens to a smaller footprint. It stands a listed 18 inches high, enough that a guest is not climbing up from the floor, and its built-in 110-120V electric pump has an approximate inflation time of 2.25 minutes. Intex lists a 300-pound weight capacity, which is the spec to check before you buy a twin, because it means one adult sleeper rather than two. The construction is Intex's Dura-Beam system: horizontally positioned beams with Fiber-Tech polyester fibers that Intex says give better full-body support and an edge that resists sagging, plus a dual-layer air pocket system and a velvety top and sides that resist punctures and abrasions. A carry bag is included. Like every new Intex bed, Intex says the material stretches at first inflation and settles within 2 to 3 nights, so top it up rather than assuming it leaks. The trade-offs: one sleeper only, and it needs an outlet. Buy the King Koil twin instead if you want a 20-inch height and a listed 350-pound capacity."
  },
  {
    "id": "coleman-supportrest-plus-pillowstop",
    "name": "Coleman SupportRest Plus PillowStop Double-High Airbed",
    "category": "Double-High, Built-In 120V Pump, PillowStop Raised Head, 600 lb",
    "badge": "Best for Camping With Power",
    "amazonUrl": "#",
    "pros": [
      "Built-in 120V pump for inflation and deflation",
      "Double-high height makes getting in and out easier",
      "PillowStop raised head keeps the pillow in place",
      "Supports up to 600 pounds, per the listing",
      "Factory-tested AirTight system, per Coleman"
    ],
    "cons": [
      "The listing does not state the size or exact height",
      "The 120V pump needs an outlet or a power station at camp",
      "A thin listing: check Coleman's spec sheet before you buy"
    ],
    "bottomLine": "A double-high airbed from a camping brand, for campsites with power, cabins and the spare room.",
    "description": "Coleman is the best-known name in camping gear, and the SupportRest Plus PillowStop is its double-high airbed for people who want a tall bed both at home and on campsites with electric hookups. The listing describes a built-in 120V pump for quick inflation and deflation, a double-high height that makes getting in and out easier, and a 600-pound capacity. Its signature feature is the PillowStop design, a raised head section that keeps the pillow from sliding off the end, which is a real annoyance on flat airbeds. Coleman also describes a factory-tested AirTight system and says the bed suits camping trips or a spare room. The reason it sits lower in our ranking is the listing itself. It is thin: the text does not state which bed size this is or the exact height in inches, so check Coleman's spec sheet and the size option on the page before you order, and make sure it fits your tent floor if camping is the plan. The other trade-off is power. A 120V pump needs an outlet, a campsite hookup or a portable power station; it will not run from a car's 12V socket without the right equipment. Buy the Bestway Tritech instead if your campsite has no power, or the SoundAsleep if the bed will mostly live at home."
  },
  {
    "id": "bestway-tritech-queen-battery-pump",
    "name": "Bestway Tritech 12-inch Queen Air Mattress with Built-in Battery Pump",
    "category": "Queen, 12-in, Built-In D-Cell Battery Pump, About 3 Minutes, 661 lb",
    "badge": "Best for Camping Without Power",
    "amazonUrl": "#",
    "pros": [
      "Built-in pump runs on 4 D-cell batteries: no outlet needed",
      "Listed inflation time of 3 minutes",
      "80 x 60 x 12 inches, sized for two adults",
      "661-pound weight capacity, per the listing",
      "Built-in pillow and Tritech material for indoor and outdoor use"
    ],
    "cons": [
      "Batteries are not included",
      "At 12 inches it is lower than the raised guest beds",
      "Tritech strength and air-retention figures are Bestway's own comparisons"
    ],
    "bottomLine": "A queen that inflates itself anywhere, with no outlet, hand pump or power station needed.",
    "description": "The problem with most built-in pumps is that they need a wall outlet, which is exactly what a tent site does not have. The Bestway Tritech solves that with a built-in pump that runs on four D-cell batteries and, per the listing, inflates the bed in 3 minutes. That makes it our pick for car camping without hookups, and also a sensible choice for a cabin, a backyard sleepover or an emergency bed during a power outage. The listing gives an inflated size of 80 by 60 by 12 inches, so it is a full queen that fits two adults, with a 661-pound weight capacity and a built-in pillow. At 12 inches it is lower than a raised guest bed, which suits most family tents better than a 20-inch bed that eats headroom. Bestway describes its Tritech construction as 18% stronger, 44% more stretch-resistant and able to retain 19% more air pressure than standard PVC. Those are the maker's own comparisons, not independent measurements, but they target the right problem: stretch is the main reason new airbeds feel soft after the first night. The trade-offs: batteries are not included, so pack fresh D cells and spares, and the lower height is less convenient for guests at home. Buy the Coleman SupportRest instead if your campsite has power and you want a taller bed."
  },
  {
    "id": "intex-classic-downy-queen",
    "name": "Intex Classic Downy Queen Airbed Set with 2 Pillows and Hand Pump",
    "category": "Queen, 8.75-in, No Built-In Pump, Double Quick Hand Pump Included, 600 lb",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "Hand pump included: inflates anywhere without power",
      "Two inflatable pillows included in the set",
      "Waterproof flocked top with wave beams, easy to clean",
      "Standard queen size works with fitted sheets, per the listing",
      "600-pound capacity and folds compactly"
    ],
    "cons": [
      "Hand pumping takes effort and time",
      "8.75 inches tall: a floor-level bed",
      "No built-in pump for quick top-ups in the night"
    ],
    "bottomLine": "The simplest, most compact queen airbed: a classic low mattress with a hand pump and pillows in the box.",
    "description": "Sometimes you just need a basic queen airbed that packs small, needs no power and costs little, and the Intex Classic Downy set is the long-running answer. Unlike every other pick in this guide, it has no built-in pump. Instead the set includes Intex's Double Quick hand pump and two inflatable pillows, so everything needed for a night on the floor comes in the box. The listing gives dimensions of 60 by 80 inches and an 8.75-inch thickness, with a 600-pound capacity, and says the standard queen size works with fitted sheets. Inside, wave beams shape the surface, and the flocked top is waterproof and easy to wipe clean. A 2-in-1 valve with an extra-wide opening is listed as making inflation and deflation quick, which matters more than usual when the pump is your own arms. Without a motor in the bed it folds more compactly than a raised airbed, which makes it the best fit here for car camping, a trunk or a small closet. The trade-offs are clear. Hand pumping a queen takes effort and several minutes, there is no quick top-up button at 2 a.m., and at under 9 inches it is a floor-level bed that is harder to get up from. Buy the Bestway Tritech instead if you want power-free inflation without the pumping."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Air Mattresses",
          item: "https://www.thehonestreviewers.com/best-air-mattress/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best air mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the SoundAsleep Dream Series Queen is the best air mattress. Its listing gives a 19-inch raised height, 40 internal air coils, a one-click built-in pump that inflates it in under four minutes and a 600-pound capacity. Choose the King Koil for faster inflation, or the Bestway Tritech for camping without power."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best air mattress for guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A raised queen with a built-in pump. The SoundAsleep Dream Series, King Koil and Intex Comfort Plush stand 19 to 22 inches tall, inflate in minutes from an outlet and take standard queen sheets. For one guest in a small room, the Intex Dura-Beam Deluxe twin offers an 18-inch height with a quick built-in pump."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best air mattress for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One that inflates without mains power and fits your tent. The Bestway Tritech queen has a built-in D-cell battery pump and a 12-inch height, and the Intex Classic Downy includes a hand pump. If your site has electric hookups, a double-high bed like the Coleman SupportRest is also an option."
          }
        },
        {
          "@type": "Question",
          "name": "How do I keep my air mattress from deflating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stretch a new bed in by inflating it a day early and topping it up, inflate it in the room where it will be used, avoid overinflating, check that the valve is fully closed and keep it on a clean floor away from sharp objects. If it still loses air after a few nights, look for a leak."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my new air mattress lose air the first night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "New PVC stretches when it is first inflated, so the bed feels softer even without a leak. Intex says its beds settle within 2 to 3 nights, and King Koil advises topping off after the first night. Cooler night temperatures also make the air contract. Re-inflate, and the softening should shrink each night."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to inflate an air mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With a built-in pump, about 2 to 5 minutes for a queen by the makers' figures: about 2 minutes for the King Koil, under 4 for the SoundAsleep and about 4.75 for the 22-inch Intex. Battery pumps take a similar time, like the Bestway's listed 3 minutes, while hand pumps take longer and some effort."
          }
        },
        {
          "@type": "Question",
          "name": "Is a queen or twin air mattress better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A queen, about 80 by 60 inches, suits two adults and takes standard queen sheets, so it is the better all-round guest bed. A twin suits one sleeper, a child or a small room and is easier to store, but twin capacities run around 300 to 350 pounds. Measure the room before choosing either."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Bedroom & Sleep",
    tags: [
      "best air mattress",
      "best air mattress for guests",
      "best air mattress for camping",
      "best guest bed air mattress",
      "best air mattress with built in pump",
      "best queen air mattress",
      "best twin air mattress"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Air Mattresses</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A good air mattress inflates in minutes, stands at bed height and is still firm in the morning. Seven air mattresses on Amazon, from raised guest beds to camping airbeds that need no outlet.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#soundasleep-dream-series-queen"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Guest Bed or Camping?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Guest, Camping or Classic</a>
          <a href="#pumps" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Pump Types and Inflation Time</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Air Mattresses</a>
          <a href="#guests" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. For Guests</a>
          <a href="#camping" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. For Camping</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Queen vs Twin</a>
          <a href="#holds-air" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Does It Hold Air?</a>
          <a href="#deflating" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Stop It Deflating</a>
          <a href="#leaks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Find and Fix a Leak</a>
          <a href="#setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Make It a Real Guest Bed</a>
          <a href="#everyday" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Everyday Use</a>
