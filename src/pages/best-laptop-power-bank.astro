---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-charger-for-power-outages/"
  },
  {
    "title": "Best Power Banks for Travel",
    "url": "/best-power-bank-for-travel/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best EcoFlow Power Stations",
    "url": "/best-ecoflow-power-station/"
  },
  {
    "title": "Best Anker Power Stations",
    "url": "/best-anker-power-station/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How Long Does It Take to Charge a Portable Power Station?",
    "url": "/how-long-does-it-take-to-charge-a-portable-power-station/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Laptop Power Banks in 2026: Wattage-Matched Picks";
const description =
  "The 7 best laptop power banks in 2026, matched to your laptop's wattage: 100W and 140W USB-C banks for MacBooks, plus an AC-outlet pick for gaming laptops.";

const PRODUCTS = [
  {
    "id": "anker-laptop-power-bank-25k-165w",
    "name": "Anker Laptop Power Bank (25K, 165W, Built-In Retractable Cables)",
    "category": "25,000mAh (90Wh), 165W, Two Built-In USB-C Cables",
    "badge": "Best Overall Laptop Bank",
    "amazonUrl": "#",
    "pros": [
      "Up to 100W per built-in USB-C cable, full speed for most 13- to 15-inch laptops",
      "Two built-in cables plus extra USB-C and USB-A ports",
      "About 90Wh, carry-on legal without airline approval",
      "Display shows remaining capacity and live wattage",
      "Charges up to four devices at once"
    ],
    "cons": [
      "Built-in cables top out at 100W, short of a 16-inch MacBook Pro's 140W",
      "About 595g, heavy for a small bag"
    ],
    "bottomLine": "The most practical laptop bank for most people: full-speed charging for typical laptops and no cables to pack.",
    "description": "For most people charging a typical laptop, this is the bank to buy. The Anker Laptop Power Bank packs 25,000mAh, about 90Wh, behind two built-in USB-C cables: one retracts into the body and the other doubles as a carry strap. Each cable can deliver up to 100W, which is at or above what a MacBook Air, a 14-inch MacBook Pro on most configurations, a Dell XPS, a ThinkPad or a Surface Laptop draws from its own charger. That means the laptop charges at normal speed while you work, rather than merely slowing its drain. There is also a separate USB-C port and a USB-A port, so you can charge four devices at once, with total output reaching 165W across two devices and lower when all four are loaded. The screen shows remaining capacity and live wattage, which is the easiest way to tell whether your laptop is actually negotiating the power it needs. After conversion losses, 90Wh is roughly one full charge of a 50 to 70Wh laptop battery plus a phone, or close to two full charges of a MacBook Air. At 90Wh it stays under the 100Wh airline limit, so it is carry-on legal without approval. The limits are worth stating plainly. The built-in cables top out at 100W, so a 16-inch MacBook Pro or a 130W Dell XPS will charge more slowly than on its wall charger under load. And at about 595g it is not light. For the vast majority of laptops, though, it delivers full speed with zero cable management, which is exactly what you want from a laptop bank."
  },
  {
    "id": "anker-prime-power-bank-26k-300w",
    "name": "Anker Prime Power Bank (26K, 300W)",
    "category": "26,250mAh (99.75Wh), 300W Total, 140W per USB-C",
    "badge": "Best for MacBook Pro 16 and Two Laptops",
    "amazonUrl": "#",
    "pros": [
      "Up to 140W on each USB-C port via PD 3.1",
      "300W total output charges two laptops at full speed",
      "99.75Wh, the maximum carry-on capacity without airline approval",
      "Fast recharge, faster still with the optional charging base",
      "Per-port wattage readout on the display"
    ],
    "cons": [
      "Expensive compared with banks that cover most laptops",
      "Needs a 240W-rated cable to get 140W"
    ],
    "bottomLine": "The only pocketable bank here that charges a 140W laptop at full speed with headroom for a second machine.",
    "description": "If your laptop draws more than 100W, this is the bank that keeps up. The Anker Prime 26K is rated at 26,250mAh, which is 99.75Wh, the most energy you can carry onto most flights without airline approval. Each of its two USB-C ports can deliver up to 140W using USB PD 3.1 Extended Power Range, and total output reaches 300W across three ports. In practice that means a 16-inch MacBook Pro charges at its full 140W rate, and a second laptop or a tablet can charge at high speed at the same time. Few power banks can do that. A display shows remaining capacity and per-port wattage, which helps confirm that a demanding laptop is getting the full 140W rather than falling back to 100W because of a cable. Speaking of which, you need a USB-C cable rated for 240W to get 140W from a single port; an ordinary 100W cable caps it. Recharging is fast, and the optional charging base raises input further. Independent tests have measured usable output in the 80 to 90Wh range, which is typical after conversion losses, so expect about one full charge of a 16-inch MacBook Pro's 100Wh battery under light use, or more than one charge of a smaller laptop. At around 600g it is about the same weight as other 25K banks. The real drawback is price: it costs substantially more than the Anker 25K or the UGREEN. If your laptop draws 100W or less, you are paying for headroom you will not use. For 140W machines and people who charge two laptops at once, it is the best laptop power bank available."
  },
  {
    "id": "cuktech-20-power-bank",
    "name": "CUKTECH 20 Power Bank",
    "category": "25,000mAh (90Wh), 210W Total, 140W USB-C",
    "badge": "Best High-Output Value",
    "amazonUrl": "#",
    "pros": [
      "140W from a single USB-C port with PD 3.1",
      "210W combined output across three ports",
      "Fast input for quick refills",
      "Large display shows per-port power",
      "Usually priced below the Anker Prime"
    ],
    "cons": [
      "About 630g, the heaviest bank in this size class",
      "Shorter, chunkier can shape is awkward in slim laptop sleeves"
    ],
    "bottomLine": "A 140W-capable laptop bank for less than flagship money, if you do not mind the weight.",
    "description": "CUKTECH is the power brand spun out of the Xiaomi ecosystem, and the CUKTECH 20 has become a favorite among people who want 140W output without paying Anker Prime prices. It is rated at 25,000mAh, roughly 90Wh, so it is carry-on legal. One USB-C port delivers up to 140W using PD 3.1, enough for a 16-inch MacBook Pro at full speed, and total output across its two USB-C ports and one USB-A port reaches 210W. That is enough to charge a laptop at high speed and a phone and tablet at full speed together. Input is fast too, so a full refill takes far less time than budget banks that accept only 30 or 45W. The large display shows battery percentage and per-port wattage, which reviewers consistently praise for confirming exactly what each device is drawing. After conversion losses, expect roughly one full charge of a 70Wh laptop plus a phone. The tradeoffs are size and weight. At about 630g, it is heavier than the Anker 25K and Prime, and its short, thick can shape fits a backpack pocket well but bulges in a slim laptop sleeve. As with the Prime, you need a 240W-rated USB-C cable to get the full 140W on one port. Availability and pricing can vary more than with Anker, and support is less established in the U.S. For buyers who want 140W capability and strong total output at a lower price, it is the best value in the high-output class."
  },
  {
    "id": "ugreen-nexode-power-bank-25000-145w",
    "name": "UGREEN Nexode Power Bank 25,000mAh 145W",
    "category": "25,000mAh (90Wh), 145W Total, 140W USB-C",
    "badge": "Best Budget 140W Bank",
    "amazonUrl": "#",
    "pros": [
      "Up to 140W on its main USB-C port",
      "About 90Wh, carry-on legal",
      "Lighter than most 25K banks at about 513g",
      "Two USB-C and one USB-A port",
      "Typically the cheapest 140W-capable bank from a major brand"
    ],
    "cons": [
      "Slow input, so a full refill takes several hours",
      "Total output is only slightly above the single-port maximum"
    ],
    "bottomLine": "The cheapest reliable way to get 140W laptop charging, as long as you can recharge overnight.",
    "description": "The UGREEN Nexode is the budget route to 140W laptop charging from a brand with a solid track record. It is rated at 25,000mAh, about 90Wh, so it flies in a carry-on without approval. The main USB-C port delivers up to 140W, enough for a 16-inch MacBook Pro or a 130W Windows laptop, and the bank adds a second USB-C and a USB-A port with a combined output of 145W. That combined figure is the main limitation: when the laptop takes close to 140W, the other ports have little left, so a phone charges slowly alongside. For a single 65 to 100W laptop plus a phone, there is plenty to go around. At roughly 513g, it is lighter than the Anker and CUKTECH banks of similar capacity, and its flat shape slides into a laptop sleeve more easily than a can-shaped bank. A small display shows remaining charge. After conversion losses, expect about one full charge of a 70Wh laptop, or one and a half of a MacBook Air. The other compromise is recharge speed. Input is modest compared with the flagship banks, so a full refill takes a few hours rather than about one. That is fine if you charge overnight at a hotel or desk, but it is a real limitation on a short layover. There are no built-in cables, so pack a 240W-rated USB-C cable to get the full 140W. For students, commuters and anyone who wants high-wattage laptop charging on a budget, this is the one."
  },
  {
    "id": "baseus-blade-hd-100w",
    "name": "Baseus Blade HD 100W Laptop Power Bank",
    "category": "20,000mAh (74Wh), 100W USB-C, About 18mm Thick",
    "badge": "Slimmest Laptop Bank",
    "amazonUrl": "#",
    "pros": [
      "Flat, roughly 18mm-thick shape slides into a laptop sleeve",
      "100W USB-C covers most ultrabooks and 14-inch laptops",
      "About 74Wh, comfortably under airline limits",
      "Four ports: two USB-C, two USB-A",
      "Digital display shows remaining charge"
    ],
    "cons": [
      "Less capacity than 25K banks, about one laptop charge",
      "Wide footprint, roughly the size of a small tablet"
    ],
    "bottomLine": "The bank to get when a thick brick will not fit your bag: thin, 100W, and enough for one laptop charge.",
    "description": "Most laptop banks are thick bricks, and the Baseus Blade HD takes the opposite approach. It is wide and flat, roughly 18mm thick with a footprint closer to a small tablet, so it slides into a laptop sleeve or a document pocket where a 25K can-shaped bank would bulge. Baseus rates it at 20,000mAh, about 74Wh, with up to 100W from USB-C. That covers MacBook Airs, most 14-inch laptops, Chromebooks and the majority of Windows ultrabooks at full charging speed. There are two USB-C and two USB-A ports, so a phone and earbuds can charge alongside the laptop, and a digital display shows remaining capacity. At about 490g it is not much lighter than the bigger banks, because the flat format adds housing, but it carries better. After conversion losses, 74Wh delivers about one full charge of a 50 to 60Wh ultrabook battery, or most of a charge on a larger laptop, so think of it as a way to get through an afternoon or a long flight rather than a full day of heavy work. The limits are clear. At 100W it will not charge a 16-inch MacBook Pro or a 130W Windows laptop at full speed under load, and capacity is lower than the 25K banks above. Baseus is a larger brand than many on Amazon but has less support history than Anker or UGREEN in the U.S. For ultrabook users who value a slim bag over maximum capacity, it is the best fit."
  },
  {
    "id": "anker-737-power-bank-24k",
    "name": "Anker 737 Power Bank (PowerCore 24K)",
    "category": "24,000mAh (88.8Wh), 140W USB-C PD 3.1",
    "badge": "Proven 140W Workhorse",
    "amazonUrl": "#",
    "pros": [
      "140W USB-C with PD 3.1, among the first banks to support it",
      "About 88.8Wh, carry-on legal",
      "Smart display shows percentage and live wattage",
      "Two USB-C and one USB-A port",
      "Frequently discounted now that newer models exist"
    ],
    "cons": [
      "About 630g, heavy for its capacity",
      "Total output is shared, so two laptops will not both get 140W"
    ],
    "bottomLine": "An older but proven 140W bank that is worth buying when it is on sale below the newer models.",
    "description": "The Anker 737 was one of the first power banks to support USB PD 3.1 at 140W, and it remains a solid choice, especially when it is discounted below Anker's newer models. It is rated at 24,000mAh, about 88.8Wh, comfortably under the 100Wh carry-on limit. A single USB-C port can deliver up to 140W, so a 16-inch MacBook Pro charges at its full rate, and there is a second USB-C and a USB-A port for a phone or earbuds. Total output is shared, so connecting a laptop and other devices reduces what each gets, and it will not charge two laptops at full speed the way the Prime does. The side display shows remaining battery and live wattage in and out, which is the feature owners mention most because it removes guesswork about whether a laptop is truly charging. Recharging is fast with a 140W wall charger, so it refills in a couple of hours, much faster than budget banks. After conversion losses, expect about one full charge of a 70Wh laptop or a little more for a MacBook Air. The weight is the drawback: about 630g for under 90Wh, heavier than the UGREEN for similar capacity. Its can-like shape is also bulkier than flat banks. Newer banks like the Anker Prime and CUKTECH 20 beat it on total output, and the Anker 25K adds built-in cables. Buy the 737 when the price is right, and you will get a reliable 140W bank that has years of owner reports behind it."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow River 3",
    "category": "245Wh LiFePO4, 300W AC Outlets, 100W USB-C",
    "badge": "Best AC-Outlet Option",
    "amazonUrl": "#",
    "pros": [
      "True AC outlets run gaming laptops and barrel-plug chargers",
      "245Wh, about three times a 90Wh power bank",
      "LiFePO4 chemistry rated for thousands of cycles",
      "100W USB-C port for USB-C laptops",
      "Fast AC recharge in about an hour"
    ],
    "cons": [
      "Cannot fly: 245Wh is over the 160Wh airline maximum",
      "About 7.8 pounds, not a bag-carry device"
    ],
    "bottomLine": "For gaming laptops and barrel-plug chargers that no USB-C bank can feed, this is the practical answer, just not on a plane.",
    "description": "No USB-C power bank can run a 200W-plus gaming laptop at full power, and many workstation and gaming laptops still use barrel-plug chargers that cannot draw from USB-C at all. For those machines, you need an AC outlet, and the EcoFlow River 3 is the most sensible small option. It packs 245Wh of LiFePO4 capacity with AC outlets rated for 300W continuous, so you plug in your laptop's normal charger exactly as you would at home. A 180W or 230W gaming laptop charger runs comfortably under that limit. There is also a 100W USB-C port for regular laptops, USB-A ports and a car outlet. The LiFePO4 chemistry is rated for thousands of cycles, so it will last far longer than a typical power bank if you use it daily. It recharges from the wall in about an hour, and it can take solar input for camping or field work. Runtime math is simple: a gaming laptop averaging 120W while gaming runs for roughly 1.5 to 1.7 hours after inverter losses, while a 40W ultrabook under light work gets several full charges. Going through the AC inverter wastes 10 to 15 percent compared with direct USB-C, so use the USB-C port for any laptop that supports it. The hard limitation is travel. At 245Wh it is well above the 160Wh absolute airline maximum, so it cannot fly in carry-on or checked luggage, and at about 7.8 pounds it is a car or desk device, not a bag device. For gaming laptops on the road, at LAN events or in a car, it is the right tool."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Laptop Power Banks",
          item: "https://www.thehonestreviewers.com/best-laptop-power-bank/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size power bank do I need for a laptop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Match the bank's USB-C output to your laptop's charger wattage first, then pick capacity. Most people should buy a 20,000 to 26,000mAh bank, about 74 to 99Wh, which gives roughly one full laptop charge and stays under airline limits. A MacBook Air gets close to two charges from a 90Wh bank; a 16-inch MacBook Pro gets about one."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power bank charge a MacBook Pro 16?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, at full speed if the bank supports 140W over USB PD 3.1 and you use a 240W-rated cable. The Anker Prime, CUKTECH 20, UGREEN Nexode and Anker 737 all do. A 100W bank also charges it, just more slowly under heavy load. Expect about one full charge from a 90 to 99Wh bank after conversion losses."
          }
        },
        {
          "@type": "Question",
          "name": "Can I charge a gaming laptop with a power bank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only partly. Gaming laptops can draw 150 to 250W or more under load, which exceeds any USB-C bank. Models that accept USB-C charging will charge at idle or during light work from a 100 to 140W bank. For gaming away from an outlet, use an AC-outlet power station that runs the laptop's normal charger."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take a laptop power bank on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in carry-on only, if it is 100Wh or less, which covers banks up to about 27,000mAh. Banks from 101 to 160Wh need airline approval, with a limit of two. Over 160Wh is banned. Some airlines also restrict using power banks during flight, so check your carrier's current policy before relying on one to work onboard."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 65W power bank enough for a laptop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most ultrabooks, MacBook Airs and Chromebooks, yes. A 65W bank charges them at full or near-full speed. For a 14-inch MacBook Pro or similar 90 to 100W laptop, 65W will charge it during light work but may not keep up under heavy load. For 16-inch performance laptops, step up to a 140W bank."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a power bank with an AC outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if your laptop charges through a barrel plug instead of USB-C, or you need to run a gaming laptop's full charger. AC outlets waste 10 to 15 percent of energy in conversion and add weight, and the units that offer real AC power are generally too large to fly. For USB-C laptops, a USB-C bank is the better choice."
          }
        },
        {
          "@type": "Question",
          "name": "Why is my laptop charging slowly from a power bank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually one of three reasons: the bank's port delivers less wattage than the laptop wants, the cable is rated for only 60 or 100W, or other devices connected to the bank are sharing its total output. Check the bank's display for live wattage, use a 240W-rated cable, and unplug other devices to see if speed improves."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "laptop portable charger",
      "laptop portable power bank",
      "portable laptop battery charger",
      "laptop charger portable",
      "140w power bank",
      "power bank for macbook pro"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Laptop Power Banks</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A laptop power bank only works if its output matches your laptop. These are the banks that actually keep up, from 100W ultrabook packs to 140W MacBook Pro banks and an AC-outlet option for gaming laptops.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-laptop-power-bank-25k-165w"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Find Your Wattage
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 7 Top Picks Reviewed</a>
          <a href="#wattage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How Many Watts You Need</a>
          <a href="#pd-31" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. USB PD 3.1 and 140W</a>
          <a href="#macbook-vs-gaming" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. MacBook vs Gaming Laptops</a>
