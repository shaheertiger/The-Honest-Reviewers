                  <td class="py-3 px-4 font-semibold text-white">Sticks to wood, drywall, masonry</td>
                  <td class="py-3 px-4">Good</td>
                  <td class="py-3 px-4 text-green-400">Excellent</td>
                </tr>
                <tr class="border-b border-gray-800">
                  <td class="py-3 px-4 font-semibold text-white">Shrinkage</td>
                  <td class="py-3 px-4 text-green-400">Minimal</td>
                  <td class="py-3 px-4 text-yellow-400">Noticeable in deep joints</td>
                </tr>
                <tr class="border-b border-gray-800">
                  <td class="py-3 px-4 font-semibold text-white">Tooling and cleanup</td>
                  <td class="py-3 px-4 text-yellow-400">Fussy, solvent cleanup</td>
                  <td class="py-3 px-4 text-green-400">Easy, water cleanup</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-white">Recaulking over it</td>
                  <td class="py-3 px-4 text-red-400">Nothing bonds to it</td>
