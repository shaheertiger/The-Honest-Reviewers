---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 8000 Watt Generators",
    "url": "/best-8000-watt-generator/"
  },
  {
    "title": "Best 10,000 Watt Generators",
    "url": "/best-10000-watt-generator/"
  },
  {
    "title": "Generator Transfer Switch Types and Cost",
    "url": "/generator-transfer-switch-types-cost-and-installation/"
  },
  {
    "title": "Best Tri Fuel Generators",
    "url": "/best-tri-fuel-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 9500 Watt Generators in 2026: What 9,500 Peak Watts Really Buys";
const description =
  "The best 9500 watt generators, decoded: 7,500 running watts, a 30A or 50A transfer switch, central air limits and gas, propane or natural gas fuel math.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen7500c",
    "name": "Westinghouse WGen7500c Gas Portable Generator with CO Sensor",
    "category": "Open Frame, 7,500W Running / 9,500W Peak, Gasoline",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "7,500 running and 9,500 peak watts on gasoline per Westinghouse's spec sheet",
      "Remote key fob start plus push-button electric and recoil backup",
      "Up to 11 hours at 25% load from a 6.6 gallon tank",
      "Built-in CO sensor and transfer-switch-ready 30A twist-lock",
      "Simpler than a dual fuel unit, with one fuel system to maintain"
    ],
    "cons": [
      "Gasoline only, so you need a stabiliser and rotation routine",
      "About 197 pounds dry, a two-person lift"
    ],
    "bottomLine": "The plainest, most sensible way to buy a 9,500 peak watt generator: full 30-amp output, remote start and a CO sensor, without paying for fuel systems you will not use.",
    "description": "The WGen7500c is the gas-only sibling of the dual fuel WGen7500DFc, and for a lot of houses it is the better buy. Westinghouse rates it at 7,500 running and 9,500 peak watts, roughly 31 amps at 240 volts, which is enough to fill a 30-amp L14-30 transfer switch connection. The 6.6 gallon tank is rated for up to 11 hours at 25% load, and Westinghouse lists a dry weight of 197.1 pounds. Starting is the same three-way system as the more expensive models: a remote key fob, a push-button electric start and a recoil cord as backup. The c suffix means a built-in CO sensor that shuts the engine down if carbon monoxide builds up around it, and there is a fuel gauge on the tank. Retail listings show an L14-30R twist-lock, a TT-30R RV outlet and GFCI duplexes on the panel; confirm the layout against the listing photo before buying cords. What you give up is propane. If you already keep treated gasoline in rotation for a mower and a truck, that is no loss, and the money saved over a dual fuel or inverter unit buys a proper inlet box and cord."
  },
  {
    "id": "duromax-xp9500iht",
    "name": "DuroMax XP9500iHT 9,500-Watt Tri Fuel Inverter Generator",
    "category": "Inverter, 7,600W Running / 9,500W Peak, Gas / Propane / Natural Gas",
    "badge": "Best Tri Fuel Inverter",
    "amazonUrl": "#",
    "pros": [
      "7,600 running and 9,500 peak watts on gasoline per DuroMax",
      "Runs on gasoline, propane or a natural gas line",
      "Rated about 61 dB at 25% load, far quieter than open-frame units",
      "Up to 11 hours at 50% load on gasoline",
      "Remote electric start and CO alert shutdown"
    ],
    "cons": [
      "Costs roughly twice what an open-frame 9,500 watt unit does",
      "Natural gas output is lower than gasoline; check DuroMax's sheet for the derate"
    ],
    "bottomLine": "The one to buy if you have a natural gas service and want a quiet, clean-power generator that never needs a fuel run. Expensive, but nothing else here does all three fuels as an inverter.",
    "description": "The XP9500iHT is the tri fuel version of DuroMax's 9,500 watt inverter, which adds a natural gas connection to the gasoline and propane of the XP9500iH. DuroMax rates it at 7,600 running and 9,500 peak watts on gasoline and lists up to 11 hours at 50% load on a tank of gas. On natural gas every generator loses output, because the fuel carries less energy per cubic foot than propane, so treat the gasoline figure as the ceiling and plan your loads around the natural gas rating on DuroMax's spec sheet. Noise is rated at about 61 dB at 25% load, which puts it in a different class from the 70-plus dB open-frame units, and inverter output suits furnace control boards and electronics. Remote and electric start come standard, along with a CO alert that shuts the engine off. Retail titles describe 50-amp output and transfer switch readiness; remember that 7,600 running watts is about 32 amps at 240 volts whatever receptacle it comes out of. Some sellers will not ship it to a handful of states, so check that before you order. It is the most expensive generator here, and worth it mainly for the natural gas hookup and the quiet."
  },
  {
    "id": "champion-201277",
    "name": "Champion 201277 7500-Watt Dual Fuel Portable Generator with CO Shield",
    "category": "Open Frame, 7,500W Running / 9,375W Starting, Dual Fuel",
    "badge": "Best Dual Fuel Value",
    "amazonUrl": "#",
    "pros": [
      "7,500 running and 9,375 starting watts on gasoline",
      "6,750 running watts on propane",
      "439cc Champion engine with electric start",
      "CO Shield automatic shutdown",
      "Champion's family of these units carries an L14-30R twist-lock"
    ],
    "cons": [
      "Listed as 9,375, not 9,500, starting watts",
      "Retail listings disagree on weight, from about 205 to 230 pounds"
    ],
    "bottomLine": "The value dual fuel pick in this class: the same running watts as the 9,500 peak models for less money, with a propane option for storage.",
    "description": "Champion sells this as a 9,375 watt generator, which is its starting rating; the useful number is 7,500 running watts on gasoline, exactly what the 9,500 peak Westinghouse makes. On propane Champion rates it at 6,750 running and 8,400 starting watts, which is the usual 10% propane drop and still close to the 7,200 watts a 30-amp L14-30 cord carries. Power comes from a 439cc Champion engine with electric start, and CO Shield shuts the engine down if carbon monoxide builds up. Champion's spec pages for this dual fuel family list a 120/240V L14-30R twist-lock, a 120V L5-30R and GFCI duplexes; check the 201277 listing photo to confirm before you buy a cord. Retail listings put the tank at 7.7 gallons and the weight anywhere from about 205 to 230 pounds, so expect over 200 either way. It has no remote start and it is an open-frame unit, so it is loud. What it offers is the full 30-amp running output on gas, a propane fallback, and Champion's wide dealer and parts network, at a price well under the inverters."
  },
  {
    "id": "pulsar-gd950bn",
    "name": "Pulsar GD950BN 9500W Dual Fuel Inverter Generator",
    "category": "Inverter, 7,600W Running / 9,500W Peak, Dual Fuel",
    "badge": "Best Budget Inverter",
    "amazonUrl": "#",
    "pros": [
      "7,600 running watts on gasoline and 7,200 on propane per the manual",
      "Inverter output for sensitive electronics",
      "Parallel capable with a compatible Pulsar inverter",
      "3-year manufacturer warranty",
      "Usually priced below the DuroMax and GENMAX inverters"
    ],
    "cons": [
      "Runtime figures conflict between listings; the conservative one is about 5 hours at half load",
      "Thin published spec detail compared with the bigger brands"
    ],
    "bottomLine": "The cheapest route to 7,600 running watts of inverter power on either fuel. Buy it with your eyes open on runtime and documentation.",
    "description": "Pulsar's GD950BN puts the same headline numbers as the DuroMax XP9500iH into a lower-priced dual fuel inverter. The user manual lists 9,500 peak and 7,600 running watts on gasoline and 8,550 peak and 7,200 running watts on propane, a small propane drop that lets it fill a 30-amp connection on either fuel. It is parallel capable with a compatible Pulsar inverter and carries a 3-year warranty. Where it falls short is documentation. Listings disagree on runtime, with one quoting about 5 hours at half load and another 8 hours, and we could not find a detailed outlet breakdown from Pulsar, so look at the panel photo on the listing and confirm it has the 120/240V twist-lock your transfer switch needs before you order. That is the trade: you pay less than for the DuroMax or GENMAX and you get clean inverter power at full 30-amp output, but with less certainty about how long a tank lasts. If you plan to run mostly on propane from a pair of 100 pound cylinders, the gasoline runtime matters less than it looks."
  },
  {
    "id": "genmax-gm9000ied",
    "name": "GENMAX GM9000iED 9000W Dual Fuel Inverter Generator",
    "category": "Inverter, 7,600W Running / 9,000W Peak, Dual Fuel",
    "badge": "Best 9000 Watt Inverter",
    "amazonUrl": "#",
    "pros": [
      "7,600 rated and 9,000 peak watts per the user manual",
      "Gasoline or propane, with remote start",
      "Listed at about 62 dB",
      "CO detection shutdown",
      "Parallel capable with a second GM9000iED"
    ],
    "cons": [
      "Peak rating is 500 watts lower than the 9,500 class on paper",
      "Weight and runtime are not clearly published"
    ],
    "bottomLine": "Shopping for a 9,000 watt inverter is shopping for the same 7,600 running watts as the 9,500 models. This is that generator with a lower peak number.",
    "description": "The GM9000iED shows why peak ratings mislead. GENMAX sells it as a 9,000 watt inverter, but its manual lists 7,600 rated watts, the same running output as the 9,500 watt DuroMax and Pulsar. The peak figure is 500 watts lower, which matters only in the half second a large motor is starting. It runs on gasoline or propane, starts from a remote or the electric start button, and has a CO detection system that shuts it down if carbon monoxide builds up. Retail listings give about 62 dB, similar to the DuroMax, and a 6.9 gallon tank for the closely related GM9000iEDC; we could not find a weight on GENMAX's material, so expect something in the 200 pound range like the rest of this class and plan on wheels. Two units can run in parallel for more output. Retail titles describe 50-amp output; as with the others, that is a receptacle rating, not 50 amps of power. If you find it priced below the DuroMax, it is the same useful output for less."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 9500 Watt Generator",
          item: "https://www.thehonestreviewers.com/best-9500-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will a 9500 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With 7,500 to 7,600 running watts, a 9,500 peak generator runs a refrigerator, chest freezer, gas furnace blower, a 1 horsepower well pump, a window air conditioner, lights and electronics at the same time, with room for a microwave used in turns. It will not run an electric water heater, range and central air together."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 9500 watt generator enough for a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For essentials, yes. Most homes need 4,500 to 6,500 running watts to keep the fridge, freezer, furnace, pump and lights on, which fits comfortably. It is not a whole-house generator for homes with electric heat, an electric water heater or central air without a soft starter."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 9500 watt generator run central air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, if the condenser has a soft starter. A 3-ton unit runs at about 3,500 watts but can surge past 9,000 watts at start-up without one. With a soft starter fitted and the rest of the load kept light at that moment, a 7,500 running watt generator can usually start it."
          }
        },
        {
          "@type": "Question",
          "name": "How much fuel does a 9500 watt generator use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Westinghouse rates its WGen7500c at 11 hours at 25% load on 6.6 gallons, about 0.6 gallons an hour. At half load expect roughly a gallon an hour from an open-frame unit. Inverters use less at light loads because the engine slows down, and propane use is higher by volume."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 30 amp or 50 amp transfer switch for a 9500 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 30-amp switch is the right match. It carries 7,200 watts at 240 volts, and these generators make 7,500 to 7,600 running watts, so you lose very little. A 50-amp switch only makes sense if you already own one or plan to move to a larger generator."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a 9000 watt inverter generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The GENMAX GM9000iED is sold as 9,000 watts and its manual lists 7,600 rated watts, the same running output as the 9,500 watt DuroMax and Pulsar inverters. The 500 watt difference is only in peak rating, which matters for a second or two when a large motor starts."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Westinghouse WGen9500DF a 9500 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in the sense this page uses. The WGen9500DF has 9,500 running watts and a 12,500 peak rating, so it belongs with the 12,000 watt class. The Westinghouse generators with a 9,500 peak rating are the WGen7500 models, including the WGen7500c and WGen7500DFc."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "9500 watt generator",
      "9500w generator",
      "9500 generator",
      "best 9500 watt generator",
      "9000 watt inverter generator",
      "7500 running watt generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">9500 Watt Generators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Nine thousand five hundred watts is the peak rating. The running number is 7,500 to 7,600, and that is what decides your transfer switch, your fuel bill and whether the air conditioner starts. Here are the five worth buying.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen7500c"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-9500-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 9,500 Watts Means</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#thirty-or-fifty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. 30A or 50A Switch</a>
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What It Runs</a>
          <a href="#inverter-or-open" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Inverter or Open Frame</a>
          <a href="#fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Fuel Choices</a>
          <a href="#buying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Buying Checklist</a>
          <a href="#vs-other-sizes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Size Up or Down?</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A 9,500 watt generator is the class where a portable stops feeling like a compromise: well pump, refrigerator, freezer, furnace and an air conditioner all running together, with surge left over for the pump to kick on. But the 9,500 on the box is a peak figure, and the generator underneath makes 7,500 to 7,600 watts all evening. Know that number and the rest of the buying decision gets simple.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-9500-means" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What a 9,500 Watt Generator Actually Is
          </h2>

          <p>
            A generator sold as 9,500 watts is almost never a 9,500 watt generator in the sense that matters. The number on the box is the peak, or starting, rating: the most the engine and alternator can push for the second or two it takes a compressor or pump motor to get spinning. The number that decides what you can run all evening is the running rating, and in this class it is 7,500 to 7,600 watts on gasoline. Westinghouse, DuroMax and Pulsar all build to that same 9,500 peak and 7,500 to 7,600 running pairing, and Champion's equivalent is sold as 9,375 watts with the same 7,500 running underneath.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Where the Class Sits</h3>

          <p>
            That puts the 9,500 watt class one step above the 8,000 watt bracket and one step below the 12,500 peak models such as the Westinghouse WGen9500DF, which confusingly carries 9500 in its model name because that is its running rating. If you searched for a 9,500 watt generator and meant 9,500 running watts, you want our <a href="/best-10000-watt-generator/">10,000 watt generator guide</a>, not this one. This page is about the much more common 7,500 running, 9,500 peak machine.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Running (gas)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Peak (gas)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Running (propane)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Westinghouse WGen7500c</td>
                    <td class="px-4 py-4 text-gray-700">7,500W</td>
                    <td class="px-4 py-4 text-gray-700">9,500W</td>
                    <td class="px-4 py-4 text-gray-700">n/a (gas only)</td>
                    <td class="px-4 py-4 text-gray-700">Open frame</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DuroMax XP9500iHT</td>
                    <td class="px-4 py-4 text-gray-700">7,600W</td>
                    <td class="px-4 py-4 text-gray-700">9,500W</td>
                    <td class="px-4 py-4 text-gray-700">See DuroMax sheet</td>
                    <td class="px-4 py-4 text-gray-700">Inverter, tri fuel</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Champion 201277</td>
                    <td class="px-4 py-4 text-gray-700">7,500W</td>
                    <td class="px-4 py-4 text-gray-700">9,375W</td>
                    <td class="px-4 py-4 text-gray-700">6,750W</td>
                    <td class="px-4 py-4 text-gray-700">Open frame, dual fuel</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pulsar GD950BN</td>
                    <td class="px-4 py-4 text-gray-700">7,600W</td>
                    <td class="px-4 py-4 text-gray-700">9,500W</td>
                    <td class="px-4 py-4 text-gray-700">7,200W</td>
                    <td class="px-4 py-4 text-gray-700">Inverter, dual fuel</td>
                  </tr>
