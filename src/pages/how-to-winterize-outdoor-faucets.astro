---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Winterize a Pressure Washer", url: "/how-to-winterize-a-pressure-washer/" },
    { title: "Wet Basement Solutions", url: "/wet-basement-solutions/" },
    { title: "Best Expandable Garden Hose", url: "/best-expandable-garden-hose/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "How to Winterize Outdoor Faucets (Hose Bibs)";
const description =
  "Disconnect the hose, drain the line, and know whether your spigot is frost-free. A twenty-minute job that prevents a burst pipe inside the wall.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "How to Winterize Outdoor Faucets", item: "https://www.thehonestreviewers.com/how-to-winterize-outdoor-faucets/" },
      ],
    },
    {
      "@type": "HowTo",
      name: "How to winterize an outdoor faucet",
      totalTime: "PT20M",
      step: [
        { "@type": "HowToStep", name: "Disconnect every hose", text: "Remove hoses, splitters and timers from every outdoor spigot. A connected hose is what defeats a frost-free faucet." },
        { "@type": "HowToStep", name: "Find the indoor shut-off", text: "Trace the supply line back indoors and close the dedicated shut-off valve for that spigot if one exists." },
        { "@type": "HowToStep", name: "Open the outdoor faucet and drain", text: "With the supply closed, open the outdoor faucet fully and let the line drain completely, then open the bleeder cap on the indoor valve if fitted." },
        { "@type": "HowToStep", name: "Leave the faucet open", text: "Leave the outdoor faucet in the open position for the winter so any remaining water has room to expand." },
        { "@type": "HowToStep", name: "Insulate what is exposed", text: "Fit an insulated faucet cover, and insulate any exposed supply pipe running through an unheated crawlspace or garage." },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you need to shut off outdoor faucets in winter?",
          acceptedAnswer: { "@type": "Answer", text: "In any climate that reaches freezing, yes. Even a frost-free faucet needs its hose disconnected, and a standard compression spigot needs its supply shut off indoors and the line drained. The failure this prevents is a pipe splitting inside the wall, which usually goes unnoticed until the first spring thaw sends water into the wall cavity." },
        },
        {
          "@type": "Question",
          name: "Do you need to shut off a frost-free faucet?",
          acceptedAnswer: { "@type": "Answer", text: "A frost-free faucet does not need a separate shut-off if it is correctly installed and pitched, because the valve seat sits inside the heated envelope and the barrel drains itself when you close it. But it absolutely must have its hose disconnected. A hose left attached traps water in the barrel, which then cannot drain, and freezes and splits the pipe inside the wall." },
        },
        {
          "@type": "Question",
          name: "How do you know if a faucet is frost-free?",
          acceptedAnswer: { "@type": "Answer", text: "A frost-free spigot has a long barrel, typically 150 to 350 millimetres, running back through the wall, and the handle usually sits on a slight angle. A standard spigot is short and the valve is right behind the handle at the wall face. If the handle takes several turns to shut off, and water keeps running briefly after you close it while the barrel drains, it is frost-free." },
        },
        {
          "@type": "Question",
          name: "Should you leave outdoor faucets open in winter?",
          acceptedAnswer: { "@type": "Answer", text: "Yes, once the supply is shut off and the line drained. Leaving the faucet in the open position gives any residual water room to expand as it freezes rather than building pressure against a closed valve. It also makes it obvious in spring which spigots were winterized and need turning back on." },
        },
        {
          "@type": "Question",
          name: "Are foam faucet covers worth it?",
          acceptedAnswer: { "@type": "Answer", text: "They help and they cost very little, but they are insulation rather than protection. A cover slows heat loss from the wall and buys tolerance against a short cold snap; it cannot save a spigot with a hose attached or a supply line full of water in an unheated crawlspace. Use one as the last layer, after disconnecting and draining." },
        },
        {
          "@type": "Question",
          name: "What happens if you leave a hose connected over winter?",
          acceptedAnswer: { "@type": "Answer", text: "Water trapped in the hose and in the faucet barrel freezes and expands. Because ice forms outward from the spigot, the pressure has nowhere to escape and is transmitted back into the pipe inside the wall, which splits. The split often goes unnoticed until spring, when the supply is turned on and water pours into the wall cavity behind the finished surface." },
        },
        {
          "@type": "Question",
          name: "When should you winterize outdoor faucets?",
          acceptedAnswer: { "@type": "Answer", text: "Before the first hard freeze, which in most temperate climates means some point in autumn once night-time lows start reaching a few degrees above freezing. Watch the forecast rather than the calendar: an early cold snap in a mild autumn does exactly the same damage as a January freeze, and the job takes twenty minutes." },
        },
        {
          "@type": "Question",
          name: "How do you thaw a frozen outdoor faucet?",
          acceptedAnswer: { "@type": "Answer", text: "Open the faucet to relieve pressure, then warm the pipe gradually from the faucet end inward with a hair dryer or heat lamp — never a torch or open flame. Work slowly and be ready for water once it flows, because a split you cannot see may already be there. If the pipe runs through a wall you cannot access, shut off the supply and call a plumber rather than guessing." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Seasonal Home Maintenance",
    tags: ["winterize outdoor faucet", "hose bib", "frost-free spigot", "frozen pipes"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Winter Prep Guides", link: "/best-of/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Seasonal</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">How to Winterize <span class="text-[#38BDF8]">Outdoor Faucets</span></h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Twenty minutes in autumn against a split pipe inside a wall you cannot see, discovered in spring by the water coming through the ceiling below it.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#steps" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">See the Steps</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="9.4k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Actually Breaks</a>
          <a href="#which-type" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Type of Faucet You Have</a>
          <a href="#steps" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Twenty-Minute Routine</a>
          <a href="#no-shutoff" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. If There Is No Indoor Shut-Off</a>
          <a href="#covers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Covers, Insulation and Heat Tape</a>
          <a href="#irrigation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Irrigation, Hoses and Equipment</a>
          <a href="#frozen" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. If It Is Already Frozen</a>
          <a href="#spring" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Turning It Back On in Spring</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The damage from a frozen hose bib almost never happens at the spigot. It happens half a metre back, inside the wall, where the split pipe sits quietly all winter and then delivers mains pressure into the wall cavity on the first warm day in March.
        </p>

        <div id="why" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. What Actually Breaks</h2>

          <p>
            Water expands by roughly nine percent as it freezes, and in a closed pipe it has nowhere to put that volume. Ice forms first at the coldest point, which is the exposed spigot, and grows inward. As it does, it seals the pipe and then compresses the water still trapped behind it, and the pressure rises until the weakest section of pipe gives way.
          </p>

          <p>
            That weakest section is very often inside the wall, on the warm side of where the ice formed. So the burst is invisible, the spigot looks fine, and everything appears normal until the supply is turned on again in spring.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Why the Hose Matters So Much</p>
            <p class="text-xl font-bold text-white mb-3">A hose left connected is the single most common cause of a burst pipe behind a frost-free faucet.</p>
            <p class="text-gray-300 leading-relaxed m-0">A frost-free spigot only works because the barrel drains out through the open end after you shut it off. Cap that end with a hose full of water and the barrel cannot drain, so it holds water through the wall — exactly the condition the design exists to prevent. The faucet is doing its job; the hose has disabled it.</p>
          </div>
        </div>

        <div id="which-type" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Which Type of Faucet You Have</h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Standard Spigot</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Frost-Free Spigot</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Where the valve sits</td>
                    <td class="px-4 py-4 text-gray-700">At the wall face, outdoors</td>
                    <td class="px-4 py-4 text-gray-700">150-350 mm inside the wall</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">How to spot it</td>
                    <td class="px-4 py-4 text-gray-700">Short body, shuts off fast</td>
                    <td class="px-4 py-4 text-gray-700">Long barrel, several turns, drains after closing</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Needs indoor shut-off</td>
                    <td class="px-4 py-4 text-gray-700">Yes, always</td>
                    <td class="px-4 py-4 text-gray-700">Not if correctly installed</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Hose must come off</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes, without exception</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            One caveat on frost-free faucets: they only self-drain if they were installed with a slight downward pitch to the outside. A unit fitted dead level, or worse pitched slightly inward, holds water in the barrel no matter how carefully you shut it off. If yours does not dribble briefly after closing, treat it as a standard spigot and shut off the supply indoors.
          </p>

          <p>
            Also check for an anti-siphon or vacuum breaker on the spout, which is a small domed cap. These occasionally trap a little water themselves, and a failed one can weep in cold weather. They are inexpensive and replaceable.
          </p>
        </div>

        <div id="steps" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. The Twenty-Minute Routine</h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Step 1: Disconnect Everything</h3>
          <p>
            Hoses, splitters, timers, quick-connect fittings, filters. All of it comes off every outdoor spigot. Drain the hoses fully — walking one out along a slope or draping it over a fence works — and coil them loosely for storage somewhere they will not freeze into a solid ring.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Step 2: Find the Indoor Shut-Off</h3>
          <p>
            Trace the supply line back indoors. In most houses the valve for a hose bib is in the basement, crawlspace or utility area on the inside of the same wall, often within a metre or so of the spigot. It may be a gate valve with a round handle or a ball valve with a lever.
          </p>
          <p>
            Label it. A strip of tape reading "front hose bib" saves the next person — quite possibly you in five years — a frustrating hour, and it means anyone in the house can shut it in a hurry.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Step 3: Shut Off and Drain</h3>
          <p>
            Close the indoor valve, then go outside and open the spigot fully. Water will run for a few seconds and stop. Leave it open.
          </p>
          <p>
            Back inside, look for a small bleeder cap or drain screw on the side of the shut-off valve. Put a container under it and open it to release the water trapped between the valve and the spigot — this is the section that would otherwise freeze. Close the bleeder once it stops dripping.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Step 4: Leave It Open</h3>
          <p>
            The outdoor faucet stays open all winter. Any residual water then has somewhere to expand instead of building pressure against a closed seat. It also makes it obvious in spring which spigots were done.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Step 5: Insulate</h3>
          <p>
            Fit an insulated faucet cover over the spigot. If the supply pipe runs through an unheated garage, crawlspace or rim joist area, insulate that run too — pipe sleeves take minutes and address the section most likely to freeze after the spigot itself.
          </p>
        </div>

        <div id="no-shutoff" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. If There Is No Indoor Shut-Off</h2>

          <p>
            Plenty of houses, particularly older ones, have a hose bib teed straight off a main run with no dedicated valve. You have three options, in ascending order of cost and descending order of anxiety.
          </p>

          <p>
            <strong>If the spigot is genuinely frost-free and properly pitched</strong>, no shut-off is needed. Disconnect the hose, close the faucet, confirm it dribbles and stops, and fit a cover. That is the whole job.
          </p>

          <p>
            <strong>If it is a standard spigot with no valve</strong>, this is worth fixing rather than managing. A plumber adding a shut-off with a bleeder, or replacing the spigot with a frost-free unit, is a modest job and permanently removes an annual worry and a real burst risk.
          </p>

          <p>
            <strong>As an interim measure only</strong>, insulate heavily: a good faucet cover, pipe sleeves on any accessible run, and where the pipe passes through an unheated space, consider thermostatically controlled heat tape rated for potable water pipe and installed to its instructions. Treat that as a stopgap for one winter, not a permanent answer.
          </p>
        </div>

        <div id="covers" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Covers, Insulation and Heat Tape</h2>

          <p>
            Faucet covers are cheap and mildly useful. They trap the small amount of heat leaking out through the wall around the pipe and slow the rate at which the spigot chills, which buys tolerance during a brief cold snap. They do not make a spigot with a hose attached safe, and they do not drain a line.
          </p>

          <p>
            Fit them snugly against the siding so the seal is against the wall rather than around the spout, and check after a windy week that they have not blown loose. A cover hanging off its cord is doing nothing.
          </p>

          <p>
            Pipe insulation on exposed runs is more valuable than the cover, because a supply pipe running along the inside of an uninsulated rim joist or through a vented crawlspace is genuinely exposed. Foam sleeves are inexpensive and take minutes, and while you are down there, look for gaps in the rim joist where cold air pours in.
          </p>

          <p>
            Heat tape is the last resort rather than the first tool. Use a thermostatically controlled product intended for water pipe, follow the wrapping and overlap instructions exactly, do not run it under insulation unless the product allows it, and never use it as a substitute for draining a line you could simply drain.
          </p>
        </div>

        <div id="irrigation" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Irrigation, Hoses and Outdoor Equipment</h2>

          <p>
            An in-ground irrigation system is a separate and larger job. Most need the backflow preventer isolated and drained and the zones blown out with compressed air, which is normally a service call because getting the pressure and volume right matters and an over-pressurised blowout damages heads and valves. Book it before the first freeze rather than after.
          </p>

          <p>
            Drain and store hoses somewhere they will not freeze. Water left inside a hose freezes into a rigid core, and repeated freeze-thaw cycles crack the liner and destroy fittings. Coiled loosely and stored in a shed or garage is fine; a hose reel left outside full of water is not.
          </p>

          <p>
            Anything else that holds water outdoors needs the same thought: pressure washers, which we cover in <a href="/how-to-winterize-a-pressure-washer/">winterizing a pressure washer</a>, garden sprayers, rain barrels, water features and outdoor kitchen supply lines. The rule is simple and universal — if it holds water and it lives outside, drain it.
          </p>
        </div>

        <div id="frozen" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. If It Is Already Frozen</h2>

          <p>
            If a spigot will not flow on a cold morning and you suspect ice, open the faucet first. An open faucet gives melting water somewhere to go and relieves pressure, which is the whole objective.
          </p>

          <p>
            Then warm the pipe gradually, working from the faucet end back toward the house with a hair dryer, a heat lamp or towels soaked in hot water. Never use a torch or any open flame: it can ignite framing inside the wall, and it heats one spot fast enough to turn trapped water to steam, which bursts pipes rather than saving them.
          </p>

          <p>
            Be ready for water. If the pipe has already split, thawing it is what reveals the split, so know where your main shut-off is before you start and keep a hand near it. If the frozen section runs inside a wall you cannot reach, shut off the supply and call a plumber rather than heating a cavity blind.
          </p>

          <p>
            Afterwards, treat the event as information: a spigot that froze once will freeze again in the same conditions, so fix the underlying issue — a missing shut-off, an uninsulated run, a frost-free unit pitched the wrong way — before next winter.
          </p>
        </div>

        <div id="spring" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">8. Turning It Back On in Spring</h2>

          <p>
            Order matters here, and getting it wrong is how a winter split becomes a flooded basement.
          </p>

          <p>
            Close the outdoor faucet first. Then open the indoor shut-off slowly, no more than a quarter turn at a time, and listen. Water rushing continuously with the spigot closed means a break somewhere in that line — shut it off immediately and investigate before opening it further.
          </p>

          <p>
            If it stays quiet, go outside and open the spigot. Expect a spit of air first, then steady flow. While it runs, go back and look at the pipe and the shut-off valve for weeping, and check the ceiling below if the line runs through a finished space.
          </p>

          <p>
            One more spring check worth the minute it takes: with the water running, look at where it lands. A spigot discharging against the foundation is a small but persistent contributor to <a href="/wet-basement-solutions/">basement moisture problems</a>, and a splash block or a length of hose moves the problem away from the wall.
          </p>
        </div>


        <div class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Wells, Empty Houses and Long Absences</h2>

          <p>
            Two situations change the calculation, and both are worth planning for in autumn rather than improvising in January.
          </p>

          <p>
            <strong>On a private well</strong>, the pump, pressure tank and any above-ground pipework are additional freeze points, and a well house or pit needs its own attention: insulation, a sealed hatch, and where necessary a thermostatically controlled heat source rated for the space. A frozen pressure tank or a split pipe at the wellhead takes the whole house's water supply out, not just a garden tap.
          </p>

          <p>
            <strong>Leaving a house empty in winter</strong> — a holiday home, a rental between tenants, a long trip — deserves more than turning the thermostat down. Shut off the water at the main, drain the system by opening the lowest taps, and leave the heating on a low setting rather than off entirely, since a house at 12°C keeps pipes in cold cavities well clear of freezing at a fraction of the cost of a burst.
          </p>

          <p>
            Where a property will be empty for months, a full winterisation — draining the water heater, blowing out the lines, and putting non-toxic antifreeze into traps so they do not evaporate dry and let sewer gas in — is the thorough version, and it is the standard approach for a seasonal cottage.
          </p>

          <p>
            In either case, a cheap wifi temperature sensor in the coldest part of the house pays for itself the first time it tells you the heating has failed while you are away.
          </p>
        </div>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Leaving a Hose Connected</h3>
              <p class="text-gray-700 text-sm m-0">The number one cause of a burst pipe behind a frost-free faucet. The hose caps the barrel so it cannot drain, defeating the entire design. Every hose, splitter and timer comes off before the first freeze.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Shutting the Supply but Not Draining the Line</h3>
              <p class="text-gray-700 text-sm m-0">The water between the indoor valve and the spigot is exactly the water that freezes. Open the outdoor faucet, and open the bleeder cap on the shut-off valve if there is one.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Closing the Faucet Again After Draining</h3>
              <p class="text-gray-700 text-sm m-0">Leave it open all winter. Residual water then has room to expand instead of pressurising against a closed seat, and you can see at a glance which spigots were winterized.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming Frost-Free Means Maintenance-Free</h3>
              <p class="text-gray-700 text-sm m-0">A frost-free unit installed level or pitched inward does not self-drain. If yours does not dribble briefly after closing, treat it as a standard spigot and shut off the supply indoors.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Thawing With a Torch</h3>
              <p class="text-gray-700 text-sm m-0">An open flame can ignite framing inside the wall and flash trapped water to steam, which bursts the pipe. Use a hair dryer or heat lamp, work gradually from the faucet inward, and open the faucet first.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Opening the Supply Fast in Spring</h3>
              <p class="text-gray-700 text-sm m-0">If the line split over winter, a fully opened valve delivers mains pressure into the wall. Close the outdoor faucet, open the indoor valve a quarter turn at a time, and listen for water that should not be flowing.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">10. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do you have to shut them off?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">In any freezing climate, yes. Frost-free faucets need the hose off; standard spigots need the supply closed indoors and the line drained. The failure it prevents is a split pipe inside the wall, discovered in spring.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do frost-free faucets need shutting off?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Not if correctly installed and pitched, because the valve seat sits inside the heated envelope and the barrel self-drains. But the hose must come off without exception — a connected hose traps water in the barrel and defeats the design.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you tell which type you have?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">A frost-free spigot has a long barrel running back through the wall, takes several turns to close, and dribbles briefly afterwards as the barrel drains. A standard spigot is short and shuts off immediately at the wall face.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Leave them open over winter?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes, once the supply is off and the line drained. Residual water then has room to expand rather than pressurising a closed valve, and open spigots are a visible record of which ones you did.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Are foam covers worth it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">They help and cost little, but they are insulation, not protection. A cover buys tolerance in a short cold snap; it cannot save a spigot with a hose attached or a supply line full of water. Use one as the last layer.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What if a hose is left on?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Water trapped in the hose and barrel freezes and expands, and because ice forms outward the pressure is transmitted back into the pipe inside the wall, which splits — often unnoticed until the supply is turned on in spring.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">When should you do it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Before the first hard freeze — watch the forecast rather than the calendar, since an early cold snap does the same damage as January. The whole job takes about twenty minutes.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you thaw a frozen one?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Open the faucet to relieve pressure, then warm the pipe gradually from the faucet inward with a hair dryer or heat lamp — never a flame. Be ready for water, and if the run is inside an inaccessible wall, shut off the supply and call a plumber.</p>
            </div>
          </div>
        </div>

