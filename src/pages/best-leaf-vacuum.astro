const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Leaf Vacuum",
          item: "https://www.thehonestreviewers.com/best-leaf-vacuum/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a leaf vacuum better than a leaf blower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. A blower moves leaves much faster across open ground, so it is better for getting leaves to the curb, a tarp or the woods. A vacuum picks leaves up and shreds them, so it is better for beds, patios, corners and producing mulch. Many homeowners use a blower-vac that does both."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good mulch ratio for a leaf vacuum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most good blower-vacs are rated between 10:1 and 18:1. Anything from about 12:1 upward makes a big difference to how many bags you fill. Higher ratios also produce finer mulch for beds and compost. Remember the figures assume dry leaves, so expect less reduction with damp material and pine needles."
          }
        },
        {
          "@type": "Question",
          "name": "Can a leaf vacuum pick up wet leaves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not well. Every handheld leaf vacuum struggles with wet, matted leaves, which pack into the impeller and block airflow. Some models handle damp leaves better than others, but the practical answer is to vacuum on dry days, or rake wet leaves into piles and let them dry before vacuuming or mulching them."
          }
        },
        {
          "@type": "Question",
          "name": "Are cordless leaf vacuums any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The newest ones are. Older battery blower-vacs had weak suction, but machines like the EGO LV5005 are rated for airflow similar to corded models. Run time on high is the limitation, often around 15 minutes per battery, so cordless vacuums suit small and mid-sized yards or owners with spare batteries on the same platform."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a leaf vacuum and a leaf mulcher?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A leaf vacuum sucks leaves up through a tube and shreds them into a bag. A standalone leaf mulcher like the Worx WG430 does not pick anything up. You gather leaves first with a rake, blower or sweeper and feed them in. For large volumes, a mulcher is faster, while a vacuum is better for beds and tight spaces."
          }
        },
        {
          "@type": "Question",
          "name": "Can I vacuum leaves from gravel or mulch beds?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Carefully. A leaf vacuum will pull up small stones and wood mulch along with the leaves, which can chip the impeller and fill the bag with debris. Use a low setting, hold the tube a little above the surface, or blow the leaves onto a hard surface first and vacuum them there."
          }
        },
        {
          "@type": "Question",
          "name": "Should I mulch leaves or bag them?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mulching is usually better. Shredded leaves make excellent bed mulch and compost, and fine shreds left on the lawn feed the soil. Bagging whole leaves takes far more bags and curb space. If your town composts curbside leaves anyway, shredding still saves on bags and makes the pile much easier to handle."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best leaf vacuum",
      "leaf vacuum",
      "best leaf mulcher",
      "leaf vacuum mulcher",
      "leaf blower vacuum",
      "cordless leaf vacuum"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Leaf Vacuums</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Corded blower-vacs, a cordless vacuum and a standalone mulcher, chosen for suction, mulch ratio and how well each fits the size of your yard.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#toro-51621-ultraplus-blower-vac"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
