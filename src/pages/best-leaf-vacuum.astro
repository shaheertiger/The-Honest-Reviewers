const dates = pageDates(Astro.url.pathname, { published: "2026-10-06", modified: "2026-10-06" });
const title = "6 Best Leaf Vacuums in 2026: Blower-Vacs, Mulchers and Cordless";
const description =
  "Six leaf vacuums and mulchers compared, from corded blower-vacs to a cordless EGO and a standalone mulcher, plus what mulch ratios mean and when to skip one.";

const PRODUCTS = [
  {
    "id": "toro-51621-ultraplus-blower-vac",
