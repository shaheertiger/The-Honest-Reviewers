const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Water Heater Element",
          item: "https://www.thehonestreviewers.com/water-heater-element/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How do I know if my water heater element is bad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Turn off the power, verify it is off, disconnect one wire and measure resistance across the element terminals. A 4,500-watt, 240-volt element should read about 12.8 ohms. An open reading means it has burned out. Then test from a terminal to the tank; any continuity means the element is grounded and should be replaced even if it heats."
          }
        },
        {
          "@type": "Question",
          "name": "Which element goes out first, upper or lower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually the lower element. Cold water enters at the bottom, so the lower element does most of the daily heating, and sediment settles around it. A failed lower element typically gives a short burst of hot water that runs out quickly. A failed upper element usually means no hot water at all, because the upper thermostat never passes control to the lower one."
          }
        },
        {
          "@type": "Question",
          "name": "Can I replace a water heater element without draining the tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is possible for the upper element by closing the cold supply and creating a vacuum, but it is messy and splashes water onto wiring. Draining below the element is safer. For the lower element, drain completely, which also lets you flush sediment. Always refill fully and bleed air before restoring power."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a higher wattage element?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the heater's rating label lists that wattage as an option. The wiring and breaker were sized for the original rating, and a larger element can overload them. Matching the label is the safe choice. For faster recovery, a larger tank or a heat pump model with a hybrid mode is usually a better answer than a bigger element."
          }
        },
        {
          "@type": "Question",
          "name": "What is a low watt density water heater element?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It spreads its rated wattage over a larger surface area, often by folding back on itself, so the sheath runs cooler. Element makers and plumbers commonly recommend them for hard water because scale builds more slowly on a cooler surface. They usually cost a little more than high-density elements but tend to last longer in tough water."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my water heater keep tripping the breaker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common causes are a grounded element with a cracked sheath, damaged or loose wiring, or a short in a thermostat. Test each element for a ground fault from a terminal to the tank, and inspect wiring for scorching. If you cannot find the cause, call an electrician or plumber; repeated tripping is a safety signal, not a nuisance to be reset."
          }
        },
        {
          "@type": "Question",
          "name": "How long do water heater elements last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no fixed number. In soft water with regular flushing, elements can last many years, sometimes the life of the tank. In hard water or with heavy sediment, failures every few years are common. Low-watt-density elements, stainless or Incoloy sheaths and annual flushing all extend element life, and a failed element alone is not a reason to replace the heater."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
