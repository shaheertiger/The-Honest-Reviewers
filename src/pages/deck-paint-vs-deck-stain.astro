const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "Deck Paint vs Deck Stain: Which Should You Use?";
const description =
  "Paint lasts longest, hides the most, and is the hardest to undo. Where it genuinely wins on a deck, and where a stain is the safer answer.";

