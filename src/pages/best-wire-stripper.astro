  },
  {
    id: "ideal-45-092",
    name: "Ideal 45-092 Stripmaster",
    category: "Automatic Bench Style, Interchangeable Dies, 10-22 AWG",
    badge: "Best for Volume Work",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 1800,
    pros: [
      "Extremely fast for repetitive stripping of the same gauge",
      "Interchangeable die sets covering different wire ranges",
      "Very consistent strip quality across many conductions",
