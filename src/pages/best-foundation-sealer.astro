        <h2 id="by-wall" class="scroll-mt-24 text-3xl font-black text-gray-900 mt-16 mb-6">
          4. Matching Product to Wall
        </h2>

        <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
          <table class="w-full text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-4 font-bold text-gray-600 text-sm">Your Situation</th>
                <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product Type</th>
                <th class="px-4 py-4 font-bold text-gray-600 text-sm">Our Pick</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white border-b border-gray-100">
                <td class="px-4 py-4 font-black text-gray-900">Excavating anyway</td>
                <td class="px-4 py-4 text-gray-700">Exterior elastomeric membrane</td>
                <td class="px-4 py-4 text-gray-700">Liquid Rubber Foundation Sealant</td>
              </tr>
              <tr class="bg-gray-50 border-b border-gray-100">
                <td class="px-4 py-4 font-black text-gray-900">Damp, musty block wall</td>
                <td class="px-4 py-4 text-gray-700">Cementitious waterproofer</td>
                <td class="px-4 py-4 text-gray-700">DRYLOK Extreme</td>
              </tr>
