            </div>
            <div>
              <p class="text-3xl font-black text-white">6 ft</p>
              <p class="text-gray-400 text-xs mt-1">Where downspouts should discharge</p>
            </div>
            <div>
              <p class="text-3xl font-black text-[#FF4500]">6"/10 ft</p>
