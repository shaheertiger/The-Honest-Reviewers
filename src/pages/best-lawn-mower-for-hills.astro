---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Self-Propelled Lawn Mowers",
    "url": "/best-self-propelled-lawn-mower/"
  },
  {
    "title": "Best Gas Lawn Mowers",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "Best Battery-Powered Lawn Mowers",
    "url": "/best-battery-powered-lawn-mower/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Zero-Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Front-Wheel vs Rear-Wheel Drive Mowers",
    "url": "/front-wheel-vs-rear-wheel-drive-lawn-mower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Lawn Mowers for Hills That Grip on Steep Slopes";
const description =
  "Seven rear- and all-wheel-drive mowers for sloped lawns, plus the slope limits for riders and zero-turns, which way to mow, and whether battery power copes on a grade.";

const PRODUCTS = [
  {
    "id": "toro-recycler-22-awd-21472",
    "name": "Toro 22\" Recycler All-Wheel Drive Personal Pace (21472)",
    "category": "Gas, 163cc Briggs & Stratton, All-Wheel Drive",
    "badge": "Best Overall for Hills",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 2000,
    "pros": [
      "True all-wheel drive keeps pulling when the front wheels unload on a climb and the rear wheels skid on a wet side-slope",
      "Personal Pace drive speeds up and slows down with your stride, so there is no lever to feather while you fight gravity",
      "14-gauge steel 22-inch Recycler deck mulches well, so you are not carrying a heavy bag up the hill",
      "10-inch rear wheels and 8-inch fronts roll over bumps and ruts instead of dropping into them",
      "Briggs & Stratton EXi 163cc engine with 7.25 ft-lb of torque and no oil changes required, only top-ups"
    ],
    "cons": [
      "At around 85 lb it is a heavy mower to haul around on flat ground, and the AWD adds cost over the RWD Recycler",
      "Only a 2-year limited mower warranty, shorter than several rivals"
    ],
    "bottomLine": "The mower to buy if your lawn has real grades and you want something that climbs them wet or dry without a fight.",
    "description": "Most self-propelled mowers are rear-wheel drive, and on a moderate slope that is enough. The Toro 21472 exists for lawns where it is not. It drives all four wheels, which matters in two specific situations: climbing a steep bank, where weight shifts back and a front-drive mower's front wheels lift and spin, and traversing a side-slope in damp grass, where a two-wheel-drive mower's driven wheels break loose and the deck slides downhill. With all four wheels pulling, one wheel losing grip no longer stops the machine. The Personal Pace system is the other reason it works on a hill. You push the handle bar forward and the mower matches your pace, so on a climb you can shorten your stride without fiddling with a speed lever, and on the way down you simply ease back. Toro rates it for yards up to half an acre, and the 22-inch Recycler deck with Vortex airflow is a genuinely good mulcher, which matters more on a slope than people expect, because a full bag adds real weight when you are walking it uphill. The 163cc Briggs EXi engine with 7.25 ft-lb of torque is adequate rather than generous. Independent testers have found that all-wheel drive's advantage over a good rear-wheel-drive mower is modest on dry grass, so if your slopes are gentle, save the money. If they are steep, wet or both, this is the one."
  },
  {
    "id": "ego-lm2156sp-select-cut-xp-hills",
    "name": "EGO Power+ Select Cut XP LM2156SP 21\"",
    "category": "56V Battery, Rear-Wheel Drive, 8.3 ft-lb",
    "badge": "Best Battery Mower for Hills",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 4800,
    "pros": [
      "8.3 ft-lb of cutting torque, the most of any 21-inch EGO in its generation, so it does not bog climbing through thick grass",
      "Rear-wheel Touch Drive with a speed dial under your thumb lets you slow right down on a steep pitch",
      "No oil sump and no fuel tank, so there is nothing to starve or spill on a side-slope",
      "Up to 75 minutes of rated runtime on the 10.0Ah battery gives real headroom for the extra draw a hill causes",
      "Select Cut system lets you swap the lower blade for mulching, bagging or longer runtime"
    ],
    "cons": [
      "The big battery sits high on the deck and makes the mower feel top-heavy on a steep sideways pass",
      "Premium price, and a spare 10.0Ah battery costs a large share of a budget gas mower"
    ],
    "bottomLine": "The battery mower that handles a hilly lawn best, provided you budget for the fact that slopes shorten runtime.",
    "description": "Battery mowers used to be a poor choice for slopes: the self-propel drive and the blade motor both pull harder on a climb, and early models ran out of charge or torque halfway up. The LM2156SP is the model that changed our view. It pairs 8.3 ft-lb of cutting torque with rear-wheel self-propel, and EGO's Touch Drive puts the speed control on a dial at your fingertips, so you can crawl up a steep pitch without holding a lever at a precise position. On a hill the practical advantage of battery power is often overlooked. A gas mower has an oil sump and a fuel tank, and running one across a steep face for twenty minutes can starve the engine of oil or push fuel out of the cap vent. An electric motor has neither, so it does not care what angle it is held at. Where the EGO does care is runtime. EGO rates it at up to 75 minutes on the 10.0Ah pack, but that figure assumes flat, dry grass; plan on noticeably less on a lawn that is mostly climbing. The Select Cut Multi-Blade system is a genuine bonus, letting you fit a mulching lower blade so you are not hauling a full bag uphill. The weakness is weight distribution: the battery sits high, and on a steep traverse you feel it."
  },
  {
    "id": "toro-timemaster-30-21200-hills",
    "name": "Toro 30\" TimeMaster Personal Pace Electric Start (21200)",
    "category": "Gas, 223cc Briggs & Stratton, 30-inch Deck",
    "badge": "Best for Large Sloped Lawns",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "30-inch deck cuts around 40 percent more per pass than a 21-inch mower, which means fewer trips up and down the slope",
      "Rear-wheel drive with Traction Assist helps hold grip when one wheel loses contact on uneven ground",
      "223cc OHV engine with 10 ft-lb of torque keeps blade speed up while climbing in thick grass",
      "Electric start, so you are not yanking a pull cord while standing on a grade",
      "Twin Atomic blades mulch fine, and the 2.5-bushel bag is large when you do need it"
    ],
    "cons": [
      "Around 145 lb, so it is hard to manhandle on a steep bank and needs the drive to do the work",
      "The wide deck will scalp on sharp crests and in ditches where a 21-inch mower would follow the contour"
    ],
    "bottomLine": "For an acre of rolling ground that is too steep or too tight for a rider, this is the fastest walk-behind option.",
    "description": "There is a category of lawn that pushes people toward a riding mower when a riding mower is the wrong tool: an acre or so of rolling ground with a few grades too steep to ride safely. The TimeMaster is the answer to that lawn. Its 30-inch deck covers roughly 40 percent more ground per pass than a standard 21-inch walk-behind, which on a large lawn cuts the number of passes, and therefore the number of climbs, substantially. Toro fits it with a 223cc Briggs & Stratton OHV engine rated at 10 ft-lb of torque, which keeps blade speed up in thick grass on a climb where a 163cc engine would sag. The drive is Toro's Personal Pace rear-wheel system with Traction Assist, which helps maintain grip when one wheel loses contact over a hump. Electric start is not a luxury on a hill, either. Restarting a stalled pull-cord mower while bracing on a slope is awkward and a little unsafe, and push-button start removes that. The caveats are physical. At around 145 lb it is a lot of machine to turn around on a bank, and a 30-inch deck bridges small dips and scalps crests that a narrower mower would follow. On smooth, broad slopes it is superb; on lumpy, tight ones a 21-inch AWD mower is better."
  },
  {
    "id": "greenworks-pro-80v-21-brushless-hills",
    "name": "Greenworks Pro 80V 21\" Brushless Self-Propelled Mower",
    "category": "80V Battery, Rear-Wheel Drive, 10-inch Rear Wheels",
    "badge": "Best Value Battery",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 3000,
    "pros": [
      "Variable-speed rear-wheel drive puts the traction where the weight goes when you climb",
      "10-inch rear wheels are larger than most battery mowers at this price, which helps on rough, sloped ground",
      "At about 68 lb it is noticeably lighter than the gas mowers here, so it is easier to control on a traverse",
      "Up to 70 minutes of rated runtime on the 5.0Ah battery, and the battery runs the whole Greenworks 80V range",
      "4-year limited tool and battery warranty"
    ],
    "cons": [
      "Cutting height only goes to 3-3/4 inches, a little short for keeping cool-season grass tall on dry slopes",
      "Self-propel feels less refined than Toro's Personal Pace or EGO's Touch Drive"
    ],
    "bottomLine": "The sensible battery pick for a small to mid-sized hilly yard when the EGO is more than you want to spend.",
    "description": "The Greenworks Pro 80V is the mower we would point to for a buyer who wants the practical benefits of battery power on a slope without paying EGO prices. It uses rear-wheel drive with variable speed, which is the right layout for hills, and it rides on 10-inch rear wheels with 8-inch fronts, a larger rear wheel than most battery mowers at this price. Larger rear wheels matter on a slope because they ride over bumps rather than dropping into them, and a wheel that drops into a hole on a side-slope tips the deck and scalps the grass. Its weight, around 68 lb with battery, is a real advantage too. A lighter mower is easier to hold on line across a grade and easier to turn at the end of a pass without the rear end swinging downhill. Greenworks rates it at up to 70 minutes on the included 5.0Ah pack, and as with every battery mower, a lawn that is mostly climbing will use that faster. The brushless DigiPro motor is rated by Greenworks as comparable to a 160cc gas engine, which is fair for normal grass and a little optimistic in thick, wet growth. The weak points are modest: the maximum cutting height of 3-3/4 inches is lower than we would like for a sun-baked slope, and the self-propel control is less smooth than the two premium systems here."
  },
  {
    "id": "craftsman-m310c-rwd-hills",
    "name": "Craftsman M310 21\" 163cc RWD Self-Propelled Mower",
    "category": "Gas, 163cc Briggs & Stratton, Rear-Wheel Drive",
    "badge": "Best Budget Gas",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 1500,
    "pros": [
      "Rear-wheel drive and 11-inch rear wheels, a combination many budget mowers skip",
      "Pace control adjusts to your walking speed, which is easier on a slope than a fixed-speed drive",
      "163cc Briggs & Stratton engine with ReadyStart, so no priming or choking",
      "3-in-1 deck mulches, side discharges or bags into a 2.3-bushel bag",
      "Folding handle for compact storage"
    ],
    "cons": [
      "Cutting height tops out at 3.75 inches with six positions, fewer than the Toros",
      "2-year limited warranty and a lighter-duty deck than the premium picks"
    ],
    "bottomLine": "The cheapest mower we would trust on a moderately hilly half-acre, as long as the slopes are dry and moderate.",
    "description": "The budget end of the self-propelled market is full of front-wheel-drive mowers, and front-wheel drive is the wrong answer on a hill. The Craftsman M310 is one of the more affordable models that gets the drive layout right. It is rear-wheel drive, it runs on 11-inch rear wheels, larger than most mowers in this list, and its pace-control system adjusts drive speed to your walking pace rather than locking you into a single speed. Craftsman pitches it at yards of half to three-quarters of an acre, which is realistic. The 163cc Briggs & Stratton engine with ReadyStart needs no priming or choking and handles normal grass on a moderate grade without trouble, though it will sag in thick, wet growth on a steep climb, where the Toro TimeMaster's larger engine does not. The 3-in-1 deck mulches, side discharges or bags into a 2.3-bushel bag, and on a slope we would mulch, since a full bag shifts weight rearward and makes the front end light. Where it gives ground is refinement and longevity: six height positions topping out at 3.75 inches, a 2-year warranty and a deck that is not built to the standard of the Toros. For moderate slopes and a tight budget, though, it is the right kind of cheap."
  },
  {
    "id": "ego-lm2206sp-aluminum-hills",
    "name": "EGO Power+ LM2206SP 22\" Aluminum Deck Self-Propelled",
    "category": "56V Battery, Cast Aluminum Deck, 11.1 ft-lb",
    "badge": "Most Torque (Battery)",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 400,
    "pros": [
      "11.1 ft-lb of torque, the most of any battery mower here, so it holds blade speed climbing through heavy grass",
      "Cast aluminum 22-inch deck will not rust, and EGO backs it with a lifetime warranty on registration",
      "Touch Drive self-propel from 0.9 to 3.1 mph gives a slow, controllable crawl for steep pitches",
      "Up to 70 minutes of rated runtime on the included 10.0Ah battery",
      "Eight cutting heights from 1 to 4 inches, with levers front and rear"
    ],
    "cons": [
      "Very expensive for a walk-behind, gas or battery",
      "Fewer owner reviews than the long-running LM2156SP, so long-term reliability is less proven"
    ],
    "bottomLine": "The premium battery choice for steep lawns with thick grass, where torque matters more than price.",
    "description": "If the LM2156SP is EGO's best-known mower, the LM2206SP is the one it built to answer the question of whether a battery mower can match a strong gas engine in heavy grass. EGO rates it at 11.1 ft-lb of torque and blade speeds up to 3,350 RPM, the highest figures of any battery mower in this guide, and on a hill that headroom is what keeps the blade from bogging when the drive and the cut are both working hard. The Touch Drive self-propel runs from 0.9 to 3.1 mph, and the slow end of that range is useful: on a steep pitch you want the mower to crawl, and many drives lurch rather than creep. The 22-inch cast aluminum deck is the other headline. Aluminum does not rust, EGO backs the deck with a lifetime warranty on registration, and a cast deck holds its shape better than stamped steel over years of bumping into slopes and edges. Like the LM2156SP, it has no oil or fuel to worry about at angle, and it uses EGO's Select Cut system with interchangeable lower blades. The honest objection is price, which sits well above everything else here, and a shorter track record. If your hill is steep and your grass is thick and you want battery power, this is the most capable option; if either is moderate, the LM2156SP does most of this for less."
  },
  {
    "id": "toro-60v-recycler-22-21467-hills",
    "name": "Toro 60V Max 22\" Recycler Personal Pace (21467)",
    "category": "60V Battery, Rear-Wheel Drive, Steel Deck",
    "badge": "Best Battery for Small Slopes",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 500,
    "pros": [
      "Toro's Personal Pace drive on a battery mower, so it matches your stride up and down a grade",
      "Rear-wheel drive with 10-inch rear wheels and 8-inch fronts",
      "Same 22-inch Recycler cutting system as Toro's gas mowers, in 15-gauge steel",
      "Push-button start and no fuel or oil to manage on a slope",
      "Battery is shared across Toro's 60V Flex-Force tools"
    ],
    "cons": [
      "Rated at up to 40 minutes and about a third of an acre per charge, less than the EGO and Greenworks",
      "Around 85 lb is heavy for a battery mower, and it shows on a steep traverse"
    ],
    "bottomLine": "A good fit for a small, hilly lot where you want Toro's drive and deck without a gas engine.",
    "description": "This is the mower for a buyer who likes the way Toro's Personal Pace drive handles a slope and does not want a gas engine. It uses the same idea as the gas Recycler models: push the bar forward and the mower matches your pace, which on a climb means you can slow down naturally without adjusting a speed control. It is rear-wheel drive, rides on 10-inch rear and 8-inch front wheels, and uses Toro's 22-inch Recycler cutting system in a 15-gauge steel deck, which mulches as well as the gas versions. The limiting factor is energy. Toro rates the included 6.0Ah battery at up to 40 minutes and up to a third of an acre per charge, and that is on flat ground. A lawn that climbs will use the battery faster, so this is realistically a mower for a small hilly lot, not a large one. It is also heavy for a battery mower at around 85 lb, which you feel on a steep side-slope. If your lot is a quarter-acre with a bank or two, the combination of Personal Pace, a proper steel Recycler deck and no fuel to manage is appealing. If it is bigger, the EGO LM2156SP or a spare battery is the better plan."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Lawn Mowers for Hills",
          item: "https://www.thehonestreviewers.com/best-lawn-mower-for-hills/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best lawn mower for hills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most hilly lawns, the Toro 22-inch Recycler All-Wheel Drive with Personal Pace is our top pick. All four wheels are driven, so it keeps climbing when one wheel slips on damp grass, and the drive matches your walking speed. For battery power, the EGO LM2156SP with rear-wheel drive and 8.3 ft-lb of torque is the best choice."
          }
        },
        {
          "@type": "Question",
          "name": "Is rear-wheel or all-wheel drive better for hills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rear-wheel drive handles most hilly lawns well, because weight shifts onto the rear wheels as you climb. All-wheel drive is better on steep climbs, side-slopes and damp grass, where one slipping wheel would stop a rear-drive mower. On dry, moderate slopes the difference is small, so pay for AWD only if your slopes are steep or often wet."
          }
        },
        {
          "@type": "Question",
          "name": "Should you mow a hill up and down or side to side?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the mower. With a walk-behind, mow across the slope, side to side, so the mower cannot roll back onto your feet if you slip. With a riding mower or zero-turn, mow up and down, never across, because driving across a slope puts the weight over the downhill wheels and risks a sideways rollover."
          }
        },
        {
          "@type": "Question",
          "name": "How steep a slope can a riding mower handle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most residential riding mowers and zero-turns carry a manufacturer limit between 10 and 15 degrees, and many zero-turns sit at the low end. That limit assumes dry grass and a smooth surface. Stay well under it in practice, and use a walk-behind or string trimmer on anything close to the limit or near water or drop-offs."
          }
        },
        {
          "@type": "Question",
          "name": "Are battery lawn mowers good on hills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Good ones are. Battery mowers have no oil or fuel, so operating angle does not harm them the way it can harm a splash-lubricated gas engine. The trade-off is runtime, which falls noticeably on a lawn that is mostly climbing. Choose a model with high torque and a large battery, such as the EGO LM2156SP or Greenworks Pro 80V."
          }
        },
        {
          "@type": "Question",
          "name": "Is a zero-turn mower good for hills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Zero-turns steer and brake only through their rear wheels, with free-swiveling front casters, so if the rear tires lose grip on a slope you lose steering and braking together. Most manufacturers set limits around 10 degrees. For lawns with significant slopes, a walk-behind for the grades and a rider for the flat is safer."
          }
        },
        {
          "@type": "Question",
          "name": "What is the safest way to mow a steep bank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure it first. If it is over about 20 degrees, use a string trimmer or replace the grass with ground cover. Below that, use a rear- or all-wheel-drive walk-behind, mow across the slope when the grass is dry, wear boots with lugged soles, turn the mower uphill of you at the end of each pass, and raise the cutting height."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best lawn mower for hills",
      "self-propelled mower for slopes",
      "all-wheel drive lawn mower",
      "rear-wheel drive mower",
      "mowing on slopes safety"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Mowers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Lawn Mowers <span class="text-[#38BDF8]">for Hills</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Slopes punish the wrong drive system, the wrong wheels and the wrong mowing direction. Here are the mowers that climb, and the rules that keep you upright on a grade.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#toro-recycler-22-awd-21472"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            RWD vs AWD
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
