const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best SPC Flooring",
          item: "https://www.thehonestreviewers.com/best-spc-flooring/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is SPC flooring really waterproof?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The plank itself does not absorb water, and its mineral core will not swell the way fiberboard does. The seams and the subfloor are the weak points, since standing water can seep between planks and sit beneath them. Wipe spills promptly and test slab moisture first."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between SPC and LVP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LVP is the broad category of luxury vinyl plank, including flexible glue-down and peel-and-stick types. SPC is a rigid-core subtype with a dense limestone composite core. It is stiffer, more dent resistant and more dimensionally stable than flexible LVP, though less cushioned underfoot than WPC."
          }
        },
        {
          "@type": "Question",
          "name": "How thick should SPC flooring be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Residential SPC commonly runs from about 4 to 8 mm of total thickness. The middle of that range suits most homes. Wear layer thickness matters more for durability, so look for a higher mil rating in busy rooms before paying extra for additional millimeters."
          }
        },
        {
          "@type": "Question",
          "name": "Can SPC flooring go over existing floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often yes, if the existing surface is flat, clean and solidly attached. Manufacturers usually allow installation over vinyl, tile and concrete when conditions are met. Embossed or cushioned vinyl and carpet generally must be removed. Check the installation guide for your product."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need underlayment for SPC flooring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not if the planks have an attached pad, which many do. Adding a second layer can void warranties. Planks without a pad may need underlayment, and concrete slabs often require a vapor retarder. Follow the manufacturer's instructions for your particular product."
          }
        },
        {
          "@type": "Question",
          "name": "Can SPC flooring be used with radiant heat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only some lines are approved for radiant systems, and those carry limits on maximum surface temperature and ramp-up rate. Others are not approved at all. Confirm radiant compatibility in the manufacturer's installation guide before you float any rigid plank over heated floors."
          }
        },
        {
          "@type": "Question",
          "name": "How long does SPC flooring last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lifetimes depend mostly on wear layer, traffic and care. Manufacturers often advertise long residential warranties, but the actual service life varies with use. A higher mil wear layer, felt pads under furniture and avoiding abrasive cleaners all extend how long the surface looks good."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
