    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-navigation-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why It Decides Everything</a>
          <a href="#lidar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. LiDAR Explained</a>
          <a href="#camera" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Cameras and vSLAM</a>
