];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-15", modified: "2026-09-15" });
const title = "Impregnating vs Topical Stone Sealer: Which Your Stone Wants";
const description =
  "Impregnating sealers work inside the stone, topical sealers form a film on top. How each protects, how each fails, and which surfaces can only take one of them.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Impregnating vs Topical Stone Sealer",
          item: "https://www.thehonestreviewers.com/impregnating-vs-topical-stone-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the difference between impregnating and topical sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An impregnating sealer carries a repellent into the stone's pores and leaves nothing on the surface, so the stone looks unchanged and can still breathe. A topical sealer cures into a film on top, adding gloss and deepened colour but blocking vapour and wearing away under traffic."
          }
        },
        {
          "@type": "Question",
          "name": "Which sealer is best for granite countertops?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An impregnating sealer, specifically a fluoropolymer one rated for food contact. A topical film cannot survive knives, hot pans and daily detergent, and it cannot be repaired in one spot — a scratch means stripping and redoing the entire surface."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a topical sealer outdoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is usually a mistake. Exterior stone sits on ground that moves vapour upwards continuously, and a film blocks it until the pressure blisters and lifts the sealer. Outdoors, use an impregnator, or a colour-enhancing impregnator if you want the wet look."
          }
        },
        {
          "@type": "Question",
          "name": "Do impregnating sealers change how stone looks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, when applied correctly. The stone should look identical afterwards. If it looks hazy or patchy, product dried on the surface instead of being buffed off at the end of the dwell — fixable with more sealer to soften the residue and a hard buff."
          }
        },
        {
          "@type": "Question",
          "name": "How long does each type last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Impregnators give three to five years indoors and two to five outdoors on most stone. Topical sealers give one to three years indoors and often only six to twenty-four months outdoors, because UV and traffic attack the film directly."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put an impregnating sealer over a topical one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not successfully. The impregnator cannot reach the pores through the film, so it sits on top, stays tacky and never cures. The old film has to be chemically stripped, rinsed and fully dried first, which on textured stone usually takes two passes."
          }
        },
        {
          "@type": "Question",
          "name": "What about colour-enhancing sealers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are impregnators with added resin that deepens the stone the way water does. They stay vapour permeable, which makes them the sensible way to get a wet look on exterior slate or flagstone. The effect is permanent, so test on an offcut before committing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
