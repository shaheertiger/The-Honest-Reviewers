---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Concrete Countertop Sealer",
    "url": "/best-concrete-countertop-sealer/"
  },
  {
    "title": "Food-Safe Concrete Countertop Sealer",
    "url": "/food-safe-concrete-countertop-sealer/"
  },
  {
    "title": "Concrete Countertop Sealer Not Curing",
    "url": "/concrete-countertop-sealer-not-curing/"
  },
  {
    "title": "How Often to Seal Granite Countertops",
    "url": "/how-often-to-seal-granite-countertops/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-18", modified: "2026-09-18" });
const title = "How Often to Seal Concrete Countertops? Test the Surface, Not the Calendar";
const description =
  "Penetrating sealers want topping up every one to three years; films last five or more then need stripping. The water test that tells you, and the wax that delays both.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Often to Seal Concrete Countertops",
          item: "https://www.thehonestreviewers.com/how-often-to-seal-concrete-countertops/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How often should you seal concrete countertops?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends entirely on the sealer. Penetrating sealers want topping up every one to three years, acrylic films every two to four, polyurethanes every four to six and epoxies every five to eight. Rather than following those figures, do a thirty-second water test every six months and reseal when it fails."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know when my concrete countertop needs resealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Put a few drops of water in several places and wait a minute. Beading means the sealer is working; spreading and darkening the concrete means that area has lost protection. Test the hob zone, the sink surround and an unused corner, because they wear at very different rates."
          }
        },
        {
          "@type": "Question",
          "name": "Can you over-seal a concrete countertop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With a penetrating sealer, not really — excess simply does not absorb and is wiped off, though leaving it to dry on the surface causes a blotchy residue. With film sealers, repeated recoating builds thickness that eventually needs stripping, so assess whether a recoat or a strip is appropriate each time."
          }
        },
        {
          "@type": "Question",
          "name": "What ruins a concrete countertop sealer fastest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Acidic cleaners — vinegar, lemon-based products, bleach and abrasive creams. Many countertops lose their sealer within a year to routine cleaning with the wrong product. After that: cutting directly on the surface, sliding pans, hot pans on film sealers, and the permanently damp strip beside the sink."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to strip the old sealer before resealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for a penetrating sealer, which is simply topped up and blends invisibly. For a film sealer, only if it is scratched, hazed, breached or you do not know what it is. A sound film that is merely thinning can take a light abrasion and a compatible recoat."
          }
        },
        {
          "@type": "Question",
          "name": "What is sacrificial wax and do I need it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A food-safe paste wax applied over the sealer that wears away in its place, taking daily abrasion and minor acid contact. It takes ten minutes to apply, needs redoing every three to six months, and roughly doubles the interval between resealing on a penetrating system. It is standard professional practice."
          }
        },
        {
          "@type": "Question",
          "name": "My countertop looks dull but water still beads — what does that mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually that the wax has worn while the sealer underneath is still intact, which calls for a ten-minute rewax rather than a resealing job. Distinguishing the two saves considerable unnecessary work, and it is one of the more useful things the water test tells you."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
