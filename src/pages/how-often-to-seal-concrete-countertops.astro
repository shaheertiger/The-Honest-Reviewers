      "resealing concrete countertop",
      "concrete countertop maintenance"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Tested Concrete Countertop Sealers",
    link: "/best-concrete-countertop-sealer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Maintenance
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How Often to Seal <span class="text-[#38BDF8]">Concrete Countertops?</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Anywhere from every year to every decade, depending entirely on which kind of sealer you have. The calendar is close to useless here, and a thirty-second water test tells you more than any published interval.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#intervals"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            Learn the Water Test
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#intervals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Intervals by Sealer Type</a>
          <a href="#water-test" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Water Test</a>
          <a href="#other-signs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Other Signs</a>
          <a href="#what-shortens" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Shortens It</a>
          <a href="#wax" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The Sacrificial Wax</a>
          <a href="#reapply" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Reapplying, Step by Step</a>
          <a href="#schedule" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. A Maintenance Schedule</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Waiting until a countertop looks bad is waiting too long. By the time staining is visible the protection has been gone for months, and the marks left behind are in the concrete rather than in the sealer.
        </p>

        <div id="intervals" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Intervals by Sealer Type
          </h2>

          <p>
            The published figures span an order of magnitude, which tells you the sealer type matters far more than any general rule.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sealer Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Light Use</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Normal Kitchen</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Heavy Use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Penetrating, no wax</td>
                    <td class="px-4 py-4 text-gray-700">2-3 years</td>
                    <td class="px-4 py-4 text-gray-700">1-2 years</td>
                    <td class="px-4 py-4 text-gray-700">Annually</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Penetrating plus wax</td>
                    <td class="px-4 py-4 text-gray-700">3-4 years</td>
                    <td class="px-4 py-4 text-gray-700">2-3 years</td>
                    <td class="px-4 py-4 text-gray-700">1-2 years</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Acrylic film</td>
                    <td class="px-4 py-4 text-gray-700">3-5 years</td>
                    <td class="px-4 py-4 text-gray-700">2-4 years</td>
                    <td class="px-4 py-4 text-gray-700">2 years</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Polyurethane film</td>
                    <td class="px-4 py-4 text-gray-700">5-8 years</td>
                    <td class="px-4 py-4 text-gray-700">4-6 years</td>
                    <td class="px-4 py-4 text-gray-700">3-4 years</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Epoxy film</td>
                    <td class="px-4 py-4 text-gray-700">7-10 years</td>
                    <td class="px-4 py-4 text-gray-700">5-8 years</td>
                    <td class="px-4 py-4 text-gray-700">4-6 years</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sacrificial wax over any</td>
                    <td class="px-4 py-4 text-gray-700">6-12 months</td>
                    <td class="px-4 py-4 text-gray-700">3-6 months</td>
                    <td class="px-4 py-4 text-gray-700">Every 2-3 months</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The crucial difference is not just how long each lasts but what happens at the end. A penetrating sealer depletes gradually and is topped up by cleaning and reapplying, which takes an hour and blends invisibly. A film sealer wears through and eventually needs stripping and recoating, which is a substantially larger job on a fitted countertop.
          </p>

          <p>
            So penetrating sealers ask for more frequent, trivial attention; film sealers ask for rare, significant attention. Which suits you is a genuine preference rather than a technical question, and our comparison of epoxy and penetrating sealers covers the broader trade.
          </p>

          <p>
            The wax row is different in kind. A sacrificial paste wax is not a sealer and does not replace one; it sits on top taking the daily abrasion so the sealer underneath lasts longer. It needs reapplying every few months, which sounds tedious and takes about ten minutes.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE POINT</p>
            <p class="text-xl font-bold text-white mb-3">Penetrating: frequent and trivial. Film: rare and significant.</p>
            <p class="text-gray-300 leading-relaxed m-0">A penetrating sealer is topped up in an hour with no visible edge, every year or two. A film sealer lasts five years or more and then needs the whole surface stripped and recoated. Neither is less work overall; they distribute it differently.</p>
          </div>
        </div>

        <div id="water-test" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Water Test
          </h2>

          <p>
            Thirty seconds, no equipment, and far more reliable than any interval in the table above.
          </p>

          <p>
            Put a few drops of water on the countertop in several places — the area in front of the hob, next to the sink, a corner that sees little use — and wait a minute or two. If the water beads and sits, the sealer is working. If it spreads out and darkens the concrete beneath, that area has lost its protection.
          </p>

          <p>
            Test several spots, because wear is never even. The zone in front of the hob and the strip beside the sink fail first, often years before a corner does. A countertop is usually part due and part fine, and that is exactly what a calendar cannot tell you.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What the Water Does</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Condition</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Beads tightly, sits several minutes</td>
                    <td class="px-4 py-4 text-gray-700">Good</td>
                    <td class="px-4 py-4 text-gray-700">Retest in six months</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Beads weakly, slowly flattens</td>
                    <td class="px-4 py-4 text-gray-700">Starting to deplete</td>
                    <td class="px-4 py-4 text-gray-700">Reseal within a few months</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Spreads and darkens within a minute</td>
                    <td class="px-4 py-4 text-gray-700">Protection gone</td>
                    <td class="px-4 py-4 text-gray-700">Reseal now</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Darkens immediately</td>
                    <td class="px-4 py-4 text-gray-700">Well overdue</td>
                    <td class="px-4 py-4 text-gray-700">Reseal, check for existing stains</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Beads but surface looks dull</td>
                    <td class="px-4 py-4 text-gray-700">Wax worn, sealer fine</td>
                    <td class="px-4 py-4 text-gray-700">Rewax only</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The last row matters if you use a wax. A dull appearance with intact beading means the wax has worn and the sealer underneath is still doing its job — a ten-minute rewax rather than a resealing job. Distinguishing these saves a lot of unnecessary work.
          </p>

          <p>
            Do the same test with a drop of olive oil if you want a harder check. Oil is more demanding than water and a sealer that still beads water may already be letting oil in, which for a kitchen is the more relevant threat. If oil darkens the surface within a few minutes, reseal regardless of what water does.
          </p>

          <p>
            Test every six months, in spring and autumn. It takes half a minute and it means you reseal when the surface needs it rather than when you remember to think about it.
          </p>
        </div>

        <div id="other-signs" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Other Signs
          </h2>

          <p>
            Four things to watch for alongside the water test.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Spills Are Starting to Mark</h3>

          <p>
            The functional test and the one people notice first. If coffee, wine or oil now leaves a shadow where it used to wipe off completely, the protection has gone regardless of appearance. Act on this immediately, because each subsequent spill is going into bare concrete.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">A Dull Patch in the Work Zone</h3>

          <p>
            A visible difference in sheen between the area in front of the hob or sink and the rest of the surface means the sealer or wax has worn through there. On a film sealer this is the early warning before the film fails properly.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Surface Feels Different</h3>

          <p>
            Run a hand across the whole countertop. A worn area often feels slightly more porous or grippy than a protected one, and you will notice it before you see it. This is particularly true of penetrating sealers, where there is no gloss change to give it away.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Etch Marks Appearing</h3>

          <p>
            Dull spots where something acidic sat mean the acid is reaching the concrete. On a penetrating sealer this indicates depletion. On a film sealer it means the film has been breached, which is more serious and warrants a close inspection for cracks or wear-through.
          </p>

          <p>
            What is not a sign: general darkening of the concrete over years. Concrete deepens in colour as it continues to hydrate and as it acquires a patina, and that is normal ageing rather than sealer failure. Judge by the water test rather than by colour.
          </p>
        </div>

        <div id="what-shortens" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Shortens the Interval
          </h2>

          <p>
            If your countertop is failing faster than the table suggests, one of these is usually why.
          </p>

          <p>
            Harsh cleaners, and this is the big one. Vinegar, lemon-based cleaners, bleach, ammonia and abrasive creams all attack either the sealer or the concrete under it. A great many concrete countertops are stripped of their sealer within a year by someone cleaning them the way they cleaned their old worktop. pH-neutral only.
          </p>

          <p>
            Abrasion in the work zone. Cutting directly on the surface, sliding pans, scrubbing with a scouring pad. A film sealer thins where this happens and a penetrating sealer is abraded out of the top of the pore structure. Boards and trivets are not fussiness; they are the maintenance schedule.
          </p>

          <p>
            Heat. On a film sealer, repeated hot contact softens and degrades the film long before it leaves a visible mark. This is a slow failure that shows up as premature wear rather than as a single event.
          </p>

          <p>
            Standing water. The area beside a sink that is permanently damp is the first to fail on almost every countertop, because the sealer is under continuous challenge rather than occasional. Wiping the sink surround dry after washing up genuinely extends the interval.
          </p>

          <p>
            Sunlight, where the countertop is near a window. UV degrades some sealers and can amber epoxies, and the affected strip will need attention before the rest of the surface.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">What Costs You Time</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">Vinegar</p>
                <p class="text-gray-400 text-xs mt-1">Strips sealer fastest</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">Sink edge</p>
                <p class="text-gray-400 text-xs mt-1">Always fails first</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">Cutting</p>
                <p class="text-gray-400 text-xs mt-1">Abrades the work zone</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">Hot pans</p>
                <p class="text-gray-400 text-xs mt-1">Degrades films invisibly</p>
              </div>
            </div>
          </div>
        </div>

        <div id="wax" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. The Sacrificial Wax Almost Nobody Uses
          </h2>

          <p>
            This is standard practice in professional concrete countertop work and largely unknown among homeowners, and it changes the maintenance picture considerably.
          </p>

          <p>
            A food-safe paste wax applied over the sealer forms a thin, soft layer that takes the daily abrasion, minor acid contact and water exposure instead of the sealer. It is deliberately sacrificial: it wears away and you reapply it, which protects the much more expensive and much harder-to-renew sealer underneath.
          </p>

          <p>
            Application takes about ten minutes. Apply a thin coat with a soft cloth, let it haze, then buff off. It adds a slight sheen and a noticeably pleasant feel to the surface, and on a penetrating-sealed countertop it also adds real water resistance.
          </p>

          <p>
            Reapply every three to six months in a normal kitchen, and every couple of months in a busy one. The water test tells you when: if beading has weakened but you know the sealer is not old, it is usually the wax that has gone.
          </p>

          <p>
            It roughly doubles the effective interval between resealing on a penetrating system, which for ten minutes every few months is an excellent trade. On a film system it is less transformative but still reduces wear in the high-traffic zones.
          </p>

          <p>
            Check the wax is food-safe and compatible with your sealer. Carnauba and beeswax-based products intended for countertops are the usual choice, and a furniture wax is not the same thing. Our guide on food-safe countertop sealers covers what to look for on a label.
          </p>
        </div>

        <div id="reapply" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Reapplying, Step by Step
          </h2>

          <p>
            For a penetrating sealer this is genuinely an hour's work. For a film it depends on whether you are recoating or stripping.
          </p>

          <p>
            Clear and clean thoroughly. Remove everything from the surface, clean with a pH-neutral cleaner, and if there is wax on it, remove that first with the solvent the wax maker specifies — new sealer will not penetrate through old wax.
          </p>

          <p>
            Let it dry completely. A countertop that has just been cleaned holds moisture in the surface, and sealing over it causes clouding. Several hours at minimum, and overnight is safer.
          </p>

          <p>
            For a penetrating sealer: apply thinly and evenly with a cloth or applicator pad, let it dwell for the stated time, then wipe off any excess that has not absorbed. That last step matters — penetrating sealer left to dry on the surface leaves a residue that looks blotchy and has to be removed.
          </p>

          <p>
            For a film sealer, decide first whether to recoat or strip. If the film is sound and simply thinning, a light abrasion followed by a compatible coat works, and compatibility means the same system where possible. If the film is scratched, hazed, breached or unknown, strip and start again, because coating over a damaged film locks the damage in permanently.
          </p>

          <p>
            Then respect the cure before use. Even a simple penetrating top-up wants a day before heavy use, and a film recoat wants the full chemical cure of several days to weeks. Our guide on sealing a concrete countertop covers the timings.
          </p>

          <p>
            Wax afterwards, once the sealer has cured, and note the date.
          </p>
        </div>

        <div id="schedule" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. A Maintenance Schedule
          </h2>

          <p>
            What this looks like as an actual routine.
          </p>

          <p>
            Daily: wipe spills promptly, especially acidic and oily ones, and clean with pH-neutral products only. Use boards and trivets without exception. This is ninety percent of countertop maintenance and it costs nothing.
          </p>

          <p>
            Every two to three months: reapply the sacrificial wax if you use one. Ten minutes, and it roughly doubles how long the sealer lasts.
          </p>

          <p>
            Every six months: do the water test in four or five places, including the hob zone, the sink surround and an unused corner. Note the result somewhere so you can see the trend across years.
          </p>

          <p>
            Every one to three years, for a penetrating sealer: clean, dry and reapply. An hour, no visible edge, and the surface is back to new performance.
          </p>

          <p>
            Every five years or so, for a film sealer: assess whether it needs recoating or stripping, and plan accordingly. This is the job that benefits most from having recorded which product is on there.
          </p>

          <p>
            And write the product and date on a piece of tape inside a cupboard door. The most common cause of a difficult countertop reseal is nobody remembering what is on it, which forces either a test patch or a precautionary strip on a surface where neither is convenient.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Following a Calendar Instead of Testing</h3>
              <p class="text-gray-700 text-sm m-0">
                Published intervals span from one year to a decade because sealer type matters far more than time. The water test takes thirty seconds: drops that bead mean the sealer is working, drops that spread and darken the concrete mean that area is due. Test several spots, because wear is never even.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Cleaning With Vinegar or Lemon-Based Products</h3>
              <p class="text-gray-700 text-sm m-0">
                Acidic cleaners strip sealer and etch the concrete underneath, and a great many concrete countertops lose their protection within a year to someone cleaning them the way they cleaned a previous worktop. pH-neutral products only — warm water and mild dish soap handles almost everything.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Waiting Until Stains Appear</h3>
              <p class="text-gray-700 text-sm m-0">
                By the time staining is visible the protection has been gone for months, and the marks are in the concrete rather than in the sealer, so resealing will not remove them. The water test catches depletion while it is still only a maintenance job.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Skipping the Sacrificial Wax</h3>
              <p class="text-gray-700 text-sm m-0">
                A food-safe paste wax over the sealer takes the daily abrasion instead of the sealer, roughly doubling the interval on a penetrating system for ten minutes of work every few months. It is standard in professional concrete countertop work and almost unknown among homeowners.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Recoating a Film That Should Be Stripped</h3>
              <p class="text-gray-700 text-sm m-0">
                Coating over a scratched, hazed or breached film locks the damage in permanently and adds thickness over a compromised layer. If the film is sound and merely thinning, a light abrasion and a compatible coat is right. If it is damaged or unknown, strip it.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How often should you seal concrete countertops?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It depends entirely on the sealer. Penetrating sealers want topping up every one to three years, acrylic films every two to four, polyurethanes every four to six and epoxies every five to eight. Rather than following those figures, do a thirty-second water test every six months and reseal when it fails.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I know when my concrete countertop needs resealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Put a few drops of water in several places and wait a minute. Beading means the sealer is working; spreading and darkening the concrete means that area has lost protection. Test the hob zone, the sink surround and an unused corner, because they wear at very different rates.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you over-seal a concrete countertop?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                With a penetrating sealer, not really — excess simply does not absorb and is wiped off, though leaving it to dry on the surface causes a blotchy residue. With film sealers, repeated recoating builds thickness that eventually needs stripping, so assess whether a recoat or a strip is appropriate each time.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What ruins a concrete countertop sealer fastest?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Acidic cleaners — vinegar, lemon-based products, bleach and abrasive creams. Many countertops lose their sealer within a year to routine cleaning with the wrong product. After that: cutting directly on the surface, sliding pans, hot pans on film sealers, and the permanently damp strip beside the sink.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I need to strip the old sealer before resealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Not for a penetrating sealer, which is simply topped up and blends invisibly. For a film sealer, only if it is scratched, hazed, breached or you do not know what it is. A sound film that is merely thinning can take a light abrasion and a compatible recoat.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is sacrificial wax and do I need it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A food-safe paste wax applied over the sealer that wears away in its place, taking daily abrasion and minor acid contact. It takes ten minutes to apply, needs redoing every three to six months, and roughly doubles the interval between resealing on a penetrating system. It is standard professional practice.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">My countertop looks dull but water still beads — what does that mean?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Usually that the wax has worn while the sealer underneath is still intact, which calls for a ten-minute rewax rather than a resealing job. Distinguishing the two saves considerable unnecessary work, and it is one of the more useful things the water test tells you.
              </p>
            </div>

          </div>
        </div>

