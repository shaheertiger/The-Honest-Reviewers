---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Pool Heaters",
    "url": "/best-pool-heater/"
  },
  {
    "title": "Best Home Saunas",
    "url": "/best-sauna/"
  },
  {
    "title": "Best Cold Plunge Tubs",
    "url": "/best-cold-plunge/"
  },
  {
    "title": "Best Pool Vacuums",
    "url": "/best-pool-vacuum/"
  },
  {
    "title": "Best Pool Deck Sealers",
    "url": "/best-pool-deck-sealer/"
  },
  {
    "title": "Concrete Patio Cost",
    "url": "/concrete-patio-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "7 Best Hot Tubs: Inflatable and Plug-and-Play Picks Compared";
const description =
  "The best hot tubs for most backyards, from inflatable spas to 110V plug-and-play hard shells, compared on seats, insulation, power needs and running cost.";

const PRODUCTS = [
  {
    "id": "coleman-saluspa-hawaii-airjet",
    "name": "Coleman SaluSpa Hawaii AirJet (Square)",
    "badge": "Best Inflatable Overall",
    "category": "Inflatable, 4 to 6 People, 104°F Max",
    "amazonUrl": "#",
    "description": "The square Hawaii AirJet is the inflatable we would buy for most first-time owners, because it pairs a sensible size with the insulation features that decide how much an inflatable costs to run. Best Buy lists the square Hawaii for four to six people with 140 jets and an EnergySense cover; one Walmart listing for a grey variant gives 114 jets, so check the jet count on the exact bundle. Sellers list a 104°F maximum and one gives a 40 to 104°F heat range and 222 gallons at 80 percent fill. The walls use Bestway's DuraPlus three-layer material, which one listing says is 33 percent more puncture resistant than PVC, and the maker says the EnergySense cover makes the tub about 40 percent more energy efficient. A Freeze Shield function heats automatically to stop the water freezing, though listings disagree on the lowest outdoor temperature it handles (one says about 39°F, another 14°F), so read the manual before running it through a hard winter. The package typically includes the cover, pump, chemical floater, two filter cartridges and a repair patch.",
    "pros": [
      "Seats four to six with 140 AirJets on most listings",
      "EnergySense cover, which the maker says improves efficiency about 40%",
      "Freeze Shield automatic freeze protection",
      "DuraPlus three-layer walls instead of plain PVC"
    ],
    "cons": [
      "Jet count varies by bundle (114 or 140)",
      "Listings disagree on the cold-weather limit for Freeze Shield",
      "Air jets bubble rather than massage like water jets"
    ],
    "bottomLine": "For most people trying a hot tub for the first time, the square Coleman Hawaii AirJet is the inflatable to buy: room for four to six, a better cover than most, and freeze protection."
  },
  {
    "id": "intex-purespa-plus",
    "name": "Intex PureSpa Plus (4-Person)",
    "badge": "Best Value Inflatable",
    "category": "Inflatable, 4 People, 68 to 104°F",
    "amazonUrl": "#",
    "description": "Intex's PureSpa Plus is the value pick: a four-person inflatable with a wireless control panel and enough jets to feel like a hot tub rather than a heated paddling pool. Retail listings give a 68 to 104°F temperature range set from the wireless panel, and most list 140 bubble jets, though one Walmart listing says 120 for the same line. Several Walmart listings give a 210-gallon water capacity and inner dimensions of 63 by 63 by 28 inches, and say it is ready for water in about 20 minutes. Intex's naming is genuinely confusing: listings mix 4-person and 6-person labels and give outside dimensions of both 69 and 83 inches, so match the exact model number to Intex's own spec page before you order. What the PureSpa Plus does well is the basics: a smaller water volume heats faster and costs less to keep warm than a larger tub, and Intex's replacement filters and parts are easy to find.",
    "pros": [
      "Wireless control panel with a 68 to 104°F range",
      "About 210 gallons, so it heats faster than bigger tubs",
      "Sets up in about 20 minutes, per listings",
      "Parts and filters are widely available"
    ],
    "cons": [
      "Model naming and dimensions vary across listings",
      "Jet count listed as 140 or 120",
      "Fits four comfortably, not six"
    ],
    "bottomLine": "If you want an affordable inflatable for two to four people and are careful to match the model number, the Intex PureSpa Plus delivers the essentials for less."
  },
  {
    "id": "bestway-palm-springs-airjet",
    "name": "Bestway Lay-Z-Spa Palm Springs AirJet",
    "badge": "Best Larger Inflatable",
    "category": "Inflatable, 4 to 6 People, 140 Jets",
    "amazonUrl": "#",
    "description": "The Palm Springs AirJet is Bestway's larger round inflatable, and it is the one to choose if six adults will actually use it at once. Retail listings for model 60017 give four to six people, 140 jets and water heated up to 40°C (104°F), with an outside footprint of about 196 by 196 by 71 cm, or roughly 77 by 77 by 28 inches. One listing gives a 916-litre water capacity, which works out to about 242 US gallons by our conversion; we did not find an official gallon figure. Listings also disagree on empty weight (34 kg in one, 43 kg in another). A bigger tub takes longer to heat and costs more to hold at temperature, so this is the right choice only if the extra seats will be used. Some retailers list it as sold out, and Bestway sells many similar Lay-Z-Spa names, so check the model number on the listing.",
    "pros": [
      "Roomier round shell for four to six adults",
      "140 AirJets and a 104°F maximum, per listings",
      "Lay-Z-Spa parts and filters are easy to source"
    ],
    "cons": [
      "Larger water volume heats slower and costs more to keep warm",
      "No official gallon figure found; listings conflict on weight",
      "Stock is patchy at some retailers"
    ],
    "bottomLine": "Buy the Palm Springs AirJet when you regularly need room for five or six; for two to four people, a smaller tub is cheaper to run."
  },
  {
    "id": "lifesmart-ls200",
    "name": "Lifesmart LS200 (Rock Solid Luna)",
    "badge": "Best Plug-and-Play",
    "category": "Rotomolded, 4 People, 13 Jets, 110V",
    "amazonUrl": "#",
    "description": "A plug-and-play hard-shell tub is the step up from an inflatable: real water jets, a rigid shell you can sit on, and no electrician as long as you have a suitable outlet. Sam's Club lists the Lifesmart LS200 as a 110V plug-and-play spa with 13 jets, seating for four adults, three cupholders and a multi-color underwater LED light, and says it includes a thermal locking cover, a filter and a 15-foot GFCI cord. Wayfair sells what appears to be the same tub as the Rock Solid Luna, but its title and description name different models, so confirm the model number. The trade-off with any 120V tub is heating power: a standard 15-amp circuit limits how much heater and pump can run at once, so expect slower heat-up than a 240V tub and plan to keep the cover on between uses. For a small household that wants a durable shell without wiring, it is the sensible starting point.",
    "pros": [
      "Plugs into a standard 110V outlet with an included 15 ft GFCI cord",
      "Rigid rotomolded shell with 13 water jets",
      "Thermal locking cover included",
      "Underwater LED and three cupholders"
    ],
    "cons": [
      "120V heating is slower than a 240V tub",
      "Retailer titles mix up model names",
      "Four adults is a tight fit"
    ],
    "bottomLine": "If you want a hard-shell tub without hiring an electrician, the Lifesmart LS200 is the plug-and-play spa to start with, provided you keep the cover on."
  },
  {
    "id": "lifesmart-rock-solid-simplicity",
    "name": "Lifesmart Rock Solid Simplicity",
    "badge": "Best Insulated Plug-and-Play",
    "category": "Rotomolded, 4 People, 13 Jets, Full Foam",
    "amazonUrl": "#",
    "description": "The Rock Solid Simplicity is the plug-and-play tub we would pick for colder climates, because retailers list it with full foam insulation, which matters far more to the power bill than jet count. Retail listings describe a four-person, 13-jet tub with a sandstone-style rotomolded shell, full foam insulation, a Balboa digital control system and mood lighting, designed to run on a standard 110V outlet. One listing's data table gives a 195-gallon capacity and a 295 lb dry weight, which is light enough that two people can position it on a pad. Full foam insulation fills the cabinet around the plumbing, so heat leaks out more slowly and the small 120V heater has an easier job keeping up in cold weather. Balboa controls are common across the industry, which helps if a technician ever needs to service it.",
    "pros": [
      "Full foam insulation for lower heat loss, per listings",
      "Balboa digital controls, common and serviceable",
      "About 195 gallons and 295 lb dry, per one listing",
      "Runs on a standard 110V outlet"
    ],
    "cons": [
      "Capacity and weight come from a single listing's data table",
      "120V heater limits recovery speed",
      "Only 13 jets"
    ],
    "bottomLine": "For a plug-and-play tub that will sit outside through a real winter, the insulated Rock Solid Simplicity is the better buy than a jet-heavy model with thin insulation."
  },
  {
    "id": "lifesmart-ls500-plus",
    "name": "Lifesmart LS500 Plus",
    "badge": "Best for Five People",
    "category": "Rotomolded, 5 People, 23 Jets, 120V/15 A",
    "amazonUrl": "#",
    "description": "If four seats is not enough but you still want to avoid 240V wiring, the LS500 Plus is the size up. Sam's Club lists it as a five-person, 23-jet plug-and-play tub with a 1.0 HP pump, and notes that it needs a standard 15-amp dedicated electrical circuit. That dedicated-circuit requirement is the important line: plugging a hot tub into a shared outlet that also runs lights or a freezer invites tripped breakers, so check that the outlet you plan to use serves nothing else. More jets and a bigger pump give a stronger massage than the four-person models, but the water volume is larger too, so heat-up after a refill takes longer on 120V. Treat it as a tub that holds temperature well with the cover on rather than one you heat from cold every evening.",
    "pros": [
      "Five seats and 23 jets with a 1.0 HP pump, per Sam's Club",
      "Still plug-and-play on a 15 A circuit",
      "Stronger massage than four-person 13-jet models"
    ],
    "cons": [
      "Needs a dedicated 15 A circuit, per the listing",
      "Larger volume heats slowly on 120V",
      "We found no official Lifesmart spec sheet"
    ],
    "bottomLine": "For five people and no 240V wiring, the LS500 Plus is the tub to buy, as long as you can give it its own 15-amp circuit."
  },
  {
    "id": "lifesmart-ls450dx",
    "name": "Lifesmart LS450DX",
    "badge": "Best for Groups",
    "category": "Rotomolded, 7 People, 22 Jets, 300 Gallons",
    "amazonUrl": "#",
    "description": "The LS450DX is the largest plug-and-play tub we would consider, listed for seven people with 22 jets and a waterfall feature. Retail listings give a 300-gallon capacity and a 15-amp, 110V electrical requirement. Three hundred gallons is a lot of water for a 120V heater to warm, so this is a tub to fill, heat over a day or two and then keep at temperature with the cover on, not one to heat quickly before a party. Seven seats in a rotomolded shell also means more weight on the base once it is full: 300 gallons of water alone weighs about 2,500 lb before anyone climbs in, so the pad matters. For families who regularly have a crowd, it offers the most seats you can get without hiring an electrician.",
    "pros": [
      "Seven seats and 22 jets, per listings",
      "Waterfall feature",
      "Still runs on a 110V, 15 A supply"
    ],
    "cons": [
      "300 gallons heats slowly on 120V",
      "Heavy when full; needs a solid, level base",
      "Specs come from retailer listings only"
    ],
    "bottomLine": "When you need seven seats and cannot add a 240V circuit, the LS450DX is the plug-and-play tub to buy; give it a proper pad and keep the cover on."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Hot Tubs",
          item: "https://www.thehonestreviewers.com/best-hot-tub/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best hot tub for the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people trying a hot tub, a good inflatable like the square Coleman SaluSpa Hawaii AirJet offers the most for the money, with room for four to six and an efficiency-focused cover. If you want a hard shell without hiring an electrician, a plug-and-play tub like the Lifesmart LS200 is the value step up."
          }
        },
        {
          "@type": "Question",
          "name": "Are plug-and-play hot tubs any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, within their limits. They run on 120V, usually on a dedicated 15 or 20 amp circuit, so they heat more slowly and many cannot run the heater at full power with the jets on high. For one to five people who keep the tub covered at temperature, they work well and avoid 240V wiring."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a hot tub?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends mostly on weather, insulation and the cover. As an example, a 1,500-watt heater running eight hours a day uses 12 kWh, about $2 a day at 17 cents per kWh. A well-insulated tub with a good locking cover runs its heater much less."
          }
        },
        {
          "@type": "Question",
          "name": "What temperature should a hot tub be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The CPSC recommends that hot tub water never exceed 104°F. Many people are comfortable between 100 and 102°F. Use lower temperatures for children and shorter sessions at the top of the range, and ask a doctor first if you are pregnant or have a heart condition."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put a hot tub on my deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the deck is built for it. A filled tub with people can exceed the roughly 40 lb per square foot live load many residential decks are designed for. Have a builder or engineer check the structure, or put the tub on a concrete pad or compacted paver base instead."
          }
        },
        {
          "@type": "Question",
          "name": "How long do inflatable hot tubs last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With careful use, an inflatable often lasts a few seasons. Punctures, pump wear and UV damage are the usual causes of failure. Keeping it covered, on a smooth mat away from sharp objects, and draining and storing it properly in winter all extend its life."
          }
        },
        {
          "@type": "Question",
          "name": "Do hot tubs need a dedicated circuit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most do. Plug-and-play tubs typically need a dedicated 15 or 20 amp 120V circuit with GFCI protection, and the Lifesmart LS500 Plus, for example, is listed as needing a dedicated 15-amp circuit. 240V tubs need a dedicated circuit and GFCI disconnect installed by a licensed electrician."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Pool & Spa",
    tags: [
      "best hot tub",
      "inflatable hot tub",
      "plug and play hot tub",
      "best hot tub brands",
      "4 person hot tub"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Buyer's Guide
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Hot Tubs</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Inflatable and plug-and-play hot tubs compared on what decides the experience and the bill: seats, insulation, cover, power needs and safety.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#coleman-saluspa-hawaii-airjet"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Inflatable, Plug-and-Play or 240V</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Picks</a>
          <a href="#insulation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Insulation and Covers</a>
          <a href="#running-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Running Cost</a>
          <a href="#base" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Base and Electrical</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Safety and Water Care</a>
          <a href="#acrylic" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. 240V Acrylic Tubs</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The best hot tub for most people is the one that holds its heat. Choose the type first, inflatable to try it, plug-and-play for years of use without an electrician, 240V for fast heat, then pick the model with the best cover and insulation.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-picked" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Picked
          </h2>

          <p>
            We did not fill and soak in these tubs. We compared the specifications manufacturers and retailers publish, seating, jet count, water volume, maximum temperature, insulation, electrical requirements and what comes in the box, and we note on each card where listings disagree. The hot tub market is full of near-identical model names and bundles, so every card tells you which detail to confirm before ordering.
          </p>

          <p>
            We split the category into the two kinds most people can buy without a dealer visit: inflatable tubs, which cost the least and pack away, and rotomolded plug-and-play tubs, which have hard shells and real water jets but still run on a standard outlet. Acrylic hot tubs from dealer brands are a third tier; they need a 240V circuit and a delivery crew, and we cover how to judge them below rather than ranking models whose specs vary dealer by dealer.
          </p>

          <p>
            Within each kind, we favored insulation and covers over jet counts. A hot tub spends most of its life sitting at temperature with nobody in it, so the features that stop heat leaking out, a thick, well-fitting cover and foam insulation, matter more to your power bill than whether there are 13 jets or 23.
          </p>

          <p>
            We also gave weight to safety basics: a maximum temperature no higher than 104°F, a lockable cover, and clear electrical requirements. Those are not features to trade away for a lower price.
          </p>
        </div>

        <div id="types" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Inflatable, Plug-and-Play or 240V
          </h2>

          <p>
            An <strong>inflatable hot tub</strong> is a heated, insulated vinyl tub with air jets that bubble rather than massage. It is the cheapest way in, sets up in an afternoon and can be drained and stored for winter. The trade-offs are durability, comfort (no molded seats) and heat retention, which is weaker than a hard shell's even with a good cover.
          </p>

          <p>
            A <strong>plug-and-play tub</strong> has a rigid rotomolded shell, water jets and a cabinet you can insulate. It runs on a 120V outlet, usually needing a dedicated 15 or 20 amp circuit. Because a 120V circuit can only deliver so much power, these tubs heat slowly and many cannot run the heater at full power while the jets are on high. They are ideal for one to five people who leave the tub at temperature with the cover on.
          </p>

          <p>
            A <strong>240V acrylic tub</strong> is the traditional hot tub: molded acrylic seats, powerful pumps and a heater commonly in the 4 to 5.5 kW range, wired to a dedicated circuit, often 40 or 50 amps, through a GFCI disconnect. It heats quickly and runs jets and heater together, but it needs an electrician, a permit in most areas and a delivery crew, and it costs several times more than the other two kinds.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Heat-up speed</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Lifespan expectation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Inflatable</td>
                    <td class="px-4 py-4 text-gray-700">120V outlet</td>
