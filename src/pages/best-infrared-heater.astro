---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Electric Space Heaters",
    "url": "/best-electric-space-heater/"
  },
  {
    "title": "Best Oil-Filled Radiator Heaters",
    "url": "/best-oil-filled-radiator-heater/"
  },
  {
    "title": "Best Garage Heaters",
    "url": "/best-garage-heater/"
  },
  {
    "title": "Best Indoor Heaters for Power Outages",
    "url": "/best-indoor-heater-for-power-outage/"
  },
  {
    "title": "Best Battery-Powered Heaters",
    "url": "/best-battery-powered-heater/"
  },
  {
    "title": "Can a Portable Power Station Run a Space Heater?",
    "url": "/can-a-portable-power-station-run-a-space-heater/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Infrared Heaters in 2026: Safe Picks, No Hype";
const description =
  "Infrared heaters are not more efficient: every 1,500 W heater makes the same heat. They warm what they face. Seven safe picks, plus sizing, costs and safety.";

const PRODUCTS = [
  {
    "id": "dr-infrared-dr-978",
    "name": "Dr. Infrared Heater DR-978 Dual Heating Hybrid Infrared Space Heater, 1500W",
    "category": "Infrared Cabinet, Quartz + PTC, 1,500 W, UL/cUL, Remote",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "UL and cUL certified, per the listing",
      "Tip-over and overheat shut-off protection",
      "No exposed heating elements: a sensible pick around children and pets",
      "Thermostat from 50 to 86 degrees with Eco, high and low settings",
      "12-hour timer and remote control"
    ],
    "cons": [
      "The 5,200 BTU rating is just what 1,500 W produces, not extra power",
      "Boxy cabinet takes more floor space than a tower",
      "The blower adds some fan noise in a quiet bedroom"
    ],
    "bottomLine": "The best infrared heater for most living rooms and bedrooms: a certified cabinet heater with tip-over and overheat shut-off, a real thermostat and a timer.",
    "description": "If you want one infrared heater for a living room or bedroom and would rather not think about it again, the DR-978 is the one we would start with. It is a cabinet heater with what Dr. Infrared calls a hybrid dual heating system: an infrared quartz element and a PTC ceramic element working together, with a larger blower that the listing says moves more air at very low noise. That matters because a cabinet heater spreads its warmth by fan as well as by glow, so it heats a room more evenly than a bare quartz tower. The listing gives a heat rating of 5,200 BTU per hour, which is what any 1,500-watt heater produces, so do not read it as extra power. What sets the DR-978 apart is its safety and control package. The listing states it is UL and cUL certified, has tip-over and overheat shut-off, and has no exposed heating elements, which makes it a sensible choice around children and pets. The thermostat cycles it to hold a set temperature between 50 and 86 degrees, there are Eco, high (1,500 W) and low (1,200 W) settings, and a 12-hour timer. The trade-offs are size and sound: it is a boxy cabinet, and the blower is audible. If you only need warmth at a desk, the BLACK+DECKER tower costs far less."
  },
  {
    "id": "comfort-zone-cz2062c",
    "name": "Comfort Zone CZ2062C 1,500W Infrared Quartz Cabinet Heater with Remote",
    "category": "Infrared Quartz Cabinet, 1,500/750 W, ECO Mode, 12-Hr Timer, USB Ports",
    "badge": "Best Value Cabinet",
    "amazonUrl": "#",
    "pros": [
      "Tip-over switch and overheat shut-off, per the listing",
      "Three settings: 1,500 W, 750 W and an ECO mode that holds 68 degrees",
      "Thermostat adjustable from 59 to 86 degrees",
      "Timer up to 12 hours, with remote control",
      "Two USB charging ports rated up to 2.1 amps"
    ],
    "cons": [
      "The listing does not name a UL or ETL mark: check the label",
      "After an overheat shut-off it needs a 20-minute cool-down to reset",
      "USB ports are a nice extra, not a reason to buy a heater"
    ],
    "bottomLine": "A well-equipped infrared cabinet heater for less: tip-over and overheat protection, an ECO mode, a timer and a remote.",
    "description": "The Comfort Zone CZ2062C is the cabinet heater to buy if you want the features of a premium infrared model without paying premium money. It is a 20-inch, 1,500-watt infrared quartz cabinet, so like the Dr. Infrared it pushes warm air out with a fan and keeps its elements enclosed. The listing describes three heat settings: high at 1,500 watts, low at 750 watts and an ECO mode that automatically regulates the room to 68 degrees. That ECO mode is the most useful feature here, because it stops the heater from running flat out once the room is comfortable, which is where real savings on any space heater come from. The adjustable thermostat covers 59 to 86 degrees, and a timer, settable in one-hour steps up to 12 hours, can switch it off after you fall asleep. Both are available from the remote as well as the panel. On safety, the listing names a tip-over switch that cuts power if the heater is knocked over and an overheat shut-off. It also explains the reset: turn it off, unplug it and let it cool for 20 minutes. The listing does not mention a UL or ETL certification, so look for the mark on the heater's label. Two USB ports can charge a phone. If certification on the listing matters most, buy the Dr. Infrared DR-978."
  },
  {
    "id": "lifesmart-4-element-quartz",
    "name": "LifeSmart 1,500W 4-Element Infrared Quartz Bulb Room Heater",
    "category": "Infrared Quartz Bulb Cabinet, 1,500 W, 3 Settings, Remote, 10.87 lb",
    "badge": "Best Compact Cabinet",
    "amazonUrl": "#",
    "pros": [
      "Four infrared quartz elements in a compact cabinet",
      "Child lock and tip-over shut-off, per the listing",
      "Remote, digital thermostat and a timer that can switch it on up to 12 hours ahead",
      "Built-in carry handles and 10.87 lb weight for moving room to room",
      "Washable filter and no assembly required"
    ],
    "cons": [
      "The listing does not mention overheat protection or a UL/ETL mark: check the manual and label",
      "The \"does not dry out the air\" claim applies to every electric heater",
      "Small footprint means a small fan: slower to spread heat in a big room"
    ],
    "bottomLine": "A small, easy-to-carry infrared cabinet heater with a child lock and a pre-heat timer, best for bedrooms and offices.",
    "description": "The LifeSmart four-element heater suits anyone who wants the enclosed, fan-assisted warmth of a cabinet heater in a smaller box that is easy to carry between rooms. The listing gives its dimensions as about 11.6 by 9.7 by 12.1 inches and its weight as 10.87 pounds, with built-in carry handles, so it can live in the bedroom at night and the home office during the day. It is a 1,500-watt heater with four infrared quartz elements, and there are three heat settings including an Eco mode for smaller rooms. The feature we like most is the timer: LifeSmart says you can set it to switch the heater on up to 12 hours ahead, so the room is already warm when you get up or come home. The remote runs the digital thermostat and timers. For homes with children, the listing names a child lock and a tip-over shut-off. It does not mention an overheat shut-off or a safety certification mark, so confirm both on the manual and the label before you rely on it. The listing also says the heater does not dry out the air; that is true of electric heaters generally, not a special feature. It includes a washable filter. If you want listed overheat protection and certification, buy the Dr. Infrared DR-978 or the BLACK+DECKER BHTI06 instead."
  },
  {
    "id": "dr-infrared-dr-998",
    "name": "Dr. Infrared Heater DR-998 1,500W Dual Heating Infrared Heater with Humidifier",
    "category": "Quartz Tube + PTC, Cool-Mist Humidifier, Oscillation, 1,500 W",
    "badge": "Best with Humidifier",
    "amazonUrl": "#",
    "pros": [
      "Built-in cool-mist ultrasonic humidifier for dry winter air",
      "Oscillation spreads warm air around the room",
      "Tip-over and overheat protection, with no exposed heating elements",
      "Remote, digital thermostat (50 to 85 degrees) and 1-12 hour timer",
      "Wheels and a washable filter"
    ],
    "cons": [
      "The \"60% more warmth\" claim cannot mean more heat: it is still a 1,500 W heater",
      "A humidifier tank needs regular emptying and cleaning",
      "Costs more than a heater-only cabinet"
    ],
    "bottomLine": "An infrared cabinet heater with a built-in humidifier, for bedrooms where winter air feels dry; ignore the 60 percent claim.",
    "description": "Heated winter air feels dry because warm air can hold more moisture, so its relative humidity drops, and that happens with every type of heater. The Dr. Infrared DR-998 tackles it by combining a 1,500-watt heater with a cool-mist ultrasonic humidifier in one cabinet, which saves a second appliance and a second outlet in a bedroom. Its heater pairs an infrared quartz tube with a PTC element, and oscillation sweeps the warm air across the room. The listing names tip-over and overheat protection and no exposed heating elements, plus a remote, a digital thermostat from 50 to 85 degrees, a 1 to 12 hour timer, a washable filter and wheels. Now the honest caveat. The listing says the DR-998 delivers 60 percent more warmth than standard 1,500-watt heaters. It cannot produce more heat than its 1,500 watts allow; no heater can. What it can do is make you feel warmer sooner, because the quartz tube warms you directly and the oscillation moves air around. Judge it as a well-equipped heater and humidifier combination, not as a more powerful heater. A humidifier also adds upkeep: empty and clean the tank regularly as the manual directs. If your air is not dry, the DR-978 does the heating job for less."
  },
  {
    "id": "heat-storm-phoenix-hs-1500-phx",
    "name": "Heat Storm Phoenix HS-1500-PHX Infrared Space Heater, Wall or Floor",
    "category": "Wall or Floor Infrared, 750/1,500 W, LED Thermostat, Remote",
    "badge": "Best Wall-Mounted",
    "amazonUrl": "#",
    "pros": [
      "Mounts on the wall or stands on removable feet",
      "Two power modes: 1,500 W and 750 W",
      "Built-in thermostat with an LED display of the room temperature",
      "Remote control included",
      "The listing says the case and grill are safe to touch"
    ],
    "cons": [
      "The listing does not mention tip-over shut-off or a UL/ETL mark: check before floor use",
      "One-year warranty is short for a heater",
      "Wall mounting still needs an outlet within cord reach"
    ],
    "bottomLine": "An infrared heater that hangs on the wall to keep the floor clear, best for small rooms and offices.",
    "description": "Floor space is the problem the Heat Storm Phoenix solves. It can hang on the wall from mounting points on the back or stand on removable feet, so it suits a small office, a dressing area or a room where a floor heater would sit in a walkway or within reach of a toddler. Heat Storm describes it as a portable 1,500-watt infrared heater sized for a small room or office, with a 5,200 BTU output at full power and a second 750-watt mode for milder days. A built-in thermostat with an LED display shows the room temperature and regulates the heater, and a remote lets you adjust it from across the room. The listing says a patented heat exchanger gives soft heat and that the unit is safe to touch, even the grill. It also says the heater does not reduce oxygen or humidity. That is true, but it is true of every electric heater, since none of them burns fuel or removes water from the air. The listing does not mention tip-over shut-off or a safety certification mark, which matters most if you use it on its feet on the floor, so check the manual and the label. The warranty is one year. If you want a heater that stays on the floor, the Comfort Zone CZ2062C lists more safety features."
  },
  {
    "id": "black-decker-bhti06",
    "name": "BLACK+DECKER BHTI06 Infrared Radiant Quartz Tower Heater, 1500W",
    "category": "Quartz Tube Tower, 750/1,500 W, Thermostat, 5 lb",
    "badge": "Best Budget Personal Heater",
    "amazonUrl": "#",
    "pros": [
      "Dual quartz tubes give fast, direct radiant warmth",
      "Tip-over auto shut-off and overheat protection, per the listing",
      "Cool-touch housing and a power indicator light",
      "Two settings, 750 W and 1,500 W, with an adjustable thermostat",
      "Weighs about 5 lb, easy to move from room to room"
    ],
    "cons": [
      "Manual controls only: no remote or timer",
      "Warms what it faces, not a whole room",
      "The listing does not name a UL or ETL mark: check the label"
    ],
    "bottomLine": "The cheapest way to put fast infrared warmth at a desk or chair, with tip-over and overheat shut-off.",
    "description": "Most people searching for an infrared heater want to feel warm where they sit, and for that job the BLACK+DECKER BHTI06 does what a cabinet heater costing far more does, for much less. It is a slim tower with two quartz tubes and an integrated fan, so it delivers the quick, direct radiant warmth infrared is good at, with a little airflow to spread it. Set it a few feet from your desk or reading chair and you feel it as soon as the tubes glow. The listing gives two settings, low at 750 watts and high at 1,500 watts, and an adjustable thermostat with manual controls. Safety is better than many budget towers: BLACK+DECKER lists cool-touch housing, a power indicator light, overheat shut-off and tip-over auto shut-off. At about 5 pounds, it is easy to carry from the home office to the bedroom. The trade-offs come with the price. There is no remote and no timer, so you have to remember to switch it off, and as a radiant tower it warms what is in front of it and leaves the rest of the room cool. The listing does not mention a UL or ETL certification, so check the label. If you want even heat across a whole bedroom, buy a cabinet heater such as the Comfort Zone CZ2062C."
  },
  {
    "id": "duraflame-3d-infrared-stove",
    "name": "Duraflame Electric Infrared Quartz Fireplace Stove with 3D Flame Effect",
    "category": "Infrared Quartz Fireplace Stove, 5,200 BTU, 3D Flame, Thermostat",
    "badge": "Best for a Fireplace Look",
    "amazonUrl": "#",
    "pros": [
      "3D flame effect with five brightness settings",
      "Flame can run with or without heat, all year round",
      "Adjustable thermostat",
      "Metal body with side windows and an opening beveled glass door",
      "Easy assembly: attach the legs and plug in"
    ],
    "cons": [
      "The \"up to 1,000 sq ft\" claim is supplemental heat, not whole-room heating",
      "You pay a lot extra for looks over a plain 1,500 W heater",
      "The listing does not name tip-over shut-off or a certification mark"
    ],
    "bottomLine": "A 1,500-watt-class infrared quartz heater inside a stove with a convincing flame, for rooms where looks matter as much as heat.",
    "description": "Sometimes the room you want to heat is the living room, and you want it to feel cosy as well as warm. The Duraflame infrared quartz fireplace stove is the pick for that. Inside is the same class of infrared quartz heater as the other picks, rated at 5,200 BTU, which is what a 1,500-watt heater produces, so it heats like the others. What you are paying extra for is the stove. Duraflame describes a 3D flame effect with flames that move on and behind the logs, a glowing ember bed, and five brightness settings, and the flame runs with or without the heat, so it can set the mood in summer too. The metal body has side windows and an opening beveled glass door, and assembly is just attaching the legs. An adjustable thermostat controls the heat. The listing says it gives supplemental zone heating for up to 1,000 square feet. Read that as help alongside your furnace; one 1,500-watt heater will not heat a cold 1,000-square-foot space alone. It also says the stove is safe for use around children and pets, but it does not name a tip-over shut-off or a UL or ETL mark, so check the manual and the label, and keep three feet clear in front. If you only want heat, a Comfort Zone CZ2062C does the same job for far less."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Infrared Heaters",
          item: "https://www.thehonestreviewers.com/best-infrared-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best infrared heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the Dr. Infrared DR-978 is the best infrared heater: a UL and cUL certified cabinet heater with tip-over and overheat shut-off, enclosed elements, a thermostat from 50 to 86 degrees and a 12-hour timer. The Comfort Zone CZ2062C is the best value cabinet, and the BLACK+DECKER BHTI06 is the cheapest way to warm a desk or one chair."
          }
        },
        {
          "@type": "Question",
          "name": "Are infrared heaters more energy efficient than other space heaters?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every plug-in electric heater turns close to all its electricity into heat, so a 1,500-watt infrared heater makes the same heat as a 1,500-watt ceramic or oil-filled heater. Infrared feels warmer sooner because it heats you and nearby objects directly. It saves money only if that lets you turn the central heating down and warm just one room."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run an infrared heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 1,500-watt infrared heater on high uses 1.5 kilowatt-hours per hour. At 17 cents per kilowatt-hour that is about 26 cents an hour, or about $2 for eight hours at full power. The low setting halves that, and a thermostat cuts it further by switching the heater off when the room is warm. Check your bill for your own rate."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to leave an infrared heater on overnight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is safer not to. Even with tip-over and overheat shut-off, a heater running unattended near bedding is a fire risk. If you use one in a bedroom, keep three feet clear, plug it into a wall outlet and set the timer to switch it off after you fall asleep. An electric blanket is a safer way to stay warm through the night."
          }
        },
        {
          "@type": "Question",
          "name": "What size infrared heater do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nearly all plug-in infrared heaters are 1,500 watts, the most a standard outlet supplies. As a rule of thumb, allow about 10 watts per square foot when the heater is the only heat source, so one heater fully heats about 150 square feet. In larger rooms it works as supplemental heat for the area where you sit, alongside your central heating."
          }
        },
        {
          "@type": "Question",
          "name": "Do infrared heaters dry out the air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Infrared heaters do not remove moisture from the air, but neither does any other electric heater. Air feels drier in winter because warming it lowers its relative humidity, and that happens whatever heats the room. If dry air bothers you, run a humidifier, or choose a heater with a built-in one such as the Dr. Infrared DR-998."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an infrared heater in a garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A plug-in 1,500-watt infrared heater can keep you warm at a workbench if you aim it at where you stand, but it cannot heat a whole garage in winter. For that you need a hardwired 240-volt electric heater or a properly vented gas unit. Keep it away from fuel, solvents and sawdust, and plug it directly into a wall outlet."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home & Garage",
    tags: [
      "best infrared heater",
      "infrared heater",
      "best infrared space heater",
      "infrared quartz heater",
      "are infrared heaters more efficient",
      "best infrared heater for large room",
      "infrared heater safety"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best Infrared Heaters for a Cold Room
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Infrared heaters are sold as more efficient. They are not: every 1,500-watt plug-in heater turns the same electricity into the same heat. Infrared feels faster because it warms you and the things in front of it first. Here is which ones to buy.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dr-infrared-dr-978"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="2.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#efficiency" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Are Infrared Heaters More Efficient?</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Quartz Tower, Cabinet or Wall Panel</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Infrared Heaters</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Are Infrared Heaters Safe?</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. What Size You Need</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. What It Costs to Run</a>
          <a href="#vs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Infrared vs Oil-Filled vs Ceramic</a>
          <a href="#where" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Where Infrared Works Best</a>
