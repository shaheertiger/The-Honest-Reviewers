  {
    "title": "Best Mattresses for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattresses for Heavy People",
    "url": "/best-mattress-for-heavy-people/"
  },
  {
    "title": "Best Mattress Toppers",
    "url": "/best-mattress-topper/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "6 Best Mattresses for Seniors in 2026: Edge Support and Height";
const description =
  "The best mattresses for seniors and older adults, compared on bed height, edge support, firmness for joint comfort, adjustable-base compatibility, temperature and motion isolation.";

const PRODUCTS = [
  {
    "id": "dreamcloud-premier",
    "name": "DreamCloud Premier 13\" Hybrid Mattress",
    "category": "13-inch Euro-Top Hybrid, Medium-Firm",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Medium-firm with a cushioned euro top, a balance many older sleepers prefer",
      "Reinforced edge from a higher-density foam frame, per the maker",
      "8-inch individually wrapped coils make it easier to change position than all-foam",
      "13 inches tall, which raises the sleeping surface on a standard frame",
      "365-night trial and Forever Warranty"
    ],
    "cons": [
      "Memory foam layer can feel warm to some sleepers",
      "Some reviewers have questioned its long-term durability",
      "Heavy to unbox and position without help"
