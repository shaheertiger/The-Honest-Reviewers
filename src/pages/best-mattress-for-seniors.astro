  },
  {
    "id": "brooklyn-signature-hybrid",
    "name": "Brooklyn Bedding Signature Hybrid Mattress",
    "category": "13.25-inch Hybrid, Soft, Medium or Firm",
    "badge": "Best Firmness Choice",
    "amazonUrl": "#",
    "pros": [
      "Available in soft, medium and firm, so you buy the feel you need",
      "8-inch coil core with up to 760 encased coils, per the maker",
      "GlacioTex cooling cover and copper-infused foam for heat",
