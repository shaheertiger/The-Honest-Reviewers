const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Welders for Beginners: MIG, Flux-Core and Multi-Process Picks";
const description =
  "The best welders for beginners, from 120V flux-core starters to dual-voltage MIG machines, compared on duty cycle, thickness range and what each one plugs into.";

const PRODUCTS = [
  {
    "id": "hobart-handler-140",
    "name": "Hobart Handler 140 MIG Welder",
    "badge": "Best Overall",
    "category": "120V MIG / Flux-Core",
    "amazonUrl": "#",
    "description": "The Hobart Handler 140 is the welder we would hand most beginners because it does the job almost everyone starts with, on the outlet almost everyone has. Retailer and catalog listings give a rated output of 90 amps at 18.5 volts and a 20 percent duty cycle, with a welding range of roughly 25 to 140 amps. A Hobart catalog summary says it welds 24 gauge up to 1/4-inch mild steel in a single pass, and it runs on 115-volt single-phase power, per the Airgas listing. It takes both flux-cored wire for outdoor work and solid wire with shielding gas for cleaner indoor welds, so you can start without a bottle and add one later. The five-position voltage selector is a deliberate limitation that helps a beginner: fewer settings means fewer ways to get lost. Be aware that Hobart also sells a Handler 140EZ under a different model number, and its spec sheet lists a 30 percent duty cycle and a 3/16-inch top thickness, so check the model number on the box before you compare numbers.",
    "pros": [
      "Runs on standard 115V household power, per Airgas",
      "24 gauge to 1/4-inch mild steel in one pass, per Hobart's catalog",
      "MIG with gas or flux-core without gas",
      "Simple five-position voltage control",
      "Long-established model with wide parts availability"
    ],
    "cons": [
      "20 percent duty cycle at 90 amps limits long welds",
      "Handler 140EZ is a different model with different specs",
      "Aluminum needs an optional spool gun"
    ],
    "bottomLine": "For a first welder on a 115V circuit, the Hobart Handler 140 covers sheet metal to 1/4-inch steel with gas or flux-core, and it is simple enough to learn on."
  },
  {
    "id": "millermatic-142",
    "name": "Miller Millermatic 142 MIG Welder",
    "badge": "Best Premium 120V",
    "category": "120V MIG with Auto-Set",
    "amazonUrl": "#",
    "description": "The Millermatic 142 is the 120-volt machine to buy if you want the setup done for you and the duty cycle to keep up with longer welds. Miller lists an amperage range of 30 to 140 amps and a rated output of 100 amps at 19 volts at a 60 percent duty cycle, or 80 amps at a 100 percent duty cycle, which is three times the duty cycle of most 120-volt starters at a higher current. Miller rates it for 24 gauge to 3/16-inch mild steel and 18 to 14 gauge aluminum with a spool gun. Its Auto-Set mode chooses voltage and wire speed from the material thickness and wire you select, which removes the trial-and-error that frustrates new welders. Miller says it gives full output on generators of 5,000 watts or more. It weighs about 33 pounds per Miller's listing. The trade-off is price: you pay a premium over the Hobart for the duty cycle and the Auto-Set convenience, and its 3/16-inch top end is lower than some cheaper machines claim.",
    "pros": [
      "60 percent duty cycle at 100 amps, per Miller",
