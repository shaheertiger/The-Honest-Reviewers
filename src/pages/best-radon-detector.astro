---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Air Purifiers for Home",
    "url": "/best-air-purifier-for-home/"
  },
  {
    "title": "Best Air Purifiers for Mold",
    "url": "/best-air-purifier-for-mold/"
  },
  {
    "title": "Best Hygrometers",
    "url": "/best-hygrometer/"
  },
  {
    "title": "Drylok vs RadonSeal",
    "url": "/drylok-vs-radonseal/"
  },
  {
    "title": "Basement Moisture Control",
    "url": "/basement-moisture-control/"
  },
  {
    "title": "Best Dehumidifiers for Basements",
    "url": "/best-dehumidifier-for-basement/"
  },
  { title: "How Long Does a Radon Test Take?", url: "/how-long-does-a-radon-test-take/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Radon Detectors for Knowing What Your Basement Is Really Breathing";
const description =
  "Seven radon detectors and test kits compared, plus the EPA 4 pCi/L action level, where to place a monitor, and when a reading means it is time to mitigate.";

const PRODUCTS = [
  {
    "id": "airthings-corentium-home-2",
    "name": "Airthings Corentium Home 2 Radon Detector",
    "category": "Battery Digital Monitor, LCD + Bluetooth",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 900,
    "pros": [
      "LCD shows 24-hour, 7-day, 30-day and long-term averages without opening an app",
      "Runs on two AA batteries for up to about three years, so it can sit anywhere in the house",
      "Adds Bluetooth history, temperature and humidity to the proven original Corentium sensor",
      "Small enough to move from basement to bedroom to test different levels",
      "No subscription, no Wi-Fi setup and no account required to read the result"
    ],
    "cons": [
      "First reading takes 24 hours, and the 7-day figure is the first one worth acting on",
      "No audible alarm, so a high number only gets noticed if someone looks"
    ],
    "bottomLine": "The easiest detector to live with: put it in the basement, glance at the long-term average every few weeks, and you always know where you stand.",
    "description": "The original Corentium Home earned its reputation by doing one thing well. It showed a radon average on a plain screen and ran for years on AA batteries, and home inspectors and radon forums have recommended it for a decade for exactly that reason. The Corentium Home 2 keeps the same radon sensor and adds the things owners kept asking for: Bluetooth sync with the Airthings app so you can see a history instead of a single figure, plus temperature and humidity readings that help explain why the number moves. The screen cycles through 24-hour, 7-day, 30-day and long-term averages, and that last figure is the one the EPA action level is written around. Because it is battery powered, you can put it exactly where the testing guidance says to put it, on the lowest lived-in level and away from outlets, drafts and exterior walls, instead of wherever there is a free socket. The trade-off is patience. It needs a day before it shows anything, and the 24-hour number bounces around enough that you should not react to it. Give it a week for a first read and three months for a number you can make a mitigation decision on. For most households that is the right way to measure radon anyway, which is why this is our first pick."
  },
  {
    "id": "ecosense-radoneye-rd200",
    "name": "Ecosense RadonEye RD200 Radon Detector",
    "category": "Plug-In Ion Chamber Monitor, OLED + Bluetooth",
    "badge": "Fastest Readings",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 4200,
    "pros": [
      "First reading in about 10 minutes and a usable hourly figure within the first hour",
      "Rated sensitivity of 30 counts per hour per pCi/L, far above the typical consumer minimum",
      "Stores a year of hourly data that exports from the Bluetooth app as a text file",
      "Configurable audible alarm when the reading crosses a level you choose",
      "OLED screen shows the current value without a phone"
    ],
    "cons": [
      "Needs a wall outlet, which limits placement in some basements",
      "Hourly swings are real and can alarm owners who do not wait for the average"
    ],
    "bottomLine": "The detector to buy if you want to see radon move in real time, especially while you are testing whether a mitigation fan is working.",
    "description": "Most consumer radon monitors sample slowly and smooth their output heavily, so you wait a day for anything to appear. The RadonEye RD200 uses a pulsed ion chamber with a rated sensitivity of 30 counts per hour per pCi/L, which is why it can post a first reading in roughly ten minutes and a reasonably settled figure within the hour. That speed is genuinely useful in two situations. The first is diagnosis: you can watch radon climb overnight when the house is closed up, fall when a window opens, and spike when the furnace or a bathroom fan depressurises the basement. The second is verification. After a sub-slab system is installed, the RD200 shows the drop within hours rather than leaving you to wait a week. The unit keeps a year of hourly data on board and exports it as a text file, which is handy if you want to hand real numbers to a contractor. Ecosense quotes precision of about 10 percent at 10 pCi/L, and in a side-by-side on the same shelf it tracked our other monitors closely once all of them had a few days of data. The downsides are practical rather than performance related. It is a plug-in device, so it sits wherever an outlet allows, and its hourly readings can look alarming to someone who does not yet understand that radon naturally swings."
  },
  {
    "id": "airthings-wave-radon",
    "name": "Airthings Wave Radon Smart Radon Detector",
    "category": "Battery Smart Monitor, Bluetooth App",
    "badge": "Best Smart Monitor",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 2600,
    "pros": [
      "Wave a hand in front of it for a green, yellow or red status ring",
      "Tracks radon, temperature and humidity with 24-hour and long-term averages in the app",
      "Battery life of roughly 18 months on Bluetooth, longer when paired with an Airthings hub",
      "Ceiling or wall mounting keeps it out of reach of kids and pets",
      "Works with the wider Airthings ecosystem if you add more sensors later"
    ],
    "cons": [
      "No numeric display, so you need the app to see the actual pCi/L figure",
      "Bluetooth only on its own; remote alerts require a hub or View-series device"
    ],
    "bottomLine": "A tidy, mount-and-forget monitor for people who already live in a phone app and want radon to sit alongside their other smart-home data.",
    "description": "The Wave Radon is the Airthings detector for people who would rather not look at a screen at all. It mounts on a wall or ceiling like a smoke alarm, and when you wave a hand in front of it a light ring glows green, yellow or red to tell you whether radon is fine, worth watching or above the threshold you set. Everything else lives in the Airthings app: 24-hour and long-term radon averages, humidity, temperature and a graph of how they move together. That graph is more useful than it sounds. In a basement, radon and humidity often rise at the same times, both driven by a closed-up house and soil gas pressure, and seeing them together makes it easier to decide whether ventilation changes are worth trying. Battery life runs to about a year and a half on Bluetooth, and longer when a hub handles the syncing. The limitation is that Bluetooth alone means you only get fresh data when your phone is nearby, and there is no numeric readout on the device itself, so a visitor or another household member cannot glance at it and see a number. If you want the smart features, this is the cleanest way to get them. If you want a figure on a screen, the Corentium Home 2 is the better buy."
  },
  {
    "id": "ecosense-ecoqube",
    "name": "Ecosense EcoQube Radon Detector",
    "category": "Plug-In Wi-Fi Monitor with Alarm",
    "badge": "Best Wi-Fi Alerts",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1500,
    "pros": [
      "Wi-Fi connection sends readings and alerts to your phone from anywhere",
      "Same 30 cph/pCi/L sensitivity class as the RadonEye, with a first result in about 10 minutes",
      "Audible alarm and a three-color front LED configurable to your own threshold",
      "Updates every 10 minutes with a 60-minute moving average",
      "Small and light enough to tuck on a shelf near an outlet"
    ],
    "cons": [
      "No numeric screen on the unit, so the value lives in the app",
      "Depends on your Wi-Fi reaching the basement, which it often does not"
    ],
    "bottomLine": "The best choice for a rental, a cabin or an elderly parent's house, where you need to know about a radon problem without being there to see it.",
    "description": "The EcoQube takes the fast ion-chamber approach Ecosense built its name on and puts it on Wi-Fi, which changes who it suits. Instead of walking down to the basement or waiting to be within Bluetooth range, you get readings and threshold alerts on your phone wherever you are. That makes it the detector we would put in a property we do not live in: a rental unit, a vacation house that sits closed for weeks, or a parent's home where you want an early warning without asking them to read a screen. Ecosense rates it at 30 counts per hour per pCi/L with precision under 10 percent at 10 pCi/L once it has run for about ten hours, and it produces a first figure within roughly ten minutes. The device itself signals status with a three-color LED and an audible alarm, both configurable to the level you care about, which is a sensible choice for people who will never open the app. What it lacks is a numeric readout on the unit, and the Wi-Fi requirement is the catch that surprises buyers most often. Basements under concrete and steel can be dead zones for a router two floors up, so check the signal where you plan to place it before relying on remote alerts."
  },
  {
    "id": "airthings-view-plus",
    "name": "Airthings View Plus Air Quality Monitor",
    "category": "7-Sensor Radon, PM2.5 and CO2 Monitor",
    "badge": "Best Whole-Air Monitor",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1100,
    "pros": [
      "Measures radon, PM1, PM2.5, CO2, VOCs, humidity, temperature and pressure in one unit",
      "E-ink display shows up to four readings you choose, readable across a room",
      "Runs on six AA batteries for up to about two years or on USB-C power",
      "On USB power it doubles as a Wi-Fi hub for other Airthings sensors",
      "Wi-Fi connection means remote alerts and history without a separate hub"
    ],
    "cons": [
      "Premium price, and most of it pays for sensors a basement radon check does not need",
      "Radon is shown as a 24-hour average on screen, so long-term trends live in the app"
    ],
    "bottomLine": "Worth it if you want one device that covers radon, smoke-season particulates and stuffy-room CO2; overkill if radon is the only question.",
    "description": "The View Plus is less a radon detector than a whole-house air quality station that happens to include one of the better consumer radon sensors. It measures seven things at once, including radon, fine particulates, carbon dioxide, volatile organic compounds, humidity, temperature and air pressure, and its e-ink screen shows up to four of them at a time without the glare or power draw of a backlit display. For a main living area that combination is genuinely informative. CO2 tells you when a room needs fresh air, PM2.5 tells you when cooking or wildfire smoke calls for a purifier, and radon sits in the corner as the slow, invisible risk. It runs for up to about two years on six AA batteries or can be powered over USB-C, and when it is plugged in it acts as the Wi-Fi hub for any other Airthings sensors in the house, which solves the Bluetooth-only limitation of the Wave Radon. The trade-off is cost and focus. You are paying a premium for the particulate and CO2 sensors, and on the device itself radon appears as a 24-hour figure, with the long-term average living in the app. If radon is your only concern, a Corentium Home 2 in the basement does the job for a fraction of the money. If you want to understand the air in the whole house, this is the one to get."
  },
  {
    "id": "safety-siren-pro4-radon",
    "name": "Safety Siren Pro4 Series Radon Gas Detector",
    "category": "Plug-In Ion Chamber Monitor with Display",
    "badge": "Best No-App Plug-In",
    "amazonUrl": "#",
    "rating": 4.1,
    "reviewCount": 1300,
    "pros": [
      "Backlit display shows short-term and long-term radon averages with no app at all",
      "Continuous ion chamber sensor with an automatic self-test every 24 hours",
      "Audible alarm modes for owners who want a warning they cannot miss",
      "Long-running design from a company that has made home radon monitors for decades",
      "Nothing to pair, sync or update; plug it in and read it"
    ],
    "cons": [
      "Plug-in only, so placement is dictated by outlet locations",
      "No data export or history graph, only the averages on the screen"
    ],
    "bottomLine": "A straightforward wall-socket monitor for households that want a number on a screen and an alarm, and nothing to do with apps.",
    "description": "The Safety Siren line has been sold as a home radon monitor for far longer than smart air quality gadgets have existed, and the Pro4 Series keeps the formula simple. It plugs into a wall socket, runs a continuous ion chamber sensor, and shows radon on a backlit display that alternates between a short-term average and a long-term average running since it was last reset. It runs an automatic self-test every 24 hours and includes audible alarm modes, so a household that never checks the screen still gets a warning. That design has real advantages for some buyers. There is no app to install, no account to create, no Bluetooth to pair and no firmware that might stop being supported. Grandparents, tenants and people who simply distrust connected devices can read it at a glance. The limitations are the mirror image. You get averages rather than a graph, so you cannot see the daily pattern that helps diagnose where radon is entering, and there is no way to export the data for a contractor. Being a plug-in unit, it also ends up wherever an outlet happens to be, which in a basement is not always the recommended spot away from exterior walls. As a no-nonsense monitor it does the job; if you want to understand your radon rather than just watch it, the RadonEye gives you more."
  },
  {
    "id": "first-alert-rd1-radon-test-kit",
    "name": "First Alert RD1 Radon Gas Test Kit",
    "category": "Short-Term Charcoal Kit, Lab Analysis Included",
    "badge": "Best Budget Test",
    "amazonUrl": "#",
    "rating": 4,
    "reviewCount": 5200,
    "pros": [
      "Budget price with the lab fee included in most states",
      "Short-term test runs just 2 to 3 days in the home",
      "Results arrive by email a few business days after the lab receives the sample",
      "A lab-analysed result is a useful cross-check against an electronic monitor",
      "Nothing to plug in, charge or configure"
    ],
    "cons": [
      "One snapshot of a number that changes daily, so it cannot confirm a long-term average",
      "Shipping delays can spoil the sample, and New Jersey residents pay a separate lab fee"
    ],
    "bottomLine": "The cheapest honest first step: if it comes back well under 2 pCi/L you have your answer, and if it comes back high you know to buy a monitor.",
    "description": "A charcoal test kit is the oldest and cheapest way to measure radon, and the First Alert RD1 is the one most people find on the hardware store shelf. You open the canister, set it on the lowest lived-in level for two to three days with the house closed up, reseal it and mail it to the lab. The lab fee is included except for New Jersey tests, and results arrive by email a few business days after the sample is received. That makes it a very inexpensive way to get a first answer. What you need to understand is what kind of answer it is. Activated charcoal absorbs radon over the exposure period and the lab counts what it caught, so the result is an average of those two or three days only. Radon can easily be twice as high in a cold snap as during a mild, breezy week, which means one charcoal result tells you roughly where you are rather than where your annual average sits. The kit also has a clock on it: charcoal keeps absorbing and radon keeps decaying after the test, so mail it the same day you close it. We use kits like this as a cross-check against electronic monitors and as a screening test in houses where nobody has ever measured. A low result is reassuring; a result near or above 4 pCi/L is a reason to buy a monitor and measure properly."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Radon Detectors",
          item: "https://www.thehonestreviewers.com/best-radon-detector/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is a safe radon level in a home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No level of radon is considered completely safe, because risk rises with exposure. The EPA action level is 4 pCi/L, and it recommends considering mitigation between 2 and 4 pCi/L. The average US indoor level is about 1.3 pCi/L and outdoor air is around 0.4 pCi/L, so a long-term average under 2 is a reasonable target."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a radon detector run before I trust it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A continuous monitor gives a usable first read after about a week, but decisions should rest on a long-term average of at least 90 days. Radon changes with weather and season, and the heating months usually read highest. Letting a monitor run through a full winter gives you the most honest picture of your annual exposure."
          }
        },
        {
          "@type": "Question",
          "name": "Are home radon detectors accurate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reputable consumer monitors are accurate enough to tell a house that needs mitigation from one that does not. They are factory calibrated and most quote precision around 10 percent at 10 pCi/L. Cross-check yours with a lab-analysed kit every year or two. They are not accepted for real estate transactions, which require a certified measurement professional."
          }
        },
        {
          "@type": "Question",
          "name": "Where is the best place to put a radon detector?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On the lowest level that is lived in or could be, usually the basement. Keep it at least 20 inches off the floor, about a foot from exterior walls and three feet from doors, windows and vents. Avoid kitchens, bathrooms, laundry rooms, sump pits and spots near furnaces, water heaters or direct sun."
          }
        },
        {
          "@type": "Question",
          "name": "Is a radon test kit or a digital monitor better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A kit is cheaper for a single first screening and is lab analysed. A digital monitor is better for making decisions, because it builds a long-term average, shows trends and confirms whether mitigation works. If a kit comes back above 2 pCi/L, or you plan to stay in the house for years, a monitor is the better investment."
          }
        },
        {
          "@type": "Question",
          "name": "Can opening windows lower radon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, temporarily. Ventilation dilutes radon and reduces the pressure difference that pulls soil gas indoors, and a fast monitor will show the drop within hours. It is not a practical long-term fix in cold or hot weather, though, and levels rebound as soon as the house is closed. Sub-slab depressurization is the permanent solution."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a radon detector if my house has a mitigation system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a good idea. Fans fail, pipes crack and slabs settle, and none of that is obvious without a measurement. Most systems include a manometer that shows whether the fan is creating suction, but a running monitor confirms the result that actually matters: that the long-term average stays well below 4 pCi/L."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home & Indoor Air Quality",
    tags: [
      "best radon detector",
      "radon monitor",
      "radon test kit",
      "home radon testing",
      "radon mitigation",
      "basement air quality"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Detectors Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Radon Detectors</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Radon has no smell, no color and no symptoms until it is far too late. A detector that runs for months tells you the one number that matters: your long-term average.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#airthings-corentium-home-2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Choose
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#radon-basics" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What the Numbers Mean</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#monitors-vs-kits" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Monitors vs Test Kits</a>
          <a href="#averaging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Short vs Long-Term Averages</a>
          <a href="#placement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Where to Place a Detector</a>
          <a href="#calibration" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Accuracy and Calibration</a>
          <a href="#acting-on-results" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Acting on Your Results</a>
          <a href="#mitigation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. What Mitigation Involves</a>
          <a href="#whole-basement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Radon and the Rest of the Basement</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

