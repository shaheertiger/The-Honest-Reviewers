const title = "How to Stain a Concrete Patio to Look Like Stone (2026 Guide)";
const description = "The complete professional guide to transforming a plain concrete patio into a stunning faux stone surface using acid stains and scoring techniques. Step-by-step instructions, product recommendations, and cost breakdown.";

const schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    author: {
        "@type": "Person",
        name: "Alex Rivers",
    },
    datePublished: "2026-03-10",
    publisher: {
        "@type": "Organization",
        name: "The Honest Reviewers",
    },
};
---

<Layout
    title={`${title} | The Honest Reviewers`}
    description={description}
    ogType="article"
    jsonLd={schema}
    stickyCta={{
        text: "Jump to Step-by-Step Guide",
        link: "#step-by-step",
