---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Countertop Water Filters",
    "url": "/best-countertop-water-filter/"
  },
  {
    "title": "Best Water Filter Pitchers",
    "url": "/best-water-filter-pitcher/"
  },
  {
    "title": "Best Headlamps",
    "url": "/best-headlamp/"
  },
  {
    "title": "Best Emergency Radios",
    "url": "/best-emergency-radio/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "5 Best Portable Water Filters: Filter vs Purifier, Flow Rate and Emergency Use";
const description =
  "The best portable water filters for outages, boil notices and camping, with the filter vs purifier difference explained and flow, capacity and care compared.";

const PRODUCTS = [
  {
    "id": "sawyer-squeeze",
    "name": "Sawyer Squeeze Water Filtration System",
    "category": "0.1 Micron Hollow Fiber, Squeeze Pouches, Backflushable",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "0.1-micron hollow fiber membrane that Sawyer rates to remove bacteria and protozoa",
      "Threads onto standard disposable water bottles as well as the included pouches",
      "Backflushable with the included syringe to restore flow",
      "Light, small and inexpensive for what it does"
    ],
    "cons": [
      "A filter, not a purifier: Sawyer does not rate it to remove viruses",
      "The squeeze pouches wear out before the filter does",
      "Must be kept from freezing once wet"
    ],
    "bottomLine": "The most useful portable filter for the money: small enough for a kit, flexible enough to fill a pot, and easy to keep flowing.",
    "description": "The Sawyer Squeeze is the filter we would put in an emergency kit first. It is a small hollow-fiber cartridge with a 0.1-micron membrane that Sawyer rates to remove bacteria and protozoa, the organisms behind most waterborne illness from rivers and lakes. You fill a pouch with untreated water, screw the filter on and squeeze clean water into a bottle or pot, and the filter also threads onto ordinary disposable water bottles, which makes it far more flexible than a straw. When flow slows, you backflush it with the included syringe and most of the flow comes back. It is light, it is cheap and it lasts a long time with care. It is a filter, not a purifier, so it is not rated for viruses; read the section below on when that matters. And once it has been wet it must be kept from freezing, which can crack the fibers."
  },
  {
    "id": "katadyn-befree-1l",
    "name": "Katadyn BeFree 1.0L Water Filter",
    "category": "0.1 Micron Hollow Fiber, 1L Soft Flask, Fast Flow",
    "badge": "Fastest Flow",
    "amazonUrl": "#",
    "pros": [
      "0.1-micron hollow fiber filter that Katadyn rates to remove bacteria and protozoa",
      "Fast flow that makes it pleasant to drink straight from the flask",
      "Cleans by shaking or swishing, no backflush syringe",
      "Collapsible flask packs very small"
    ],
    "cons": [
      "Not rated to remove viruses",
      "Soft flask is less durable than a hard bottle",
      "Filter is specific to the flask's wide mouth, so it is less flexible than the Sawyer"
    ],
    "bottomLine": "The pick if you want to scoop, drink and go with the least effort, accepting a less versatile setup.",
    "description": "The BeFree is built around speed and convenience. It is a 1-litre soft flask with a hollow-fiber filter in the cap, and Katadyn rates the 0.1-micron membrane to remove bacteria and protozoa. Its standout feature is flow: water comes through quickly enough that drinking straight from the flask feels natural, where many filters make you work for every sip. Cleaning is simple, too. You shake or swish the filter in clean water rather than backflushing it with a syringe. The trade-offs are the flask and the fit. The soft flask is less tough than a hard bottle, and the filter is designed for this wide-mouth flask, so it is less adaptable than the Sawyer for filling pots or other containers. Like the Sawyer, it is a filter, not a purifier, and is not rated for viruses."
  },
  {
    "id": "grayl-geopress",
    "name": "GRAYL GeoPress Water Purifier Bottle",
    "category": "Purifier, 24 oz, Press Design",
    "badge": "Best Purifier",
    "amazonUrl": "#",
    "pros": [
      "GRAYL rates it as a purifier: viruses, bacteria and protozoa",
      "Also lists reduction of some chemicals, heavy metals and microplastics",
      "Press design purifies a full bottle in seconds rather than squeezing or sucking",
      "Hard, durable bottle"
    ],
    "cons": [
      "Heaviest and bulkiest option here",
      "Cartridges have a much shorter life than hollow-fiber filters and cost more",
      "Pressing takes real force, especially as the cartridge ages"
    ],
    "bottomLine": "The one to buy if virus risk matters to you: flood water, travel, or a boil notice when you cannot boil.",
    "description": "The GeoPress is the only purifier on this list, and that is the reason to buy it. GRAYL rates it to remove viruses as well as bacteria and protozoa, and lists reduction of some chemicals, heavy metals and microplastics too, which hollow-fiber filters do not claim. It works like a coffee press: fill the outer cup, push the inner cup down through the cartridge, and a full 24-ounce bottle is ready in seconds. That speed and the virus rating come at a cost. It is heavier and bulkier than every other filter here, its cartridges are rated for far fewer litres than a hollow-fiber filter and cost more to replace, and pressing takes real force, more so as the cartridge clogs. For a household kit it is the right tool for the dirtiest water, used alongside a cheaper filter for everything else."
  },
  {
    "id": "platypus-gravityworks-4l",
    "name": "Platypus GravityWorks 4.0L Water Filter System",
    "category": "Gravity, 0.2 Micron Hollow Fiber, Two 4L Reservoirs",
    "badge": "Best for a Family",
    "amazonUrl": "#",
    "pros": [
      "Gravity does the work: hang the dirty bag and clean water fills the clean bag",
      "Two 4-litre reservoirs filter enough for a household in one go",
      "0.2-micron hollow fiber that Platypus rates for bacteria and protozoa",
      "Easy to backflush by lifting the clean bag above the dirty one"
    ],
    "cons": [
      "Not rated to remove viruses",
      "Needs somewhere to hang the bag",
      "Bulkier than a squeeze filter"
    ],
    "bottomLine": "The best way to filter water for several people at once without pumping, squeezing or power.",
    "description": "The GravityWorks is the household-sized option. It comes with two 4-litre reservoirs and a hollow-fiber filter in the hose between them. You fill the dirty bag, hang it from a hook, a door or a branch, and gravity pushes water through the 0.2-micron filter into the clean bag while you do something else. Platypus rates the filter to remove bacteria and protozoa. That hands-free operation is what makes it right for a family: eight litres at a time covers drinking and cooking for a small household for a day, and nobody has to squeeze a pouch for twenty minutes. Backflushing is as simple as raising the clean bag above the dirty one. It is bulkier than a squeeze filter and is not rated for viruses, but for volume without power it is the best tool here."
  },
  {
    "id": "lifestraw-personal",
    "name": "LifeStraw Personal Water Filter",
    "category": "0.2 Micron Hollow Fiber, Straw Design, No Moving Parts",
    "badge": "Best Budget / Backup",
    "amazonUrl": "#",
    "pros": [
      "Very cheap, light and simple, with nothing to break",
      "LifeStraw rates the 0.2-micron membrane to remove bacteria and parasites",
      "LifeStraw lists a capacity of about 4,000 litres",
      "No batteries, no chemicals, no setup"
    ],
    "cons": [
      "You can only drink through it; it cannot fill a pot or a bottle",
      "Not rated to remove viruses or chemicals",
      "Hard to share between people hygienically"
    ],
    "bottomLine": "The backup to put in every car, bag and kit, not the main way to supply a household.",
    "description": "The LifeStraw Personal is the simplest filter there is. It is a straw with a hollow-fiber membrane inside that LifeStraw rates to remove bacteria and parasites, and LifeStraw lists its capacity at about 4,000 litres. You put one end in the water and drink through the other. There are no moving parts, no batteries and nothing to assemble, and it costs little enough to put one in every car, backpack and go-bag. The limitation is just as simple: it only works for drinking directly from a source. You cannot use it to fill a cooking pot, a baby bottle or a container for later, and sharing one straw between several people is awkward. It is the right backup and the wrong main filter."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Water Filters",
          item: "https://www.thehonestreviewers.com/best-portable-water-filter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best portable water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people the Sawyer Squeeze is the best all-round choice. Its 0.1-micron hollow fiber is rated for bacteria and protozoa, it threads onto pouches and ordinary bottles, it can be backflushed to restore flow, and it is small and inexpensive enough to keep in every emergency kit."
          }
        },
        {
          "@type": "Question",
          "name": "Do portable water filters remove viruses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most do not. Hollow-fiber filters like the Sawyer, Katadyn BeFree, Platypus GravityWorks and LifeStraw Personal are rated for bacteria and protozoa. A purifier, such as the GRAYL GeoPress, is rated for viruses too. When viruses are a risk, boil the water or use a purifier."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a portable water filter during a boil water notice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow your local health authority's instructions first; if they say boil, boil. A standard filter is not rated for viruses, so it does not replace boiling. A purifier rated for viruses, or a filter followed by chemical treatment, is the backup when boiling is impossible."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable filter make flood water safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not recommended. Flood water can carry viruses, chemicals, fuel and sewage, and no filter on this list removes all of those. Use stored water, bottled water or water from your hot water tank instead, and treat flood water as unsafe to drink."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a portable water filter last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hollow-fiber filters are rated for hundreds to thousands of litres, and usually outlast their pouches and bags with care. Purifier cartridges are rated for far less. Freezing, heavy sediment and poor cleaning shorten any filter's life, so pre-filter and backflush as recommended."
          }
        },
        {
          "@type": "Question",
          "name": "Is a gravity filter better than a squeeze filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a family, a gravity filter is easier because it treats litres at a time without effort. For one person or a kit bag, a squeeze filter is smaller and more flexible. Many households keep a gravity filter at home and squeeze or straw filters in cars and go-bags."
          }
        },
        {
          "@type": "Question",
          "name": "Do portable water filters remove chlorine or lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most hollow-fiber filters do not, because those contaminants are dissolved in the water and pass through a membrane sized for organisms. GRAYL lists reduction of some chemicals and heavy metals for the GeoPress. For everyday tap water, use a certified home water filter."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "portable water filter",
      "best portable water filter",
      "emergency water filter",
      "water purifier bottle",
      "gravity water filter bag",
      "backpacking water filter"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Buyer's Guide
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Portable Water Filters</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A filter that works without power turns questionable water into drinking water when the tap stops. Knowing whether you need a filter or a purifier matters more than the brand.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#sawyer-squeeze"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Rankings
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-portable" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why One at Home</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#filter-vs-purifier" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Filter vs Purifier</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Choosing a Type</a>
          <a href="#outage-plan" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Outages and Boil Notices</a>
          <a href="#flow-capacity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Flow and Capacity</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Storage and Care</a>
          <a href="#tap-water" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Portable vs Home Filters</a>
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Which to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most portable water filters are sold for camping, but the place you are most likely to need one is at home, during an outage, a broken main or a boil notice when you cannot boil.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="why-portable" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Why a Portable Water Filter Belongs in a Home Kit
          </h2>

          <p>
            Most people think of portable water filters as camping gear, and most of them are sold that way. But the situations where a household is most likely to need one are at home: a storm knocks out power to a well pump, a water main breaks, or the local utility issues a boil water notice and the power is out so you cannot boil. In each of those cases, a filter that works without electricity turns a bucket of questionable water into something you can drink.
          </p>

          <p>
            A home system does not cover these cases. Under-sink and countertop filters, including the gravity units in our <a href="/best-countertop-water-filter/">countertop water filter guide</a>, are designed to improve treated tap water. They reduce chlorine, taste and some contaminants, but most are not rated to make untreated water from a creek, a rain barrel or a flooded well safe. A portable filter is built for exactly that job.
          </p>

          <p>
            They are also cheap, small and long-lasting. A good hollow-fiber filter costs about the same as a case of bottled water, fits in a drawer, and can filter hundreds or thousands of litres. Bottled water is still the first line of defence for an outage, but a filter means you are not limited to what you stored.
          </p>

          <p>
            This guide covers five filters that each suit a different job: a flexible squeeze filter, a fast drink-through flask, a true purifier for the worst water, a gravity system for a family, and a cheap straw for every bag. Most homes need one or two of them, not all five.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The 5 Best Portable Water Filters, Ranked
          </h2>

          <p>
            Every filter below is a current model sold on Amazon. Removal claims are the manufacturer's ratings. We ranked them for emergency use at home first and outdoor use second.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
                            <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            {pro}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-3">Cons</p>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="flex items-start gap-2 text-sm text-red-800">
                            <svg class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            {con}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

