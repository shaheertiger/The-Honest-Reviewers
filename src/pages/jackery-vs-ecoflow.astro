---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "What Size Portable Power Station Do I Need",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How Long Do Portable Power Stations Last",
    "url": "/how-long-do-portable-power-stations-last/"
  },
  {
    "title": "How to Charge a Portable Power Station With Solar",
    "url": "/how-to-charge-a-portable-power-station-with-solar/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-01", modified: "2026-10-01" });
const title = "Jackery vs EcoFlow: Which Brand Wins at Each Size, and Who Should Buy Which";
const description =
  "Jackery vs EcoFlow compared model for model at 1, 2 and 5 kWh: output, charging, solar, cycle ratings, UPS speed, weight and warranty, with a clear verdict.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Jackery vs EcoFlow",
          item: "https://www.thehonestreviewers.com/jackery-vs-ecoflow/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Jackery or EcoFlow better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most home backup buyers, EcoFlow, because its current models offer more AC output, faster wall charging, higher solar input and faster UPS switchover at each size up to 2 kWh. Jackery is better if weight and simplicity matter most, and its Explorer 5000 Plus out-powers EcoFlow's DELTA Pro 3 at the whole-home end."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better, Jackery Explorer 1000 v2 or EcoFlow DELTA 3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The DELTA 3 Plus is the more capable unit, with 1800W of output against 1500W, six AC outlets against three, 1000W of solar input against 400W, and expansion to 5 kWh. The Explorer 1000 v2 is 3.8 pounds lighter and simpler to operate. Choose the EcoFlow for home backup and the Jackery for portability."
          }
        },
        {
          "@type": "Question",
          "name": "Do Jackery and EcoFlow both use LiFePO4 batteries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, across their current main lineups. Every model in this comparison uses LiFePO4 cells. Older Jackery Explorer models used NMC lithium-ion with much lower cycle ratings, so if you are buying used or on clearance, check the spec sheet for the cell chemistry before assuming the long cycle life applies."
          }
        },
        {
          "@type": "Question",
          "name": "Which charges faster, Jackery or EcoFlow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EcoFlow, in standard mode. The DELTA 3 Plus refills in 56 minutes from a wall outlet and the DELTA 3 Max models reach 80 percent in about an hour. Jackery's Explorer 1000 v2 takes 1.58 hours normally and about an hour in its app-enabled emergency mode, so the gap narrows once you switch that on."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix Jackery and EcoFlow batteries or panels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expansion batteries are brand and model specific, so you cannot add an EcoFlow battery to a Jackery or vice versa. Solar panels are more flexible: either brand accepts third-party panels within its voltage and wattage limits, sometimes with an adapter cable for the connector. Check the input voltage window before connecting any panel."
          }
        },
        {
          "@type": "Question",
          "name": "Which has the better warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On paper they are close. Jackery lists most current models at three years plus two extra when bought directly or through authorised sellers. EcoFlow lists five years on its current DELTA models, described on several pages as three years plus two on app registration. In both cases, register promptly to secure the full term."
          }
        },
        {
          "@type": "Question",
          "name": "Is the EcoFlow DELTA 2 still worth buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you find one discounted, yes. It has 1024 Wh of LiFePO4 capacity, 1800W of output and expansion, and it remains a capable unit. EcoFlow's US store now steers buyers to the DELTA 3, which adds faster charging and a 4,000-cycle rating, so compare prices before choosing the older model."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "jackery vs ecoflow",
      "ecoflow vs jackery",
      "jackery explorer 1000 v2 vs ecoflow delta 3",
      "jackery homepower 2000 plus v2 vs ecoflow delta 3 max",
      "jackery 5000 plus vs ecoflow delta pro 3",
      "best power station brand"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Power Station Picks",
    link: "/best-portable-power-station/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Comparison
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Jackery vs <span class="text-[#38BDF8]">EcoFlow</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Both sell LiFePO4 power stations from 1 kWh to whole-home systems. EcoFlow usually wins on output, charging speed and solar input. Jackery usually wins on weight and simplicity. Here is how the current models line up, size by size.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#verdict"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            Get the Verdict
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="18.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#one-kwh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. 1 kWh: Explorer 1000 v2 vs DELTA 3</a>
          <a href="#two-kwh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. 2 kWh: Explorer and HomePower vs DELTA 3 Max</a>
          <a href="#whole-home" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Whole Home: 5000 Plus vs DELTA Pro 3</a>
          <a href="#cycles-warranty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Chemistry, Cycles and Warranty</a>
          <a href="#charging-solar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Wall Charging and Solar Input</a>
          <a href="#ups-app-noise" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. UPS, App and Noise</a>
          <a href="#who-should-buy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Who Should Buy Which</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          If you want the most output, the fastest wall charging and the most solar input for the money, EcoFlow wins at almost every size. If you want the lightest box at a given capacity and the simplest thing to live with, Jackery is the better buy. Both now use LiFePO4 cells across their main lineups, so the old chemistry argument is over; what separates them is output, charging, expansion and how the warranty is structured.
        </p>

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            Jackery and EcoFlow are the two names most people shortlist, and at a glance their catalogues look interchangeable: a 1 kWh box, a 2 kWh box, an expandable home-backup unit and a large 120/240V system. Line the current models up spec for spec, though, and a consistent pattern appears. EcoFlow puts more inverter, more charging power and more solar input into each size class. Jackery builds lighter units and keeps the interface simpler.
          </p>

          <p>
            At 1 kWh, the EcoFlow DELTA 3 Plus gives you 1800W of continuous AC output against 1500W on the Jackery Explorer 1000 v2, takes 1000W of solar against 400W, and expands to 5 kWh where the Explorer does not expand at all. The Explorer, in turn, is nearly four pounds lighter and slightly bigger in capacity. At 2 kWh and at the whole-home end, the same pattern repeats with one notable exception: Jackery's Explorer 5000 Plus out-muscles EcoFlow's DELTA Pro 3 on output and solar, at the cost of more than 20 extra pounds.
          </p>

          <p>
            That is why our <a href="/best-portable-power-station/">best portable power station guide</a> names an EcoFlow as the best overall pick and a Jackery as the best value and first-time buy. The EcoFlow DELTA 2 that leads that guide has now been succeeded on EcoFlow's US store by the DELTA 3 family, which carries the same 1024 Wh capacity with a faster charger and a longer cycle rating, so everything that made the DELTA 2 our top pick applies to its successor.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">At 1 kWh, Side by Side</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">1800W</p>
                <p class="text-gray-400 text-xs mt-1">DELTA 3 Plus AC output</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">1500W</p>
                <p class="text-gray-400 text-xs mt-1">Explorer 1000 v2 AC output</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">23.8 lb</p>
                <p class="text-gray-400 text-xs mt-1">Explorer 1000 v2 weight</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">27.6 lb</p>
                <p class="text-gray-400 text-xs mt-1">DELTA 3 Plus weight</p>
              </div>
            </div>
          </div>

          <p>
            The rest of this page goes size by size using the makers' own published specifications, then through the categories that matter after purchase: cycle ratings, wall and solar charging, UPS switchover, app and noise, and warranty. If you have not yet worked out how much capacity you need, do that first with our guide to <a href="/what-size-portable-power-station-do-i-need/">what size portable power station you need</a>, because picking the right size matters more than picking the right brand.
          </p>
        </div>

        <div id="one-kwh" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. 1 kWh: Jackery Explorer 1000 v2 vs EcoFlow DELTA 3 Plus
          </h2>

          <p>
            This is the size most people buy: enough to keep a fridge, a router and some lights going through an evening outage, or to run a campsite for a weekend. Jackery's entry is the Explorer 1000 v2. EcoFlow's is the DELTA 3 family, of which the DELTA 3 Plus is the version to compare, since it adds a second solar input and a faster 140W USB-C port over the plain DELTA 3 for a modest premium.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec (maker's figures)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Jackery Explorer 1000 v2</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow DELTA 3 Plus</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Capacity</td>
                    <td class="px-4 py-4 text-gray-700">1070 Wh</td>
                    <td class="px-4 py-4 text-gray-700">1024 Wh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chemistry and cycles</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4, 4,000 cycles to 70%</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4, 4,000 cycles to 80%</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC output</td>
                    <td class="px-4 py-4 text-gray-700">1500W, 3000W surge, 3 outlets</td>
                    <td class="px-4 py-4 text-gray-700">1800W, 3600W surge, 6 outlets</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">X-Boost style mode</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Up to 2200W resistive loads</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wall charging</td>
                    <td class="px-4 py-4 text-gray-700">1.58 hrs standard, about 1 hr in app emergency mode</td>
                    <td class="px-4 py-4 text-gray-700">1500W input, full in 56 min</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solar input</td>
                    <td class="px-4 py-4 text-gray-700">400W max, 2 ports, 12-60V</td>
                    <td class="px-4 py-4 text-gray-700">1000W max, 2 x 500W, 11-60V</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Expandable</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Yes, up to 5 kWh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">UPS switchover</td>
                    <td class="px-4 py-4 text-gray-700">Under 20 ms</td>
                    <td class="px-4 py-4 text-gray-700">Under 10 ms</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weight</td>
                    <td class="px-4 py-4 text-gray-700">23.8 lb</td>
                    <td class="px-4 py-4 text-gray-700">27.6 lb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Warranty</td>
                    <td class="px-4 py-4 text-gray-700">3 + 2 years</td>
                    <td class="px-4 py-4 text-gray-700">5 years</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            On paper the DELTA 3 Plus wins most rows. Its 1800W inverter runs a 1500W space heater or a full-size microwave with headroom to spare, where the Explorer's 1500W limit makes those borderline. Its six AC outlets against three matter more than they sound during an outage, when you are otherwise daisy-chaining a power strip. And its 1000W solar ceiling means two or three mid-size panels can refill it in an afternoon, where the Explorer tops out at two 200W panels.
          </p>

          <p>
            The Explorer's advantages are real but narrower. It is 3.8 pounds lighter, which you notice carrying it to a campsite or up from a basement. It holds 46 Wh more energy. And its spec sheet is simpler: three outlets, one charging mode switch in the app, nothing to configure. For someone buying their first power station mainly for camping and the occasional outage, that simplicity has value, and it is why the Explorer 1000 v2 is the value pick in our roundup.
          </p>

          <p>
            If you think you might want more capacity later, Jackery's answer at this size is the newer HomePower 1000 Plus v2, a 1024 Wh unit with 1800W of output, 3600W peak, a sub-10 ms UPS switchover and expansion to 11 kWh using 2 kWh battery packs. That makes it a direct rival to the DELTA 3 Plus on paper, and the choice between them comes down to price on the day and whose battery ecosystem you would rather buy into.
          </p>

          <p>
            Our verdict at this size: the DELTA 3 Plus is the more capable machine and the better choice for home backup. The Explorer 1000 v2 is the better choice if weight and simplicity top your list and you are confident 1 kWh and 1500W are all you will ever need.
          </p>
        </div>

        <div id="two-kwh" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. 2 kWh: Explorer 2000 v2 and HomePower 2000 Plus v2 vs DELTA 3 Max
          </h2>

          <p>
            At 2 kWh both brands split their lineup in two: a fixed-capacity unit and an expandable one. Jackery's fixed unit is the Explorer 2000 v2; its expandable model is the HomePower 2000 Plus v2, which replaces the Explorer 2000 Plus that many older comparisons still reference. EcoFlow's equivalents are the DELTA 3 Max and the expandable DELTA 3 Max Plus, with the older DELTA 2 Max still on sale alongside them.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Fixed capacity: Explorer 2000 v2 vs DELTA 3 Max</h3>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Jackery Explorer 2000 v2</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow DELTA 3 Max</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Capacity</td>
                    <td class="px-4 py-4 text-gray-700">2042 Wh</td>
                    <td class="px-4 py-4 text-gray-700">2048 Wh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC output</td>
                    <td class="px-4 py-4 text-gray-700">2200W, 4400W surge, 3 outlets</td>
                    <td class="px-4 py-4 text-gray-700">2400W, X-Boost to 3400W, 4 outlets</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wall charging</td>
                    <td class="px-4 py-4 text-gray-700">1.75 hrs standard, 1.3 hrs emergency</td>
                    <td class="px-4 py-4 text-gray-700">1800W input, 0-80% in 68 min</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solar input</td>
                    <td class="px-4 py-4 text-gray-700">400W max</td>
                    <td class="px-4 py-4 text-gray-700">500W max</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cycles</td>
                    <td class="px-4 py-4 text-gray-700">4,000 to 70%</td>
                    <td class="px-4 py-4 text-gray-700">Maker quotes about 10 years of use</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">UPS switchover</td>
                    <td class="px-4 py-4 text-gray-700">Not stated on spec sheet</td>
                    <td class="px-4 py-4 text-gray-700">Under 10 ms</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weight</td>
                    <td class="px-4 py-4 text-gray-700">39.5 lb</td>
                    <td class="px-4 py-4 text-gray-700">44.8 lb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Warranty</td>
                    <td class="px-4 py-4 text-gray-700">3 + 2 years</td>
                    <td class="px-4 py-4 text-gray-700">5 years with app registration</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
