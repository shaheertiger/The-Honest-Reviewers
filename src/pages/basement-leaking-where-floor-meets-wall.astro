                    <td class="px-4 py-4 text-gray-700">Minor, occasional dampness on a poured wall</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dehumidifier</td>
                    <td class="px-4 py-4 text-gray-700">Roughly $200-$400</td>
                    <td class="px-4 py-4 text-gray-700">Plastic sheet test shows condensation</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Footing drain camera inspection</td>
                    <td class="px-4 py-4 text-gray-700">A few hundred dollars</td>
                    <td class="px-4 py-4 text-gray-700">Older house with an existing exterior drain</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Interior perimeter drain and sump</td>
