import productImages from "../data/product-images.json";

const title = "7 Best Wet Look Paver Sealers in 2026: Tested & Ranked";
const description =
  "We tested 20+ wet look paver sealers on brick, concrete, and stone. Here are the 7 that deliver a rich, lasting finish without peeling.";

const PRODUCTS = [
