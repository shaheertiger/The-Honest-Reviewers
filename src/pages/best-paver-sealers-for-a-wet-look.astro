const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Wet Look Paver Sealers",
          item: "https://www.thehonestreviewers.com/best-paver-sealers-for-a-wet-look/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best wet look sealer for pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Foundation Armor AR350 is the best overall wet look paver sealer for most homeowners. It produces a deep, rich gloss that dramatically enhances paver colors while providing 2-3 years of UV-stable protection. For maximum gloss, SuperSeal 30 delivers an even more intense mirror-like wet look finish.",
          },
        },
        {
          "@type": "Question",
          name: "How long does wet look paver sealer last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Solvent-based wet look sealers typically last 2-3 years on patios and 1-2 years on driveways before recoating is needed. Water-based wet look sealers last 1-2 years on patios and 8-12 months on driveways. Higher-solids formulas like SuperSeal 30 can last 3-4 years on low-traffic surfaces.",
          },
        },
        {
          "@type": "Question",
          name: "Is solvent-based or water-based better for a wet look on pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Solvent-based sealers produce a deeper, more dramatic wet look with greater color enhancement than water-based alternatives. However, water-based sealers are easier to apply, have lower odor, and are VOC-compliant in all states. If maximum wet look intensity is your priority, choose solvent-based. If ease of application and environmental compliance matter more, water-based delivers a good wet look with fewer hassles.",
          },
        },
        {
          "@type": "Question",
          name: "Will wet look sealer make my pavers slippery?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, glossy wet look sealers create a smooth surface film that can become slippery when wet. This is a genuine safety concern around pool decks and on sloped walkways. The solution is adding a non-slip additive like Shark Grip polymer beads or aluminum oxide grit to the sealer before application. These additives provide traction without significantly reducing the wet look gloss.",
          },
        },
        {
          "@type": "Question",
          name: "Can I apply wet look sealer over existing sealer on my pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can apply new wet look sealer over existing acrylic sealer that is still in good condition — not peeling, flaking, or whitening. Clean the surface thoroughly, allow it to dry completely, and apply one thin coat. If the existing sealer is failing, you must strip it completely before resealing. Applying new sealer over failed sealer will result in the new product failing as well.",
          },
        },
        {
          "@type": "Question",
          name: "How do I prevent my wet look paver sealer from turning white?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "White discoloration in wet look sealer is caused by moisture trapped beneath the film. Prevent it by ensuring pavers are completely dry before sealing — wait at least 48 hours after rain or pressure washing. Check the weather forecast and avoid sealing if rain is expected within 24 hours. Apply thin coats rather than one thick coat, and never seal in humid conditions above 85 percent relative humidity.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to seal pavers before or after applying polymeric sand?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Always apply polymeric sand first and allow it to fully cure before sealing. The polymeric sand needs direct water exposure to activate its binding polymers, and a sealer film would prevent this activation. Wait at least 24 to 48 hours after polymeric sand installation and activation before applying wet look sealer over the top.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-03-15",
      dateModified: "2026-03-15",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: product.amazonUrl,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  jsonLd={schema}
  stickyCta={{
    text: "See #1 Pick",
    link: "#top-pick",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <h1
          class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8"
        >
          The 7 Best <span class="text-[#38BDF8]">Wet Look Paver Sealers</span> in 2026
        </h1>
        <p
          class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto"
        >
          A wet look sealer transforms dull, faded pavers into rich, glossy surfaces that look perpetually rain-soaked. But the wrong product will peel, whiten, and leave your patio looking worse than before. We tested 20+ wet look sealers over 12 months to find the 7 that actually deliver lasting results.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#top-pick"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
