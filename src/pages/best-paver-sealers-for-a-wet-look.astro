    badge: "Best Budget",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 12800,
    pros: [
      "Excellent value at $30-40 per gallon with high coverage rates of 300+ sq ft",
      "Water-based formula with very low odor suitable for residential neighborhoods",
      "Good initial wet look color enhancement on both concrete and natural stone pavers",
