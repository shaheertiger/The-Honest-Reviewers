];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "The Best Time of Year to Stain a Deck";
const description =
  "Late spring and early autumn, in the shade, with the overnight low above 50°F. Why the daytime forecast is the wrong number to check.";

