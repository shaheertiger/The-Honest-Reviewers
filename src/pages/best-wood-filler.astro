---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Spackle vs Putty",
    "url": "/spackle-vs-putty/"
  },
  {
    "title": "Joint Compound vs Spackle",
    "url": "/joint-compound-vs-spackle/"
  },
  {
    "title": "Best Spackle",
    "url": "/best-spackle/"
  },
  {
    "title": "Best Primers",
    "url": "/best-primer/"
  },
  {
    "title": "Best Deck Paint",
    "url": "/best-deck-paint/"
  },
  {
    "title": "Best Miter Saws",
    "url": "/best-miter-saw/"
  },
  { title: "How Long Does Wood Filler Take to Dry?", url: "/how-long-does-wood-filler-take-to-dry/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-06", modified: "2026-10-06" });
const title = "8 Best Wood Fillers in 2026: Latex, Two-Part and Epoxy Compared";
const description =
  "Eight wood fillers compared for trim, stained furniture, exterior repairs and rotted wood, with honest notes on stainability, shrinkage and when to use epoxy.";

const PRODUCTS = [
  {
    "id": "dap-plastic-wood-x-7079800540",
    "name": "DAP Plastic Wood-X with DryDex Wood Filler (7079800540)",
    "category": "Latex, Interior/Exterior, Knife-Grade",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 1600,
    "pros": [
      "DryDex indicator goes on pink and turns natural when it is dry enough to sand",
      "Thick knife-grade body holds on corners and vertical surfaces and can be sculpted",
      "Can be planed, cut, drilled, screwed, nailed, sanded, stained and painted once dry",
      "Rated for interior and exterior wood",
      "Low odor with soap-and-water cleanup"
    ],
    "cons": [
      "Deep fills are slow: DAP quotes 36 hours for 1/4 inch and deeper",
      "Small 5.5 oz tub runs out quickly on bigger jobs"
    ],
    "bottomLine": "The filler we would keep on the shelf for almost every repair: easy to work, tough once cured, and it tells you when it is ready.",
    "description": "Plastic Wood-X is DAP's latex upgrade on its classic solvent-based Plastic Wood, and it is the most forgiving all-round filler we know of. The body is thick, knife-grade and slightly sticky, so it stays put on an outside corner or a vertical door edge instead of sagging out of the repair, and you can mold it to rebuild a chipped profile. The DryDex feature sounds like a gimmick but solves a real problem: the filler goes on pink and turns natural when it is dry, which stops you sanding a repair that is still soft underneath. DAP quotes 3 to 6 hours for repairs up to 1/8 inch deep and 36 hours for fills of 1/4 inch and deeper, so build big repairs in layers. Once cured it can be planed, cut, drilled, screwed, nailed and sanded, and DAP rates it for interior and exterior wood. It is stainable in the sense that it accepts stain, but like every filler it will not match stained wood exactly, so test on scrap first. Cleanup is soap and water and the odor is low. The 5.5 oz tub is small; buy the larger size for trim or siding work."
  },
  {
    "id": "minwax-stainable-wood-filler-42853",
    "name": "Minwax Stainable Wood Filler, 16 oz (42853000)",
    "category": "Latex, Stainable, Interior/Exterior",
    "badge": "Best for Stained Projects",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 7000,
    "pros": [
      "Formulated to accept both oil- and water-based Minwax stains",
      "Paintable and sandable, for indoor and outdoor unfinished wood",
      "Shallow repairs dry in about 2 hours",
      "Generous 16 oz tub at a modest price",
      "Water cleanup"
    ],
    "cons": [
      "Deep holes must be built in 1/4-inch layers, each taking 2 to 6 hours",
      "Stained repairs still read lighter or darker than the surrounding grain"
    ],
    "bottomLine": "The sensible choice when you plan to stain, especially if you are already using Minwax stains.",
    "description": "Minwax's Stainable Wood Filler is a latex formula that the company specifically formulates to accept its own oil- and water-based wood stains, which is why it is our pick for projects that will be stained rather than painted. That matters because many fillers that claim to be stainable simply tolerate stain, leaving a flat, blotchy patch. No filler takes stain exactly like wood, but this one gets closer than most, especially when you sand it flush and then apply the stain with the same technique as the rest of the piece. It handles cracks, small gouges, nail holes and knot holes on unfinished wood indoors and out. Minwax says most shallow repairs dry within 2 hours, and deeper holes should be filled in layers of 1/4 inch, allowing 2 to 6 hours each. The 16 oz tub is a good size for a room of trim or a furniture restoration and costs little. Our advice for the best match is to test on a scrap of the same wood first, and if the filled spot reads too light, darken it with a second coat of stain on the patch only before topcoating."
  },
  {
    "id": "abatron-woodepox-weab6or",
    "name": "Abatron WoodEpox Two-Part Epoxy Wood Filler Kit, 12 oz",
    "category": "Two-Part Epoxy, Structural, Interior/Exterior",
    "badge": "Best for Rotted Wood",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 3100,
    "pros": [
      "Mixes 1:1 by volume by hand with a working time of about 20 minutes",
      "100 percent solids, so it does not shrink or pull away from the repair",
      "Can be sawed, planed, routed, drilled and sanded like wood once hardened",
      "Designed to pair with Abatron LiquidWood consolidant for rotted wood",
      "Greenguard certified with virtually no VOCs"
    ],
    "cons": [
      "Costs several times more per ounce than latex fillers",
      "Application temperature range of 50 to 90 degrees F rules out cold-weather work with the standard formula"
    ],
    "bottomLine": "The repair that saves rotted sills, door bottoms and trim instead of replacing them.",
    "description": "WoodEpox is the product restoration carpenters reach for when wood has rotted rather than simply cracked. It is a two-part epoxy putty that you mix 1:1 by volume until the color is uniform, then press into the repair. Abatron gives a working time of about 20 minutes and says it hardens in 1 to 2 hours depending on temperature. Because it is 100 percent solids, with no water or solvent to evaporate, it does not shrink, so a deep repair stays flush instead of sinking. The cured putty is light and beige and can be sawed, planed, routed, drilled and sanded much like wood, and it can be tinted with dry pigments. The full system pairs it with Abatron's LiquidWood, a thin epoxy consolidant that soaks into and hardens soft, punky wood before you fill, which is how you rebuild a rotted window sill or door jamb without cutting it out. It is rated for interior and exterior use, Greenguard certified and has virtually no VOCs. The drawbacks are price and temperature: it is expensive, and the standard formula wants 50 to 90 degrees F, though Abatron offers a cold-weather version. For anything structural or exterior, it is worth the money."
  },
  {
    "id": "minwax-high-performance-wood-filler-41600",
    "name": "Minwax High Performance Wood Filler, 6 oz (41600000)",
    "category": "Two-Part, Interior/Exterior, Paint-Grade",
    "badge": "Best Fast Exterior Repair",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 160,
    "pros": [
      "Two-part filler that hardens in about 15 minutes and sands in about 30",
      "Will not shrink, crack or fall out of the repair",
      "Weather, water and rot resistant for exterior trim, sills and decks",
      "Bonds to wood plus ceramics, concrete, metal and fiberglass",
      "Can anchor screws and secure loose furniture joints"
    ],
    "cons": [
      "Strong odor and a short working window once the hardener is mixed in",
      "Hard, dense patch is best painted; it does not take stain like wood"
    ],
    "bottomLine": "A fast, hard, weatherproof filler for exterior repairs that will be painted the same day.",
    "description": "Minwax's High Performance Wood Filler is a two-part product: you knead a small amount of the included hardener into the filler, and it cures chemically instead of drying. That is the big advantage over latex fillers. It hardens in roughly 15 minutes and Minwax says it can be sanded in about 30, regardless of how deep the repair is, so you can fill, shape, sand and prime an exterior repair in a single session. Minwax describes it as super-strength, weather, water and rot resistant, and suitable for fixing split, damaged or rotted wood on decks, window sills, doors, furniture and woodwork. It will not shrink, crack or fall out, and it bonds to almost any rigid surface including ceramics, concrete, metal and fiberglass, which makes it useful for odd jobs beyond wood. It can also anchor screws in stripped holes and secure loose joints. The catch is handling. Once mixed, you have only a few minutes to work it, the odor is strong, and the cured patch is harder and denser than surrounding wood, so it sands unevenly if you are not careful. Treat it as a paint-grade repair. For large rotted sections, Abatron's slower epoxy system is easier to shape."
  },
  {
    "id": "j-b-weld-kwikwood-8258",
    "name": "J-B Weld KwikWood Wood Repair Epoxy Putty Stick (8258)",
    "category": "Two-Part Epoxy Putty Stick, Tan",
    "badge": "Best Quick Epoxy Fix",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 8300,
    "pros": [
      "Hand-mixable stick: cut off what you need and knead it, no measuring",
      "Sets in 15 to 25 minutes and cures in about 1 hour",
      "J-B Weld rates it at 2,450 psi tensile strength",
      "Can be machined, drilled, tapped, sanded, filed and painted after an hour",
      "Tan color blends with lighter woods"
    ],
    "cons": [
      "Small stick suits small repairs, not long cracks or siding",
      "Fixed tan color will not suit dark woods without paint"
    ],
    "bottomLine": "The epoxy repair to keep in the drawer for broken chair legs, stripped screw holes and chipped corners.",
    "description": "KwikWood is the quickest way to make an epoxy wood repair. It comes as a stick with the resin wrapped around the hardener, so you slice off the amount you need and knead it in your fingers until the color is even, with no measuring or mixing cups. J-B Weld says it sets in 15 to 25 minutes and cures in about an hour, after which it can be machined, drilled, tapped, sanded, filed and painted, and the company rates it at 2,450 psi of tensile strength. That makes it ideal for the repairs latex filler cannot handle: rebuilding a chipped table corner, re-forming a broken piece of molding, filling a stripped hinge-screw hole so the screw bites again, or patching a split in a chair rung. It is water resistant once cured, so it works on outdoor furniture too. The limitations come from the format. A single stick covers small repairs only, and the cured color is a fixed tan that suits light woods such as pine and maple but will stand out on walnut or cherry unless painted. J-B Weld lists it as stainable, but expect a paint-grade result. For bigger or rotted repairs, Abatron's WoodEpox is the better epoxy."
  },
  {
    "id": "goodfilla-wood-grain-filler-8oz",
    "name": "Goodfilla Water-Based Wood & Grain Filler, 8 oz",
    "category": "Water-Based, Tintable, Interior",
    "badge": "Best for Woodworkers",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1700,
    "pros": [
      "Sold in wood-species colors such as white oak, and can be tinted with pigment, stain or dye",
      "Works as both a hole filler and a grain filler for open-grain woods",
      "Reconstitutes with water, so a dried-out tub is not wasted",
      "Freeze-thaw stable with zero VOCs, made in the USA",
      "Does not shrink, sink or crack, according to the maker"
    ],
    "cons": [
      "Not water resistant, so it is for interior work only",
      "Smaller containers cost more per ounce than big-box tubs"
    ],
    "bottomLine": "The furniture maker's filler: tint it to match, use it for grain filling, and never throw away a dried tub again.",
    "description": "Goodfilla is aimed at woodworkers and furniture refinishers, and it solves two problems that general-purpose fillers do not. The first is color. It is sold in species colors, white oak among them, and the water-based formula can be mixed with pigments, stains or dyes, so you can tint it to match a piece before you fill rather than hoping a stain will take afterward. That is the most reliable way to get an invisible repair on stained furniture. The second is shelf life. Because it reconstitutes with water, a tub that has dried out is simply re-wetted rather than thrown away, and the maker says it is freeze-thaw stable. It is also sold as a grain filler for open-grain woods like oak and ash, packing the pores before a glossy finish. Goodfilla says it does not shrink, sink or crack, it sands smoothly and accepts finishes and stain evenly, and it has zero VOCs. The important limitation is that the listing describes it as not water resistant, so keep it to interior furniture, cabinets, floors and instruments. For exterior trim, use an epoxy or a latex filler rated for outdoor use."
  },
  {
    "id": "gorilla-wood-filler-107104",
    "name": "Gorilla All Purpose Wood Filler, 16 oz (107104)",
    "category": "Acrylic, Water Resistant, Interior/Exterior",
    "badge": "Best Budget All-Purpose",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 10900,
    "pros": [
      "Water resistant and rated for indoor and outdoor use",
      "Does not shrink or crack, according to Gorilla",
      "Paintable, stainable and sandable",
      "Smooth, easy-spreading consistency for fast trim work",
      "Holds nails and screws driven into the cured repair"
    ],
    "cons": [
      "Natural color is light and reads pale under darker stains",
      "Not a structural or rot-repair product"
    ],
    "bottomLine": "A low-cost, easy-spreading tub filler for trim, doors and general household repairs.",
    "description": "Gorilla's wood filler is the most-rated big tub in the category, sells at a budget price and is a good default for the kind of repairs most homeowners face: nail holes and gouges in trim, dents in doors, and cracks in painted woodwork. The acrylic formula spreads smoothly and feathers out well, which means less sanding on flat surfaces like door skins and baseboard, and Gorilla describes it as water resistant, shrink resistant and suitable for indoor and outdoor projects. Once cured it is paintable, stainable and sandable, and Gorilla says it anchors nails and screws, so you can fill a damaged area and fasten through it. The natural color is light, which is fine under paint but reads pale under medium and dark stains, so for stained work test first or tint it. Like any water-based filler, deep holes should be filled in layers and allowed to dry fully between coats, or the top skins over while the core stays soft. It is not a rot repair or structural filler; for crumbling sills or broken parts, step up to an epoxy. For painted trim around the house, though, it is all most people need."
  },
  {
    "id": "famowood-latex-wood-filler-40022126",
    "name": "FamoWood Latex Wood Filler, Natural, Pint (40022126)",
    "category": "Latex, Fast-Drying, Interior/Exterior",
    "badge": "Fastest Drying Latex",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 2300,
    "pros": [
      "FamoWood says it dries in 15 minutes",
      "Solvent free, low odor and cleans up with water",
      "Can be sanded, drilled or planed once dry",
      "Stainable, paintable, and rated for interior and exterior use",
      "Made in the USA"
    ],
    "cons": [
      "Fast drying shortens working time on large fills",
      "Deep repairs still need building in layers"
    ],
    "bottomLine": "The latex filler to grab when you want to fill, sand and paint before lunch.",
    "description": "FamoWood is a long-established brand among cabinetmakers and trim carpenters, and its latex filler brings the handling of the company's solvent-based filler without the solvent fumes. The headline feature is speed. FamoWood says it dries in 15 minutes, which on shallow nail holes and small gouges means you can fill a run of trim, sand it and move on to priming in a single visit. That is a real advantage over latex fillers that need an hour or more before they can be sanded cleanly. Once dry, it can be sanded, drilled or planed, and it is stainable, paintable and rated for interior and exterior use. Cleanup is water, the odor is low, and it is made in the USA. Owners give it one of the highest ratings in the category. The flip side of fast drying is a shorter working window. On a long crack or a large patch, work in smaller sections and keep the lid on the tub between scoops so it does not skin over. Deep repairs still need to be built in layers. For painted trim and cabinet work where speed matters most, it is an excellent choice."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Wood Filler",
          item: "https://www.thehonestreviewers.com/best-wood-filler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best wood filler for exterior use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small holes and cracks in painted exterior trim, an exterior-rated latex filler such as DAP Plastic Wood-X works well if it is primed and painted. For window sills, door bottoms and anywhere water sits, use a two-part filler like Minwax High Performance or an epoxy such as Abatron WoodEpox, which do not shrink and resist water and rot."
          }
        },
        {
          "@type": "Question",
          "name": "Is wood filler the same as wood putty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Wood filler hardens fully and is applied to bare wood before finishing, then sanded flush and stained or painted. Wood putty stays slightly soft, usually comes pre-colored, and is pressed into nail holes after the wood has been stained and finished. Use filler during the build and putty for touch-ups on finished surfaces."
          }
        },
        {
          "@type": "Question",
          "name": "Can you stain wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most fillers labeled stainable will accept stain, but none will look exactly like wood, because filler has no grain and absorbs stain evenly. The result is usually a flat patch that is lighter or darker than the board. For the best match, tint the filler before use, test on scrap, or fill finished wood with color-matched putty."
          }
        },
        {
          "@type": "Question",
          "name": "How long does wood filler take to dry?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It varies widely. Fast latex fillers like FamoWood can dry in about 15 minutes on shallow repairs, while DAP Plastic Wood-X quotes 3 to 6 hours for fills up to 1/8 inch and 36 hours for deeper ones. Two-part fillers and epoxies cure chemically, often sandable within 30 minutes to a couple of hours regardless of depth."
          }
        },
        {
          "@type": "Question",
          "name": "What should I use to fill large holes in wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For large holes, use a two-part epoxy or polyester filler, which cures without shrinking regardless of depth. Water-based fillers can work if you build the repair in thin layers and let each dry, but they shrink and take far longer. If the damaged area is bigger than the board itself, replacing the board is usually the better fix."
          }
        },
        {
          "@type": "Question",
          "name": "Can I screw into wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Into most cured epoxy, yes. J-B Weld says KwikWood can be drilled and tapped after an hour, and Minwax High Performance filler can anchor screws. Some latex fillers, including DAP Plastic Wood-X and Gorilla, also claim to hold screws or nails, but for a hinge or anything under load, an epoxy repair or a glued-in wood plug is far more reliable."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use wood filler or caulk on trim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use wood filler for nail holes, dents and gouges within the trim itself, and caulk for the joints where trim meets the wall, ceiling or another piece of trim. Those joints move slightly with temperature and humidity, and only a flexible caulk will stay sealed. Rigid filler in a moving joint cracks out within a season."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "best wood filler",
      "wood filler",
      "stainable wood filler",
      "exterior wood filler",
      "epoxy wood filler",
      "wood filler vs wood putty"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            8 Fillers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 8 Best <span class="text-[#38BDF8]">Wood Fillers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Latex for nail holes and trim, two-part for fast exterior fixes, epoxy for rotted wood, and a straight answer on what stainable really means.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dap-plastic-wood-x-7079800540"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Filler Types Compared</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 8 Top Picks</a>
          <a href="#filler-vs-putty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Filler vs Putty vs Spackle</a>
          <a href="#stainable" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Stainable vs Paintable</a>
          <a href="#exterior" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Interior vs Exterior</a>
