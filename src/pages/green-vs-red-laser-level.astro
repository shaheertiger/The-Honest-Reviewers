const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Green vs Red Laser Level",
          item: "https://www.thehonestreviewers.com/green-vs-red-laser-level/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a green laser level better than red?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Green is better for visibility, especially in bright rooms and on darker surfaces, because human eyes are more sensitive to green light. Red is cheaper and runs longer on batteries. For bright finished homes and frequent use, green is usually worth it. For dim interiors and occasional use, red is often enough."
          }
        },
        {
          "@type": "Question",
          "name": "How much brighter is a green laser than red?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturers commonly say green beams are up to about four times more visible than red at similar power, and standard visual sensitivity curves support a figure in that range for typical red wavelengths. The actual difference you see depends on lighting, distance and the surface."
          }
        },
        {
          "@type": "Question",
          "name": "Do green laser levels use more battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally yes. Green laser diodes are less efficient, so green lasers usually have shorter rated run times than comparable red models on the same batteries. Carry spares or choose a model with a rechargeable lithium-ion pack if you use it for long sessions."
          }
        },
        {
          "@type": "Question",
          "name": "Can you see a green laser level outside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only at short distances in daylight. Sunlight washes out both colors quickly. For outdoor work beyond a short range, switch the laser to pulse mode and use a compatible detector, or use a rotary laser designed for site work."
          }
        },
        {
          "@type": "Question",
          "name": "Are green laser levels safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Green laser levels in Class 2 or Class 3R are considered safe for normal use when you follow the label precautions. Never stare into the beam or point it at anyone's eyes. Green can feel more dazzling than red, but same-class lasers have similar output limits."
          }
        },
        {
          "@type": "Question",
          "name": "Do green lasers work in the cold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most current green lasers work within their stated operating range, but cold can reduce brightness and battery performance, and some older green designs were more sensitive to temperature. Check the operating range in the manual and let the tool warm up before relying on it in freezing conditions."
          }
        },
        {
          "@type": "Question",
          "name": "Why are green laser levels more expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Green laser diodes have historically cost more to make than red diodes, and green tools often include features aimed at professionals. The price gap has narrowed but remains. You are paying mainly for better visibility in bright conditions."
          }
        }
      ],
    },
    {
