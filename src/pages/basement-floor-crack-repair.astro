                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Shrinkage</td>
                    <td class="px-4 py-4 text-gray-700">Thin, flat, straight, stable</td>
                    <td class="px-4 py-4 text-gray-700">Concrete curing</td>
                    <td class="px-4 py-4 text-gray-700">Clean and fill</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Heave</td>
                    <td class="px-4 py-4 text-gray-700">One edge raised, slab domed</td>
                    <td class="px-4 py-4 text-gray-700">Clay soil, water, frost</td>
                    <td class="px-4 py-4 text-gray-700">Drainage and soil work, then fill</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Settlement</td>
                    <td class="px-4 py-4 text-gray-700">One edge dropped, hollow sound</td>
                    <td class="px-4 py-4 text-gray-700">Poor fill, washout, trench</td>
                    <td class="px-4 py-4 text-gray-700">Fill void or repour, then seal</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wall-floor joint</td>
                    <td class="px-4 py-4 text-gray-700">Gap along the perimeter</td>
                    <td class="px-4 py-4 text-gray-700">Cold joint between pours</td>
                    <td class="px-4 py-4 text-gray-700">Seal if dry, drain if wet</td>
                  </tr>
                </tbody>
              </table>
