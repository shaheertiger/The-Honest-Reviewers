---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best 50 Pint Dehumidifiers",
    "url": "/best-50-pint-dehumidifier/"
  },
  {
    "title": "Best Smart Dehumidifiers",
    "url": "/best-smart-dehumidifier/"
  },
  {
    "title": "GE Dehumidifier Review",
    "url": "/ge-dehumidifier-review/"
  },
  {
    "title": "Best Dehumidifiers With a Pump",
    "url": "/best-dehumidifier-with-pump/"
  },
  {
    "title": "What Size Dehumidifier for a Basement?",
    "url": "/what-size-dehumidifier-for-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "Midea Cube Dehumidifier Review: Which Size, and Is the Pump Worth It";
const description =
  "The Midea Cube 20, 35 and 50 pint compared on ENERGY STAR ratings, bucket weight, drain modes, the 14 ft pump and owner complaints, with who should skip it.";

const PRODUCTS = [
  {
    "id": "midea-cube-35-mad35s1qwt",
    "name": "Midea Cube 35 Pint Dehumidifier (MAD35S1QWT)",
    "badge": "Best Overall",
    "category": "35 Pints/Day, 4.25 Gal Max Bucket, Wi-Fi",
    "amazonUrl": "#",
    "description": "The Cube 35 is the one we would tell most people to buy. It uses the same large bucket as the 50 pint models, with four fill levels from about 2.25 to 4.25 gallons in Midea's manual, and ENERGY STAR lists the current revision at 35.82 pints a day and 378 kWh a year, with the same 2.01 L/kWh efficiency as the 50. Midea rates it for spaces up to 3,500 square feet and lists it at 14.45 by 14.76 by 14.57 inches and 39.62 pounds. It has Wi-Fi control through the SmartHome app, two fan speeds, Set, Max and Continuous modes, auto defrost and auto restart, and drains by bucket, gravity hose or bucketless mode. There is no pump. For a typical damp basement, finished lower level or large living area, this is the right capacity, and it is meaningfully cheaper to run than the 50 when the space does not need it.",
    "pros": [
      "35.82 pints/day per ENERGY STAR (current -A revision)",
      "Same 4.25 gal max bucket as the 50 pint",
      "2.01 L/kWh, the same efficiency as the 50",
      "Nests into its bucket for storage"
    ],
    "cons": [
      "Full bucket weighs about 40.5 lb at level 4",
      "No pump option at this size",
      "Only two fan speeds"
    ],
    "bottomLine": "The right Cube for most homes: the big bucket and full efficiency of the 50, without paying for capacity a typical basement does not need."
  },
  {
    "id": "midea-cube-50-pump-mad50ps1qwt",
    "name": "Midea Cube 50 Pint Dehumidifier with Pump (MAD50PS1QWT)",
    "badge": "Best for No Floor Drain",
    "category": "50 Pints/Day, Built-In Pump, 14 ft Lift",
    "amazonUrl": "#",
    "description": "The pump Cube is the one to buy when your only drain is above the floor. Midea's manual says the pump can push water up to 14 feet above the drain port, enough to reach a utility sink, a window or a laundry standpipe. The pump sits inside the bucket, starts when the water reaches fill level 4 and leaves a little water behind to protect itself, so the manual still asks you to empty the bucket weekly. ENERGY STAR lists the MAD50PS1QWT-A revision at 49.67 pints a day and 515 kWh a year. Midea rates it for 4,500 square feet and lists it at 41.54 pounds. You get everything the plain 50 has, including the app and gravity hose option, plus the pump. The trade-off is one more component that can fail, and pump faults are a recurring theme in owner reviews; keeping the pump filter clean is part of owning it.",
    "pros": [
      "Pump lifts up to 14 ft per Midea's manual",
      "Gravity hose still available if the pump quits",
      "49.67 pints/day per ENERGY STAR",
      "Pump inlet and drain hoses included"
    ],
    "cons": [
      "Still needs the bucket emptied weekly",
      "Pump faults are a common owner complaint",
      "Do not run the hose outdoors at or below 32°F"
    ],
    "bottomLine": "Worth the extra only if gravity drainage is impossible; then it is the most convenient Cube."
  },
  {
    "id": "midea-cube-50-mad50s1qwt-a",
    "name": "Midea Cube 50 Pint Dehumidifier (MAD50S1QWT-A)",
    "badge": "Best for Very Damp Spaces",
    "category": "50 Pints/Day, No Pump, Wi-Fi",
    "amazonUrl": "#",
    "description": "The plain Cube 50 is for genuinely wet basements, open lower levels and households that dry laundry indoors. ENERGY STAR lists the MAD50S1QWT-A at 49.67 pints a day, 2.01 L/kWh and 515 kWh a year, and Midea rates it for up to 4,500 square feet. It shares its 14.5 inch footprint and 4.25 gallon maximum bucket with the 35, and Midea lists it at 41.54 pounds. Without a pump, drainage is by bucket, a gravity hose from the back of the bucket, or bucketless mode on a surface above a drain. In a damp basement running near its rating it will fill even the big bucket in less than a day, so plan on the hose. If your space is only moderately damp, the 35 will do the job with lower running costs; this is the Cube for a space where the 35 would never switch off.",
    "pros": [
      "49.67 pints/day per ENERGY STAR",
      "Same compact footprint as the 35",
      "Garden-hose thread on the drain port",
      "Wi-Fi app and voice assistant support"
    ],
    "cons": [
      "Fills even the large bucket quickly in a wet space",
      "Higher running cost than the 35 (515 vs 378 kWh/yr)",
      "No pump"
    ],
    "bottomLine": "Buy it for a truly wet space with a floor drain nearby; otherwise the 35 is the better Cube."
  },
  {
    "id": "midea-cube-20-mad20s1qwt",
    "name": "Midea Cube 20 Pint Smart Dehumidifier (MAD20S1QWT)",
    "badge": "Best for One Room",
    "category": "20 Pints/Day, 3 Gal Max Bucket, Wi-Fi",
    "amazonUrl": "#",
    "description": "The Cube 20 is the smallest model and the one to buy for a single bedroom, office, guest room or small apartment. ENERGY STAR lists it at 20.16 pints a day and 249 kWh a year, about half the 50's energy use, though at 1.70 L/kWh it is less efficient per pint than the bigger Cubes. Midea rates it for 1,500 square feet and lists it at 13.5 by 13.5 by 13.39 inches and 33.07 pounds. Its bucket is smaller than the 35 and 50's, with fill levels from about 1.5 to 3 gallons, or up to roughly 29.5 pounds of water. It has the same app, modes and drain options as the larger models, without a pump. It is a real compressor dehumidifier, not a mini unit, so it is more machine than a closet needs. Tom's Guide reported it pulled a room down to its target quickly but noted a metallic hum.",
    "pros": [
      "Smallest, lightest Cube at 33.07 lb",
      "249 kWh/yr per ENERGY STAR",
      "Up to 3 gal bucket, large for its size",
      "Same app and drain modes as larger Cubes"
    ],
    "cons": [
      "Less efficient per pint (1.70 L/kWh)",
      "Too small for a whole damp basement",
      "Reviewers report a metallic hum"
    ],
    "bottomLine": "The right Cube for one room; for a basement, step up to the 35."
  },
  {
    "id": "midea-mad50c1aws-a",
    "name": "Midea 50 Pint Dehumidifier (MAD50C1AWS-A)",
    "badge": "Non-Cube Alternative",
    "category": "50 Pints/Day, Conventional Upright, No Pump",
    "amazonUrl": "#",
    "description": "This is Midea's conventional 50 pint dehumidifier, and it is here because it is the honest alternative to the Cube. ENERGY STAR lists the MAD50C1AWS-A at 49.74 pints a day, 2.01 L/kWh and 525 kWh a year, which is the same drying and essentially the same running cost as the 50 pint Cube. Retailer listings put it at about 24 inches tall and roughly 40 pounds, in a familiar upright shape with a smaller pull-out bucket. What you give up is the Cube's large bucket, fill level control and compact nested storage. We could not confirm from Midea's current pages whether this revision has Wi-Fi, so treat it as a basic machine. If your plan is a hose to a floor drain for the whole season, the Cube's main advantages never come into play, and this is the more sensible buy. Midea also sells a pump version, the MAD50P1AWS-A, with the same ENERGY STAR ratings.",
    "pros": [
      "49.74 pints/day per ENERGY STAR",
      "Same 2.01 L/kWh efficiency as the Cube 50",
      "Upright shape suits a fixed spot by a drain"
    ],
    "cons": [
      "Much smaller bucket than the Cube",
      "Does not nest for storage",
      "Wi-Fi not confirmed on this revision"
    ],
    "bottomLine": "If you will drain by hose all season, this does the Cube 50's job without paying for the Cube's bucket."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Midea Cube Dehumidifier Review",
          item: "https://www.thehonestreviewers.com/midea-cube-dehumidifier-review/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which Midea Cube size should I buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most basements and living areas, the 35 pint. It shares the 50's 4.25 gallon bucket and 2.01 L/kWh efficiency but uses less power, at 378 kWh a year against 515 in ENERGY STAR's figures. Choose the 20 for a single room and the 50 for genuinely wet spaces or indoor laundry drying."
          }
        },
        {
          "@type": "Question",
          "name": "How much water does the Midea Cube bucket hold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Midea's manual lists four fill levels. The Cube 20 holds about 1.5, 2, 2.75 or 3 gallons. The 35 and 50 pint models hold about 2.25, 3, 3.75 or 4.25 gallons, which weighs about 40.5 pounds at the top level. You choose the level with the fill level button to keep the bucket liftable."
          }
        },
        {
          "@type": "Question",
          "name": "How high can the Midea Cube pump push water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Midea's owner's manual for the MAD50PS1QWT says the pump can lift water up to 14 feet above the drain port. That reaches most utility sinks, laundry standpipes and basement windows. The pump starts when the bucket reaches fill level 4, and the manual says to empty the bucket weekly even in pump mode."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Midea Cube loud?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Midea's manual does not publish a noise rating. A Home Depot listing gives 45 dB for the Cube 20, Tom's Guide reported around 55 decibels for the same model, and HouseFresh measured 54.2 dBA at three feet on high. Expect typical compressor noise on high and noticeably less on low; it has only two fan speeds."
          }
        },
        {
          "@type": "Question",
          "name": "Does the Midea Cube work in a cold basement or garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only down to 41 degrees Fahrenheit. Midea's manual rates it for rooms between 41 and 95 degrees, and says coils can frost at lower temperatures, which reduces performance. Auto defrost helps near the bottom of that range, but for an unheated garage or crawl space in winter, look at units built for cold operation."
          }
        },
        {
          "@type": "Question",
          "name": "What app does the Midea Cube use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Midea's SmartHome app on iOS and Android. It shows room humidity and lets you change the target, fan speed and power from your phone, and Midea advertises voice assistant support. The wireless module runs on 2.4 GHz only, so if your router merges 2.4 and 5 GHz under one name, setup can take some fiddling."
          }
        },
        {
          "@type": "Question",
          "name": "What warranty does the Midea Cube have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One year of full coverage from the original purchase date, according to the warranty in Midea's Cube manual, with service through Midea Consumer Services at 1-866-646-4332. That is shorter than some rivals, and because owners report some failures around the one to two year mark, keep the receipt and register the unit."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

