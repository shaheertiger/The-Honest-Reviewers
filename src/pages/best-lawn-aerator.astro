---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Grass Seed",
    "url": "/best-grass-seed/"
  },
  {
    "title": "Best Fertilizer for Grass",
    "url": "/best-fertilizer-for-grass/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Zero-Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Weed Killers",
    "url": "/best-weed-killer/"
  },
  {
    "title": "Best Lawn Mower Blades",
    "url": "/best-lawn-mower-blades/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Lawn Aerators That Actually Relieve Compacted Soil";
const description =
  "Seven lawn aerators compared, from tow-behind plug aerators to a manual corer and liquid options, plus core vs spike, timing, soil moisture and overseeding after.";

const PRODUCTS = [
  {
    "id": "agri-fab-45-0299-plug-aerator",
    "name": "Agri-Fab 45-0299 48-Inch Tow Plug Aerator",
    "category": "48-Inch Tow-Behind Plug Aerator",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1500,
    "pros": [
      "48-inch working width with 32 galvanized plugging knives",
      "Rated to 3 inches of penetration on well-prepared soil",
      "Weight tray takes up to 175 lb of added weight for hard ground",
      "Cantilever transport handle raises and lowers the tines from the tractor seat",
      "Universal hitch and 10-inch flat-proof tires"
    ],
    "cons": [
      "Agri-Fab calls for a lawn tractor of 9 HP or more to pull it",
      "About 93 lb assembled before you add any weight, so it is awkward to store and move by hand"
    ],
    "bottomLine": "The tow-behind plug aerator we would buy for a half-acre or larger lawn: wide, heavy enough to load properly, and easy to lift from the seat.",
    "description": "The Agri-Fab 45-0299 is a rolling plug aerator, which means it pulls short cores with curved hollow knives rather than punching holes with solid spikes. Agri-Fab lists 32 galvanized knives across a 48-inch working width and up to 3 inches of penetration. That width is the main reason it earns the top spot: on a big lawn, a 48-inch aerator needs noticeably fewer passes than a 40-inch one, and aeration works best when you cover the lawn twice in a crisscross pattern. The weight tray matters more than any other feature on a tow-behind aerator. An empty rolling aerator rides on top of firm soil and barely scratches it. The 45-0299 takes up to 175 lb of added weight, which is enough for three or four concrete blocks or several sandbags and makes the difference between shallow dimples and real plugs. The cantilever transport handle lets you raise the tines from the tractor seat to cross a driveway or turn at the end of a row, and the 10-inch flat-proof tires will not leave you with a flat at the start of the season. Agri-Fab says it needs a tractor of 9 HP or more, and backs it with a 3-year limited warranty. Set expectations correctly: like every spoon-style tow aerator, it pulls shallower, less uniform plugs than a rented gas core aerator on dry clay. Water first, load it up and make two passes."
  },
  {
    "id": "brinly-pa-40bh-plug-aerator",
    "name": "Brinly PA-40BH 40-Inch Tow-Behind Plug Aerator",
    "category": "40-Inch Tow-Behind Plug Aerator",
    "badge": "Best for Zero-Turns",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1800,
    "pros": [
      "24 heat-treated steel plugging spoons rated to 3 inches deep",
      "Enclosed steel weight tray takes up to 150 lb of added weight",
      "Each plugging spoon is individually replaceable",
      "Built for lawn tractors and zero-turn mowers",
      "Transport wheels engage for crossing drives and paths"
    ],
    "cons": [
      "Assembly takes a while, commonly around an hour or more",
      "Narrower 40-inch path means more passes on a big lawn"
    ],
    "bottomLine": "The best fit for smaller tractors and zero-turns on quarter- to half-acre lawns, and the easiest to keep running because every spoon is replaceable.",
    "description": "Brinly has been making tow-behind lawn attachments for a long time, and the PA-40BH is its mainstream plug aerator. It carries 24 heat-treated 16-gauge steel spoons that Brinly rates to 3 inches of penetration, with an enclosed steel weight tray that takes up to 150 lb of additional weight for compacted soil or hard clay. We like it for a specific kind of owner: someone with a zero-turn or a smaller lawn tractor and a lawn in the quarter- to half-acre range. The 40-inch width is easier to steer around beds and trees than a 48-inch unit, and it does not need a big tractor to pull it once loaded. The feature that matters over years of ownership is the individually replaceable spoons. On stony ground, spoons bend and wear, and on many cheaper aerators that means replacing a whole tine section or the entire shaft. Here you replace one spoon. Transport wheels engage with a lever, so you can cross a driveway or sidewalk without dragging the tines over concrete. The honest downsides are the assembly, which buyers commonly report taking an hour or more, and the fact that it shares the limits of every spoon aerator: it needs moist soil and real weight in the tray to pull full plugs. Treat 3 inches as the best case, not the typical result on dry clay."
  },
  {
    "id": "brinly-pa-48bh-plug-aerator",
    "name": "Brinly PA-48BH 48-Inch Tow-Behind Plug Aerator",
    "category": "48-Inch Tow-Behind Plug Aerator",
    "badge": "Best for Heavy Clay",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "32 heat-treated steel tines pulling plugs up to 3 inches",
      "Weight tray accepts up to 200 lb of added weight, the most of our tow picks",
      "Four tine sections rotate independently, so turns tear the turf less",
      "Individually replaceable plugging spoons",
      "Never-flat transport wheels on a side lever"
    ],
    "cons": [
      "Needs a tractor with enough weight and traction to pull it fully loaded",
      "Sits at the top of the price range for homeowner tow aerators"
    ],
    "bottomLine": "The tow-behind to buy for stubborn clay, where the extra 200 lb of weight capacity is what gets tines into the ground.",
    "description": "The PA-48BH is Brinly's larger plug aerator, and the reason to choose it over the Agri-Fab is weight. Brinly rates the fully enclosed steel tray for up to 200 lb of added weight, the most of any tow-behind here, and on heavy clay that extra load is the difference between pulling plugs and bouncing across the surface. It carries 32 heat-treated steel tines across 48 inches, rated to 3-inch plugs. The design detail we like most is the four separately welded tine sections that rotate independently. A single solid shaft drags and twists the turf when you turn; independent sections let the inside and outside of the aerator roll at different speeds, so corners and curves do far less damage. Like the smaller PA-40BH, each plugging spoon is individually replaceable, which keeps long-term maintenance cheap. Never-flat transport wheels engage with a side lever for crossing hard surfaces. The catch with any heavily weighted aerator is the tractor. Two hundred pounds of blocks plus the aerator itself is a real load, and a light zero-turn can lose traction on slopes or wet grass. If you have the machine for it, this is the most effective homeowner tow aerator we can recommend for clay. If your tractor is small, the PA-40BH is the better match. Brinly also points out that the plugs themselves carry soil microbes, so leave them on the lawn to break down."
  },
  {
    "id": "yard-butler-id-6c-core-aerator",
    "name": "Yard Butler ID-6C Manual Lawn Coring Aerator",
    "category": "Manual Two-Tine Core Aerator",
    "badge": "Best Manual Aerator",
    "amazonUrl": "#",
    "rating": 4.1,
    "reviewCount": 5000,
    "pros": [
      "Pulls two real cores, about 1/2 inch wide and 3-1/2 inches deep, per step",
      "Powder-coated steel with a foot bar for leverage",
      "Light enough to carry anywhere and hang on a wall",
      "Ideal for dog runs, paths and patches a machine cannot reach",
      "No tractor, rental or fuel needed"
    ],
    "cons": [
      "Slow and tiring: a thousand square feet at 6-inch spacing is roughly two thousand steps",
      "Cores can stick in the tubes in sticky clay and need clearing"
    ],
    "bottomLine": "The only manual aerator we recommend, because it actually pulls cores, but it is a tool for small areas and problem spots, not a whole lawn.",
    "description": "The Yard Butler ID-6C is a simple steel frame with two hollow coring tubes at the bottom, a foot bar and a pair of cushioned grips on top. You set it down, step on the bar and pull it up, and it removes two plugs about 1/2 inch in diameter and 3-1/2 inches deep. That depth is better than most tow-behind aerators achieve on firm soil, which is the whole point: this is a real core aerator, not a spike tool dressed up as one. Each new step pushes the previous cores out of the top of the tubes. What it is not is fast. At 6-inch spacing, a square foot needs four holes, so every thousand square feet takes around two thousand steps. That is a long afternoon for a small front lawn and not a sensible plan for a quarter acre. Where it shines is targeted work: the worn strip along a fence where the dog runs, the path the kids cut across the lawn, compacted soil around a tree where a machine cannot go, or a small city lawn that never justifies a rental. In sticky clay, plugs sometimes jam inside the tubes; a screwdriver or a stick clears them. Moist soil makes it dramatically easier, as with every aerator. The steel is powder-coated and the whole tool is light enough to hang on a garage wall."
  },
  {
    "id": "jonathan-green-love-your-soil",
    "name": "Jonathan Green Love Your Soil",
    "category": "Granular Gypsum and Humate Soil Amendment",
    "badge": "Best Soil Amendment",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1500,
    "pros": [
      "Gypsum-based amendment with humates, sold to loosen hard, compacted soil",
      "One 15.5 lb bag treats up to 5,000 sq ft of established lawn",
      "Applied with an ordinary broadcast or drop spreader",
      "Adds calcium and sulfur without changing soil pH much",
      "Pairs well with core aeration, since granules can fall into the holes"
    ],
    "cons": [
      "Works gradually over a season, not overnight",
      "Gypsum does most for sodic or salt-affected soil; ordinary clay responds less dramatically"
    ],
    "bottomLine": "A sensible add-on after core aeration on clay, especially along salted drives and walks, but not a substitute for pulling plugs.",
    "description": "Love Your Soil is Jonathan Green's granular soil amendment for hard, compacted ground. The label analysis is 21 percent calcium, 3.8 percent sulfur and 1 percent iron, from gypsum plus humates, and one 15.5 lb bag covers up to 5,000 square feet of established lawn or 2,500 square feet when preparing new ground. The pitch is that it loosens clay, feeds soil microbes and builds humus over time. The honest reading of that is useful rather than magical. Gypsum improves structure most clearly where sodium is the problem, which is common along driveways, sidewalks and roads that get de-icing salt and on some arid-region soils. There it can make a real difference. On ordinary clay without a sodium issue, research shows smaller effects, and the humate portion works slowly by supporting soil life. That is why we treat it as a partner to core aeration rather than an alternative. The best time to apply it is right after aerating, when a share of the granules can fall into the open holes, and it spreads with the same broadcast spreader you use for fertilizer and seed. Because it is calcium rather than lime, it does not raise pH much, which makes it safe to use on lawns that are already neutral or alkaline. Expect results over a season, not a week."
  },
  {
    "id": "simple-lawn-solutions-soil-loosener",
    "name": "Simple Lawn Solutions Liquid Soil Loosener",
    "category": "Liquid Aerator, 32 oz",
    "badge": "Best Liquid Aerator",
    "amazonUrl": "#",
    "rating": 4.1,
    "reviewCount": 2500,
    "pros": [
      "32 oz bottle rated to cover up to 32,000 sq ft",
      "Helps water move down into tight soil and reduces puddling",
      "Nothing to rent, tow or push, and no plugs on the lawn",
      "Suitable for all grass types",
      "Can be used alongside core aeration"
    ],
    "cons": [
      "Does not create physical channels, so it cannot replace core aeration on compacted ground",
      "Must go down at least 4 weeks before seeding because it can reduce germination"
    ],
    "bottomLine": "A reasonable maintenance product for lawns with drainage and runoff problems, as long as you do not expect it to do what a core aerator does.",
    "description": "Liquid aerators are the most oversold products in lawn care, so we picked the one whose own instructions are most honest about how it should be used. Simple Lawn Solutions' Liquid Soil Loosener is a 32 oz concentrate that the company rates for up to 32,000 square feet, aimed at compacted soil, standing water and poor drainage. Products like this act mainly as soil conditioners and wetting agents: they help water soak down into tight soil rather than running off or sitting on top, and over time that can support deeper roots. What they cannot do is remove soil. A core aerator physically pulls plugs, which gives compacted soil somewhere to expand into and opens a direct path for air, water and seed. No liquid does that, and anyone telling you a bottle replaces aeration on heavy, trafficked clay is overselling it. Where a liquid makes sense is on lawns with runoff or puddling that are not badly compacted, on slopes where towing an aerator is unsafe, or as a follow-up between core aerations. Pay attention to the timing rules on the label: water the lawn for about 20 minutes within 24 hours of applying, apply at least 4 weeks before seeding because it can reduce germination, and at least 2 weeks before fertilizer. That seeding gap is the detail most buyers miss."
  },
  {
    "id": "agri-fab-45-0543-spiker-seeder",
    "name": "Agri-Fab 45-0543 Tow Spiker/Seeder/Spreader",
    "category": "32-Inch Tow Spike Aerator with 100 lb Hopper",
    "badge": "Best for Seeding Loose Soil",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 700,
    "pros": [
      "Spikes, seeds or spreads in a single pass",
      "32-inch working width with galvanized steel spike disks",
      "100 lb hopper for seed or granular products",
      "Large flat-free tires and a steel lift handle",
      "Useful for seed-to-soil contact when overseeding loose or sandy soil"
    ],
    "cons": [
      "Spikes push soil aside instead of removing it, so it does not relieve compaction",
      "Narrower than the plug aerators, so big lawns take more passes"
    ],
    "bottomLine": "Worth buying only as an overseeding tool for loose or sandy soil; on compacted clay, buy a plug aerator instead.",
    "description": "We include one spike tool on this list, and we want to be precise about why. The Agri-Fab 45-0543 combines a row of galvanized steel spike disks with a 100 lb hopper, so it can open the surface and drop seed or granular product in the same pass across a 32-inch width. On loose, sandy or loamy soil that is not compacted, that is genuinely useful at overseeding time. The spikes break the surface and create small pockets where seed settles and makes contact with soil, which is what seed needs to germinate. It also works as a tow spreader on its own. What it will not do is fix compacted ground. A spike pushes soil sideways and down as it enters, so on clay each hole is surrounded by soil that is now packed tighter than before, and the holes close back up quickly. That is the main reason extension services recommend core aeration over spiking for compaction. So if your lawn is hard, drains poorly or grows thin where people walk, start with a plug aerator, then consider this for seeding. If your soil is sandy and your goal is simply to get seed into contact with the ground in autumn, it is an efficient single-pass tool. The large flat-free tires and a steel lift handle for raising the spikes are practical touches."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Lawn Aerators",
          item: "https://www.thehonestreviewers.com/best-lawn-aerator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best type of lawn aerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A core or plug aerator, which pulls plugs of soil out of the lawn. It is the method university extension services recommend for compacted soil, because removing soil gives the surrounding ground room to loosen and opens a direct path for air, water and seed. Spike aerators and liquids have narrower uses and do not relieve real compaction."
          }
        },
        {
          "@type": "Question",
          "name": "Do spike aerator shoes work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for compaction. Spiked shoes push short spikes into the surface, which on firm soil rarely reach more than an inch, and like every spike tool they press soil sideways rather than removing it. On clay that tightens the soil around each hole. They are not worth buying. A manual core aerator is the cheapest tool that genuinely works."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I aerate my lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clay soil or lawns with heavy traffic usually benefit from core aeration once a year. Loamy lawns with light use can go two or three years between aerations. Sandy soil rarely needs it. Use the screwdriver test each season: if a screwdriver will not push 6 inches into moist soil, it is time to aerate again."
          }
        },
        {
          "@type": "Question",
          "name": "Should I aerate before or after dethatching?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you need both, dethatch first, then aerate, then seed and feed. Dethatching clears the matted layer so tines reach soil and seed reaches the ground. On lawns with only moderate thatch, aeration alone is often enough, because the soil in the plugs helps break the thatch down naturally without the stress of dethatching."
          }
        },
        {
          "@type": "Question",
          "name": "Do liquid aerators really work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They work as soil conditioners, helping water soak into tight soil and supporting soil life over time. They do not remove soil or open physical channels, so they cannot do what core aeration does on compacted ground. They are reasonable for drainage and runoff problems or slopes, but check the label; some need a gap of weeks before seeding."
          }
        },
        {
          "@type": "Question",
          "name": "How deep should aeration plugs be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for plugs about 2 to 3 inches long, spaced a few inches apart. Shallower plugs mean the soil was too dry, the tow aerator needs more weight, or the soil is heavy enough to justify renting a gas core aerator. Pull a few plugs early in the job to check before covering the whole lawn."
          }
        },
        {
          "@type": "Question",
          "name": "Is it better to rent an aerator or buy one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy a tow-behind if you own a lawn tractor or zero-turn and have more than about a quarter acre, since it pays for itself over a few seasons and lets you aerate when conditions are right. Rent a gas core aerator if you have no tractor, a very compacted clay lawn, or a small lawn aerated only occasionally."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best lawn aerator",
      "core aerator vs spike aerator",
      "tow behind plug aerator",
      "manual lawn aerator",
      "liquid aeration",
      "when to aerate lawn"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Aerators Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Lawn Aerators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Aeration only works if it pulls soil out of the ground. Here are the plug aerators worth owning, the soil treatments worth adding, and the spike tools most lawns should skip.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#agri-fab-45-0299-plug-aerator"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Core vs Spike
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#core-vs-spike" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Core vs Spike vs Liquid Aeration</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#do-you-need-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Does Your Lawn Need Aerating?</a>
          <a href="#timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. When to Aerate Cool- and Warm-Season Grass</a>
          <a href="#soil-moisture" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Soil Moisture Decides the Result</a>
          <a href="#tow-manual-rent" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Tow-Behind vs Manual vs Renting</a>
          <a href="#how-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. How to Aerate a Lawn Properly</a>
          <a href="#overseeding" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Overseeding and Feeding After Aeration</a>
          <a href="#clay" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Aerating Heavy Clay</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
