const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Heated Driveway Cost",
          item: "https://www.thehonestreviewers.com/heated-driveway-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can you add heat to an existing driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not without replacing it. Heating cables and tubing are embedded in the slab or set in the base below the surface, so most retrofits mean tearing out and repouring. A few electric cable systems can be set into saw-cut grooves in sound existing concrete, but that is a specialized install and not an option for asphalt or cracked slabs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a heated driveway last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The embedded cable or tubing is designed to last as long as the slab around it, often decades, and electric cables commonly carry long manufacturer warranties. Controls, sensors, pumps and boilers wear out sooner and get replaced on their own schedules. Physical damage from cutting, drilling or a failing slab is the most common way an embedded system dies early."
          }
        },
        {
          "@type": "Question",
          "name": "Do heated driveways melt snow instantly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A system starting from a cold slab can take a while to begin melting, and heavy snowfall can outpace it. That is why some controllers offer an idling mode that keeps the slab just above freezing before a forecast storm. Idling melts faster once snow starts but adds run time and cost, so most homes use it only where speed matters."
          }
        },
        {
          "@type": "Question",
          "name": "Is electric or hydronic cheaper to run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hydronic is usually cheaper per storm where natural gas is available at typical prices, because gas heat costs less than electric resistance heat. With propane or expensive gas, the gap narrows or disappears. Electric is cheaper to install and maintain, so for small areas it often wins on total cost even if each storm costs more."
          }
        },
        {
          "@type": "Question",
          "name": "Do heated driveways work in extreme cold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They work, but they work harder. In very cold, windy weather a system loses more heat to the air and melts snow more slowly, and run time goes up. Systems in the coldest regions are designed for higher output per square foot. Ask your installer what conditions the design is sized for and how it performs below about 10 degrees."
          }
        },
        {
          "@type": "Question",
          "name": "Does a heated driveway need a permit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most places, yes. Electric systems need electrical permits and inspections, usually before the slab is poured so the inspector can see the cable. Hydronic systems need permits for the boiler, gas piping and venting. A reputable installer pulls the permits and schedules the inspections; be wary of any quote that suggests skipping them to save time or money."
          }
        },
        {
          "@type": "Question",
          "name": "Can you still use ice melt on a heated driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You should not need it on the heated areas, and avoiding de-icers is one of the benefits. On unheated walkways, steps and edges, use a concrete-safe product sparingly. Avoid piling salty snow from the street or other areas onto the heated slab, since the meltwater still carries chloride into the concrete and can scale the surface over time."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
