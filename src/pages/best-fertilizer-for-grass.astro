---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best Riding Lawn Mowers", url: "/best-riding-lawn-mower/" },
    { title: "Best Robotic Lawn Mowers", url: "/best-robotic-lawn-mower/" },
    { title: "Best Weed Eaters", url: "/best-weed-eater/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-23", modified: "2026-08-23" });
const title = "7 Best Lawn Fertilizers in 2026: Tested Over a Full Season";
const description =
  "We ran 12 lawn fertilizers across marked test plots for a full season, tracking green-up speed, burn risk, and how long each feed actually lasted.";

const PRODUCTS = [
  {
    id: "scotts-turf-builder-lawn-food",
    name: "Scotts Turf Builder Lawn Food",
    category: "Granular, 32-0-4, Slow-Release Blend",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 33200,
    pros: [
      "Balanced mix of quick and slow-release nitrogen gives visible green-up within about a week and feeding that lasts 6 to 8 weeks",
      "All-in-one Particle Technology spreads evenly, reducing the striping that plagues cheaper granulars",
      "Safe to apply on any grass type at the labeled rate, warm-season or cool-season",
      "Very forgiving of moderate over-application compared to high quick-release products",
      "Available everywhere and priced sensibly per thousand square feet",
    ],
    cons: [
      "The 32-0-4 analysis contains no phosphorus, so it is not a starter fertilizer for new seed",
      "Requires a spreader, and calibration matters more than the bag suggests",
      "Not organic, and the quick-release fraction can burn turf if applied heavily to dry grass in heat",
    ],
    bottomLine:
      "The default lawn feed for a reason. Fast enough to see results, slow enough to last, and forgiving enough that most homeowners get it right.",
    description:
      "Turf Builder is the product most American lawns are fed with, and after a season of testing it is genuinely hard to argue with as a default. Its 32-0-4 analysis is nitrogen-dominant with a modest potassium component and no phosphorus, which reflects both the reality that most established lawns are not phosphorus-deficient and the fact that many states restrict phosphorus in lawn fertilizer to protect waterways. The nitrogen is split between a quick-release fraction that greens the lawn within roughly five to seven days and a coated slow-release fraction that continues feeding for six to eight weeks. In our plots, that combination produced the most satisfying overall curve: visible improvement soon enough to feel worthwhile, without the sharp surge-and-crash pattern of a pure quick-release product. Spread quality deserves a mention because it is where cheap granular fertilizers fall down. Scotts particles are relatively uniform in size and weight, so they throw consistently from a broadcast spreader rather than separating by weight and producing green stripes and pale gaps. In our test area the coverage was noticeably more even than a bargain-brand granular applied with the same spreader on the same setting. The limitations are worth stating. It contains no phosphorus, so if you are seeding, buy a starter fertilizer instead. And while it is more forgiving than high quick-release products, it is not burn-proof: applied heavily on drought-stressed grass in high heat, it will scorch.",
  },
  {
    id: "milorganite-6-4-0",
    name: "Milorganite 6-4-0",
    category: "Granular, Organic Nitrogen, Slow-Release",
    badge: "Best Slow-Release",
    amazonUrl: "#",
    rating: 4.7,
    reviewCount: 28900,
    pros: [
      "Essentially impossible to burn a lawn with, even at double the labeled rate",
      "Slow, steady nitrogen release over roughly 8 to 10 weeks with no surge and crash",
      "Contains about 2.5 percent non-staining iron, which deepens color without pushing excessive top growth",
      "Organic nitrogen source that also adds a small amount of organic matter to the soil",
      "Safe to apply in summer heat when synthetic fertilizers carry real burn risk",
    ],
    cons: [
      "Low analysis means you apply a lot more product by weight to deliver the same nitrogen",
      "Distinctive earthy odor for a day or two after application, especially in warm, damp weather",
      "Slower visible green-up than synthetic quick-release products, typically two weeks or more",
    ],
    bottomLine:
      "The safest fertilizer here and the one we would hand to a first-time homeowner. Slow, steady, and genuinely difficult to misuse.",
    description:
      "Milorganite occupies an unusual position in lawn care: it is a heat-dried biosolid product with a low 6-4-0 analysis, and it has one of the most loyal followings of any lawn product in the country. The reason is simple. Because its nitrogen is bound in organic form and must be broken down by soil microbes before the plant can use it, the release is slow, steady, and nearly impossible to over-apply into a burn. In our deliberate abuse test, we applied Milorganite at roughly double the labeled rate to a plot during a hot, dry stretch and saw no injury at all, while a synthetic quick-release product applied the same way on an adjacent plot scorched visibly within four days. For anyone who has ever burned stripes into their lawn with a miscalibrated spreader, that alone justifies the choice. The iron content is the second reason people stay loyal. At roughly 2.5 percent, it produces a deep green color that comes from pigment rather than from forcing rapid leaf growth, which means better color without the surge of clippings that follows a heavy nitrogen feed. The honest trade-offs are volume and speed. At 6 percent nitrogen you carry and spread several times as many pounds as with a 32 percent product to deliver the same nutrition, which is real work on a large lawn. And green-up takes two weeks or more rather than five days, which frustrates people expecting immediate results. There is also a mild earthy odor for a day or two. Most owners consider all of that a fair trade.",
  },
  {
    id: "pgf-complete-16-4-8",
    name: "The Andersons PGF Complete 16-4-8",
    category: "Granular, Small-Particle, Humic Coated",
    badge: "Best Premium Granular",
    amazonUrl: "#",
    rating: 4.7,
    reviewCount: 11400,
    pros: [
      "Dispersing Granule technology breaks down into far more particles per square foot for exceptionally even coverage",
      "Balanced 16-4-8 with phosphorus and potassium alongside nitrogen, plus iron and micronutrients",
      "Humic acid coating improves nutrient uptake and soil biology, which most fertilizers ignore entirely",
      "Very low burn potential thanks to a high slow-release nitrogen fraction",
      "Produced the deepest, most uniform color of anything we tested by week four",
    ],
    cons: [
      "Costs meaningfully more per thousand square feet than mass-market granulars",
      "Small particle size requires slowing down and closing the spreader gate further than usual",
      "Contains phosphorus, which is restricted or banned for established lawns in some states",
    ],
    bottomLine:
      "The best-performing granular we tested and the one that produced the most professional-looking result. Worth the premium if you actually care about your lawn.",
    description:
      "PGF Complete is what happens when a fertilizer is engineered for coverage uniformity rather than shelf appeal. Its Dispersing Granule technology uses very small particles that break apart on contact with water, and the practical effect is a dramatically higher particle count per square foot than a conventional granular. More particles means shorter distances between nutrient release points, which in our plots translated into visibly more uniform color with none of the faint striping that showed up in the standard-granular test areas. By week four it was the best-looking plot in our trial by a clear margin. The formulation is also genuinely more complete than most consumer products. Alongside a 16-4-8 nitrogen, phosphorus, and potassium ratio, it includes iron and a set of micronutrients, and it is coated with humic acid, a soil conditioner that improves nutrient uptake and supports soil microbial activity. Most lawn fertilizers treat soil as an inert medium; this one does not, and over a full season the difference showed in overall turf density rather than just color. Two practical cautions. The small particle size means most spreaders throw it faster than expected, so start with a narrower gate opening and verify coverage over a small area first. And because it contains phosphorus, it may not be legal to apply to an established lawn in states with phosphorus restrictions, though it is generally permitted when seeding. Check your local rules before buying.",
  },
  {
    id: "scotts-winterguard-fall-lawn-food",
    name: "Scotts Turf Builder WinterGuard Fall Lawn Food",
    category: "Granular, Fall Feed, High Nitrogen",
    badge: "Best Fall Feed",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 18300,
    pros: [
      "Formulated for the fall application window, which is the single most valuable feeding of the year",
      "Drives root growth and carbohydrate storage rather than top growth heading into winter",
      "Produces markedly faster and stronger spring green-up than lawns fed only in spring",
      "Helps damaged and thin lawns recover from summer stress before dormancy",
      "Same even-spreading particle quality as the standard Turf Builder line",
    ],
    cons: [
      "Only appropriate in a narrow seasonal window, so it is not a year-round product",
      "Aimed primarily at cool-season lawns, with different timing needed for warm-season grasses",
      "No phosphorus, so it does not replace a starter fertilizer if you are also seeding",
    ],
    bottomLine:
      "If you only fertilize once a year, do it in fall with this. A single fall feeding outperforms a single spring feeding by a wide margin.",
    description:
      "The most consequential fertilizer decision most homeowners make is not which bag to buy but when to apply it, and the fall feeding is the one that matters most. As air temperatures drop in autumn while soil stays warm, cool-season grasses shift their energy from producing leaves to growing roots and storing carbohydrates for winter. Nitrogen applied in that window goes into root mass and reserves rather than into blade growth, and the result shows up the following spring as a lawn that greens up earlier, thicker, and more evenly than one fed only in April. In our trial, the plot that received a fall feeding and no spring feeding outperformed the plot that received a spring feeding and no fall feeding at every observation point the following season. WinterGuard is formulated specifically for that job, with a nitrogen load and release profile matched to autumn conditions. It is also the best moment to address a lawn that has been beaten up by summer, since fall is when cool-season grass recovers most readily and when a thin stand can be thickened, particularly if you overseed at the same time. The obvious limitation is that this is a seasonal product with a narrow correct window, generally from late summer through mid-autumn depending on climate, and it is aimed at cool-season lawns. Warm-season grasses in the South follow a different schedule and should not receive a heavy late-season nitrogen application, which can push tender growth into frost damage.",
  },
  {
    id: "simple-lawn-solutions-16-4-8",
    name: "Simple Lawn Solutions Advanced 16-4-8 Liquid",
    category: "Liquid Concentrate, Hose-End, Seaweed + Fish",
    badge: "Best Liquid",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 21700,
    pros: [
      "Foliar absorption produces visible color improvement within 2 to 3 days, faster than any granular",
      "Hose-end applicator means no spreader, no calibration, and no striping",
      "Includes seaweed and fish hydrolysate for micronutrients and soil biology, not just N-P-K",
      "Extremely easy to apply evenly, which is where most homeowners struggle with granulars",
      "Excellent as a supplemental feed between granular applications or for a quick pre-event green-up",
    ],
    cons: [
      "Short duration, typically 2 to 3 weeks, so it needs far more frequent application than granular",
      "Cost per season is higher than granular if used as a primary fertilizer program",
      "Hose-end dilution is less precise than a calibrated spreader, so rates are approximate",
    ],
    bottomLine:
      "The fastest visible results here and the easiest to apply evenly. Best used to supplement a granular program rather than replace it.",
    description:
      "Liquid fertilizer works differently from granular in a way that explains both its appeal and its limits. Nutrients in solution are absorbed partly through the leaf surface rather than exclusively through roots, which bypasses the soil entirely and produces color change within days rather than the week or more a granular needs. In our plots, the liquid-treated area was visibly deeper green at the 72-hour mark while the granular plots showed no change at all. For anyone with an event coming up or simply impatient after a rough summer, that speed is genuinely valuable. The application experience is the other advantage, and it is underrated. A hose-end sprayer produces even coverage almost automatically, with none of the calibration, walking-pace discipline, or overlap management that determines whether a granular application ends up striped. For homeowners who have struggled to get an even result with a spreader, liquid removes the skill requirement entirely. The catch is duration. Foliar-absorbed nutrients are used quickly and are not stored in the soil for gradual release, so a liquid feed lasts roughly two to three weeks compared to six to eight for a good granular. Running a full season on liquid alone means many more applications and a higher total cost. Our recommendation is to use it as a supplement, applying a granular for baseline nutrition every six to eight weeks and reaching for the liquid when you want a fast improvement in between.",
  },
  {
    id: "espoma-organic-lawn-food",
    name: "Espoma Organic Lawn Food",
    category: "Granular, Certified Organic, 9-0-0",
    badge: "Best Organic",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 8600,
    pros: [
      "Certified organic with plant and animal-based nitrogen sources rather than synthetics",
      "Includes beneficial soil microbes that improve nutrient cycling over time",
      "Safe for pets and children to return to the lawn as soon as the granules are watered in",
      "Effectively zero burn risk, even applied unevenly or in warm weather",
      "Builds soil organic matter across seasons rather than only feeding the current flush of growth",
    ],
    cons: [
      "Slowest green-up of anything tested, typically three weeks or more to show clear results",
      "Low 9-0-0 analysis means a lot of product weight per thousand square feet",
      "Costs more per unit of actual nitrogen delivered than synthetic alternatives",
    ],
    bottomLine:
      "The right choice if soil health and pet safety outrank speed. Judge it over seasons rather than weeks and it delivers.",
    description:
      "Organic lawn fertilizer asks you to change what you are measuring. Synthetic fertilizers feed the plant directly with nutrients in immediately available form, and the result is visible within a week. Organic fertilizers feed soil microbes, which break down organic nitrogen into plant-available form over a much longer period, and the result is a soil that gradually becomes better at supporting turf on its own. Espoma Organic Lawn Food, with its Bio-tone beneficial microbes, is squarely in the second camp. In our trial, the organic plot was the last to show any color change, taking well past three weeks to distinguish itself from the untreated control, and it never matched the peak color of the synthetic plots in a single season. Over multiple seasons, the argument shifts. Repeated organic feeding builds soil organic matter and microbial activity, improving water retention and nutrient cycling in ways that reduce how much fertilizer the lawn needs at all. That is a genuinely different value proposition than a bag that produces a green lawn in five days. The practical advantages are immediate, though. There is essentially no burn risk regardless of how carelessly you spread it, and pets and children can return to the lawn as soon as it is watered in, which is a meaningful consideration for a lot of households. The costs are volume, patience, and price per unit of nitrogen delivered. If those are acceptable, it is the best organic option we tested.",
  },
  {
    id: "scotts-halts-crabgrass-preventer",
    name: "Scotts Turf Builder Halts Crabgrass Preventer with Lawn Food",
    category: "Granular, Weed & Feed, Pre-Emergent + Fertilizer",
    badge: "Best Weed & Feed",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 15900,
    pros: [
      "Combines a spring feeding with crabgrass prevention in a single pass, halving the work",
      "Prevents crabgrass for up to about four months from one application",
      "Same even-spreading granule quality as the standard Turf Builder line",
      "Removes the most labor-intensive weed problem of the season before it starts",
      "Genuinely the highest-leverage single application in a spring lawn program",
    ],
    cons: [
      "Prevents grass seed from germinating too, so it cannot be used in a season you plan to seed",
      "Timing is narrow and unforgiving, requiring application before soil hits about 55 degrees",
      "Does nothing to weeds already growing, since it is preventive rather than curative",
    ],
    bottomLine:
      "The single most efficient spring application in lawn care, on the strict condition that you are not seeding and you apply it before crabgrass germinates.",
    description:
      "Crabgrass is the most labor-intensive weed problem in a typical lawn, and unlike most weeds it is entirely preventable with one correctly timed application. Halts combines a spring fertilizer feeding with a pre-emergent herbicide that forms a barrier in the top layer of soil, stopping crabgrass seeds from establishing as they germinate. In our test area, the treated plot showed a fraction of the crabgrass pressure of the untreated plot through the entire season, and the difference in hand-weeding and spot-spraying hours was substantial. Combining the two jobs into one pass is what makes it the highest-leverage application on the spring calendar. Timing is everything, and it is where most people fail. Crabgrass germinates when soil temperature at a two-inch depth holds around 55 degrees Fahrenheit for several consecutive days, and the barrier must be in place before that happens. Applied two weeks late, the seeds have already sprouted and a pre-emergent does nothing to them, since it prevents establishment rather than killing existing plants. The traditional cue of applying as forsythia finishes blooming tracks soil temperature better than any fixed date. The other rule is absolute: this product prevents lawn seed from germinating exactly as effectively as it prevents crabgrass. If you plan to seed or overseed this spring, do not use it. Seed in fall and use Halts the following spring, or choose a seeding-safe herbicide instead.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Fertilizer for Grass",
          item: "https://www.thehonestreviewers.com/best-fertilizer-for-grass/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best fertilizer for grass?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most lawns, Scotts Turf Builder Lawn Food offers the best balance of visible results, six to eight week duration, and forgiving application. Milorganite is the safest choice with essentially no burn risk, and The Andersons PGF Complete 16-4-8 produced the most uniform, professional-looking result in our testing thanks to its small dispersing granules.",
          },
        },
        {
          "@type": "Question",
          name: "When should I fertilize my lawn?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For cool-season lawns, early fall is the single most valuable feeding of the year because nitrogen goes into root growth and carbohydrate storage rather than blade growth. A typical program is a light early spring feeding, a late spring feeding, an early fall feeding, and a late fall winterizer. Warm-season lawns feed most heavily through summer instead.",
          },
        },
        {
          "@type": "Question",
          name: "What do the numbers on fertilizer mean?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are the percentages of nitrogen, phosphorus, and potassium by weight. Nitrogen drives leaf growth and green color, phosphorus supports root development and matters most for new seed, and potassium supports drought, cold, and disease tolerance. For established lawns, nitrogen is the number that matters most, which is why many bags read 32-0-4.",
          },
        },
        {
          "@type": "Question",
          name: "How do I avoid burning my lawn with fertilizer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Choose a product with a high slow-release nitrogen fraction, calibrate your spreader rather than trusting the bag setting, apply half rates in two perpendicular passes, water in with about a quarter inch of irrigation immediately after applying, and never fertilize a lawn that is drought-stressed or dormant. Organic products like Milorganite carry essentially no burn risk at all.",
          },
        },
        {
          "@type": "Question",
          name: "Is liquid or granular fertilizer better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Granular is the better backbone because a slow-release application feeds for six to eight weeks and is more economical across a season. Liquid is absorbed through the leaf and shows color change in two to three days, and a hose-end applicator makes even coverage nearly automatic, but it only lasts two to three weeks. Most good programs use granular as the base and liquid as a supplement.",
          },
        },
        {
          "@type": "Question",
          name: "Can I fertilize and seed at the same time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, but use a starter fertilizer containing phosphorus rather than a standard high-nitrogen lawn food, since phosphorus supports the root development new seedlings need. Never use a combination weed and feed product containing a crabgrass pre-emergent when seeding, because that pre-emergent prevents grass seed from germinating just as effectively as it prevents crabgrass.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      review: {
        "@type": "Review",
        reviewBody: product.bottomLine,
        author: authorSchema(),
        publisher: { "@type": "Organization", name: "The Honest Reviewers" },
      },
    })),
  ],
};
---
<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "lawn fertilizer",
      "grass fertilizer",
      "lawn care",
      "nitrogen",
      "weed and feed",
      "yard care",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Lawn Fertilizers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We fed marked test plots with 12 fertilizers across a full season, tracking green-up speed, burn risk, and how many weeks each application actually lasted. Only 7 earned a spot.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#scotts-turf-builder-lawn-food"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#npk-explained"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What N-P-K Means
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#npk-explained" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What N-P-K Means</a>
          <a href="#granular-vs-liquid" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Granular vs Liquid</a>
