import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Exterior Caulk", url: "/best-exterior-caulk/" },
    { title: "How to Remove Old Caulk", url: "/how-to-remove-old-caulk/" },
    { title: "Where Not to Caulk", url: "/where-not-to-caulk/" },
    { title: "Why Exterior Caulk Keeps Cracking", url: "/why-does-exterior-caulk-keep-cracking/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-08", modified: "2026-09-08" });
const title = "How to Caulk Exterior Windows: A Step-by-Step Guide";
const description =
  "How to caulk exterior windows properly — which joints to seal, which to leave open, backer rod, bead geometry and the tooling technique that makes it look professional.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "How to Caulk Exterior Windows", item: "https://www.thehonestreviewers.com/how-to-caulk-exterior-windows/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Where should you caulk around exterior windows?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Seal the joint where the window frame or trim meets the siding or masonry, down both sides and across the top. Leave the bottom edge of the sill and any weep holes open — those are drainage paths, and sealing them traps water inside the wall rather than keeping it out.",
          },
        },
        {
          "@type": "Question",
          name: "What kind of caulk should I use on exterior windows?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A sealant rated for at least 25 per cent joint movement. If the joint will be painted, use a hybrid polymer or polyurethane; if it stays bare, silicone or a hybrid. Painter's acrylic latex is not adequate on an exterior window joint — it cannot handle the seasonal movement.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need to remove old caulk first?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If it is cracked, loose, or silicone, yes — new sealant will not bond to a failing bead or to cured silicone. If the existing bead is sound, well-adhered acrylic and you are applying a compatible product, you can clean it and caulk over it, though a full replacement always performs better.",
          },
        },
        {
          "@type": "Question",
          name: "What size gap needs backer rod?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Anything deeper than about a quarter inch. Backer rod sets the bead depth so it is roughly half its width, letting it stretch, and it prevents the sealant bonding to the back of the joint — three-sided adhesion is what tears beads apart when the joint moves.",
          },
        },
        {
          "@type": "Question",
          name: "What temperature can you caulk at?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most products want the surface above roughly 40°F and dry, with no rain or frost forecast during the cure window. Late spring and early autumn are ideal. Caulking in strong direct sun is also worth avoiding, because a hot surface skins the bead before it can be tooled.",
          },
        },
        {
          "@type": "Question",
          name: "How long does exterior window caulk last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A quality sealant in a properly formed joint should give 15 to 25 years. Acrylic latex on the same joint often fails within two to five. When a good product fails early, the cause is almost always geometry or preparation — a bead too deep to flex, three-sided adhesion, or a dusty or damp surface.",
          },
        },
        {
          "@type": "Question",
          name: "Should you caulk between the window and the siding or just the trim?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Seal where the trim meets the siding and where the frame meets the trim, on the sides and top. What matters more than the exact line is that water running down the wall cannot get behind the assembly, and that anything which does get in has a route back out at the bottom.",
          },
        },
        {
          "@type": "Question",
          name: "Can you caulk over painted surfaces?",
