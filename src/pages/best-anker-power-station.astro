---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "Jackery vs EcoFlow",
    "url": "/jackery-vs-ecoflow/"
  },
  {
    "title": "Bluetti vs EcoFlow",
    "url": "/bluetti-vs-ecoflow/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "Can a Portable Power Station Run a CPAP?",
    "url": "/can-a-portable-power-station-run-a-cpap/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "Best Home Battery Backup Systems",
    "url": "/best-home-battery-backup-system/"
  },
  {
    "title": "Portable Power Station vs Generator",
    "url": "/portable-power-station-vs-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Anker Power Stations in 2026: SOLIX Models Ranked";
const description =
  "We ranked Anker's SOLIX power stations, from the 288Wh C300X to the 3,840Wh F3800 Plus, on capacity, charging speed, expansion and home backup value.";

const PRODUCTS = [
  {
    "id": "anker-solix-c1000-gen-2",
    "name": "Anker SOLIX C1000 Gen 2",
    "category": "1024Wh LiFePO4, 2000W Output, 49-Minute Recharge",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Rated 2,000W continuous and 3,000W surge, enough for a microwave, coffee maker or small window AC",
      "1,600W AC input refills the battery in about 49 minutes from a wall outlet",
      "Around 24.9 lb, lighter and smaller than the original C1000 despite more output",
      "LiFePO4 chemistry with a 5-year warranty",
      "App control for charge limits, charging speed and scheduling"
    ],
    "cons": [
      "Not expandable: Anker says it does not support the BP1000 or any expansion battery",
      "Fastest charging pulls heavily from one household circuit"
    ],
    "bottomLine": "The best all-round Anker power station for most people: enough power for kitchen appliances and short outages, and it refills in under an hour.",
    "description": "The C1000 Gen 2 is the Anker power station we would hand to someone who just wants the right answer. It stores 1,024Wh in LiFePO4 cells and is rated for 2,000W continuous with 3,000W of surge, which covers almost every single household appliance that plugs into a standard 120V outlet: a full-size refrigerator, a 1,500W space heater on low, a 1,200W microwave, a CPAP with a heated humidifier, or a sump pump in the half-horsepower class. The headline feature is charging. Anker rates the Gen 2 at roughly 49 minutes from empty to full on AC, which works out to about 1,600W of input. That matters more than it sounds: in a rolling blackout or a storm with intermittent power, a battery that refills during a 60-minute window of grid power is a different tool from one that needs six hours. Compared with the original C1000, the Gen 2 gives up about 30Wh of rated capacity but adds 200W of continuous output and drops weight to around 24.9 lb, so one person can carry it from the garage to the kitchen without strain. At a typical 85% usable fraction, the battery delivers about 870Wh, which runs a fridge averaging 120W for roughly seven hours or a 40W CPAP without humidifier for three nights. The one trade-off versus the original is expansion: the Gen 2 does not accept the BP1000 or any other add-on battery, so 1,024Wh is final. The app lets you cap the charge level and slow the charging rate when you do not need speed, which is gentler on the cells. If you want a single unit that handles camping, tailgating and short outages without overthinking it, this is the one to buy."
  },
  {
    "id": "anker-solix-f3800-plus",
    "name": "Anker SOLIX F3800 Plus",
    "category": "3840Wh LiFePO4, 6000W, 120V/240V, Expandable",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "pros": [
      "6,000W continuous output at both 120V and 240V, so it can run a well pump or central-air air handler",
      "3,840Wh base capacity, expandable with BP3800 batteries to about 26.9kWh per unit",
      "Up to 3,200W of solar input through dual high-voltage MPPT inputs",
      "Connects to Anker's Home Power Panel or a transfer switch for circuit-level backup",
      "LiFePO4 cells rated for 3,000+ cycles with a 5-year warranty"
    ],
    "cons": [
      "136.7 lb on wheels, so it is a roll-around unit, not a portable one",
      "A full home kit with panel and expansion batteries costs as much as a standby generator"
    ],
    "bottomLine": "The only Anker that does true home backup: 240V output, huge expansion and fast solar, if you can justify the price and the weight.",
    "description": "The F3800 Plus is Anker's answer to the question most people are really asking when they search for an Anker power plant: can a battery replace a generator for my house? For a lot of homes, yes. It holds 3,840Wh of LiFePO4 and is rated for 6,000W continuous at both 120V and 240V, which means it can run 240V loads like a well pump, a heat pump air handler or an electric dryer that no C-series unit can touch. The Plus refresh raises solar input to 3,200W across two high-voltage MPPT inputs, up from 2,400W on the original F3800, so a roof's worth of portable or rigid panels can genuinely refill it in a day. Expansion is where it pulls away from everything else Anker makes. Each BP3800 battery adds another 3,840Wh, and Anker supports up to six per unit, which reaches roughly 26.9kWh. Link two F3800 Plus units and their batteries, and the system tops out around 53.8kWh, which is whole-home territory for several days. To use it properly you will want Anker's Home Power Panel or the Smart Home Power Kit, which wires selected circuits to the battery and switches automatically, or at minimum a generator inlet and transfer switch installed by an electrician. Budget for that installation. At 136.7 lb it rolls rather than carries, and the BP3800 adds another 72.8 lb per battery. For a 300W average overnight load, the base unit's roughly 3,260 usable watt-hours lasts around 11 hours before solar or expansion takes over."
  },
  {
    "id": "anker-solix-c2000-gen-2",
    "name": "Anker SOLIX C2000 Gen 2",
    "category": "2048Wh LiFePO4, 2400W Output, 800W Solar",
    "badge": "Best for RVs and Longer Outages",
    "amazonUrl": "#",
    "pros": [
      "Twice the C1000's capacity at 2,048Wh with 2,400W continuous and 4,000W peak",
      "Anker rates a full AC recharge in about 58 minutes",
      "Up to 800W of solar input and optional 800W alternator charging for vehicles",
      "Expandable to about 4kWh with the BP2000 Gen 2 battery",
      "Rated for 4,000+ cycles, the longest of the C series"
    ],
    "cons": [
      "Still 120V only, so no 240V well pumps or dryers",
      "About 41.7 lb, so two hands and a short carry are the realistic limit"
    ],
    "bottomLine": "The sweet spot between the C1000 and the F series: real overnight capacity, fast charging and RV-friendly alternator support.",
    "description": "The C2000 Gen 2 fills the gap that used to make the Anker lineup awkward. Before it, you either bought a 1kWh C-series unit or jumped to a 3,000Wh-plus F-series machine that weighs as much as a large dog. The C2000 Gen 2 stores 2,048Wh of LiFePO4 and is rated for 2,400W continuous with a 4,000W peak, so it handles a refrigerator, a chest freezer and a furnace blower together during an outage, or an RV's microwave and roof fan when you are off hookups. Anker rates it for a full AC recharge in roughly 58 minutes, and solar input reaches 800W, which on a clear day can refill most of the battery in three to four hours of good sun. For van and RV owners the more interesting option is the 800W alternator charger accessory, which tops it up while you drive without the slow trickle of a 12V cigarette socket. Expansion is optional: the BP2000 Gen 2 battery doubles capacity to about 4kWh, enough for a couple of days of fridge, lights and phones. Anker rates the cells for 4,000 cycles, so even daily cycling would take more than a decade to reach the 80% capacity mark. At about 85% usable, the base unit delivers roughly 1,740Wh, enough to run a 150W-average refrigerator for around 11 hours or a 60W CPAP for most of a week of nights. The one real limit is voltage. It is 120V only, so if your outage priority is a 240V well pump, skip to the F3800 Plus."
  },
  {
    "id": "anker-solix-c1000",
    "name": "Anker SOLIX C1000",
    "category": "1056Wh LiFePO4, 1800W Output, Expandable to 2112Wh",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Frequently discounted well below the Gen 2 now that the newer model is out",
      "1,056Wh capacity, slightly more than the C1000 Gen 2",
      "1,800W continuous and 2,400W surge covers most single appliances",
      "Pairs with the BP1000 expansion battery for 2,112Wh total",
      "600W solar input and a 58-minute UltraFast AC charge mode"
    ],
    "cons": [
      "About 28.4 lb, heavier than the Gen 2",
      "1,800W limit rules out some 1,800W-plus kitchen appliances"
    ],
    "bottomLine": "If you can find the original C1000 on sale, it delivers 95% of the Gen 2's usefulness for noticeably less money.",
    "description": "The original SOLIX C1000 is still one of the best-selling power stations on the market, and the arrival of the Gen 2 has made it a better buy rather than a worse one. Retailers routinely discount it, and on paper it actually holds a little more energy than its replacement: 1,056Wh of LiFePO4 versus 1,024Wh. Output is rated at 1,800W continuous with 2,400W surge, which covers refrigerators, CPAP machines, laptops, TVs, a 1,000W microwave and most power tools. What you give up compared with the Gen 2 is 200W of continuous output, a few pounds of weight (the C1000 is about 28.4 lb) and a little charging speed. Anker's UltraFast mode, enabled in the app, still refills it in about 58 minutes from a wall outlet, which is faster than most competitors' current models. Solar input is rated at 600W through an 11-60V input, so two 200W panels or one 400W panel is the right match. The C1000 also has a documented expansion path: the BP1000 battery adds a second 1,056Wh and brings the total to 2,112Wh, and the BP1000 weighs about 20 lb, so the two pieces stay portable. The C1000X is the same machine in a different finish, usually sold through warehouse clubs and select retailers, so treat the two as interchangeable. At 85% usable, expect around 900Wh in practice, roughly eight hours for a 110W-average fridge. If the price gap between this and the Gen 2 is more than about $100, buy this one."
  },
  {
    "id": "anker-solix-c800-plus",
    "name": "Anker SOLIX C800 Plus",
    "category": "768Wh LiFePO4, 1200W Output, Built-In Camp Light",
    "badge": "Best for Camping",
    "amazonUrl": "#",
    "pros": [
      "Detachable built-in camping light and a pole mount, genuinely useful at a campsite",
      "768Wh is enough for two or three nights of phones, lights, a fan and a 12V cooler",
      "1,200W continuous with a 1,600W surge mode for short spikes",
      "About 24 lb with a fold-down handle",
      "300W solar input and a 58-minute UltraFast AC charge"
    ],
    "cons": [
      "Not expandable, so 768Wh is the ceiling",
      "Too small to be your main outage plan for a refrigerator and a furnace"
    ],
    "bottomLine": "The camper's Anker: smaller than the C1000, with a light and pole mount that make it more useful at a campsite than its spec sheet suggests.",
    "description": "The C800 Plus is the Anker most people should take camping. It stores 768Wh of LiFePO4, is rated for 1,200W continuous, and Anker's surge mode lets it briefly handle loads up to about 1,600W, so an electric kettle or a small induction burner will run as long as you are not also charging an e-bike. The reason it beats a slightly bigger unit for camping is the design. It has a detachable LED camping light built into the top and a mount that lets the light sit on a pole above the table, which replaces the lantern most families pack anyway. At roughly 24 lb it weighs only a little less than the C1000 Gen 2, so this is not an ultralight choice, but the shape and handle are friendlier for a car trunk. Solar input is rated at 300W, which suits a single 200W folding panel well: on a clear day that is enough to replace most of a night's use of lights, phones and a fan. A 50W-average 12V compressor cooler would run for about 13 hours from the roughly 650 usable watt-hours, so pair it with a panel for multi-day trips. The limits are clear. There is no expansion battery option, so 768Wh is as big as it gets, and for home outage duty the C1000 Gen 2 is the better use of money because the extra capacity and output matter more than a built-in lamp when the power is out for a day. For campers who also want occasional storm backup for phones, a router and a CPAP, this is the right size."
  },
  {
    "id": "anker-solix-f3000",
    "name": "Anker SOLIX F3000",
    "category": "3072Wh LiFePO4, 3600W, 120V, Expandable",
    "badge": "Best 120V Home Backup",
    "amazonUrl": "#",
    "pros": [
      "3,072Wh and 3,600W continuous, enough for a fridge, freezer, furnace and lights together",
      "Up to 2,400W of solar input",
      "Rated for 4,000+ cycles to 80% capacity with a 5-year warranty",
      "Two units can pair for 240V output",
      "Expandable with BP3000 batteries for multi-day backup"
    ],
    "cons": [
      "About 91.5 lb, a two-person lift without its wheels",
      "Single unit is 120V only"
    ],
    "bottomLine": "A cheaper route to whole-day backup for homes that do not need 240V, with the option to add a second unit later.",
    "description": "The F3000 is the F-series model for people who want serious backup but do not need, or cannot justify, the F3800 Plus. It holds 3,072Wh of LiFePO4 and is rated for 3,600W continuous, which comfortably runs a refrigerator, a chest freezer, a gas furnace blower, Wi-Fi and lights at the same time with headroom for a microwave. Solar input reaches 2,400W, so a modest array can refill most of the battery in a sunny afternoon. The important difference from the F3800 Plus is voltage. A single F3000 is a 120V machine. That is fine for most homes on gas heat and city water, but it will not run a 240V well pump, an electric water heater or central air. Anker's workaround is pairing: two F3000 units linked together produce 240V, which is an affordable upgrade path if you start with one and add a second later. Expansion is also available through BP3000 batteries; retailer listings disagree on the maximum, so confirm the current limit on Anker's site before you plan a large system around it. Anker rates the cells for 4,000 cycles to 80% capacity and backs it with a 5-year warranty. The unit weighs about 91.5 lb and has wheels and a telescoping handle, so it rolls easily on a flat floor but is a two-person job up stairs. At 85% usable, the F3000 delivers roughly 2,600Wh, which runs a 250W average household load (fridge, furnace cycling, lights and router) for about ten hours. It also has an RV-style TT-30 option in some bundles, making it a reasonable trailer battery."
  },
  {
    "id": "anker-solix-c300x",
    "name": "Anker SOLIX C300X / C300X DC",
    "category": "288Wh LiFePO4, 300W, Dual 140W USB-C",
    "badge": "Best Compact",
    "amazonUrl": "#",
    "pros": [
      "About 8.8 lb for the AC version and roughly 6.2 lb for the DC version",
      "Two 140W USB-C ports charge laptops at full speed",
      "300W AC output with 600W surge on the AC model",
      "LiFePO4 chemistry, unusual at this size",
      "Small enough for a backpack, desk drawer or glovebox"
    ],
    "cons": [
      "288Wh will not run a refrigerator for long",
      "The DC version has no AC outlet at all"
    ],
    "bottomLine": "The best small Anker battery for laptops, phones, a CPAP for a night and a few lights, as long as you buy the version with the outlets you need.",
    "description": "The C300X is the smallest Anker power station we would actually recommend, and it comes in two versions that are easy to confuse. The standard C300X has a 288Wh LiFePO4 battery and a 300W pure sine wave inverter with a 600W surge mode, plus AC outlets, USB-C, USB-A and a car port, in a roughly 8.8 lb box about the size of a loaf of bread. The C300X DC drops the inverter entirely. It keeps the same 288Wh battery but offers only DC outputs, including two 140W USB-C ports and a 120W car socket, and weighs around 6.2 lb. That makes the DC version essentially a very large power bank, ideal if everything you own charges over USB-C. Both share the strengths that make this class useful: two 140W USB-C ports will run a MacBook Pro or gaming laptop at full speed, and the LiFePO4 cells tolerate thousands of cycles, which matters for a battery that lives in a car or a backpack. Solar charging is modest, around 100W, which suits a single folding panel. Know the limits before you buy. At 85% usable, 288Wh is about 245Wh, enough for roughly four nights of a 50W laptop working day, a full night of a CPAP without humidifier, or a handful of phone and tablet charges. It will not keep a refrigerator going for more than an hour or two. Think of it as the Anker battery for desks, day trips and power-cut phone charging, not for the kitchen."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Anker Power Station",
          item: "https://www.thehonestreviewers.com/best-anker-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best Anker power station for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The SOLIX C1000 Gen 2. It stores 1,024Wh, runs 2,000W loads, recharges from a wall outlet in about 49 minutes and weighs around 25 lb. That covers camping, CPAP, a refrigerator through a short outage and most kitchen appliances. If the original C1000 is discounted by more than about $100, it is the better value buy."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Anker power plant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no Anker product sold as a power plant in the US. People use the phrase for Anker's large home backup batteries, which in practice means the SOLIX F3800 Plus or a pair of F3000 units. The F3800 Plus is the one that delivers 240V output, 6,000W and expansion to about 26.9kWh per unit."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Anker SOLIX C1000 worth buying in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, especially on sale. It holds 1,056Wh, outputs 1,800W, refills in about 58 minutes in UltraFast mode and can be expanded to 2,112Wh with the BP1000. The C1000 Gen 2 is lighter and more powerful, but the original remains one of the best values in the category whenever it is discounted."
          }
        },
        {
          "@type": "Question",
          "name": "Can the Anker SOLIX F3800 run a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can run a large share of one. The F3800 Plus delivers 6,000W at 120V or 240V, enough for a well pump, fridge, furnace and lights together. With expansion batteries and solar it can cover multi-day outages. Central air plus an electric range and dryer at once would exceed it, so prioritize circuits."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the Anker C300X and C300X DC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both hold 288Wh of LiFePO4 with two 140W USB-C ports. The standard C300X adds a 300W AC inverter with outlets and weighs about 8.8 lb. The C300X DC removes the inverter, keeping only USB and car-socket outputs, and weighs around 6.2 lb. Buy the DC version only if nothing you own needs a wall plug."
          }
        },
        {
          "@type": "Question",
          "name": "Are Anker power stations better than EcoFlow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither is better across the board. Anker leads on charging speed, compact weight and its standard 5-year warranty. EcoFlow offers a larger ecosystem of extra batteries, smart panels and a highly rated app. At the 1,000Wh level they trade wins model by model, so compare current prices and the specific features you need."
          }
        },
        {
          "@type": "Question",
          "name": "How long does an Anker battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Current SOLIX models use LiFePO4 cells rated for 3,000 to 4,000 cycles before dropping to 80% capacity. One full cycle a day for eight years would still be within that range, and most owners cycle far less. Store it partly charged in a cool place and top it up every three months."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best anker power station",
      "anker power plant",
      "anker battery",
      "anker solix c300x portable power station",
      "anker solix c1000",
      "anker solix f3800",
      "anker solix power station"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Anker Power Stations</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Anker sells more than a dozen SOLIX power stations and the names barely help. We sorted the lineup by what each one is actually good for, from a 288Wh tent battery to a 240V home backup system.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-solix-c1000-gen-2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
