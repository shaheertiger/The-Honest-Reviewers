---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Indoor Heaters for Power Outages",
    "url": "/best-indoor-heater-for-power-outage/"
  },
  {
    "title": "Best Carbon Monoxide Detectors",
    "url": "/best-carbon-monoxide-detector/"
  },
  {
    "title": "Best Camping Power Banks",
    "url": "/best-camping-power-bank/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Battery Powered Lanterns",
    "url": "/best-battery-powered-lantern/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-28", modified: "2026-11-28" });
const title = "7 Best Camping Stoves in 2026: Safe Picks for Outages";
const description =
  "Camp stoves are outdoor appliances: never cook with propane or butane indoors in an outage. The best camping stoves for campsites and outdoor outage cooking, with fuel, BTU and wind compared.";

const PRODUCTS = [
  {
    "id": "camp-chef-everest-2x",
    "name": "Camp Chef Everest 2X 2-Burner Propane Stove",
    "category": "2-Burner Propane, 40,000 BTU Total, Matchless Ignition, 3-Sided Windscreen",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Two 20,000 BTU cast-aluminum burners, 40,000 BTU total, per the listing",
      "Folding lid and three-sided windscreen for breezy campsites",
      "Matchless ignition and precise controls, as Camp Chef lists",
      "215 square inches of cooking area fits two pans",
      "Drip tray and carry handle for cleanup and transport"
    ],
    "cons": [
      "The most expensive stove of the seven",
      "Heavier and bulkier than a single burner",
      "Listing does not state burn time per cylinder; check the manual"
    ],
    "bottomLine": "The best camping stove for most households: two strong burners, a real windscreen and matchless ignition for camp meals and outdoor outage cooking.",
    "description": "If you want one stove that cooks real meals at a campsite and handles a week of outdoor cooking during an outage, the Camp Chef Everest 2X is the one we would buy. Its listing describes two 20,000 BTU cast-aluminum burners for 40,000 BTU total, nearly double what a typical entry-level two-burner offers. That matters less for boiling a single pot than for keeping a big pot of pasta water rolling while the second burner fries eggs, and for bringing a pot back to a boil quickly in cold air. The spec that does the most work outdoors, though, is the folding lid with a three-sided windscreen. Wind steals heat from an open flame far faster than a few thousand extra BTU can replace, and Camp Chef designed this lid to block it. Matchless ignition, a 215 square inch cooking area that fits two pans and a drip tray round it out. The trade-offs are price, weight and bulk: it is a car-camping and backyard stove, not something you carry far. The listing does not give a burn time per 1 lb cylinder, so budget fuel generously and check Camp Chef's manual. Buy the Coleman Triton+ instead if you cook simpler meals and want to spend less."
  },
  {
    "id": "coleman-triton-plus",
    "name": "Coleman Triton+ 2-Burner Propane Stove with InstaStart",
    "category": "2-Burner Propane, 22,000 BTU Total, Push-Button InstaStart, Dual Wind Guards",
    "badge": "Best Value 2-Burner",
    "amazonUrl": "#",
    "pros": [
      "22,000 total BTU across two independently adjustable burners, per the listing",
      "Push-button InstaStart ignition, no matches needed",
      "Dual wind guards shield both burners",
      "Fits a 12-inch and a 10-inch pan side by side",
      "Coleman lists up to 1 hour on high per 16 oz propane cylinder"
    ],
    "cons": [
      "Half the burner output of the Everest 2X",
      "One hour per cylinder on high means stocking several for an outage",
      "Piezo igniters can wear out; keep a lighter as backup"
    ],
    "bottomLine": "The value two-burner: enough heat and control for most camp meals, matchless lighting and wind guards at a lower price than the Everest.",
    "description": "The Coleman Triton+ is the classic green two-burner camp stove updated with push-button ignition, and for most families it is all the stove they need. Coleman lists 22,000 total BTU across two independently adjustable burners with what it calls PerfectFlow and PerfectHeat technology for precise temperature control. In practice that means one burner can hold a pot of chili low while the other boils water for coffee. The InstaStart push-button lights the burners without matches, which is convenient, though piezo igniters on any stove can fail with age, so keep a long lighter in the case. Two wind guards fold up on the sides, the chrome-plated grate lifts out for cleaning and the cooktop is aluminized steel for rust resistance. The number to plan around for outage use is burn time: Coleman lists up to 1 hour on high on one 16 oz propane cylinder. Cooking two meals a day on moderate heat stretches that further, but a week without power still means stocking several cylinders or using a maker-approved adapter hose to a larger tank. If you only ever boil water and heat soup, a single burner butane stove costs less and packs smaller. If you cook for a crowd or in steady wind, step up to the Everest 2X."
  },
  {
    "id": "iwatani-35fw",
    "name": "Iwatani 35FW Single-Burner Butane Portable Cooktop",
    "category": "1-Burner Butane, 15,000 BTU Brass Burner, Magnetic Can Lock, Double Windbreaker",
    "badge": "Best Butane Stove",
    "amazonUrl": "#",
    "pros": [
      "15,000 BTU brass burner, high for a cassette stove, per the listing",
      "Magnetic can lock that is hard to load incorrectly",
      "Heat panel designed to use the whole butane can",
      "Built-in double windbreaker",
      "Automatic shut-off if canister pressure rises too high; made in Japan"
    ],
    "cons": [
      "Butane loses pressure in cold weather",
      "One burner only",
      "Indoor label is not permission to cook in a closed-up house during an outage"
    ],
    "bottomLine": "The best single-burner butane stove: strong output, a smart can lock and a wind guard, ideal for tabletop and outdoor cooking.",
    "description": "Iwatani is the name cooks reach for when they want a butane cassette stove that behaves like a real burner, and the 35FW is its strongest common model. The listing describes a 15,000 BTU brass burner, which is roughly double what budget butane stoves offer, so it can sear and stir-fry instead of just warming food. Loading is simple: the fuel can pushes onto a magnet and locks, with no lever to forget, and Iwatani says a heat panel keeps output up until the can is fully used rather than fading at the end. A built-in double windbreaker protects the flame, and an automatic safety stop cuts the butane and puts the flame out if canister pressure rises to unsafe levels. Iwatani sells the 35FW as an indoor and outdoor cooktop, and that is the honest caveat for outage use. Indoor use on a ventilated kitchen counter for a hot-pot dinner is not the same as cooking in a sealed-up house with no exhaust fan running; burning butane still makes carbon monoxide. During an outage, cook with it outside or in a truly ventilated space, follow Iwatani's manual, and have a CO alarm on. Butane also struggles below freezing, so winter campers should choose a propane stove instead."
  },
  {
    "id": "gas-one-gs-3900pb",
    "name": "Gas One GS-3900PB Dual Fuel Propane or Butane Stove",
    "category": "1-Burner Dual Fuel, 15,000 BTU, Butane or 1 lb Propane, Piezo Ignition",
    "badge": "Best for Fuel Flexibility",
    "amazonUrl": "#",
    "pros": [
      "Runs on an 8 oz butane cartridge or a 1 lb propane cylinder, per the listing",
      "Propane adapter included",
      "15,000 BTU output, as Gas One lists",
      "Pressure-sensor cartridge ejection and gas flow cut-off",
      "Windblocker on all four corners of the burner and a carrying case"
    ],
    "cons": [
      "Single burner",
      "Listing does not state burn times",
      "Fuel is sold separately, and the propane setup is taller"
    ],
    "bottomLine": "The single burner for uncertain fuel supply: it takes butane or 1 lb propane, so you can cook with whichever the store still has.",
    "description": "The best argument for the Gas One GS-3900PB is the one that matters in a storm: when store shelves empty, you may find butane canisters but no propane, or the reverse. This stove takes either. Gas One's listing says it runs on a single 8 oz butane cartridge or a 16.4 oz (1 lb) propane cylinder, with the propane adapter included, and rates it at 15,000 BTU. That flexibility also fixes butane's weak spot: when it is too cold for butane to vaporize well, you can switch to a propane cylinder and keep cooking. The listing describes piezo-electric ignition, an adjustable heat dial, a pressure sensor that ejects the cartridge and cuts gas flow if something goes wrong, and a heavy windblocker on all four corners of the burner head. A carrying case is included. The trade-offs are that it is one burner, so a full family meal takes longer than on a two-burner, and the listing does not give burn times for either fuel, so check the manual and stock more fuel than you think you need. The listing does not describe it as an indoor stove; use it outdoors or in a well-ventilated open area. Buy the Iwatani instead if you only ever use butane and want the stronger, more refined burner."
  },
  {
    "id": "coleman-classic-butane-1-burner",
    "name": "Coleman Classic 1-Burner Butane Stove with Carry Case",
    "category": "1-Burner Butane, 7,650 BTU, InstaStart Ignition, Wind Baffle",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "Matchless InstaStart ignition, per the listing",
      "Coleman lists up to 1.25 hours on high per 8.8 oz butane cylinder",
      "Removable porcelain-coated grate and rust-proof aluminum burner",
      "Wind baffle and a large, stable base for stirring",
      "Carry case included"
    ],
    "cons": [
      "7,650 BTU is modest; boiling a big pot takes a while",
      "Fits one 10-inch pan",
      "Butane fades in cold weather"
    ],
    "bottomLine": "A simple, low-cost butane burner for heating soup, boiling water and keeping a backup stove in the outage kit.",
    "description": "Not everyone needs a big stove. If your plan is to boil water for coffee, heat soup and cook eggs on the back patio when the power goes out, the Coleman Classic 1-Burner Butane Stove does that for little money and stores in a closet in its carry case. Coleman lists 7,650 BTU, a single adjustable burner for precise temperature control, matchless InstaStart ignition and a wind baffle around the flame. The porcelain-coated grate lifts out for cleaning, the burner is rust-proof aluminum, and the large base keeps a pot steady while you stir. The planning number is also on the listing: up to 1.25 hours on high per 8.8 oz butane cylinder, which makes it easy to work out how many canisters to keep for a few days of outage cooking. The trade-offs are honest ones. At 7,650 BTU it is slow to boil a large pot, it fits one 10-inch pan, and like all butane stoves it loses pressure near and below freezing, so it is a three-season stove. Coleman does not describe it as an indoor stove: use it outdoors. Buy the Iwatani 35FW if you want much more heat from a butane burner, or the Gas One GS-3900PB if you want the option of propane."
  },
  {
    "id": "jetboil-flash",
    "name": "Jetboil Flash 1.0L Fast Boil Cooking System",
    "category": "Backpacking Canister System, 1.0L Cup, Auto Ignition, Propane/Isobutane",
    "badge": "Best for Boiling Water",
    "amazonUrl": "#",
    "pros": [
      "Jetboil says it boils 16 oz of water in 2 minutes",
      "One-step turn-and-click auto ignition",
      "Stove and a 100 g canister pack inside the 1 liter cup",
      "Three locking points to secure the cup to the burner",
      "Insulated cozy and cool-touch grip zones"
    ],
    "cons": [
      "Built for boiling, not for frying or real simmering",
      "Small capacity for a family",
      "Uses threaded canisters you may not find at every store"
    ],
    "bottomLine": "The fastest, most compact way to boil water for coffee, freeze-dried meals and an emergency go-bag.",
    "description": "The Jetboil Flash is not a stove for cooking dinner in a pan. It is a system for boiling water quickly with very little fuel, and at that it is hard to beat. Jetboil says the Flash boils 16 ounces of water in 2 minutes, and the integrated cup, which locks to the burner at three points with visual indicators, captures heat that an open flame under a separate pot would lose to the air and the wind. A turn-and-click igniter lights it without matches, the cup has an insulated cozy and cool-touch grip zones, and the burner and a 100 g fuel canister pack inside the 1 liter cup. That is why it shows up in backpacks and emergency go-bags: water for coffee, oatmeal, instant noodles or freeze-dried meals, from something the size of a large thermos. The trade-offs are just as clear. The listing makes no simmer claim, and the Flash is designed to boil, so it is a poor choice for frying or slow cooking. A liter at a time is small for a family. It runs on threaded isobutane-propane canisters, which outdoor stores carry but many grocery stores do not. Consider the Jetboil MiniMo if you want a similar system with simmer control, or a two-burner stove for family meals."
  },
  {
    "id": "msr-pocketrocket-2",
    "name": "MSR PocketRocket 2 Ultralight Backpacking Stove",
    "category": "Backpacking Canister Stove, 2.6 oz, Simmer Control, Isobutane-Propane",
    "badge": "Best Ultralight",
    "amazonUrl": "#",
    "pros": [
      "2.6 oz and folds to 2 x 2 x 3 inches, per the listing",
      "MSR lists boiling one liter in 3.5 minutes",
      "Flame adjusts from simmer to rolling boil",
      "Serrated pot supports fit a wide range of pots",
      "No priming or pressurizing; protective case included"
    ],
    "cons": [
      "No built-in igniter; bring a lighter",
      "Open burner is more affected by wind than an integrated system",
      "Tall and less stable with a large pot on a canister"
    ],
    "bottomLine": "The tiny canister stove for backpackers who want real simmer control and any pot they like.",
    "description": "The MSR PocketRocket 2 is the stove many backpackers carry when weight matters more than anything else. MSR lists it at 2.6 ounces, folding to 2 by 2 by 3 inches, and it screws onto a self-sealing isobutane-propane canister, a fuel MSR notes is available in most countries. Unlike integrated systems built only for boiling, the PocketRocket 2 adjusts from a simmer to a rolling boil, so you can cook a real backcountry meal in your own pot. MSR lists boiling one liter of water in 3.5 minutes, slower than the Jetboil Flash's integrated cup but with far more flexibility, and the serrated pot supports grip a wide range of pot sizes. There is no priming, preheating or pressurizing, and a protective case is included. The trade-offs come from its tiny size. There is no built-in igniter, so carry a lighter. An open burner loses more heat to wind than an enclosed system, and while the title mentions MSR's WindClip protection, you will still want to shelter it behind rocks, a pack or a windscreen designed for canister stoves. A wide pot sitting high on a small canister is less stable than a camp stove on a table. For outage cooking at home it works, but a two-burner propane stove is easier for family meals."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Camping Stoves",
          item: "https://www.thehonestreviewers.com/best-camping-stove/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best camping stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households, the Camp Chef Everest 2X is the best camping stove: two 20,000 BTU burners, matchless ignition and a three-sided windscreen, per its listing, which make it strong for family meals and windy conditions. The Coleman Triton+ is the value two-burner, and the Iwatani 35FW is the best single butane burner."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a camping stove indoors during a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Propane and butane camp stoves burn fuel and make carbon monoxide, and they have no vent. In a closed-up house during an outage that is dangerous. Cook outdoors in an open, ventilated area away from doors and windows, and keep a battery carbon monoxide alarm working inside. Some butane stoves are sold for indoor use; follow their manual and ventilate."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best stove for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A two-burner propane camp stove used outside, such as the Camp Chef Everest 2X or Coleman Triton+, because propane is easy to find and works in cold weather. If you are unsure which fuel stores will have, the Gas One GS-3900PB runs on butane or 1 lb propane. Always cook outdoors."
          }
        },
        {
          "@type": "Question",
          "name": "Is butane or propane better for a camping stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Propane is better in cold weather and is the most widely sold camp fuel in North America. Butane canisters are cheaper, slimmer and burn quietly, but butane struggles near and below freezing. For winter outages, choose propane. For mild weather and tabletop cooking, a butane stove is a good, compact choice."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a 1 lb propane cylinder last on a camp stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the stove and the flame. Coleman lists up to 1 hour on high for the Triton+ on one 16 oz cylinder. Cooking at medium heat stretches that. For outage planning, budget about one cylinder per day of normal cooking and keep a spare, or use a maker-approved adapter to a larger tank."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a butane stove in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only with difficulty. Butane boils at around the freezing point of water, so in freezing weather canister pressure drops and the flame weakens. Keep canisters at room temperature until you cook, never heat them, and for freezing conditions use a propane stove or a dual fuel model that can switch to propane."
          }
        },
        {
          "@type": "Question",
          "name": "Is a Jetboil good for emergencies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For boiling water, yes. Jetboil says the Flash boils 16 oz of water in 2 minutes, and the stove and a small canister pack into its own cup, which makes it a good go-bag stove. It is not made for frying or simmering, and it serves one or two people, so a household should pair it with a larger stove."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "best camping stove",
      "camping stove",
      "best stove for power outage",
      "butane stove",
      "propane camping stove",
      "2 burner camp stove",
      "backpacking stove"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Camping Stoves</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A camping stove is the easiest way to keep cooking when the power goes out, but propane and butane camp stoves are outdoor appliances: never use one inside your house, cook in the open air and keep a CO alarm working. Here are seven that do the job safely outside.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#camp-chef-everest-2x"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Type?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Which Type You Need</a>
          <a href="#power-outage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Using One in an Outage</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Camping Stoves</a>
          <a href="#btu" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How Many BTUs</a>
          <a href="#fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Propane vs Butane vs Isobutane</a>
          <a href="#cold-weather" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Butane in Cold Weather</a>
          <a href="#wind" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Wind Performance</a>
          <a href="#simmer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Simmer Control</a>
          <a href="#fuel-planning" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Fuel for an Outage</a>
          <a href="#outage-kit" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. The Rest of an Outage Kit</a>
          <a href="#car-vs-backpacking" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Car Camping vs Backpacking</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Setup and Storage</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">14. FAQ</a>
        </nav>
      </div>
    </div>

