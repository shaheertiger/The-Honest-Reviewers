---
import Layout from "../layouts/Layout.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";


const dates = pageDates(Astro.url.pathname, { published: "2026-08-31", modified: "2026-08-31" });
const title = "How to Fill Large Cracks in an Asphalt Driveway";
const description =
  "Cracks over half an inch need backer rod and the right filler, not more product poured in. Here is the method that holds through a freeze-thaw winter.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "How-To Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Filling Large Asphalt Cracks",
          item: "https://www.thehonestreviewers.com/how-to-fill-large-cracks-in-asphalt-driveway/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do you fill large cracks in an asphalt driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Clear the crack of debris and vegetation, brush and blow out the dust, let it dry fully, then press closed-cell foam backer rod in so its top sits about a quarter to half an inch below the surface. Fill with rubberized crack filler slightly proud, strike it level, and let it cure 24 to 48 hours before sealing.",
          },
        },
        {
          "@type": "Question",
          name: "What size crack needs backer rod?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Anything wider than about half an inch, and any crack deep enough that you cannot see or feel the bottom. Backer rod gives the filler a floor to sit on, prevents it slumping into the void, dramatically reduces how much product you use, and lets the fill flex correctly with seasonal movement.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use crack filler on a crack wider than an inch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No, not effectively. Pourable rubberized filler is formulated to flex within a narrow joint, and in a wide opening it behaves like a rubber slab that splits across the middle or pulls away from one wall. Use cold patch asphalt instead, compacted firmly in layers of no more than two inches.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best time of year to fill asphalt cracks?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A mild spring or early autumn day. Asphalt contracts in cold weather, so cracks are widest in winter and narrowest in summer. Filling in cool conditions means filling nearer the crack’s wider state, which puts the filler into compression as things warm rather than stretching it, while still allowing a proper cure.",
          },
        },
        {
          "@type": "Question",
          name: "How long does asphalt crack filler take to cure before sealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically 24 to 48 hours, and longer in cool or humid weather — check the specific product label. Sealing over uncured filler traps solvent underneath and leaves a soft strip along every repair that never fully hardens and picks up dirt and tyre marks.",
          },
        },
        {
          "@type": "Question",
          name: "Will crack repairs be visible after sealing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, to some degree. Crack filler cures to a different texture and sheen than the surrounding asphalt, and sealer over the top reduces the contrast without eliminating it. Slight settling into a shallow dish is also normal as the filler shrinks during cure and is purely cosmetic.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete",
    tags: [
      "fill large cracks in asphalt driveway",
      "asphalt crack repair",
      "backer rod driveway",
      "driveway & concrete",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Crack Fillers",
    link: "/best-asphalt-crack-filler/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Repair Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How to Fill Large Cracks <span class="text-[#38BDF8]">in an Asphalt Driveway</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Pourable filler alone sinks and cracks in a wide gap. The fix is a backer rod floor, the right product for the width, and patience with the cure.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#method"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Repair Steps
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-counts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Counts as a Large Crack</a>
          <a href="#materials" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What You Need</a>
          <a href="#method" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Repair Method</a>
          <a href="#timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Timing and Weather</a>
          <a href="#expectations" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. What to Expect Afterwards</a>
          <a href="#crack-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Why the Crack Formed</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The mistake with a wide crack is treating it as a narrow crack that needs more product. Pour filler into a half-inch gap and it slumps, cures unevenly, sinks below the surface and splits down the middle by spring. Wide cracks need a floor to sit on.
        </p>

        <div id="what-counts" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What Counts as a “Large” Crack
          </h2>

          <p>
            Width determines the product and the method, so measure before you buy anything. A tape measure or even a coin held against the gap is enough to sort what you are looking at.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Crack Width</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Backer Rod?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Under 1/8"</td>
                    <td class="px-4 py-4 text-gray-700">Filler-and-sealer, or sealer alone</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Hairline crazing; handled by the surface coat</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/8" to 1/2"</td>
                    <td class="px-4 py-4 text-gray-700">Pourable rubberized crack filler</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">The routine case; fill, strike level, cure</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/2" to 1"</td>
                    <td class="px-4 py-4 text-gray-700">Rubberized filler over backer rod</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Rod prevents slumping and saves product</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1" to 2"</td>
                    <td class="px-4 py-4 text-gray-700">Cold patch, compacted</td>
                    <td class="px-4 py-4 text-gray-700">Sometimes</td>
                    <td class="px-4 py-4 text-gray-700">Too wide for pourable filler to hold</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Over 2", or a hole</td>
                    <td class="px-4 py-4 text-gray-700">Cold patch or permanent patch</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Treat as a pothole repair, compact in layers</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Depth matters as much as width. A crack that swallows a screwdriver to the handle is going down toward the base, and that is where backer rod earns its place — without it you are filling a void of unknown volume with an expensive product that will settle anyway.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Pattern That Means Stop</p>
            <p class="text-xl font-bold text-white mb-3">Interconnected webbing is not a crack to fill.</p>
            <p class="text-gray-300 leading-relaxed m-0">If the cracks form a web resembling reptile skin rather than discrete lines, that is alligator cracking and it means the base beneath the asphalt has failed. Filling it is wasted product, because the flexing that created the pattern continues underneath. A small area can be cut out and patched; a large area needs resurfacing.</p>
          </div>
        </div>

        <div id="materials" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Materials and Tools
          </h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rubberized asphalt crack filler, pourable bottle or caulk tube, for cracks up to about an inch.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Closed-cell foam backer rod, sized about 25 percent wider than the crack so it compresses in.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Cold patch asphalt for anything wider than an inch or for depressions and potholes.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A screwdriver, cold chisel or crack cleaning tool for clearing the gap.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A wire brush and a leaf blower or compressed air for dust removal.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A putty knife or trowel for striking the fill level.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A hand tamper or a length of 4x4 for compacting cold patch.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Weed treatment if anything is growing in the crack.</span>
            </li>
          </ul>

          <p>
            On backer rod sizing: buy it wider than the crack. Rod that drops loosely into the gap does not stay put and does not give the filler a proper floor. Rod that has to be pressed in wedges itself at a consistent depth, which is exactly what you want. Sizes are inexpensive enough that buying two diameters for a driveway with varied cracks is sensible.
          </p>
        </div>

        <div id="method" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. How to Fill a Large Crack Step by Step
          </h2>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Clear the crack completely</p>
                <p class="text-gray-700 text-sm m-0">Dig out loose asphalt, soil, old failed filler and debris with a screwdriver or chisel. The filler must contact sound asphalt on both walls, not the rubble sitting between them.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Deal with any vegetation properly</p>
                <p class="text-gray-700 text-sm m-0">Weeds in a crack have roots below the pavement. Treat them, wait for die-off, then remove the root mass. Cutting the tops off guarantees they return through your repair.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Brush and blow out the dust</p>
                <p class="text-gray-700 text-sm m-0">Wire brush the crack walls, then clear the dust with a blower or compressed air. Filler bonds to clean asphalt; it does not bond to dust.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Make sure it is bone dry</p>
                <p class="text-gray-700 text-sm m-0">After washing, give the crack a full dry day. Cracks hold moisture far longer than the surrounding surface, and damp walls prevent bonding.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Press in backer rod for anything over half an inch</p>
                <p class="text-gray-700 text-sm m-0">Push the rod down so its top sits roughly a quarter to half an inch below the driveway surface. That leaves the right depth of filler above it — deep enough to be robust, shallow enough to cure.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Fill in layers if the crack is deep</p>
                <p class="text-gray-700 text-sm m-0">Even over backer rod, a very deep fill benefits from two passes with time between them rather than one heavy pour that skins over and stays soft underneath.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">7</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Overfill slightly, then strike level</p>
                <p class="text-gray-700 text-sm m-0">Filler shrinks a little as it cures. Fill marginally proud and strike flush with a putty knife so it settles level rather than dishing.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">8</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Let it cure fully before sealing</p>
                <p class="text-gray-700 text-sm m-0">Typically 24 to 48 hours, longer in cool or humid weather. Check the label. Sealing over uncured filler traps solvent and leaves a permanently soft strip.</p>
              </div>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">For Cracks Over an Inch: Use Cold Patch Instead</h3>

          <p>
            Past about an inch, pourable filler is the wrong product regardless of how much backer rod you use. Rubberized filler is formulated to flex within a narrow joint; in a wide opening it behaves like a rubber slab, and it will crack across the middle or pull away from one wall as the asphalt moves seasonally.
          </p>

          <p>
            Cold patch is the answer. Clear the opening down to a sound base, add patch material in layers of no more than about two inches, and compact each layer firmly with a hand tamper or by driving over it with a board on top. The compaction is the whole job — under-compacted cold patch loosens and lifts within a season.
          </p>
        </div>

        <div id="timing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. When to Do This Work
          </h2>

          <p>
            Crack width changes with temperature, and that has a practical consequence for the timing of the repair.
          </p>

          <p>
            Asphalt contracts in the cold, so a given crack is at its widest in winter and its narrowest in summer heat. Filling a crack in high summer means you are filling it at close to its minimum width, and the filler is then stretched as the crack opens through the following winter. Filling in cool conditions — spring or autumn — means filling near its wider state, which puts the material into compression rather than tension as things warm up. Compression is the easier state for a flexible filler to handle.
          </p>

          <p>
            Against that, most fillers need reasonable temperatures to cure properly, though many rubberized products tolerate cooler conditions than surface sealer does. The practical sweet spot for most climates is a mild spring or early autumn day: cool enough that the cracks are not at minimum width, warm enough for a proper cure.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Sequence the Whole Project</p>
            <p class="text-xl font-bold text-white mb-3">Fill first, cure fully, then seal.</p>
            <p class="text-gray-300 leading-relaxed m-0">Crack repair always precedes sealing, and the filler needs its full cure time in between. A realistic order is: clean and wash, dry for a day, fill cracks, cure for 24 to 48 hours, then two coats of sealer with 24 to 48 hours before traffic. This is a multi-day project and treating it as an afternoon job is why repairs fail.</p>
          </div>
        </div>

        <div id="expectations" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What a Good Repair Looks Like — and What It Does Not
          </h2>

          <p>
            Setting expectations honestly here saves disappointment, because a technically excellent asphalt crack repair still looks like a repair.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Repairs Stay Visible</h3>

          <p>
            Crack filler cures to a different texture and sheen than the surrounding asphalt, and it is usually a slightly different shade of black. A coat of sealer over the top reduces the contrast considerably but never eliminates it. On close inspection you will always be able to trace where the repairs run. Anyone promising invisible repairs is overselling.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Some Settling Is Normal</h3>

          <p>
            Filler shrinks slightly as it cures and may settle marginally below the surface in the first weeks. A shallow dish is cosmetic and does not need addressing. A repair that has sunk substantially or split down the middle usually indicates the crack was too wide for pourable filler, or that there was no backer rod under a deep fill.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">How Long It Should Last</h3>

          <p>
            A properly executed fill on a discrete thermal crack, protected by sealer above it, should hold for several years and typically survives multiple freeze-thaw winters. It will need inspecting each spring, and touching up occasionally where movement has been greatest. If a repair fails within a single season, the cause is nearly always preparation — a dirty or damp crack, or a fill with no floor beneath it.
          </p>
        </div>

        <div id="crack-types" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Understanding Why the Crack Formed
          </h2>

          <p>
            Filling a crack without understanding what caused it means the repair may be fighting an ongoing process rather than closing a finished one. Three patterns account for most large cracks in residential driveways.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Thermal and Shrinkage Cracks</h3>

          <p>
            Straight or gently curving cracks running roughly across or along the driveway, opening in winter and closing in summer. These come from the asphalt expanding and contracting with temperature, and they are entirely normal on any driveway past a few years old. They are the ideal candidate for filling: the cause is ongoing but benign, and a flexible filler accommodates the seasonal movement indefinitely.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Edge Cracks</h3>

          <p>
            Cracks running parallel to and within a foot or so of the driveway edge, usually caused by lack of lateral support — the soil beside the driveway has eroded, or vehicles have been driven over the unsupported edge. Filling these works, but so does addressing the cause: building the soil back up to the level of the asphalt so the edge is supported. Otherwise the crack reopens as the edge continues to break away.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Reflective Cracks</h3>

          <p>
            Cracks that appear in a resurfaced driveway directly above cracks in the old layer underneath. The movement in the lower layer telegraphs through the new asphalt above it. These will keep reopening, because the source of the movement is buried and unaddressed. Filling them is legitimate maintenance rather than a permanent fix, and they will need attention every few years.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Watch What the Crack Does Seasonally</p>
            <p class="text-xl font-bold text-white mb-3">A crack that moves needs flexible filler; one that grows needs investigating.</p>
            <p class="text-gray-300 leading-relaxed m-0">Normal thermal cracks open and close with the seasons but stay roughly the same length year to year. A crack that is visibly extending, branching, or developing a depression alongside it is telling you something is moving underneath — drainage, base erosion or settlement — and filling it repeatedly will not stop that.</p>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            7. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Pouring Filler Into a Bottomless Crack</h3>
              <p class="text-gray-700 text-sm m-0">
                A deep crack will accept product indefinitely, and filler poured into a large void cures unevenly, slumps and settles well below the surface. Closed-cell foam backer rod pressed in first gives the filler a floor, uses far less material, and lets the fill flex properly with seasonal movement instead of behaving like a deep rubber plug.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using Pourable Filler on a Crack Over an Inch Wide</h3>
              <p class="text-gray-700 text-sm m-0">
                Rubberized filler is designed to flex within a narrow joint. In a wide opening it behaves like a rubber slab and splits across the middle or pulls away from one wall within a season. Past about an inch the correct product is cold patch, compacted in layers of no more than two inches.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Filling a Crack That Is Damp or Full of Dust</h3>
              <p class="text-gray-700 text-sm m-0">
                Filler bonds to clean, dry, sound asphalt on both walls. Dust, debris or moisture means it bonds to those instead, and the whole repair lifts out as a rubbery strip within a year. Clear the crack fully, wire brush the walls, blow out the dust, and give it a dry day after washing.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Cutting Weeds Instead of Killing Them</h3>
              <p class="text-gray-700 text-sm m-0">
                Vegetation growing through a crack is rooted below the pavement. Trimming the visible growth and filling over it means the roots push straight back through the repair, reopening it. Treat the growth, wait for die-off, then dig the root mass out before filling.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealing Before the Filler Has Cured</h3>
              <p class="text-gray-700 text-sm m-0">
                Uncured filler under a coat of sealer cannot release its solvent, leaving a permanently soft strip along every repair that collects dirt and prints under tyres. Give the filler its full label cure time, and extend it in cool or humid weather, before any sealer goes down.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do you fill large cracks in an asphalt driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Clear the crack of debris and vegetation, brush and blow out the dust, let it dry fully, then press closed-cell foam backer rod in so its top sits about a quarter to half an inch below the surface. Fill with rubberized crack filler slightly proud, strike it level, and let it cure 24 to 48 hours before sealing.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What size crack needs backer rod?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Anything wider than about half an inch, and any crack deep enough that you cannot see or feel the bottom. Backer rod gives the filler a floor to sit on, prevents it slumping into the void, dramatically reduces how much product you use, and lets the fill flex correctly with seasonal movement.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you use crack filler on a crack wider than an inch?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No, not effectively. Pourable rubberized filler is formulated to flex within a narrow joint, and in a wide opening it behaves like a rubber slab that splits across the middle or pulls away from one wall. Use cold patch asphalt instead, compacted firmly in layers of no more than two inches.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the best time of year to fill asphalt cracks?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A mild spring or early autumn day. Asphalt contracts in cold weather, so cracks are widest in winter and narrowest in summer. Filling in cool conditions means filling nearer the crack’s wider state, which puts the filler into compression as things warm rather than stretching it, while still allowing a proper cure.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does asphalt crack filler take to cure before sealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Typically 24 to 48 hours, and longer in cool or humid weather — check the specific product label. Sealing over uncured filler traps solvent underneath and leaves a soft strip along every repair that never fully hardens and picks up dirt and tyre marks.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Will crack repairs be visible after sealing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, to some degree. Crack filler cures to a different texture and sheen than the surrounding asphalt, and sealer over the top reduces the contrast without eliminating it. Slight settling into a shallow dish is also normal as the filler shrinks during cure and is purely cosmetic.
              </p>
            </div>
          </div>
        </div>

