  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Crabgrass Preventers",
          item: "https://www.thehonestreviewers.com/best-crabgrass-preventer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "When should I apply crabgrass preventer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Apply before crabgrass germinates, which university extension services commonly tie to soil temperatures around 55°F for several consecutive days. That is early to mid spring in most of the country. A soil thermometer or an extension service soil temperature map is more reliable than a calendar date, and many labels allow a split application for longer protection."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best pre-emergent for crabgrass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your lawn and timing. Pendimethalin products like Scotts Halts are simple and widely sold, dithiopyr products like Jonathan Green Veri-Green and Preen give a few weeks of grace on young crabgrass, and prodiamine concentrates offer the lowest cost and longest residual on large lawns. Match the product to your grass type and the label."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put down crabgrass preventer and grass seed at the same time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not with standard pre-emergents like pendimethalin, dithiopyr or prodiamine, which stop grass seed from establishing. Seed cool-season lawns in early fall instead, or look for a starter product labelled for use at seeding, typically one containing mesotrione. Always check the waiting period on the label before seeding."
          }
        },
        {
          "@type": "Question",
          "name": "How long does crabgrass preventer last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most products control crabgrass for roughly two to four months depending on the active ingredient, rate and weather. Scotts says Step 1 prevents crabgrass for up to four months, and Ace lists Preen for up to four months. Prodiamine is known for long residual activity, and split applications extend coverage through the end of germination season."
          }
        },
        {
          "@type": "Question",
          "name": "Does crabgrass preventer kill existing crabgrass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Pre-emergents stop seeds from establishing and do not kill grown plants. Dithiopyr is a partial exception, with labels claiming control of very young crabgrass for a few weeks after germination. For established crabgrass in summer, use a post-emergent product labelled for crabgrass."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to water in crabgrass preventer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most labels call for watering in with about half an inch of water, from irrigation or rain, within a few days of application. Watering moves the active ingredient off the grass blades and into the top layer of soil where it forms the barrier. Follow the specific timing on your product's label."
          }
        },
        {
          "@type": "Question",
          "name": "Is crabgrass preventer safe for pets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Labels specify when people and pets can return to a treated lawn, usually once the product has been watered in and the grass has dried. Follow that interval, store products out of reach, and sweep granules off hard surfaces. If you have specific concerns, check the product's label and safety data sheet, or ask your vet."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

