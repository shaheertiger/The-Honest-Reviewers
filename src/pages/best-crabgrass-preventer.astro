      "best crabgrass preventer",
      "pre emergent for crabgrass",
      "best pre emergent herbicide",
      "crabgrass preventer with fertilizer",
      "crabgrass pre emergent",
      "when to apply crabgrass preventer"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
