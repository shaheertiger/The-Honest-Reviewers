    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Gift Guides",
    tags: [
      "christmas gifts for men under $50",
      "cheap christmas gifts for men",
      "affordable christmas gifts for men",
      "inexpensive christmas gifts for men",
      "small christmas gifts for men",
      "christmas gifts for men under $25",
      "christmas gifts for men under $20",
      "stocking stuffers for men",
      "last minute christmas gifts for men"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
