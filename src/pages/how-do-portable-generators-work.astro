const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Portable Generators Work",
          item: "https://www.thehonestreviewers.com/how-do-portable-generators-work/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How does a portable generator work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An engine spins a magnet inside coils of wire, and the moving magnetic field induces a voltage in them by electromagnetic induction. Because the magnet rotates, the induced current alternates direction, producing AC. An automatic voltage regulator adjusts the rotor's magnetic field to hold output voltage steady as the load changes."
          }
        },
        {
          "@type": "Question",
          "name": "Why do generators run at 3600 rpm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Output frequency equals engine rpm multiplied by the number of alternator poles, divided by 120. For a two-pole alternator, producing the 60 hertz that North American equipment expects requires exactly 3,600 rpm. That is why conventional generators hold full engine speed regardless of load, and why they are loud and thirsty at light load."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between an inverter and a conventional generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An inverter generator converts its output to DC and then electronically synthesises clean 60 hertz AC, which frees the engine from having to hold 3,600 rpm. That gives much quieter operation and better fuel economy at light load, plus power quality under 3 percent THD against 10 to 25 for a conventional machine."
          }
        },
        {
          "@type": "Question",
          "name": "What is THD on a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Total harmonic distortion, a measure of how far the output waveform departs from a pure sine wave. Mains is close to zero, conventional portables are typically 10 to 25 percent, and inverter generators under 3. Resistive loads like heaters ignore it; electronics with switch-mode power supplies run hot and can be damaged."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable generator damage my electronics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A conventional one can, over time, because distorted waveforms make switch-mode power supplies run hot. Laptops, televisions, games consoles, modern appliance control boards and medical devices such as CPAP machines are the vulnerable categories. Use an inverter generator, or buffer them through a UPS or a portable power station."
          }
        },
        {
          "@type": "Question",
          "name": "What is the L14-30 outlet on a generator for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a twist-lock receptacle carrying both 120-volt legs plus neutral and ground, rated 30 amps at 120/240 volts. That is what a manual transfer switch or an interlock inlet needs to feed a household panel properly. A generator without one cannot feed a 240-volt panel correctly."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my generator surge up and down?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Almost always fuel delivery: a partly blocked carburettor jet, a dirty fuel filter, or a blocked vent in the tank cap. On a conventional generator it matters more than it sounds, because engine speed sets output frequency, so a surging engine means your output frequency is oscillating too. Stop and investigate rather than running on."
          }
        }
