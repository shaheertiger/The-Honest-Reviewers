---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "The Best Concrete Sealer",
    "url": "/best-concrete-sealer/"
  },
  {
    "title": "Acrylic vs Penetrating Concrete Sealer",
    "url": "/acrylic-vs-penetrating-concrete-sealer/"
  },
  {
    "title": "DIY vs Professional Driveway Sealing",
    "url": "/diy-vs-professional-driveway-sealing/"
  },
  {
    "title": "Concrete Driveway Cost",
    "url": "/concrete-driveway-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-15", modified: "2026-09-15" });
const title = "Concrete Sealer Cost: DIY, Pro Pricing and Cost Per Year";
const description =
  "What concrete sealing costs per square foot for materials and labour, what a contractor quote should include, and why the cheapest sealer is rarely the cheapest job.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Sealer Cost",
          item: "https://www.thehonestreviewers.com/concrete-sealer-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much does it cost to seal a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DIY runs about 250 to 400 dollars for a 600 square foot driveway including product and one day of pressure washer rental, or roughly 0.40 to 0.65 dollars per square foot. Professional sealing runs 0.50 to 1.25 dollars per square foot, so 300 to 750 dollars for the same driveway, including cleaning."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to seal concrete yourself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, and increasingly so with each reseal. The first DIY job carries equipment costs that narrow the gap against a cheap contractor. Once you own a sprayer, a reseal costs only product — around 220 dollars for a two-car driveway against 400 to 700 for a contractor."
          }
        },
        {
          "@type": "Question",
          "name": "How much does concrete sealer cost per gallon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Water-based acrylics run 25 to 45 dollars a gallon, solvent acrylics 35 to 60, and silane-siloxane penetrating sealers 40 to 75. High-solids silanes reach 110. Five-gallon pails cut the per-gallon price by roughly 20 to 30 percent."
          }
        },
        {
          "@type": "Question",
          "name": "Why is penetrating sealer so much more expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It carries far more active silane or siloxane content and has to chemically bond inside the pore structure rather than simply dry on the surface. It also covers less per gallon. Against that, it lasts three to four times as long, which makes it cheaper per year of protection."
          }
        },
        {
          "@type": "Question",
          "name": "What should a contractor quote include?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The product name, coverage rate, number of coats, cleaning method, crack repair as a line item, and what happens if it rains within 24 hours. A quote without the first four cannot be compared against any other quote except on price."
          }
        },
        {
          "@type": "Question",
          "name": "Does sealing concrete add value to a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It protects value rather than adding it. A sealed driveway resists salt scaling, oil staining and freeze-thaw damage, and a slab that has been maintained looks maintained. The comparison worth making is against the cost of resurfacing or replacing a spalled driveway, which runs into thousands."
          }
        },
        {
          "@type": "Question",
          "name": "Is expensive concrete sealer worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For exterior flatwork, yes. The price gap between a budget acrylic and a quality silane-siloxane is around 150 dollars on a typical driveway, and it buys three to five extra years. For decorative surfaces where colour and sheen are the objective, an acrylic is the right product regardless of cost per year."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete Sealers",
    tags: [
      "concrete sealer cost",
      "cost to seal concrete",
      "concrete sealing price",
      "sealing concrete driveway cost",
      "driveway & concrete"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Concrete Sealers",
    link: "/best-concrete-sealer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Cost Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Concrete Sealer Cost: <span class="text-[#38BDF8]">What You Will Actually Pay</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Materials, tools, rental and labour, priced line by line — plus the cost-per-year comparison that reverses the answer most people expect.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#materials"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Numbers
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="19.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#materials" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Material Cost per Square Foot</a>
          <a href="#tools" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Tools, Rental and Consumables</a>
          <a href="#diy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. A Full DIY Job Priced Out</a>
          <a href="#pro" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Contractors Charge</a>
          <a href="#quote" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Reading a Quote</a>
          <a href="#peryear" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cost Per Year of Protection</a>
          <a href="#saving" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Where to Save and Where Not To</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Two sealers sit on the same shelf. One costs half as much per gallon and lasts a third as long. Priced per year of protection, the expensive one is the cheap one, and that is the calculation almost nobody runs.
        </p>

        <div id="materials" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Material Cost per Square Foot
          </h2>

          <p>
            Sealer pricing only makes sense per square foot, because coverage varies as much as price does. A gallon that costs twice as much but covers the same area and lasts three times as long is not expensive. Converting to cost per square foot, and then to cost per square foot per year, is the only way to compare products honestly.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sealer Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Price per Gallon</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Coverage</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Material Cost per sq ft</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Water-based acrylic</td>
                    <td class="px-4 py-4 text-gray-700">$25-45</td>
                    <td class="px-4 py-4 text-gray-700">250-400 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.08-0.18</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solvent-based acrylic</td>
                    <td class="px-4 py-4 text-gray-700">$35-60</td>
                    <td class="px-4 py-4 text-gray-700">200-300 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.14-0.30</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Silane-siloxane penetrating</td>
                    <td class="px-4 py-4 text-gray-700">$40-75</td>
                    <td class="px-4 py-4 text-gray-700">100-250 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.20-0.60</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">High-solids silane</td>
                    <td class="px-4 py-4 text-gray-700">$60-110</td>
                    <td class="px-4 py-4 text-gray-700">125-200 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.35-0.75</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Silicate densifier</td>
                    <td class="px-4 py-4 text-gray-700">$25-50</td>
                    <td class="px-4 py-4 text-gray-700">200-400 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.08-0.25</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Epoxy garage kit</td>
                    <td class="px-4 py-4 text-gray-700">$120-300 per kit</td>
                    <td class="px-4 py-4 text-gray-700">250-500 sq ft per kit</td>
                    <td class="px-4 py-4 text-gray-700">$0.35-1.00</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Polyaspartic system</td>
                    <td class="px-4 py-4 text-gray-700">$250-500 per kit</td>
                    <td class="px-4 py-4 text-gray-700">300-500 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">$0.80-1.60</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Remember that acrylics need two coats and penetrating sealers frequently need one saturating pass, so the per-square-foot figures above are not directly comparable until you multiply by the coats each requires. A water-based acrylic at 12 cents a square foot in two coats lands near 20 cents; a silane-siloxane at 40 cents in one pass stays at 40. Our guide to <a href='/how-much-concrete-sealer-do-i-need/'>how much concrete sealer you need</a> does that arithmetic properly.
          </p>

          <p>
            Buying in five-gallon pails cuts the per-gallon price by roughly 20 to 30 percent against single gallons of the same product. On a 600 square foot driveway that difference is typically 30 to 60 dollars, which is enough to move a mid-range penetrating sealer into the same total as a premium acrylic bought in singles.
          </p>

          <p>
            One more variable moves the material figure: how thirsty your slab is. A weathered, open driveway can absorb a third more sealer than the label predicts, which turns a 40 cent per square foot product into a 55 cent one without anything appearing on the receipt to explain it. Price the job against the low end of the coverage range rather than the high end, and treat any surplus as next season's touch-up budget rather than a mistake.
          </p>
        </div>

        <div id="tools" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Tools, Rental and Consumables
          </h2>

          <p>
            The product is rarely the whole bill. A first-time sealing job carries equipment costs that a second one does not, and leaving them out of the comparison is what makes DIY look cheaper than it is on the first pass — and cheaper than it looks on every pass after that.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Item</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Buy</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rent</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure washer</td>
                    <td class="px-4 py-4 text-gray-700">$150-400</td>
                    <td class="px-4 py-4 text-gray-700">$50-100 per day</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Surface cleaner attachment</td>
                    <td class="px-4 py-4 text-gray-700">$60-150</td>
                    <td class="px-4 py-4 text-gray-700">Often included</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Low-pressure chemical sprayer</td>
                    <td class="px-4 py-4 text-gray-700">$20-60</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Roller frame, nap covers, extension pole</td>
                    <td class="px-4 py-4 text-gray-700">$30-60</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete degreaser</td>
                    <td class="px-4 py-4 text-gray-700">$15-30</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Crack filler / patch</td>
                    <td class="px-4 py-4 text-gray-700">$10-25 per tube or bag</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Etching or profiling acid</td>
                    <td class="px-4 py-4 text-gray-700">$20-40</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Renting the pressure washer is the right call for a one-off job and the wrong one if you will be sealing every few years or washing siding and vehicles in between. Two rentals cost most of an entry-level machine. If you are buying, our guide to the <a href='/best-electric-pressure-washer/'>best electric pressure washers</a> covers what is actually needed for concrete — which is less machine than most people assume, provided it comes with a surface cleaner.
          </p>

          <p>
            Do not economise on the sprayer. Solvent-based sealers destroy the seals in cheap garden sprayers, often mid-job and usually over the slab you just cleaned. A chemical-resistant pump sprayer with Viton seals is 40 to 60 dollars and survives repeated use with solvent products.
          </p>

          <p>
            Consumables are small individually and add up quickly. Nap covers, a stir stick, painter's tape for the garage threshold, plastic sheeting for the house wall, gloves and a respirator for solvent products will together add 40 to 70 dollars to a first job. None of it is optional if you want clean edges and a safe afternoon, and most of it is thrown away at the end, so it belongs in the budget rather than in the category of things already lying around the garage.
          </p>
        </div>

        <div id="diy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. A Full DIY Job, Priced Out
          </h2>

          <p>
            Here is a complete 600 square foot driveway, the size of a typical two-car parking area, sealed with a quality silane-siloxane. This is the realistic total for someone who owns nothing but a garden hose at the start.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Line Item</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Silane-siloxane sealer, 5 gal pail</td>
                    <td class="px-4 py-4 text-gray-700">$220</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pressure washer rental, 1 day</td>
                    <td class="px-4 py-4 text-gray-700">$75</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Surface cleaner attachment</td>
                    <td class="px-4 py-4 text-gray-700">Included with rental</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete degreaser</td>
                    <td class="px-4 py-4 text-gray-700">$22</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chemical-resistant pump sprayer</td>
                    <td class="px-4 py-4 text-gray-700">$45</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Crack filler, 2 tubes</td>
                    <td class="px-4 py-4 text-gray-700">$24</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Total</td>
                    <td class="px-4 py-4 text-gray-700">$386 — about $0.64 per sq ft</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The same driveway with a mid-range water-based acrylic comes in nearer 250 dollars, or about 42 cents a square foot, because the product is cheaper even allowing for two coats. That is a genuine saving on the day and a false one over a decade, for reasons the cost-per-year section below makes plain.
          </p>

          <p>
            Time is the line item nobody prices. Cleaning, drying, crack repair and two application sessions realistically occupy a full weekend for a driveway, spread over two days because the slab has to dry properly between washing and sealing. If that weekend has a value to you, put a number on it before comparing against a contractor.
          </p>

          <p>
            Second and subsequent jobs drop sharply. Once the sprayer and any tools are bought, a reseal is just product — 220 dollars, or 37 cents a square foot, for the same driveway. This is the real economics of DIY sealing: the first job is close to break-even against a cheap contractor, and every one after it is not.
          </p>

          <p>
            Disposal is the last line people forget. Solvent-based sealer and the rags used with it cannot go in household waste in most municipalities, and leftover product should be sealed and stored rather than poured anywhere. Budget nothing for it financially, but budget a trip to a household hazardous waste drop-off if you end up with product you cannot store somewhere frost-free.
          </p>
        </div>

        <div id="pro" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Contractors Charge
          </h2>

          <p>
            Professional concrete sealing runs roughly 0.50 to 1.25 dollars per square foot for a straightforward driveway with a penetrating or acrylic sealer, including cleaning. Decorative work, stamped surfaces and anything needing stain removal or crack repair sits above that, commonly 1.50 to 2.50 dollars per square foot. Garage floor coatings are a different trade entirely and priced accordingly.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Typical Professional Pricing</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">$0.50-1.25</p>
                <p class="text-gray-400 text-xs mt-1">Per sq ft, driveway seal</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">$300-750</p>
                <p class="text-gray-400 text-xs mt-1">600 sq ft driveway</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">$1.50-2.50</p>
                <p class="text-gray-400 text-xs mt-1">Per sq ft, stamped or decorative</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">$3-12</p>
                <p class="text-gray-400 text-xs mt-1">Per sq ft, garage coating system</p>
              </div>
            </div>
          </div>

          <p>
            Most contractors carry a minimum charge, usually somewhere between 250 and 400 dollars, because mobilising a crew and equipment for a small patio costs nearly as much as for a driveway. If the job is a 200 square foot patio, the minimum charge is the price, and DIY becomes considerably more attractive.
          </p>

          <p>
            Regional variation is substantial. Labour-heavy markets on either coast run at the top of these ranges or above; much of the Midwest and South sits comfortably in the middle. Seasonality matters too — the same crew quoting in a busy August is rarely quoting its best price, and shoulder-season work in late spring or early autumn is often cheaper.
          </p>

          <p>
            For the equivalent decision on asphalt rather than concrete, the trade-off runs differently because asphalt sealing is cheaper per square foot and needed more often. Our breakdown of <a href='/diy-vs-professional-driveway-sealing/'>DIY versus professional driveway sealing</a> sets both out side by side.
          </p>
        </div>

        <div id="quote" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Reading a Contractor Quote
          </h2>

          <p>
            A quote that says sealing and gives one number is not a quote, it is a price. What separates a job that lasts eight years from one that lasts two is almost entirely in the prep, and prep is exactly what a single-line quote leaves undefined. Ask for the product name, the coverage rate, the number of coats and the cleaning method in writing.
          </p>

          <p>
            The product name matters more than any other detail. It tells you the chemistry, which tells you the expected lifespan, which is what you are really buying. A contractor who will not name the product, or who says only penetrating sealer, is quoting something you cannot evaluate and probably something cheap.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE FOUR QUESTIONS</p>
            <p class="text-xl font-bold text-white mb-3">Which product, at what coverage rate, how many coats, and how is the slab being cleaned?</p>
            <p class="text-gray-300 leading-relaxed m-0">Any competent contractor answers all four without hesitation. A quote with those four answers can be compared against another quote; a quote without them can only be compared on price, which is how the cheap job wins and then fails.</p>
          </div>

          <p>
            Watch for crack repair being priced separately after work begins. Cracks are visible before anyone starts, so a quote that omits them and then adds them is either careless or deliberate. Get repairs itemised up front, and make sure the quote specifies that cracks are filled before sealing rather than sealed over.
          </p>

          <p>
            Finally, ask what happens if it rains within 24 hours of application. A contractor who has thought about this has a policy; one who has not may leave you with a washed-out application and an argument. Rain on fresh sealer is common enough that it should not be an improvised conversation.
          </p>
        </div>

        <div id="peryear" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Cost Per Year of Protection
          </h2>

          <p>
            This is the calculation that changes the decision. Divide the total cost of a sealing job by the years of protection it delivers, and the ranking of the options inverts almost completely. A cheap acrylic bought for its shelf price turns out to be the most expensive way to keep a driveway sealed over a decade.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approach</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per Application</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Life</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per Year</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DIY water-based acrylic</td>
                    <td class="px-4 py-4 text-gray-700">$250</td>
                    <td class="px-4 py-4 text-gray-700">2-3 years</td>
                    <td class="px-4 py-4 text-gray-700">$100-125</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DIY solvent acrylic</td>
                    <td class="px-4 py-4 text-gray-700">$300</td>
                    <td class="px-4 py-4 text-gray-700">3-4 years</td>
                    <td class="px-4 py-4 text-gray-700">$75-100</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DIY silane-siloxane</td>
                    <td class="px-4 py-4 text-gray-700">$386 first, $220 after</td>
                    <td class="px-4 py-4 text-gray-700">6-8 years</td>
                    <td class="px-4 py-4 text-gray-700">$31-55</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pro acrylic</td>
                    <td class="px-4 py-4 text-gray-700">$450</td>
                    <td class="px-4 py-4 text-gray-700">3 years</td>
                    <td class="px-4 py-4 text-gray-700">$150</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pro silane-siloxane</td>
                    <td class="px-4 py-4 text-gray-700">$600</td>
                    <td class="px-4 py-4 text-gray-700">7 years</td>
                    <td class="px-4 py-4 text-gray-700">$86</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Over ten years on a 600 square foot driveway, the water-based acrylic route costs roughly 1,000 to 1,250 dollars in materials and four or five weekends of work. The penetrating sealer route costs around 600 dollars and takes two weekends. The product that looked twice as expensive on the shelf is close to half the price in practice.
          </p>

          <p>
            The comparison holds even against professional application of a good penetrating sealer, which at 86 dollars a year undercuts DIY acrylic. If you were leaning towards a contractor anyway, spending the extra on chemistry rather than on frequency is where the money goes furthest. The lifespan figures behind this table are set out in our guide to <a href='/how-long-does-concrete-sealer-last/'>how long concrete sealer lasts</a>.
          </p>

          <p>
            There is one case where the acrylic still wins on merit rather than price: decorative concrete where colour and sheen are the point. A penetrating sealer does nothing for appearance, so if the reason for sealing is how a stamped patio looks, cost per year is the wrong measure and you should be buying the finish you want.
          </p>
        </div>

        <div id="saving" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Where to Save and Where Not To
          </h2>

          <p>
            Save on the pressure washer. Renting for a one-off job, or borrowing, avoids 200 to 400 dollars of equipment that sits idle for years. Concrete does not need a high-end machine — a mid-range electric unit with a surface cleaner does the work, and the attachment matters far more than the pressure rating.
          </p>

          <p>
            Save by buying in pails rather than gallons, and by sealing the driveway, walkway and patio in the same session. The cleaning and setup time is largely shared, the product is cheaper in bulk, and you only lose one weekend instead of three.
          </p>

          <p>
            Do not save on the chemistry. The gap between a budget acrylic and a quality silane-siloxane is perhaps 150 dollars on a typical driveway and three to five years of protection. That is the worst trade available in this entire job, and it is the one most commonly made because the two products sit side by side on the same shelf.
          </p>

          <p>
            Do not save on prep either. Skipping the degreaser, sealing before the slab has dried, or stretching the product thin to avoid buying one more gallon all cost more than they save, because they shorten the life of the application by years. Every dollar of prep buys more protection than a dollar of product does.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Comparing Sealers on Price per Gallon</h3>
              <p class="text-gray-700 text-sm m-0">
                Coverage and lifespan vary more than price does. Convert everything to cost per square foot per year and the ranking usually inverts — the pail that costs twice as much is often half the price over a decade.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Accepting a One-Line Quote</h3>
              <p class="text-gray-700 text-sm m-0">
                Sealing, $500 tells you nothing about what is going on your slab. Ask for the product name, coverage rate, number of coats and cleaning method in writing. Without those four, you can only compare quotes on price.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting the Equipment on Job One</h3>
              <p class="text-gray-700 text-sm m-0">
                The first DIY seal carries sprayer, cleaner and rental costs the second one does not. Compare first-job DIY against a contractor honestly, then remember that every reseal after that is product-only.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Paying a Minimum Charge for a Small Patio</h3>
              <p class="text-gray-700 text-sm m-0">
                Most contractors have a 250 to 400 dollar minimum. On a 200 square foot patio that is the whole price regardless of the work involved, and it makes DIY dramatically cheaper for small areas.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Letting Crack Repair Be a Surprise</h3>
              <p class="text-gray-700 text-sm m-0">
                Cracks are visible before anyone starts. A quote that omits them and adds them later is a quote you cannot compare. Get repairs itemised up front and specified as filled before sealing, not sealed over.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does it cost to seal a concrete driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                DIY runs about 250 to 400 dollars for a 600 square foot driveway including product and one day of pressure washer rental, or roughly 0.40 to 0.65 dollars per square foot. Professional sealing runs 0.50 to 1.25 dollars per square foot, so 300 to 750 dollars for the same driveway, including cleaning.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is it cheaper to seal concrete yourself?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Usually, and increasingly so with each reseal. The first DIY job carries equipment costs that narrow the gap against a cheap contractor. Once you own a sprayer, a reseal costs only product — around 220 dollars for a two-car driveway against 400 to 700 for a contractor.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much does concrete sealer cost per gallon?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Water-based acrylics run 25 to 45 dollars a gallon, solvent acrylics 35 to 60, and silane-siloxane penetrating sealers 40 to 75. High-solids silanes reach 110. Five-gallon pails cut the per-gallon price by roughly 20 to 30 percent.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why is penetrating sealer so much more expensive?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It carries far more active silane or siloxane content and has to chemically bond inside the pore structure rather than simply dry on the surface. It also covers less per gallon. Against that, it lasts three to four times as long, which makes it cheaper per year of protection.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What should a contractor quote include?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The product name, coverage rate, number of coats, cleaning method, crack repair as a line item, and what happens if it rains within 24 hours. A quote without the first four cannot be compared against any other quote except on price.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Does sealing concrete add value to a house?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It protects value rather than adding it. A sealed driveway resists salt scaling, oil staining and freeze-thaw damage, and a slab that has been maintained looks maintained. The comparison worth making is against the cost of resurfacing or replacing a spalled driveway, which runs into thousands.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is expensive concrete sealer worth it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For exterior flatwork, yes. The price gap between a budget acrylic and a quality silane-siloxane is around 150 dollars on a typical driveway, and it buys three to five extra years. For decorative surfaces where colour and sheen are the objective, an acrylic is the right product regardless of cost per year.
              </p>
            </div>

          </div>
        </div>

