const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "7 Best Dehumidifiers for Mold in 2026: Stop It Coming Back";
const description =
  "The best dehumidifiers for mold prevention in basements, crawl spaces and closets, chosen for continuous drainage, auto restart and cold-room performance.";

