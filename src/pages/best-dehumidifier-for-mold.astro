const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dehumidifier for Mold",
          item: "https://www.thehonestreviewers.com/best-dehumidifier-for-mold/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Does a dehumidifier get rid of mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A dehumidifier lowers humidity so mold cannot grow, and it makes existing mold go dormant, but it does not kill or remove it. Clean small areas of visible growth, remove moldy porous materials such as drywall and carpet, fix the moisture source, and then run the dehumidifier at about 50% to keep mold from returning."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should I keep to prevent mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA recommends keeping indoor relative humidity below 60%, ideally between 30% and 50%. In a basement, aim for about 50% measured by a separate hygrometer near the coldest wall. Cold surfaces have higher humidity than the room air, so a setting just under 60% can still leave walls damp enough for mold to grow."
          }
        },
        {
          "@type": "Question",
          "name": "Will a dehumidifier help with black mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It helps prevent it, not remove it. The mold usually called toxic black mold needs material that stays very wet for a long time, so holding a space at 50% is an effective defense. Existing black mold should be treated like any other visible growth: cleaned or removed, with professional help for areas larger than about 10 square feet."
          }
        },
        {
          "@type": "Question",
          "name": "Can a dehumidifier get rid of a mildew smell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. The musty smell comes from actively growing mold and mildew, and as humidity drops toward 50% that growth slows and the odor typically fades over days to weeks. If the smell lingers or returns when the unit is off, something is staying wet for another reason, such as a leak or condensation, and needs fixing."
          }
        },
        {
          "@type": "Question",
          "name": "What size dehumidifier do I need for mold in a basement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a basement with visible mold spots, sweating pipes or damp wall bases, plan on a 50-pint unit for every 1,000 to 1,500 square feet. A basement that only smells musty can usually manage with a 35-pint unit up to about 1,500 square feet. If in doubt, size up; an undersized unit runs nonstop without reaching its target."
          }
        },
        {
          "@type": "Question",
          "name": "Should I run a dehumidifier all the time to prevent mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Leave it plugged in and set to about 50% rather than on continuous mode. The humidistat runs the compressor only when needed, which saves electricity and still keeps conditions below the mold threshold. Use continuous mode only after a leak or flood, when you want maximum drying for a few days, then switch back to the setpoint."
          }
        },
        {
          "@type": "Question",
          "name": "Is a dehumidifier or an air purifier better for mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. A dehumidifier stops mold growing by removing moisture; a HEPA air purifier captures spores already in the air but does nothing about the damp that lets mold grow. For mold prevention, start with the dehumidifier. Add a HEPA purifier during and after cleanup, or if someone in the house has mold allergies."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "dehumidifier for mold",
      "dehumidifier black mold",
      "dehumidifiers for mold prevention",
      "dehumidifier to get rid of mold",
      "dehumidifier for mildew smell",
      "best dehumidifiers for mold",
      "basement mold dehumidifier"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Dehumidifiers for Mold</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A dehumidifier will not kill mold, but it is the best tool there is for keeping mold from growing back. Here are seven picks for basements, crawl spaces, laundry rooms and closets, chosen for drainage, auto restart and cold-room performance.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#frigidaire-fhdp5033y1-pump"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#mold-basics" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What a Dehumidifier Can and Cannot Do</a>
          <a href="#target-humidity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Humidity Number That Stops Mold</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best, Ranked</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Sizing by Dampness</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Continuous Drainage</a>
          <a href="#auto-restart" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Auto Restart and Power Cuts</a>
          <a href="#cold-spaces" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cold Basements and Crawl Spaces</a>
          <a href="#mildew-smell" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Mildew Smell and Laundry Rooms</a>
          <a href="#existing-mold" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When Mold Is Already There</a>
          <a href="#setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Setup and Maintenance</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Mold grows wherever a surface stays damp, and in most homes that means a basement, a crawl space or a closet on an outside wall. A dehumidifier is how you keep those places below the humidity mold needs, but the features that matter for mold prevention are not the ones on the front of the box. Continuous drainage, automatic restart after a power cut and the ability to keep working in a cool room matter more than the biggest pint number. This guide picks seven units for mold-prone spaces and explains exactly what a dehumidifier can and cannot do once mold has already appeared.
