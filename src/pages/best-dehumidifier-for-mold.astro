              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~84%</p>
                <p class="text-gray-400 text-xs mt-1">RH at a 55°F wall in 70°F, 50% air</p>
              </div>
            </div>
          </div>
        </div>

