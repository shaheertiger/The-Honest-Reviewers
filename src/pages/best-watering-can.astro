const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Watering Cans in 2026: Indoor, Outdoor and Galvanized";
const description =
  "The best watering cans for indoor plants, seedlings and beds, compared on capacity vs full weight, brass vs plastic roses, spout length and galvanized steel";

const PRODUCTS = [
  {
    "id": "haws-cradley-deluxe",
