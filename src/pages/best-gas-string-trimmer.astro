---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best String Trimmers",
    "url": "/best-string-trimmer/"
  },
  {
    "title": "Best Battery String Trimmers",
    "url": "/best-battery-string-trimmer/"
  },
  {
    "title": "Best Weed Eaters",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Best Gas Lawn Mowers",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "Best Leaf Blowers",
    "url": "/best-leaf-blower/"
  },
  {
    "title": "Best Hedge Trimmers",
    "url": "/best-hedge-trimmer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "Best Gas String Trimmer in 2026: 7 Picks by Shaft and Engine";
const description =
  "Engine type comes first, because it decides how you fuel the trimmer. Seven gas string trimmers and weed eaters compared on 2 vs 4-cycle, shaft shape, head and attachments.";

const PRODUCTS = [
  {
    "id": "husqvarna-330lk",
    "name": "Husqvarna 330LK Gas String Trimmer",
    "category": "Straight Shaft, 18 or 20-inch Cut, Attachment Capable, Rapid Replace Head",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Adjustable cut: 20 inches for open areas or 18 inches for more power in thick growth",
      "Attachment capable, with a detachable shaft for click-on tools (sold separately)",
      "Rapid Replace head reloads by aligning, loading and twisting",
      "Spring-assisted start that Husqvarna says is 30% easier to pull, plus Air Purge",
      "LowVib anti-vibration system and a comfortable handle"
    ],
    "cons": [
      "Attachments cost extra",
      "Heavier than the small curved-shaft picks",
      "The listing does not state engine displacement"
    ],
    "bottomLine": "The best gas string trimmer for larger properties: a wide adjustable cut, easy starting and the option to add a pole saw or edger later.",
    "description": "The Husqvarna 330LK is the gas trimmer we would buy for a larger yard, a fence line or a property with ditches and rough edges, because it combines a wide cut with the flexibility to grow into other jobs. Its listing describes a customizable cutting width: 20 inches for covering large areas quickly, or 18 inches for maximum power in thick vegetation. It is attachment capable, with a detachable shaft that takes a range of click-on tools, so the same engine can later run an edger, a pole saw or a hedge trimmer attachment, each sold separately. The Rapid Replace head reloads line by aligning, loading and twisting, without taking the head apart. Husqvarna's spring-assisted starter is listed as 30 percent easier to pull, and Air Purge clears air from the carburetor and fuel system before you start, while the stop switch resets automatically. LowVib anti-vibration technology and a comfortable handle cut fatigue on long sessions. The trade-offs are weight and cost. A straight-shaft, attachment-capable trimmer is heavier than the curved-shaft Husqvarna 122C, the attachments add up, and the listing does not state the engine displacement. Buy the Husqvarna 525L instead for a lighter straight shaft without attachments, or the 130C for a curved shaft."
  },
  {
    "id": "husqvarna-525l",
    "name": "Husqvarna 525L Gas String Trimmer",
    "category": "Straight Shaft, 25.4cc X-Torq 2-Cycle, 17-inch Cut, Tap-n-Go Head",
    "badge": "Best Straight Shaft",
    "amazonUrl": "#",
    "pros": [
      "25.4cc X-Torq 2-cycle engine, designed for power at low RPM, per Husqvarna",
      "Straight shaft reaches under shrubs and along fences",
      "Smart Start, with a stop switch that resets itself to on",
      "Choke and purge controls for easy starting",
      "Tap-n-Go head is easy to use and refill"
    ],
    "cons": [
      "17-inch cut, narrower than the 330LK",
      "Not attachment capable",
      "2-cycle, so you mix oil with the fuel"
    ],
    "bottomLine": "A pro-leaning straight-shaft trimmer for everyday edges and tight spots, built around Husqvarna's efficient X-Torq engine.",
    "description": "The Husqvarna 525L sits between homeowner and professional trimmers, and it is the straight-shaft model to buy if you want reach and a strong engine without paying for attachment capability. Its 25.4cc 2-cycle engine uses Husqvarna's X-Torq design, which the listing says maximizes power even at low RPM, and an efficient air filter that reduces engine wear. The straight shaft is the right shape for trimming under shrubs, along fence lines and around posts, where a curved shaft makes you stoop. The listing describes a 17-inch cutting width suited to everyday trimming in areas a mower cannot reach. Starting is straightforward: Smart Start technology is designed for easy starts, the stop switch resets itself to the on position so it is ready next time, and intuitive choke and purge controls take the guesswork out of a cold start. The Tap-n-Go head feeds line when you tap it on the ground and is easy to refill. The trade-offs: a 17-inch cut is narrower than the 330LK's adjustable 18 to 20 inches, it does not take attachments, and as a 2-cycle engine it runs on mixed fuel. Buy the 330LK instead if you want to add a pole saw or edger, or the Troy-Bilt TB25SB for a lower-cost straight shaft."
  },
  {
    "id": "husqvarna-130c",
    "name": "Husqvarna 130C Gas String Trimmer",
    "category": "Curved Shaft, 28cc 2-Cycle, 17-inch Cut, Tap N' Go Head, Digital Ignition",
    "badge": "Best Curved Shaft",
    "amazonUrl": "#",
    "pros": [
      "28cc 2-cycle engine, the largest stated displacement among the curved picks",
      "Curved shaft is easy to maneuver around obstacles",
      "Digital ignition for easier starting in different weather, per the listing",
      "Smart Start and Air Purge",
      "Heavy-duty twin-line Tap N' Go head with LowVib anti-vibration"
    ],
    "cons": [
      "Curved shafts reach less well under shrubs",
      "Not attachment capable",
      "Heavier than the 22cc 122C"
    ],
    "bottomLine": "The curved-shaft trimmer for typical suburban yards: easy to handle, quick to start and strong enough for thick grass.",
    "description": "Curved-shaft trimmers are easier to control for most homeowners, because the head sits closer and the balance is more natural, and the Husqvarna 130C is the strongest curved-shaft pick here. Its listing gives a 28cc 2-cycle engine, more than the 122C's 22cc, with a 17-inch cutting width for working around beds, trees, mailboxes and fences. Husqvarna lists digital ignition for easier starting in various weather conditions, which helps on cold spring mornings, and pairs it with Smart Start, designed to start quickly with minimum effort, and Air Purge, which removes air from the carburetor and fuel system. The heavy-duty twin-line Tap N' Go head feeds fresh line when you tap it on the ground. A comfortable handle and LowVib anti-vibration technology reduce fatigue over a full yard. The trade-offs are typical of curved shafts. The shape makes it less effective at reaching under shrubs and decks than a straight shaft, it does not take attachments, and the larger engine makes it heavier than the 122C. Buy the 525L or 330LK instead if you trim long fence lines or under shrubs, or the 122C if you want the lightest, quietest option. For most suburban lots, though, the 130C is the comfortable middle ground."
  },
  {
    "id": "echo-srm-2620",
    "name": "ECHO SRM-2620 X Series Straight Shaft String Trimmer",
    "category": "Professional Grade, 25.4cc, Straight Shaft",
    "badge": "Best Pro Grade",
    "amazonUrl": "#",
    "pros": [
      "Part of ECHO's professional X Series line",
      "25.4cc engine, per the listing",
      "Straight shaft for reach under shrubs and along fences",
      "Genuine ECHO unit, per the listing",
      "ECHO is a long-established professional landscaping brand"
    ],
    "cons": [
      "The Amazon listing gives very few specifications",
      "Check cutting width, weight and warranty on ECHO's own spec sheet",
      "Pro-grade pricing"
    ],
    "bottomLine": "For heavy, regular use: a professional-series straight shaft from ECHO, if you confirm the full specs with ECHO before buying.",
    "description": "ECHO is one of the brands landscaping crews use every day, and the SRM-2620 belongs to its professional X Series. The Amazon listing describes it as a brand-new, genuine ECHO SRM-2620 X Series straight-shaft string trimmer with a 25.4cc engine. For homeowners with large properties, acreage, long fence lines or ditches that need trimming every week, a pro-series trimmer is built for many more hours of use than a typical homeowner model, and its straight shaft gives the reach that heavy trimming needs. The honest caveat is the listing itself. Beyond the model number, engine size and X Series description, it gives almost no detail: no cutting width, no weight, no starting system and no warranty terms. ECHO publishes full specifications for the SRM-2620 on its own website, so check them there before buying, and make sure the seller is an authorized ECHO dealer if warranty coverage matters to you. Professional trimmers also cost more than homeowner models and are designed for users who run them often enough to justify it. Buy the Husqvarna 525L instead for a strong straight shaft with full details on the listing, or the 330LK if you want attachments. Most homeowners do not need pro grade; it pays off only with frequent, heavy use."
  },
  {
    "id": "ryobi-25cc-curved-attachment-capable",
    "name": "RYOBI 25cc 2-Stroke Attachment Capable Curved Shaft Gas String Trimmer",
    "category": "Curved Shaft, 25cc Full Crank, Attachment Capable, 17-inch Cut, Dual 0.095-inch Line",
    "badge": "Best Budget Attachment-Capable",
    "amazonUrl": "#",
    "pros": [
      "Attachment capable: accepts universal brand-fit attachments, per the listing",
      "Full crank engine that RYOBI says gives twice the life",
      "Zip start carburetor for easier starting",
      "Reel-easy bump-feed head for faster reloads",
      "17-inch maximum cutting path with dual 0.095-inch line"
    ],
    "cons": [
      "Curved shaft limits reach under shrubs",
      "Mid-range build compared with Husqvarna and ECHO",
      "2-cycle fuel mixing required"
    ],
    "bottomLine": "The low-cost way into an attachment system: a curved-shaft trimmer that accepts universal edger, pole saw and blower attachments.",
    "description": "Attachment-capable trimmers let one engine run several tools, and the RYOBI 25cc curved-shaft model is the most affordable way into that idea on this list. Its listing says it accepts universal brand-fit attachments, so it can work with compatible edgers, pole saws, cultivators and hedge trimmer attachments, not only RYOBI's own. The 25cc 2-stroke engine is a full crank design, which RYOBI says gives twice the life of the alternative, and a zip start carburetor is listed for easier starting. A reel-easy bump-feed head speeds up reloading and runs dual 0.095-inch line, a heavier line than many homeowner trimmers use, which holds up better against thick weeds. The listing gives a 17-inch maximum cutting path, and the curved shaft is designed for lighter trimming with less fatigue. RYOBI also sells a straight-shaft version of the same trimmer if you need more reach. The trade-offs: the curved shaft does not reach under shrubs as well as a straight one, the build is mid-range rather than professional, and it runs on mixed 2-cycle fuel. Buy the Husqvarna 330LK instead if you want a stronger attachment-capable trimmer with an adjustable cut, or the Troy-Bilt if you do not need attachments. Check that any attachment you buy is listed as compatible before ordering."
  },
  {
    "id": "troy-bilt-tb25sb",
    "name": "Troy-Bilt TB25SB Gas String Trimmer",
    "category": "Straight Shaft, 25cc 2-Cycle, 16-inch Cut, SpringAssist",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "25cc lightweight 2-cycle engine, per the listing",
      "SpringAssist for easier pull starts",
      "Straight shaft reaches under shrubs and around fence posts",
      "Multi-position adjustable handle reduces vibration and fatigue",
      "16-inch cutting swath"
    ],
    "cons": [
      "16-inch cut is the narrowest here",
      "Basic features compared with Husqvarna",
      "Not attachment capable"
    ],
    "bottomLine": "A simple, affordable straight-shaft gas trimmer for small to medium yards.",
    "description": "Not every yard needs a pro-grade trimmer, and the Troy-Bilt TB25SB covers the basics for less. Its listing describes a lightweight 25cc 2-cycle engine that it says is comfortable for everyone, and SpringAssist technology that makes the pull start easier, which matters for anyone who has fought a stubborn trimmer cord. It is a straight-shaft model, and Troy-Bilt points out that straight shafts reach more easily under shrubs, around fence posts and past other obstacles, which is the main reason to choose one over a curved shaft. A multi-position adjustable handle lets you set a comfortable grip and reduces vibration and fatigue, and the 16-inch cutting swath is enough for edges, beds and the strips a mower misses in a typical suburban yard. The trade-offs are what you would expect at a lower price. The 16-inch cut is the narrowest on this list, so large properties take longer, the feature set is basic compared with Husqvarna's Air Purge and LowVib systems, and it does not take attachments. Like every gas trimmer here, it runs on mixed 2-cycle fuel. Buy the Husqvarna 525L instead for a stronger straight shaft, or the RYOBI if you want attachment capability at a similar budget."
  },
  {
    "id": "husqvarna-122c",
    "name": "Husqvarna 122C Gas String Trimmer",
    "category": "Curved Shaft, 22cc 2-Cycle Low-Noise Engine, 17-inch Cut, Tap N' Go Head",
    "badge": "Lightest and Quietest",
    "amazonUrl": "#",
    "pros": [
      "22cc engine, the smallest here, for a lighter trimmer",
      "Low-noise engine design, per Husqvarna",
      "17-inch cutting width",
      "Smart Start and Air Purge for easy starts",
      "Heavy-duty twin-line Tap N' Go head"
    ],
    "cons": [
      "Least power for thick weeds and brush",
      "Curved shaft limits reach under shrubs",
      "Not attachment capable"
    ],
    "bottomLine": "The easiest gas trimmer here to carry and start: small, quieter and suited to small yards and tidy edges.",
    "description": "For a small yard where trimming means edges, beds and around the house, a big engine is extra weight you carry for no reason, and the Husqvarna 122C is the light option. Its 22cc 2-cycle engine is the smallest on this list, and Husqvarna describes it as a low-noise design that reduces extra engine noise, which your neighbors will appreciate on a weekend morning. The listing gives a 17-inch cutting width, the same as the larger 130C, so you give up power rather than coverage. Starting is easy: Smart Start technology pairs a specially designed engine and starter for fast starts with minimum effort, and Air Purge removes air from the carburetor and fuel system before you pull. The curved shaft makes it easy to maneuver around obstacles, and the heavy-duty twin-line Tap N' Go head feeds line with a tap on the ground. The trade-offs come with the small engine. It has the least power here for thick weeds, overgrown fence lines and light brush, the curved shaft limits reach under shrubs, and it does not take attachments. Buy the Husqvarna 130C instead if your yard has heavier growth, or consider a battery trimmer from our battery string trimmer guide if quiet is your main goal."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gas String Trimmers",
          item: "https://www.thehonestreviewers.com/best-gas-string-trimmer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best gas string trimmer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Husqvarna 330LK is the best gas string trimmer for larger yards: an adjustable 18 or 20-inch cut, attachment capability, a Rapid Replace head and an easier spring-assisted start. The Husqvarna 525L is the best simpler straight shaft, the 130C the best curved shaft, and the Troy-Bilt TB25SB the best budget pick."
          }
        },
        {
          "@type": "Question",
          "name": "Is a straight or curved shaft weed eater better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Straight shafts reach under shrubs, decks and fence rails better and suit taller users and larger properties. Curved shafts are lighter, shorter and easier to balance, which suits smaller yards and shorter users. If you trim long fence lines or under bushes, choose straight."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a 2-cycle and 4-cycle trimmer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2-cycle trimmer runs on gasoline mixed with 2-cycle oil and is lighter and simpler. A 4-cycle trimmer runs on straight gasoline with separate engine oil, so there is no mixing, but it is heavier and needs oil changes. Every trimmer in this guide is 2-cycle."
          }
        },
        {
          "@type": "Question",
          "name": "What size gas trimmer do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For edges, beds and walkways in a typical yard, a 22cc to 25cc engine like the Husqvarna 122C or Troy-Bilt TB25SB is enough. For thick weeds, overgrown fence lines and larger properties, choose 25cc to 28cc, like the Husqvarna 525L, 130C or ECHO SRM-2620."
          }
        },
        {
          "@type": "Question",
          "name": "Are gas string trimmers better than battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gas trimmers are better for long sessions, thick growth and large properties, because they run as long as you have fuel. Battery trimmers are quieter, start instantly and need almost no maintenance, which suits typical suburban yards. Choose by yard size and how long you trim."
          }
        },
        {
          "@type": "Question",
          "name": "Why won't my gas trimmer start?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common cause is stale or incorrectly mixed fuel. Drain old fuel, refill with fresh gasoline mixed at the ratio in your manual, purge the bulb and use the choke for a cold start. A clogged air filter or fouled spark plug are the next things to check."
          }
        },
        {
          "@type": "Question",
          "name": "What fuel does a gas string trimmer use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "2-cycle trimmers use gasoline mixed with 2-cycle engine oil, usually at 50:1; check your manual for the exact ratio. Use fresh fuel, avoid storing mixed fuel for months, and add fuel stabilizer if it will sit. Pre-mixed canned fuel is a convenient alternative."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn & Yard Care",
    tags: [
      "gas string trimmer",
      "best gas string trimmer",
      "best gas weed eater",
      "gas weed wacker",
      "gas powered weed trimmer",
      "straight shaft gas trimmer",
      "2 cycle string trimmer"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Gas String Trimmers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          For long fence lines, thick weeds and bigger yards, gas still wins. Engine type is the first choice, because 2-cycle or 4-cycle decides how you fuel it. Then match the shaft to your yard. Seven gas trimmers, chosen on shaft, engine and how easily they reload.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#husqvarna-330lk"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Straight or Curved?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#two-vs-four" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. 2-Cycle vs 4-Cycle</a>
          <a href="#shaft" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Straight vs Curved Shaft</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Gas String Trimmers</a>
          <a href="#engine-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Engine Size</a>
          <a href="#gas-vs-battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Gas vs Battery</a>
          <a href="#heads" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Trimmer Heads and Line</a>
          <a href="#starting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Starting and Upkeep</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Safety Gear</a>
          <a href="#attachments" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Attachment-Capable Trimmers</a>
          <a href="#edging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Edging</a>
          <a href="#thick-weeds" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Thick Weeds and Brush</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Trimming Technique</a>
          <a href="#season-care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. Season Maintenance</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">14. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">15. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
