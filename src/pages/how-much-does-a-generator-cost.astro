                    <td class="px-4 py-4 text-gray-700">$4,000+</td>
                    <td class="px-4 py-4 text-gray-700">Farms, long runtimes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Home standby (installed)</td>
                    <td class="px-4 py-4 text-gray-700">10-26 kW</td>
                    <td class="px-4 py-4 text-gray-700">$6,500-$15,000+</td>
