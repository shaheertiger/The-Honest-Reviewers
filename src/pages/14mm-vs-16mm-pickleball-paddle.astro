                    <td class="px-4 py-4 text-gray-700">Doubles dinkers, resets, newer players</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">20mm</td>
                    <td class="px-4 py-4 text-gray-700">Very muted, very stable</td>
