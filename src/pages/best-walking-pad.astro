---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Weight Benches",
    "url": "/best-weight-bench/"
  },
  {
    "title": "Best Home Gym Equipment on a Budget",
    "url": "/best-home-gym-equipment-on-a-budget/"
  },
  {
    "title": "Best Garage Floor Mats",
    "url": "/best-garage-floor-mat/"
  },
  {
    "title": "Best Garage Floor Tiles",
    "url": "/best-garage-floor-tiles/"
  },
  {
    "title": "Best Garage Heaters",
    "url": "/best-garage-heater/"
  },
  {
    "title": "Best Pickleball Shoes",
    "url": "/best-pickleball-shoes/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "7 Best Walking Pads: Under-Desk Treadmills for Real Workdays";
const description =
  "The best walking pads and under-desk treadmills, compared on rated weight limit, speed range, belt size, folding and daily run time, with picks for every desk.";

const PRODUCTS = [
  {
    "id": "walkingpad-z1",
    "name": "WalkingPad Z1 Folding Walking Pad",
    "badge": "Best Overall",
    "category": "Folding, 1-4 mph, 242 lb rating",
    "amazonUrl": "#",
    "description": "The WalkingPad Z1 is the walking pad we would point most desk walkers toward, because it gets the basics right without asking for much floor. WalkingPad's own listing gives a 1 to 4 mph speed range, a 242 lb (110 kg) user rating and a walking area of about 47.6 by 15.7 inches, which is longer than many budget pads and gives a natural stride more room. It weighs about 51 lb and, per the spec sheet, folds to roughly 31.8 by 22 by 5.4 inches, so it slides under a sofa or stands in a closet between workdays. The one figure to treat carefully is the motor: different versions of WalkingPad's own page list it as 0.75 HP and as 2.25 HP brushless, and the lower number is most likely the continuous rating. For walking at 1.5 to 3 mph that is enough, but it is a reason not to buy a Z1 for jogging.",
    "pros": [
      "WalkingPad lists a 47.6 x 15.7 in walking area, longer than many compact pads",
      "242 lb (110 kg) rating on the official listing",
      "Folds to about 5.4 in tall for storage",
      "1-4 mph range covers every realistic desk-walking pace"
    ],
    "cons": [
      "Motor rating is listed inconsistently (0.75 HP vs 2.25 HP) on the brand's own pages",
      "Top speed of 4 mph rules out jogging",
      "Folding design adds a hinge you need to keep clean"
    ],
    "bottomLine": "For most people walking at a standing desk, the Z1 balances belt length, weight rating and storage better than anything else here."
  },
  {
    "id": "lifespan-tr1200-glowup",
    "name": "LifeSpan TR1200-GlowUp (TR1200-DT3) Under Desk Treadmill",
    "badge": "Best for All-Day Use",
    "category": "Non-folding, 0.4-4 mph, 350 lb rating",
    "amazonUrl": "#",
    "description": "The LifeSpan TR1200-GlowUp, sold for years as the TR1200-DT3, is the pick for people who plan to walk most of the workday. LifeSpan's spec sheet lists a 20 by 50 inch belt, a 114 lb deck and a default belt speed of 0.4 to 2.0 mph that can be set up to 4.0 mph, which tells you exactly what it was designed for: slow, long sessions under a desk. Retailers list a 350 lb user rating, and most sources describe the motor as a 2.25 HP continuous-duty unit, with one review noting it is built to support walking up to about four hours a day. It does not fold, it is heavy, and it costs several times what a budget pad does; reviews and retailers have quoted prices from about $999 to $1,299, so check the current one. The warranty on LifeSpan's sheet is a lifetime frame with multi-year parts and labor coverage, while one third-party site lists shorter terms, so confirm it at purchase.",
    "pros": [
      "20 x 50 in belt is the widest and longest of our desk-walking picks",
      "350 lb user rating per retailers",
      "Built around a long-session duty cycle",
      "Default speed range is tuned for desk walking"
    ],
    "cons": [
      "Does not fold, and the deck weighs about 114 lb",
      "Costs far more than folding pads",
      "Warranty terms differ between the spec sheet and third-party listings"
