---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Fuel Stabilizers",
    "url": "/best-fuel-stabilizer/"
  },
  {
    "title": "Best Dual Fuel Inverter Generators",
    "url": "/best-dual-fuel-inverter-generator/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Best Tri-Fuel Generators",
    "url": "/best-tri-fuel-generator/"
  },
  {
    "title": "Best Generator Covers",
    "url": "/best-generator-cover/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Best Gas Can in 2026: 7 Picks That Pour Without Spilling";
const description =
  "A gas can should pour without spilling and seal in vapor. Seven picks from Scepter plastic to Eagle steel safety cans and Wavian, with EPA and CARB rules and safe storage.";

const PRODUCTS = [
  {
    "id": "scepter-smartcontrol-5-gal",
    "name": "Scepter 5 Gallon Gas Can with SmartControl Spout (FSCG552)",
    "category": "5 Gal Plastic, EPA/CARB Compliant, Flame Mitigation Device, Up to 3 GPM",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "EPA/CARB and child-safety compliant, per the listing",
      "SmartControl spout: squeeze less for a little, more for a lot",
      "Integrated spout vent and funnel for flows up to 3 gallons per minute",
      "Flame mitigation device helps prevent internal vapor ignition",
      "5-layer construction designed to prevent vapor leaks"
    ],
    "cons": [
      "Squeeze-to-pour takes practice",
      "Plastic, so not the choice for long-term storage near heat",
      "Gasoline only; diesel needs the yellow version"
    ],
    "bottomLine": "The best gas can for most homes: compliant, quick to pour and easy to control, for generators, mowers and outage fuel.",
    "description": "Modern gas cans have a reputation for slow, awkward spouts, and the Scepter SmartControl is the one that fixes it best for most people. Its listing describes a 5-gallon, EPA and CARB compliant can with a SmartControl spout: squeeze gently for a little fuel or harder for a lot, so you can top up a small generator tank without overflowing it. An integrated air vent in the spout and an included funnel are listed as allowing flow of up to 3 gallons per minute, far faster than the trickle many compliant cans manage. The funnel has a storage ring so it does not get lost. Safety details matter for a can that sits in a garage for outage season: Scepter lists a flame mitigation device that helps prevent internal vapor ignition, child-safety compliance, and a 5-layer construction that prevents vapor leaks and, by Scepter's account, preserves gasoline longer. It measures 15.25 by 10 by 12 inches, with a rear handle for pouring. The trade-offs: the squeeze-to-pour spout takes a few uses to learn, plastic is not ideal near heat sources, and this red version is for gasoline only, with a yellow version for diesel. Buy the Eagle Type I steel can instead if you store fuel long term in a workshop."
  },
  {
    "id": "no-spill-1405-2-5-gal",
    "name": "No-Spill 1405 2.5 Gallon Gas Can",
    "category": "2.5 Gal Plastic, Thumb-Button Control, 7/8-in Spout, Built-In Screen",
    "badge": "Best Small Can",
    "amazonUrl": "#",
    "pros": [
      "Thumb button for precise pouring",
      "7/8-inch spout fits small equipment fuel openings",
      "Attached dust cover keeps the spout clean",
      "Integrated 20-mesh stainless steel screen",
      "Compact: 13.5 inches tall and 10 inches long"
    ],
    "cons": [
      "2.5 gallons runs out fast for a generator",
      "The listing does not state EPA/CARB compliance",
      "Plastic body"
    ],
    "bottomLine": "A compact, precise can for mowers, trimmers and blowers, with a screen that keeps debris out of small engines.",
    "description": "A 5-gallon can is heavy and clumsy for topping up a string trimmer or leaf blower, which is where the No-Spill 1405 earns its place. It holds 2.5 gallons and measures 13.5 inches tall by 10 inches long, small enough to lift with one hand while you pour. Pouring is controlled by a thumb button, so fuel only flows while you press it, and the 7/8-inch spout is narrow enough to fit the small fuel openings on trimmers, chainsaws and blowers without a funnel. Two details make it better than a basic can for small engines. An attached dust cover keeps grit off the spout between uses, and an integrated 20-mesh stainless steel screen catches debris before it reaches a tiny carburetor, which is where small-engine problems usually start. It suits a separate can for 2-cycle mix, too, so mixed fuel never ends up in a 4-cycle mower. The trade-offs: 2.5 gallons runs out quickly when feeding a generator through an outage, the listing does not state EPA or CARB compliance, so check your state's rules, and it is a plastic can rather than steel. Buy the Scepter 5-gallon instead for generator fuel, or the Midwest 2-gallon if you need a CARB-compliant small can."
  },
  {
    "id": "eagle-type-i-5-gal-red",
    "name": "Eagle Type I 5 Gallon Safety Gas Can (UI50S)",
    "category": "Galvanized Steel, Type I, Flame Arrester, Self-Closing Lid, OSHA/NFPA, FM/UL Approved",
    "badge": "Best Steel Safety Can",
    "amazonUrl": "#",
    "pros": [
      "Hot-dipped 24-gauge galvanized steel with a baked powder coat",
      "Non-sparking flame arrester helps prevent ignition and flame spread",
      "Self-closing gasketed cap vents vapor automatically",
      "Meets OSHA 1910.106 and NFPA 30; FM, UL and ULC approved, per the listing",
      "Made in the USA"
    ],
    "cons": [
      "Single opening is slower to pour without a funnel",
      "The listing cites OSHA and NFPA, not EPA/CARB: check rules in CARB states",
      "Heavier than plastic"
    ],
    "bottomLine": "A workshop-grade steel safety can for storing gasoline safely, from a long-established US maker.",
    "description": "If you keep gasoline in a garage or shop for weeks at a time, a steel safety can is the sturdiest way to do it, and the Eagle UI50S is a classic. It is a Type I safety can, meaning a single opening for both filling and pouring, made in the USA from hot-dipped 24-gauge galvanized steel with a baked-on powder coat that resists rust, dents, scratches and fading. The safety features are what set steel safety cans apart. A non-sparking flame arrester in the opening helps prevent the fuel inside from igniting and stops flames from spreading into the can, and the gasketed spout cap closes itself to prevent leaks and opens automatically to vent pressure from vapors. Eagle lists a fixed handle and a double interlock, no-weld bottom seam. The listing says it meets OSHA standard 1910.106 and NFPA code 30, and is FM, UL and ULC approved. Two cautions. A single opening pours more slowly without a funnel, and the listing cites workplace and fire-code standards rather than EPA or CARB, so if you live in California or another state with CARB rules for consumer fuel containers, check that it is allowed for your use. It is also heavier than plastic. Buy the Justrite Type I instead for a counterbalanced handle, or the Scepter for easier pouring."
  },
  {
    "id": "justrite-type-i-5-gal",
    "name": "Justrite Type I 5 Gallon Gasoline Safety Can",
    "category": "Galvanized Steel, Type I, Stainless Flame Arrester, Self-Closing Lid, FM/UL/TÜV",
    "badge": "Best for Controlled Pouring",
    "amazonUrl": "#",
    "pros": [
      "Counterbalanced swinging handle and bottom lip for controlled pouring",
      "24-gauge galvanized steel, leak tested, with a chemical-resistant powder coat",
      "Stainless steel flame arrester helps reduce flashback ignition",
      "Self-closing lid with automatic positive-pressure relief",
      "FM Approved, UL/ULC Listed and TÜV Certified, per the listing"
    ],
    "cons": [
      "Built for workshops and industry, so priced accordingly",
      "Standards cited are OSHA/NFPA, not EPA/CARB",
      "Heavier than plastic cans"
    ],
    "bottomLine": "An industrial-grade steel safety can that pours more steadily than most, for serious fuel storage.",
    "description": "Justrite is a leading name in industrial flammable-liquid storage, and its Type I gasoline safety can brings that build to a home garage or workshop. The listing describes 24-gauge galvanized steel with a chemical-resistant powder-coat finish, and says each can is leak tested. Where it stands out is pouring control. A counterbalanced swinging handle and an integrated bottom lip let you tip and pour steadily with two hands, which matters with a full five gallons and a generator's fill opening at knee height. The safety system follows the Type I pattern: a stainless steel flame arrester helps reduce the risk of flashback ignition when handling fuel, and a self-closing lid with automatic positive-pressure relief limits vapor release and pressure buildup as the can warms and cools. Justrite lists it as FM Approved, UL/ULC Listed and TÜV Certified, designed to support compliance with OSHA and NFPA requirements. The trade-offs are cost and the standards it targets. It is an industrial product priced accordingly, it is heavier than plastic, and like the Eagle its listing cites workplace standards rather than EPA or CARB rules for consumer containers, so check local rules in CARB states. Buy the Eagle UI50S instead for a similar steel can, or the Scepter for everyday refilling."
  },
  {
    "id": "surecan-5-gal-type-ii",
    "name": "SureCan 5 Gallon Type II Safety Can",
    "category": "5 Gal, Rotating Spout, Thumb Trigger, Self-Venting, 3-Year Warranty",
    "badge": "Easiest Pouring",
    "amazonUrl": "#",
    "pros": [
      "Downward-rotating spout pours without lifting and tipping the can",
      "Thumb trigger for controlled dispensing",
      "Self-venting design for steadier flow and less splashing",
      "5-gallon capacity",
      "3-year limited warranty, per the listing"
    ],
    "cons": [
      "This yellow listing describes a general utility container; check fuel type and compliance",
      "Bulkier than standard cans",
      "Costs more than basic plastic cans"
    ],
    "bottomLine": "The can that solves the lift-and-tip problem: its spout rotates down so you pour from the bottom.",
    "description": "The hardest part of using a full 5-gallon can is lifting 30-plus pounds and tipping it over a fuel opening. SureCan's design avoids that: the spout sits at the bottom of the can and rotates downward, so you set the can above the tank, aim the spout and squeeze the thumb trigger to dispense. That makes it much easier to refill a generator, mower or ATV without spilling, especially for anyone who finds lifting a full can difficult. The listing describes a Type II design, meaning separate fill and pour openings, with a self-venting mechanism for steady flow and less splashing, and a 5-gallon capacity. SureCan backs it with a three-year limited warranty. The caution is about this specific listing. It describes the yellow can as a general utility container for household, workshop, indoor and outdoor use, and does not spell out which fuel it is for or whether it is EPA or CARB compliant. Yellow conventionally marks diesel. SureCan sells red gasoline versions too, so check the color, intended fuel and compliance on the listing before you order. It is also bulkier than a standard can and costs more. Buy the Scepter instead for a compliant gasoline can at a lower price, or the Justrite for steel storage."
  },
  {
    "id": "midwest-can-2310-2-gal",
    "name": "Midwest Can 2310 Safe-Flo 2 Gallon Gas Can",
    "category": "2 Gal HDPE, Auto Shut-Off Quick-Flow Spout, FlameShield, CARB/EPA",
    "badge": "Best Small Compliant Can",
    "amazonUrl": "#",
    "pros": [
      "Quick-Flow spout listed at 2.5x faster flow with auto shut-off",
      "FlameShield system: internal flame mitigation plus a vapor-locking spout",
      "Meets CARB and EPA standards, per the listing",
      "HDPE with barrier materials to limit hydrocarbon emissions",
      "Holds 2 gallons plus 8 ounces for oil mixes"
    ],
    "cons": [
      "2 gallons is small for generator use",
      "1-year warranty",
      "Plastic body"
    ],
    "bottomLine": "A compliant small can with an auto shut-off spout, ideal for mowers, trimmers and 2-cycle mix.",
    "description": "The Midwest Can 2310 is the small can to choose if you need CARB and EPA compliance and want to avoid overfilling small engines. Its listing says it holds 2 gallons plus 8 ounces, which leaves room to add 2-cycle oil to a full 2 gallons of gas, and that it meets CARB and EPA standards. The headline feature is the Quick-Flow spout. Midwest lists it as 2.5 times faster than standard spouts, with an automatic shut-off that stops flow when the tank is full, and an automatic closing valve that seals the spout between uses. Together, those features deal with the two common complaints about compliant cans: slow flow and spills. Midwest's FlameShield system pairs an internal flame mitigation device with the vapor-locking spout for a double layer of protection, and the can is made from HDPE plastic with barrier materials that Midwest says virtually eliminate hydrocarbon emissions. An ergonomic handle helps with control. The trade-offs: 2 gallons is too small to keep a generator running through an outage, the warranty is one year, and it is plastic rather than steel. Buy the Scepter 5-gallon instead for generator fuel, or the No-Spill 2.5-gallon for a slightly larger small can."
  },
  {
    "id": "wavian-nato-jerry-can-10l",
    "name": "Wavian NATO Jerry Can and Spout System, 10 Liter",
    "category": "Steel Jerry Can, 2.6 Gal, EPA & CARB Compliant (EO G-14-079B-1), Bayonet Spout",
    "badge": "Best Jerry Can",
    "amazonUrl": "#",
    "pros": [
      "0.9 mm cold-rolled steel with anti-corrosion coating",
      "EPA and CARB compliant, with executive order number G-14-079B-1 on the listing",
      "Bayonet quick-release nozzle with a safety lock",
      "NATO-style design built for rough use",
      "Compact 2.6-gallon size fits vehicle mounts"
    ],
    "cons": [
      "2.6 gallons only in this size",
      "Costs more per gallon than plastic",
      "Spout must be stored separately"
    ],
    "bottomLine": "A rugged, compliant steel jerry can for vehicles, trips and emergency fuel.",
    "description": "Jerry cans have been the standard for rugged fuel storage since the military designs of the 1940s, and Wavian's NATO-style cans are among the best-known modern versions. This 10-liter can holds 2.6 gallons and is built from 0.9 mm cold-rolled steel with an anti-corrosive coating, so it stands up to being strapped to a truck, trailer or off-road vehicle. Importantly for buyers in California and other CARB states, the listing states it is EPA and CARB compliant and gives its executive order number, G-14-079B-1, which is the reference that shows a fuel container is approved. Fuel transfer uses a bayonet-style quick-release nozzle with a safety lock, designed for spill-free pouring, and the classic jerry can shape, with three handles, makes it easy to carry and stack. For outage planning, a couple of steel jerry cans store neatly and resist the damage that cracks old plastic cans. The trade-offs: this size holds only 2.6 gallons, steel costs more per gallon of capacity than plastic, and the spout is a separate piece that needs storing. Wavian also sells a larger 20-liter version. Buy the Scepter 5-gallon instead if you mainly refill a generator at home, or the Eagle Type I for workshop storage."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gas Cans",
          item: "https://www.thehonestreviewers.com/best-gas-can/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best gas can?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the Scepter 5-gallon SmartControl is the best gas can. Its listing states EPA/CARB compliance, a flame mitigation device and a controllable spout that pours up to 3 gallons per minute with the included funnel. For workshop storage, the Eagle Type I steel safety can is the sturdiest choice."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best 5 gallon gas can?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Scepter SmartControl for everyday use, the Eagle or Justrite Type I steel cans for long-term storage, and the SureCan if you want a rotating spout that pours without lifting and tipping. Check compliance if you live in a CARB state."
          }
        },
        {
          "@type": "Question",
          "name": "Are metal gas cans better than plastic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Metal safety cans are tougher and include flame arresters and self-closing, pressure-relieving lids, which makes them better for storing fuel in a garage or shop. Plastic cans are lighter, cheaper and easier for everyday refilling. Many homes keep one of each."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best gas can for long-term storage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A steel safety can like the Eagle UI50S or Justrite Type I, or a steel jerry can like the Wavian. Store it in a cool, detached space, add fuel stabilizer when you fill it, and rotate the fuel every few months."
          }
        },
        {
          "@type": "Question",
          "name": "Why are new gas cans so hard to pour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EPA and CARB rules require spouts that seal automatically to limit vapor and spills, which slowed many designs. Better cans fix it with vented spouts and controllable flow, like the Scepter SmartControl, or auto shut-off spouts like the Midwest Quick-Flow."
          }
        },
        {
          "@type": "Question",
          "name": "How long can gas be stored in a gas can?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untreated gasoline begins to degrade within a few months. With fuel stabilizer added when the can is filled, it lasts considerably longer. Rotate stored fuel into your car regularly and refill with fresh, treated gas."
          }
        },
        {
          "@type": "Question",
          "name": "What color gas can is for diesel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yellow is the standard color for diesel, red for gasoline and blue for kerosene. Using the right color helps prevent putting the wrong fuel in an engine. Scepter sells its SmartControl can in red for gasoline and yellow for diesel."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "gas can",
      "best gas can",
      "best 5 gallon gas can",
      "metal gas can",
      "gas can for long term storage",
      "gas can for generator",
      "safety gas can"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Gas Cans</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A generator is only as useful as the fuel beside it. The right gas can pours without spilling, seals in vapor and keeps fuel safe between storms. For most homes that is the Scepter 5-gallon SmartControl. Seven picks, from plastic to steel safety cans.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#scepter-smartcontrol-5-gal"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Plastic or Steel?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="4.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Plastic, Steel or Jerry Can</a>
          <a href="#compliance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. EPA and CARB Rules</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Gas Cans</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Size You Need</a>
          <a href="#storage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Storing Gas Safely</a>
          <a href="#generators" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. For Generators and Outages</a>
          <a href="#pouring" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Pouring Without Spills</a>
          <a href="#two-cycle" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. 2-Cycle Mix and Diesel</a>
          <a href="#replacement-spouts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Replacement Spouts</a>
          <a href="#lawn-mowers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. For Lawn Mowers</a>
          <a href="#transfer-pumps" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Funnels and Pumps</a>
          <a href="#vehicles" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Carrying in a Vehicle</a>
          <a href="#disposal" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. Disposing of Old Gas</a>
          <a href="#how-many-cans" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">14. Small Cans or One Big One</a>
