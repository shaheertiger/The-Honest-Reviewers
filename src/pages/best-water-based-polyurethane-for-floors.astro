const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Water-Based Polyurethane for Floors", item: "https://www.thehonestreviewers.com/best-water-based-polyurethane-for-floors/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best water-based polyurethane for floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bona Traffic HD is the most durable water-based floor finish available, because it is a two-component product that cross-links far more thoroughly than single-component finishes. For a homeowner doing their own floor, Varathane's Ultimate Floor Finish is the best balance of durability, price and availability.",
          },
        },
        {
          "@type": "Question",
          name: "Is water-based polyurethane as durable as oil-based?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Modern two-component water-based finishes are more durable than oil-based polyurethane, not less. Single-component water-based products are roughly comparable to oil for scratch resistance while drying faster and staying clear. The old assumption that water-based is inherently softer dates from formulations that are decades out of date.",
          },
        },
        {
          "@type": "Question",
          name: "Does water-based polyurethane yellow over time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No, and this is its main advantage. Oil-based polyurethane ambers as it cures and continues to yellow for years, which warms up oak and visibly discolours maple, ash and white-washed floors. Water-based dries clear and stays clear, so pale floors keep the colour you chose.",
          },
        },
        {
          "@type": "Question",
          name: "How many coats of water-based polyurethane do floors need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Three coats is the standard for a floor, and four is worth it in a hallway or kitchen. Water-based finishes build a thinner film per coat than oil-based, so the extra coat is not optional — two coats of water-based is not equivalent to two coats of oil.",
          },
        },
        {
          "@type": "Question",
          name: "How long does water-based polyurethane take to dry?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically two to four hours between coats, which is why a whole floor can be finished in a day. Full cure is a different matter: expect light foot traffic after 24 hours, furniture after several days, and full hardness at two to three weeks. Rugs should stay off until the finish has fully cured.",
          },
        },
        {
          "@type": "Question",
          name: "Can you put water-based polyurethane over oil-based?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, provided the oil-based finish is fully cured — usually at least 30 days — and the surface is scuff-sanded and thoroughly cleaned so the new finish has a mechanical key. Applying water-based over an oil finish that is still curing risks adhesion failure, so when in doubt, wait longer and test in a corner.",
          },
        },
        {
          "@type": "Question",
          name: "What applicator should you use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For floors, a T-bar applicator or a synthetic pad on a pole — they lay down an even film quickly, which matters because water-based finishes set fast. For furniture, trim and stairs, a good synthetic brush or a foam applicator gives better control. Never use a natural-bristle brush with a water-based finish; the bristles absorb water and go limp.",
          },
        },
        {
          "@type": "Question",
          name: "Do you sand between coats?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — a light abrade with 220 grit or a fine sanding screen between coats knocks down raised grain and gives the next coat a key. The first coat in particular raises the grain of bare wood noticeably, so that first sanding matters most. Vacuum and tack off thoroughly afterwards; dust is the enemy of a smooth floor.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

