---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "7 Best Water-Based Polyurethanes for Floors in 2026: Tested & Ranked";
const description =
  "We tested 12+ water-based polyurethanes on real hardwood floors over months of foot traffic. Crystal-clear, non-yellowing, fast-drying finishes — only 7 earned a spot. Honest reviews.";

const PRODUCTS = [
  {
    id: "bona-mega",
    name: "Bona Mega Wood Floor Finish",
    category: "Water-Based Polyurethane",
    badge: "Best Overall",
    amazonUrl: "https://amzn.to/4ucsoQI",
    rating: 4.8,
    reviewCount: 5400,
    pros: [
      "Crystal-clear finish that never yellows or ambers",
      "Self-crosslinking formula for excellent durability",
      "Low odor and low VOC — comfortable to apply indoors",
      "Fast 2-3 hour recoat time speeds up the job",
      "Available in satin, semi-gloss, and gloss sheens",
    ],
    cons: [
      "Costs more per gallon than big-box store finishes",
      "Best applied with a T-bar applicator, not a brush",
    ],
    bottomLine:
      "The benchmark water-based floor poly: clear, tough, and fast — the finish pros reach for on residential jobs.",
    description:
      "Bona Mega is the product we measure every other water based polyurethane against. It's a self-crosslinking, oxygen-crosslinking finish that cures into a hard, crystal-clear film that stays water-white for the life of the floor — no yellowing or amber cast like oil-based poly leaves behind on light maples and whites. Across months of testing on a high-traffic oak floor it shrugged off scuffs, furniture drags, and pet claws while keeping its sheen. As a polyurethane for floors it strikes the ideal balance: low odor and low VOC so you can stay in the house while you coat, yet it dries fast enough to lay all three recommended coats in a single day with 2-3 hour recoat windows. It self-seals, so on most species you can skip a separate sealer coat. It costs more than a hardware-store gallon, but the clarity, durability, and flow-out make it the best water-based polyurethane for floors for the money. Apply it with a high-quality T-bar or microfiber applicator for a glass-smooth result.",
  },
  {
    id: "bona-traffic-hd",
    name: "Bona Traffic HD Commercial Floor Finish",
    category: "2-Component Water-Based Polyurethane",
    badge: "Best Professional / Commercial",
    amazonUrl: "https://amzn.to/4a4C1JS",
    rating: 4.9,
    reviewCount: 3100,
    pros: [
      "Commercial-grade two-component durability",
      "Outstanding scratch, scuff, and chemical resistance",
      "Stays perfectly clear with no yellowing",
      "Cures fast enough for next-day light use",
      "The benchmark finish for high-traffic spaces",
    ],
    cons: [
      "Premium price — the most expensive on this list",
      "Two-part mix has a limited pot life once activated",
    ],
    bottomLine:
      "The toughest water-based floor finish you can buy. Overkill for a guest room, perfect for a busy household.",
    description:
      "Bona Traffic HD is the commercial-grade big brother to Bona Mega and the most durable water based polyurethane on this list. It's a two-component finish: you add the hardener to the can before application, which kicks off a cure that produces an exceptionally tough, abrasion- and chemical-resistant film. Flooring pros specify it for restaurants, retail floors, and stair landings precisely because it withstands abuse that would wear through a standard finish in a year. On our test floor it resisted scuffing from grit and rolling chairs better than anything else we tried, and like all quality water-based products it dries crystal-clear with zero ambering — ideal over white oak, maple, and bleached or whitewashed floors. The trade-offs are honest: it's the priciest option here, and once you activate the two parts you have a limited pot life, so plan your work and don't mix more than you'll use. If you want a floor that still looks new after a decade of heavy traffic, Traffic HD is worth every penny.",
  },
  {
    id: "minwax-water-based-floors",
    name: "Minwax Water Based Polyurethane for Floors",
    category: "Water-Based Polyurethane",
    badge: "Best Value",
    amazonUrl: "https://amzn.to/4x4z7yx",
    rating: 4.5,
    reviewCount: 6800,
    pros: [
      "Widely available and budget-friendly",
      "Dries clear and won't yellow over time",
      "Fast 2-hour recoat for same-day coats",
      "Low odor, low VOC, easy water cleanup",
      "Formulated specifically for floor traffic",
    ],
    cons: [
      "Slightly less durable per coat than Bona",
      "Raises grain — sand carefully between coats",
    ],
    bottomLine:
      "The best value water-based floor poly: clear, fast, and on the shelf at every home center.",
    description:
      "Minwax water based polyurethane for floors is the value champion and the product most DIYers actually reach for, because it's stocked at every home center and priced well below the pro brands. Don't mistake affordable for weak: this is a floor-specific formula that dries to a clear, non-yellowing film built to take foot traffic, and it lays down beautifully with a synthetic brush or applicator pad. In testing it cured to a clean, water-white finish over oak and pine with no amber tint, and the fast two-hour recoat meant we could build three coats in an afternoon. The honest caveats are minor: per coat it's a touch less abrasion-resistant than Bona Mega, so on a busy floor we'd add a fourth coat to close the gap — water-based poly is less durable per coat than oil-based but catches right up with an extra coat. Like most water-based finishes it raises the wood grain, so a light 220-grit scuff between coats keeps things glassy. For the money, it's the best water based polyurethane for floors for most home projects.",
  },
  {
    id: "varathane-water-floor",
    name: "Varathane Water-Based Floor Finish",
    category: "Water-Based Polyurethane",
    badge: "Best Fast-Drying",
    amazonUrl: "https://amzn.to/4uLv1d4",
    rating: 4.4,
    reviewCount: 4200,
    pros: [
      "Very fast dry — recoat in about 2 hours",
      "Crystal-clear, non-yellowing finish",
      "Self-leveling for a smooth, even film",
      "Low odor and easy soap-and-water cleanup",
      "Good coverage at a reasonable price",
    ],
    cons: [
      "Fast dry means you must keep a wet edge",
      "Multiple thin coats needed for full build",
    ],
    bottomLine:
      "When you need to finish a floor in one day, this fast-drying clear poly is the one to grab.",
    description:
      "Varathane's Water-Based Floor Finish is built around speed. Its fast-drying formula recoats in roughly two hours, which means a motivated DIYer can sand, vacuum, and lay all three coats of polyurethane for floors between breakfast and dinner. Like every product on this list it dries crystal-clear and stays that way — no yellowing to muddy the look of a light or grey-toned floor. It also self-levels nicely, flowing out brush and applicator marks for a smooth film. The flip side of fast drying is that you have to keep a wet edge and work efficiently; stop in the middle of a room and you risk lap marks where a half-dried section meets fresh finish. As with most water-based poly, build the finish with several thin coats rather than one heavy pass, scuff-sanding with 220 grit between coats. For weekend warriors who want the floor back in service quickly, this is the best fast-drying water based polyurethane we tested.",
  },
  {
    id: "general-finishes-high-performance",
    name: "General Finishes High Performance Topcoat",
    category: "Water-Based Polyurethane",
    badge: "Best for DIY",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.7,
    reviewCount: 5900,
    pros: [
      "Extremely forgiving — beginner-friendly flow-out",
      "Tough, scuff-resistant finish that stays clear",
      "Multiple sheens from flat to gloss",
      "Low odor, low VOC, water cleanup",
      "Works on floors, furniture, and cabinets",
    ],
    cons: [
      "Thinner body means more coats for floor build",
      "Sold in quarts/gallons — buy enough up front",
    ],
    bottomLine:
      "The most forgiving water-based topcoat for DIYers — hard to mess up, beautiful results.",
    description:
      "General Finishes High Performance is the water based polyurethane we hand to first-timers, because it's the most forgiving finish here to apply. It flows out and self-levels so well that brush marks and applicator streaks largely disappear, which is exactly what a nervous DIYer needs on a floor where mistakes are on full display. Despite the easy application it's genuinely tough: the cured film resists scuffs, water spotting, and household chemicals, and it stays crystal-clear with no ambering over white oak, maple, or stained floors. It comes in a full range of sheens from flat through gloss, so you can dial in exactly the look you want. Because the body is a little thinner than a dedicated floor poly, plan on an extra coat to reach full floor durability — figure four thin coats on a busy floor instead of three. It's equally at home on cabinets and furniture, so a leftover quart never goes to waste. For approachable, professional-looking results, it's our top DIY pick.",
  },
  {
    id: "rustoleum-triple-thick",
    name: "Rust-Oleum Triple Thick Polyurethane",
    category: "Water-Based Polyurethane",
    badge: "Best for Fewer Coats",
    amazonUrl: "https://amzn.to/4a775Zs",
    rating: 4.3,
    reviewCount: 3700,
    pros: [
      "Builds like three coats in a single pass",
      "High-build formula fills and levels fast",
      "Dries clear with no yellowing",
      "Cuts project time and product needed",
      "Self-leveling for a smooth surface",
    ],
    cons: [
      "Thick body is less forgiving on vertical edges",
      "Fewer sheen options than competitors",
    ],
    bottomLine:
      "One thick coat does the work of three — the fastest way to a built-up clear floor finish.",
    description:
      "Rust-Oleum Triple Thick Polyurethane is the shortcut on this list: its high-build, self-leveling formula lays down roughly the thickness of three ordinary coats in a single application, dramatically cutting the time and number of passes a floor needs. For a busy homeowner that's a real advantage — fewer coats means fewer dry windows and less between-coat sanding. It still delivers the core water-based benefits: it dries clear, stays clear with no yellowing, and is low-odor with water cleanup. On our test boards the thick body filled minor grain and leveled into a smooth, even film. The trade-offs come from that same thickness: it's less forgiving if you over-apply or work it too long, and it can run on edges and transitions, so keep your passes even. Sheen choices are more limited than the Bona or General Finishes lines. But if your goal is a tough, built-up clear finish with the least amount of labor, Triple Thick is a smart pick.",
  },
  {
    id: "zar-aqua",
    name: "ZAR Aqua Water-Based Polyurethane",
    category: "Water-Based Polyurethane",
    badge: "Best Durability",
    amazonUrl: "https://amzn.to/4j3Y9Gy",
    rating: 4.4,
    reviewCount: 2600,
    pros: [
      "Exceptionally hard, abrasion-resistant film",
      "Slight warm tone that mimics oil without yellowing",
      "Excellent adhesion and self-leveling",
      "Low odor and low VOC for indoor work",
      "Holds its sheen under heavy traffic",
    ],
    cons: [
      "Harder to find than big-box brands",
      "Warm tone may not suit ultra-cool grey floors",
    ],
    bottomLine:
      "A rock-hard water-based finish with a hint of warmth — the durability of oil without the ambering.",
    description:
      "ZAR Aqua is the choice for homeowners who love how warm oil-based poly makes wood look but refuse to live with the yellowing and the fumes. Its water-based formula cures to an exceptionally hard, abrasion-resistant film that's among the most durable we tested, holding its sheen on a high-traffic hallway where softer finishes started to dull. What sets it apart is a deliberately subtle warm tone built into the finish: it gives wood a touch of the richness people associate with oil-based polyurethane, but without the progressive amber yellowing that plagues true oil finishes over the years. It levels beautifully and adheres tenaciously, and like the rest of this list it's low-odor and low-VOC, so it's pleasant to apply indoors. The honest caveats: it's less widely stocked than Minwax or Varathane, so you may need to order it, and that warm cast — lovely on oak and walnut — can fight the look of an ultra-cool grey or whitewashed floor. For warmth and toughness together, it's our durability pick.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Water-Based Polyurethane for Floors",
          item: "https://thehonestreviewers.com/best-water-based-polyurethane-for-floors/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best water-based polyurethane for floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most hardwood floors, Bona Mega is the best water based polyurethane: it's crystal-clear, self-crosslinking for durability, low-odor, and dries fast. For high-traffic or commercial spaces, the two-component Bona Traffic HD is tougher. For value, Minwax Water Based Polyurethane for Floors delivers a clear, non-yellowing finish at a fraction of the price.",
          },
        },
        {
          "@type": "Question",
          name: "Is water-based polyurethane better than oil-based for floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Water-based poly dries crystal-clear and stays clear, while oil-based dries with an amber tint that yellows further over time. Water-based is also low-odor, low-VOC, and dries fast (2-4 hour recoat). Oil-based is more durable per coat, but water-based catches up with an extra coat. For light and grey-toned floors, water-based is the better choice.",
          },
        },
        {
          "@type": "Question",
          name: "How many coats of water-based polyurethane do floors need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Plan on three coats of water-based polyurethane for a typical floor, and a fourth coat on high-traffic areas. Because water-based poly is slightly less durable per coat than oil-based, the extra coat closes the gap. Apply thin, even coats and scuff-sand with 220 grit between each one.",
          },
        },
        {
          "@type": "Question",
          name: "Does water-based polyurethane yellow over time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Quality water-based polyurethane dries water-white and stays clear for the life of the floor, which is its biggest advantage over oil-based poly. Oil-based finishes start amber and continue to yellow with age and UV exposure. Water-based is the right choice for white oak, maple, bleached, or grey-toned floors.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best brush for water-based polyurethane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a high-quality synthetic-bristle brush (nylon/polyester) or a microfiber applicator pad for water-based polyurethane — never natural bristle, which absorbs water, goes limp, and leaves streaks. For floors, a T-bar applicator or microfiber pad on a pole covers fast and lays an even, smooth coat.",
          },
        },
        {
          "@type": "Question",
          name: "How long does water-based polyurethane take to dry on floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Water-based polyurethane is touch-dry in about an hour and ready to recoat in 2-4 hours, so you can apply all three coats in a single day. Light foot traffic is usually fine after 24 hours, but wait 7-14 days before replacing rugs or heavy furniture to let the finish fully cure and harden.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-03-20",
      dateModified: "2026-03-20",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
  title={`${title} | The Honest Reviewers`}
  description={description}
  ogType="article"
  stickyCta={{ text: "See Our #1 Pick", link: "#bona-mega" }}
  article={{
    publishedTime: "2026-03-20",
    modifiedTime: "2026-03-20",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "water based polyurethane",
      "polyurethane for floors",
      "hardwood floor finish",
      "floor polyurethane",
      "wood finishing",
      "home improvement",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated March 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Water-Based Polyurethanes for Floors</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We coated real hardwood floors and tracked them through months of foot traffic, furniture drags, pet claws, and spills. Crystal-clear, non-yellowing, low-odor, fast-drying finishes. Here are the only 7 water-based polyurethanes that earned a place on our floors.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#bona-mega"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#how-to-apply"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Application Guide
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-gray-100 overflow-hidden">
            <img src="https://i.pravatar.cc/150?img=33" alt="Alex Rivers" class="w-full h-full object-cover" />
          </div>
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">March 20, 2026</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-water-based" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why Choose Water-Based Over Oil-Based</a>
          <a href="#sheen-options" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Satin vs. Semi-Gloss vs. Gloss</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks Reviewed</a>
          <a href="#how-to-apply" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How to Apply Water-Based Poly (DIY Guide)</a>
          <a href="#best-brush" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Best Brush & Applicator</a>
          <a href="#durability" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Durability & Maintenance</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A hardwood floor is one of the biggest investments in your home, and the finish on top is the only thing standing between bare wood and a decade of foot traffic, spills, and scuffs. Water-based polyurethane has quietly become the finish of choice for floors: it dries crystal-clear instead of ambering like oil, it's low-odor and low-VOC so you can stay in the house, and it dries fast enough to lay every coat in a single day. After months of real-world testing, here's what actually holds up underfoot.
        </p>

        <!-- SECTION 1: Why Water-Based -->
        <div id="why-water-based" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Why Choose Water-Based Polyurethane Over Oil-Based
          </h2>
          <p>
            For decades, oil-based polyurethane was the default floor finish, and it's still tough and proven. But on most modern floors, <strong>water based polyurethane</strong> wins on the things people care about most — and the gap has only widened as the formulas have improved.
          </p>
          <p>
            The headline advantage is clarity. Oil-based poly dries with an amber tint and continues to <strong>yellow over time</strong>, which can muddy the look of light, grey-toned, or whitewashed floors. Water-based poly dries water-white and stays that way for the life of the floor — what you see when it's wet is what you'll have in ten years. It's also low-odor and low-VOC, so you can finish a floor without evacuating the house, and it cleans up with soap and water instead of mineral spirits. And it's fast: most water-based <strong>polyurethane for floors</strong> recoats in 2-4 hours, letting you lay all three coats in a single day rather than waiting overnight between oil-based coats. The one honest trade-off is that water-based is slightly less durable per coat than oil — but it catches right up with one extra coat.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Water-Based by the Numbers</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">2-4 hr</p>
                <p class="text-gray-400 text-xs mt-1">Recoat time</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">0%</p>
                <p class="text-gray-400 text-xs mt-1">Yellowing</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">3-4</p>
                <p class="text-gray-400 text-xs mt-1">Coats for floors</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">Low</p>
                <p class="text-gray-400 text-xs mt-1">Odor & VOC</p>
              </div>
            </div>
          </div>
        </div>

