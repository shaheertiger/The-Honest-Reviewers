    section: "Home Improvement",
    tags: ["water based polyurethane", "floor finish", "hardwood floors", "polycrylic", "wood finishing"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our #1 Pick", link: "#bona-traffic-hd" }}
>
