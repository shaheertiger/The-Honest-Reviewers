  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "7 Best Generator Inlet Boxes in 2026: 30 Amp and 50 Amp, Matched to Your Cord";
const description =
  "The best generator power inlet boxes: 30 amp L14-30 vs 50 amp, steel vs plastic NEMA 3R, kits with cord, and how the inlet pairs with an interlock or switch.";

const PRODUCTS = [
  {
    "id": "reliance-pb30",
    "name": "Reliance Controls PB30 30-Amp Power Inlet Box",
    "category": "30A, L14-30, Powder-Coated Steel, NEMA 3R",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "L14-30 inlet that matches the twist-lock on most 5,000 to 9,000 watt generators",
      "Rated for generators up to 7,500 running watts",
      "Steel NEMA 3R enclosure listed for indoor or outdoor mounting",
      "Four combination 1/2 and 3/4 inch knockouts give the electrician routing options",
      "The inlet most electricians already know, made by the company behind Pro/Tran switches"
    ],
    "cons": [
      "Steel can rust at scratches in coastal or salted-road climates",
      "Small box, around 6 by 4 inches, so heavy wire is snug"
    ],
    "bottomLine": "The default 30-amp inlet: the right plug, a sturdy box, and the brand an electrician will not argue with.",
    "description": "If your generator has an L14-30R twist-lock, the PB30 is the inlet we would hand an electrician. Reliance lists it as a 30-amp, 120/240 volt power inlet box with a flanged L14-30P inlet, rated for generators up to 7,500 running watts, in a powder-coated steel enclosure rated NEMA 3R for indoor or outdoor use. Distributors list it at about 6 by 4 inches with roughly 2-5/8 inches of depth and four combination 1/2 and 3/4 inch knockouts, which lets the wire leave from the back straight through the wall or from the bottom into conduit. Reliance makes the Pro/Tran 2 transfer switches, so the PB30 is the box their switches are drawn around, but it works with any 30-amp interlock or switch. The only reasons to pick something else are corrosion, where a non-metallic box lasts longer, and space, because 10-gauge wire in a small steel box is a tight fit."
  },
  {
    "id": "generac-6337",
    "name": "Generac 6337 30-Amp Resin Power Inlet Box",
    "category": "30A, L14-30, Glass-Filled Nylon, NEMA 3R",
    "badge": "Best Non-Metallic 30A",
    "amazonUrl": "#",
    "pros": [
      "Glass-filled nylon resin enclosure that will not rust",
      "L14-30 inlet, listed for generators up to 7,500 watts",
      "UL listed; Generac lists it as made in the USA",
      "Generac's own inlet for its HomeLink transfer switches",
      "Often the cheapest name-brand 30A inlet at retail"
    ],
    "cons": [
      "Two-year limited warranty",
      "Plastic housing can crack if a cord is yanked sideways"
    ],
    "bottomLine": "The 30-amp inlet to buy if you live near salt air or just want a box that cannot rust.",
    "description": "The 6337 is Generac's 30-amp resin inlet and the one we would pick over steel anywhere corrosion is a real concern. Retailers list it as a 30-amp, 125/250 volt raintight inlet box with a NEMA L14-30 inlet, rated for generators up to 7,500 watts, in a glass-filled nylon enclosure rated NEMA 3R. It is UL listed, Generac describes it as made in the USA, and it carries a two-year limited warranty. Because Generac designs its HomeLink manual transfer switches around it, it is also the natural inlet if you are building a Generac switch setup piece by piece rather than buying the complete kit. Retail prices in our search ranged from roughly $33 to $63, which makes it one of the least expensive name-brand inlets. The trade-off for a non-metallic box is impact strength: mount it where a mower or a tripping foot cannot catch the cord and lever it off the wall."
  },
  {
    "id": "reliance-pbn30",
    "name": "Reliance Controls PBN30 30-Amp Non-Metallic Power Inlet Box",
    "category": "30A, L14-30, ABS, NEMA 3R, Bottom Feed",
    "badge": "Best Bottom-Entry 30A",
    "amazonUrl": "#",
    "pros": [
      "UV-stabilized ABS housing that will not corrode",
      "Bottom-fed design with a flip lid that shields the plug from rain",
      "L14-30 inlet rated for 7,500-watt generators",
      "Designed to pair with Reliance Pro/Tran switches and transfer panels"
    ],
    "cons": [
      "Bottom-fed cord exit means you need clearance below the box",
      "Slightly bulkier than the steel PB30"
    ],
    "bottomLine": "The non-metallic Reliance: same L14-30 inlet as the PB30, in a plastic box with the cord hanging down out of the rain.",
    "description": "The PBN30 is the ABS version of the PB30, and it changes one thing that matters more than it sounds: the inlet faces down. Reliance lists it as a 30-amp L14-30 power inlet in a NEMA 3R non-metallic enclosure, bottom fed, with a plug-in flip lid, built for use with Pro/Tran transfer switches and Reliance's transfer panels. With the inlet pointing at the ground, rain runs off the back of the cord connector instead of sitting on top of it, which is the right orientation for a wall that takes weather. The plastic housing will not rust, which makes it a better choice than steel on the coast or beside a driveway that gets salted. The cost is clearance. The cord hangs straight down out of the box, so you need a few inches of space below it, and you cannot mount it right on top of a deck board or a foundation ledge. If you would rather have the cord come out the front, buy the PB30 or the Generac 6337."
  },
  {
    "id": "connecticut-electric-egspi30",
    "name": "Connecticut Electric EGSPI30 30-Amp Power Inlet Box",
    "category": "30A, L14-30, Hinged Door, NEMA 3R",
    "badge": "Best Hinged Cover",
    "amazonUrl": "#",
