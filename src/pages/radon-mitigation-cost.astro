                    <td class="px-4 py-4 font-black text-gray-900">Slab on grade</td>
                    <td class="px-4 py-4 text-gray-700">Sub-slab depressurization</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1,000 to 2,500 dollars</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Crawl space</td>
                    <td class="px-4 py-4 text-gray-700">Sealed membrane with suction</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1,500 to 4,000 dollars or more</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Mixed foundation</td>
                    <td class="px-4 py-4 text-gray-700">Multiple suction points or systems</td>
                    <td class="px-4 py-4 text-gray-700">Often 2,000 to 4,000 dollars or more</td>
                  </tr>
