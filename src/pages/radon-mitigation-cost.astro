                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Basement, unfinished</td>
                    <td class="px-4 py-4 text-gray-700">Sub-slab depressurization</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 800 to 2,000 dollars</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Basement, finished</td>
                    <td class="px-4 py-4 text-gray-700">Sub-slab depressurization, harder routing</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1,200 to 2,500 dollars or more</td>
                  </tr>
