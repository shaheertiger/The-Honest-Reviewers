                    <td class="px-4 py-4 text-gray-700">Wattage limiter or wrong bulb type</td>
                    <td class="px-4 py-4 text-gray-700">Swap in one known-good LED bulb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Light works on one chain pull, not others</td>
                    <td class="px-4 py-4 text-gray-700">Worn pull chain switch</td>
                    <td class="px-4 py-4 text-gray-700">Count clicks through a full cycle</td>
                  </tr>
