    "url": "/best-rv-generator/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "What Can a 3500 Watt Generator Run? Outage Plans, RV Loads and What Trips It";
const description =
  "What a 3500 watt generator runs: essentials-only outage plans, a 30A RV with and without the rooftop AC, the 120V-only limits, and the loads that trip it.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Can a 3500 Watt Generator Run?",
          item: "https://www.thehonestreviewers.com/what-can-a-3500-watt-generator-run/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a 3500 watt generator run a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It will run the essentials of a house with gas heat: refrigerator, freezer or furnace blower, lights, internet and small appliances one at a time. It will not run a house normally, because it is 120V only and too small for air conditioning, electric cooking, a water heater or a well pump. Treat it as a keep-the-food-cold-and-lights-on machine, not a whole-house one."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 3500 watt generator run a refrigerator and freezer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A refrigerator typically runs at about 700 watts and a chest freezer at about 500, so together they use well under half the running capacity. Their compressor starts, around 2,200 and 1,500 watts, fit the starting rating as long as both do not start in the same second. Plug them into different outlets and start them one after the other."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 3500 watt generator run a 13,500 BTU RV air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, if it is an open-frame unit with around 4,375 or more starting watts and little else is running. Inverter models with lower surge ratings often trip, especially in heat or at altitude. A soft starter fitted to the AC cuts the starting surge enough that most 3,500 watt generators start it reliably. Keep the microwave off while the AC runs."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 3500 watt generator run a window air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One small or mid-size unit, yes. A 10,000 BTU window AC typically runs at 1,000 to 1,200 watts and starts at up to about 3,000, so it fits alongside a refrigerator and lights but not alongside a refrigerator, freezer and sump pump. Start the AC first, then the refrigerator, and keep heating appliances off while it runs."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 3500 watt generator run a well pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Almost never. Most residential well pumps are 240V, and almost every 3,500 watt generator is 120V only, so it cannot power them regardless of wattage. A few small 120V jet pumps exist, but their starting surge often exceeds what this class can deliver alongside other loads. Plan on a 5,000 watt or larger generator with an L14-30R outlet."
          }
        },
        {
          "@type": "Question",
          "name": "What does 3500 running watts mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It means the generator can deliver 3,500 watts continuously for hours. A generator listed as 3500 running watts is a slightly larger machine than one sold as 3500 watts peak, which may only run 3,000 continuously. Starting or surge watts are a separate, higher figure that only lasts a second or two while a motor starts."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 3500 watt generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many open-frame models in this class are rated for somewhere around 10 to 14 hours at a quarter to half load on a full tank, and inverters can run longer at light load. At the 2,500 to 2,800 watt loads in this guide, expect noticeably less than the headline figure. Check the spec sheet's runtime and the load it was quoted at."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
