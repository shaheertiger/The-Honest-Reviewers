  },
  {
    "id": "frigidaire-ffht1835vs",
    "name": "Frigidaire 18.3 cu. ft. Top Freezer Refrigerator (FFHT1835VS)",
    "category": "Top-Freezer, Stainless Finish",
    "badge": "Best for Rentals and Budgets",
    "amazonUrl": "#",
    "pros": [
      "Straightforward top-freezer design with adjustable shelves and bins",
      "Available in a stainless-look finish for kitchens that want a modern appearance",
      "Frigidaire is part of Electrolux, with a broad parts and service network",
      "Capacity in the range that suits two to three people",
      "Frequently sold at a price that undercuts French door competitors by a wide margin"
    ],
    "cons": [
      "No in-door water or ice, and ice-maker options vary by model",
      "Feature set is basic compared with Samsung and LG alternatives"
    ],
    "bottomLine": "The refrigerator to put in a rental, a garage-adjacent kitchen or a first apartment. It does the basic job and does not charge you for extras.",
