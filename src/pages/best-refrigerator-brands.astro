---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "What Temperature Should a Refrigerator Be?",
    "url": "/what-temperature-should-a-refrigerator-be/"
  },
  {
    "title": "Can a Portable Power Station Run a Refrigerator?",
    "url": "/can-a-portable-power-station-run-a-refrigerator/"
  },
  {
    "title": "Best Countertop Ice Makers",
    "url": "/best-countertop-ice-maker/"
  },
  {
    "title": "Best Dishwashers",
    "url": "/best-dishwasher/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-30", modified: "2026-10-30" });
const title = "Best Refrigerator Brands in 2026: Seven Models, Ranked by Kitchen Type";
const description =
  "Which refrigerator brands are worth buying in 2026? Seven real models across top-freezer, French door, side-by-side and counter-depth layouts, compared.";

const PRODUCTS = [
  {
    "id": "whirlpool-wrt318fzdw",
