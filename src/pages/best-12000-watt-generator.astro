---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 10,000 Watt Generators",
    "url": "/best-10000-watt-generator/"
  },
  {
    "title": "Best Whole House Generators",
    "url": "/best-whole-house-generator/"
  },
  {
    "title": "Best Tri-Fuel Generators",
    "url": "/best-tri-fuel-generator/"
  },
  {
    "title": "Portable vs Standby Generator",
    "url": "/portable-vs-standby-generator/"
  },
  {
    "title": "Whole-House Generator Installation Cost",
    "url": "/whole-house-generator-installation-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Best 12,000 Watt Generators in 2026: Near-Whole-House Portables";
const description =
  "Six 12,000 watt generators compared on true running watts, 50-amp output, weight and fuel runtime, plus when a standby generator is the better buy.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen10500dfc",
    "name": "Westinghouse WGen10500DFc",
    "category": "Dual Fuel Open Frame, 10,500W Running",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "10,500 running and 13,500 peak watts on gasoline, 12,500 peak on propane",
      "Rated for up to 19 hours at quarter load on a 9.5-gallon tank",
      "14-50R and L14-30R outlets plus two 5-20R duplexes and USB ports",
      "Remote electric start and a CO sensor shutdown",
      "About 230 lb dry, light for its running output"
    ],
    "cons": [
      "Westinghouse does not publish a propane running figure on its main spec listing",
      "Open-frame output, so not the cleanest power for sensitive electronics"
    ],
    "bottomLine": "The best balance in the 12,000 watt class: 10,500 running watts, a 50-amp outlet and long rated runtime in a frame one person can still roll.",
    "description": "The WGen10500DFc is the generator we would point most 12,000 watt shoppers toward, because it delivers more sustained power than the typical 12,000-peak machine without moving into V-twin weight. Westinghouse rates it at 10,500 running and 13,500 peak watts on gasoline, with 12,500 peak watts on propane. That extra 1,000 running watts over a 9,500 watt unit is exactly the margin that lets a soft-started central air system run alongside a refrigerator, well pump and lights without hovering at the limit. The panel is built for home connection, with a 120/240V 14-50R, an L14-30R, two 5-20R GFCI duplexes, USB ports and a switch that sets it up for transfer-switch use. Westinghouse rates runtime at up to 19 hours at quarter load from the 9.5-gallon tank, which covers a full night at a light load with fuel left over. Remote electric start and a CO sensor that shuts the engine down are both standard. Dry weight is listed at about 230 lb, roughly 15 lb more than a 9,500 watt machine and well over 100 lb less than the true-12kW V-twins. The gaps: Westinghouse's primary listing does not state a propane running rating, so size conservatively on LP, and open-frame power is less clean than an inverter's."
  },
  {
    "id": "champion-201161",
    "name": "Champion 201161 12,000-Watt Tri Fuel",
    "category": "Tri Fuel V-Twin, 12,000W Running",
    "badge": "Best True 12kW",
    "amazonUrl": "#",
    "pros": [
      "A genuine 12,000 running watts on gasoline, 15,000 starting",
      "11,000 running on propane and 10,000 on natural gas, with a 25 ft NG hose kit included",
      "717cc V-twin engine and an 11-gallon tank rated for about 9 hours",
      "14-50R, L14-30R, L5-30R and two 5-20R GFCI duplexes",
      "CO Shield shutdown, electric start and a 3-year limited warranty"
    ],
    "cons": [
      "347 lb net, the heaviest generator here apart from the Generac",
      "78 dBA rated noise level, the loudest figure published in this group"
    ],
    "bottomLine": "If you want 12,000 watts you can actually run all afternoon, this is the one. It is heavy and loud, and it runs on natural gas for outages that last.",
    "description": "Most generators sold as 12,000 watts sustain 9,500. The Champion 201161 is one of the few that actually runs 12,000: Champion's spec sheet lists 15,000 starting and 12,000 running watts on gasoline, 13,750 and 11,000 on propane, and 12,500 and 10,000 on natural gas. Even on natural gas it out-runs the 9,500 watt machines on gasoline. That output comes from a 717cc V-twin rather than the 457-500cc single cylinders the lighter units use, and it changes what you can do: a three-ton air conditioner with a soft starter, a 240V well pump, a refrigerator, freezer and an electric water heater can all be on at once. The tri-fuel capability is the other headline. Champion includes a 25 ft natural gas hose kit, and with a professionally installed gas connection the generator runs as long as the outage lasts with no refueling. Champion rates the 11-gallon tank for about 9 hours on gasoline. Outlets include a 14-50R, an L14-30R, an L5-30R and two 5-20R GFCI duplexes. The costs are physical. It weighs 347 lb net, and Champion rates it at 78 dBA, so it needs a permanent spot with a hard path, and neighbors will hear it. CO Shield and a 3-year warranty are standard."
  },
  {
    "id": "duromax-xp12000hx",
    "name": "DuroMax XP12000HX",
    "category": "Dual Fuel Open Frame, 9,500W Running",
    "badge": "Best Value 12,000 Watt",
    "amazonUrl": "#",
    "pros": [
      "12,000 starting and 9,500 running watts on gasoline, 9,025 running on propane",
      "Small propane derate of 5 percent",
      "Four 5-20R GFCI outlets plus L5-30R, L14-30R and 50A 14-50R",
      "Rated 8.83 hours at half load on gasoline and 7.2 on propane, 8.3-gallon tank",
      "CO Alert shutdown and all-metal construction"
    ],
    "cons": [
      "Around 222 lb, and the wheel kit has to carry all of it",
      "9,500 running watts is the same as many generators sold as 10,000-class"
    ],
    "bottomLine": "The classic 12,000 watt dual fuel portable: 9,500 running watts, a full 50-amp panel and one of the smallest propane penalties in the class.",
    "description": "The XP12000HX is what most people picture when they think of a 12,000 watt generator, and DuroMax's spec sheet is refreshingly clear about it: 12,000 starting and 9,500 running watts on gasoline, 11,400 starting and 9,025 running on propane. The 5 percent propane derate is smaller than the 10 percent many dual fuel generators show, so this is a good choice for households that plan to run primarily on LP cylinders or a larger tank. The panel is the most complete here for direct plug-in use: four 5-20R GFCI outlets, an L5-30R 120V twist-lock, an L14-30R and a 120/240V 50-amp heavy-duty outlet, so it can feed a 50-amp inlet and still power extension cords directly. DuroMax rates runtime at 8.83 hours at half load on its 8.3-gallon gasoline tank and 7.2 hours on propane, and recommends a 40 lb or larger cylinder for longer runs. CO Alert technology shuts the engine down if carbon monoxide builds up. Listings put it around 222 lb. Our honest caveat is about class: 9,500 running watts is a 10kW-class number, and you are paying for the 50-amp panel and starting headroom as much as for running power. If you need more sustained output, look at the WGen10500DFc or XP13000HX."
  },
  {
    "id": "duromax-xp13000hx",
    "name": "DuroMax XP13000HX",
    "category": "Dual Fuel Open Frame, 10,500W Running",
    "badge": "Best on Propane",
    "amazonUrl": "#",
    "pros": [
      "10,500 running watts on gasoline and 10,000 on propane",
      "13,000 starting watts on gas, 12,500 on propane",
      "Rated 17 hours at quarter load on gasoline and 13 on propane",
      "Four 5-20R, L5-30R, L14-30R and 14-50R outlets",
      "5-year manufacturer warranty, the longest here"
    ],
    "cons": [
      "Listed at 246 lb, heavier than the Westinghouse with the same gasoline rating",
      "74 dB rated noise, typical for open-frame units but not quiet"
    ],
    "bottomLine": "The strongest propane performer below V-twin weight. Pick it over the Westinghouse if you will run mostly on LP and value the 5-year warranty.",
    "description": "The XP13000HX matches the Westinghouse WGen10500DFc on gasoline at 10,500 running and 13,000 starting watts, but it wins clearly on propane. Listings give 10,000 running and 12,500 starting watts on LP, so it loses only about 5 percent on propane and still clears the 9,500 watt machines running on gasoline. If your outage plan is built around propane because it stores indefinitely and does not go stale, this is the strongest dual fuel option under 250 lb. Rated runtime is up to 17 hours at quarter load and 8.5 hours at half load on the 8.3-gallon gasoline tank, and 13 and 6.5 hours respectively on propane. The panel matches the XP12000HX with four 5-20R GFCI outlets, an L5-30R, an L14-30R and a 14-50R. DuroMax backs it with a 5-year warranty, longer than anything else here, and CO Alert shutdown is standard. The 500cc engine is rated at 74 dB, about what you would expect from an open-frame generator at this output. The trade-off against the Westinghouse is weight: listings put the XP13000HX at about 246 lb, 16 lb more, and it uses push-button rather than remote start. If you run mostly on gasoline, the Westinghouse is the slightly better buy; on propane, the DuroMax is."
  },
  {
    "id": "westinghouse-wgen9500df",
    "name": "Westinghouse WGen9500DF",
    "category": "Dual Fuel Open Frame, 9,500W Running",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "12,500 peak and 9,500 running watts on gasoline, 8,500 running on propane",
      "Rated 12 hours at quarter load and 8 hours at half load on 6.6 gallons",
      "14-50R, L14-30R and two GFCI 5-20R duplexes",
      "Remote start with a key fob and electric push-button start",
      "211 lb dry, the lightest unit in this guide"
    ],
    "cons": [
      "No CO sensor on this version; the WGen9500DFc adds one",
      "Propane running output drops more than 10 percent"
    ],
    "bottomLine": "The least expensive way into a 50-amp, 12,500-peak generator. Fine for most essentials-plus-AC plans, but treat it as a 9,500 watt machine.",
    "description": "The WGen9500DF is one of the most widely sold large portables, and it earns that by packing a 50-amp panel and remote start into a light, affordable frame. Westinghouse rates it at 12,500 peak and 9,500 running watts on gasoline, and 11,200 peak and 8,500 running on propane. At 211 lb dry it is the lightest generator in this guide, which matters when it lives in a shed and has to be wheeled out across a lawn. Runtime is rated at up to 12 hours at quarter load and 8 hours at half load from the 6.6-gallon tank, and 7 hours at half load on a 20 lb propane cylinder. The panel has two 5-20R GFCI duplexes, an L14-30R and a 14-50R, so it connects to a 50-amp inlet. Remote start via key fob is standard, and Westinghouse rates it at 74 dBA. Two caveats keep it in the budget slot. This version has no CO sensor; Westinghouse sells the WGen9500DFc with one, and we would spend the difference. And its propane derate of over 10 percent is larger than DuroMax's. Owners commonly report reliable starts and straightforward fuel switching. Size it as a 9,500 watt generator and it is very good value."
  },
  {
    "id": "generac-gp15000e",
    "name": "Generac GP15000E 5734",
    "category": "Gasoline Open Frame, 15,000W Running",
    "badge": "When 12kW Is Not Enough",
    "amazonUrl": "#",
    "pros": [
      "15,000 running and 22,500 starting watts, enough to start a 5-ton air conditioner per Generac",
      "16-gallon tank rated for about 10 hours at half load",
      "50A 120/240V outlet plus L14-30R, two L5-30R and two 5-20R",
      "Generac OHVI engine and never-flat wheels",
      "Generac's large dealer and service network"
    ],
    "cons": [
      "363 lb, effectively a stationary generator on wheels",
      "Gasoline only, burns more fuel than anything else here, and runs above 5 percent THD"
    ],
    "bottomLine": "The step past 12kW, for houses that need two big 240V loads plus central air. At this weight and fuel burn, compare it seriously with a standby unit.",
    "description": "We include the GP15000E to show what lies beyond the 12,000 watt class and what it costs. Generac's spec sheet lists 15,000 running and 22,500 starting watts, and Generac's brochure says the GP15000E and GP17500E can start up to a 5-ton air conditioner. That surge capacity is the real reason to buy it: it starts large compressors and well pumps without soft starters and still carries the rest of the house. The panel includes a 50-amp 120/240V outlet, an L14-30R, two L5-30R 120V twist-locks and two 5-20R outlets, and the 16-gallon tank is rated for about 10 hours at half load. It is gasoline only, so there is no propane or natural gas option for long-term fuel storage, and Generac states that its GP series generators run above 5 percent total harmonic distortion. The weight is the big practical issue: Generac lists 363 lb, which makes this a generator you park once and leave. At that point the arguments for a standby generator, automatic start, natural gas fuel and no cords, get very strong, and we discuss that trade below. Buy the GP15000E if you need 15kW portable output and cannot install a standby unit."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 12,000 Watt Generators",
          item: "https://www.thehonestreviewers.com/best-12000-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will a 12,000 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 10,500 to 12,000 running-watt generator runs a refrigerator, freezer, furnace, 240V well pump, sump pump, lights, electronics and a soft-started central air system at once, with room for an electric water heater or dryer cycling. A 9,500 running-watt model covers the same essentials but with less room for the large 240V loads."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 12,000 watt generator run a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For many gas-heated homes it can run nearly everything, provided the central air has a soft starter and you avoid running every large 240V appliance at once. Homes with electric heat, heat pumps used for heating, or more than one big air conditioner usually need a standby generator instead."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 12kW generator the same as 12,000 running watts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not usually. Most portables sold as 12,000 watts produce 12,000 starting watts and about 9,500 running watts. The Champion 201161 is one of the few portables rated for 12,000 running watts on gasoline, and it uses a V-twin engine and weighs 347 lb."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 12,000 watt generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Based on manufacturers' ratings, about 8 to 9 hours at half load for most of this class, and up to 17 to 19 hours at quarter load on models like the DuroMax XP13000HX and Westinghouse WGen10500DFc. The Generac GP15000E's 16-gallon tank is rated for about 10 hours at half load."
          }
        },
        {
          "@type": "Question",
          "name": "Does a 12,000 watt generator need a 50 amp transfer switch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To use its full output, yes. A 30-amp, 240V connection carries at most 7,200 watts, while a 50-amp connection carries up to 12,000. Use the generator's 50-amp outlet with a 50-amp inlet, a 50-amp transfer switch or interlock, and a 6-gauge cord installed by an electrician."
          }
        },
        {
          "@type": "Question",
          "name": "Is an 11,000 watt generator big enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many 11,000 watt generators, including the Champion 201417 and DuroMax XP11000iH, are rated for 9,000 running watts. That covers essentials plus a soft-started central air system, but leaves less room for an electric water heater or dryer at the same time than the 10,500 and 12,000 running-watt models."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a 12,000 watt portable or a standby generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose portable if outages are occasional, you want to keep costs down and you can move and fuel the generator. Choose standby if outages are frequent or long, nobody can safely handle a 250 to 350 lb generator, or you want automatic power while away. Installation often costs as much as the unit."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "12000 watt generator",
      "12kw generator",
      "11000 watt generator",
      "12000 watt dual fuel generator",
      "50 amp generator",
      "whole house portable generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">12,000 Watt</span> Generators
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most 12,000 watt generators are 9,500 running-watt machines with a 50-amp outlet. A few genuinely run 10,500 to 12,000 watts. Here is which is which, what each one weighs, and the point where a standby unit makes more sense.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen10500dfc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#what-12kw-means"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            12,000 Watts, Decoded
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-12kw-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 12,000 Watts Means</a>
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What a 12kW Generator Runs</a>
          <a href="#50-amp" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 50-Amp Outlet</a>
          <a href="#weight-wheels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Weight and Wheel Kits</a>
          <a href="#fuel-runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Fuel and Runtime</a>
          <a href="#dual-tri-fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Dual Fuel and Tri Fuel</a>
          <a href="#standby-vs-portable" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When Standby Is Better</a>
          <a href="#11000-watt" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. 11,000 Watt Alternatives</a>
          <a href="#buying-checklist" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Buying Checklist</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Twelve thousand watts is where a portable generator starts to behave like a whole-house system: it can start central air, run a well pump and keep the kitchen going at the same time. But the label hides a big spread. Some 12,000 watt generators sustain 9,500 watts and weigh 220 lb; others sustain a true 12,000 and weigh nearly 350. Pick by running watts, the 50-amp outlet and whether you can actually move the thing.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Our Top 12,000 Watt Generator Picks
          </h2>

          <p>
            We compared rated running and starting watts on each fuel, outlet panels, rated runtime and tank size, dry weight, noise ratings, warranty and widely reported owner experience. We did not bench-test these units; every number below comes from the manufacturer's specifications or listing. All six are 120/240V open-frame generators with a 50-amp outlet, the feature that defines this class. They range from 9,500 to 15,000 running watts so you can see what each step up in running power costs in weight and fuel.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
