---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 10000 Watt Generators",
    "url": "/best-10000-watt-generator/"
  },
  {
    "title": "Best 12000 Watt Generators",
    "url": "/best-12000-watt-generator/"
  },
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  },
  {
    "title": "Best Manual Transfer Switches",
    "url": "/best-manual-transfer-switch/"
  },
  {
    "title": "Interlock Kit vs Transfer Switch",
    "url": "/interlock-kit-vs-transfer-switch/"
  },
  {
    "title": "Generator Extension Cord Size",
    "url": "/generator-extension-cord-size/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best Generators With a 50 Amp Outlet in 2026: 14-50R Picks";
const description =
  "Portable generators with a real 14-50R outlet, ranked by how many of its 50 amps they can deliver, plus RV and home inlet hookups and the right cord gauge.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen11500dfc",
    "name": "Westinghouse WGen11500DFc",
    "category": "Dual Fuel, 11,500W Running / 14,500W Peak, 14-50R",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "47.9 running amps at 240V on gasoline, the closest here to using a 50A outlet fully",
      "14-50R and L14-30R on the same panel",
      "Push-button, remote fob and recoil start",
      "CO sensor with automatic shutdown",
      "Westinghouse lists up to 19 hours at 25% load on a 9.5-gallon tank"
    ],
    "cons": [
      "Westinghouse lists 230 lb dry",
      "74 dBA rating, open-frame loud"
    ],
    "bottomLine": "If you are buying a generator for its 50 amp outlet, this is the one that can actually put close to 50 amps through it, with remote start and a CO shutoff included.",
    "description": "Most portables with a 14-50R can only push 35 to 40 amps per leg through it. The WGen11500DFc is the exception in this list: Westinghouse rates it at 11,500 running watts on gasoline and lists 47.9 running amps at 240V, so it uses about 96% of what a 50 amp outlet is built for. On propane it drops to 10,500 running watts and 43.8 amps, which is still more than most competitors make on gasoline. The panel carries two GFCI 5-20R duplex outlets, an L14-30R, the 14-50R and USB ports, and Westinghouse adds a CO sensor that shuts the engine down if exhaust builds up around it. Start it by push-button, by the included remote fob, or by recoil. Runtime is a strength, with Westinghouse listing up to 19 hours at quarter load and 9.5 hours at half load from a 9.5-gallon tank. The costs are size and noise: 230 pounds dry and a 74 dBA rating mean this lives on a pad well away from windows. For a 50 amp RV with two air conditioners, or a 50 amp inlet feeding a house with a well pump and central air, it is the right tool."
  },
  {
    "id": "westinghouse-wgen9500df",
    "name": "Westinghouse WGen9500DF",
    "category": "Dual Fuel, 9,500W Running / 12,500W Peak, 14-50R",
    "badge": "Best Value With Remote Start",
    "amazonUrl": "#",
    "pros": [
      "9,500 running watts on gasoline, about 39.6A at 240V",
      "14-50R, L14-30R and two GFCI 5-20R outlets",
      "Remote fob, push-button and recoil start, battery included",
      "Westinghouse lists up to 12 hours at 25% load on 6.6 gallons",
      "Propane option at 8,500 running watts"
    ],
    "cons": [
      "Uses about 79% of the 14-50R's capacity",
      "No CO sensor on this model; 211 lb dry"
    ],
    "bottomLine": "The most common way into a 14-50R with remote start. It will not fill a 50 amp service, but it runs a 50 amp RV or a home inlet sensibly for less money than the 11,500W units.",
    "description": "The WGen9500DF is the generator most people end up with when they search for a 50 amp portable, and for good reason. Westinghouse rates it at 9,500 running and 12,500 peak watts on gasoline and 8,500 and 11,200 on propane, with a panel that includes a 14-50R, an L14-30R twist-lock and two GFCI 5-20R duplex outlets. At 240V, 9,500 watts works out to about 39.6 amps, which means the 14-50R is a connector here, not a promise of 50 amps; plan your loads around roughly 40 amps per leg, or about 4,750 watts on each side of a 50 amp RV. Start options are the full set: push-button, an included remote key fob, and recoil, with the battery in the box. Westinghouse lists up to 12 hours at quarter load on the 6.6-gallon tank, 211 pounds dry, and a 74 dBA rating. There is no CO sensor on this version, which is the main reason it sits second. If you mostly care about start convenience rather than the outlet, it also appears in our electric start generator roundup."
  },
  {
    "id": "duromax-xp12000eh",
    "name": "DuroMax XP12000EH",
    "category": "Dual Fuel, 9,500W Running / 12,000W Starting, 50A Outlet",
    "badge": "Best Budget 14-50R",
    "amazonUrl": "#",
    "pros": [
      "9,500 running watts on gasoline and 9,025 on propane",
      "DuroMax lists 39.58A at 240V",
      "50A heavy-duty outlet plus 120/240V and 120V 30A twist-locks",
      "Push-button electric start with recoil backup",
      "All-metal frame and copper windings per the spec sheet"
    ],
    "cons": [
      "No remote start or CO shutoff",
      "Open-frame noise and a heavy, bulky frame"
    ],
    "bottomLine": "The least expensive route to a real 120/240V 50 amp outlet from a well-known brand. Loud and basic, but it delivers its rating on either fuel.",
    "description": "The XP12000EH is the budget workhorse with a 50 amp outlet. DuroMax's spec sheet rates it at 12,000 peak and 9,500 running watts on gasoline and 11,400 and 9,025 on propane, which means it loses only about 5% when you switch to propane, a smaller drop than most dual fuel generators. It lists 79.17 amps at 120V and 39.58 amps at 240V, so like the Westinghouse WGen9500DF it uses about 79% of the 50 amp outlet's capacity. The panel is well equipped: two 120V 20A GFCI outlets, a 120V 30A twist-lock, a 120/240V 30A twist-lock and the 120/240V 50A heavy-duty outlet, which is the 14-50R. Starting is by push-button with a recoil backup. DuroMax lists runtime of about 8.8 hours at half load on gasoline and 7.2 hours on propane. There is no remote fob and no CO shutoff, and it is an open-frame generator with the noise that implies, so placement matters. For an owner who wants a 14-50R for an RV pedestal-style hookup or a 50 amp inlet and does not need the extras, it is very hard to beat on value."
  },
  {
    "id": "duromax-xp13000eh",
    "name": "DuroMax XP13000EH",
    "category": "Dual Fuel, 10,500W Running / 13,000W Starting, 50A Outlet",
    "badge": "Best Headroom for the Money",
    "amazonUrl": "#",
    "pros": [
      "10,500 running watts on gasoline, 9,975 on propane",
      "DuroMax lists 43.75A at 240V, about 88% of a 50A outlet",
      "500cc OHV engine",
      "50A heavy-duty outlet plus 30A twist-locks and GFCI outlets",
      "Push-button electric start with recoil backup"
    ],
    "cons": [
      "DuroMax lists 234 lb dry",
      "No remote start or CO shutoff"
    ],
    "bottomLine": "One step up from the XP12000EH with about four more amps per leg. If you want more of your 50 amp outlet without paying for an 11,500W Westinghouse, this is the one.",
    "description": "The XP13000EH is the same idea as the XP12000EH with a bigger engine and more usable current. DuroMax rates it at 13,000 peak and 10,500 running watts on gasoline and 12,350 and 9,975 on propane from a 500cc OHV engine, and its spec sheet lists 87.5 amps at 120V and 43.75 amps at 240V. That is about four more amps per leg than the 9,500W generators in this list, which is roughly the difference between running one more large appliance or not, for example a second RV air conditioner alongside a microwave. The panel carries two 120V 20A GFCI outlets, a 120V 30A twist-lock, a 120/240V 30A twist-lock and the 120/240V 50A outlet. Starting is push-button with recoil backup. DuroMax lists about 8.5 hours at half load on gasoline and 6.5 on propane, and a 234-pound dry weight that makes it a two-person or wheel-only move. It lacks remote start and a CO shutoff, and at its size it is loud. For a buyer who wants headroom on the 14-50R at a budget price, it is the sensible step up; if you are weighing it against even larger units, the best 12000 watt generators guide covers that class."
  },
  {
    "id": "champion-201417",
    "name": "Champion 201417 11,000-Watt Electric Start Dual Fuel Inverter",
    "category": "Inverter, 9,000W Running / 11,000W Starting, 14-50R (37.5A)",
    "badge": "Quietest With a 14-50R",
    "amazonUrl": "#",
    "pros": [
      "Inverter output, rated 64 dB(A) measured at 23 feet",
      "Electric start with recoil backup",
      "CO Shield carbon monoxide shutoff",
      "Champion lists up to 15 hours at 25% load on gasoline",
      "14-50R, L14-30R, two GFCI 5-20R and a 12V outlet"
    ],
    "cons": [
      "Champion rates the 14-50R at 37.5A, not 50A",
      "Champion lists 205.1 lb"
    ],
    "bottomLine": "The quiet choice for a 50 amp RV or home inlet, as long as you accept that its 14-50R is rated for 37.5 amps. Champion is honest about that on the spec sheet; many listings are not.",
    "description": "The Champion 201417 is the one inverter in this list, and it is the best illustration of why the outlet label is not the whole story. Champion's own spec sheet lists the 14-50R as a 120/240V 37.5A outlet, which is exactly what 9,000 running watts divided by 240V works out to. The outlet accepts a 50 amp plug, and it will run a 50 amp RV or a 50 amp home inlet, but the current available is 37.5 amps per leg, or about 4,500 watts on each side of an RV panel. Within that limit it is the most pleasant generator here to live with. Champion rates it at 11,000 starting watts on both fuels and 9,000 running on gasoline or 8,100 on propane, and lists 64 dB(A) measured from 23 feet, far quieter than the 74 dBA open-frame units. Electric start comes with a recoil backup, and Champion's CO Shield shuts the engine down if carbon monoxide builds up. Champion lists up to 15 hours at quarter load on gasoline and 8 on propane from a 6.08-gallon tank, and a weight of 205.1 pounds. For campgrounds with quiet hours or a house where the generator sits close to bedrooms, it is the one to buy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Generators With a 50 Amp Outlet",
          item: "https://www.thehonestreviewers.com/best-generator-with-50-amp-outlet/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size generator do I need for a 50 amp RV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To use most of a 50 amp RV service you need about 9,000 running watts or more, which gives roughly 37 to 40 amps per leg. Two roof air conditioners plus normal loads usually fit on a 9,500 watt generator if you balance the legs. An 11,500 watt generator gives real margin for cooking and both air conditioners together."
          }
        },
        {
          "@type": "Question",
          "name": "Can a generator with a 50 amp outlet run my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the house. A 9,500 to 11,500 watt generator through a 50 amp inlet can run a well pump, refrigerator, freezer, furnace, lights and often a central air unit, but not an electric range, water heater and dryer at once. Add up running watts and stay under the generator's rating."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 14-50R the same as an RV 50 amp outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. RV parks use the NEMA 14-50R for 50 amp service, and 50 amp RVs have a 14-50P plug. A generator's 14-50R accepts that plug directly. The difference is how much current is behind it: a park pedestal supplies 50 amps per leg, while most portables supply 35 to 48 amps."
          }
        },
        {
          "@type": "Question",
          "name": "What gauge cord do I need for a 50 amp generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a 6 AWG cord with four conductors, labeled 6/4 or 6/3 with an 8 AWG ground. Keep it as short as practical, typically 25 to 30 feet, and choose an outdoor-rated jacket such as STW or SOOW. Never use 10 AWG wire with a 50 amp plug."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug a 50 amp RV into a 30 amp generator outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with a dogbone adapter into a TT-30R, but the RV then gets a single 30 amp, 120V feed on both legs, or about 3,600 watts. That runs lights, a fridge and maybe one air conditioner, not a 50 amp coach's full load. An L14-30R to 14-50 adapter is a different case and needs care with load."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 50 amp transfer switch for a 50 amp generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you want to use the generator's full output in the house. A generator over about 7,500 running watts can exceed what a 30 amp switch and L14-30 cord carry, so a 50 amp inlet and switch or interlock make sense. Below that, a 30 amp setup is cheaper and adequate."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my RV surge protector say open ground on the generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many portables have a floating neutral, meaning neutral and ground are not bonded at the generator. RV surge protectors look for that bond and flag it as a fault. A neutral-ground bonding plug in a spare outlet is the usual fix for RV use, but remove it if the generator feeds a house."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "generator with 50 amp",
      "50 amp generator",
      "generator with 14-50 outlet",
      "50 amp rv generator",
      "portable generator with 50 amp outlet",
      "14-50r generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          5 Best Generators With a <span class="text-[#38BDF8]">50 Amp Outlet</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A 14-50R lets a generator plug straight into a 50 amp RV or a 50 amp home inlet. What it does not tell you is how many amps the generator can actually push through it. These five have the outlet, and we rank them on how much of it they can use.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen11500dfc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 5 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The 5 Best Picks</a>
          <a href="#what-is-14-50" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The NEMA 14-50R, Explained</a>
          <a href="#amp-math" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Why a 50 Amp Outlet Does Not Mean 12,000 Watts</a>
          <a href="#which-have-one" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Which Portables Actually Have a 14-50R</a>
          <a href="#rv-hookup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Running a 50 Amp RV on a Generator</a>
          <a href="#home-hookup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Using a 14-50R for Home Backup</a>
          <a href="#cord-gauge" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cord Gauge</a>
          <a href="#50-vs-30" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. 14-50R vs L14-30R</a>
          <a href="#setup-safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Setup and Safety at 50 Amps</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A generator with a 50 amp outlet is not a 50 amp generator. The NEMA 14-50R on the panel is rated for 50 amps, but the generator behind it usually supplies 37 to 48 amps per leg, because a 50 amp, 240V circuit is 12,000 watts and very few portables run that hard. The five generators below all carry a true 120/240V 14-50R, and they are ranked on what you can actually draw from it, for a 50 amp RV or a 50 amp inlet on a house.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 5 Best Generators With a 50 Amp Outlet, Ranked
          </h2>

          <p>
            Ranked on usable amps through the 14-50R, start options, safety features and value. Watts and amps come from manufacturer spec sheets; where a figure was not published or listings disagreed, we left it out. Every pick has electric start and a 120/240V 14-50R.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
