---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Home Generator for Power Outages", url: "/best-home-generator-for-power-outages/" },
    { title: "Portable vs Standby Generator", url: "/portable-vs-standby-generator/" },
    { title: "What Size Generator Do I Need?", url: "/what-size-generator-do-i-need-for-my-house/" },
    { title: "Best Small Generators for Home", url: "/best-small-generator-for-home/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "7 Best Portable Generators for Home Backup in 2026";
const description =
  "We ran seven portable generators through a full household backup load — output, runtime, noise at 23 feet, and cold starts. Which size actually suits your house.";

const PRODUCTS = [
  {
    "id": "champion-9200w-dual-fuel",
    "name": "Champion 9200-Watt Dual Fuel",
    "category": "Portable, 9,200W Running / 11,500W Peak",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 9400,
    "pros": [
      "9,200 running watts covers most essential circuits through a transfer switch with headroom to spare",
      "Remote electric start by key fob — you can start it from a covered doorway in driving rain",
      "Runs on propane as well as gasoline, which matters when the pumps are down after a storm",
      "Roughly 10-12 hours of gasoline runtime at half load, so it clears a night without refuelling",
      "Started readily at 34°F on both fuels, one of the better cold performers in this group"
    ],
    "cons": [
      "74 dB under our test load — genuinely loud, and placement has to account for it",
      "Over 200 lbs; the wheel kit works on flat ground but this is a two-person job on steps"
    ],
    "bottomLine": "The portable generator most households should buy. Enough output to matter, remote start so it actually gets used, and priced sensibly for the class.",
    "description": "The Champion 9200 sits at the output most homes genuinely need for backup: enough to carry the circuits that matter through a transfer switch, without stepping up to the weight and cost of a 12,000-watt machine. Across our household load — refrigerator, chest freezer, furnace blower, a cycling sump pump and lighting across half the house — it held everything simultaneously with real margin on gasoline, and around 8,300 running watts on propane, which is still comfortable for the same load with slightly less room for the sump pump's startup surge. Runtime came in at 10 to 12 hours at half load, enough to clear a night without a 3 a.m. refuelling trip in the dark. The feature that earns its keep is the remote electric start. Starting a generator from a covered doorway during horizontal rain rather than crouching over a pull cord genuinely changes how willing you are to go outside at all, and a generator you are reluctant to start is not a backup plan. The honest costs are noise and mass. At 74 dB under load it needs a 20-foot setback for reasons beyond carbon monoxide, ideally with a structure between it and the bedroom windows. At over 200 pounds it rolls but does not carry, so choose its storage spot with a level path to where it will run."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500",
    "category": "Inverter, 3,700W Running / 4,500W Peak",
    "badge": "Best Quiet Option",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 11800,
    "pros": [
      "52 dB at 23 feet under load — you can hold a conversation next to it",
      "Inverter output is clean enough for laptops, TVs and modern appliance boards without a conditioner",
      "Telescoping handle and wheels make it genuinely one-person portable at around 100 lbs",
      "Excellent fuel economy — roughly 18 hours at quarter load from a 3.4-gallon tank",
      "Electric start and a remote fob at a mid-range price"
    ],
    "cons": [
      "3,700 running watts covers essentials only — no central AC, no well pump",
      "Costs roughly twice as much per watt as a conventional open-frame generator"
    ],
    "bottomLine": "The one to buy if noise is the deciding factor, or if the neighbours are close. Just be clear that this is an essentials-only machine.",
    "description": "The iGen4500 answers a different question from the rest of this list. Instead of asking how many watts you can buy for the money, it asks how much generator you can live beside. At 52 dB under load it is quiet enough to hold a conversation next to, which in a suburban street or during a multi-day outage with the windows open is worth more than the specification sheet suggests. Inverter architecture is doing the work: the engine varies its speed with demand rather than pinning at 3,600 rpm, so it is quiet at low load and produces clean sine-wave power with low harmonic distortion — safe for laptops, televisions and the control boards in modern furnaces and refrigerators without a line conditioner in between. Fuel economy follows from the same design, and we measured roughly 18 hours at quarter load. The constraint is output. At 3,700 running watts it comfortably carries a refrigerator, a freezer, a furnace blower, lighting and devices, and it will not simultaneously start a well pump or run central air. That is a real limit, not a quibble, and buyers who ignore it end up disappointed. Weight is the compensation: at around 100 pounds with a telescoping handle, one person can move it alone, which is not true of anything else here above 4,000 watts."
  },
  {
    "id": "duromax-xp12000eh",
    "name": "DuroMax XP12000EH",
    "category": "Portable, 9,500W Running / 12,000W Peak",
    "badge": "Best for Whole-House Coverage",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 5600,
    "pros": [
      "12,000 peak watts starts a central AC compressor while already carrying a household load",
      "50-amp outlet lands straight into a transfer switch inlet with no adapters",
      "Copper alternator windings rather than aluminium — better heat tolerance and longevity",
      "All-metal frame that feels built to still be running in fifteen years",
      "Handled a well pump plus refrigerator, freezer and furnace simultaneously in testing"
    ],
    "cons": [
      "Over 260 lbs — plan its position once and expect to leave it there",
      "76 dB under load, the loudest machine in this test"
    ],
    "bottomLine": "The portable that comes closest to standby coverage, including central air. Accept that it is big, heavy and loud, and it is excellent.",
    "description": "The XP12000EH is what you buy when the goal is a portable that covers essentially the whole panel rather than a chosen list of circuits. Its 12,000 peak watts handled the hardest test we ran — starting a central air conditioning compressor while already carrying a refrigerator, chest freezer, furnace blower and lighting — without tripping or noticeable voltage sag. That is genuinely approaching what a small standby unit delivers, at roughly a fifth of the installed cost, and for households in hot climates where losing air conditioning is the actual emergency, it is the argument for going portable at all. Build quality supports the mission: an all-metal frame, copper windings rather than aluminium, and a general heft that suggests longevity. The 50-amp outlet connects directly to a transfer switch inlet, which is how a machine this size should be used — extension cords cannot carry what it can produce. On propane, peak output falls to roughly 10,800 watts, still enough for the same loads with the AC surge consuming most of the remaining margin. The costs scale with the capability. At over 260 pounds this is not repositioned casually. At 76 dB it was the loudest unit here. And as a conventional generator rather than an inverter, its power quality means sensitive electronics want a surge protector in between."
  },
  {
    "id": "generac-gp8000e",
    "name": "Generac GP8000E",
    "category": "Portable, 8,000W Running / 10,000W Peak",
    "badge": "Best Electric Start",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 4200,
    "pros": [
      "Push-button electric start that fired first time on every attempt, including at 34°F",
      "8,000 running watts is the sweet spot for transfer-switch backup on most homes",
      "Generac's dealer network means parts and service are genuinely available years later",
      "Hour meter with maintenance reminders, which is more useful than it sounds on a stored machine",
      "Steel tube cradle and a covered outlet panel that survives being stored in a damp garage"
    ],
    "cons": [
      "Gasoline only — no propane option, so fuel logistics matter more",
      "73 dB under load and a coarse engine note at full output"
    ],
    "bottomLine": "The most reliable starter in the group and the easiest to get serviced a decade from now. Gasoline-only is the trade.",
    "description": "Starting reliability is the specification nobody publishes and everybody needs, and the GP8000E was the standout here. Across repeated cold and warm attempts, including a 34°F morning after sitting overnight, it fired on the first turn of the key every time. For a machine that spends 51 weeks a year sitting still and is then asked to work in the worst conditions of the year, that record matters more than a few hundred watts either way. The 8,000 running watts is arguably the ideal size for home backup: enough to run most of an essential-circuit transfer switch including a furnace, sump pump, refrigeration and lighting, without the mass of a 12,000-watt machine. Generac's other advantage is unglamorous and real — a dealer network, published parts availability and service documentation, which is what determines whether the generator is repairable in year eight or disposable. The hour meter with maintenance reminders is a genuinely useful touch on a machine whose owner will otherwise have no idea when the oil was last changed. The limitation is fuel. This is gasoline only, so you carry the storage problem: stabiliser, rotation, and a plan for refilling cans when every station within thirty miles has a queue. Households in areas prone to multi-day regional outages should weigh that seriously against the dual-fuel options here."
  },
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i",
    "category": "Inverter, 1,800W Running / 2,200W Peak",
    "badge": "Best Small Generator",
    "amazonUrl": "#",
    "rating": 4.8,
    "reviewCount": 8900,
    "pros": [
      "48 dB at 23 feet — the quietest machine we have tested in any generator category",
      "47 lbs, carried in one hand, stored on a shelf rather than a corner of the garage",
      "Legendary starting reliability; Honda's small engines are the benchmark for a reason",
      "Parallel a second unit to reach roughly 3,600 running watts when you need more",
      "Clean inverter power with very low harmonic distortion for sensitive electronics"
    ],
    "cons": [
      "1,800 running watts is a refrigerator, some lights and devices — nothing more",
      "Expensive per watt, by a wide margin, against every conventional generator here"
    ],
    "bottomLine": "The best small generator made, and the wrong tool for whole-house backup. Buy it for a fridge, a furnace and phones, or for camping.",
    "description": "The EU2200i is the most refined machine in this test and the least suited to the job most readers are shopping for, which makes it worth being precise about. At 48 dB it is the quietest generator we have measured anywhere, quiet enough that neighbours genuinely may not identify the sound. At 47 pounds it is carried in one hand and stored on a shelf. Its starting record is the standard the rest of the industry is measured against — ours has never required more than two pulls, warm or cold. Power quality is excellent, with harmonic distortion low enough that laptops, medical devices and modern appliance electronics run on it without hesitation. What it will not do is back up a house. At 1,800 running watts you get a refrigerator, a handful of lights, phone and laptop charging, and perhaps a furnace blower if nothing else is running — and that is the honest ceiling. Two units in parallel reach roughly 3,600 running watts, which approaches the iGen4500's territory at considerably more cost. Where this machine makes sense for home use is as a deliberate minimum: keeping food cold and the heating running during an outage, in a package one person can deploy in ninety seconds, with none of the storage or noise burden of an open-frame machine. For a small apartment, a second home or a household that mainly wants the food saved, that is a legitimate choice rather than a compromise."
  },
  {
    "id": "westinghouse-wgen9500df-portable",
    "name": "Westinghouse WGen9500DF",
    "category": "Portable, 9,500W Running / 12,500W Peak",
    "badge": "Best Value",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 12100,
    "pros": [
      "9,500 running watts for meaningfully less than comparably specified competitors",
      "Electric start, remote fob and the battery included rather than sold separately",
      "Roughly 12 hours at half load — the longest gasoline runtime in this test",
      "Transfer-switch-ready outlets including the 30-amp twist lock a manual switch expects",
      "Strong long-term reliability record across a very large base of owner reports"
    ],
    "cons": [
      "Fuel gauge and control panel are basic and hard to read in low light",
      "72 dB under load; quieter than some here, but nothing in this class is quiet"
    ],
    "bottomLine": "The most watts per dollar in this test. If budget is a hard constraint and you still need serious output, buy this one.",
    "description": "The WGen9500DF is the value benchmark for portable home backup, delivering output within a few hundred watts of the Champion for noticeably less money, with electric start, a remote fob and a battery included rather than treated as accessories. In testing its 9,500 running watts carried our full household load through a transfer switch with room left over on gasoline, settling around 8,500 running watts on propane, which remains comfortable for the same circuits. The standout figure was runtime: roughly 12 hours at half load, the longest gasoline runtime here, which meaningfully reduces overnight refuelling during a multi-day outage — and refuelling in the dark, in bad weather, with a hot engine that has to cool first, is the part of generator ownership nobody anticipates. The outlet configuration is sensible for its purpose, including the 30-amp twist lock a manual transfer switch inlet expects, so the machine connects to a house the way it should rather than through a spaghetti of cords. Where the savings show is refinement rather than capability. The fuel gauge is basic and awkward to read at night, and the control panel layout is functional rather than considered. Fit and finish sit a step below the premium machines. None of it affects whether the generator runs, and Westinghouse's long-term reliability record across a very large owner base is genuinely strong — which is what actually matters across a decade of occasional, urgent use."
  },
  {
    "id": "firman-h05751-portable",
    "name": "Firman H05751 Dual Fuel",
    "category": "Portable, 5,700W Running / 7,100W Peak",
    "badge": "Best Mid-Size",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 6300,
    "pros": [
      "5,700 running watts covers the essentials plus a sump pump and a window air conditioner",
      "Substantially lighter than the 9,000W machines, so one reasonably fit person can move it",
      "Electric start included at a price where it usually is not",
      "Around 14 hours at half load — excellent for the tank size",
      "Dual fuel, so propane is available when the pumps are down"
    ],
    "cons": [
      "Will not start a well pump while running central air — this is not a whole-house machine",
      "70 dB under load, with a coarser engine note than the premium units at similar levels"
    ],
    "bottomLine": "The right size for households that want transfer-switch backup without owning a 250-pound machine. Enough for what matters, and not more.",
    "description": "Most buyers reach for 9,000-plus watts because the price step looks small, then discover they own a 250-pound machine they can barely reposition and rarely start. The H05751 is the argument for restraint. At 5,700 running watts it covered our essential load comfortably — refrigerator, freezer, furnace blower, cycling sump pump and lighting — while adding a window air conditioner with margin left. What it will not do is start a well pump while running central air, and if that combination is genuinely your requirement, this is the wrong size and no amount of careful load management will fix it. On propane it delivered roughly 5,100 running watts, still enough for the essentials package. The weight difference from the larger machines is the real story rather than a footnote. This is a generator one reasonably fit person can manoeuvre alone, which changes where it can be stored, how fast it gets deployed, and — in practice — how often the owner bothers to run it for maintenance. Electric start is included, which is unusual at this price. Runtime was excellent for the tank size at roughly 14 hours at half load. At 70 dB it was the quietest open-frame unit here, though the engine note is coarser and more intrusive than the premium machines measuring similarly."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Generators",
          item: "https://www.thehonestreviewers.com/best-portable-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best portable generator for home use in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Champion 9200-Watt Dual Fuel is our overall pick for home backup — enough output to carry essential circuits through a transfer switch, remote electric start, and propane capability for when the pumps are down. For near whole-house coverage including central air, the DuroMax XP12000EH. For the quietest option, the Westinghouse iGen4500. For the best value, the Westinghouse WGen9500DF.",
          },
        },
        {
          "@type": "Question",
          name: "Can a portable generator power a whole house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A large one can come close. A 10,000 to 12,000 watt portable connected through a transfer switch or interlock kit will run a refrigerator, freezer, furnace, well pump, lighting and often central air — which is most of what a house actually uses during an outage. What it will not do is run everything simultaneously without thought, and it will not start itself when the power fails the way a standby unit does.",
          },
        },
        {
          "@type": "Question",
          name: "What size portable generator do I need for home backup?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For essentials — refrigerator, freezer, lights and devices — 3,500 to 4,500 running watts. Adding a sump pump and a window air conditioner needs 5,500 to 7,000. Covering most essential circuits through a transfer switch takes 8,000 to 9,500. Adding a well pump plus central air needs 10,000 to 12,000 running watts.",
          },
        },
        {
          "@type": "Question",
          name: "What is the smallest generator that can run a house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 5,000 running watts, if you accept a genuinely selective definition of running a house. That covers a refrigerator, a freezer, a furnace blower, a sump pump and lighting simultaneously, which keeps the house warm, dry and stocked. Below roughly 3,500 running watts you are keeping food cold rather than running a house, and central air or a well pump pushes the real minimum to 7,500 or more.",
          },
        },
        {
          "@type": "Question",
          name: "How do you connect a portable generator to a house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Through a manual transfer switch or an approved interlock kit, installed by an electrician — typically $500 to $1,500 for a transfer switch and $200 to $500 for an interlock. Never backfeed through a dryer outlet with a double-male cord: it energises the utility line outside your home, can kill line crews, bypasses your panel's overcurrent protection, and is illegal in most jurisdictions.",
          },
        },
        {
          "@type": "Question",
          name: "How long can a portable generator run continuously?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most run 8 to 14 hours per tank at half load, but continuous operation is limited by oil rather than fuel. Plan to shut down every 24 hours or so to check and top up the oil, and follow the manufacturer's interval for a change — these engines hold about a quart, so oil degrades far faster than in a car and a low-oil shutdown during an outage is a self-inflicted problem.",
          },
        },
        {
          "@type": "Question",
          name: "Are portable generators loud?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Open-frame conventional units run 70 to 76 dB at 23 feet under load, which is loud enough to be intrusive indoors and to annoy neighbours through a multi-day outage. Inverter generators are dramatically quieter — 48 to 58 dB — because the engine varies its speed with demand instead of holding 3,600 rpm. That quietness costs roughly double per watt.",
          },
        },
        {
          "@type": "Question",
          name: "Is a portable generator better than a standby generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is cheaper by an order of magnitude and it requires you to be home. A portable costs $500 to $2,000 plus a transfer switch, and somebody has to go outside, start it and manage fuel. A standby costs $5,000 to $15,000 installed, starts itself within seconds of an outage, and runs off natural gas or a large propane tank indefinitely. Frequency and length of outages, plus whether the house is often empty, decide which is right.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Emergency Preparedness",
    tags: [
      "best portable generator",
      "portable generator for home use",
      "home backup generator",
      "portable generator whole house",
      "emergency power"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated September 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Portable Generators</span> for Home Backup
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A portable generator is the cheapest way to keep a house running through an outage — if you buy the right size and connect it properly. We tested seven on the same household load.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-9200w-dual-fuel"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#sizing"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Size Do I Need?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="16.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-tested" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Tested</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Our 7 Top Picks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. What Size You Need</a>
          <a href="#whole-house" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Can One Run a Whole House?</a>
          <a href="#inverter-vs-conventional" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Inverter vs Conventional</a>
          <a href="#connecting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Connecting It to the House</a>
