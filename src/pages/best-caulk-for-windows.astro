      "Brush-paintable in about 20 minutes, per DAP",
      "Cleans up with water",
      "Exceeds ASTM C834, with a 50-year warranty",
      "Easy to tool into a clean line"
    ],
    "cons": [
      "White only",
      "Not for moving exterior frame joints",
      "Full cure still takes 7 to 14 days"
    ],
    "bottomLine": "For interior window trim you want to caulk and paint the same day, DAP Alex Fast Dry is the pick, brush-paintable in about 20 minutes per DAP."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
