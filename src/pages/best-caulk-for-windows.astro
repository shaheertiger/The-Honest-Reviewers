];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Caulks for Windows: Exterior Frames and Interior Trim";
const description =
  "The best caulk for windows, inside and out: exterior frame-to-siding sealants and paintable trim caulks compared on movement, paint time and cold-weather range.";

const PRODUCTS = [
  {
    "id": "osi-quad-max",
    "name": "OSI Quad Max Window, Door & Siding Sealant",
    "badge": "Best Overall",
    "category": "Exterior Sealant, Plus or Minus 50% Movement",
    "amazonUrl": "#",
    "description": "OSI Quad Max is the exterior window sealant we would reach for first, because it combines the biggest movement rating we could verify with the widest application window. OSI's data sheets list joint movement of plus or minus 50 percent under ASTM C719, and the clear version's sheet gives a maximum elongation of 458 percent. It can be applied from 0 to 140 degrees, which covers almost any day you would want to be on a ladder, and OSI recommends keeping cartridges at room temperature for 24 hours before cold-weather use. OSI markets it as paintable in about an hour with latex paint or primer, and lists a full cure of 24 to 72 hours depending on conditions. Skin time varies by version, from 8 to 10 minutes on the current clear sheet to 17 to 20 minutes on others, so tool quickly. One important limit: OSI says not to tool or smear it on prefinished colored cladding, so run a neat bead and leave it. Joints deeper than 3/8 inch need backer material.",
    "pros": [
      "Plus or minus 50 percent movement under ASTM C719, per OSI",
