---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best 3500 Watt Generators",
    "url": "/best-3500-watt-generator/"
  },
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  },
  {
    "title": "Best Dual Fuel Inverter Generators",
    "url": "/best-dual-fuel-inverter-generator/"
  },
  {
    "title": "Best Generators With a 50 Amp Outlet",
    "url": "/best-generator-with-50-amp-outlet/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 4000 Watt Generators in 2026: Runs a 13,500 BTU AC";
const description =
  "The best 4000 watt generators to start a 13,500 BTU RV air conditioner or run a window AC and fridge. 4500W inverters, 30A RV and 240V outlets, weights.";

const PRODUCTS = [
  {
    "id": "champion-201319-dual-fuel-inverter",
    "name": "Champion 201319 4500-Watt Electric Start Dual Fuel Portable Inverter Generator with CO Shield",
    "category": "Enclosed Dual Fuel Inverter, 3,500W Running / 4,500W Starting",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Rated 4,500 starting and 3,500 running watts on gasoline",
      "Dual fuel, with 3,150 running watts listed on propane",
      "Electric start plus CO Shield carbon monoxide shutoff",
      "Listed at 61 dBA, quiet enough for most campgrounds",
      "Up to 14 hours on gasoline and 21 on propane at 25 percent load"
    ],
    "cons": [
      "Listed weights range from about 92 to 99 lb",
      "Not sold in California per some retailer listings"
    ],
    "bottomLine": "The 4500 watt inverter most RV owners should buy: enough surge for a 13,500 BTU AC, propane, a push button and CO Shield.",
    "description": "The Champion 201319 is the generator that best matches what people buy this size for. Champion rates it at 4,500 starting and 3,500 running watts on gasoline, which is the surge a 13,500 BTU rooftop air conditioner typically needs to start, with enough running capacity left to keep the RV refrigerator, converter and lights going. On propane it is listed at 3,150 running watts, so a summer trip on LP works best with a soft starter on the AC. It is an enclosed inverter, listed at 61 dBA, which keeps it inside most campground quiet-hour expectations and well below an open-frame generator of similar output. Electric start means a button instead of a pull cord, and CO Shield shuts the engine down if carbon monoxide builds up around the unit, a real concern when a generator sits beside a camper door. Runtime is rated at up to 14 hours on gasoline and up to 21 hours on propane at 25 percent load. The panel includes a TT-30R RV outlet, so a 30-amp shore cord plugs straight in. Listed weights run from about 92 to 99 pounds depending on the source, so treat it as a wheeled unit, not a carry-on. If you never use propane, Champion sells a gasoline-only 4500 watt inverter, the 201318."
  },
  {
    "id": "wen-df450i",
    "name": "WEN DF450i 4500-Watt Dual Fuel RV-Ready Inverter Generator",
    "category": "Enclosed Dual Fuel Inverter, 3,500W Running / 4,500W Surge",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Rated 4,500 surge and 3,500 running watts on gasoline",
      "Keeps 4,500 surge watts on propane, with 3,150 running",
      "Listed at 58 dBA at quarter load from 22 feet",
      "Onboard wheels, folding handle and a TT-30R RV outlet",
      "Parallel capable and backed by a 3-year limited warranty"
    ],
    "cons": [
      "No CO shutoff listed on this model",
      "Small 2.2 gallon tank, rated up to 8.5 hours at half load"
    ],
    "bottomLine": "Most of the Champion 201319 for less money, with a quieter rating, but no CO shutoff and a smaller tank.",
    "description": "The WEN DF450i is the value pick in the 4500 watt inverter class and the closest rival to the Champion. WEN rates it at 4,500 surge and 3,500 running watts on gasoline, and unusually it keeps the full 4,500 surge rating on propane while running watts drop to 3,150. That surge figure is what starts an RV air conditioner, so holding it on LP is a genuine advantage for propane campers. WEN lists it at 58 dBA at quarter load measured from 22 feet, and it includes Eco-Mode, a fuel shutoff for running the carburetor dry before storage, a digital fuel and load display, and low-oil and low-fuel shutdown. The panel has two 120 volt household outlets, a TT-30R RV outlet, a 12 volt outlet and USB charging, and it can be paired with a second unit using WEN's parallel kit. Onboard wheels and a folding handle make it easy to roll. The trade-offs are the reasons it costs less. There is no carbon monoxide shutoff listed, which we would otherwise treat as standard, and the 2.2 gallon tank is rated for up to 8.5 hours at half load on gasoline, so an air-conditioned afternoon will need a refill. On a 20 pound propane tank WEN rates it for up to 9 hours at half load."
  },
  {
    "id": "champion-201320-4500w-open-frame-inverter",
    "name": "Champion 201320 4500-Watt Open Frame Inverter Generator with CO Shield",
    "category": "Open-Frame Inverter, 3,650W Running / 4,500W Starting",
    "badge": "Most Running Watts per Pound",
    "amazonUrl": "#",
    "pros": [
      "Rated 3,650 running and 4,500 starting watts",
      "Champion lists just 78 lb, light for the output",
      "Up to 22 hours on a 4.02 gallon tank at 25 percent load",
      "CO Shield shutoff, TT-30R and 5-20R outlets, 12V DC",
      "Parallel capable with an optional kit"
    ],
    "cons": [
      "Recoil start only",
      "No wheels; you carry it by the frame"
    ],
    "bottomLine": "The most running watts and runtime per pound in the class, if you are happy with a pull cord and no wheels.",
    "description": "The Champion 201320 puts more running watts in less weight than anything else here. Champion rates it at 3,650 running and 4,500 starting watts and lists it at 78 pounds, around 15 to 20 pounds lighter than the enclosed 4500 watt inverters. The open frame is the reason: there is no plastic shell and less sound insulation, so it is listed at 64 dBA rather than the high 50s, but it keeps inverter power quality and economy mode. Runtime is the other standout. With a 4.02 gallon steel tank, Champion rates it for up to 22 hours at 25 percent load, roughly double some enclosed models, which matters for long home outages where the load is a refrigerator, a window air conditioner and lights. The outlet panel has a TT-30R for an RV, a 5-20R household outlet and a 12 volt DC outlet, CO Shield shuts the engine down if carbon monoxide builds up, and it can run in parallel with a compatible Champion inverter using a kit sold separately. The two things to accept are recoil start only and no wheels. At 78 pounds two people can lift it into a truck, but one person will want a cart. It runs on gasoline only."
  },
  {
    "id": "wen-df472x",
    "name": "WEN DF472X 4750-Watt 120V/240V Dual Fuel Portable Generator with CO Shutdown Sensor",
    "category": "Open-Frame Dual Fuel, 3,800W Running / 4,750W Surge, 120/240V",
    "badge": "Best for a Transfer Switch",
    "amazonUrl": "#",
    "pros": [
      "Rated 3,800 running and 4,750 surge watts on gasoline",
      "3,500 running and 4,350 surge watts on propane",
      "L14-30R 120/240 volt outlet for a transfer switch or interlock",
      "CO shutdown sensor, per the listing",
      "Most running watts of any generator here"
    ],
    "cons": [
      "Conventional open frame, so louder and less efficient at light load than an inverter",
      "Recoil start per retailer listings; no remote or electric start"
    ],
    "bottomLine": "The only pick here with 240 volts, which makes it the 4000 watt class generator for feeding a house panel.",
    "description": "The WEN DF472X is in this guide for one reason the inverters cannot match: it has a 120/240 volt L14-30R outlet. That is the four-prong twist-lock that most generator inlet boxes, manual transfer switches and panel interlock kits are built around, so this is the 4000 watt class generator to buy if you want to power house circuits rather than run extension cords. WEN rates it at 3,800 running and 4,750 surge watts on gasoline and 3,500 running and 4,350 surge watts on propane from a 224cc engine, the most running watts of anything here. That is enough for a refrigerator, a gas furnace blower, lights, a sump pump and a 10,000 BTU window air conditioner if you stagger the starts. It also carries a CO shutdown sensor. The compromises come with the conventional design. It runs at a fixed engine speed, so it is louder and burns more fuel than an inverter at light load, and its output is not as clean, though most household appliances do not care. Retailer listings describe it as recoil start. RV owners should note that the panel is built around the L14-30R; check the outlet layout or plan on an adapter before relying on it for a 30-amp trailer."
  },
  {
    "id": "westinghouse-igen4000dfc",
    "name": "Westinghouse iGen4000DFc Dual Fuel Inverter Generator with Remote Start and CO Sensor",
    "category": "Enclosed Dual Fuel Inverter, 3,300W Running / 4,000W Peak",
    "badge": "Quietest",
    "amazonUrl": "#",
    "pros": [
      "Westinghouse lists 52 dBA, the quietest rating here",
      "Remote start key fob and automatic CO shutdown",
      "Dual fuel: 3,300 running watts on gasoline, 2,970 on propane",
      "Up to 17 hours on propane at 25 percent load",
      "Compact, about 21 x 13 x 19 inches"
    ],
    "cons": [
      "Only 4,000 peak watts, the least surge in this group",
      "1.69 gallon tank, rated about 7 hours on gasoline at 25 percent load"
    ],
    "bottomLine": "The campground-friendly 4000 watt generator: very quiet, propane-friendly and remote start, but it may need a soft starter for a rooftop AC.",
    "description": "The Westinghouse iGen4000DFc is the literal 4000 watt generator in this guide, and its strength is how little noise it makes for the output. Westinghouse lists it at 52 dBA, the quietest rating here and quiet enough that neighbors in a campground are unlikely to notice it over normal conversation. It is rated for 4,000 peak and 3,300 running watts on gasoline and 3,600 peak and 2,970 running watts on propane. The key fob starts it from inside the camper, and an automatic carbon monoxide shutdown stops it if CO builds up. Propane is where it shines, with Westinghouse rating it at up to 17 hours at 25 percent load, against about 7 hours from its small 1.69 gallon gasoline tank. The limitation is surge. At 4,000 peak watts, it has the least starting headroom of the five, and a 13,500 BTU rooftop air conditioner that surges hard on a hot afternoon may trip it, especially on propane. A soft starter on the AC is the usual fix. Without one, the Champion 201319 or WEN DF450i are safer. For a household with a window air conditioner and a refrigerator, or a camper in mild weather, it is the most pleasant generator here to live next to."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 4000 Watt Generator",
          item: "https://www.thehonestreviewers.com/best-4000-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a 4000 watt generator run a 13,500 BTU RV air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. A 13,500 BTU unit runs at roughly 1,300 to 1,800 watts but surges well above 3,000 watts when starting. A generator with 4,500 starting watts handles that in most conditions with the refrigerator and lights running. A 4,000 peak watt unit is borderline on hot days or at altitude; a soft starter fixes it."
          }
        },
        {
          "@type": "Question",
          "name": "What will a 4000 watt generator run in a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It runs a refrigerator, a 10,000 BTU window air conditioner, lights, a router and a television together, or in winter a refrigerator, gas furnace blower, lights and a 1/2 horsepower sump pump. It will not run central air, electric heat, an electric water heater or an electric range. Stagger motor starts to stay within the surge rating."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 4500 watt generator the same as a 4000 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are the same class. Model names usually quote starting watts, and most so-called 4000 watt generators are sold as 4500 watt units with 3,500 to 3,800 running watts. The Westinghouse iGen4000DFc is rated 4,000 peak and 3,300 running; the Champion 201319 and WEN DF450i are rated 4,500 starting and 3,500 running."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a 4500 watt inverter generator weigh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Enclosed 4500 watt inverters are typically listed at around 90 to 100 pounds, which is why most come with wheels and a telescoping handle. Open-frame inverters can be lighter; Champion lists the 201320 at 78 pounds. Compact inverters below this class weigh around 50 pounds but give up the surge an air conditioner needs."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 4000 watt generator run a 30 amp RV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A 30 amp RV outlet, the TT-30R, is rated for 3,600 watts, which matches the running capacity of this class. Four of our five picks have a TT-30R built in. You can run the air conditioner, refrigerator, converter and lights, but avoid running the microwave and water heater element together with the AC."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 240 volt generator for a transfer switch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most panel interlock kits and whole-panel inlet setups, yes. They expect a 120/240 volt L14-30R outlet so the generator can feed both legs of the panel. Some small transfer switches for a few circuits work with 120 volt L5-30R outlets. Check your switch before buying; the WEN DF472X is our 240 volt pick."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 4500 watt generator run on a tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on tank size and load. Rated runtimes at 25 percent load range from about 7 hours on the Westinghouse iGen4000DFc to 22 hours on the Champion 201320. With an air conditioner running, expect roughly half the rated figure. Propane extends runtime considerably, and a 20 pound cylinder often outlasts a small gasoline tank."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "4000 watt generator",
      "4000 watts generator",
      "4500 watt generators",
      "best 4000 watt generator",
      "4500 watt inverter generator",
      "generator for 13500 btu rv ac"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">4000 Watt</span> Generators
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The step up from 3,500 watts that buys one thing: enough surge to start an air conditioner while the refrigerator keeps running.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-201319-dual-fuel-inverter"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-4000-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 4,000 Watts Means</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best Picks</a>
          <a href="#rv-ac" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Starting a 13,500 BTU RV AC</a>
          <a href="#window-ac" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Window AC Plus Fridge at Home</a>
          <a href="#inverter-4500" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The 4500W Inverter Class</a>
          <a href="#outlets" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. TT-30R, L14-30R and 50A RVs</a>
          <a href="#weight-wheels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Weight and Wheels</a>
          <a href="#derating" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Heat, Altitude and Propane</a>
          <a href="#fuel-runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Runtime and Fuel</a>
          <a href="#bigger-smaller" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. When to Go Bigger or Smaller</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The 4000 watt class exists for the air conditioner. A 3500 watt generator carries a refrigerator, furnace blower and sump pump, but it struggles the moment a 13,500 BTU RV air conditioner or a window unit tries to start on top of that. Four to 4,750 starting watts is where that stops being a gamble. Here is what the class really delivers, why most of it is labelled 4500, and the five models worth buying.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-4000-means" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What a 4000 Watt Generator Really Is
          </h2>

          <p>
            Shop for a 4000 watt generator and you will find almost nothing that runs 4,000 watts continuously. The label refers to the starting, or peak, rating. The real class spans roughly 4,000 to 4,750 starting watts and 3,300 to 3,800 running watts, and most of the best sellers are marketed as 4500 watt generators. The Westinghouse iGen4000DFc below is rated 4,000 peak and 3,300 running; the Champion 201319 and WEN DF450i 4,500 starting and 3,500 running; the WEN DF472X 4,750 surge and 3,800 running.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Gain Over 3500 Watts Is Surge</h3>

          <p>
            Compared with the 3500 watt class, the gain in running watts is small, often 0 to 300 watts. The gain that matters is surge. A good 3500W generator offers 4,250 to 4,650 starting watts on an open frame, but the compact inverters sold at 3,500 often stop at 3,500 or 3,600. Step up to the 4500 inverter class and you get 4,500 starting watts in a quiet, enclosed package. That is the difference between an RV air conditioner starting and a tripped breaker.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Weight Penalty</h3>

          <p>
            The other change is what you pay in weight. A 4500 watt enclosed inverter typically weighs 90 to 100 pounds, against about 50 pounds for a compact 3,600 watt inverter like the WEN DF360iX. Wheels and a handle become essential rather than optional, which is why we cover them below. If your loads never include an air conditioner, the extra weight buys you little.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">When This Size Makes Sense</h3>

          <p>
            The honest summary: buy this size when you need to start a compressor-driven load that is bigger than a refrigerator while other things keep running. For home backup that usually means a window air conditioner. For RVs it means the rooftop unit. Our <a href="/generator-wattage-chart/">generator wattage chart</a> has starting and running figures for most household loads if you want to check yours.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">The Class at a Glance</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">4,000-4,750W</p>
                <p class="text-gray-400 text-xs mt-1">Starting watts</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">3,300-3,800W</p>
                <p class="text-gray-400 text-xs mt-1">Running watts</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">78-100 lb</p>
                <p class="text-gray-400 text-xs mt-1">Typical weight</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">52-64 dBA</p>
                <p class="text-gray-400 text-xs mt-1">Listed inverter noise</p>
              </div>
            </div>
          </div>
        </div>

