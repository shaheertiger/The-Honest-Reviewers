    category: "Water-Based Semi-Transparent Stain & Sealant",
    badge: "Best Budget Pick",
    amazonUrl: "https://www.amazon.com/dp/B07BKFM4R6?tag=sktiger-20&linkCode=osi&th=1&psc=1",
