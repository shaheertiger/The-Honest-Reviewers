<Layout
  title={title}
  description={description}
  ogImage="https://placehold.co/1200x630/374151/white?text=Best+Fence+Stain+2026"
  ogType="article"
  article={{
    publishedTime: "2026-07-17",
    modifiedTime: "2026-07-17",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "fence stain",
      "wood stain",
      "pressure treated wood stain",
      "cedar fence stain",
      "solid stain",
      "semi-transparent stain",
      "exterior wood protection",
      "deck and fence stain",
      "fence sealer",
    ],
  }}
  jsonLd={schema}
