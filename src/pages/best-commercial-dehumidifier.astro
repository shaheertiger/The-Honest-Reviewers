---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifiers for the Home",
    "url": "/best-dehumidifier-for-home/"
  },
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Garage Dehumidifiers",
    "url": "/best-dehumidifier-for-garage/"
  },
  {
    "title": "Best Whole-House Dehumidifiers",
    "url": "/best-whole-house-dehumidifier/"
  },
  {
    "title": "Best Dehumidifiers With a Pump",
    "url": "/best-dehumidifier-with-pump/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-06", modified: "2026-11-06" });
const title = "7 Best Commercial Dehumidifiers in 2026: AHAM Pints, Amps and Pumps";
const description =
  "The best commercial dehumidifiers for warehouses, shops, job sites and big basements, from B-Air, Abestorm, BlueDri and Santa Fe, with AHAM and amp specs.";

const PRODUCTS = [
  {
    "id": "b-air-vg-2200",
    "name": "B-Air VG-2200 Vantage 225 Pint (130 PPD AHAM) LGR Commercial Dehumidifier",
    "category": "LGR, 130 PPD AHAM / 225 PPD Saturation, 400 CFM, 8.5 Amps",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "130 pints per day at AHAM and 225 at saturation, per listings",
      "LGR design with 400 CFM of listed airflow",
      "Lasko lists an operating range of 32°F to 115°F",
      "Internal condensate pump and ETL certification"
    ],
    "cons": [
      "About 100 pounds dry, per one retailer",
      "Single fan speed, and hose length is listed at 30 or 38 feet depending on seller"
    ],
    "bottomLine": "The commercial dehumidifier most buyers with a big space should start with: the most AHAM pints per dollar among the units with solid spec sources, an LGR coil and a wide temperature range.",
    "description": "B-Air is better known for its air movers, and like BlueDri it is part of Lasko's restoration family. The VG-2200 Vantage is its large LGR dehumidifier, and on paper it is the strongest all-round commercial unit in this guide. Listings rate it at 130 pints per day at AHAM conditions (80°F and 60% relative humidity) and 225 pints at saturation, and the 225 in the name is the saturation figure. Airflow is listed at 400 CFM and the current draw at 8.5 amps on 115 volts, so on a 15 amp circuit it wants little else sharing the line. Because it is an LGR design, it keeps removing water as a space dries rather than levelling off, which suits a warehouse being brought down from a wet spell as well as day-to-day humidity control. Lasko lists an operating range of 32°F to 115°F, the widest here. It has an internal condensate pump and ETL certification. Retailers list it at about 21 by 20 by 32.5 inches, with a dry weight of about 100 pounds on one listing and a 110 pound shipping weight on another, and hose length is listed at 30 or 38 feet depending on the seller. There is one fan speed. It was about $1,499 on Amazon at the time of writing."
  },
  {
    "id": "abestorm-hurricane-1250",
    "name": "Abestorm Hurricane 1250 270 Pint (125 PPD AHAM) Commercial Dehumidifier with Pump",
    "category": "125 PPD AHAM / 270 PPD Saturation, Built-In Pump, 3,000 sq ft",
    "badge": "Best for Warehouses",
    "amazonUrl": "#",
    "pros": [
      "125 pints per day at AHAM and 270 at saturation, per listings",
      "Built-in pump listed at 14.7 feet of lift with a 19.6-foot hose",
      "Marketed for up to 3,000 square feet",
      "About $1,045, the lowest price per AHAM pint in this guide"
    ],
    "cons": [
      "Listed at about 1,035 watts, roughly 9 amps by our arithmetic",
      "Spec sources disagree on weight and pump lift"
    ],
    "bottomLine": "The pick for a warehouse, barn or very large basement where one big machine is easier to manage than two smaller ones, provided you have a circuit with room for about 9 amps.",
    "description": "The Hurricane 1250 is Abestorm's largest portable commercial dehumidifier, and it is the unit to look at when the space is measured in thousands of square feet or the air is genuinely wet. Listings rate it at 125 pints per day at AHAM conditions and 270 pints at saturation, and market it for up to 3,000 square feet. Amazon lists it as the Abestorm 270 Pint Commercial Dehumidifier with Pump; Abestorm's model name for the 270 pint unit is the Hurricane 1250. The built-in pump is listed with 14.7 feet of lift and a 19.6-foot hose, although one third-party spec page gives 20 feet. Listings give about 1,035 watts, which is roughly 9 amps at 115 volts by our arithmetic, so on a 15 amp circuit little else should share it. A third-party spec page lists an operating range of 33.8°F to 105°F, a weight of about 85 pounds and a cabinet of roughly 23 by 39 by 22 inches on wheels. Abestorm's large units carry a 5-year limited warranty on the listings we found. At about $1,045 on Amazon at the time of writing, it delivers the most AHAM pints per dollar of any unit here, which is why it is our warehouse pick despite the thinner documentation."
  },
  {
    "id": "bluedri-bd-130p",
    "name": "BlueDri BD-130P 225 PPD Industrial Commercial Dehumidifier",
    "category": "225 PPD Saturation, 410 CFM, Automatic Pump, 38 ft Hose",
    "badge": "Most Airflow",
    "amazonUrl": "#",
    "pros": [
      "410 CFM listed airflow, the highest of the 120 volt portables here",
      "225 pints per day at saturation with an automatic pump",
      "Listings include a long 38-foot drain hose",
      "Listed at 7.5 amps, less than the Abestorm Hurricane 1250"
    ],
    "cons": [
      "Listings disagree on the AHAM figure (105 or 130 pints) and on weight",
      "Warranty is listed at 1 year on the unit, shorter than AlorAir or Abestorm"
    ],
    "bottomLine": "A big, high-airflow machine for open shops and job sites at a fair price, if you can live with a shorter warranty and some spec confusion.",
    "description": "BlueDri is one of Lasko's restoration and commercial brands, and the BD-130P is its largest conventional portable. The headline rating is 225 pints per day at saturation (90°F and 90% relative humidity). The AHAM figure is where the listings disagree: older Amazon listings say 105 pints per day at AHAM conditions, while BlueDri's own product page for the BD-130 series lists 130. Plan around the lower number until the manual in the box confirms otherwise. What is not in dispute is airflow, listed at 410 CFM, the most of any 120 volt unit in this guide, and an automatic pump feeding a drain hose listed at 38 feet. Listings give 7.5 amps at 115 volts and R-410A refrigerant. Weight is listed at 97 pounds on one listing and 107 on another, on large wheels with a pull handle. The warranty is the weak point: most listings describe 1 year on the unit, with one adding 5 years on the housing, against 5 years on the AlorAir and Abestorm units. It is a strong choice for an open workshop or a building under construction, where moving a lot of air matters more than a quiet cabinet. It was about $1,199 on Amazon at the time of writing."
  },
  {
    "id": "abestorm-hurricane-800",
    "name": "Abestorm Hurricane 800 170 Pint (80 PPD AHAM) Commercial Dehumidifier with Pump",
    "category": "80 PPD AHAM / 170 PPD Saturation, 19.6 ft Pump Lift",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "80 pints per day at AHAM and 170 at saturation for about $670",
      "Abestorm lists 19.6 feet of vertical pump lift, the most here",
      "Listed at about 607 watts and 63.9 pounds",
      "5-year limited warranty and ETL certification"
    ],
    "cons": [
      "Abestorm does not publish a minimum operating temperature for this model",
      "60 dBA listed, so not one for an occupied office"
    ],
    "bottomLine": "The commercial dehumidifier to buy on a budget: 80 AHAM pints, the strongest pump here and a 5-year warranty for under $700.",
    "description": "Abestorm sells a long line of commercial and crawl space dehumidifiers on Amazon, and the Hurricane 800 is the one that gives the most capacity per dollar. Abestorm rates it at 80 pints per day at AHAM conditions and 170 pints at saturation, and markets it for up to 2,100 square feet. Its strongest spec is the pump: Abestorm lists 19.6 feet of vertical lift, more than the 14.7 feet quoted for most of Abestorm's own range, including the Hurricane 1250, which helps when the water has to go up a stairwell or out a high window. Airflow is listed at 200 CFM, the refrigerant is R-32, and the Amazon listing gives about 607 watts, roughly 5.3 amps at 115 volts by our arithmetic. Weight is listed at 63.9 pounds and the noise rating at 60 dBA. Abestorm lists a 5-year limited warranty and ETL electrical certification. What the listing does not give is a lower operating temperature; other Abestorm models are rated down to the mid 30s, but we would not assume that for this one until the manual confirms it. Amazon lists it as an Abestorm 170 Pint Commercial Dehumidifier with Pump without the model name; the 170 pint, 2,100 square foot ratings match the Hurricane 800 on Abestorm's site. It was about $670 on Amazon at the time of writing."
  },
  {
    "id": "alorair-sentinel-hd90-crawl-space",
    "name": "AlorAir Sentinel HD90 90 PPD (AHAM) Basement and Crawl Space Dehumidifier",
    "category": "90 PPD AHAM / 198 PPD Saturation, ENERGY STAR, Low Profile",
    "badge": "Most Efficient",
    "amazonUrl": "#",
    "pros": [
      "90 pints per day at AHAM and 198 at saturation, per AlorAir",
      "ENERGY STAR certified with a listed efficiency of about 2.69 L/kWh",
      "Low, horizontal cabinet that fits under stairs, on shelving or in a crawl space",
      "Optional 6-inch outlet duct to push dry air to the far end of a room"
    ],
    "cons": [
      "No pump on the HD90 (the HDi90 adds one), so it needs a drain",
      "Not built to be dragged around a job site like the Storm units"
    ],
    "bottomLine": "The pick for a large basement, storage room or crawl space that needs commercial capacity running every day at the lowest power cost, where a drain is close by.",
    "description": "Not every big space needs a job-site machine. The Sentinel HD90 is AlorAir's large crawl space and basement unit, built to sit in one place and run for years, and it is the most efficient dehumidifier in this guide. AlorAir rates it at 90 pints per day at AHAM conditions and 198 at saturation, and markets it for up to 2,600 square feet. It is ENERGY STAR certified with a listed efficiency of about 2.69 liters per kWh, and AlorAir also publishes a capacity of roughly 48 pints per day at 60°F and 60%, a useful reality check for a cool basement. Listings give 210 CFM of airflow and about 5.56 amps at 115 volts. The horizontal cabinet is roughly 23 by 15 by 18 inches and about 70 pounds, and AlorAir sells a 6-inch outlet duct accessory, so you can tuck the unit in a corner and blow dry air toward the far end of the room. The HD90 drains by gravity through a hose; if you need a pump, the HDi90 version adds one. It is rated to run down to 33.8°F with auto defrost and carries a 5-year warranty. It was about $838 on Amazon at the time of writing."
  },
  {
    "id": "santa-fe-advance-dry110",
    "name": "Santa Fe Advance Dry110 110 Pint Ducted Dehumidifier (4047010)",
    "category": "110 Pints/Day at 80°F/60%, 370 CFM, 4.1 Amps, Dual Outlets",
    "badge": "Best Ducted",
    "amazonUrl": "#",
    "pros": [
      "Santa Fe rates it at about 110 pints per day at 80°F and 60%, and about 70 at 65°F",
      "Dual exhaust outlets and an optional supply duct kit for divided spaces",
      "Spec sheet lists 370 CFM and only 4.1 amps at 65°F and 60%",
      "Internal condensate pump plus a 3/4-inch gravity drain"
    ],
    "cons": [
      "About $2,475, roughly double the big portables",
      "Built to sit in place and be ducted, not to move around a job site"
    ],
    "bottomLine": "The machine to buy when one dehumidifier must serve several rooms of a large basement, storage area or crawl space through ducts, at a low running amp draw.",
    "description": "The Advance Dry110 is a Santa Fe horizontal dehumidifier from Therma-Stor, and it is the only unit in this guide designed from the start to be ducted. Santa Fe's spec sheet rates it at about 110 pints per day at 80°F and 60% relative humidity, the same conditions as the AHAM figures quoted for the other units here, and about 70 pints at 65°F and 60%, which is the household DOE test point. The spec sheet lists a blower of 370 CFM and a current draw of only 4.1 amps at 65°F and 60%, the lowest in this guide. The point of the Dry110 is air distribution: it has dual exhaust outlets, and Santa Fe's optional supply duct kit lets one machine feed dry air to two separate areas of a divided basement, a storage room or a large crawl space. The owner's manual is specific that supply and return air should be ducted directly to the space. Drainage is flexible: the spec sheet lists an internal condensate pump as well as a 3/4-inch threaded drain with an 8-foot gravity hose included. Retailers market it for homes and basements of about 2,900 to 3,600 square feet. It was about $2,475 on Amazon at the time of writing, with stock listed as limited."
  },
  {
    "id": "dri-eaz-drizair-1400",
    "name": "Dri-Eaz DrizAir 1400 Commercial Dehumidifier with Pump (127890)",
    "category": "64 PPD AHAM / 129 PPD Saturation, 4.7 Amps, 40 ft Hose",
    "badge": "Lowest Amp Draw",
    "amazonUrl": "#",
    "pros": [
      "Dri-Eaz lists only 4.7 amps, so two can share one 15 amp circuit",
      "Internal condensate pump with a 40-foot drain hose",
      "About 65 to 66 pounds and 19.5 by 16 by 20 inches",
      "Bluetooth and Wi-Fi control through Dri-Eaz's app"
    ],
    "cons": [
      "64 AHAM pints for about $2,249 is poor capacity per dollar",
      "Conventional refrigerant, not LGR"
    ],
    "bottomLine": "Worth it only when circuit capacity is the constraint, such as a job site or old building where you need two or three units on limited power; otherwise the Abestorm and B-Air units give far more water removal per dollar.",
    "description": "Dri-Eaz is a restoration industry standard, and the DrizAir 1400 is its conventional-refrigerant commercial dehumidifier, aimed at contractors and facilities that want Dri-Eaz build quality without LGR pricing. Retailers list it at 64 pints per day at AHAM conditions and about 129 pints at saturation. Its standout figure is power: Dri-Eaz's product page says it draws only 4.7 amps, so two units can run on one 15 amp circuit within the continuous-load limit, which none of the bigger machines here can do. It has an internal condensate pump and a 40-foot drain hose, and Dri-Eaz describes Bluetooth and Wi-Fi connectivity for remote control through its app. Airflow is listed at 215 to 220 CFM depending on the retailer, and the cabinet is about 19.5 by 16 by 20 inches and 65 to 66 pounds, small enough to move between rooms easily. The problem is value. At about $2,249 on Amazon at the time of writing, with stock listed as limited, it costs more than the 125 AHAM pint Abestorm Hurricane 1250 for roughly half the capacity. Buy it when you are short of circuits, not short of money."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Commercial Dehumidifier",
          item: "https://www.thehonestreviewers.com/best-commercial-dehumidifier/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the difference between a commercial and a residential dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A commercial dehumidifier is built for continuous duty in larger spaces. It typically has a heavier compressor, a rugged rotomolded or steel cabinet, wheels and a handle, a built-in pump or large drain, and much higher airflow. Residential units are rated under the 2019 DOE test at 65°F, while commercial units quote AHAM ratings at 80°F, so the numbers are not directly comparable."
          }
        },
        {
          "@type": "Question",
          "name": "How many pints per day do I need for a warehouse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on volume and moisture load rather than floor area. As a rough starting point, one 85 AHAM pint unit can hold a closed, dry storage space of 15,000 to 20,000 cubic feet at 50%, while a damp space or one with frequent door openings may need one per 8,000 to 10,000. Large buildings deserve a professional load calculation."
          }
        },
        {
          "@type": "Question",
          "name": "Can a commercial dehumidifier run on a regular outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every unit in this guide runs on a standard 120 volt outlet. Listed draw ranges from 4.1 amps for the Santa Fe Advance Dry110 to roughly 9 amps for the Abestorm Hurricane 1250. On a 15 amp circuit, keep continuous loads under 12 amps total, so the larger units are best on their own circuit."
          }
        },
        {
          "@type": "Question",
          "name": "What does AHAM mean on a dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AHAM refers to the test conditions used by the Association of Home Appliance Manufacturers: 80°F and 60% relative humidity. Commercial dehumidifiers quote an AHAM capacity alongside a larger saturation figure taken at 90°F and 90%. The AHAM number is the fairer basis for comparing two commercial units, and it is usually about half the saturation rating."
          }
        },
        {
          "@type": "Question",
          "name": "Do commercial dehumidifiers need a drain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They need somewhere for the water to go, because they can collect 8 to 10 gallons a day. Gravity units such as the Sentinel HD90 need a floor drain, sump or sink below the outlet. Pump units such as the Abestorm Hurricane 800 and 1250, B-Air VG-2200 and Dri-Eaz DrizAir 1400 can push water up to a sink or window, with lifts listed at about 15 to 20 feet."
          }
        },
        {
          "@type": "Question",
          "name": "Can I duct a commercial dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some, yes. The Santa Fe Advance Dry110 is designed for ducting, with dual outlets and a supply duct kit that splits dry air to two areas, and the AlorAir Sentinel HD90 accepts a 6-inch outlet duct. Job-site units such as the Abestorm Hurricanes and the BlueDri and B-Air machines are built to be moved around rather than ducted, so place them centrally instead."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a commercial dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Using listed wattage and 17 cents per kWh, a 607 watt Hurricane 800 running 20 hours a day costs about $2.06 a day, and a 1,035 watt Hurricane 1250 about $3.50. Real costs are lower when the humidistat cycles the compressor off. ENERGY STAR units such as the Sentinel HD90 remove more water per kWh."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "commercial dehumidifier",
      "commercial dehumidifiers",
      "industrial dehumidifier",
      "heavy duty dehumidifier",
      "large dehumidifier",
      "best commercial dehumidifier",
      "warehouse dehumidifier",
      "alorair commercial dehumidifier"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Commercial Dehumidifiers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Big-capacity dehumidifiers for warehouses, shops, job sites and large basements, compared on the numbers that matter for continuous duty: AHAM pints, amp draw, pump lift and ducting.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#b-air-vg-2200"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#aham-vs-saturation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. AHAM vs Saturation Pints</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 7 Best, Ranked</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Sizing a Large Space</a>
          <a href="#amp-draw" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. 120V Amp Draw and Circuits</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Pump or Gravity Drainage</a>
          <a href="#ducting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Ducting and Air Distribution</a>
          <a href="#continuous-duty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Continuous Duty</a>
          <a href="#cold-spaces" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Cold Warehouses and Shops</a>
          <a href="#lgr" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. LGR vs Conventional</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
