---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Can You Run a Generator in the Rain?", url: "/can-you-run-a-generator-in-the-rain/" },
    { title: "How to Store a Portable Generator", url: "/how-to-store-a-portable-generator/" },
    { title: "Best Portable Generators", url: "/best-portable-generator/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-10", modified: "2026-09-10" });
const title = "Where to Place a Generator Outside (Safe Distance Guide)";
const description =
  "Six metres from the house, exhaust pointed away, never in a garage or under an overhang. The placement rules that prevent carbon monoxide poisoning, and why they exist.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Where to Place a Generator Outside", item: "https://www.thehonestreviewers.com/where-to-place-a-generator-outside/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How far should a generator be from the house?",
          acceptedAnswer: { "@type": "Answer", text: "At least six metres, roughly twenty feet, from any part of the building, with the exhaust pointed away from it. That distance is the widely published safety guidance from consumer product safety regulators, and it exists because carbon monoxide from a portable generator can reach lethal indoor concentrations far faster than most people expect. Distance alone is not enough — doors, windows and vents matter as much as metres." },
        },
        {
          "@type": "Question",
          name: "Can you run a generator in a garage with the door open?",
          acceptedAnswer: { "@type": "Answer", text: "No. This is the single most dangerous placement mistake and it kills people every storm season. An open garage door does not provide anything close to adequate ventilation, exhaust accumulates against the ceiling and works its way into the house through the connecting door and shared framing, and carbon monoxide is odourless. A garage is an enclosed space regardless of what the door is doing." },
        },
        {
          "@type": "Question",
          name: "Can you run a generator under a covered porch or deck?",
          acceptedAnswer: { "@type": "Answer", text: "No. A porch, carport, deck or open shed traps exhaust under the roof and beside the wall, and being adjacent to the house means that trapped gas finds its way indoors. If you need weather protection, use a purpose-built generator tent or an open-sided canopy positioned well away from the building, never a structure attached to it." },
        },
        {
          "@type": "Question",
          name: "Which way should a generator exhaust face?",
          acceptedAnswer: { "@type": "Answer", text: "Away from the house and away from any neighbouring building, and ideally downwind. Check where the exhaust actually exits your machine, because some portables vent from the side or the rear rather than an obvious tailpipe. Then check the wind — a generator placed correctly at six metres with the wind blowing exhaust straight at an open bedroom window has been placed badly." },
        },
        {
          "@type": "Question",
          name: "How close can a generator be to a window or vent?",
          acceptedAnswer: { "@type": "Answer", text: "As far as possible, and never in the direct line of one. Windows, doors, dryer vents, soffit vents, crawlspace vents, and HVAC fresh-air intakes are all pathways indoors, and an intake will actively draw exhaust into the house. When choosing a spot, walk the wall and identify every opening before you decide, not after." },
        },
        {
          "@type": "Question",
          name: "Do you need a carbon monoxide detector when running a generator?",
          acceptedAnswer: { "@type": "Answer", text: "Yes. Battery-powered or battery-backed CO alarms on every sleeping level are essential, because a mains-powered detector is useless in exactly the situation where a generator is running. Test them before storm season and keep spare batteries. Many newer portable generators also have a built-in CO shutoff sensor, which is a genuine safety improvement but is a backstop, not a substitute for correct placement." },
        },
        {
          "@type": "Question",
          name: "Can a generator sit on grass or dirt?",
          acceptedAnswer: { "@type": "Answer", text: "It can, but a firm level surface is better. Soft ground lets the machine settle and tilt, which affects oil pickup and can trigger a low-oil shutdown, and wet grass under a running engine is not an ideal combination. A couple of paving slabs, a sheet of exterior plywood on blocks, or a purpose-made mat gives a stable, level base that keeps the frame out of standing water." },
        },
        {
          "@type": "Question",
          name: "How far should a generator be from a neighbour's house?",
          acceptedAnswer: { "@type": "Answer", text: "Apply the same six-metre rule to their walls, windows and vents as to your own. On a tight suburban lot this is the constraint that decides placement, because the spot that is furthest from your own house may be almost against theirs. Carbon monoxide does not respect a property line, and the person asleep on the other side of that wall has no idea your generator is running." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Emergency Preparedness",
    tags: ["generator placement", "carbon monoxide", "generator safety", "power outage"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Portable Generators", link: "/best-portable-generator/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Safety</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">Where to Place a <span class="text-[#38BDF8]">Generator Outside</span></h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Six metres from the building, exhaust pointed away, never in a garage or under anything attached to the house. Decide this before the storm, not in the dark with a torch.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#rules" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">See the Rules</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="12.1k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#rules" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Placement Rules</a>
          <a href="#why" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Why Six Metres</a>
          <a href="#never" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Places That Are Never Safe</a>
          <a href="#openings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Windows, Vents and Intakes</a>
          <a href="#wind" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Wind, Weather and Rain</a>
          <a href="#surface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Surface, Levelling and Security</a>
          <a href="#small-lots" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Small Lots and Neighbours</a>
          <a href="#detectors" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. CO Detectors and Sensors</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A portable generator produces carbon monoxide at a rate that has no household equivalent. It is colourless, odourless, and it accumulates. Almost every generator fatality is a placement decision, made quickly, in bad weather, by someone who was trying to be sensible.
        </p>

        <div id="rules" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. The Placement Rules</h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rule</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">The Standard</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Distance from the building</td>
                    <td class="px-4 py-4 text-gray-700">At least 6 m (about 20 ft), all sides</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Exhaust direction</td>
                    <td class="px-4 py-4 text-gray-700">Pointed away from every building</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Enclosure</td>
                    <td class="px-4 py-4 text-gray-700">Fully outdoors, open on all sides</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Openings nearby</td>
                    <td class="px-4 py-4 text-gray-700">Not in line with windows, doors, vents or intakes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Neighbouring buildings</td>
                    <td class="px-4 py-4 text-gray-700">Same 6 m rule applies to their walls</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Surface</td>
                    <td class="px-4 py-4 text-gray-700">Firm, level, out of standing water</td>
                  </tr>
                  <tr class="bg-white">
                    <td class="px-4 py-4 font-black text-gray-900">Detection indoors</td>
                    <td class="px-4 py-4 text-gray-700">Battery CO alarms on every sleeping level</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-red-50 border border-red-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-red-800 mb-2">This Is the Rule That Matters</p>
            <p class="text-sm text-red-700">
              Never run a generator inside a house, garage, basement, crawlspace, shed, carport, or under a deck or porch — including with doors and windows open. Carbon monoxide from a portable generator can build to a dangerous concentration in minutes in a space that feels well ventilated, and by the time symptoms are recognisable, judgement is already impaired.
            </p>
          </div>

          <p>
            Work out your spot now, on a dry afternoon, and mark it. The whole reason bad placement happens is that the decision usually gets made at night, in wind and rain, by someone tired and in a hurry, with a heavy machine and a short cord. Removing that decision from the moment of the outage is the most valuable thing in this guide.
          </p>
        </div>

        <div id="why" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Why Six Metres</h2>

          <p>
            Carbon monoxide binds to haemoglobin several hundred times more readily than oxygen does, so it does not need to displace the air in a room to be lethal — it only needs to reach a modest concentration in the air you are breathing. A running portable generator emits it continuously and in quantity, which is why the guidance is a distance rather than a ventilation instruction.
          </p>

          <p>
            Six metres, roughly twenty feet, is the figure published by consumer product safety regulators and printed on the machines themselves. It is a practical minimum that gives the exhaust plume room to disperse before it reaches the building envelope, not a precise threshold below which harm begins.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Part People Miss</p>
            <p class="text-xl font-bold text-white mb-3">Carbon monoxide poisoning starts with symptoms that are indistinguishable from being tired and stressed during a storm.</p>
            <p class="text-gray-300 leading-relaxed m-0">Headache, dizziness, nausea, weakness and confusion are exactly what a long night without power feels like. That overlap is what makes it so dangerous: people attribute the early warning to the situation and go to bed. If anyone in the house feels unwell while a generator is running, get everyone outside into fresh air first and diagnose afterwards.</p>
          </div>

          <p>
            Treat six metres as the floor, not the target. If your lot allows ten, use ten. The cost is a longer extension cord, which is a solvable problem — just size it correctly for the run, because a long undersized cord causes voltage drop that damages motors and heats the cable.
          </p>
        </div>

        <div id="never" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Places That Are Never Safe</h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Garage, Door Open or Not</h3>
          <p>
            This is the placement that appears in incident reports year after year. An open garage door reads as ventilation and is not. Exhaust rises and pools against the ceiling, the connecting door to the house is rarely airtight, and shared framing cavities carry gas into the building. A garage attached to a house is functionally part of the house.
          </p>
          <p>
            The same applies to a detached garage or workshop with the door open, with the added risk that nobody is monitoring a building they are not living in. If the machine is under a roof with walls, it is in the wrong place.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Porches, Carports and Under Decks</h3>
          <p>
            A roof overhead traps exhaust and holds it against the structure beneath. Under a raised deck is worse still, because the joist bays create pockets that hold gas directly beneath the doors and windows people will open in the morning. A carport, being attached and roofed, is the same problem with better airflow and false reassurance.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Basements, Crawlspaces and Sheds</h3>
          <p>
            Below-grade spaces are the worst possible location: no meaningful air exchange, and the gas has nowhere to go but into the living space above. A garden shed is an enclosed space with a door, and a generator in one is an enclosed generator with the heat and fire risk of a fuel-fed engine in a wooden box.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Right Against an Exterior Wall</h3>
          <p>
            Outdoors but tight to the siding still fails, because the wall traps the plume and pushes it upward along the building, where it meets soffit vents, upstairs windows and the gable end. Outdoors is a necessary condition, not a sufficient one — the distance and the direction are what make it safe.
          </p>
        </div>

        <div id="openings" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Windows, Vents and Intakes</h2>

          <p>
            Before choosing a spot, walk the wall you are considering and count every opening: windows, doors, dryer vents, bathroom fan outlets, crawlspace vents, soffit vents, combustion air intakes for a furnace or water heater, and any HVAC fresh-air intake.
          </p>

          <p>
            The intakes deserve particular attention because they are active. A fresh-air intake or an air handler pulling makeup air will draw exhaust into the house against the wind, and it will distribute it evenly through every room the ducts reach. Six metres away means little if the machine is sitting in front of an intake.
          </p>

          <p>
            Bedroom windows are the priority, because that is where the risk of not noticing symptoms is highest. If the geometry of your lot forces a compromise, compromise away from where people sleep.
          </p>

          <p>
            One more path people forget: an open window on the floor above. Exhaust rises. A generator at ground level six metres out, on a still night, can still reach a second-floor window left open for air. During an outage, keep windows on the generator side of the house closed.
          </p>
        </div>

        <div id="wind" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Wind, Weather and Rain</h2>

          <p>
            Wind direction turns a good placement into a bad one. A generator six metres from the house with a steady breeze carrying its exhaust straight at the building is effectively much closer. Check the wind when you set up, and be willing to move the machine if it shifts — which during a storm it will.
          </p>

          <p>
            Weather protection is where people get into trouble, because the instinct to keep a generator dry is what puts it under a porch or in a garage. The correct answer is a purpose-built generator tent or open-sided canopy, positioned away from the house, that shelters the machine from falling rain while leaving all four sides open.
          </p>

          <p>
            Never cover a running generator with a tarp. It traps heat around a hot exhaust, restricts the cooling airflow the engine depends on, and creates a fire risk on top of everything else. We cover wet-weather operation in detail in <a href="/can-you-run-a-generator-in-the-rain/">can you run a generator in the rain</a>.
          </p>

          <p>
            In snow, think about drifting as well as accumulation. A machine placed in the lee of a fence can be buried by morning, and clearing a running generator out of a drift is neither safe nor pleasant. Choose an exposed spot with a windbreak well away from it, not immediately behind it.
          </p>
        </div>

        <div id="surface" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Surface, Levelling and Security</h2>

          <p>
            Set the machine on something firm and level. Small engines rely on the oil pickup sitting in oil, and a machine tilted on soft ground can starve it or trigger a low-oil shutdown at three in the morning. Two paving slabs, a sheet of exterior plywood on blocks, or a rubber generator mat all work.
          </p>

          <p>
            Get it out of standing water. Water pooling around the frame during a storm is an electrical hazard, and a machine sitting in a puddle for two days will corrode at the frame and the receptacle panel.
          </p>

          <p>
            Consider theft. Generators are stolen during outages with depressing regularity, precisely because they are outdoors, running, and audible from the street. A security cable through the frame to something immovable is a reasonable precaution — just route it so it cannot foul the exhaust or the cooling air.
          </p>

          <p>
            Finally, think about noise for both you and your neighbours. A generator running for three days at four in the morning is a genuine test of goodwill, and placing it behind a solid fence line or an outbuilding — not against the house — takes the edge off. Inverter machines are dramatically quieter if noise is a recurring problem; our <a href="/best-inverter-generator/">inverter generator testing</a> covers the real-world difference.
          </p>
        </div>

        <div id="small-lots" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. Small Lots and Neighbours</h2>

          <p>
            On a narrow suburban lot the six-metre rule can be impossible to satisfy in every direction at once, and this is where honest planning matters. The spot furthest from your own walls may be almost against your neighbour's, and their bedroom window is exactly as vulnerable as yours.
          </p>

          <p>
            Work the problem in this order: find the position that maximises distance from all buildings including theirs, point the exhaust into open space such as a street, driveway or the widest part of the yard, and keep it clear of both properties' vents and intakes. Front driveways often work better than back gardens on tight lots, for exactly this reason.
          </p>

          <p>
            Tell your neighbours you will be running it. They can close windows on that side, and they will know to check on you if something seems wrong. It also prevents the conversation about noise turning into a grievance.
          </p>

          <p>
            If your lot genuinely cannot accommodate safe portable placement, that is a real argument for a permanently installed standby unit, which is sited to code with a proper exhaust arrangement and does not require a decision in the dark. Our comparison of <a href="/portable-vs-standby-generator/">portable versus standby generators</a> covers the trade-off, and a <a href="/portable-power-station-vs-generator/">battery power station</a> produces no exhaust at all, which sidesteps the problem entirely for lighter loads.
          </p>
        </div>

        <div id="detectors" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">8. CO Detectors and Built-In Sensors</h2>

          <p>
            Battery-powered or battery-backed carbon monoxide alarms on every sleeping level are not optional when a generator is in use. A detector that plugs into the wall is dead during exactly the event that creates the hazard, which is an irony that has killed people.
          </p>

          <p>
            Test them at the start of storm season, not during a storm, and replace the batteries. CO detectors also have a service life — typically seven to ten years — after which the sensing element degrades and the unit should be replaced regardless of whether it still chirps.
          </p>

          <p>
            Many portable generators sold in recent years include a built-in CO shutoff sensor that stops the engine when it detects a dangerous accumulation around the machine. It is a genuine and worthwhile safety feature, and if you are buying a generator it is worth prioritising. It is not, however, a licence to place a machine badly: it protects against a build-up at the generator, not against a plume travelling into a window twenty feet away.
          </p>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-amber-800 mb-2">If an Alarm Sounds</p>
            <p class="text-sm text-amber-700">
              Get everyone out of the building into fresh air immediately, then call emergency services. Do not open windows and wait to see whether it stops, and do not go back in to shut the generator down first. Carbon monoxide impairs judgement before it causes collapse, which is why the instruction is to leave first and think outside.
            </p>
          </div>
        </div>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Common Mistakes to Avoid</h2>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Running It in the Garage With the Door Open</h3>
              <p class="text-gray-700 text-sm m-0">The most common fatal mistake. An open door is not ventilation, exhaust pools at the ceiling, and an attached garage shares air paths with the house. A garage is an enclosed space regardless of the door.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Tucking It Under a Porch to Keep It Dry</h3>
              <p class="text-gray-700 text-sm m-0">A roof traps exhaust against the wall beneath it. Use an open-sided generator tent placed well away from the house instead, and never a tarp over a running machine.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Measuring Distance but Ignoring Direction</h3>
              <p class="text-gray-700 text-sm m-0">Six metres with the exhaust and the wind pointed at an open window is not six metres of safety. Check where the exhaust exits your machine and which way the wind is blowing, and re-check as the storm shifts.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting the HVAC Intake</h3>
              <p class="text-gray-700 text-sm m-0">A fresh-air intake actively pulls exhaust into the house and distributes it through the ducts. Walk the wall and identify every opening before choosing a spot, not after.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Placing It Against the Neighbour's Wall</h3>
              <p class="text-gray-700 text-sm m-0">The six-metre rule applies to their building too, and they have no idea the machine is running. On tight lots, work the geometry for both houses and tell them you will be running it.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Relying on Mains-Powered CO Detectors</h3>
              <p class="text-gray-700 text-sm m-0">A plug-in detector is dead during the outage that made you start the generator. Use battery or battery-backed alarms on every sleeping level and test them before storm season.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">10. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How far from the house?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">At least six metres, about twenty feet, from any part of the building, with the exhaust pointed away. That is the published safety guidance, and further is better. Distance alone is not enough — doors, windows and vents matter as much.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Garage with the door open?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">No. An open door is nowhere near adequate ventilation, exhaust accumulates against the ceiling, and an attached garage shares air paths with the house. This is the placement that appears in fatality reports every storm season.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Under a porch or deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">No. A roof traps exhaust against the structure and the house beneath it, and joist bays under a deck hold gas right below the doors above. Use an open-sided generator tent positioned away from the building instead.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Which way should the exhaust face?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Away from every building and ideally downwind. Check where the exhaust actually exits your machine — some vent from the side or rear — and re-check the wind as the weather shifts during a storm.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How close to a window or vent?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">As far as possible, never in line with one. Windows, doors, dryer and crawlspace vents and HVAC intakes are all paths indoors, and an intake will actively draw exhaust in. Prioritise distance from bedrooms.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do you need a CO detector?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes — battery or battery-backed alarms on every sleeping level, since mains detectors are dead during an outage. Test them before storm season. A generator's built-in CO shutoff is a useful backstop, not a substitute for placement.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can it sit on grass?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">It can, but firm and level is better. Soft ground lets the machine tilt, which affects oil pickup and can trigger a low-oil shutdown. Paving slabs, plywood on blocks or a generator mat keep it stable and out of standing water.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How far from a neighbour's house?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">The same six metres, applied to their walls, windows and vents. On a tight lot this usually decides the placement. Carbon monoxide ignores property lines, and the person asleep next door does not know your generator is running.</p>
            </div>
          </div>
        </div>

