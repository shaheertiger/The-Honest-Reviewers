  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-03-15",
    modifiedTime: "2026-03-15",
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "best hookaroon reviews",
      "home improvement",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See #1 Pick",
    link: "#top-pick",
  }}
>
  <article class="relative overflow-hidden">
