---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Milwaukee vs DeWalt",
    "url": "/milwaukee-vs-dewalt/"
  },
  {
    "title": "DeWalt vs Makita",
    "url": "/dewalt-vs-makita/"
  },
  {
    "title": "Drill vs Impact Driver",
    "url": "/drill-vs-impact-driver/"
  },
  {
    "title": "Brushless vs Brushed Drill",
    "url": "/brushless-vs-brushed-drill/"
  },
  {
    "title": "Cordless Tool Batteries Explained",
    "url": "/cordless-tool-batteries-explained/"
  },
  {
    "title": "Best Cordless Tool Brand",
    "url": "/best-cordless-tool-brand/"
  },
  {
    "title": "Ryobi ONE+ HP vs Standard",
    "url": "/ryobi-one-plus-hp-vs-standard/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Impact Drivers for Decks, Lags and Everyday Driving";
const description =
  "Seven impact drivers compared on real driving, not specs: why brand torque figures don't compare, when speed modes matter, and which to buy for your batteries.";

const PRODUCTS = [
  {
    "id": "milwaukee-2953-20-impact-driver",
    "name": "Milwaukee M18 FUEL 1/4-Inch Hex Impact Driver (2953-20)",
    "category": "18V Brushless, 4-Mode Drive Control",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 2200,
    "pros": [
      "Milwaukee rates it at 2,000 in-lbs, 3,900 RPM and 4,400 IPM, the fastest no-load speed among the conventional drivers here",
      "4-Mode Drive Control includes a self-tapping screw mode that slows as the screw breaks through steel",
      "Sank half-inch lags noticeably quicker than most of the field in our testing",
      "Around 2.2 lb bare and about 4-1/2 inches long, compact for a full-power 18V driver",
      "Runs on the whole M18 battery line, one of the largest professional platforms"
    ],
    "cons": [
      "Priced at the premium end of the category, even as a bare tool",
      "Changing modes takes a deliberate press at the base, slower mid-job than Makita's quick-shift button"
    ],
    "bottomLine": "The best all-round impact driver we tested, and the one to buy if you are on M18 or choosing a professional platform from scratch.",
    "description": "Milwaukee's M18 FUEL driver earns the top spot because it does the heavy jobs faster than most of the field without being clumsy at the light ones. Milwaukee rates it at 2,000 in-lbs of torque, 3,900 RPM and 4,400 impacts per minute, and in our driving it sank half-inch lags into a 4x4 post noticeably quicker than most of the other drivers here. Those figures are Milwaukee's own, and as we explain below they do not compare directly with other brands' claims, but the speed under load was obvious on the bench. What keeps it from being a blunt instrument is the 4-Mode Drive Control. The first mode is slow enough for cabinet hardware, and the dedicated self-tapping screw mode slows down automatically as a screw punches through steel, which prevents the stripped holes and snapped screws that plague metal-stud work. The body is compact for a full-power driver at about 4-1/2 inches long and around 2.2 pounds bare, and it balances well on a 2.0Ah or 3.0Ah pack. The honest caveat is price: this is a premium tool, and if you already own DeWalt, Makita or Ryobi batteries, their own drivers get close enough that switching platforms for it makes no sense."
  },
  {
    "id": "dewalt-dcf850-atomic-impact-driver",
    "name": "DeWalt ATOMIC 20V MAX Brushless 1/4-Inch Impact Driver (DCF850B)",
    "category": "20V MAX Compact Brushless, 3-Speed",
    "badge": "Best for DeWalt Owners",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1600,
    "pros": [
      "Under 4 inches long, the shortest 18V/20V-class driver on this list",
      "DeWalt rates it at 1,825 in-lbs, 3,250 RPM and 3,800 IPM from a tool weighing about 2.1 lb bare",
      "Three speed settings cover everything from cabinet screws to lags",
      "Runs on every DeWalt 20V MAX battery, including FlexVolt packs",
      "Handled our full test set, including pilot-drilled half-inch lags"
    ],
    "cons": [
      "No specialised self-tapping or assist mode, only three plain speeds",
      "A little slower on long lags than the Milwaukee M18 FUEL"
    ],
    "bottomLine": "The best DeWalt driver for most people: near full-size power in a body short enough for work between joists.",
    "description": "DeWalt sells two very similar brushless drivers, the DCF887 and the Atomic DCF850, and for most buyers the Atomic is the better pick. Both are rated by DeWalt at 1,825 in-lbs, 3,250 RPM and 3,800 impacts per minute, with three speed settings, but the DCF850 packs that into a head under 4 inches long and around 2.1 pounds bare. In practice that shorter body is what you notice. It fits between joists and inside base cabinets where longer drivers have to go in at an angle, and it balances nicely on a compact 2.0Ah pack. In our testing it drove 3-inch construction screws at a pace we could not tell apart from the Milwaukee, and it handled half-inch lags with pilot holes, a little more slowly. The three speeds are straightforward: low for small screws, medium for general driving, high for long fasteners. What it lacks compared with Milwaukee and Makita is a specialised mode for self-tapping screws or a soft-start assist, so metal work takes a lighter finger on the trigger. The DCF887 adds DeWalt's Precision Drive mode for small fasteners and is worth considering if you do a lot of cabinetry, but the Atomic is the one we would carry. It runs on all DeWalt 20V MAX packs, including FlexVolt."
  },
  {
    "id": "makita-xdt16-impact-driver",
    "name": "Makita 18V LXT Brushless Quick-Shift Mode 4-Speed Impact Driver (XDT16Z)",
    "category": "18V LXT Brushless, 4-Speed with T-Mode",
    "badge": "Best Control",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 1400,
    "pros": [
      "Four speed settings from 0-1,100 up to 0-3,600 RPM give the finest control of any driver here",
      "T-mode drops speed the moment impacting starts, preventing stripped threads on self-tapping screws",
      "Quick-shift button near the trigger changes speed without looking",
      "Compact 4-9/16-inch head length",
      "Runs on Makita's large 18V LXT battery line"
    ],
    "cons": [
      "Rated at 1,600 in-lbs, lower than rivals, and slower on long lags in our testing",
      "Speed button is easy to bump by accident until you are used to it"
    ],
    "bottomLine": "The driver for people who drive more small screws than lags: precise, compact and very hard to over-drive with.",
    "description": "The Makita XDT16 is not the most powerful driver on this list and does not try to be. Makita rates it at 1,600 in-lbs, with four speeds running from 0-1,100 up to 0-3,600 RPM and up to 3,800 impacts per minute. What it offers instead is control. The four speed settings cover a wider range than most rivals, and the lowest is gentle enough to set cabinet screws and hinge screws without driving them through. The standout is T-mode, which automatically drops speed the moment the impact mechanism engages. On self-tapping screws into steel stud it prevented the stripped holes we got with other drivers set too high, and it was nearly as useful for driving screws flush into softwood. The quick-shift button sits near the trigger, so you can change speeds with a thumb without looking; it is fast once you know it and easy to bump before you do. On half-inch lags it was among the slower drivers here, and if heavy fastening is most of your work the Milwaukee or DeWalt suits better. Makita has since added the XDT19, which keeps the four speeds and adds an assist mode and reverse auto-stop, but the XDT16 remains widely available and is often the cheaper of the two."
  },
  {
    "id": "milwaukee-3453-20-m12-impact-driver",
    "name": "Milwaukee M12 FUEL 1/4-Inch Hex Impact Driver (3453-20)",
    "category": "12V Compact Brushless, 4-Mode",
    "badge": "Best 12V Compact",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1900,
    "pros": [
      "About 2 lb with a 2.0Ah battery, far lighter in the hand than any 18V driver once a pack is fitted",
      "Rated at 1,500 in-lbs and 3,600 RPM, enough for everything in our test except fast lag driving",
      "4-Mode Drive Control with a dedicated self-tapping screw mode",
      "Tri-LED ring lights the fastener rather than casting a shadow",
      "Part of the M12 line, one of the deepest 12V platforms available"
    ],
    "cons": [
      "Slow on half-inch lags, and small packs run down quickly on heavy work",
      "Means a second battery platform if you already own M18"
    ],
    "bottomLine": "The best impact driver for cabinet installers, electricians and homeowners who value light weight over peak power.",
    "description": "The M12 FUEL is the driver we would hand to most homeowners who do not build decks, and it is the one many tradespeople carry in a pouch alongside a bigger 18V kit. Milwaukee rates it at 1,500 in-lbs and 3,600 RPM, and it weighs about 2 pounds with a 2.0Ah battery, which is noticeably lighter than any 18V driver once a pack is fitted. That weight difference is the point. Overhead, inside cabinets and on ladders, the M12 is simply easier to hold and control for long periods. In our testing it drove 3-inch screws into framing with no trouble and managed half-inch lags with pilot holes, though slowly, and it ran down a 2.0Ah pack faster than the 18V drivers did on the heavy jobs. It gets the same 4-Mode Drive Control as its M18 sibling, including the self-tapping screw mode, and the tri-LED ring around the collet puts the light on the screw. The caveat is the platform. If you already own M18, adding M12 means a second set of batteries and chargers, which is worthwhile for professionals and harder to justify for occasional users. If you are starting fresh and your work is mostly assembly and repair, 12V is a sensible place to begin."
  },
  {
    "id": "ryobi-pblid02-impact-driver",
    "name": "Ryobi ONE+ HP 18V Brushless 4-Mode 1/4-Inch Impact Driver (PBLID02B)",
    "category": "18V ONE+ HP Brushless, 4-Mode",
    "badge": "Best Value",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 900,
    "pros": [
      "Brushless HP motor with a claimed 2,200 in-lbs and up to 4,000 IPM",
      "Three speeds plus an Assist mode that starts slowly until the screw bites",
      "Runs on the huge ONE+ battery line that also powers yard and household tools",
      "Priced well below the professional brands",
      "Drove deck screws and pilot-drilled lags steadily in our testing"
    ],
    "cons": [
      "Slower on long lags than the Milwaukee and DeWalt despite the higher printed torque",
      "Top speed of 2,900 RPM is the lowest of the conventional drivers here"
    ],
    "bottomLine": "The best value impact driver for homeowners, and an easy choice for anyone already on ONE+.",
    "description": "Ryobi's ONE+ HP driver is the clearest illustration of why torque numbers do not compare across brands. Ryobi rates it at 2,200 in-lbs, more than Milwaukee claims for its flagship, yet in our lag-screw test it was clearly slower than both the Milwaukee M18 FUEL and the DeWalt Atomic. That is less a criticism of the tool than of the number. Its top speed of 2,900 RPM is the lowest of the conventional drivers here, and speed under load is what finishes long fasteners. For the work most homeowners actually do, none of that matters much. It drove 3-inch deck screws steadily all afternoon, handled pilot-drilled lags, and its four modes are genuinely useful: three speeds at 0-850, 0-2,000 and 0-2,900 RPM, plus an Assist mode that starts slowly until the screw bites and then ramps up, which reduces cam-out on the first few turns. The real reason to buy it is the platform. ONE+ batteries run a huge range of tools, including mowers, trimmers, blowers and household gadgets, and the HP brushless tools close much of the gap with the pro brands at a much lower price. If you already own ONE+ batteries, this is the driver to buy, bare."
  },
  {
    "id": "bosch-gdr18v-1860cn-impact-driver",
    "name": "Bosch 18V Connected-Ready 1/4-Inch Hex Impact Driver (GDR18V-1860CN)",
    "category": "18V Brushless, 3-Speed, Connected-Ready",
    "badge": "Best for Bosch Owners",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 500,
    "pros": [
      "Bosch rates it at 1,860 in-lbs and up to 4,100 IPM",
      "Three speeds topping out at 1,100, 2,300 and 3,400 RPM",
      "Auto bolt-release mode slows the driver as a fastener comes free in reverse",
      "Connected-ready: an optional module lets you customise modes from a phone",
      "Compatible with all Bosch 18V batteries"
    ],
    "cons": [
      "About 2.4 lb bare and 4-7/8 inches long, bulkier than the DeWalt Atomic",
      "Bosch's 18V catalog is smaller in the US than Milwaukee's or DeWalt's, and the connectivity module costs extra"
    ],
    "bottomLine": "A strong, well-controlled driver that makes sense if you already own Bosch 18V batteries, less so as a reason to start the platform.",
    "description": "Bosch's GDR18V-1860CN is a capable driver that rarely gets the attention of the big three. Bosch rates it at 1,860 in-lbs and up to 4,100 impacts per minute, with three speeds topping out at 1,100, 2,300 and 3,400 RPM. In our driving it sat comfortably in the middle of the pack: quick on construction screws, competent on lags and smooth in its low setting for smaller fasteners. The most useful extra is the auto bolt-release function, which slows the driver as a bolt or screw comes free in reverse, so the fastener stops at the tip of the bit instead of dropping off it. The connected-ready feature lets you fit an optional Bluetooth module and adjust speed and mode settings from a phone app. That is handy for tradespeople who want a custom mode for a specific fastener and irrelevant to most homeowners, which is why we would not pay extra for it. The body is a little long at about 4-7/8 inches and heavier than the DeWalt at about 2.4 pounds bare. The bigger question is the platform. Bosch 18V is well built and consistent across its tools, but its US catalog is smaller than Milwaukee's or DeWalt's. Buy it if you already own Bosch batteries."
  },
  {
    "id": "makita-xst01z-oil-impulse-driver",
    "name": "Makita 18V LXT Brushless Oil-Impulse 3-Speed Impact Driver (XST01Z)",
    "category": "Hydraulic Oil-Impulse, 18V LXT",
    "badge": "Quietest",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 600,
    "pros": [
      "Oil-impulse mechanism is far quieter than a conventional hammer-and-anvil driver",
      "Smooth pulses make it easy to set screws flush in trim and cabinetry",
      "Three speeds up to 3,200 RPM plus Quick-Shift mode to prevent stripping",
      "Extreme Protection Technology for dust and water resistance",
      "Runs on Makita 18V LXT batteries"
    ],
    "cons": [
      "Rated at only 355 in-lbs, a fraction of the conventional drivers",
      "Not suitable for lag screws or long structural fasteners"
    ],
    "bottomLine": "The driver for indoor finish work where noise matters, and a second driver rather than a first for almost everyone else.",
    "description": "The XST01Z is here because it is a different tool, not a weaker version of the others. Instead of a steel hammer striking a steel anvil, it uses a sealed oil chamber to deliver its pulses, and the difference in noise is immediate. Makita claims up to 30 percent less noise than a conventional impact driver, and working inside a finished room we found it far less tiring over a long session. The pulses are also softer, which makes it easy to set screws flush in trim, cabinet backs and drywall without overdriving. The trade-off is plain in the numbers. Makita rates it at 355 in-lbs of torque, with three speeds up to 3,200 RPM and up to 2,700 impulses per minute, against 1,500 to 2,000 in-lbs for the conventional drivers here. It drove 2-1/2-inch screws into framing, slowly, and it is not a tool for lag screws, ledger boards or long structural fasteners. The Quick-Shift mode helps prevent stripping on self-tapping screws, and Makita's Extreme Protection Technology adds dust and water resistance. For cabinet installers, electricians working in occupied homes and anyone who does a lot of indoor assembly, it is a pleasure to use. For a homeowner buying a single driver, a conventional model on its low setting is more versatile."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Impact Drivers",
          item: "https://www.thehonestreviewers.com/best-impact-driver/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best impact driver for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the best impact driver is the brushless model from the battery platform they already own. If you are starting from nothing, the Milwaukee M18 FUEL 2953-20 is the strongest all-rounder we tested, the DeWalt DCF850 Atomic is the best compact full-size option, and the Ryobi ONE+ HP PBLID02 gives homeowners the most for the money."
          }
        },
        {
          "@type": "Question",
          "name": "How much torque does an impact driver need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Far less than the marketing suggests. Any current brushless 18V or 20V impact driver has more than enough torque for deck screws, structural screws and lags up to around half an inch with a pilot hole. Even 12V compact drivers handle most household jobs. If you need more than that, you probably need an impact wrench rather than a bigger impact driver."
          }
        },
        {
          "@type": "Question",
          "name": "Can I compare torque numbers between brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not reliably. There is no single standard behind the in-lb figures printed on impact driver boxes, and each brand tests under its own conditions. Figures within one brand are comparable, which helps when choosing between a brand's 12V and 18V models, but a 2,200 in-lb claim from one maker is not necessarily stronger than 2,000 from another."
          }
        },
        {
          "@type": "Question",
          "name": "Are hydraulic impact drivers worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For people who drive screws indoors all day, often yes. Oil-pulse drivers like the Makita XST01Z are much quieter and smoother than conventional drivers. The trade-off is far lower torque, which rules them out for lag screws and heavy structural work. For most homeowners, a conventional driver used on its low speed mode is the more versatile single tool."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a 12V or 18V impact driver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy 18V or 20V if you build decks, frame or drive lag screws regularly, or if you already own batteries for one of those platforms. Buy 12V if you mostly assemble furniture, install cabinets or do repair work, where the lighter and smaller tool is easier to handle and still has plenty of power for the job."
          }
        },
        {
          "@type": "Question",
          "name": "Can an impact driver drill holes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can drill small holes with hex-shank drill bits, but it is not good at it. The hammering action makes holes rough, there is no clutch, and larger bits wander. For pilot holes before lag screws it works well enough. For clean holes in finished material, holes over about 1/4 inch, or masonry, use a drill or a hammer drill."
          }
        },
        {
          "@type": "Question",
          "name": "Is a drill and impact driver combo kit worth buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes, if you are starting a battery platform from scratch. A two-tool combo kit often costs little more than the drill on its own and includes a charger and batteries. Just check the battery sizes: many kits include small compact packs, which suit the driver well but will be too small for a circular saw later on."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "best impact driver",
      "cordless impact driver",
      "impact driver torque",
      "oil pulse impact driver",
      "brushless impact driver",
      "12V impact driver"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Drivers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Impact Drivers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We drove 3-inch framing screws, half-inch lags and self-tapping metal screws with seven drivers, and found that the battery you already own matters more than the torque number on the box.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#milwaukee-2953-20-impact-driver"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Choose
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#platform" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Pick the Platform First</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#torque" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Torque Figures Explained</a>
          <a href="#speed" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. RPM, IPM and Speed Modes</a>
          <a href="#drill-or-driver" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Impact Driver or Drill?</a>
          <a href="#hydraulic" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Hydraulic Oil-Pulse Drivers</a>
