          <a href="#by-job" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Which One, By Job</a>
          <a href="#finishing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Sanding and Painting</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. FAQ</a>
        </nav>
