  },
  {
    "id": "duromax-xp5500hx",
    "name": "DuroMax XP5500HX",
    "category": "Dual Fuel Open-Frame, 4,500W Running / 5,500W Starting",
    "badge": "Best Cheap Dual Fuel",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1500,
    "pros": [
      "4,500 running watts on gas, 4,275 on propane",
      "Electric start",
      "CO alert with automatic shutdown",
      "120/240V 30A twist-lock outlet",
      "Spec sheet lists about 8.8 hours at 50% load on gasoline"
    ],
    "cons": [
      "Around 128-131 lb",
      "Loud open-frame engine",
      "Not sold in California, per some retailers"
    ],
    "bottomLine": "The most generator for the money if you want propane, push-button starting and a 240V twist-lock in one budget unit.",
    "description": "The XP5500HX is where a cheap generator starts doing serious home-backup work. DuroMax rates it at 5,500 starting and 4,500 running watts on gasoline and 5,225 and 4,275 on propane, with electric start and a CO alert that shuts the engine off. The spec sheet lists two 120V 20A GFCI outlets, a USB port and a 120/240V 30A twist-lock outlet. That last one is unusual at this price, because it means the generator can feed a transfer switch or inlet box and run a 240V well pump. The spec sheet gives about 8.8 hours at 50% load on gasoline and 7.6 on propane. The trade-offs are the ones every budget open-frame has. It weighs roughly 130 pounds, it is loud, and DuroMax does not publish the kind of low distortion figure inverters do, so sensitive electronics belong on a UPS or a small inverter. For a fridge, freezer, sump pump, well pump and some lights through a transfer switch, it covers more than most buyers in this price range expect."
  },
  {
    "id": "wen-56235i",
    "name": "WEN 56235i",
    "category": "Inverter, 1,900W Running / 2,350W Surge",
    "badge": "Cheapest Inverter Worth Owning",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 9800,
    "pros": [
      "1,900 rated and 2,350 surge watts",
      "About 39 lb",
      "WEN lists 51 dB at quarter load",
