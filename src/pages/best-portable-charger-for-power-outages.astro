];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Portable Chargers for Power Outages in 2026: Ranked";
const description =
  "The 7 best portable chargers for power outages, from pocket power banks to AC-outlet battery packs, with phone-charge math and what each one can really run.";

const PRODUCTS = [
  {
    "id": "anker-737-power-bank-24k",
    "name": "Anker 737 Power Bank (PowerCore 24K)",
    "category": "24,000mAh, 140W USB-C PD 3.1",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "24,000mAh (about 88.8Wh) is enough for three to four full phone charges",
      "140W USB-C output charges phones, tablets and most laptops at full speed",
      "Two USB-C ports and one USB-A port run three devices at once",
      "Built-in display shows remaining percentage and input or output watts",
      "Stays under the 100Wh carry-on limit, so it doubles as a travel bank"
    ],
    "cons": [
      "At about 630g (1.4 lb), it is a bag item, not a pocket item",
      "No AC outlet, so anything with a wall plug needs a different power source"
    ],
    "bottomLine": "The one power bank most households should own for outages: big enough for a whole family's phones over a weekend, fast enough to refill a laptop.",
    "description": "The Anker 737 is the bank we would hand to anyone who asks for one portable charger to keep in the emergency drawer. Anker rates it at 24,000mAh, which works out to roughly 88.8Wh, and it pushes up to 140W through USB-C using Power Delivery 3.1. In practice that means a modern phone charges at whatever speed it accepts, a tablet tops up quickly, and most laptops, including 14-inch and many 16-inch models, charge at or near full speed instead of just slowing their drain. There are two USB-C ports and one USB-A port, so a household can charge a phone, a tablet and a pair of earbuds at the same time. The small screen on the side is more useful than it sounds during an outage: it shows remaining battery as a percentage and the live wattage in or out, so you know exactly how much reserve you have instead of guessing from four LEDs. Recharging is fast too. With a 140W wall charger it refills in a couple of hours, which matters if power comes back briefly between outages and you want to bank as much as possible. The capacity sits safely under the 100Wh carry-on threshold, so the same bank goes on trips. The tradeoffs are size and weight. At about 630g it is closer to a can of soup than a phone, and it has no AC outlet, so a CPAP, a fan with a wall plug or a small TV are off the table. For phones, laptops, USB lights and a router with the right cable, though, nothing at this price is more useful."
  },
  {
    "id": "anker-nano-power-bank-a1259",
    "name": "Anker Nano Power Bank (30W, Built-In USB-C Cable)",
    "category": "10,000mAh, 30W, Built-In Cable",
    "badge": "Best Pocket Charger",
    "amazonUrl": "#",
    "pros": [
      "10,000mAh in a size that fits a jacket pocket or glovebox",
      "Built-in USB-C cable means you never hunt for a cord in the dark",
      "30W output fast-charges current phones",
      "Extra USB-C and USB-A ports charge a second device",
      "Cheap enough to buy one per family member"
    ],
    "cons": [
      "About 1.5 to 2 phone charges, not enough for a long outage on its own",
      "An attached cable cannot be replaced if it frays"
    ],
    "bottomLine": "Buy one per person as a personal reserve, then pair them with a bigger shared bank. It is the right second charger, not the only one.",
    "description": "Anker lists the A1259 Nano at 10,000mAh with a USB-C cable built into the body, plus one extra USB-C port and one USB-A port, and up to 30W output. That combination solves the most common outage failure we hear about: the bank is charged, but nobody can find a cable in a dark house. Here the cable is part of the bank, so whoever grabs it can plug in immediately. Thirty watts is more than enough to fast-charge any current iPhone or Android phone, and enough to top up a tablet or a small handheld game console, though not enough to run most laptops at full speed. Capacity is the honest limitation. A 10,000mAh bank holds about 37Wh, and after conversion losses delivers roughly 24Wh to a device, which is around 1.5 to 2 full charges for a typical phone. That makes it a one-person, one-day reserve if you are careful with screen brightness, or a dependable top-up for the commute or the car once the lights are back. Where the Nano shines in outage planning is as a personal bank: one for each adult or teenager, kept charged in a bag or nightstand, so nobody drains the big shared bank on their own. At this price, buying three or four of them is realistic, and that spreads your stored energy across the household instead of putting it all in one device. Keep it out of hot cars in summer, and top it up every few months. It is a pocket charger done right, but not a substitute for the larger banks on this list."
  },
  {
    "id": "anker-solix-c300-dc",
    "name": "Anker SOLIX C300 DC",
    "category": "288Wh LiFePO4, 300W DC Power Bank Station",
    "badge": "Best for Multi-Day Outages",
    "amazonUrl": "#",
    "pros": [
      "288Wh is roughly three times the energy of the largest airline-legal banks",
      "LiFePO4 chemistry handles thousands of cycles and holds charge well in storage",
      "Multiple USB-C ports, including a 140W port, plus USB-A and a 12V car socket",
      "Runs a Wi-Fi router for well over a day through the 12V socket or a USB-C cable",
      "Accepts solar input, so it can be refilled during a long outage"
    ],
    "cons": [
      "No AC outlet, so plug-in appliances and most CPAP power bricks will not work",
      "At about 6 lb, it is a shelf battery, not something you carry around"
    ],
    "bottomLine": "The best way to stretch USB charging across a multi-day outage. If you only need phones, laptops, lights and the router, it does the job of a power station for less.",
    "description": "The SOLIX C300 DC sits in the gap between a power bank and a power station, and for many outage kits it is the smartest buy on this list. Anker rates it at 288Wh with a LiFePO4 battery and 300W of total output, and the DC in the name means exactly what it says: there is no AC inverter and no wall-style outlet. Instead you get several USB-C ports, the strongest rated at 140W, a USB-A port and a 12V car socket. Dropping the inverter is a feature for outage use. Inverters burn energy just by being switched on, and almost everything people actually need during an outage, phones, laptops, LED lanterns, USB fans and a Wi-Fi router, runs on USB or 12V anyway. With 288Wh on board and conversion losses taken into account, it can deliver something like 15 phone charges, three or four laptop charges, or more than a day of router runtime on a typical 10W router through a 12V or USB-C adapter cable. LiFePO4 chemistry is the other reason it belongs in an emergency kit. It is rated for far more charge cycles than a standard lithium power bank and tends to hold its charge better while it sits in a closet between storms. It also takes solar input, so a small folding panel can refill it during a long outage. The limits are clear: no AC outlet means no plug-in CPAP brick, no microwave, no fridge, and at about 6 lb it lives on a shelf rather than in a backpack. If you need wall outlets, look at the River 3 below or a full power station."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow River 3",
    "category": "245Wh LiFePO4, 300W AC Outlets",
    "badge": "Best With an AC Outlet",
    "amazonUrl": "#",
    "pros": [
      "Real AC outlets turn it into a portable outlet for small plug-in devices",
      "LiFePO4 chemistry rated for long cycle life",
      "Small and light enough to carry in one hand",
      "Charges from the wall in about an hour",
      "Can run a CPAP without humidifier, a router and lights for a night"
    ],
    "cons": [
      "245Wh will not run a refrigerator or space heater for any useful time",
      "300W output limits it to small electronics, lighting and fans"
    ],
    "bottomLine": "The smallest sensible step from a power bank to a power station. Buy it when you need wall outlets, not just USB ports.",
    "description": "Sometimes what you need during an outage is not another USB port but a wall outlet: a CPAP power brick, a modem with a barrel-plug adapter, a small fan, a lamp. That is where the EcoFlow River 3 earns a spot on a power bank list. It is a compact power station with a 245Wh LiFePO4 battery and 300W of AC output from proper three-prong outlets, plus USB-C, USB-A and a 12V car port. In practical terms it is a portable outlet that fits in one hand and recharges from the wall in about an hour, which matters when the grid flickers back on for a short window. The arithmetic for outage use is straightforward. At around 85 percent usable through the inverter, 245Wh gives you roughly 200Wh. A CPAP drawing 30 to 40W with the humidifier off runs for most or all of a night. A router and modem pulling 15W combined run for well over half a day. Phone and laptop charging over USB-C is more efficient than going through the AC outlet, so plug USB devices directly into its USB ports rather than using a wall charger. LiFePO4 chemistry means the River 3 is rated for many more charge cycles than a regular lithium bank and holds its charge well between storms. Do not mistake it for home backup, though. A refrigerator, a microwave, a sump pump or a space heater either exceeds its 300W output or drains it in under an hour. For those, read our sizing guide and look at the larger power stations we link below."
  },
  {
    "id": "anker-maggo-power-bank-10k",
    "name": "Anker MagGo Power Bank (10K)",
    "category": "10,000mAh, Qi2 15W Magnetic Wireless",
    "badge": "Best MagSafe Bank",
    "amazonUrl": "#",
    "pros": [
      "Qi2-certified 15W magnetic wireless charging for iPhone and Qi2 Android phones",
      "Snaps on and charges with no cable at all",
      "Smart display shows battery level and time remaining",
      "Built-in fold-out stand props the phone up for video calls or news",
      "Two-way USB-C for wired charging and recharging the bank"
    ],
    "cons": [
      "Wireless charging wastes more energy than a cable, so you get fewer full charges",
      "10,000mAh is a one-person, one-day reserve"
    ],
    "bottomLine": "The easiest bank to actually use in the dark, and the best choice for iPhone owners who hate cables. Pair it with a larger bank for longer outages.",
    "description": "Anker's MagGo Power Bank (10K), model A1654, is the magnetic option we recommend for iPhone households and for Android phones that support Qi2. It is Qi2 certified for 15W wireless charging, so it snaps onto the back of a compatible phone and starts charging with no cable involved, which is genuinely useful in a dark house where you are holding a flashlight in one hand. A small smart display shows remaining battery and estimated time, and a fold-out stand lets the phone sit upright on a table while it charges, handy for following storm coverage or a video call with family. There is also a two-way USB-C port for wired charging and for refilling the bank itself. The caveat is efficiency. Wireless charging loses more energy as heat than a cable does, so a 10,000mAh magnetic bank typically delivers noticeably fewer full charges than the same capacity used over USB-C. Expect a bit more than one full charge wirelessly for most current iPhones, and closer to two if you plug in with a cable when you are trying to stretch the reserve. That makes the MagGo a personal convenience bank rather than the backbone of an outage plan. Where it fits best is as the bank someone actually uses every day, which means it is more likely to be charged and within reach when the lights go out. If you go this route, set the phone to low power mode early in an outage, use the cable when energy matters more than convenience, and keep a larger shared bank like the Anker 737 for the household."
  },
  {
    "id": "goal-zero-venture-75",
    "name": "Goal Zero Venture 75",
    "category": "19,200mAh, IP67 Rugged, 60W USB-C PD",
    "badge": "Best Rugged Camping Bank",
    "amazonUrl": "#",
    "pros": [
      "IP67 dust and water rating survives rain, mud and a dropped-in-the-creek moment",
      "19,200mAh is about three phone charges",
      "60W USB-C PD charges phones fast and recharges the bank in about 1.5 hours",
      "Built-in flashlight is useful in a dark house or tent",
      "Rubber sleeve and sealed port cover stand up to rough handling"
    ],
    "cons": [
      "Costs more than a non-rugged bank of the same capacity",
      "60W is not enough to charge larger laptops at full speed"
    ],
    "bottomLine": "The bank to keep in a storm bag or truck, or to take camping. You pay a premium for ruggedness, and for an outage that happens in bad weather, it is often worth it.",
    "description": "Outages tend to happen in bad weather, and a lot of emergency gear spends its life in a truck, a garage shelf or a go-bag. The Goal Zero Venture 75 is built for exactly that. Goal Zero rates it at 19,200mAh with an IP67 dust and water rating, a protective rubber sleeve and a sealed cover over the ports, so rain, mud or a fall into a puddle are not the end of it. That ruggedness also makes it our pick as a power bank for camping, where it gets knocked around far more than a bank on a nightstand. It has a 60W USB-C Power Delivery port that both charges your devices and refills the bank, and Goal Zero says a full recharge takes about an hour and a half from a capable USB-C charger. There is also a built-in flashlight, which sounds like a gimmick until you are digging through a dark closet for the breaker panel. In capacity terms, 19,200mAh is roughly 71Wh, which after conversion losses delivers around three full charges to a typical phone, or a meaningful top-up for a tablet or small laptop. Sixty watts is enough for phones, tablets and ultrabooks, though larger laptops will charge slowly. The honest knock is value. A standard 20,000mAh bank costs noticeably less and outputs more power, so if your bank lives indoors in a drawer, the Anker 737 is the better buy. Some retailers also show limited stock, so check availability. If your bank lives in a vehicle, a boat or a tent, or travels with you during storm season, the Venture 75 is worth the premium."
  },
  {
    "id": "midland-er310",
    "name": "Midland ER310 Emergency Crank Weather Radio",
    "category": "NOAA Weather Radio, Hand Crank, Solar, USB Charging",
    "badge": "Best Hand-Crank Backup",
    "amazonUrl": "#",
    "pros": [
      "AM, FM and NOAA weather radio with alert scan keeps you informed with no cell signal",
      "Four ways to recharge: hand crank, solar, USB and six AA batteries",
      "Built-in rechargeable pack can top up a phone in an emergency",
      "130-lumen LED flashlight with SOS beacon",
      "Never truly runs out of power as long as you can crank it"
    ],
    "cons": [
      "Small internal battery gives only a partial phone charge",
      "Hand cranking produces very little energy for the effort"
    ],
    "bottomLine": "Not a power bank replacement, but the best last-resort device in an outage kit: weather alerts, light and a trickle of phone charge that never fully runs dry.",
    "description": "Every outage kit needs one device that does not depend on a wall outlet ever coming back, and the Midland ER310 is our pick. It is first a radio: AM, FM and NOAA weather radio with an alert scan feature, which matters because cell networks often get overloaded or go down in the same storm that knocked out your power. It also has a 130-lumen LED flashlight with an SOS beacon and a USB output to charge a phone. The internal battery is listed at about 2,600mAh on most retailer specs, and it can be recharged four ways: from USB, from the small built-in solar panel, by hand crank, or by running the radio on six AA batteries. Be realistic about the phone-charging part. A 2,600mAh pack holds roughly 10Wh, which might give a modern phone a third to half of a charge, enough to make calls and check alerts but not to keep a phone at full. Midland's own figures put one minute of cranking at up to about nine minutes of radio play, so cranking is a way to keep the radio and flashlight going, not a practical way to refill a smartphone. Solar is a trickle that maintains the battery rather than refilling it quickly. That is why we rank it last for charging but still recommend it. The ER310 is the backstop when everything else is drained on day four, and the radio is often more valuable than the phone charge. Charge it fully, put six AA batteries in the kit beside it, and test it every time you test your smoke alarms."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Chargers for Power Outages",
          item: "https://www.thehonestreviewers.com/best-portable-charger-for-power-outages/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best portable charger for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households, a 20,000 to 24,000mAh USB-C bank like the Anker 737 is the best single pick. It delivers three to four phone charges, charges laptops at full speed, and stays under the airline limit. Add a small bank per person, and step up to a 288Wh battery or power station for outages beyond two days."
          }
        },
        {
          "@type": "Question",
          "name": "How many times will a 10,000mAh power bank charge my phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually 1.5 to 2 full charges for a typical current phone. A 10,000mAh bank holds about 37Wh, but conversion losses mean around 24Wh actually reaches the phone. Most phones hold 13 to 19Wh. Wireless charging, cold temperatures and an older phone with a larger battery all reduce the number of charges you get."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power bank run a Wi-Fi router during an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with the right cable. Most routers run on 12V and draw 6 to 12W, so a USB-C PD trigger cable set to 12V can power one from a bank. A 24,000mAh bank runs a 10W router about six to seven hours. Your internet provider's equipment must still have power for the connection to work."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power bank run a CPAP machine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Most CPAPs need AC power or a specific DC adapter and draw 30 to 60W or more, which needs around 300 to 500Wh for a full night. That is power station territory. A compact unit like the EcoFlow River 3 can run many machines with the humidifier off. Check your model's DC options first."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a power bank hold its charge in storage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quality lithium power bank typically loses a few percent per month in storage at room temperature, more in heat. That means a bank can be well short of full after six months. Top it up every three months, store it indoors away from heat, and charge everything the moment an outage is forecast."
          }
        },
        {
          "@type": "Question",
          "name": "What is the largest power bank allowed on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under FAA rules, power banks of 100Wh or less are allowed in carry-on bags without airline approval. Banks between 100 and 160Wh need airline approval, with a limit of two. Anything over 160Wh is prohibited on passenger aircraft. Power banks are never allowed in checked luggage, and the Wh rating should be printed on the case."
          }
        },
        {
          "@type": "Question",
          "name": "Is a power bank or a power station better for outages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on what you need to run. Power banks are cheaper, lighter and ideal for phones, laptops, lights and a router. A power station adds AC outlets and much more capacity, so it can run a CPAP, fans and small appliances. Many households keep both: banks for personal devices, and a station for everything with a plug."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "portable chargers for power outages",
      "portable battery pack",
      "power bank for camping",
      "portable power source",
      "portable outlet",
      "emergency phone charger",
      "power bank for power outage"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Portable Chargers for Power Outages</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          When the grid goes down, your phone is your weather alert, your flashlight and your line to everyone. These are the battery packs worth keeping charged in a drawer, and the point where you need something bigger.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-737-power-bank-24k"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 7 Top Picks Reviewed</a>
