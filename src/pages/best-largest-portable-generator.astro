---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 20000 Watt Generators",
    "url": "/best-20000-watt-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Tri-Fuel Generators",
    "url": "/best-tri-fuel-generator/"
  },
  {
    "title": "Portable vs Standby Generator",
    "url": "/portable-vs-standby-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "6 Largest Portable Generators in 2026: Biggest in Each Category";
const description =
  "The largest portable generators by category: biggest gas, tri-fuel and inverter models, the biggest you can move alone, with real weights and running watts.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen20000tfc",
    "name": "Westinghouse WGen20000TFc",
    "category": "Largest Tri-Fuel, 20,000W Running Gas / 16,000W Natural Gas",
    "badge": "Largest Overall",
    "amazonUrl": "#",
    "pros": [
      "20,000 running and 28,000 peak watts on gasoline; 18,000 running on propane",
      "Runs on natural gas at 16,000 running watts for open-ended runtime",
      "125A 240V terminal block plus two 14-50R and two L14-30R outlets",
      "17.2-gallon tank rated for 14 hours at 25% load"
    ],
    "cons": [
      "557 lb dry and about 40 inches tall; a two-person machine at minimum",
      "Propane runtime from a 20 lb cylinder is rated at only 3 to 5 hours"
    ],
    "bottomLine": "The largest portable you can buy from a mainstream brand, by weight and by output across three fuels. Treat it as a semi-permanent installation, not a grab-and-go.",
    "description": "By every measure that makes a portable large, the WGen20000TFc is at the top. Westinghouse lists it at 557 pounds dry, with a 999cc V-twin rated for 20,000 running and 28,000 peak watts on gasoline, 18,000 running on propane and 16,000 on natural gas. Retail listings give its footprint as about 38 by 35 inches and just over 40 inches tall. The 17.2-gallon tank is rated for 14 hours at 25% load. The feature that sets it apart from other big portables is the 125A, 240V terminal block, which lets an electrician wire the full output to a 100-amp transfer switch rather than being limited to the 12,000 watts a 14-50 cord can carry. Natural gas turns it into a near-standby with no refueling. Propane is its weak point, at 3 to 5 hours from a 20 lb cylinder per Westinghouse, so plan on large tanks. Buy it when you need the most capacity on the most fuels and it will rarely move."
  },
  {
    "id": "duromax-xp28000ih",
    "name": "DuroMax XP28000iH",
    "category": "Largest Inverter, 22,000W Running / 28,000W Peak",
    "badge": "Largest Inverter",
    "amazonUrl": "#",
    "pros": [
      "22,000 running watts on gas and 20,000 on propane, the most of any inverter we found",
      "Variable engine speed, rated at 70 dB at 25% load",
      "Two 14-50R, an L14-30R and four 5-20R receptacles",
      "Rated for 16 hours at 25% load from a 12.7-gallon tank"
    ],
    "cons": [
      "466 lb, so it is only portable in the sense of having wheels",
      "New model with little long-term owner history"
    ],
    "bottomLine": "If 'large inverter generator' means the most clean, throttled power on wheels, this is the ceiling of the category right now.",
    "description": "Large inverter generators used to stop at about 9,000 to 11,000 watts. The XP28000iH more than doubles that. DuroMax rates it at 22,000 running and 28,000 peak watts on gasoline, and 20,000 running and 25,000 peak on propane, from a 999cc engine whose speed follows the load. Physically it measures 39.25 by 31 by 34.5 inches and weighs 466 pounds, which puts it in the same size class as the open-frame 20kW units, not the suitcase inverters people usually imagine. The inverter benefits are a listed 70 dB at 25% load and 16 hours from the 12.7-gallon tank at that load, and DuroMax lists propane runtime of 18 hours at 25% from a 60 lb tank. Outlets are two 14-50R, one L14-30R and four 5-20R. The concern is age: this is a new model, so its long-term reliability is unproven. It is still the biggest inverter we could confirm on sale."
  },
  {
    "id": "westinghouse-wgen20000c",
    "name": "Westinghouse WGen20000c",
    "category": "Largest Gas-Only Open Frame, 20,000W Running",
    "badge": "Largest Gas-Only",
    "amazonUrl": "#",
    "pros": [
      "20,000 running and 28,000 peak watts on gasoline",
      "Seven receptacles including two 14-50R and two L14-30R",
      "Remote electric start and CO sensor shutoff",
      "Simpler fuel system than the tri-fuel version, at 16 lb lighter"
    ],
    "cons": [
      "541 lb dry, and gasoline only",
      "Not CARB compliant; listed at 74 dBA"
    ],
    "bottomLine": "The largest gas-only portable worth considering. Choose it over the tri-fuel version only if you will never run propane or natural gas.",
    "description": "The WGen20000c is the gasoline-only version of the WGen20000TFc and, at 541 pounds dry, is only 16 pounds lighter. It has the same 999cc V-twin and the same 20,000 running and 28,000 peak watts on gasoline. The panel has two 120/240V 14-50R outlets, two L14-30R, an L5-30 and two 5-20R duplexes, and Westinghouse rates its 17.2-gallon tank at 8 hours at 50% load. Remote start and a CO sensor are standard. Without the terminal block of the tri-fuel model, you are limited to 12,000 watts per 14-50 cord unless an electrician wires a larger connection, so many owners use one 14-50 for the house and the second for a shop or RV. It is not sold in California. If gasoline is the only fuel you will ever use, it is the largest open-frame gas portable from a major brand we could find."
  },
  {
    "id": "duromax-xp15000hx",
    "name": "DuroMax XP15000HX",
    "category": "Largest Dual Fuel Under 350 lb, 12,000W Running",
    "badge": "Best Big-But-Movable",
    "amazonUrl": "#",
    "pros": [
      "12,000 running watts on gas and 11,400 on propane, enough to fill a 14-50 inlet",
      "345 lb dry, about 200 lb less than the 20kW Westinghouse units",
      "13.2-gallon tank rated for 17.9 hours at 25% load",
      "Remote, electric and recoil start; 5-year warranty"
    ],
    "cons": [
      "Listed at 78 dB at 50% load, the loudest here",
      "Still too heavy for one person on anything but smooth concrete"
    ],
    "bottomLine": "The point where 'large' stops costing you more than it gives. For most homes it is the largest generator worth buying.",
    "description": "The XP15000HX is the largest dual fuel open frame we would recommend to someone who has to move the generator out and back each outage. DuroMax rates it at 12,000 running and 15,000 peak watts on gasoline and 11,400 running on propane, from a 670cc engine. That 12,000-watt figure matters, because it is the most a single 120/240V 14-50 inlet can carry, so the generator can use the full capacity of the most common home connection. At 345 pounds dry and about 36 by 33 by 32 inches, it is nearly 200 pounds lighter than the Westinghouse 20kW units and a few inches smaller in every direction. The 13.2-gallon tank is rated for 17.9 hours at 25% load. The drawback is noise: DuroMax lists 78 dB at 50% load, more than any other unit on this page. If you want a big generator without a semi-permanent installation, this is the one."
  },
  {
    "id": "duromax-xp16000ih",
    "name": "DuroMax XP16000iH",
    "category": "Largest Mid-Weight Inverter, 13,000W Running",
    "badge": "Best Large Inverter Value",
    "amazonUrl": "#",
    "pros": [
      "13,000 running watts on gas and 12,350 on propane, from an inverter",
      "Two 14-50R outlets with 120V GFCI receptacles",
      "Rated at 66.9 dB at 25% load",
      "368 lb, about 100 lb lighter than the XP28000iH"
    ],
    "cons": [
      "EPA certified only, so not sold in California",
      "10.6-gallon tank is small for the output"
    ],
    "bottomLine": "A large inverter that is a little bigger than a 50-amp inlet needs. Choose it over the XP28000iH if you want inverter output without the extra 100 pounds.",
    "description": "The XP16000iH sits between the suitcase inverters and the XP28000iH. DuroMax's manual rates it at 13,000 running and 16,000 surge watts on gasoline, and 12,350 running and 15,200 surge on propane, from a 744cc V-twin. It weighs 368 pounds and measures 38.3 by 30.8 by 34.4 inches, close to the footprint of the bigger model but about 100 pounds lighter. Noise is listed at 66.9 dB at 25% load, the lowest of any generator here above 12,000 watts. The panel has two 120/240V 14-50R outlets and 120V GFCI 5-20R receptacles, and runtime is rated at 10.5 hours at 50% load on gasoline and 9.4 hours on a 60 lb propane tank. The 10.6-gallon tank is small for the output, and the unit is EPA certified but not CARB, so it is not sold in California. For a large inverter that suits a 50-amp connection, it is the more practical DuroMax."
  },
  {
    "id": "champion-201423",
    "name": "Champion 201423 11,000-Watt Tri Fuel Inverter",
    "category": "Largest One-Person Unit, 9,000W Running",
    "badge": "Largest You Can Move Alone",
    "amazonUrl": "#",
    "pros": [
      "212.3 lb in a compact 28-inch cube, with 8-inch solid wheels",
      "Tri-fuel: 9,000 / 8,100 / 7,290 running watts on gas, propane and natural gas",
      "Listed at 64 dBA, with under 3% THD",
      "14-50R, L14-30R and two GFCI duplex outlets; wireless start from 80 ft"
    ],
    "cons": [
      "Its 14-50R is rated at 37.5A, not a full 50A",
      "6.08-gallon tank limits gasoline runtime"
    ],
    "bottomLine": "The largest generator most people can move by themselves. If you live alone or store it away from the run spot, start here.",
    "description": "The Champion 201423 is on this list because it answers the question many people really mean when they search for a large portable generator: what is the most power I can handle on my own? Champion rates it at 11,000 starting watts on all three fuels and 9,000 running on gasoline, 8,100 on propane and 7,290 on natural gas, from a 459cc engine. It weighs 212.3 pounds and measures roughly 28 inches in every direction, with 8-inch solid wheels, so one person can roll it across a driveway and up a shallow ramp, which none of the units above allow. It is listed at 64 dBA, with under 3% THD. The panel includes a 14-50R rated at 37.5 amps, an L14-30R, two 5-20R GFCI duplexes and a 12V outlet, and a key fob starts it from up to 80 feet away. The 6.08-gallon tank is rated for 15 hours at 25% load. It is not a whole-house unit, but it covers essentials plus central air in many homes."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Largest Portable Generators",
          item: "https://www.thehonestreviewers.com/best-largest-portable-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the largest portable generator you can buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By output, the DuroMax XP28000iH is rated at 22,000 running and 28,000 peak watts on gasoline. By weight, the Westinghouse WGen20000TFc is the largest at 557 pounds dry, with 20,000 running watts on gasoline and natural gas capability. Both are far too heavy for one person to move easily."
          }
        },
        {
          "@type": "Question",
          "name": "What is the biggest inverter generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The largest we could confirm on sale is the DuroMax XP28000iH, rated at 22,000 running watts on gasoline and 20,000 on propane. It weighs 466 pounds. The XP16000iH is a smaller option at 13,000 running watts and 368 pounds, and is listed at 66.9 dB at quarter load."
          }
        },
        {
          "@type": "Question",
          "name": "What is the largest generator one person can move?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most adults, about 200 to 220 pounds on large wheels across smooth ground. The Champion 201423 fits that limit at 212.3 pounds and 9,000 running watts on gasoline, in a compact 28-inch frame with 8-inch solid wheels. Anything over about 300 pounds usually needs two people."
          }
        },
        {
          "@type": "Question",
          "name": "How heavy is a large portable generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Units in the 12,000 to 13,000-watt range weigh about 345 to 370 pounds dry. The 18,000 to 22,000-watt class weighs 440 to 560 pounds. A full gasoline tank adds roughly 60 to 105 pounds. One-person units top out at around 210 to 220 pounds."
          }
        },
        {
          "@type": "Question",
          "name": "Can a large portable generator run a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 20,000-watt unit can run most houses, including central air and electric appliances, but only if it is connected through a 100-amp transfer switch or terminal block. Through a standard 50-amp inlet, any generator is limited to 12,000 watts, which still covers most homes with some load management."
          }
        },
        {
          "@type": "Question",
          "name": "Is a heavy duty portable generator better than a standby?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A portable costs less and can be taken elsewhere. A standby starts automatically, runs on natural gas or propane without refueling, and never has to be moved. For long or frequent outages, or households that cannot move a 450-pound machine, a standby is usually the better choice."
          }
        },
        {
          "@type": "Question",
          "name": "Do large generators need a special outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most connect to the house through a 14-50 or L14-30 inlet and a transfer switch or interlock, installed by an electrician. The 14-50 carries up to 12,000 watts and the L14-30 up to 7,200. The largest units also offer a terminal block for a 100-amp or larger connection."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "largest portable generator",
      "biggest portable generator",
      "large inverter generator",
      "heavy duty portable generator",
      "large generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The <span class="text-[#38BDF8]">Largest</span> Portable Generators
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The biggest gas, tri-fuel and inverter portables on sale, plus the biggest one person can actually move, with real weights and running watts.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen20000tfc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See Each Category
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-largest-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Largest Means</a>
          <a href="#size-ladder" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Size Ladder</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Largest in Each Category</a>
          <a href="#biggest-gas" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Largest Gas-Only</a>
          <a href="#biggest-dual-tri" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Largest Dual and Tri-Fuel</a>
          <a href="#biggest-inverter" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Largest Inverters</a>
          <a href="#move-alone" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Largest You Can Move Alone</a>
          <a href="#outlets" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Outlets and Connections</a>
          <a href="#standby-line" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Portable vs Standby</a>
          <a href="#ownership" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Storage and Upkeep</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The largest portable generators now reach 22,000 running watts and 557 pounds, and the biggest inverters are no longer suitcase units. But the largest generator is rarely the right one. What matters is the largest you can connect, fuel and move. Below are the biggest models in each category, from the 557-pound tri-fuel giant down to the largest unit one person can roll out alone.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-largest-means" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What "Largest" Means for a Portable Generator
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Three Meanings of Largest</h3>

          <p>
            People use "largest portable generator" to mean three different things, and the best answer depends on which you mean. Some want the most watts available without a permanent installation. Some want the physically biggest, heaviest-duty frame. And many want the most power they can personally handle: the biggest unit one adult can roll out of a garage, start and refuel.
          </p>

          <p>
            Those three questions have different answers. On output, the largest portables now reach 20,000 to 22,000 running watts and weigh 440 to 560 pounds. On physical size, the largest are about 3 feet wide, 3 feet deep and more than 3 feet tall. On what one person can move, the practical limit for most adults is about 200 to 220 pounds on good wheels, which right now means about 9,000 running watts.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Why This Page Is Organized by Category</h3>

          <p>
            That is why this page is organized by category rather than a single wattage. For each type, gas-only open frame, dual and tri-fuel, inverter, and one-person, we name the largest model we could confirm is currently sold, with the manufacturer's own ratings. If you already know you need a true 20kW machine, our <a href="/best-20000-watt-generator/">best 20,000-watt generators</a> guide goes deeper into that class.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE RULE</p>
            <p class="text-xl font-bold text-white mb-3">Decide which kind of large you need before you compare models.</p>
            <p class="text-gray-300 leading-relaxed m-0">Most watts, biggest frame and biggest you can move alone point to different generators. Picking the wrong one is how people end up with a 550-pound machine they can't get out of the garage.</p>
          </div>

          <p>
            All ratings below are running watts unless stated. Peak or starting watts are usually 25 to 40% higher and are what most product titles lead with.
          </p>
        </div>

        <div id="size-ladder" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Size Ladder: Largest in Each Category
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Full Size Ladder</h3>

          <p>
            Here is the full picture in one table. Weights are dry weights from the manufacturers' specifications. Dimensions are rounded to the nearest inch.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Category</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Running Watts (Gas)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Weight</th>
