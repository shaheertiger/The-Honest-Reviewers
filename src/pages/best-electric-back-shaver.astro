  ogType="article"
  article={{
    publishedTime: "2026-02-10",
    modifiedTime: "2026-08-01",
    author: "Alex Rivers",
    section: "Grooming",
    tags: [
      "electric back shaver",
      "battery back shaver",
      "mens grooming",
      "body groomer",
      "mangroomer",
      "waterproof shaver",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See #1 Electric Pick", link: PRODUCTS[0].amazonUrl }}
>
  <!-- ========== HERO ========== -->
