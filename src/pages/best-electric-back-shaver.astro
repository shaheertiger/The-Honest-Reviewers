const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Electric Back Shaver",
          item: "https://www.thehonestreviewers.com/best-electric-back-shaver/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How long do electric back shavers actually last on a single charge?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Runtime varies from about 40 minutes (Remington Shortcut Pro) to 90 minutes (Hatteker 4-in-1) per charge. In practice, one full back-shaving session takes 5-15 minutes, so even the shortest-runtime unit we tested handles multiple sessions per charge. Battery type matters more for how often you'll need to recharge weekly than for whether a single session will drain the unit.",
          },
        },
        {
          "@type": "Question",
          name: "What does an IPX7 rating actually mean for a back shaver?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "IPX7 is a certified international standard meaning the device can be fully submerged in up to 1 meter of water for 30 minutes without damage. Only the Philips Norelco Bodygroom 5000, Hatteker 4-in-1, and Panasonic ER-GK60 in this guide carry a true IPX7 rating. Terms like 'rinsable' or 'washable' are not the same thing — those units can only be cleaned under a light rinse or tap, not used in a running shower.",
          },
        },
        {
          "@type": "Question",
          name: "Will an electric back shaver stall on thick or curly back hair?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends entirely on motor torque, not battery size. In our stall testing, the Mangroomer Ultimate Pro's dual-motor Power Burst mode never lost RPM on dense synthetic-fiber test patches, while lower-torque units like the Hatteker 4-in-1 needed slower, more deliberate passes to avoid bogging down. If you have thick or curly back hair, prioritize a shaver with a documented boost mode or dual-motor design over one with the longest advertised runtime.",
          },
        },
        {
          "@type": "Question",
          name: "Should I charge my electric back shaver over USB or a proprietary dock?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "USB charging (Hatteker 4-in-1, Philips Norelco Bodygroom 5000) is generally more convenient because you can use a phone charger, power bank, or laptop as a backup power source if you forget the dock. Proprietary charging cradles (Mangroomer, Remington, Wahl) are not interchangeable with other cables, so losing the cradle means the unit is unusable until you order a replacement.",
          },
        },
        {
          "@type": "Question",
          name: "Is an electric back shaver better than a manual one?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Electric shavers are generally safer for beginners, sensitive skin, moles, and back acne because most use foil or rounded-tip blades that can't nick skin the way exposed manual blades can. Manual back shavers usually deliver a closer shave and never need charging, but carry a higher risk of cuts until technique is dialed in. For a full comparison including manual options like BAKblade and Bro Shaver, see our complete back shaver roundup.",
          },
        },
        {
          "@type": "Question",
          name: "How often do I need to replace the shaving head or foil on an electric back shaver?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most foil heads should be replaced every 12-18 months of regular use, or sooner if you notice pulling, snagging, or reduced closeness. Rinse the head after every use and deep-clean weekly with the included brush to extend its life. Wahl's self-sharpening steel blades typically hold their edge longer than stamped foil heads before needing replacement.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline:
        "Best Electric Back Shaver in 2026: Battery-Powered Tools Tested",
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-02-10",
      dateModified: "2026-08-01",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.descriptionParagraphs
        .join(" ")
        .replace(/\*\*(.+?)\*\*/g, "$1")
        .replace(/\*(.+?)\*/g, "$1"),
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      offers: {
        "@type": "Offer",
        price: product.price,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: product.amazonUrl,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
