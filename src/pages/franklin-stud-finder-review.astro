                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sensors</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Listed Depth</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Wire Detection</th>
