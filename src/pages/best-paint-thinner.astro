                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Do Not Use It For</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Odorless mineral spirits</td>
                    <td class="px-4 py-4 text-gray-700">Refined petroleum distillate</td>
                    <td class="px-4 py-4 text-gray-700">Thinning oil paint, stain, varnish; brush cleanup</td>
