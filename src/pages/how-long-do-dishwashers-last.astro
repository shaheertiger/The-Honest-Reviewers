                    <td class="px-4 py-4 text-gray-700">Usually, unless other faults stack up</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Control board</td>
                    <td class="px-4 py-4 text-gray-700">Dead panel, random stops, error codes</td>
                    <td class="px-4 py-4 text-gray-700">Often not past year 7 or 8</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Circulation motor</td>
                    <td class="px-4 py-4 text-gray-700">No spray, loud buzzing, poor wash</td>
                    <td class="px-4 py-4 text-gray-700">Often not on an older machine</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cracked or rusted tub</td>
                    <td class="px-4 py-4 text-gray-700">Leaks from below, rust streaks</td>
                    <td class="px-4 py-4 text-gray-700">No, replace the machine</td>
                  </tr>
