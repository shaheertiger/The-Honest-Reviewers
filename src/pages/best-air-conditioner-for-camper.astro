---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Can a Portable Power Station Run an Air Conditioner?",
    "url": "/can-a-portable-power-station-run-an-air-conditioner/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Generator Wattage Chart",
    "url": "/generator-wattage-chart/"
  },
  {
    "title": "Best Portable Air Conditioners for Cars",
    "url": "/best-portable-air-conditioner-for-car/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "Best Dual Fuel Inverter Generators",
    "url": "/best-dual-fuel-inverter-generator/"
  },
  {
    "title": "Best Fishing Kayaks",
    "url": "/best-fishing-kayak/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Camper Air Conditioners in 2026: Rooftop, Window & Portable";
const description =
  "The best camper and RV air conditioners in 2026, from rooftop units to window, portable and battery ACs, with 30A vs 50A limits, soft starters and generator sizing.";

const PRODUCTS = [
  {
    "id": "dometic-brisk-ii-13-5k",
    "name": "Dometic Brisk II 13,500 BTU",
    "category": "Rooftop RV AC, 13,500 BTU, About 77 lb, 14 x 14 Vent Fit",
    "badge": "Best Overall Rooftop",
    "amazonUrl": "#",
    "pros": [
      "13,500 BTU is the right size for most trailers and motorhomes up to about 25 feet",
      "Running draw low enough to share a 30A pedestal with a fridge and lights",
      "Drops into a standard 14 x 14 inch roof vent opening",
      "Widely stocked, so parts and replacement shrouds are easy to find",
      "Starts on a 2,200W-class inverter generator with a soft starter, per many owner reports"
    ],
    "cons": [
      "About 77 pounds on the roof; check your roof's rated load",
      "Loud by home standards, like every conventional rooftop unit"
    ],
    "bottomLine": "The default answer for an RV with a 14 x 14 roof opening and 30A service: proven, easy to service and sized correctly for most campers.",
    "description": "The Brisk II is the rooftop air conditioner you will find on more RVs than almost anything else, and for good reason. The 13,500 BTU version is sized for the trailers and motorhomes most people own, roughly 18 to 25 feet, and it is light enough on the electrical system to run on a 30 amp pedestal alongside a fridge, lights and a water heater on gas. Dometic lists a net weight of about 77 pounds and a minimum 20 amp circuit. Retailer specs put the compressor and fan at roughly 15 amps combined at full load, about 1,700 watts, with the real draw usually lower once the cabin is down to temperature. It installs in the standard 14 by 14 inch vent opening used by most RV roof air conditioners, so it is a common direct replacement when an older unit dies. That is also its biggest practical advantage: dealers and mobile techs know it, parts are on the shelf, and a ceiling assembly or shroud is easy to source. The Brisk II has a high-capacity 15,000 BTU sibling for longer rigs and hot climates, and heat pump versions that take the chill off spring and fall mornings. The trade-offs are the ones every conventional rooftop unit shares. It is loud inside by home standards, it puts nearly 80 pounds on your roof, and its single-speed compressor pulls a big surge on startup. Add a soft starter and the Brisk II becomes one of the easier rooftop units to run from a 2,200 to 3,000 watt inverter generator, which many owners report doing."
  },
  {
    "id": "coleman-mach-15",
    "name": "Coleman Mach 15",
    "category": "Rooftop RV AC, 15,000 BTU, About 85 lb, 14 x 14 Vent Fit",
    "badge": "Best for Hot Climates",
    "amazonUrl": "#",
    "pros": [
      "15,000 BTU, among the strongest single rooftop units sold",
      "Known for strong airflow that cools larger rigs faster",
      "Airxcel rates cooling draw around 14 amps, reasonable for its capacity",
      "Fits the standard 14 x 14 inch opening",
      "Heat pump and ducted versions available"
    ],
    "cons": [
      "Roughly 85 pounds or more, heavier than most 13,500 BTU units",
      "Draws more at startup and in extreme heat; harder to run on a small generator"
    ],
    "bottomLine": "Buy it for a long trailer, a dark-colored rig or Southwest summers, where a 13,500 BTU unit runs flat out all afternoon and still falls behind.",
    "description": "The Mach 15 is the unit RV owners in Arizona, Texas and Florida recommend to each other, and its reputation is mostly about raw capacity. At 15,000 BTU it is one of the most powerful single rooftop air conditioners sold, and it moves a lot of air, which matters in a 28 to 35 foot trailer where a 13,500 BTU unit can run all afternoon without ever cycling off. Airxcel, which builds Coleman-Mach units, lists about 13.9 amps for cooling, while some retailer listings give full-load amps closer to 14.8 or 14.9. Plan around 15 amps, about 1,800 watts, at full load in hot weather. Most listings put the weight around 85 pounds, and heat pump and ducted packages weigh more, so check the roof load rating before swapping a lighter unit for it. Like the Brisk II, it fits the standard 14 by 14 inch opening. The extra capacity has a cost on the power side. On a 30 amp pedestal, a Mach 15 running flat out leaves less headroom for a microwave or an electric water heater, and its startup surge makes a 2,200 watt generator a stretch even with a soft starter. A 3,500 watt or larger inverter generator is the safer plan, and our RV generator guide covers the options. If you camp mostly in mild weather or in shade, a 13,500 BTU unit cycles more efficiently and is the better choice. If you are cooking in a long, dark-roofed rig in the desert, the Mach 15 is the one to get."
  },
  {
    "id": "furrion-chill-14-5k",
    "name": "Furrion Chill 14.5K",
    "category": "Rooftop RV AC, 14,500 BTU, About 14.7 A Cooling, 14 x 14 Fit",
    "badge": "Best Mid-Size Rooftop",
    "amazonUrl": "#",
    "pros": [
      "14,500 BTU sits between the common 13.5K and 15K sizes",
      "Retailers list about 1,620W and 14.7A while cooling",
      "Fits a standard 14 x 14 inch roof opening",
      "Factory-installed on many newer trailers, so techs know it",
      "Newer Chill HE line adds heat pump and R32 refrigerant options"
    ],
    "cons": [
      "Listed weights vary from about 77 to 85 pounds depending on source",
      "Outdoor noise is listed at about 80 dB, loud for neighbors at close sites"
    ],
    "bottomLine": "A solid mid-size rooftop unit, especially as a like-for-like replacement on a trailer that shipped with Furrion from the factory.",
    "description": "Furrion is the Lippert-owned brand that ships on a large share of new travel trailers and fifth wheels, and the Chill 14.5K is its mainstream rooftop air conditioner. At 14,500 BTU it lands between the 13,500 BTU units that are standard on smaller rigs and the 15,000 BTU units built for heat, which makes it a sensible size for a 22 to 30 foot trailer. Retailer listings give a cooling draw of about 1,620 watts and 14.7 amps at 115 volts, in line with competing units of its capacity, and an outdoor sound pressure level around 80 dB. Weight listings range from roughly 77 to 85 pounds depending on the source, so check the installation manual for your exact part number before planning roof load. The unit fits the standard 14 by 14 inch vent opening, which means it can replace most other brands' rooftop units with an adapter or matching ceiling assembly. The strongest case for the Chill is replacement. If your trailer came with Furrion, keeping the same family means the thermostat, wiring and ceiling plenum line up, and the swap is quicker and cheaper. Furrion has also launched the Chill HE series with heat pump and R32 refrigerant versions, worth comparing if you are buying new and want shoulder-season heat. Owner feedback on older Furrion units has been mixed on long-term reliability compared with Dometic and Coleman, which is why it ranks third here rather than higher. For a trailer that was built around it, it remains a reasonable choice."
  },
  {
    "id": "midea-5000-btu-window-ac",
    "name": "Midea 5,000 BTU EasyCool Window AC",
    "category": "Window AC, 5,000 BTU, About 150 sq ft, Mechanical Controls",
    "badge": "Best for Small Trailers",
    "amazonUrl": "#",
    "pros": [
      "Inexpensive and widely available",
      "Draws roughly 450W running, typical for this size, so a 1,000W-class generator can run it",
      "Simple mechanical controls with nothing to fail electronically",
      "Small enough for teardrops, tent trailers and vintage campers",
      "Easy to remove for travel and store at home"
    ],
    "cons": [
      "Built for house windows, so camper mounting needs a custom frame or bracket",
      "Not designed for road vibration; remove or secure it before towing"
    ],
    "bottomLine": "The cheapest way to cool a teardrop or small vintage camper on shore power, if you are willing to build a proper mount.",
    "description": "For teardrops, small tent trailers, truck campers and vintage canned hams, a full rooftop unit is overkill and a roof cut-out is not always possible. A small window air conditioner is the classic workaround, and the Midea 5,000 BTU EasyCool is a reliable, inexpensive example. It is rated for about 150 square feet, which covers a 10 to 14 foot camper with room to spare, and units of this size typically draw around 450 watts while running. That draw is the real attraction: it runs comfortably on a 15 amp household outlet, a campground 30 amp pedestal with plenty to spare, or a 1,000 to 2,200 watt inverter generator. Mechanical knobs instead of electronics mean fewer parts to rattle loose. The honest caveat is mounting. Window units are designed to sit in a vertical-sliding house window, and most campers have horizontal sliders, jalousie louvers or no suitable window at all. Owners usually build a framed opening in a wall or a door window, add an exterior bracket to carry the weight, and seal around it against rain. Window units also tilt back slightly to drain condensate outside, which needs to be planned so water does not run down the trailer wall or inside. Do not tow with it hanging unsupported in a window; road vibration can crack the frame or loosen it entirely. Take it out for travel or secure it properly. Done right, a small window unit is the best value camper window air conditioner there is, and far stronger than any battery AC."
  },
  {
    "id": "midea-duo-portable-ac",
    "name": "Midea Duo Inverter Portable AC",
    "category": "Portable AC, Hose-in-Hose Design, Inverter Compressor",
    "badge": "Best Portable AC for Campers",
    "amazonUrl": "#",
    "pros": [
      "Inverter compressor ramps down once cool, saving power and cutting noise",
      "Hose-in-hose design draws outside air in and exhausts it through one window port",
      "No installation; rolls into a cargo trailer, toy hauler or cabin",
      "Sold in more than one size, so you can match capacity to space",
      "Works on any 15 amp outlet or a 2,000W-class inverter generator"
    ],
    "cons": [
      "Large and heavy for an RV floor; it takes real space",
      "Window kit is built for house windows and needs adapting in most campers"
    ],
    "bottomLine": "The best rv portable ac when you cannot cut the roof or the existing rooftop unit needs help, and you have the floor space to spare.",
    "description": "Portable air conditioners are the quickest fix for a camper that has no AC, a rooftop unit that cannot keep up, or a toy hauler garage that turns into an oven. Most portables are inefficient single-hose designs that exhaust cabin air out the window and pull hot outside air in through every gap. The Midea Duo is different in the way that matters: it uses a hose-within-a-hose design that draws outside air in to cool the condenser and sends it back out through the same window port, which avoids most of that negative-pressure penalty. It also uses an inverter compressor, so after the initial pull-down it slows rather than cycling on and off. That makes it quieter and gentler on a generator or power station than a standard portable of the same size. Midea sells the Duo in more than one capacity, and like all portables it carries two ratings: the older ASHRAE number on the box and a lower, more realistic SACC number. Use the SACC figure when comparing it with rooftop units. The downsides are space and setup. It is a large, heavy box for an RV floor, and the window kit is designed for house windows, so most campers need a custom insert of foam board or plexiglass. It also needs a condensate plan in humid weather. As a portable ac unit for camping, it is best in cargo trailers, toy haulers, park models and cabins, or as a supplement to an undersized rooftop unit in a long trailer, not as the primary unit in a small travel trailer where floor space is precious."
  },
  {
    "id": "ecoflow-wave-3",
    "name": "EcoFlow WAVE 3",
    "category": "6,100 BTU Cooling, 6,800 BTU Heating, Optional 1,024Wh LFP Battery",
    "badge": "Best Off-Grid Option",
    "amazonUrl": "#",
    "pros": [
      "Runs from its own 1,024Wh LiFePO4 battery, a power station or solar",
      "Rated 6,100 BTU of cooling and 6,800 BTU of heat",
      "Quiet compared with a rooftop unit and a generator",
      "Portable between camper, tent and vehicle",
      "No roof modification required"
    ],
    "cons": [
      "6,100 BTU is enough for a teardrop or van, not a 25 foot trailer",
      "A few hours per battery in hot weather; expensive per BTU"
    ],
    "bottomLine": "The right pick for boondocking in a small camper where generators are banned or unwelcome; a supplement, not a rooftop replacement, in bigger rigs.",
    "description": "The WAVE 3 is a portable compressor air conditioner designed from the start to run on batteries, which makes it the most practical way to cool a small camper at a site with no hookups and generator restrictions. EcoFlow rates it at 6,100 BTU of cooling and 6,800 BTU of heating, and its optional add-on battery is a 1,024Wh LiFePO4 pack rated for about 4,000 cycles. EcoFlow quotes roughly 2 to 8 hours on that battery depending on conditions and mode. In real summer heat, our arithmetic puts it at the low end: about 870 usable watt-hours at a 300 to 400 watt average is two to three hours. It can also run from an EcoFlow power station, a wall outlet, a vehicle socket or solar, so a camper with a large battery bank and roof panels can keep it going much longer. Weight is about 34 pounds for the unit and roughly 55 with the battery attached, and it vents through two hoses to a window kit. Be realistic about capacity. 6,100 BTU suits a teardrop, a small truck camper, a pop-up or a van, and the bedroom end of a larger trailer with the door closed. It will not replace a 13,500 BTU rooftop unit in a 25 foot travel trailer on a sunny afternoon. The cost per BTU is also far higher than any rooftop or window unit. What you are buying is silence and independence from shore power and generators, which, at a national park campground with strict quiet hours, can be exactly the point."
  },
  {
    "id": "zero-breeze-mark-3",
    "name": "Zero Breeze Mark 3",
    "category": "5,280 BTU Cooling, 1,022Wh Smart Battery, About 22 lb",
    "badge": "Lightest Battery AC",
    "amazonUrl": "#",
    "pros": [
      "About 22 pounds, light enough to carry into a tent or rooftop tent",
      "Rated 5,280 BTU of cooling and roughly 5,800 BTU of heat",
      "Battery charges from 12V to 60V DC, solar or wall",
      "Listed as quiet as 46 dB in its lowest mode",
      "Can run while charging, so solar or a car keeps it topped up"
    ],
    "cons": [
      "Battery uses lithium-ion polymer cells rather than LiFePO4",
      "Two to three hours per battery at full power"
    ],
    "bottomLine": "A smaller, lighter battery AC for teardrops, pop-ups and tents where every pound and every inch of floor counts.",
    "description": "The Zero Breeze Mark 3 covers much the same ground as the WAVE 3 in a smaller, lighter package, and in a teardrop or pop-up camper those inches and pounds matter. It is rated for 5,280 BTU of cooling and about 5,800 BTU of heat from a unit that weighs about 22 pounds and measures roughly 22 by 10 by 12 inches. The matching smart battery is rated at 1,022Wh and about 14 pounds, and it accepts 12V to 60V DC, so it can charge from a tow vehicle, a solar panel or a wall outlet, and the AC can run while it charges. Zero Breeze quotes two to three hours per battery in its strongest mode, where it draws 350 to 500 watts, and longer in eco modes. That lines up with the math: about 900 usable watt-hours at 400 watts is just over two hours. Many owners buy a second battery for overnight use. The Mark 3 lists a noise level as low as 46 dB, quieter than a rooftop unit and far quieter than a generator, which makes it a good neighbor at tight campgrounds. The trade-offs are capacity and chemistry. At 5,280 BTU it is a small-space air conditioner, best in a camper of 12 feet or less, a tent or a sleeping area. Its battery uses lithium-ion polymer cells rather than LiFePO4, which means fewer rated cycles and more care about storing it hot. If you want the most durable battery, choose the WAVE 3. If you want the lightest real AC to carry from the tow vehicle into a small camper, choose this."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Air Conditioner for Camper",
          item: "https://www.thehonestreviewers.com/best-air-conditioner-for-camper/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size air conditioner do I need for my camper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a rule of thumb, one 13,500 BTU rooftop unit covers rigs up to about 25 feet, a 15,000 BTU unit or two units suit 25 to 32 feet, and longer rigs need two units on 50 amp service. Teardrops and small trailers need only 5,000 to 8,000 BTU. Go up a size for hot climates and dark exteriors."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run my RV air conditioner on a 15 amp household outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes, but it is marginal. A 15 amp outlet supplies about 1,800 watts, and a 13,500 BTU rooftop unit draws around 1,500 running, plus a large startup surge. A dedicated 20 amp outlet, a short heavy cord and a soft starter help. A window or portable unit is the more reliable choice for driveway camping."
          }
        },
        {
          "@type": "Question",
          "name": "What size generator runs a camper air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Without a soft starter, plan on 3,000 to 3,500 watts for a 13,500 BTU rooftop unit with a few other loads. With a soft starter, many owners run one on a 2,200 watt inverter generator. Two rooftop units or a 15,000 BTU unit need 4,000 watts or more. Altitude reduces output by roughly 3.5% per 1,000 feet."
          }
        },
        {
          "@type": "Question",
          "name": "Is a portable AC good for a camper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A good one can be, especially in toy haulers, cargo trailers or as a supplement to an undersized rooftop unit. Choose a dual-hose or hose-in-hose model, compare SACC ratings and plan for window adapting and condensate. In small travel trailers, portables take too much floor space to be a great primary unit."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power station run an RV rooftop air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Large ones can for a few hours. A rooftop unit at about 1,500 watts empties a 5kWh battery in roughly three hours of continuous running, longer as the compressor cycles. You will usually need a soft starter for the surge. Smaller window or battery-portable units are far more practical when you want to run on batteries."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a regular window air conditioner in a camper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with a proper mount. Most camper windows are not designed for window units, so owners build a framed opening or panel, support the weight with an exterior bracket and seal it against rain. Remove or secure the unit before towing, because house window units are not built for road vibration."
          }
        },
        {
          "@type": "Question",
          "name": "What is a soft starter and do I need one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A soft starter is a small module installed in the AC that ramps the compressor up gradually and cuts its startup surge sharply. You need one if you run the AC from a generator, a power station, a household outlet, or 30 amp service with other loads. It does not reduce running draw, only the startup spike."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Fitness & Outdoor Gear",
    tags: [
      "portable ac for camper",
      "air conditioner for camper",
      "camper window air conditioner",
      "rv window ac unit",
      "rv portable ac",
      "portable ac unit for camping",
      "air con unit for motorhome"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Air Conditioner <span class="text-[#38BDF8]">for Your Camper</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven rooftop, window, portable and battery air conditioners for trailers, motorhomes and small campers, with the power math that decides which one you can actually run.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dometic-brisk-ii-13-5k"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Choose the Right Type
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our Top Picks</a>
          <a href="#which-type" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Type</a>
          <a href="#sizing-btu" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. BTU Sizing</a>
