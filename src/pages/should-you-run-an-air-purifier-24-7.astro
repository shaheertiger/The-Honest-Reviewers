const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Should You Run an Air Purifier 24/7",
          item: "https://www.thehonestreviewers.com/should-you-run-an-air-purifier-24-7/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is it bad to leave an air purifier on all the time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Air purifiers are designed for continuous use, and running one nonstop is how they deliver the most benefit. The only real downsides are faster filter wear and a few dollars a month in electricity. Make sure it carries a recognized safety certification, keep clearance around the vents, and switch off any ozone-producing ionizer feature."
          }
        },
        {
          "@type": "Question",
          "name": "How many hours a day should I run an air purifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ideally all of them. If you must limit it, prioritize the hours you are in the room, especially overnight in the bedroom, and start it 30 to 60 minutes before you arrive so the air is already clean. A few hours a day gives only a few hours of benefit, because particle levels rise again soon after it stops."
          }
        },
        {
          "@type": "Question",
          "name": "Can I turn my air purifier off when I leave the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, and it saves a little electricity and filter life. The trade-off is coming home to air that has drifted back to normal levels. A better approach for most people is to leave it on auto, which drops to a low, cheap speed when nobody is stirring up dust. Pets at home are another reason to leave it running."
          }
        },
        {
          "@type": "Question",
          "name": "Will running an air purifier all night dry out the air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A filter-based air purifier only moves and filters air; it does not remove moisture the way a dehumidifier or air conditioner does. The air movement can feel slightly cooling, like a gentle fan, but humidity stays the same. If the air feels dry in winter, the cause is usually your heating, not the purifier."
          }
        },
        {
          "@type": "Question",
          "name": "Does running an air purifier 24/7 shorten its lifespan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A little, in the sense that the fan motor accumulates more hours, but purifier motors are built for continuous duty and usually outlast years of use. Filters are the part that wears, and they are meant to be replaced. Keep the intake clear, clean the pre-filter regularly, and the unit itself should last for years."
          }
        },
        {
          "@type": "Question",
          "name": "Should I run an air purifier with the windows open?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not on clean-air days. With windows wide open the purifier is effectively trying to filter the outdoors. Ventilate for a while with it low or off, then close up and run it. During wildfire smoke or high pollen, keep the windows shut and run the purifier on high instead, with doors closed to the rooms you use most."
          }
        },
        {
          "@type": "Question",
          "name": "Is it OK to run an air purifier and a humidifier at the same time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but keep them a few feet apart so the purifier does not pull in very humid air, and use distilled water in ultrasonic humidifiers to avoid mineral dust that the purifier then has to catch. Keep room humidity at or below about 50 percent, which helps prevent mold and dust mites."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
