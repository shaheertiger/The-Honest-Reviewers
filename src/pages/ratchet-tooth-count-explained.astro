      mainEntity: [
        {
          "@type": "Question",
          "name": "What does ratchet tooth count mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is the number of teeth on the gear inside the ratchet head, and it sets how far you must swing the handle before the pawl catches the next tooth. Divide 360 by the tooth count to get the swing arc: 72 teeth need 5 degrees, 90 teeth need 4, 36 teeth need 10."
          }
