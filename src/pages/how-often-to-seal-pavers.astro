---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Wet Look Paver Sealers",
    "url": "/best-paver-sealers-for-a-wet-look/"
  },
  {
    "title": "Do Pavers Need to Be Sealed?",
    "url": "/do-pavers-need-to-be-sealed/"
  },
  {
    "title": "How to Seal Pavers",
    "url": "/how-to-seal-pavers/"
  },
  {
    "title": "Why Paver Sealer Turns White",
    "url": "/why-paver-sealer-turns-white/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-18", modified: "2026-09-18" });
const title = "How Often to Seal Pavers: The Water Test Beats Any Schedule";
const description =
  "Two to five years depending on sealer type and exposure, but the surface tells you better than the calendar. The water test, what shortens the interval, and film build-up.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Often to Seal Pavers",
          item: "https://www.thehonestreviewers.com/how-often-to-seal-pavers/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How often should pavers be sealed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every two to five years for film sealers and three to seven for penetrating ones, depending heavily on sun exposure, traffic and climate. Driveways sit at the short end because turning tyres are hard on a film. Rather than following a calendar, run the water test twice a year and reseal when it fails in the traffic areas."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know when to reseal my pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour a cup of water on the surface in several spots. If it beads and sits, the sealer is working. If it spreads, soaks in and darkens the paver within a minute, that area has lost protection. Other signs are faded colour, visible sheen differences along traffic paths, joint sand moving again, and spills starting to stain."
          }
        },
        {
          "@type": "Question",
          "name": "Can you seal pavers too often?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it causes a real problem. Each film coat adds thickness, so recoating every cycle without ever stripping builds up a layer that eventually looks like plastic over stone, traps moisture more readily and peels in sheets. Apply thinner coats on reseals and plan a strip every third or fourth cycle."
          }
        },
        {
          "@type": "Question",
          "name": "How long does paver sealer last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Water-based acrylics typically two to four years, solvent-based three to five, and penetrating siloxanes four to seven, with every figure roughly halving on a driveway. Full sun, vehicle traffic, freeze-thaw cycling, de-icing salt and aggressive pressure washing all shorten it considerably."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to strip the old sealer before resealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not if the existing film is thin, sound, simply worn, and the same chemistry as what you are applying. You must strip if it is peeling, cloudy, visibly built up, or if you are changing product type or do not know what is on there. If unsure, test the new sealer on a hidden square foot and let it cure for several days."
          }
        },
        {
          "@type": "Question",
          "name": "Does a penetrating sealer need resealing as often?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Less often, typically every four to seven years, and it has no build-up problem because it depletes rather than accumulating. Note that water beading can fade while stain resistance remains, so on a penetrating sealer the water test is an early warning rather than a deadline; the practical test is whether spills still wipe up."
          }
        },
        {
          "@type": "Question",
          "name": "Should I reseal the whole patio or just worn areas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whole patio, in nearly every case. Spot-resealing leaves a visible difference in sheen between new and old areas that is more obvious than the wear you were fixing. The exception is a genuinely separate zone, such as a driveway apron or a set of steps, which can reasonably be treated on its own cycle."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
