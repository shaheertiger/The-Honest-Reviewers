  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Clean a Deck",
          item: "https://www.thehonestreviewers.com/how-to-clean-a-deck/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best thing to clean a deck with?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most decks, a percarbonate (oxygen bleach) cleaner. It lifts grey, dirt and mildew without damaging wood fibres or killing nearby planting, and it is the base of most commercial deck cleaners. Reach for a sodium hypochlorite product only for heavy black mould, and for a dedicated stripper only when an old film finish has to come off.",
          },
        },
        {
          "@type": "Question",
          name: "How do you clean a deck before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sweep, clear the gaps between boards, wet the deck and surrounding plants, apply a percarbonate cleaner and let it dwell 10 to 15 minutes without drying out, scrub with a stiff brush, rinse thoroughly, then apply a wood brightener and rinse again. Allow 24 to 48 hours of drying before any stain goes on, and confirm with a water-drop test rather than by eye.",
          },
        },
        {
          "@type": "Question",
          name: "Can you clean a deck with just a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can remove dirt that way, but not mildew spores or the grey oxidised layer, and pressure alone tends to fur the wood surface. The cleaner does the chemical work and the washer only rinses it away. If you do use one, stay at 500 to 1,200 psi on softwood with a 25 or 40 degree tip held 10 to 12 inches back and keep it moving with the grain.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need a brightener after cleaning a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Before staining, yes. Deck cleaners are alkaline and leave the wood surface alkaline and slightly darkened, which reduces how much stain the wood will accept. An oxalic acid brightener neutralises that, restores the colour and opens the grain, and it is the step most often skipped by people whose stain later looks blotchy.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a deck dry after cleaning before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Two full days in warm, dry, breezy weather and up to four in humid conditions or heavy shade. The reliable test is to sprinkle water on several boards: if it soaks straight in and darkens the wood, the deck is ready; if it beads or sits, there is still moisture in the surface and stain applied now will not penetrate.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use bleach to clean a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Household chlorine bleach kills mildew but also breaks down lignin in the wood, leaves fibres furry, corrodes fasteners over time and damages planting it runs into. It is a reasonable spot treatment for heavy black mould, diluted and rinsed hard, but percarbonate cleaners do the same job across a whole deck with none of the collateral damage.",
          },
        },
        {
          "@type": "Question",
          name: "How do you clean a composite deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "With a composite-safe cleaner, a soft brush and plenty of rinsing. Most manufacturers cap pressure washing at around 1,500 psi with a wide fan, and erosion marks on composite are permanent because there is no grain to sand back. Black spotting is usually surface mould feeding on debris in the embossed grain rather than damage to the board.",
          },
        },
        {
          "@type": "Question",
          name: "How often should you clean a deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A full wash once a year, ideally in spring, plus sweeping and clearing the gaps between boards through the season. That annual hour measurably extends the life of whatever finish is on the deck, because pollen, dirt and early mildew sitting on a coating shorten it.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
