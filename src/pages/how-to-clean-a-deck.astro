    { title: "Deck Brightener vs Deck Cleaner", url: "/deck-brightener-vs-deck-cleaner/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "How to Clean a Deck (Before Staining, or Just Because)";
const description =
  "Which cleaner to use for grey, green or black, how to pressure wash without furring the wood, and why the brightener step matters more than the cleaning.";

