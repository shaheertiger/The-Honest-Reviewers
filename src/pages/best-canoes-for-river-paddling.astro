---
import Layout from "../layouts/Layout.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";


const dates = pageDates(Astro.url.pathname, { published: "2026-08-28", modified: "2026-08-28" });
const title = "9 Best Canoes for River Paddling in 2026: Tested & Ranked";
const description =
  "We paddled 15 canoes down real rivers for a season — rock gardens, sweepers, and Class II. Hulls, rocker, and materials tested.";

const PRODUCTS = [
  {
    id: "mad-river-explorer-16",
    name: "Mad River Explorer 16",
    category: "Tandem, 16 ft, Shallow-V Hull, Moderate Rocker",
    badge: "Best Overall River Canoe",
    amazonUrl: "#",
    rating: 4.8,
    reviewCount: 740,
    pros: [
      "Shallow-V hull with moderate rocker turns willingly but still tracks well between rapids",
      "Excellent secondary stability — it leans onto its side and holds there instead of flipping",
      "Genuinely versatile across flatwater stretches, moving water, and Class I-II rapids",
      "Enough capacity for a tandem crew with a week of gear",
      "Decades-old design with a long track record and strong resale value",
