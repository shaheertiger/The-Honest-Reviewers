                    <td class="px-4 py-4 text-gray-700">Which breaker feeds this circuit?</td>
                    <td class="px-4 py-4 text-gray-700">Is voltage present here?</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Needs circuit live?</td>
                    <td class="px-4 py-4 text-gray-700">Yes (most models)</td>
                    <td class="px-4 py-4 text-gray-700">Yes, by definition</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Works through panel cover?</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Not for this purpose</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Typical price</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                  </tr>
