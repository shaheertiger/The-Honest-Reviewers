const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Generator Continuous Runtime",
          item: "https://www.thehonestreviewers.com/how-long-can-a-generator-run-continuously/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How long can a generator run continuously?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fuel typically limits a portable to 8 to 12 hours at half load, and most manufacturers advise shutting down and letting the engine cool at least once every 24 hours so the oil can be checked. Liquid-cooled standby generators are a different class and are designed to run for days or weeks with periodic maintenance."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a generator 24 hours a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can run through a 24-hour period, but plan a shutdown within it for cooling and an oil check rather than treating it as a continuous machine. In a multi-day outage, running in six to eight hour blocks keeps food safe on far less fuel, extends the oil interval and gives the engine cooling time."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to change the oil during a long outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quite possibly. Intervals are specified in running hours, commonly 50 to 200 depending on engine, with a much shorter first change at 20 to 30 hours during break-in. Running eight hours a day reaches a 50-hour interval within a week. Keep two changes' worth of oil and a drain pan with the generator."
          }
        },
        {
          "@type": "Question",
          "name": "Can you refuel a generator while it's running?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a gasoline one, ever. Petrol on a hot muffler ignites and this is a leading cause of generator fires. Shut down and let it cool for several minutes. Propane and natural gas units are different: a changeover regulator or a house gas connection lets fuel continue without stopping the engine, with no open fuel handling."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a generator run on a 20 lb propane tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly 6 to 9 hours at half load on a typical portable, and 10 to 14 at quarter load. Propane is slightly less energy dense than gasoline so you lose around ten percent of runtime for the same volume, but it stores indefinitely without stabiliser and tanks can be swapped without shutting the engine down."
          }
        },
        {
          "@type": "Question",
          "name": "Is it bad to run a generator at full load continuously?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, over extended periods. Rated output is generally a peak rather than a continuous figure, which is why generators quote separate starting and running watts. Sitting at 50 to 75 percent of running watts is comfortable for an engine; holding 100 percent for days accelerates wear on both the engine and the alternator."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if a generator runs out of oil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most modern units have a low-oil shutdown that stops the engine to protect it, which saves the generator but means your power disappears without warning, quite possibly overnight. Without that sensor, running low destroys the engine. Either way, checking the level at every refuel is the habit that prevents it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
