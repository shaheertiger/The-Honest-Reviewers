---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 12,000 Watt Generators",
    "url": "/best-12000-watt-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Dual Fuel Generators",
    "url": "/best-dual-fuel-generator/"
  },
  {
    "title": "What Size Generator Runs Central Air?",
    "url": "/what-size-generator-runs-central-air-conditioning/"
  },
  {
    "title": "Generator Transfer Switch Types and Cost",
    "url": "/generator-transfer-switch-types-cost-and-installation/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 10,000 Watt Generators in 2026: What 10kW Actually Runs";
const description =
  "Five 10,000 watt generators sized by what they really run: a 240V well pump, central AC with a soft starter, a dryer, plus 30A vs 50A outlets and fuel burn.";

const PRODUCTS = [
  {
    "id": "champion-201417",
    "name": "Champion 201417 11,000-Watt Dual Fuel Inverter",
    "category": "Dual Fuel Inverter, 9,000W Running",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "9,000 running watts on gasoline and 8,100 on propane, with 11,000 starting watts on both fuels",
      "Inverter output with a 64 dBA noise rating, quieter than open-frame units of the same size",
      "120/240V 14-50R outlet rated at 37.5A plus an L14-30R, so it feeds either a 30A or 50A inlet",
      "Rated for up to 15 hours at quarter load on a 6.08-gallon tank, 8 hours on a 20 lb propane cylinder",
      "CO Shield automatic shutoff and a 3-year limited warranty"
    ],
    "cons": [
      "Around 205 lb, so it rolls on wheels and never gets lifted",
      "Not parallel-capable, and it costs roughly twice an open-frame generator with similar running watts"
    ],
    "bottomLine": "The 10kW generator to buy if it will run near the house for days at a time. Inverter-quiet, clean enough for furnace boards and electronics, and it runs a 240V well pump without drama.",
    "description": "Champion's 201417 is the generator that makes the 10,000 watt class livable. Its spec sheet lists 11,000 starting watts on gasoline and propane, 9,000 running watts on gas and 8,100 on propane, which puts it at the top of this class on usable power. Because it is an inverter, the output is suitable for furnace control boards, refrigerators with electronic controls and computers without the voltage wobble an open-frame unit can show under changing loads. Champion rates it at 64 dBA, noticeably quieter than the 72 to 74 dBA typical of open-frame 10kW machines, and in practice that is the difference between hearing it through a closed bedroom window and not. The panel is built for home backup: two 5-20R GFCI duplexes, an L14-30R, and a 14-50R rated at 37.5 amps, so it can feed a 50-amp power inlet and carry its full 9,000 running watts into the panel rather than being capped at 7,200 by a 30-amp cord. Runtime is rated at up to 15 hours at quarter load on the 6.08-gallon tank and 8 hours on a 20 lb propane cylinder. The downsides are weight, about 205 lb, and price. It is not parallel-capable either. If you want the most refined 10kW portable and will run it for multi-day outages, this is the one."
  },
  {
    "id": "duromax-xp11000ih",
    "name": "DuroMax XP11000iH",
    "category": "Dual Fuel Inverter, 9,000W Running",
    "badge": "Best Inverter for Parallel Expansion",
    "amazonUrl": "#",
    "pros": [
      "9,000 running watts on gasoline and 8,550 on propane, the smallest propane derate in this group",
      "Rated 61 dB at quarter load, the quietest figure published for any pick here",
      "Up to 18 hours at quarter load and 9 hours at half load on a 7.1-gallon tank",
      "Two units can be paralleled for 18,000 running watts with a kit sold separately",
      "120/240V with 14-50R and L14-30R outlets, plus remote electric start and CO Alert shutdown"
    ],
    "cons": [
      "Listed around 216 lb dry, the heaviest inverter here",
      "Parallel kit costs extra, and two units is a big investment"
    ],
    "bottomLine": "The best 10,000 watt inverter generator for propane users and for anyone who might want to double up later. Quiet, long-running and only a small step down on LP.",
    "description": "The XP11000iH is DuroMax's answer to the Champion, and it wins on two specific points. First, propane: DuroMax rates it at 9,000 running watts on gasoline and 8,550 on propane, so it gives up only about 5 percent on LP where most generators lose 10 percent or more. If you plan to run on propane cylinders because gasoline storage is a nuisance, that extra headroom is real. Second, expansion: two XP11000iH units can be paralleled for 22,000 peak and 18,000 running watts with a kit sold separately, which turns a 10kW purchase into a path toward near-whole-house output later. DuroMax lists 61 dB at quarter load, the lowest published noise figure in this group, and rated runtime of up to 18 hours at quarter load and 9 hours at half load on the 7.1-gallon tank. The panel carries 120/240V output through a 14-50R and an L14-30R alongside 5-20R household outlets, and remote electric start means you can fire it from the doorway in a storm. CO Alert shuts it down if carbon monoxide builds up. The trade-off is mass: listings put it around 216 lb dry, and it is a roll-in-place machine. Owners commonly praise how quiet it is for the size. For propane-first households it is the pick."
  },
  {
    "id": "westinghouse-igen12000dfc",
    "name": "Westinghouse iGen12000DFc",
    "category": "Dual Fuel Inverter, 9,000W Running",
    "badge": "Lightest 10kW-Class Inverter",
    "amazonUrl": "#",
    "pros": [
      "9,000 running watts on gasoline and 8,100 on propane despite the 12,000 peak label",
      "189 lb dry, the lightest unit in this group",
      "Rated for 19 hours at quarter load and 11 hours at half load on a 7.9-gallon tank",
      "Transfer-switch ready with 14-50R and L14-30R outlets, remote start and a CO sensor",
      "Parallel-capable with Westinghouse 240V inverter models"
    ],
    "cons": [
      "Only one 120V 5-20R duplex on the panel, so you will want an inlet or a distribution cord",
      "The 12,000 peak label overstates its class; plan around 9,000 running watts"
    ],
    "bottomLine": "A 10kW-class inverter sold under a 12,000 peak label. The longest rated runtime and lowest weight here, as long as you size it by its 9,000 running watts.",
    "description": "Do not let the name push this into the wrong size bracket. Westinghouse sells the iGen12000DFc on its 12,000 peak watts, but its rated running output is 9,000 watts on gasoline and 8,100 on propane, which makes it a direct competitor to the Champion and DuroMax inverters rather than a step up from them. Judged as a 10kW-class machine it has two clear advantages. It is the lightest unit here at 189 lb dry, and it has the longest rated runtime: 19 hours at quarter load and 11 hours at half load from a 7.9-gallon tank, or 9 and 5 hours respectively on a 20 lb propane cylinder. Westinghouse rates it as low as 64 dBA. The panel is set up for a transfer switch or inlet, with a 14-50R and an L14-30R at 120/240V, but only a single 120V 5-20R GFCI duplex, so it is less convenient for running a handful of extension cords directly. Remote start, a CO sensor, and parallel capability with other Westinghouse 240V inverters round it out, and the warranty is 3 years residential. Buy it if you are wiring it into the house through an inlet and want the longest overnight runtime in the class; skip it if you mostly plug appliances straight into the generator."
  },
  {
    "id": "champion-201423",
    "name": "Champion 201423 11,000-Watt Tri Fuel Inverter",
    "category": "Tri Fuel Inverter, 9,000W Running",
    "badge": "Best for Natural Gas Hookup",
    "amazonUrl": "#",
    "pros": [
      "Runs on gasoline, propane or natural gas: 9,000, 8,100 and 7,290 running watts respectively",
      "11,000 starting watts on all three fuels",
      "Wireless remote start and Champion's cold start technology",
      "Rated under 3 percent total harmonic distortion and 64 dBA",
      "120/240V 50A and 30A outlets for an inlet or transfer switch"
    ],
    "cons": [
      "Natural gas running output drops to 7,290 watts, closer to a 7,500W generator",
      "One retailer lists it as discontinued, so stock and pricing can be patchy"
    ],
    "bottomLine": "The 10kW-class choice for a house that already has a natural gas line. Accept the lower NG rating and you never refuel during a long outage.",
    "description": "The 201423 is essentially the tri-fuel, remote-start sibling of our top pick, and it exists for one buyer: the household that already has a natural gas service and wants a portable that can be plumbed to it. Champion rates it at 11,000 starting watts on every fuel, with 9,000 running watts on gasoline, 8,100 on propane and 7,290 on natural gas. That last number is the honest cost of the convenience. Natural gas has less energy per cubic foot than propane, and the generator loses almost a fifth of its gasoline output on it, which puts its NG rating closer to a large 7,500 watt generator than to a true 10kW. What you get in return is unlimited runtime from a properly installed gas connection, with no cans, no stale fuel and no 3 a.m. refills. Champion rates runtime at up to 15 hours on gasoline and 8 hours on a 20 lb propane cylinder, with total harmonic distortion under 3 percent and a 64 dBA noise rating. Wireless remote start and cold start technology make winter starts easier. A natural gas connection needs a licensed plumber and usually a quick-connect at the house, so factor that in. Availability varies by retailer, so check stock before planning around it."
  },
  {
    "id": "generac-gp8000e-8929",
    "name": "Generac GP8000E 8929",
    "category": "Gasoline Open Frame, 8,000W Running",
    "badge": "Best Generac 10,000 Watt",
    "amazonUrl": "#",
    "pros": [
      "10,000 starting and 8,000 running watts at 120/240V from Generac's GP series",
      "Rated for about 12 hours at half load on gasoline",
      "COsense carbon monoxide shutdown and 50-state emissions compliance",
      "Generac's dealer and parts network is the largest in residential generators",
      "Usually the least expensive way into a name-brand 10kW unit"
    ],
    "cons": [
      "Only a 30A L14-30R for 240V, which caps transfer-switch power at 7,200 watts",
      "Gasoline only, and Generac says GP series units exceed 5 percent THD"
    ],
    "bottomLine": "The 10,000 watt Generac most people mean. Fine for a 30-amp inlet and a well pump, but its single 30A outlet means you will never get all 8,000 watts into the panel.",
    "description": "When people search for a Generac 10,000 watt generator, this is usually the machine they find: the GP8000E, sold in the 50-state configuration as model 8929. Generac's spec sheet lists 8,000 running and 10,000 starting watts at 120/240V, and Generac rates it for about 12 hours at half load on gasoline. COsense shuts the engine down if carbon monoxide builds up, and the brand's dealer and parts network is the deepest in residential power, which matters ten years from now when you need a carburetor or a recoil. The limits are specific and worth understanding before you buy. It runs on gasoline only, so there is no propane option for long-term fuel storage. Its 240V output comes through a single 30-amp L14-30R twist-lock, plus two 5-20R GFCI duplexes, and there is no 50-amp outlet. A 30-amp, 240V circuit carries at most 7,200 watts, so through a standard inlet and transfer switch you can never use the full 8,000 running watts. And Generac's own support answers note that GP series generators run above 5 percent total harmonic distortion. Owners commonly run furnaces and refrigerators on GP units without trouble, but if clean power matters, one of the inverters above is the safer buy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 10,000 Watt Generators",
          item: "https://www.thehonestreviewers.com/best-10000-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will a 10,000 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With 8,000 to 9,000 running watts, it runs a refrigerator, freezer, gas furnace, 1 HP 240V well pump, sump pump, lights, internet and a microwave together with margin to spare. It can also run one big 240V load, such as an electric dryer or water heater, alongside essentials. Central air usually needs a soft starter on the compressor."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 10,000 watt generator run a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It runs most of a typical house, but not everything at once. Essentials plus one large appliance fit comfortably. A home with central air, an electric range, a dryer and an electric water heater running simultaneously needs more. Treat 10kW as near-normal living with the big 240V loads taken in turns."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 10,000 watt generator run central air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes a two-ton system with little else running, but a three-ton unit can surge to 9,000 to 12,000 watts and will usually stall it. A soft starter fitted to the condenser commonly cuts that surge to 3,000 to 5,000 watts, which makes central air practical on every 9,000 running-watt pick in this guide."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a 10,000 watt inverter generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Champion 201417, DuroMax XP11000iH, Westinghouse iGen12000DFc and Champion 201423 are all inverter generators with about 9,000 running watts on gasoline and 120/240V output. They cost more than open-frame units but run quieter, burn less fuel at light loads and produce cleaner power for electronics."
          }
        },
        {
          "@type": "Question",
          "name": "How much fuel does a 10,000 watt generator use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Based on manufacturers' runtime ratings, roughly 0.4 gallons per hour at quarter load on an inverter and 0.7 to 0.8 gallons per hour at half load. At a mixed outage load expect about 10 to 15 gallons of gasoline per day. On propane, a 20 lb cylinder lasts roughly 5 to 8 hours."
          }
        },
        {
          "@type": "Question",
          "name": "Does Generac make a 10,000 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Generac GP8000E, sold in 50-state form as model 8929, is rated at 10,000 starting and 8,000 running watts. It is gasoline-only and its 240V output is a 30-amp L14-30R, which limits what it can feed through a transfer switch to 7,200 watts. Generac's standby generators cover larger home backup needs."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 50 amp outlet on a 10,000 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you are connecting it to the house through an inlet and transfer switch, yes. A 30-amp, 240V connection tops out at 7,200 watts, below the 8,000 to 9,000 running watts this class produces. A 14-50R outlet and a 50-amp inlet let you use the generator's full capacity."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "10000 watt generator",
      "10000w generator",
      "10000 watt inverter generator",
      "generac 10000 watt generator",
      "electric generator 10000 watt",
      "dual fuel generator",
      "home backup generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">10,000 Watt</span> Generators
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A 10,000 watt generator is really an 8,000 to 9,000 running-watt machine. That is enough for a 240V well pump, a fridge, a freezer and a furnace together, and for central air only with help. Here is what each pick actually delivers.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-201417"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#what-10kw-runs"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What 10kW Really Runs
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-10kw-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 10kW Actually Runs</a>
          <a href="#peak-vs-running" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Peak vs Running Watts</a>
          <a href="#well-pump" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. 240V Well Pumps</a>
          <a href="#central-air" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Central Air and Soft Starters</a>
          <a href="#big-240v-loads" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Dryers, Ranges, Water Heaters</a>
          <a href="#30a-vs-50a" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. 30A vs 50A Outlets</a>
          <a href="#fuel-burn" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Fuel Burn and Runtime</a>
          <a href="#inverter-or-open-frame" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Inverter or Open Frame</a>
          <a href="#right-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Is 10kW the Right Size?</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The number on the box is the starting surge, not the power you live on. Every generator sold as a 10,000 watt unit runs on 8,000 to 9,000 watts, loses roughly a tenth of that on propane, and can only push 7,200 watts through a 30-amp cord. Buy for the running number and the outlet, and a 10kW portable covers almost everything except an unassisted central air conditioner.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Our Top 10,000 Watt Generator Picks
          </h2>

          <p>
            We compared rated running and starting watts on each fuel, the 120/240V outlet panel, rated runtime, tank size, weight, noise ratings where the manufacturer publishes one, and widely reported owner experience. We did not bench-test these units; every figure below comes from the manufacturer's spec sheet or listing. All five deliver 8,000 to 9,000 running watts on gasoline and 120/240V output, which is the real definition of this class regardless of the peak number printed on the side. Four of the five carry a 50-amp 14-50R outlet. The Generac does not, and we explain below why that matters more than most buyers expect.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
