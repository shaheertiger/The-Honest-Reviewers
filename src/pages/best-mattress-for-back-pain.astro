import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Mattress",
    "url": "/best-mattress/"
  },
  {
    "title": "Best Mattress for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattress for Heavy People",
    "url": "/best-mattress-for-heavy-people/"
  },
  {
    "title": "Best Mattress Topper",
    "url": "/best-mattress-topper/"
  },
  {
    "title": "Best Mattress Brands",
    "url": "/best-mattress-brands/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "7 Best Mattresses for Back Pain in 2026: Zoning and Firmness";
const description =
  "The best mattress for back pain and lower back pain, compared on medium-firm vs firm feel, zoned lumbar support, sleep position and when a topper is enough.";

const PRODUCTS = [
  {
    "id": "nolah-evolution-15",
    "name": "Nolah Evolution 15 Hybrid Mattress (Luxury Firm)",
    "category": "15-Inch Hybrid, Three-Zone Coils, Plush / Luxury Firm / Firm",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "The Amazon listing describes HDMax Tri-Zone coils with a dedicated lumbar support region",
      "Three firmness choices, so you can match the feel to your sleep position",
      "Seven layers over 8-inch individually wrapped coils, per the listing",
      "Reinforced perimeter coils listed for edge support",
      "Graphite-infused AirFoamICE comfort layer and Euro topper marketed for cooling"
    ],
    "cons": [
      "Among the more expensive beds here",
      "At 15 inches it needs deep-pocket sheets",
      "Reviewers rate the Luxury Firm closer to medium than its name suggests"
    ],
    "bottomLine": "The best all-round mattress for back pain if you want zoned lumbar support and a medium-firm feel without giving up pressure relief.",
    "description": "The Evolution 15 is our first pick for back pain because it combines the two features that most often help people with a sore lower back: a medium-firm surface and zoned support underneath it. The Amazon listing describes HDMax Tri-Zone coils split into three support zones, including a firmer lumbar region, so the middle of the bed pushes back a little harder where the hips and lower back are heaviest while the shoulder zone gives more. That is the whole idea behind zoning, and it is why many back sleepers prefer it to a uniformly firm bed. Above the coils sit seven layers in total, with a graphite-infused foam and a Euro topper that Nolah markets for cooling. The model comes in Plush, Luxury Firm and Firm. For most people with back pain the Luxury Firm is the right starting point; reviewers place it around medium to medium-firm. Back and stomach sleepers over about 230 pounds should step up to the Firm, which reviewers rate near 7 to 8 out of 10. The trade-offs are price and height: this is a premium hybrid, and its 15-inch profile needs deep-pocket sheets. If your budget is under half of this, the Brooklyn Bedding Signature Hybrid below gets you most of the support for much less."
  },
  {
    "id": "helix-dawn-luxe",
    "name": "Helix Dawn Luxe Hybrid Mattress",
    "category": "13.5-Inch Firm Hybrid, Zoned Lumbar Coils, Pillow Top",
    "badge": "Best Firm for Back Pain",
    "amazonUrl": "#",
    "pros": [
      "The Amazon listing rates it 8 to 9 on a 10-point firmness scale",
      "Zoned lumbar coils, softer under the shoulders and firmer under the hips",
      "Quilted pillow top takes the edge off a firm feel",
      "GREENGUARD Gold certified, fiberglass-free, CertiPUR-US foams per the listing",
      "Optional GlacioTex cooling cover version"
    ],
    "cons": [
      "Too firm for most side sleepers",
      "Lighter back sleepers may find the hips do not sink in enough",
      "Listings disagree on coil count by size; check the one you buy"
    ],
    "bottomLine": "The pick for back and stomach sleepers who already know they want a firm bed, with zoning so firm does not mean flat.",
    "description": "Some people with lower back pain sleep better on a genuinely firm mattress, especially stomach sleepers and heavier back sleepers whose hips sink too far on softer beds. The Dawn Luxe is built for them. The Amazon listing puts it at 8 to 9 on a 10-point firmness scale, which makes it the firmest bed on this list, and Helix pairs that firmness with zoned lumbar coils. Reviewers describe the result as slightly softer under the shoulders and firmer under the hips, which matters because a uniformly firm slab can push the shoulders up and leave a gap at the waist. A quilted pillow top adds a thin layer of cushion so the first impression is not hard. The mattress is 13.5 inches tall, and the listing says it is GREENGUARD Gold certified, fiberglass-free and made with CertiPUR-US certified foams. There is a GlacioTex version with a cool-to-the-touch cover if you sleep hot. The trade-off is that this bed is narrow in who it suits. Side sleepers will feel it at the shoulder and hip, and lighter back sleepers under about 130 pounds may find their hips never settle in. If you are not sure which camp you are in, the Nolah Evolution 15 in Luxury Firm or the Helix Midnight Luxe is a safer choice."
  },
  {
    "id": "helix-midnight-luxe",
    "name": "Helix Midnight Luxe Hybrid Mattress",
    "category": "13.5-Inch Medium Hybrid, Zoned Lumbar Support, Euro Top",
    "badge": "Best for Side Sleepers With Back Pain",
    "amazonUrl": "#",
    "pros": [
      "Zoned lumbar support with softer zones under the shoulders",
      "The Amazon listing rates it a 6 out of 10, a medium feel",
      "Quilted Euro top for shoulder and hip pressure relief",
      "Pocketed coils keep it supportive and easy to move on",
      "Assembled in Arizona with GREENGUARD Gold certification, per the listing"
    ],
    "cons": [
      "Reviewers say it may feel too soft for sleepers over about 250 pounds",
      "Stomach sleepers should look at the Dawn Luxe instead",
      "Trial terms differ between Amazon listings"
    ],
    "bottomLine": "The best mattress for side sleepers with lower back pain: soft enough at the shoulder, zoned so the waist stays supported.",
    "description": "Side sleepers with back pain have a harder problem than back sleepers, because the bed has to do two things at once. It needs to be soft enough at the shoulder and hip that those points sink in, and supportive enough at the waist that the spine does not sag into a curve. The Midnight Luxe is Helix's answer. The Amazon listing describes it as a 6 out of 10 on firmness and aims it at side sleepers and couples, and Helix builds zoned lumbar support into the coil unit so the middle third of the bed is firmer than the ends. Reviewers describe the feel as medium-firm with real give at the surface, which is what most side sleepers with a sore lower back say they want. It is 13.5 inches tall with a quilted Euro top over pocketed coils, so it is easier to change position on than an all-foam bed. The listing says it is assembled in Arizona, GREENGUARD Gold certified and fiberglass-free. The trade-off is weight range: reviewers note that sleepers over roughly 250 pounds and stomach sleepers may find it too soft, and for them the Dawn Luxe or a heavy-duty bed is the better call. Back sleepers who like a softer feel will be happy on it too."
  },
  {
    "id": "brooklyn-bedding-signature-hybrid",
    "name": "Brooklyn Bedding Signature Hybrid Mattress",
    "category": "13.25-Inch Hybrid, Soft / Medium / Firm, 8-Inch Coils",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Sold in Soft, Medium and Firm, with Firm aimed at back and stomach sleepers",
      "8-inch Ascension X coil core with up to 760 individually encased coils, per the maker",
      "About 3.5 inches of comfort foam over the coils",
      "365-night trial and limited lifetime warranty listed by the maker",
      "Optional 14-inch Cloud Pillow Top version"
