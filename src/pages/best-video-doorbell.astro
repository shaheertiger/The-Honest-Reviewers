---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Security Cameras",
    "url": "/best-home-security-cameras/"
  },
  {
    "title": "Best Smart Locks",
    "url": "/best-smart-lock/"
  },
  {
    "title": "Home Improvement Ideas",
    "url": "/home-improvement-ideas/"
  },
  {
    "title": "Best Garage Door Openers",
    "url": "/best-garage-door-opener/"
  },
  {
    "title": "Best Circuit Breaker Finders",
    "url": "/best-circuit-breaker-finder/"
  },
  {
    "title": "Best Stud Finders",
    "url": "/best-stud-finder/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-30", modified: "2026-10-30" });
const title = "7 Best Video Doorbells in 2026: Ranked by Who Should Buy Which";
const description =
  "Seven video doorbells ranked by who should buy which: Ring, Nest, Eufy, Arlo, Wyze and Aqara compared on power, storage fees, privacy and smart-home fit.";

const PRODUCTS = [
  {
    "id": "ring-battery-video-doorbell-plus",
    "name": "Ring Battery Video Doorbell Plus",
    "category": "Battery or Wired, Head-to-Toe View",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Head-to-toe video, which the manufacturer specifies as a taller view that keeps packages on the step in frame",
      "Runs on a rechargeable battery or on existing doorbell wiring, so one model suits most doors",
      "Enormous owner base means abundant mounting accessories, chimes and third-party integrations",
      "Works with Alexa for announcements on Echo speakers and live video on Echo Show displays",
      "Simple setup through the Ring app that most first-time buyers find approachable"
    ],
    "cons": [
      "Saved video history and several smart alerts depend on a Ring Protect plan, so check the current plan terms",
      "Battery life varies with how busy your front door is, and winter weather tends to shorten it"
    ],
    "bottomLine": "The safest default for most households: flexible power, a view that covers the step, and the widest ecosystem of any doorbell on this list.",
    "description": "If you want one doorbell that fits most front doors without much thought, the Ring Battery Video Doorbell Plus is the place to start. It can run on its rechargeable battery for a no-wiring install or be connected to existing doorbell wiring to keep the battery topped up, which means the same model works for a renter and for an owner with a working bell. Ring specifies a head-to-toe view that shows a visitor and anything left at their feet, which addresses the most common complaint about older doorbells. The real attraction is the ecosystem: Alexa integration, a large pool of accessories and a mature app. The cost of that convenience is the subscription, since saved clips and some features sit behind a Ring Protect plan whose terms change, so verify them before you buy."
  },
  {
    "id": "ring-wired-doorbell-plus",
    "name": "Ring Wired Doorbell Plus",
    "category": "Hardwired, Head-to-Toe View",
    "badge": "Best Wired Pick",
    "amazonUrl": "#",
    "pros": [
      "Runs continuously on existing doorbell wiring, so there is never a battery to recharge",
      "Taller head-to-toe view as specified by Ring, suited to catching package drops",
      "Compact body that fits narrow door frames better than many larger doorbells",
      "Same Ring app and Alexa integration as the battery model"
    ],
    "cons": [
      "Requires working doorbell wiring and a compatible transformer, so it is not for renters without wiring",
      "Saved video and some alerts sit behind a Ring Protect plan, so check the current plan terms"
    ],
    "bottomLine": "The right choice if you own your home, have a working bell and never want to think about charging a doorbell again.",
    "description": "The Ring Wired Doorbell Plus is the straightforward answer for homeowners who already have a doorbell button and chime. Because it draws power from the existing low-voltage circuit, you skip the battery cycle entirely, which removes the most common reason a doorbell fails to record. Ring specifies the same taller head-to-toe view as its battery sibling and the same app, so you get the identical day-to-day experience with less upkeep. The compact housing is a quiet advantage on slim trim or narrow door frames. The main requirement is compatible wiring and transformer, and the manufacturer lists the supported range, so check your transformer label first. As with other Ring products, saved clips depend on a plan whose terms you should confirm."
  },
  {
    "id": "google-nest-doorbell-2nd-gen",
    "name": "Google Nest Doorbell (2nd Gen)",
    "category": "Battery or Wired, Google Home",
    "badge": "Best for Google Home",
    "amazonUrl": "#",
    "pros": [
      "Tall portrait-style frame is designed to show a visitor and a package in the same view",
      "Can be wired or run on its battery, depending on how your door is set up",
      "Deep integration with Google Home, with announcements on Nest speakers and video on Nest displays",
      "Clean app with straightforward event history and activity zones"
    ],
    "cons": [
      "Smarter features such as familiar-face alerts and longer history require a Nest Aware plan, so check the current terms",
      "Less useful outside the Google ecosystem than Ring is within Alexa homes"
    ],
    "bottomLine": "If your house runs on Google Home, this is the doorbell that feels native, with a tall view and tidy app to match.",
    "description": "For households that live in the Google Home ecosystem, the Nest Doorbell is the one that behaves as though it belongs. Google designs the image in a taller portrait frame so a visitor and the parcel at their feet both appear, and the doorbell can run from existing wiring or its battery. Integration is the draw: announcements arrive on Nest speakers, video appears on Nest displays and the activity zones let you tell the camera which parts of the porch to watch. The caveat is that the most intelligent features, such as recognizing familiar faces and extending the video history, are tied to a Nest Aware subscription, and Google changes what is included over time. Verify what comes with the doorbell on the current listing."
  },
  {
    "id": "eufy-video-doorbell-e340",
    "name": "Eufy Video Doorbell E340 (Dual Camera)",
    "category": "Local Storage, Dual Camera",
    "badge": "Best No-Subscription Pick",
    "amazonUrl": "#",
    "pros": [
      "Eufy markets local storage so clips stay on hardware you own, with no required monthly fee",
      "Dual-camera design adds a dedicated lower view aimed at the doorstep for packages",
      "Can be wired to doorbell wiring or run on battery, according to the manufacturer",
      "Works with Alexa and Google Assistant for basic voice and display integration"
    ],
    "cons": [
      "Larger body than slimmer rivals, which can look bulky on narrow trim",
      "Local storage does not protect footage if the device itself is stolen, and cloud backup is a separate decision"
    ],
    "bottomLine": "The pick for anyone who wants to avoid recurring fees and is happy to keep video on their own hardware.",
    "description": "The Eufy Video Doorbell E340 is the clearest answer to the question of what to buy if you hate subscriptions. Eufy markets local storage so footage stays on a device you control, which removes the recurring cost that inflates the lifetime price of most doorbells. The dual-camera design adds a second lens pointed at the ground, which is aimed squarely at package visibility. It is a larger unit than the slimmest competitors and the app experience differs from the Ring or Nest polish, so read the owner reports with your own priorities in mind. Confirm on the listing what storage and hub are included, and consider whether a cloud backup matters if theft of the doorbell is your main concern."
  },
  {
    "id": "arlo-essential-video-doorbell-2k",
    "name": "Arlo Essential Video Doorbell 2K (Wired)",
    "category": "Wired, 2K Wide View",
    "badge": "Best Wide Field of View",
    "amazonUrl": "#",
    "pros": [
      "Wide field of view, which Arlo specifies at 180 degrees, helps catch a visitor approaching from the side",
      "2K resolution with HDR processing aimed at doors that face bright sun",
      "Square-ish aspect ratio as specified by the manufacturer keeps more of the doorstep in frame",
      "Works with Alexa, Google Assistant and Apple HomeKit according to Arlo"
    ],
    "cons": [
      "Cloud recording depends on an Arlo Secure plan, so check the current plan terms before buying",
      "Needs existing doorbell wiring, so it is a poor fit for renters without a wired bell"
    ],
    "bottomLine": "A strong wired choice for wide porches and sunny doors, provided you accept an Arlo subscription for saved video.",
    "description": "Arlo takes a different approach from the portrait-view crowd, pairing a very wide lens with 2K resolution. The manufacturer specifies a 180-degree field of view and a squarer image, which suits doors on wide porches where visitors approach from an angle. HDR handling is aimed at the classic doorbell problem of a bright backdrop washing out a visitor's face. Arlo lists compatibility with Alexa, Google Assistant and HomeKit, which gives it more cross-ecosystem reach than some rivals. The trade-off is the usual one: recording to the cloud relies on an Arlo Secure plan and the terms change, so confirm them. This version is wired, so it needs a compatible transformer."
  },
  {
    "id": "wyze-video-doorbell-pro",
    "name": "Wyze Video Doorbell Pro",
    "category": "Budget, Battery with Chime",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "pros": [
      "Priced below most name-brand rivals, which makes it the easiest doorbell to justify on a tight budget",
      "Battery-powered for wire-free installs, with a wired option available according to Wyze",
      "Ships with a plug-in chime so you hear the ring without touching your house wiring",
      "Optional Cam Plus plan adds smarter detection, but the basics work without one"
    ],
    "cons": [
      "Some advanced detection features depend on a paid plan, so check the current terms",
      "Smaller accessory ecosystem and less polished integrations than Ring or Nest"
    ],
    "bottomLine": "The pick for a first doorbell on a budget, or for a rental where you cannot touch the wiring.",
    "description": "Wyze built its reputation on cheap, capable cameras, and the Video Doorbell Pro carries that approach to the front door. It is battery-powered so you can install it without wiring, a real advantage for renters, and it comes with a plug-in chime so you do not need to modify your existing bell. A wired option is available according to Wyze if you want to avoid recharging. Basic alerts and live view work out of the box, while smarter detection sits behind the optional Cam Plus plan, which you should price before deciding. Expect a smaller accessory ecosystem and less depth in smart-home integrations than the biggest brands. For many buyers that is a fair trade for the lower cost."
  },
  {
    "id": "aqara-video-doorbell-g4",
    "name": "Aqara Video Doorbell G4",
    "category": "HomeKit Secure Video, Wired or Battery",
    "badge": "Best for Apple Home",
    "amazonUrl": "#",
    "pros": [
      "Supports Apple HomeKit Secure Video, so recordings can live in iCloud rather than a vendor cloud",
      "Also lists Alexa and Google Assistant compatibility, according to Aqara",
      "Comes with a chime in the box, so you can hear the ring without relying on a wired bell",
      "Fits into the wider Aqara sensor and hub ecosystem for automations"
    ],
    "cons": [
      "HomeKit Secure Video recording needs a qualifying iCloud plan and a home hub such as an Apple TV or HomePod",
      "Smaller user base than Ring, with fewer mounting accessories and community guides"
    ],
    "bottomLine": "The best fit for Apple households that want video to stay inside their own iCloud account.",
    "description": "Few video doorbells support Apple's HomeKit Secure Video, and the Aqara G4 is the one most often recommended to iPhone households that care where their footage lives. With that feature enabled, clips are analyzed on your home hub and stored in your iCloud account, which keeps the data inside Apple's privacy model instead of a separate vendor cloud. Aqara also lists Alexa and Google Assistant support, and the doorbell ships with its own chime. The requirements are worth reading carefully: HomeKit Secure Video needs an iCloud plan of a qualifying tier and a home hub at home. If you already own an Apple TV or HomePod, the G4 is an easy way to add a doorbell without adding another subscription."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Video Doorbell",
          item: "https://www.thehonestreviewers.com/best-video-doorbell/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best video doorbell overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households the Ring Battery Video Doorbell Plus is the safest default because it runs on battery or wiring, offers a taller head-to-toe view and has the biggest accessory ecosystem. If you live in Google Home, the Nest Doorbell is the more natural fit, and if you want to avoid fees, the Eufy E340 deserves a close look."
          }
        },
        {
          "@type": "Question",
          "name": "Do video doorbells require a subscription?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not to work at a basic level. Most still send alerts and allow live view without a plan, but saving clips, longer history and smarter detection are often tied to a monthly or annual plan. Plan terms change, so check the current details on the manufacturer's page, or choose a model with local storage to avoid recurring fees."
          }
        },
        {
          "@type": "Question",
          "name": "Is a wired or battery doorbell better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you have a working doorbell circuit, wired is better because it never needs charging. Battery models suit renters and homes without wiring, at the cost of periodic recharges. Hybrid models such as the Ring Battery Plus and the Nest Doorbell let you use house power with the battery as backup."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a video doorbell myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes. Battery models need only a few screws, and wired models need basic low-voltage work after you switch off the breaker. Check your transformer rating and chime compatibility first. If you are uncomfortable working near the transformer or panel, hire a licensed electrician for that part."
          }
        },
        {
          "@type": "Question",
          "name": "Will a video doorbell work with my existing chime?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, but not always. Mechanical chimes usually need a small power kit or adapter, and digital chimes can need a bypass. Most manufacturers publish a compatibility checker, and several include the kit in the box. Check the support page for your doorbell and your chime type before you order."
          }
        },
        {
          "@type": "Question",
          "name": "Is it legal to record audio with a doorbell camera?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on where you live. Some states require every party to a conversation to consent, and a recording of people on your step can be treated differently from a live two-way talk feature. Many apps let you turn audio recording off. This is general information, so check your state's rules or ask a local attorney."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to buy a video doorbell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Doorbells are frequently discounted during October shopping events and around Black Friday and Cyber Monday, with smaller dips in spring. Pick your model first and then watch the price, rather than letting a sale choose the doorbell for you. Always check the return window in case the wiring or chime turns out to be incompatible."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Security",
    tags: [
      "best video doorbell",
      "video doorbell",
      "wired vs battery doorbell",
      "doorbell camera",
      "no subscription doorbell"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Video <span class="text-[#38BDF8]">Doorbells</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven doorbell cameras, ranked by who should buy which. The right pick depends on your wiring, your tolerance for monthly fees and the smart-home ecosystem you already live in.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ring-battery-video-doorbell-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-ranked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Ranked These Doorbells</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Our 7 Top Picks Reviewed</a>
          <a href="#wired-vs-battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Wired vs Battery Doorbells</a>
          <a href="#video-quality" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Video Quality, Field of View &amp; Night Vision</a>
          <a href="#subscriptions" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Subscriptions &amp; Local Storage</a>
          <a href="#installation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Installation, Transformers &amp; Chimes</a>
          <a href="#privacy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Privacy, Audio &amp; the Law</a>
          <a href="#smart-home" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Smart-Home Compatibility</a>
          <a href="#deals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When to Buy: Deals Timing</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A video doorbell is the cheapest security upgrade most homes will ever make, and also the one most often bought for the wrong reasons. People pick on brand recognition, then discover the doorbell they chose wants a transformer they do not have, a subscription they did not budget for, or a field of view that crops the package at their feet. This guide ranks seven doorbells by the buyer each one actually suits, and it is plain about what we can and cannot tell you.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-ranked" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Ranked These Doorbells (and What We Did Not Test)
          </h2>

          <p>
            We want to be straight about the method. This is a buyer's guide built from manufacturer specifications, published support documentation and the patterns that show up in owner reports, not a bench review with our own stopwatch and light meter. Where a spec is quoted, it is attributed to the manufacturer. Where we describe real-world behavior, it is framed as what owners commonly report. We have not invented test results, and you should be suspicious of any doorbell roundup that quotes suspiciously precise latency or battery numbers without showing its method.
          </p>

          <p>
            The ranking weighs five things. First, power: whether the doorbell can run from your existing wiring, a rechargeable battery or both, because that decides whether installation is a ten-minute job or a weekend of fishing wire. Second, ongoing cost: whether useful features sit behind a monthly plan and whether local storage is an option. Third, picture: field of view, resolution and whether the camera can see a package on the step. Fourth, ecosystem: how well the doorbell plays with Alexa, Google Home or Apple Home. Fifth, the track record of the app, because a doorbell is only as good as the notification that reaches your phone.
          </p>

          <p>
            Price is deliberately a secondary factor in the order of the list, because the cheapest doorbell is rarely the cheapest to own. A model that looks like a bargain on the shelf can cost more over three years once a subscription is added, while a pricier model with free local storage can come out ahead. We do not quote exact prices here because they move weekly; check the listing for today's number.
          </p>

          <p>
            Finally, a framing point. A doorbell camera is one piece of a home security setup, not the whole thing. If your concern is the back yard or the garage, a doorbell will not help, and our <a href="/best-home-security-cameras/" class="text-[#1E90FF] font-bold hover:underline">guide to home security cameras</a> covers the rest of the property. The doorbell's real job is narrower: tell you who is at the front door, record what happened there, and let you talk to them without opening it.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The 7 Best Video Doorbells in 2026, Ranked
          </h2>

          <p>
            Each pick below is ranked by the buyer it suits best. Specifications come from the manufacturers and from what owners commonly report, not from our own bench measurements, and subscription terms change often, so confirm the current plan details on the listing before you buy. The Check Price buttons are affiliate links: if you buy through them we earn a commission at no extra cost to you, and it never changes where a product lands in the ranking.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
