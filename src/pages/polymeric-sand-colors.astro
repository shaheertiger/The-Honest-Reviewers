---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Polymeric Sand", url: "/best-polymeric-sand/" },
    { title: "How to Use Polymeric Sand", url: "/how-to-use-polymeric-sand/" },
    { title: "Polymeric Sand at Home Depot", url: "/polymeric-sand-home-depot/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-08", modified: "2026-09-08" });
const title = "Polymeric Sand Colors: How to Choose the Right One";
const description =
  "Polymeric sand colors explained — grey, tan, beige, black and ivory, how each ages, and whether to match your pavers or deliberately contrast with them.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Polymeric Sand Colors", item: "https://www.thehonestreviewers.com/polymeric-sand-colors/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What colors does polymeric sand come in?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The mainstream range is grey or slate, tan or beige, and a darker charcoal or black, with ivory and brown available from some brands. Big-box stores typically stock only grey and tan; the wider palettes come from hardscape suppliers or online, which is worth knowing before you settle on an unusual shade.",
          },
        },
        {
          "@type": "Question",
          name: "Should polymeric sand match or contrast with the pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Matching makes the paving read as one continuous surface and hides slight irregularities in joint width. Contrasting emphasises the pattern and makes each unit distinct. Matching is the safer choice on a large area or where the laying is not perfectly uniform; contrast works best on a crisp pattern with even joints.",
          },
        },
        {
          "@type": "Question",
          name: "Does polymeric sand color fade?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It shifts rather than fades dramatically. Most colours settle towards a slightly greyer, duller version of the bag over the first year or two as dust and weathering take hold, and darker shades show that change less. Premium brands generally hold their colour noticeably better than budget bags.",
          },
        },
        {
          "@type": "Question",
          name: "Which polymeric sand color hides dirt best?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mid-tone greys and tans hide everyday dirt best. Very light colours such as ivory show soil, moss and organic staining quickly, particularly in shaded or damp locations. Very dark colours hide dirt well but show dust, pollen and lime bloom more obviously.",
          },
        },
        {
          "@type": "Question",
          name: "Does the color affect how polymeric sand performs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No — the binder system and joint width rating determine performance, not the pigment. What colour does affect is how visible a mistake is: haze on the paver faces shows far more against dark joints, and a lighter sand makes uneven joint depths more obvious.",
          },
        },
        {
          "@type": "Question",
          name: "Can you mix polymeric sand colors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is not recommended. Different bags can differ slightly in grain size and binder loading as well as pigment, and mixing produces an unpredictable shade that is impossible to reproduce if you run short. Buy one shade, in one order, with a spare bag.",
          },
        },
        {
          "@type": "Question",
          name: "How do you choose a color without seeing it laid?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sprinkle a little dry sand from the bag into a joint in an out-of-the-way corner and look at it in daylight next to the pavers. Better still, do a small test area properly — sweep, compact and water a square yard — and look at it the next day, because the colour changes as the binders cure.",
          },
        },
        {
          "@type": "Question",
          name: "Can you change the color of existing polymeric sand?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only by removing it. Cured polymeric sand cannot be tinted or overlaid, and a fresh colour swept on top will not bond to the old joint. Changing the colour means grinding or chipping the existing joint sand out to depth, which is slow work and usually only worth it if the original choice is genuinely wrong.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
