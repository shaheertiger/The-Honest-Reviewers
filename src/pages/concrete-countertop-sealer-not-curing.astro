    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Why is my concrete countertop sealer still sticky?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On a two-part product, most often an incorrect mix ratio or inadequate mixing, which never cures regardless of time. Otherwise: moisture still coming out of the slab, a slab or room too cold, excess film thickness, or contamination such as silicone or release agent residue on the surface."
          }
        },
        {
          "@type": "Question",
          "name": "Will off-ratio epoxy eventually harden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The reaction is stoichiometric, so surplus resin or hardener has nothing to react with and remains in the film permanently as an uncured fraction. Warming it, waiting longer and coating over it all fail. The material has to be removed and the surface resealed with a correctly measured mix."
          }
        },
        {
          "@type": "Question",
          "name": "How long should epoxy countertop sealer take to cure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Touch dry in four to twelve hours, hard in 24 to 72, and full chemical cure in seven to 30 days depending on the product. An epoxy still slightly soft at 24 hours is normal; one that is liquid, gummy or fingerprinting at 72 hours in a warm room has a problem."
          }
        },
