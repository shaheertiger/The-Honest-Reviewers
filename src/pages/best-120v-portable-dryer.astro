---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Heat Pump Dryers",
    "url": "/best-heat-pump-dryer/"
  },
  {
    "title": "Best Dryer Cords and Adapters",
    "url": "/best-dryer-cord-adapter/"
  },
  {
    "title": "Best Dishwashers",
    "url": "/best-dishwasher/"
  },
  {
    "title": "Best Clothes Irons",
    "url": "/best-clothes-iron/"
  },
  {
    "title": "Best Steam Cleaners",
    "url": "/best-steam-cleaner/"
  },
  {
    "title": "Best Heat Pump Water Heaters",
    "url": "/best-heat-pump-water-heater/"
  },
  {
    "title": "Best Countertop Ice Makers",
    "url": "/best-countertop-ice-maker/"
  },
  {
    "title": "Best Refrigerator Brands",
    "url": "/best-refrigerator-brands/"
  },
  {
    "title": "Best Air Purifiers for Allergies",
    "url": "/best-air-purifier-for-allergies/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best 120V Clothes Dryers for 2026: Portable, Ventless and Combo";
const description =
  "No 240V outlet? Seven 120V clothes dryers ranked, from $300 portable vented units to ventless heat pump dryers and combos, with honest drying times and venting.";

const PRODUCTS = [
  {
    "id": "ge-profile-ultrafast-combo-pfq97hspvds",
    "name": "GE Profile UltraFast Combo PFQ97HSPVDS",
    "category": "Washer-dryer combo, 4.8 cu ft, ventless heat pump, 120V",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Washes and dries in one drum on a standard 120V outlet with no dryer vent",
      "4.8 cu ft capacity is close to a full-size front-load washer",
      "Inverter heat pump drying is far gentler and more efficient than a 120V resistance heater",
      "No transferring wet clothes, so a load can run start to finish while you are out",
      "Smart controls and sensor drying end the cycle when clothes are actually dry"
    ],
    "cons": [
      "Needs a dedicated 15-amp, 120V circuit, not a shared kitchen or bedroom outlet",
      "Expensive, and you can only wash or dry one load at a time"
    ],
    "bottomLine": "The best way to get full-size laundry into a home with no vent and no 240V outlet, if the budget stretches.",
    "description": "GE's UltraFast Combo is the machine that changed what a 120-volt dryer can be. It is a full-width front-load washer and a ventless heat pump dryer in a single drum, and it runs on a standard 120-volt outlet on a dedicated 15-amp circuit. That combination solves the two problems that keep most apartments and condos from having laundry: no 30-amp dryer circuit and no exterior vent. The US listing gives 4.8 cubic feet of capacity, which handles a family-size load of towels or a queen comforter, and GE advertises wash-and-dry times as short as about 90 minutes under its own test conditions. Owners commonly report longer runs for large mixed or heavy loads, which is normal for any heat pump dryer. Earlier generations of all-in-one machines used condenser drying with a resistance heater and cold water to strip moisture, which was slow, used a lot of water and often left clothes damp. The heat pump approach recycles heat in a closed loop and condenses the moisture into the drain line, so the room stays dry and no water is spent on drying. The big practical win is that nobody has to move a wet load. You can start a load before work and come home to dry clothes. The trade-offs are cost and throughput: a busy household doing several loads a day will find one drum limiting compared with a separate pair. Check the outlet position too, since GE wants the receptacle within about three feet of where the cord leaves the machine."
  },
  {
    "id": "lg-washcombo-wm6998hba",
    "name": "LG WashCombo WM6998HBA",
    "category": "Washer-dryer combo, 5.0 cu ft, ventless heat pump, 120V",
    "badge": "Best Large-Capacity Combo",
    "amazonUrl": "#",
    "pros": [
      "Largest drum here at a listed 5.0 cu ft in the US",
      "Runs on a standard 120V, 15-amp circuit with no vent",
      "Inverter heat pump drying with steam and sanitize options",
      "Direct-drive motor is quiet enough for an apartment closet",
      "Single-drum design means loads go from wash to dry with nobody home"
    ],
    "cons": [
      "Premium price, often similar to a good separate washer and dryer pair",
      "Deep cabinet needs a laundry space with real depth, not a shallow closet"
    ],
    "bottomLine": "Pick the LG over the GE if you wash bulky loads and want the biggest drum on a standard outlet.",
    "description": "LG's WashCombo is the GE Profile's direct rival, and the two are close enough that the choice usually comes down to price on the day, capacity and brand preference. The WM6998HBA is an all-in-one washer and ventless heat pump dryer that US retailers list at 120 volts and 15 amps, with a 5.0 cubic-foot drum, the largest on this list. That extra space matters for bedding, towels and family loads, and it gives the dryer room to tumble, which helps drying time and wrinkles. Like the GE, it moisture-condenses into the drain instead of venting, so it can live in a closet, a kitchen alcove or a bathroom with only a water supply, a drain and an outlet. LG's direct-drive motor is one of the quieter washer drives available, a real consideration when the laundry closet opens onto a living room. Steam and sanitize cycles round out a feature list that matches a high-end standalone pair. The limits are the same as any single-drum machine: one load at a time, and a full wash-and-dry takes longer than running a separate washer and a 240-volt dryer in parallel. It is also a deep, heavy appliance, so measure the space with the door open and plan for the hoses behind it. If your building allows washers but forbids vented dryers, which is common, this or the GE is the most complete solution available, and we would buy whichever is cheaper when you shop."
  },
  {
    "id": "miele-t1-txd160wp",
    "name": "Miele T1 TXD160WP Heat Pump Dryer",
    "category": "24-inch ventless heat pump dryer, 4.02 cu ft, 120V",
    "badge": "Best Standalone 120V Dryer",
    "amazonUrl": "#",
    "pros": [
      "True heat pump dryer that plugs into a standard 120V, 15-amp outlet with a 5-15 plug",
      "Ventless, so it can sit in a closet or stack on a 24-inch washer",
      "Gentle low-temperature drying with Miele's honeycomb drum",
      "Very low energy use per load compared with any resistance dryer",
      "Wi-Fi control and Miele's long reputation for build quality"
    ],
    "cons": [
      "Expensive, with listings commonly between about $1,350 and $1,900",
      "4.02 cu ft compact drum handles smaller loads than a full-size dryer"
    ],
    "bottomLine": "The best separate 120V dryer you can buy, and a rare compact European dryer that does not need 240 volts.",
    "description": "If you want a separate dryer rather than a combo, the Miele T1 is the strongest 120-volt option, and it surprised us. Most compact European-style dryers sold in the US, including Bosch's 300 and 500 Series compact and heat pump models, are 208 to 240-volt machines that still need a dryer circuit. Miele's US T1 heat pump models are listed at 120 volts and 15 amps with an ordinary NEMA 5-15 plug, so the TXD160WP plugs into the same kind of outlet as a toaster, preferably on its own circuit. It is a 24-inch, 4.02 cubic-foot ventless heat pump dryer that pairs or stacks with a compact washer, which makes it a fit for condos, closets and European-style laundry nooks. Heat pump drying runs cooler than a conventional dryer, which is easy on fabrics and cuts energy use sharply. The honeycomb drum pattern is designed to cushion clothes on a film of water and air, and Miele's sensor drying stops the cycle when the load reaches the chosen dryness. The condensed water goes to a drain hose or a removable container, so there is no vent and no humidity dumped into the room. The trade-offs are price and capacity. It is a compact dryer, so a week of family laundry takes more loads than a full-size machine, and drying times are longer than a 240-volt vented dryer. For a couple or a small household that wants a long-lived separate dryer with no vent and no 240V circuit, it is hard to beat."
  },
  {
    "id": "ge-gfq14essnww-combo",
    "name": "GE 24-Inch Washer/Condenser Dryer Combo GFQ14ESSNWW",
    "category": "24-inch washer-dryer combo, 2.4 cu ft, ventless condenser, 120V",
    "badge": "Best Compact Combo",
    "amazonUrl": "#",
    "pros": [
      "Only 24 inches wide, fitting closets and under-counter spaces full-size combos cannot",
      "Runs on a standard 120V outlet with no vent",
      "Washes and dries in one drum, so loads can run unattended",
      "1,450 rpm spin wrings out more water before drying begins",
      "Steam, sanitize and timed dry options"
    ],
    "cons": [
      "Condenser drying with a resistance heater is slow, especially for towels and jeans",
      "Not ENERGY STAR certified, and the 2.4 cu ft drum suits small loads only"
    ],
    "bottomLine": "A practical laundry solution for the tightest spaces, provided you accept small loads and long dry times.",
    "description": "Not every apartment has room for a 27-inch combo, and GE's 24-inch GFQ14ESSNWW exists for those spaces. It is a compact front-load washer and ventless condenser dryer in a single drum, roughly 23 7/16 inches wide, and it plugs into an ordinary 120-volt outlet. Its listed 2.4 cubic-foot drum suits one or two people doing frequent small loads, not a family catching up on a weekend. The technology is the older condenser approach rather than a heat pump. A resistance heater warms the air, and moisture is condensed out and sent down the drain. It works, but it is slower and less efficient than heat pump drying, and reviewers note that towels and heavy cotton can take a long time. The machine is not ENERGY STAR certified, which reflects the less efficient drying method. Two things help. A 1,450 rpm spin wrings more water out of a load than many full-size washers, which means less to evaporate. And because washing and drying happen in the same drum, the long dry phase can run overnight or while you are out without anyone moving clothes. For best results, dry smaller loads than the washer can hold. A half-full drum dries noticeably faster than a packed one. Retail prices have commonly run around $1,250 to $1,500, which is less than the heat pump combos above. If you have the width for a 27-inch heat pump combo, buy that instead. If you have 24 inches and a standard outlet, this is the machine."
  },
  {
    "id": "panda-pan760sf",
    "name": "Panda PAN760SF 3.5 cu ft Portable Dryer",
    "category": "Portable vented dryer, 3.5 cu ft, 110V",
    "badge": "Best Large Portable",
    "amazonUrl": "#",
    "pros": [
      "Largest portable vented drum here at a listed 3.5 cu ft, up to about 13 lb",
      "Plugs into a standard household outlet, no installation",
      "Stainless steel drum and simple dial controls",
      "Typically priced in the low-to-mid $300s",
      "Can stand on the floor, a counter or a washer"
    ],
    "cons": [
      "Vented design needs an exhaust path or it will fill the room with humidity and lint",
      "Much slower than a full-size dryer, especially on full loads"
    ],
    "bottomLine": "The portable to buy if you want the biggest loads possible from a cheap 120V vented dryer and can vent it outside.",
    "description": "Panda is one of the more established names among the many small portable dryer brands, and the PAN760SF is its largest model. It is a vented electric dryer listed at 3.5 cubic feet and about 13 pounds of laundry, with a stainless steel drum and straightforward dial controls, and it plugs into a regular 110 to 120-volt outlet. That makes it roughly twice the drum volume of the 1.5 cubic-foot portables that dominate the category, which matters because a small portable that only takes a few shirts at a time turns laundry day into an all-day project. Be realistic about speed. A portable dryer's heater is limited by the 15-amp outlet, so it has a fraction of the heat output of a 240-volt dryer, and a full drum of cotton can take well over an hour. Loading it two-thirds full and spinning clothes as hard as your washer allows will shorten that more than any setting on the dial. The big decision is venting. This is a vented dryer, so it pushes warm, wet, lint-laden air out of an exhaust port. Run it with the hose out a window or into a proper vent and it works as intended. Run it into a small room with no exhaust and you will get condensation on the windows and lint on everything. Panda includes an exhaust connection, and a window vent kit is worth buying. For a garage, basement or RV with a way to vent, it is a lot of dryer for the money."
  },
  {
    "id": "black-decker-bced26",
    "name": "BLACK+DECKER BCED26 Compact Dryer",
    "category": "Portable vented dryer, 2.65 cu ft, 120V, 1,400W",
    "badge": "Best Compact Portable",
    "amazonUrl": "#",
    "pros": [
      "2.65 cu ft stainless drum takes about 8.8 lb of laundry",
      "Rated 1,400W on a standard 120V outlet, easy on an apartment circuit",
      "Multiple heat settings including air dry for delicates",
      "30 to 200-minute timer range covers small and large loads",
      "Widely sold with a straightforward one-year warranty"
    ],
    "cons": [
      "Slow on full loads, a common owner complaint",
      "Weighs about 48 lb, so wall or stand mounting needs a solid surface"
    ],
    "bottomLine": "A well-supported mid-size portable for apartments and dorms, as long as you vent it and keep loads moderate.",
    "description": "BLACK+DECKER's BCED26 is the middle child of the portable dryer world: bigger than the tiny 1.5 cubic-foot units, smaller and lighter than the Panda above, and sold through major retailers with real support behind it. It is a vented electric dryer with a 2.65 cubic-foot stainless steel drum, rated for about 8.8 pounds of laundry, and it draws a rated 1,400 watts from a standard 120-volt outlet. That wattage is the key number. It is low enough to run on most household circuits without tripping a breaker, provided nothing else heavy shares the circuit, and it is about a quarter of what a typical 240-volt dryer heater uses, which is exactly why drying takes longer. Owners who like it tend to praise the size and simplicity, and owners who mark it down usually cite drying time. Both are right. Think of it as a dryer for two or three days of clothes for one or two people, run every day or two, rather than a weekend machine for a family. The 30 to 200-minute timer and multiple heat settings let you run delicates on low heat or air only. Like every portable vented dryer, it exhausts warm moist air and fine lint, and the included exhaust connector should be routed outside or to a vent. It measures about 23.6 by 17.1 by 27.5 inches and weighs roughly 48 pounds, so if you plan to mount or stack it, make sure the surface is rated for the weight plus vibration."
  },
  {
    "id": "magic-chef-mcsdry1s",
    "name": "Magic Chef MCSDRY1S 2.6 cu ft Compact Dryer",
    "category": "Portable vented dryer, 2.6 cu ft, 120V",
    "badge": "Best for Wall Mounting",
    "amazonUrl": "#",
    "pros": [
      "2.6 cu ft stainless drum in a 23.6-inch-wide cabinet",
      "Plugs into a standard 120V outlet",
      "Supports multiple installation options, including wall-mounting hooks",
      "Five drying options with high and low heat",
      "Magic Chef is a long-running compact appliance brand with US support"
    ],
    "cons": [
      "Vented, so it needs an exhaust path",
      "Prices vary widely between sellers, from about $315 to over $500"
    ],
    "bottomLine": "Choose it over the BLACK+DECKER when you want to get the dryer off the floor and onto a wall.",
    "description": "Magic Chef has sold compact appliances for apartments and small spaces for decades, and the MCSDRY1S is its long-running 2.6 cubic-foot compact dryer. It is a vented electric unit with a stainless steel drum, a 23.6-inch-wide by 27.5-inch-tall cabinet, and a standard 120-volt plug. What sets it apart is mounting flexibility. Magic Chef lists multiple installation options, including wall-mounting hooks, which lets you hang the dryer above a compact washer or a counter rather than giving up floor space. In a small apartment bathroom or laundry closet, getting the dryer onto the wall can be the difference between having one and not. Wall mounting deserves care. The cabinet weighs about 48 pounds before it holds wet clothes, and it vibrates when it tumbles, so mount it into studs or solid blocking, never drywall anchors, and follow the manufacturer's height and clearance guidance. Performance is in line with other 120-volt portables of this size. Expect long cycles for full loads of cotton, and expect better results by drying smaller loads and using a washer with a strong spin. The five drying options with high and low heat cover delicates through towels. As with every vented portable, plan where the exhaust goes before you buy. A window vent kit or a short run to an existing exterior vent keeps humidity and lint out of the room. Shop around, because listings for the same model have ranged from roughly $315 to more than $500."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 120V Clothes Dryers",
          item: "https://www.thehonestreviewers.com/best-120v-portable-dryer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can a clothes dryer run on 120 volts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Compact vented portables, a few standalone heat pump dryers such as Miele's US T1 models, and the newer all-in-one combos from GE and LG all run on standard 120-volt outlets. They are slower than 240-volt dryers because a 15-amp outlet limits power to roughly 1,440 watts continuous. Heat pump models make up most of that gap by recycling heat."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a 120V dryer take to dry a load?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends heavily on type and load size. Vented portables commonly take one to two hours or more for a full drum of cotton. Heat pump combos are faster per pound and run unattended, with GE advertising wash-and-dry cycles as short as about 90 minutes. Smaller loads and a high washer spin speed cut time the most."
          }
        },
        {
          "@type": "Question",
          "name": "Do portable dryers need to be vented?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vented portables do. They exhaust warm, moist, lint-filled air and should be connected to a window vent kit or an exterior vent. Running one into a closed room causes humidity and lint problems. Ventless heat pump and condenser dryers do not need a vent, because they condense the moisture into water and send it to a drain or tank."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best ventless dryer for an apartment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you need both washing and drying, the GE Profile UltraFast Combo or LG WashCombo is the best ventless option on a standard 120-volt circuit. If you already have a washer, the Miele T1 TXD160WP is the strongest standalone 120-volt heat pump dryer. For very tight spaces, GE's 24-inch condenser combo fits where others will not."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug a portable dryer into any outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The plug will fit any standard outlet, but the circuit matters. A 1,400-watt dryer uses most of a 15-amp circuit, so avoid outlets shared with heaters, microwaves or air conditioners. Never use an extension cord or power strip. Heat pump combos and the Miele specify a dedicated circuit, which is a modest job for an electrician."
          }
        },
        {
          "@type": "Question",
          "name": "Are 120V washer dryer combos worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For homes with no vent and no 240-volt outlet, the new heat pump combos are worth it. They handle near full-size loads, run without anyone moving wet clothes and use far less energy than resistance dryers. They are expensive and handle one load at a time, so large households with a vent and 240-volt outlet are better served by a separate pair."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 120 volt dryer cheaper to run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per load, a vented 120-volt portable costs roughly the same as a full-size dryer, about 30 to 40 cents at average US rates, because it runs longer at lower power. Heat pump models are genuinely cheaper, using roughly half the energy of a standard electric dryer or less. Condenser combos fall in between and may also use water."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "120v clothes dryer",
      "portable dryers",
      "120 volt dryer",
      "apartment dryer",
      "ventless dryer for apartment",
      "compact dryer",
      "portable clothes dryer",
      "washer dryer combo 120v"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">120V Clothes Dryers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Dryers that plug into an ordinary wall outlet, from $300 portables to ventless heat pump machines, with straight talk about how much slower 120 volts really is.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ge-profile-ultrafast-combo-pfq97hspvds"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Type Fits
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="13.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our Top Picks</a>
          <a href="#why-slower" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Why 120V Dryers Are Slower</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Three Types</a>
