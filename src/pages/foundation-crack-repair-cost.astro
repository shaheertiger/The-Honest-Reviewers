      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Are vertical foundation cracks normal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thin vertical cracks in poured concrete walls are very common and are usually caused by shrinkage as the concrete cured. If they are hairline to about an eighth of an inch, flush on both sides and not growing, they are usually not structural. They can still let in water and soil gas, which is why many homeowners seal them."
          }
        },
