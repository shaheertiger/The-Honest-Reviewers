      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How do I stop my tools rusting in a garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Control the humidity first — a dehumidifier holding the space below 60 percent protects everything in it. Then add barriers: VCI paper in closed drawers, a wipe of light oil or paste wax on bare steel, and keep the toolbox off the concrete floor, which stays cold and wicks moisture."
          }
