---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Bathroom Dehumidifiers",
    "url": "/best-bathroom-dehumidifier/"
  },
  {
    "title": "How to Choose a Dehumidifier",
    "url": "/how-to-choose-a-dehumidifier/"
  },
  {
    "title": "Air Purifier vs Dehumidifier",
    "url": "/air-purifier-vs-dehumidifier/"
  },
  {
    "title": "How Much Electricity Does a Dehumidifier Use?",
    "url": "/how-much-electricity-does-a-dehumidifier-use/"
  },
  {
    "title": "Do You Need a Dehumidifier in Winter?",
    "url": "/do-you-need-a-dehumidifier-in-winter/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-20", modified: "2026-10-20" });
const title = "Best Dehumidifiers for Bedrooms: 4 Quiet Picks by Maker-Rated dB";
const description =
  "Four bedroom dehumidifiers compared on maker-rated noise, sleep modes, display lights and size, with the 2019 pint-rating change explained and what to skip.";

const PRODUCTS = [
  {
    "id": "ge-adyr22lc",
    "name": "GE 22-Pint Portable Dehumidifier with Smart Dry (ADYR22LC)",
    "badge": "Best Overall",
    "category": "Compressor, 22 Pints/Day (DOE 2019)",
    "amazonUrl": "#",
    "description": "The GE ADYR22LC is the bedroom dehumidifier we would start with, because it has the lowest published noise rating of the compressor models we found: GE specs listed by AJ Madison give 43 dBA on low and 45 dBA at maximum. It removes 22 pints a day under the 2019 DOE test, and GE describes its Smart Dry feature as automatically adjusting fan speed based on room humidity. Retailers list a 7-pint bucket, two fan speeds, a 30 to 70 percent adjustable humidistat, operation down to 41 degrees Fahrenheit, a drain-hose connection, and dimensions of about 19.5 by 12.2 by 8.3 inches at about 29 pounds. The bucket alarm sounds for 10 seconds when the bucket is full or missing, so empty it at bedtime. Retailers disagree on whether this R32 model is ENERGY STAR certified, so check the label if that matters to you.",
    "pros": [
      "43 dBA low, 45 dBA max per GE specs at retailers",
      "Smart Dry adjusts fan speed automatically",
      "Slim, about 8.3 inches deep",
      "22 pints/day under the 2019 DOE test"
    ],
    "cons": [
      "10-second full-bucket alarm",
      "ENERGY STAR status listed inconsistently",
      "Only two fan speeds"
    ],
    "bottomLine": "The quietest maker-rated compressor unit we found, sized right for any bedroom."
  },
  {
    "id": "danby-ddr022bswdb",
    "name": "Danby 22-Pint Dehumidifier with Wi-Fi (DDR022BSWDB)",
    "badge": "Best Smart Pick",
    "category": "Compressor, 22 Pints/Day, Wi-Fi",
    "amazonUrl": "#",
    "description": "The Danby DDR022BSWDB is the pick if you want to control a bedroom dehumidifier from your phone instead of reaching for a glowing panel at night. Danby's spec sheet rates it at 22 pints a day for spaces up to 1,500 square feet, with Wi-Fi app control and a bucket-full alert, a 24-hour timer, a Smart Dehumidify mode that factors in room temperature, auto restart, an auto de-icer, a washable filter and a direct-drain option. It measures about 15.9 by 8.9 by 15.9 inches and weighs about 30 pounds, a compact shape for a bedroom corner. Noise is the caveat: one Danby sheet lists 48 dB on low and 50 dB on high and calls it quiet operation, while another lists 56 dB on high. Reviewers note the fan is noticeable on high, so run it hard in the day and schedule low at night.",
    "pros": [
      "App control and phone alert for a full bucket",
      "24-hour timer and scheduling",
      "Compact, about 15.9 x 8.9 x 15.9 inches",
      "Auto de-icer and washable filter"
    ],
    "cons": [
      "Danby's published noise figures conflict",
      "Fan is noticeable on high per reviewers",
      "No sleep mode listed"
    ],
    "bottomLine": "A compact smart unit for people who want to schedule it and never touch the panel at night."
  },
  {
    "id": "honeywell-tp30awkn",
    "name": "Honeywell 30-Pint Smart Dehumidifier (TP30AWKN, 20-Pint 2019 DOE)",
    "badge": "Best Sleep Mode",
    "category": "Compressor, 20 Pints/Day (DOE 2019), Wi-Fi",
    "amazonUrl": "#",
    "description": "The Honeywell TP30AWKN is the Wi-Fi and Alexa-enabled version of Honeywell's 30-pint dehumidifier, which retailers list at 20 pints under the 2019 DOE standard, a clear example of how the rating change shrank the numbers. Its bedroom appeal is a dedicated sleep mode, which Sylvane describes as running on a low fan speed for quieter operation, plus two fan speeds and app control so you can adjust it without getting up. Sylvane says the 30-pint line suits small basements, bedrooms and offices, and Lowe's notes a continuous-drain option with an included tube. Housefresh reports a 7-pint tank on the non-Wi-Fi TP30WKN sibling. Honeywell does not publish a decibel figure that we could find, so we cannot rank it against the GE on noise; choose it if a true sleep mode matters more to you than a published number.",
    "pros": [
      "Dedicated sleep mode on low fan per Sylvane",
      "Wi-Fi app and Alexa control",
      "Continuous-drain tube included per Lowe's",
      "Sized for bedrooms and offices"
    ],
    "cons": [
      "No published decibel rating found",
      "Rated 20 pints under the current DOE test",
      "Bucket size not confirmed for this exact model"
    ],
    "bottomLine": "The pick for light sleepers who want a real sleep mode and app control in one unit."
  },
  {
    "id": "pro-breeze-pb-03",
    "name": "Pro Breeze PB-03 Thermoelectric Dehumidifier",
    "badge": "Best for Small Rooms",
    "category": "Thermoelectric (Peltier), 1.5 L Tank",
    "amazonUrl": "#",
    "description": "The Pro Breeze PB-03 is the near-silent option for a small guest room, nursery or walk-in closet with a mild damp problem. Pro Breeze's manual says its Peltier design, with no compressor, makes it lightweight and quiet, and RTINGS gave it a high noise score in its review. The manual rates it at about 500 mL, roughly 18 ounces, a day at 86 degrees Fahrenheit and 80 percent humidity, for spaces of about 2,200 cubic feet, with a 1.5-liter tank and automatic shut-off when full. That is a fraction of what a compressor unit removes, and RTINGS rated it poorly for capacity and airflow. It cannot drain continuously, and we found no sleep mode. Buy it for a small room where you want drier air without any compressor hum, not for a damp basement bedroom.",
    "pros": [
      "No compressor, so only fan noise",
      "Light and easy to move between rooms",
      "1.5 L tank with silent auto shut-off",
      "Low power draw"
    ],
    "cons": [
      "About 18 oz/day even at 86°F and 80% RH",
      "No continuous drain or sleep mode",
      "Too weak for a genuinely damp bedroom"
    ],
    "bottomLine": "Near-silent drying for a small, mildly damp room; not a fix for a real moisture problem."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dehumidifiers for Bedrooms",
          item: "https://www.thehonestreviewers.com/best-dehumidifier-for-bedroom/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is it OK to sleep with a dehumidifier on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the unit is in good condition, plugged directly into a wall outlet and placed with clear space around it. Many people run one at night in damp seasons. For better sleep, dry the room before bed, then use low fan or sleep mode overnight, empty the bucket at bedtime, and place the unit as far from the bed as practical."
          }
        },
        {
          "@type": "Question",
          "name": "How loud is a quiet dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The quietest compressor models that publish a figure are in the low to mid 40s in dBA on low; GE lists the ADYR22LC at 43 dBA low and 45 max. Thermoelectric units are quieter because they have no compressor, but they remove much less water. The WHO suggests about 30 dBA for bedrooms, which no compressor unit we found claims to meet."
          }
        },
        {
          "@type": "Question",
          "name": "What size dehumidifier do I need for a bedroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A compressor model rated 20 to 22 pints a day under the 2019 DOE test suits almost any bedroom, including large or basement bedrooms. That class was labeled 30 pints before 2019. Thermoelectric units rated in ounces a day are only enough for small, mildly damp rooms like guest rooms or walk-in closets."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should my bedroom be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA recommends 30 to 50 percent relative humidity indoors and below 60 percent to limit mold. For dust mite allergies, the Asthma and Allergy Foundation of America suggests keeping it below 50 percent. Use a hygrometer to check, because built-in dehumidifier sensors can read differently from conditions at your bed."
          }
        },
        {
          "@type": "Question",
          "name": "Will a dehumidifier make my bedroom hotter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A compressor dehumidifier does warm the room slightly, because the electricity it uses and the heat released by condensing water end up in the room. In summer, run it during the day with the door closed and let the AC handle temperature at night. Thermoelectric units add less heat but remove far less water."
          }
        },
        {
          "@type": "Question",
          "name": "Do dehumidifiers help with allergies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can help with dust mite and mold allergies by keeping humidity down, since both thrive in damp air. They do not filter pollen, pet dander or dust; that is an air purifier's job. If you have ongoing allergy or asthma symptoms, see a doctor or allergist to confirm the trigger before relying on equipment."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a dehumidifier and humidifier in the same bedroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at the same time, but many bedrooms need each in different seasons: a dehumidifier in a humid summer or a damp basement, and a humidifier in a dry, heated winter. Use a hygrometer to decide. If the room is below 30 percent, put the dehumidifier away; if it is above 60 percent, put the humidifier away."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement Waterproofing",
    tags: [
      "dehumidifier for bedroom",
      "best dehumidifier for bedroom",
      "quiet dehumidifier",
      "quiet dehumidifier for bedroom",
      "dehumidifier sleep mode",
      "small dehumidifier"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Quiet Picks
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Dehumidifiers for Bedrooms <span class="text-[#38BDF8]">You Can Sleep Next To</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Four dehumidifiers chosen for the room where noise, light and heat matter most, ranked on what their makers actually publish about decibels and sleep features rather than on the word quiet on the box.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ge-adyr22lc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How Loud Is Too Loud?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-chose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Chose</a>
          <a href="#do-you-need-one" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Do You Need One?</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 4 Picks</a>
          <a href="#decibels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What the Decibel Numbers Mean</a>
          <a href="#sleep-features" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Sleep Modes, Lights and Alarms</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Sizing and the 2019 DOE Change</a>
          <a href="#heat-placement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Heat and Placement</a>
          <a href="#overnight" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Getting Through the Night</a>
          <a href="#alternatives" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Running Cost and Alternatives</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A bedroom dehumidifier has a harder job than a basement one, because it has to dry the air without keeping you awake. That rules out a lot of good machines. No compressor dehumidifier is silent; the quietest ones that publish a figure sit in the low to mid 40s in decibels, and they cycle on and off through the night. The best bedroom dehumidifier is therefore a small, efficient compressor model with a published low-speed noise rating, a display you can live with in the dark and a bucket big enough to last until morning, or, in a very small room, a thermoelectric unit that trades capacity for near silence.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-chose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Chose
          </h2>

          <p>
            Almost every dehumidifier listing calls the product quiet, and most of the small ones sold for bedrooms come from brands that appear and disappear from online stores within a year. We started from the other end. We looked only at models from makers that publish a spec sheet, sell replacement parts and have a support line, and then we asked one question of each: does the maker publish a decibel figure, and what is it at the lowest fan speed?
          </p>

          <p>
            That question narrowed the field quickly. GE publishes low and maximum sound levels for its 22-pint ADYR22LC, Danby publishes a decibel rating for its Wi-Fi 22-pint model, and Pro Breeze describes the noise character of its thermoelectric design. Several well-known compressor models, including some we like for other rooms, publish no figure at all, which is a problem when the whole point is sleep. Where we include a model without a published figure, it is because it has a feature that matters more for some sleepers, in this case a true sleep mode.
          </p>

          <p>
            Next we weighed what actually wakes people up. A steady fan hum is easier to sleep through than a compressor kicking on at 3 a.m., a bright blue display, or a full-bucket alarm. So we looked at sleep modes, whether the display can be dimmed or switched off, how loud and how long the bucket alarm is, and how big the bucket is relative to an overnight run. We also looked at footprint, because bedroom floor space is limited and a unit that has to sit next to the bed is a unit you will hear.
          </p>

          <p>
            We kept this list deliberately short. Four models cover the realistic bedroom cases: a typical bedroom that needs real drying, a bedroom where app control and scheduling matter, a light sleeper who wants a dedicated sleep mode, and a very small or guest room where near silence matters more than capacity. For the general buying framework, including type and capacity, see <a href="/how-to-choose-a-dehumidifier/">how to choose a dehumidifier</a>.
          </p>
        </div>

        <div id="do-you-need-one" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Do You Need a Dehumidifier in the Bedroom?
          </h2>

          <p>
            Most bedrooms do not need one year-round. The EPA recommends keeping indoor relative humidity below 60 percent, ideally between 30 and 50 percent, and many homes sit in that range without help for most of the year. The signs that a bedroom needs drying are specific: condensation on the inside of windows on cool mornings, a musty smell from closets or the mattress, mildew on window frames or behind furniture against an exterior wall, or a hygrometer that reads above 60 percent for days at a time.
          </p>

          <p>
            Allergies are the other common reason. Dust mites thrive in humid air, and the Asthma and Allergy Foundation of America recommends keeping humidity below 50 percent to help control them. A dehumidifier is a reasonable part of an allergy plan alongside washing bedding in hot water and using mite-proof covers, but it is not a treatment. If you have persistent allergy or asthma symptoms, see a doctor or allergist, who can tell you whether dust mites are the trigger before you buy equipment.
          </p>

          <p>
            Check first. A <a href="/best-hygrometer/">hygrometer</a> on the nightstand for a week will tell you more than any symptom. If the reading sits at 45 to 55 percent, you do not need a dehumidifier, and buying one risks over-drying the room. If it sits above 60 percent, especially in summer or in a basement bedroom, a dehumidifier will help. Our guide to <a href="/ideal-indoor-humidity/">ideal indoor humidity</a> explains targets by season.
          </p>

          <p>
            Also look for the cause. A bedroom that is much damper than the rest of the house may have a roof or window leak, an exterior wall that is cold enough for condensation, or a crawl space or basement below it that is feeding moisture upward. Bugs that love damp rooms are a clue too; our guide to <a href="/does-a-dehumidifier-get-rid-of-silverfish/">whether a dehumidifier gets rid of silverfish</a> covers what drier air does and does not achieve. If the basement is the source, drying it with a larger unit from our <a href="/best-dehumidifier-for-basement/">best basement dehumidifier</a> list may fix the bedroom too.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Our 4 Bedroom Picks
          </h2>

          <p>
            All four are real, currently sold models. We have not measured their noise ourselves, so every decibel figure is the maker's or a retailer's published rating, and where a maker publishes nothing or sources disagree we say so. Capacities for compressor models use the 2019 DOE test; the thermoelectric pick is rated under warmer, wetter conditions. If you need a unit for a damp bathroom instead, see our <a href="/best-bathroom-dehumidifier/">best bathroom dehumidifier</a> guide, which covers different models.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
