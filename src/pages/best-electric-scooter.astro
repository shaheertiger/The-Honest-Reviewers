---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Electric Bikes for Seniors",
    "url": "/best-electric-bike-for-seniors/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  },
  {
    "title": "How Long Do Portable Power Stations Last?",
    "url": "/how-long-do-portable-power-stations-last/"
  },
  {
    "title": "Best Home Battery Backup Systems",
    "url": "/best-home-battery-backup-system/"
  },
  {
    "title": "Best Canoes for River Paddling",
    "url": "/best-canoes-for-river-paddling/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "6 Best Electric Scooters: Commuter, Long-Range and Lightweight Picks";
const description =
  "The best electric scooters for commuting, long range and easy carrying, compared on rated range, motor, weight, water rating, brakes and UL 2272 certification.";

const PRODUCTS = [
  {
