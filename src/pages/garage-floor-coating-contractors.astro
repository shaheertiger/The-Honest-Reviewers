---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Garage Floor Coating Cost", url: "/garage-floor-coating-cost/" },
    { title: "Best Garage Floor Coating", url: "/best-garage-floor-coating/" },
    { title: "Garage Flooring Options", url: "/garage-flooring-options/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "How to Choose a Garage Floor Coating Contractor";
const description =
  "What to ask before signing, the prep questions that separate real installers from crews with a roller, and the warranty terms that mean nothing.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Choosing a Contractor",
          item: "https://www.thehonestreviewers.com/garage-floor-coating-contractors/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What should I ask a garage floor coating contractor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Four things before price: how they will prepare the slab, whether they moisture test first, what product and solids content they are installing, and exactly what the warranty covers. The preparation answer sorts most companies on its own, since grinding is the reliable method and acid etching is not.",
          },
        },
        {
          "@type": "Question",
          name: "How do I know if a garage floor quote is too cheap?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Normalise the scope first: preparation method, crack repair, moisture testing, coat count, topcoat and film thickness. A quote still well below the others has removed something, and it is nearly always the grinding, which is the largest labour cost and the least visible once the coating is down.",
          },
        },
        {
          "@type": "Question",
          name: "Should a contractor moisture test my garage slab?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and a contractor who does not raise it unprompted has skipped the test that decides whether the job should happen at all. Vapour driving up through concrete is the most common cause of coating failure, and most contracts then exclude moisture failure from the warranty.",
          },
        },
        {
          "@type": "Question",
          name: "Are lifetime garage floor coating warranties real?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are only as real as the company behind them, and coating firms rebrand frequently. Check what is covered, what voids it, whether labour is included as well as materials, whether it transfers on sale, and how long the business has traded under its current name.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a professional garage floor coating last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A properly prepared 100% solids epoxy or polyaspartic system should give ten to twenty years in a residential garage. Anything failing well inside that is almost always a preparation or moisture problem rather than a product defect.",
          },
        },
        {
          "@type": "Question",
          name: "Is a one-day garage floor coating any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, when it is a genuine polyaspartic or polyurea system, which cures fast enough to walk on the same evening and is properly UV stable. What matters is whether the same day included real grinding, because the speed should come from the chemistry and not from skipping preparation.",
          },
        },
        {
          "@type": "Question",
          name: "How many quotes should I get for a garage floor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At least three, compared on normalised scope rather than headline price. Treat an outlier low quote as information about what has been left out, and be cautious about discounts that expire today, which are a sales technique rather than a price.",
          },
        },
        {
          "@type": "Question",
          name: "Should I hire someone or do it myself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "DIY is realistic on a dry, sound, modest slab if you can rent a grinder and work to a thirty-minute pot life. Hire for large areas, slabs needing repair, polyaspartic systems, or a marginal moisture test. If the slab is damp or cracked, tiles may beat both options.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "garage floor coating contractors",
      "garage floor coating near me",
      "hiring floor coating installer",
      "home improvement",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Garage Floor Coating Costs",
    link: "/garage-floor-coating-cost/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Choosing a Garage Floor <span class="text-[#38BDF8]">Coating Contractor</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Nearly every failed professional garage floor comes down to preparation that was quoted out to win the job. Four questions asked before you sign will tell you which kind of company you are talking to.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#four-questions"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See What to Ask
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#four-questions" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Four Questions</a>
          <a href="#moisture" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Moisture Testing</a>
          <a href="#system" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The System</a>
          <a href="#warranty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Warranty</a>
          <a href="#vetting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Vetting</a>
          <a href="#quotes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Comparing Quotes</a>
          <a href="#diy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. DIY Instead?</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The product on a garage floor is the cheap part. What you are actually buying from a contractor is slab preparation, and it is the line item most easily removed from a quote without you noticing until the coating lifts.
        </p>

        <div id="four-questions" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Four Questions That Sort Everyone
          </h2>

          <p>
            Ask these before discussing price. The answers separate companies who do this properly from crews who will roll a coating onto a swept floor and be gone.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Question</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Good Answer</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Walk Away If</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">How will you prepare the slab?</td>
                    <td class="px-4 py-4 text-gray-700">Diamond grinding or shot blasting</td>
                    <td class="px-4 py-4 text-gray-700">Acid etch, or "we clean it"</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Will you moisture test first?</td>
                    <td class="px-4 py-4 text-gray-700">Yes, and they describe the method</td>
                    <td class="px-4 py-4 text-gray-700">They have not mentioned it</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">What product and what solids content?</td>
                    <td class="px-4 py-4 text-gray-700">A named system with a spec sheet</td>
                    <td class="px-4 py-4 text-gray-700">Just "epoxy" or a trade name only</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">What exactly does the warranty cover?</td>
                    <td class="px-4 py-4 text-gray-700">Delamination and peeling, in writing</td>
                    <td class="px-4 py-4 text-gray-700">Vague, verbal, or "lifetime"</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The first is the one that matters most. Preparation is the majority of the labour on a proper installation and the easiest thing to skip, because the customer cannot see it once the coating is down. A company quoting noticeably below everyone else has usually found the saving there.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Tell in a Cheap Quote</p>
            <p class="text-xl font-bold text-white mb-3">Ask what the grinder costs them, not what the coating costs.</p>
            <p class="text-gray-300 leading-relaxed m-0">Diamond grinding takes hours, wears consumables, and needs dust extraction. A quote well under the market has almost always removed that step, substituting an acid wash or a pressure wash. Both leave a slab too smooth for the coating to grip, and neither shows any sign of failure until the floor peels a year later, by which time the crew is not answering.</p>
          </div>
        </div>

        <div id="moisture" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Whether They Test the Slab
          </h2>

          <p>
            Concrete on grade wicks vapour from the ground continuously. Put an impermeable coating over a slab that is doing this and the vapour collects underneath until it pushes the film off in sheets, with clean concrete left behind.
          </p>

          <p>
            A contractor who does not raise moisture, unprompted, has told you something important. On a residential garage the minimum is a plastic sheet test left down for 24 to 48 hours; on anything expensive, a calcium chloride or relative humidity test gives a number rather than an impression.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask whether the test happens before the quote is finalised or after the deposit is taken.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask what they do if it comes back wet, and listen for a real answer: a vapour barrier primer, a moisture-tolerant system, or a recommendation not to coat.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Be wary of anyone who says it is not necessary because the garage looks dry, since vapour drive is invisible.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask whether the warranty still applies if they coat a slab that tested marginal.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>On a detached garage or an older slab, ask specifically whether there is a vapour barrier under the concrete.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>If they offer to test while you watch, that is a good sign rather than a sales tactic.</span>
            </li>
          </ul>

          <p>
            A contractor willing to tell you not to coat a floor is worth more than one who will coat anything. Our guide to <a href="/epoxy-flooring/">epoxy flooring</a> covers the test and what the results mean, so you can follow the conversation.
          </p>
        </div>

        <div id="system" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What System They Are Actually Installing
          </h2>

          <p>
            Epoxy covers products that differ enormously, and a quote that says only epoxy tells you nothing about what you are getting.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What to Establish</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why It Matters</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Manufacturer and product name</td>
                    <td class="px-4 py-4 text-gray-700">Lets you read the spec sheet yourself</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solids content</td>
                    <td class="px-4 py-4 text-gray-700">Decides film thickness and service life</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Number of coats</td>
                    <td class="px-4 py-4 text-gray-700">A single thin coat is not the same job</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whether a topcoat is included</td>
                    <td class="px-4 py-4 text-gray-700">UV and abrasion protection sit in the topcoat</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Polyaspartic or epoxy</td>
                    <td class="px-4 py-4 text-gray-700">Different cure time, cost and UV behaviour</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flake or quartz broadcast</td>
                    <td class="px-4 py-4 text-gray-700">Affects grip, appearance and price</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Total dry film thickness</td>
                    <td class="px-4 py-4 text-gray-700">The most honest single measure of what you get</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Ask for the manufacturer's data sheet. A legitimate installer produces it without hesitation, because they chose the system deliberately. A crew working from unbranded drums usually cannot, and that is the answer to your question.
          </p>

          <p>
            Polyaspartic systems are what most one-day installations use, because they cure fast enough to walk on the same evening and are genuinely UV stable. They cost more than epoxy and that premium is real rather than a markup. Our comparisons of <a href="/epoxy-vs-polyaspartic-garage-floor/">epoxy versus polyaspartic</a> and <a href="/polyaspartic-floor-coating/">polyaspartic coatings</a> explain where the difference goes.
          </p>
        </div>

        <div id="warranty" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Reading the Warranty Properly
          </h2>

          <p>
            Warranties in this trade range from genuinely meaningful to decorative, and the length is the least informative part of them.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A lifetime warranty from a company two years old is worth what the company is worth, which may be nothing by the time you claim.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Establish what it covers. Delamination and peeling are the failures that matter; discolouration and wear usually are not covered.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Establish what voids it. Hot tyre pickup, chemical spills and moisture are common exclusions, and moisture is the most common cause of failure.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check whether it is a labour warranty or only a materials warranty, since materials are the cheap part of a redo.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask whether it transfers on sale, which matters if you are coating a house you may move from.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Get it in writing before the deposit, not with the final invoice.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Exclusion to Look For</p>
            <p class="text-xl font-bold text-white mb-3">A moisture exclusion plus no moisture test is a warranty that covers nothing.</p>
            <p class="text-gray-300 leading-relaxed m-0">If the contract excludes failure caused by moisture from beneath, and nobody tested for moisture from beneath, then the single most common failure mode in this trade is not covered and no one established whether it applied to your slab. That combination is the clearest signal available that the warranty is decorative.</p>
          </div>
        </div>

        <div id="vetting" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Vetting the Company Itself
          </h2>

          <p>
            Standard contractor due diligence applies, with a few things specific to this trade.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Confirm insurance and any licensing your area requires, and verify it rather than accepting a number on a page.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask how long they have traded under this name. Coating companies rebrand frequently, and a warranty follows the entity rather than the people.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Ask for addresses of jobs three or more years old rather than recent photographs, because everything looks good the week it is installed.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Read reviews for the word peeling specifically, and read the one and two star reviews first.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Get at least three written quotes, and treat an outlier low quote as information about scope rather than a bargain.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Be cautious with high-pressure discounts that expire today, which are a sales technique rather than a price.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Prefer a modest deposit with the balance on completion, and be wary of a large payment before any work starts.</span>
            </li>
          </ul>

          <p>
            The three-year-old job request is the single most useful one. Any competent crew can hand over a floor that looks immaculate on the day, since a fresh coating always does. What separates them is whether it is still bonded after three winters of hot tyres, road salt and vapour, and only an older installation answers that.
          </p>
        </div>

        <div id="quotes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Comparing Quotes Fairly
          </h2>

          <p>
            Quotes in this trade are difficult to compare because they often describe different amounts of work under similar words. Normalise them before looking at the totals.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Line to Compare</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What to Check</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Preparation method</td>
                    <td class="px-4 py-4 text-gray-700">Grinding, shot blasting, or acid etch</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Crack and pit repair</td>
                    <td class="px-4 py-4 text-gray-700">Included, extra, or ignored entirely</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Moisture testing</td>
                    <td class="px-4 py-4 text-gray-700">Included before work starts</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Total dry film thickness</td>
                    <td class="px-4 py-4 text-gray-700">The honest measure of how much coating</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Number of coats and topcoat</td>
                    <td class="px-4 py-4 text-gray-700">A topcoat is often where the difference sits</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Area measured</td>
                    <td class="px-4 py-4 text-gray-700">Confirm they measured rather than estimated</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cure and return-to-service time</td>
                    <td class="px-4 py-4 text-gray-700">When you can walk on it and park on it</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Making good</td>
                    <td class="px-4 py-4 text-gray-700">Dust containment and clearing the garage</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Once those are level, price differences usually make sense. A quote that is still much lower has removed something from the list, and preparation is almost always what. Our <a href="/garage-floor-coating-cost/">cost guide</a> gives the per square foot ranges so you can tell an aggressive price from an impossible one.
          </p>

          <p>
            Also confirm what you are expected to do. Most contracts require the garage emptied, and some require the vehicle kept off for several days after installation, which is a real inconvenience if you have one parking space and no alternative.
          </p>
        </div>

        <div id="diy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. When to Do It Yourself Instead
          </h2>

          <p>
            Hiring is not automatically right. The professional premium buys grinding equipment, product knowledge and speed, and there are cases where you do not need all three.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Situation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Hire or DIY</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Slab is dry, sound, and modest in size</td>
                    <td class="px-4 py-4 text-gray-700">DIY is realistic</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">You can rent a grinder and extraction</td>
                    <td class="px-4 py-4 text-gray-700">DIY is realistic</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Slab needs crack and spall repair</td>
                    <td class="px-4 py-4 text-gray-700">Lean professional</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">You want polyaspartic</td>
                    <td class="px-4 py-4 text-gray-700">Professional; the working time is very short</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Large or multi-bay garage</td>
                    <td class="px-4 py-4 text-gray-700">Professional</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Moisture test came back marginal</td>
                    <td class="px-4 py-4 text-gray-700">Professional, or choose tiles</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">You want it done in one day</td>
                    <td class="px-4 py-4 text-gray-700">Professional</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Budget is the binding constraint</td>
                    <td class="px-4 py-4 text-gray-700">DIY, or tiles, or a sealer</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The realistic DIY warning is pot life. A 100% solids epoxy can gel in the bucket thirty to forty minutes after mixing, whether or not there is floor left to cover, so the job rewards preparation and small batches rather than confidence. Our guide to <a href="/how-to-epoxy-garage-floor/">epoxying a garage floor</a> walks the full sequence.
          </p>

          <p>
            And if the slab is damp or cracked, the honest answer may be neither. Interlocking tiles and roll-out matting bond to nothing, so vapour cannot lift them and cracks do not telegraph through, and they go down in an afternoon with no preparation at all. Our guide to <a href="/garage-flooring-options/">garage flooring options</a> compares every route.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Choosing on Price Without Normalising Scope</h3>
              <p class="text-gray-700 text-sm m-0">
                Quotes describe different amounts of work under similar words. Level the preparation method, crack repair, moisture testing, coat count, topcoat and film thickness first. A quote still far below the others has removed something, and preparation is almost always what went.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Accepting Acid Etching as Preparation</h3>
              <p class="text-gray-700 text-sm m-0">
                Etching works on bare, porous, untreated concrete and does very little on hard-troweled, previously sealed or oily slabs, with no visible sign it failed until the floor peels. Diamond grinding or shot blasting is what a competent installer uses, and it is most of the labour they are charging for.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Not Asking About Moisture Before the Deposit</h3>
              <p class="text-gray-700 text-sm m-0">
                Vapour driving up through a slab is the most common cause of coating failure, and it is invisible. A contractor who has not raised it before taking money has skipped the test that determines whether the job should happen. Worse, most contracts then exclude moisture failure from the warranty.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Taking a Lifetime Warranty at Face Value</h3>
              <p class="text-gray-700 text-sm m-0">
                Length is the least informative part. Establish what it covers, what voids it, whether labour is included, and how long the company has traded under that name. Coating companies rebrand often, and a warranty follows the entity rather than the people who did your floor.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Asking Only for Recent References</h3>
              <p class="text-gray-700 text-sm m-0">
                Every fresh coating looks immaculate, so photographs from last month prove nothing. Ask for addresses of jobs three or more years old and go and look at one. Whether it is still bonded after three winters of hot tyres and road salt is the only question that matters.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What should I ask a garage floor coating contractor?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Four things before price: how they will prepare the slab, whether they moisture test first, what product and solids content they are installing, and exactly what the warranty covers. The preparation answer sorts most companies on its own, since grinding is the reliable method and acid etching is not.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I know if a garage floor quote is too cheap?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Normalise the scope first: preparation method, crack repair, moisture testing, coat count, topcoat and film thickness. A quote still well below the others has removed something, and it is nearly always the grinding, which is the largest labour cost and the least visible once the coating is down.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should a contractor moisture test my garage slab?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, and a contractor who does not raise it unprompted has skipped the test that decides whether the job should happen at all. Vapour driving up through concrete is the most common cause of coating failure, and most contracts then exclude moisture failure from the warranty.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Are lifetime garage floor coating warranties real?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                They are only as real as the company behind them, and coating firms rebrand frequently. Check what is covered, what voids it, whether labour is included as well as materials, whether it transfers on sale, and how long the business has traded under its current name.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long should a professional garage floor coating last?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A properly prepared 100% solids epoxy or polyaspartic system should give ten to twenty years in a residential garage. Anything failing well inside that is almost always a preparation or moisture problem rather than a product defect.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is a one-day garage floor coating any good?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, when it is a genuine polyaspartic or polyurea system, which cures fast enough to walk on the same evening and is properly UV stable. What matters is whether the same day included real grinding, because the speed should come from the chemistry and not from skipping preparation.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How many quotes should I get for a garage floor?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                At least three, compared on normalised scope rather than headline price. Treat an outlier low quote as information about what has been left out, and be cautious about discounts that expire today, which are a sales technique rather than a price.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should I hire someone or do it myself?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                DIY is realistic on a dry, sound, modest slab if you can rent a grinder and work to a thirty-minute pot life. Hire for large areas, slabs needing repair, polyaspartic systems, or a marginal moisture test. If the slab is damp or cracked, tiles may beat both options.
              </p>
            </div>
          </div>
        </div>

