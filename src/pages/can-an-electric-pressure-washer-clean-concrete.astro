---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Best Surface Cleaners", url: "/best-surface-cleaner-for-pressure-washer/" },
    { title: "Best Driveway Cleaners", url: "/best-driveway-cleaner/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "Can an Electric Pressure Washer Clean Concrete?";
const description =
  "Yes, above roughly 4,000 cleaning units. Below that you brighten concrete rather than clean it, and a surface cleaner changes the math.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Electric Pressure Washers on Concrete",
          item: "https://www.thehonestreviewers.com/can-an-electric-pressure-washer-clean-concrete/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can an electric pressure washer clean a concrete driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A strong one can. Above roughly 4,000 cleaning units, meaning PSI multiplied by GPM, an electric machine genuinely removes embedded algae and dirt. Below that it brightens the surface rather than cleaning it, which is the difference behind the conflicting reviews in this category.",
          },
        },
        {
          "@type": "Question",
          name: "What size electric pressure washer do I need for concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Aim for 4,000 cleaning units minimum and 6,000 if the budget allows. In practice that means something like 3,000 PSI at 2.0 GPM. Prioritise flow within your pressure band, because on a flat surface nothing helps clear debris and water volume does the work.",
          },
        },
        {
          "@type": "Question",
          name: "Is 2000 PSI enough to clean concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It sits at the bottom of the useful range, so it will work but slowly, and it will brighten a lightly soiled slab more convincingly than it removes embedded growth. Paired with a dedicated cleaner and a correctly sized surface cleaner, it becomes genuinely usable.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a surface cleaner for concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the highest-value accessory in the category. It roughly doubles speed on flat concrete and eliminates the striping a hand-waved wand produces. Check the minimum GPM it needs, though, because a low-flow machine may spin the disc sluggishly or not at all.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my driveway still look dirty after pressure washing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually one of three things: the machine brightened rather than cleaned, the stain is not dirt, or you judged it while wet. Oil, rust, efflorescence and simple weathering are not removable by pressure, and concrete never returns to the colour it was when poured.",
          },
        },
        {
          "@type": "Question",
          name: "Will a pressure washer damage concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sound concrete tolerates 2,000 to 3,000 PSI, but a narrow tip held close and paused will etch it and leave permanent striping. Old, soft or spalling concrete needs far less, and paver joint sand and soft mortar wash out well below the pressure the masonry itself withstands.",
          },
        },
        {
          "@type": "Question",
          name: "How long does an electric pressure washer take on a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Longer than gas, and how much longer depends mostly on the accessory rather than the machine. A strong electric unit with a surface cleaner and a proper cleaner handles a two-car driveway in a comfortable afternoon. The same machine with only a wand takes considerably longer.",
          },
        },
        {
          "@type": "Question",
          name: "Should I seal the concrete after cleaning it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If the goal is uniform appearance rather than cleanliness, yes. Washing is the preparation step; a sealer evens out colour and keeps the surface cleaner for longer. That combination is usually what people actually want when they say a driveway looks tired.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "can an electric pressure washer clean concrete",
      "electric pressure washer driveway",
      "best electric pressure washer for concrete",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Straight Answer
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Can Electric Clean <span class="text-[#38BDF8]">Concrete?</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          This is the objection the whole category is built around, and the honest answer has a threshold in it. Some electric machines genuinely clean concrete. Most of the ones people buy do not.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#the-threshold"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Threshold
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#the-threshold" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Threshold</a>
          <a href="#surface-cleaner" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Surface Cleaner</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Chemistry First</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Technique</a>
          <a href="#expectations" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Realistic Expectations</a>
          <a href="#buying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. What to Buy</a>
          <a href="#pavers-and-masonry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Pavers and Brick</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The difference between brightening concrete and cleaning it is roughly 4,000 cleaning units. Below that threshold you get a surface that looks better while wet and disappoints when it dries. Above it, embedded dirt actually leaves.
        </p>

        <div id="the-threshold" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Output Threshold
          </h2>

          <p>
            Cleaning units, pressure multiplied by flow, is the number that decides this. Concrete is the most demanding common surface because it is flat and porous: nothing helps clear debris, so water volume has to do all of it, and dirt sits inside the surface rather than on it.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Machine</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">PSI</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">GPM</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cleaning Units</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">On Concrete</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Small electric</td>
                    <td class="px-4 py-4 text-gray-700">1,800</td>
                    <td class="px-4 py-4 text-gray-700">1.2</td>
                    <td class="px-4 py-4 text-gray-700">2,160</td>
                    <td class="px-4 py-4 text-gray-700">Rinses only</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premium brushless</td>
                    <td class="px-4 py-4 text-gray-700">2,300</td>
                    <td class="px-4 py-4 text-gray-700">1.2</td>
                    <td class="px-4 py-4 text-gray-700">2,760</td>
                    <td class="px-4 py-4 text-gray-700">Brightens; slow on embedded dirt</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Mid electric</td>
                    <td class="px-4 py-4 text-gray-700">2,000</td>
                    <td class="px-4 py-4 text-gray-700">1.4</td>
                    <td class="px-4 py-4 text-gray-700">2,800</td>
                    <td class="px-4 py-4 text-gray-700">Brightens; slow</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Popular budget electric</td>
                    <td class="px-4 py-4 text-gray-700">2,030</td>
                    <td class="px-4 py-4 text-gray-700">1.76</td>
                    <td class="px-4 py-4 text-gray-700">3,573</td>
                    <td class="px-4 py-4 text-gray-700">Marginal, usable with chemistry</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strong electric</td>
                    <td class="px-4 py-4 text-gray-700">3,000</td>
                    <td class="px-4 py-4 text-gray-700">2.0</td>
                    <td class="px-4 py-4 text-gray-700">6,000</td>
                    <td class="px-4 py-4 text-gray-700">Genuinely cleans</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Entry-level gas</td>
                    <td class="px-4 py-4 text-gray-700">3,100</td>
                    <td class="px-4 py-4 text-gray-700">2.4</td>
                    <td class="px-4 py-4 text-gray-700">7,440</td>
                    <td class="px-4 py-4 text-gray-700">Cleans faster still</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Read down the last column and the picture is clear. The machines most people buy, in the 2,500 to 3,000 cleaning unit range, brighten concrete. They lift loose surface dirt and leave the embedded algae and ground-in grime that make a driveway look tired. That is the gap between the reviews saying electric works fine and the reviews saying it does nothing.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Brightening vs Cleaning</p>
            <p class="text-xl font-bold text-white mb-3">The test is what it looks like once it dries.</p>
            <p class="text-gray-300 leading-relaxed m-0">Wet concrete always looks clean, which is why people declare victory mid-job and are disappointed an hour later. If the difference between the washed strip and the unwashed strip disappears as it dries, you brightened it. If a hard edge remains once both are dry, you cleaned it. Judge every machine and every technique on the dry result.</p>
          </div>
        </div>

        <div id="surface-cleaner" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Attachment That Changes the Math
          </h2>

          <p>
            A surface cleaner is a shrouded disc with rotating jets that you push across flat concrete. It is the single highest-value accessory in this category, and it changes what a mid-range electric machine can accomplish more than any spec upgrade would.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>It roughly doubles cleaning speed on flat concrete, because the spinning jets cover a wide path rather than a narrow fan.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>It eliminates the striping that hand-waving a wand always produces, since the coverage is even by design.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>It holds a consistent standoff distance automatically, which is most of what good technique achieves manually.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>It keeps the spray contained under the shroud rather than throwing dirty water across the garage door.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>It works the surface from multiple angles as the disc rotates, which lifts more from a porous surface.</span>
            </li>
          </ul>

          <p>
            The caveat is flow. Some surface cleaners specify a minimum GPM to spin properly, and a 1.2 GPM machine may turn the disc sluggishly or not at all. Check the minimum flow in the specification before buying, and confirm the fitting matches your machine rather than being proprietary, which catches out owners of certain brands. Our guide to <a href="/best-surface-cleaner-for-pressure-washer/">surface cleaners</a> covers sizing for lower-flow electric machines specifically.
          </p>

          <p>
            Size matters in the other direction too. A large-diameter surface cleaner on a low-flow machine spreads the available water too thin and cleans poorly across the whole path. On a modest electric unit, a smaller disc concentrates the output and gives a better result, even though it covers less ground per pass.
          </p>
        </div>

        <div id="chemistry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Chemistry Matters More Here Than Anywhere
          </h2>

          <p>
            This is where a marginal electric machine becomes an adequate one. Concrete dirt is largely organic growth plus embedded grime, and both respond far better to a dwelling cleaner than to additional pressure.
          </p>

          <p>
            Apply a dedicated concrete or driveway cleaner with the black soap nozzle, which is the only tip that lets the detergent siphon engage. Let it dwell for the time the product specifies without letting it dry, then rinse. On a machine producing 3,000 cleaning units, that sequence does more than upgrading to 4,500 would.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Stain Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What Removes It</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pressure Alone?</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Algae and green growth</td>
                    <td class="px-4 py-4 text-gray-700">Cleaner plus dwell time</td>
                    <td class="px-4 py-4 text-gray-700">Slowly and incompletely</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">General grime and road film</td>
                    <td class="px-4 py-4 text-gray-700">Detergent plus flow</td>
                    <td class="px-4 py-4 text-gray-700">Partly</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Oil and transmission fluid</td>
                    <td class="px-4 py-4 text-gray-700">Degreaser or poultice</td>
                    <td class="px-4 py-4 text-gray-700">No, at any pressure</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rust stains</td>
                    <td class="px-4 py-4 text-gray-700">Oxalic acid based remover</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Tyre marks</td>
                    <td class="px-4 py-4 text-gray-700">Degreaser plus agitation</td>
                    <td class="px-4 py-4 text-gray-700">Rarely</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Efflorescence</td>
                    <td class="px-4 py-4 text-gray-700">Specific masonry treatment</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Leaf and tannin stains</td>
                    <td class="px-4 py-4 text-gray-700">Oxygenated cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Partly</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Only one row on that table is genuinely a pressure problem. Oil in particular is worth understanding: it soaks into porous concrete and no amount of pressure lifts what has penetrated below the surface. It needs a degreaser or an absorbent poultice that draws it back out. Our guides to <a href="/how-to-remove-oil-stains-from-driveway/">removing oil stains</a> and <a href="/best-driveway-cleaner/">driveway cleaners</a> cover the products that work.
          </p>
        </div>

        <div id="technique" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Technique for Flat Concrete
          </h2>

          <p>
            Good technique on concrete is mostly about consistency, because the failure mode here is not damage but visible unevenness that you cannot fix afterwards.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Use a 25 degree green nozzle if you are using a wand, or a surface cleaner if you have one.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Sweep in steady, overlapping passes at a constant distance and angle, and never pause mid-stroke.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Work in manageable sections so cleaner does not dry before you rinse it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the same standoff distance throughout; changing it mid-panel creates a visible line.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Overlap each pass by about a third, which hides the edge of the previous one.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Work with the slope so dirty water runs off the area you have finished rather than across it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse the whole slab at the end, including the parts you thought were clean.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Striping Is Permanent Until You Redo It</p>
            <p class="text-xl font-bold text-white mb-3">Uneven cleaning shows up worse than dirt did.</p>
            <p class="text-gray-300 leading-relaxed m-0">A driveway with clean stripes and dirty gaps looks considerably worse than a uniformly dirty one, and the only remedy is doing the whole slab again to the standard of the cleanest part. That is why consistency matters more than power here: a modest machine used evenly gives a better result than a strong one waved around.</p>
          </div>

          <p>
            Sound concrete tolerates 2,000 to 3,000 PSI, but a narrow tip held close and paused will etch the surface. Old, soft or spalling concrete needs a good deal less, and brick and paver joints will wash out well below the pressure the pavers themselves tolerate. If sand starts appearing in the runoff on pavers, stop.
          </p>
        </div>

        <div id="expectations" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Setting Honest Expectations
          </h2>

          <p>
            Even a capable electric machine takes longer on a driveway than gas does, and knowing the real numbers prevents the disappointment that generates most of the bad reviews in this category.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Setup</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Two-Car Driveway</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Low-output electric, wand only</td>
                    <td class="px-4 py-4 text-gray-700">Hours, with a mediocre result</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Low-output electric, cleaner plus surface cleaner</td>
                    <td class="px-4 py-4 text-gray-700">A long session, acceptable result</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strong electric, wand only</td>
                    <td class="px-4 py-4 text-gray-700">A long session, good result</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strong electric plus surface cleaner</td>
                    <td class="px-4 py-4 text-gray-700">A comfortable afternoon, good result</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Entry gas plus surface cleaner</td>
                    <td class="px-4 py-4 text-gray-700">Meaningfully quicker, good result</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Note that the accessory moves the result more than the machine does in the middle rows. That is the practical finding: for a homeowner cleaning a driveway once or twice a year, a strong electric machine with a surface cleaner and a proper cleaner is a genuinely good answer, and the gas machine buys time rather than quality.
          </p>

          <p>
            Some things will not come clean regardless. Old oil that has soaked deep, rust that has penetrated, and concrete that is simply weathered and greyed are not dirt, and no machine removes them. Concrete also does not return to the colour it was when poured, and expecting that is the most common cause of disappointment with an otherwise successful job.
          </p>

          <p>
            If the goal is uniform appearance rather than cleanliness, cleaning is the first step of a different project. A <a href="/best-concrete-sealer/">concrete sealer</a> applied after washing evens out colour and keeps the surface cleaner for longer, and it is what most people actually want when they say a driveway looks tired.
          </p>
        </div>

        <div id="buying" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. What to Buy If Concrete Is the Job
          </h2>

          <p>
            If flat concrete is the main reason you are buying a pressure washer, shop differently than you would for siding and cars.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Target 4,000 cleaning units as a minimum and 6,000 if the budget allows, computed as PSI multiplied by GPM.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Prioritise flow within your pressure band, because water volume is what does the clearing on a flat surface.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Budget for a surface cleaner from the start and check its minimum GPM against your machine.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Confirm the accessory fitting is a standard quick-connect rather than proprietary.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check the machine can run on a circuit you actually have; a high-output unit wants a dedicated 20-amp supply.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Prefer an induction motor for a job measured in hours, where universal motors fade as they heat.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Look for PWMA or CETA certification, because the gap between claimed and delivered pressure widens at the budget end.</span>
            </li>
          </ul>

          <p>
            The circuit point is not incidental for this category of machine. A 3,000 PSI, 2.0 GPM unit draws enough current to trip a shared 15-amp circuit, particularly at startup, and sharing with a garage freezer produces nuisance trips and a quietly thawing freezer. Sort that out before the machine arrives. Our <a href="/pressure-washer-extension-cord-size/">cord and circuit guide</a> covers what it needs.
          </p>

          <p>
            And be honest about frequency, because it changes the answer entirely. A long driveway cleaned every few weeks is a genuine argument for gas or for a rental. A driveway cleaned once a year is comfortably electric work, and the quiet machine will get used for the siding, furniture and cars that a gas unit never gets dragged out for. Our <a href="/electric-vs-gas-pressure-washer/">electric versus gas comparison</a> works through that decision.
          </p>
        </div>

        <div id="pavers-and-masonry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Pavers, Brick and Softer Masonry
          </h2>

          <p>
            Not all masonry behaves like a poured slab, and the differences matter more than the pressure setting does.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pressure</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">The Real Risk</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sound poured concrete</td>
                    <td class="px-4 py-4 text-gray-700">2,000-3,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">Etching and striping from a paused wand</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete pavers</td>
                    <td class="px-4 py-4 text-gray-700">1,500-2,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">Washing out the joint sand</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brick with sound mortar</td>
                    <td class="px-4 py-4 text-gray-700">2,000-2,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">Mortar erosion if it is soft</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brick with old soft mortar</td>
                    <td class="px-4 py-4 text-gray-700">Chemistry only</td>
                    <td class="px-4 py-4 text-gray-700">Losing the joints entirely</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Natural stone</td>
                    <td class="px-4 py-4 text-gray-700">1,200-2,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">Surface damage varies hugely by stone</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stamped or coloured concrete</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,800 PSI</td>
                    <td class="px-4 py-4 text-gray-700">Damaging the sealer and colour layer</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Spalling or crumbling concrete</td>
                    <td class="px-4 py-4 text-gray-700">Very low or none</td>
                    <td class="px-4 py-4 text-gray-700">Accelerating the failure</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Pavers are the case people most often get wrong. The pavers themselves are tough, but the polymeric or joint sand between them is not, and washing it out means re-sanding the whole area afterwards. Keep the stream at a shallow angle rather than pointing down into the joints, and stop as soon as sand appears in the runoff.
          </p>

          <p>
            Stamped and coloured concrete deserves particular care because what you are cleaning is often a sealer rather than the concrete itself. Damage that layer and the result is patchy colour that needs stripping and resealing to fix, which is a considerably larger job than the cleaning was.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Judging the Result While It Is Still Wet</h3>
              <p class="text-gray-700 text-sm m-0">
                Wet concrete always looks clean, which is why people finish a section, declare it a success and are disappointed an hour later. Judge every machine and every technique on the dry result: if the line between washed and unwashed disappears as it dries, you brightened the surface rather than cleaning it.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying on PSI and Ignoring Flow</h3>
              <p class="text-gray-700 text-sm m-0">
                A 2,300 PSI machine at 1.2 GPM produces 2,760 cleaning units, less than a 2,030 PSI machine at 1.76 GPM. On flat concrete nothing helps clear debris, so water volume does the work. Judging a driveway machine by its headline pressure picks the wrong one almost every time.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying a Surface Cleaner Without Checking Flow</h3>
              <p class="text-gray-700 text-sm m-0">
                Many surface cleaners specify a minimum GPM to spin the disc properly, and a low-flow machine will turn it sluggishly or not at all. Check that figure against your machine before buying, and note that a smaller disc often works better than a large one on modest electric units.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Pausing the Wand Mid-Stroke</h3>
              <p class="text-gray-700 text-sm m-0">
                Cleaning is a function of dwell time as much as pressure, so a stationary stream removes progressively more from one spot. That is what produces the tiger-striping people blame on the machine. A driveway with clean stripes looks worse than a uniformly dirty one, and the only fix is redoing the whole slab.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Expecting Pressure to Remove Oil</h3>
              <p class="text-gray-700 text-sm m-0">
                Oil soaks into porous concrete, and no pressure lifts what has penetrated below the surface. It needs a degreaser or an absorbent poultice that draws it back out. The same is true of rust, efflorescence and general weathering, none of which are dirt and none of which a stronger machine will fix.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can an electric pressure washer clean a concrete driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A strong one can. Above roughly 4,000 cleaning units, meaning PSI multiplied by GPM, an electric machine genuinely removes embedded algae and dirt. Below that it brightens the surface rather than cleaning it, which is the difference behind the conflicting reviews in this category.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What size electric pressure washer do I need for concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Aim for 4,000 cleaning units minimum and 6,000 if the budget allows. In practice that means something like 3,000 PSI at 2.0 GPM. Prioritise flow within your pressure band, because on a flat surface nothing helps clear debris and water volume does the work.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is 2000 PSI enough to clean concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It sits at the bottom of the useful range, so it will work but slowly, and it will brighten a lightly soiled slab more convincingly than it removes embedded growth. Paired with a dedicated cleaner and a correctly sized surface cleaner, it becomes genuinely usable.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I need a surface cleaner for concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is the highest-value accessory in the category. It roughly doubles speed on flat concrete and eliminates the striping a hand-waved wand produces. Check the minimum GPM it needs, though, because a low-flow machine may spin the disc sluggishly or not at all.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does my driveway still look dirty after pressure washing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Usually one of three things: the machine brightened rather than cleaned, the stain is not dirt, or you judged it while wet. Oil, rust, efflorescence and simple weathering are not removable by pressure, and concrete never returns to the colour it was when poured.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Will a pressure washer damage concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Sound concrete tolerates 2,000 to 3,000 PSI, but a narrow tip held close and paused will etch it and leave permanent striping. Old, soft or spalling concrete needs far less, and paver joint sand and soft mortar wash out well below the pressure the masonry itself withstands.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does an electric pressure washer take on a driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Longer than gas, and how much longer depends mostly on the accessory rather than the machine. A strong electric unit with a surface cleaner and a proper cleaner handles a two-car driveway in a comfortable afternoon. The same machine with only a wand takes considerably longer.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should I seal the concrete after cleaning it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                If the goal is uniform appearance rather than cleanliness, yes. Washing is the preparation step; a sealer evens out colour and keeps the surface cleaner for longer. That combination is usually what people actually want when they say a driveway looks tired.
              </p>
            </div>
          </div>
        </div>

