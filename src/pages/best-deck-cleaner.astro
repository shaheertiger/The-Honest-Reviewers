                                <th class="px-4 py-4 font-bold text-gray-600 text-sm">Problem</th>
                                <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cleaner Chemistry</th>
                                <th class="px-4 py-4 font-bold text-gray-600 text-sm">What It Fixes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bg-white border-b border-gray-100">
                                <td class="px-4 py-4 font-black text-gray-900">Routine dirt &amp; grime</td>
                                <td class="px-4 py-4 text-gray-700">Sodium percarbonate / oxygen bleach</td>
                                <td class="px-4 py-4 text-gray-700">Surface contamination, pollen, tannin staining</td>
                            </tr>
                            <tr class="bg-gray-50 border-b border-gray-100">
