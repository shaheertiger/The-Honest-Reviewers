                                <td class="px-4 py-4 text-gray-700">UV-degraded lignin and iron-tannate discoloration</td>
                            </tr>
                            <tr class="bg-white border-b border-gray-100">
                                <td class="px-4 py-4 font-black text-gray-900">Mold, mildew, algae</td>
                                <td class="px-4 py-4 text-gray-700">Mildewcide-strength oxidizer</td>
                                <td class="px-4 py-4 text-gray-700">Biological growth, including root-level hyphae</td>
                            </tr>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <td class="px-4 py-4 font-black text-gray-900">New / mill-glazed wood</td>
                                <td class="px-4 py-4 text-gray-700">Oxygen bleach with etching action</td>
                                <td class="px-4 py-4 text-gray-700">Compressed mill glaze blocking absorption</td>
                            </tr>
