---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Best Pressure Washers", url: "/best-pressure-washer/" },
    { title: "What Not to Pressure Wash", url: "/what-not-to-pressure-wash/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "What PSI Pressure Washer Do I Need?";
const description =
  "A surface-by-surface PSI chart, from 1,200 PSI for painted wood to 3,000 for concrete, plus why buying more pressure than you need causes damage.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What PSI Do I Need?",
          item: "https://www.thehonestreviewers.com/what-psi-pressure-washer-do-i-need/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What PSI pressure washer do I need for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most households, between 1,500 and 2,300 PSI. That covers vehicles, patio furniture, decks, fences and vinyl siding comfortably. Only concrete, brick and pavers ask for 2,000-3,000 PSI, and even then flow matters as much as pressure for how quickly the work goes.",
          },
        },
        {
          "@type": "Question",
          name: "Is 2000 PSI enough for a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It sits at the bottom of the useful range for concrete, so it will work but slowly, and it will brighten a lightly soiled driveway more convincingly than it removes embedded algae. Pair it with a dedicated driveway cleaner and a surface cleaner attachment and it becomes genuinely capable.",
          },
        },
        {
          "@type": "Question",
          name: "What PSI is safe for a wood deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "1,200 to 1,800 PSI with a 25 degree green nozzle, keeping the wand moving constantly. Above that you raise the grain and leave a furred, splintery surface that only sanding fixes. Applying a deck cleaner first and letting it dwell does most of the work at far lower risk.",
          },
        },
        {
          "@type": "Question",
          name: "What PSI is safe for vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "1,500 to 2,000 PSI with a 40 or 25 degree nozzle. Technique matters more than the number: spray downward or level and never upward under the laps, because upward spray drives water behind the boards into the wall, where the damage does not show for months.",
          },
        },
        {
          "@type": "Question",
          name: "Can 3000 PSI damage concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sound concrete tolerates it, but a narrow nozzle held close and paused will etch the surface and leave visible striping. Soft or old mortar in brick and paver joints washes out well below that figure. Use a 25 degree tip or a surface cleaner, and keep moving in overlapping passes.",
          },
        },
        {
          "@type": "Question",
          name: "Is higher PSI always better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Above the level a surface tolerates you stop cleaning and start removing the surface, and wood, paint and mortar do not grow back. Higher pressure also usually means a heavier, louder, more expensive machine, most of whose capability you will deliberately never use.",
          },
        },
        {
          "@type": "Question",
          name: "What PSI do I need to wash a car?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Up to about 1,500 PSI with a 40 degree white nozzle, kept at a sensible distance from paint. Vehicles are the lowest-pressure job on the chart, and most damage comes from a narrow tip held close at a panel edge or an existing stone chip, where the clear coat lifts.",
          },
        },
        {
          "@type": "Question",
          name: "Does PSI matter more than GPM?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither alone tells you much. Pressure breaks the bond between dirt and surface, flow carries the debris away and decides how wide a path you clean per pass. On vertical surfaces gravity helps with the second job, so pressure dominates. On flat concrete nothing helps, so flow is what makes it fast.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "what psi pressure washer do i need",
      "pressure washer psi chart",
      "psi for pressure washing",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Sizing Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          What PSI Pressure <span class="text-[#38BDF8]">Washer Do I Need?</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most people buy more pressure than any surface they own can tolerate, then use it through a wide nozzle at a distance to avoid damage. Here is what each job actually wants.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#psi-chart"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the PSI Chart
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="18.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#psi-chart" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The PSI Chart</a>
          <a href="#psi-is-not-the-spec" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. PSI Is Not the Spec</a>
          <a href="#max-psi" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The PSI Max Problem</a>
          <a href="#by-household" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. By Household</a>
          <a href="#damage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. What Damage Looks Like</a>
          <a href="#less-pressure" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How to Need Less</a>
          <a href="#distance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Distance Matters</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          More pressure is not better. Above the level a surface tolerates you stop cleaning and start removing the surface, and wood, paint and mortar do not grow back. For most households the honest answer is between 1,500 and 2,300 PSI.
        </p>

        <div id="psi-chart" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The PSI Chart by Surface
          </h2>

          <p>
            This is the table to buy from. Find the most demanding surface you will actually clean, and buy a machine that reaches it comfortably rather than the highest number on the shelf.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sensible Pressure</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Nozzle</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vehicles</td>
                    <td class="px-4 py-4 text-gray-700">Up to ~1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg; white</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Painted wood, soft siding</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg; white</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vinyl siding, fences</td>
                    <td class="px-4 py-4 text-gray-700">1,500-2,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg; or 25&deg;</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wood decks</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,800 PSI</td>
                    <td class="px-4 py-4 text-gray-700">25&deg; green, keep moving</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Concrete, brick, pavers</td>
                    <td class="px-4 py-4 text-gray-700">2,000-3,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">25&deg; or surface cleaner</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Patio furniture, grills</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,700 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg; white</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Gutters and soffits</td>
                    <td class="px-4 py-4 text-gray-700">1,500-2,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg;, extension wand</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Read the top four rows again. Everything except masonry sits below 2,000 PSI, which is why a mid-range electric machine covers the great majority of household cleaning without ever approaching its limit. The only row that asks for serious output is the last one, and only when the concrete is genuinely dirty rather than dusty.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Rule That Prevents Damage</p>
            <p class="text-xl font-bold text-white mb-3">Use the widest nozzle that does the job.</p>
            <p class="text-gray-300 leading-relaxed m-0">Start with the widest tip you have, standing roughly ten feet back, and close the distance gradually while watching what the spray does. If the widest tip at close range still is not shifting the dirt, step down one nozzle angle, not three. That single habit prevents almost every case of etched siding, furred wood and stripped paint, because you find the surface limit before you cross it rather than after.</p>
          </div>
        </div>

        <div id="psi-is-not-the-spec" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Why PSI Is Not the Spec You Should Shop On
          </h2>

          <p>
            PSI is pressure, the force that breaks dirt loose. GPM is flow, the water volume that carries it away and covers area. Multiply them and you get cleaning units, which is the closest thing this category has to a single measure of capability.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Machine</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">PSI</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">GPM</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cleaning Units</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Higher pressure, low flow</td>
                    <td class="px-4 py-4 text-gray-700">2,300</td>
                    <td class="px-4 py-4 text-gray-700">1.2</td>
                    <td class="px-4 py-4 text-gray-700">2,760</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lower pressure, higher flow</td>
                    <td class="px-4 py-4 text-gray-700">2,030</td>
                    <td class="px-4 py-4 text-gray-700">1.76</td>
                    <td class="px-4 py-4 text-gray-700">3,573</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strong electric</td>
                    <td class="px-4 py-4 text-gray-700">3,000</td>
                    <td class="px-4 py-4 text-gray-700">2.0</td>
                    <td class="px-4 py-4 text-gray-700">6,000</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Entry-level gas, for scale</td>
                    <td class="px-4 py-4 text-gray-700">3,100</td>
                    <td class="px-4 py-4 text-gray-700">2.4</td>
                    <td class="px-4 py-4 text-gray-700">7,440</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The second row is the important one. A machine advertised at 2,030 PSI delivers roughly 30 percent more cleaning capability than one advertised at 2,300, because it moves nearly 50 percent more water. Shopping on the headline pressure figure alone would pick the weaker machine and feel confident about it.
          </p>

          <p>
            This is why the practical answer to what PSI you need is usually a range rather than a number, and why the follow-up question, how much flow, matters just as much. Our <a href="/pressure-washer-psi-vs-gpm/">PSI versus GPM guide</a> works through the trade-off in full.
          </p>
        </div>

        <div id="max-psi" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The PSI Max Problem
          </h2>

          <p>
            The pressure figure printed in large type on the box is not governed by any law, and some brands measure it where the number comes out highest: inside the machine, at the pump, with no nozzle fitted, rather than at the nozzle where the water meets the dirt.
          </p>

          <p>
            That figure is usually flagged with an asterisk and the word Max. PSI Max, GPM Max. It is not necessarily a lie, but it describes a pressure you will never experience while cleaning anything. Two machines advertised at 3,000 PSI can differ substantially in the real world if one number is certified at the nozzle and the other is an internal maximum.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Two Letters Worth Looking For</h3>

          <p>
            PWMA, the Pressure Washer Manufacturers' Association, and CETA, the Cleaning Equipment Trade Association, both run certification programmes defining how pressure and flow must be measured and reported. A machine carrying either mark has had its numbers verified against a published standard. A machine with neither may still be honest; it simply has not been checked.
          </p>

          <p>
            The gap between advertised and delivered pressure tends to widen as price falls, which is exactly where buyers rely most on the printed number. If you are shopping under $200, weight and motor type tell you more about the machine than the PSI figure does.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">How to Spot an Optimistic Number</p>
            <p class="text-xl font-bold text-white mb-3">Look for the asterisk, then find the footnote.</p>
            <p class="text-gray-300 leading-relaxed m-0">If a listing quotes PSI with an asterisk, the footnote usually admits the figure is measured internally. If pressure and flow are quoted with no nozzle reference and the machine is unusually light for its claimed output, treat the number as optimistic. Between two machines at the same price where one is certified and one prints a Max figure, the certified one is the safer purchase and it is not close.</p>
          </div>
        </div>

        <div id="by-household" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Matching PSI to Your Actual Household
          </h2>

          <p>
            Rather than asking what the maximum is, work out which of these three profiles you fit. Almost everyone fits one cleanly.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The 1,500-1,800 PSI Household</h3>

          <p>
            Vehicles, patio furniture, a small deck, a fence, bikes and bins. No large concrete. A light machine in this range does all of it, costs the least, stores on a shelf, and is quiet enough to use whenever you feel like it. Buying 3,000 PSI for this list means owning a heavier machine you will operate at reduced pressure through a wide nozzle forever.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The 2,000-2,300 PSI Household</h3>

          <p>
            The same list plus vinyl siding, a larger deck, a patio, and a driveway once or twice a year. This is the most common profile and the range most mid-market electric machines target. Concrete is possible here rather than fast, and a surface cleaner attachment plus a proper cleaner does more for the driveway than another 500 PSI would.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The 2,500-3,000 PSI Household</h3>

          <p>
            A long driveway, a big patio, or masonry that genuinely needs work, cleaned on a regular schedule rather than annually. Here the pressure is usable, but only if the flow comes with it. A 3,000 PSI machine at 2.0 GPM is a serious tool; a 3,000 PSI machine at 1.2 GPM is a slow one with an impressive box.
          </p>

          <p>
            Above 3,000 PSI, consumer machines start asking questions about circuits, weight and storage that most households answer badly. If your jobs genuinely need more than this, the honest comparison is against <a href="/electric-vs-gas-pressure-washer/">a gas machine or a rental</a> rather than the top of the electric range.
          </p>
        </div>

        <div id="damage" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What Too Much Pressure Actually Does
          </h2>

          <p>
            The failures are specific and recognisable, and every one of them is permanent. Knowing what they look like makes the case for restraint better than any warning does.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What Excess Pressure Does</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Reversible?</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wood decking</td>
                    <td class="px-4 py-4 text-gray-700">Raises the grain, leaves a furred, splintery surface</td>
                    <td class="px-4 py-4 text-gray-700">Only by sanding</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vinyl siding</td>
                    <td class="px-4 py-4 text-gray-700">Drives water behind the boards into the wall</td>
                    <td class="px-4 py-4 text-gray-700">No, and it may not show for months</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Painted wood</td>
                    <td class="px-4 py-4 text-gray-700">Strips and lifts paint in patches</td>
                    <td class="px-4 py-4 text-gray-700">Repaint</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Soft mortar</td>
                    <td class="px-4 py-4 text-gray-700">Washes joints out of brickwork</td>
                    <td class="px-4 py-4 text-gray-700">Repointing</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Window seals</td>
                    <td class="px-4 py-4 text-gray-700">Forces water past old glazing</td>
                    <td class="px-4 py-4 text-gray-700">Reglazing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vehicle paint</td>
                    <td class="px-4 py-4 text-gray-700">Lifts clear coat at chips and edges</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Roof shingles</td>
                    <td class="px-4 py-4 text-gray-700">Strips protective granules</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AC condenser fins</td>
                    <td class="px-4 py-4 text-gray-700">Flattens fins and cuts efficiency</td>
                    <td class="px-4 py-4 text-gray-700">Fin comb, partly</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Note how many of these are invisible at the time. Water driven behind vinyl siding by an upward spray does not announce itself; it shows up later as damp or mould inside the wall. That is why technique on siding is a rule rather than a preference: spray downward or level, never upward under the laps.
          </p>

          <p>
            Dwell time compounds pressure. A stationary stream removes progressively more material from one spot, which is why pausing mid-stroke produces the tiger-striping on decks and driveways people blame on the machine. Keep the wand moving in steady, overlapping passes at a constant distance and angle. Our list of <a href="/what-not-to-pressure-wash/">what not to pressure wash at all</a> covers the surfaces where no pressure is the right answer.
          </p>
        </div>

        <div id="less-pressure" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. How to Need Less Pressure
          </h2>

          <p>
            The most effective way to clean a difficult surface is almost never more pressure. It is letting chemistry do the work first, which matters more on electric machines than gas ones because there is less raw output to spare.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Apply a dedicated cleaner with the black soap nozzle, which is the only tip that lets the detergent siphon engage at all.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Let it dwell for several minutes without drying, which is where the actual cleaning happens on algae, mildew and road film.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse with the widest nozzle that works, stepping down only if the surface genuinely needs it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>On flat concrete, use a surface cleaner rather than a wand, which roughly doubles speed and eliminates striping.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>On siding, apply from the bottom up so the cleaner cannot run down dry surfaces and streak, then rinse from the top down.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pre-wet the surface and surrounding plants, which both improves cleaner performance and protects landscaping.</span>
            </li>
          </ul>

          <p>
            A proper cleaner that dwells on the surface breaks down organic growth chemically, so you need far less pressure to remove it. On a deck or on siding, that turns a marginal machine into an entirely adequate one, and it does it without risking the surface. Our guide to <a href="/how-to-use-detergent-in-a-pressure-washer/">using detergent properly</a> covers why most people conclude their soap system is broken when it is working exactly as designed.
          </p>
        </div>

        <div id="distance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Distance Does as Much as the Spec Sheet
          </h2>

          <p>
            The pressure quoted on a machine is measured at the nozzle. What reaches the surface depends on how far away you stand, and that falls off quickly. This is why the same machine can be safe on a car at three feet and destructive on the same car at four inches.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Standoff Distance</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Effect at the Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2-4 inches</td>
                    <td class="px-4 py-4 text-gray-700">Close to full rated force</td>
                    <td class="px-4 py-4 text-gray-700">Only with a wide tip on sound concrete</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">6-12 inches</td>
                    <td class="px-4 py-4 text-gray-700">Aggressive on most surfaces</td>
                    <td class="px-4 py-4 text-gray-700">Stubborn spots, watched closely</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">12-24 inches</td>
                    <td class="px-4 py-4 text-gray-700">Effective and controllable</td>
                    <td class="px-4 py-4 text-gray-700">General cleaning on hard surfaces</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2-4 feet</td>
                    <td class="px-4 py-4 text-gray-700">Noticeably gentler</td>
                    <td class="px-4 py-4 text-gray-700">Siding, decks, vehicles</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">6-10 feet</td>
                    <td class="px-4 py-4 text-gray-700">Rinsing more than cleaning</td>
                    <td class="px-4 py-4 text-gray-700">The distance to start every job from</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The practical consequence is that distance is your finest pressure control, finer than the nozzle and far finer than the machine. A 2,300 PSI unit used at three feet with a 40 degree tip is gentler on siding than a 1,500 PSI unit held six inches away with a 25 degree tip, despite the specification suggesting the opposite.
          </p>

          <p>
            It also means the number you buy matters less than the habits you build. Buying 1,800 PSI instead of 3,000 does not protect a deck if you work with the wand four inches from the boards. Starting far back and closing in gradually protects it on either machine, because you find the surface limit while the spray is still too weak to cross it.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Test Where It Does Not Show</p>
            <p class="text-xl font-bold text-white mb-3">Every surface gets a test patch first.</p>
            <p class="text-gray-300 leading-relaxed m-0">Pick an area that is hidden or low: behind a downpipe, under a step, a corner of the deck near the house wall. Work the widest tip in from ten feet and see how the surface responds before you touch anything visible. Thirty seconds there tells you more about the right pressure for that material, in its current condition, than any chart can.</p>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying the Highest PSI on the Shelf</h3>
              <p class="text-gray-700 text-sm m-0">
                Every surface except masonry sits below 2,000 PSI, so extra pressure is capability you will deliberately avoid using. You end up with a heavier, more expensive machine operated at a distance through a wide nozzle forever, and one careless moment away from furring a deck or stripping paint.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Trusting a PSI Max Figure</h3>
              <p class="text-gray-700 text-sm m-0">
                Some brands measure pressure inside the machine at the pump with no nozzle fitted, which is a figure you will never experience while cleaning. Look for the asterisk and read the footnote, and prefer a PWMA or CETA certified machine, whose numbers were measured against a published standard at the nozzle.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Comparing PSI Without Comparing GPM</h3>
              <p class="text-gray-700 text-sm m-0">
                A 2,030 PSI machine at 1.76 GPM out-cleans a 2,300 PSI machine at 1.2 GPM, because cleaning units are the product of both numbers. Pressure breaks dirt loose and flow carries it away. On flat concrete especially, flow is what makes the work go quickly.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Starting Close With a Narrow Nozzle</h3>
              <p class="text-gray-700 text-sm m-0">
                The damage happens in the first few seconds, before you have judged how the surface responds. Start with the widest tip about ten feet back and close in gradually, stepping down one nozzle angle only if the wide tip at close range genuinely will not shift the dirt.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Reaching for Pressure Instead of Chemistry</h3>
              <p class="text-gray-700 text-sm m-0">
                Algae, mildew and road film break down chemically far more easily than they break off mechanically. A cleaner applied with the black soap nozzle and left to dwell for several minutes removes more with less risk than another 800 PSI ever will, and it is the difference between a marginal machine and an adequate one.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI pressure washer do I need for home use?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For most households, between 1,500 and 2,300 PSI. That covers vehicles, patio furniture, decks, fences and vinyl siding comfortably. Only concrete, brick and pavers ask for 2,000-3,000 PSI, and even then flow matters as much as pressure for how quickly the work goes.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is 2000 PSI enough for a driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It sits at the bottom of the useful range for concrete, so it will work but slowly, and it will brighten a lightly soiled driveway more convincingly than it removes embedded algae. Pair it with a dedicated driveway cleaner and a surface cleaner attachment and it becomes genuinely capable.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI is safe for a wood deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                1,200 to 1,800 PSI with a 25 degree green nozzle, keeping the wand moving constantly. Above that you raise the grain and leave a furred, splintery surface that only sanding fixes. Applying a deck cleaner first and letting it dwell does most of the work at far lower risk.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI is safe for vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                1,500 to 2,000 PSI with a 40 or 25 degree nozzle. Technique matters more than the number: spray downward or level and never upward under the laps, because upward spray drives water behind the boards into the wall, where the damage does not show for months.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can 3000 PSI damage concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Sound concrete tolerates it, but a narrow nozzle held close and paused will etch the surface and leave visible striping. Soft or old mortar in brick and paver joints washes out well below that figure. Use a 25 degree tip or a surface cleaner, and keep moving in overlapping passes.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is higher PSI always better?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Above the level a surface tolerates you stop cleaning and start removing the surface, and wood, paint and mortar do not grow back. Higher pressure also usually means a heavier, louder, more expensive machine, most of whose capability you will deliberately never use.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI do I need to wash a car?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Up to about 1,500 PSI with a 40 degree white nozzle, kept at a sensible distance from paint. Vehicles are the lowest-pressure job on the chart, and most damage comes from a narrow tip held close at a panel edge or an existing stone chip, where the clear coat lifts.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Does PSI matter more than GPM?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Neither alone tells you much. Pressure breaks the bond between dirt and surface, flow carries the debris away and decides how wide a path you clean per pass. On vertical surfaces gravity helps with the second job, so pressure dominates. On flat concrete nothing helps, so flow is what makes it fast.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Pressure Washer Guides</h2>
