                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1500W</td>
                    <td class="px-4 py-4 text-gray-700">2 AWG</td>
                    <td class="px-4 py-4 text-gray-700">175-200A</td>
                    <td class="px-4 py-4 text-gray-700">ANL or Class T</td>
