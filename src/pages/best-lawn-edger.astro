const dates = pageDates(Astro.url.pathname, { published: "2026-10-06", modified: "2026-10-06" });
const title = "7 Best Lawn Edgers in 2026: Battery, Corded, Gas and Manual";
const description =
  "Seven lawn edgers compared, from battery stick edgers to gas walk-behinds and a manual half-moon, plus how deep to cut and when a string trimmer is enough.";

const PRODUCTS = [
  {
    "id": "ego-me0800-edger",
    "name": "EGO Power+ ME0800 8-Inch Multi-Head Edger",
    "category": "56V Battery Stick Edger (Power Head + Attachment)",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1900,
    "pros": [
      "Adjustable depth down to 3 inches, deeper than any corded edger here",
      "Brushless power head with a variable-speed trigger and a hi-low speed selector",
      "The power head also drives EGO's other Multi-Head attachments, so one motor can trim and edge",
      "IPX4 weather resistance and a 5-year tool warranty",
      "The ME0801 kit adds a 56V 2.5Ah battery that EGO rates for up to 35 minutes"
    ],
    "cons": [
      "The ME0800 is sold bare, so you need an EGO battery and charger, or the ME0801 kit",
      "Costs several times what a corded edger costs if you are not already on EGO batteries"
