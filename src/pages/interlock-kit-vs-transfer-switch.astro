---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best Tri-Fuel Generator", url: "/best-tri-fuel-generator/" },
    { title: "Can a Generator Power a Furnace, Fridge and Sump Pump?", url: "/can-a-generator-power-a-furnace-refrigerator-and-sump-pump/" },
    { title: "Can a Generator Power an Electric Water Heater?", url: "/can-a-portable-generator-power-an-electric-water-heater/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-01", modified: "2026-09-01" });
const title = "Interlock Kit vs Transfer Switch: Which Should You Fit?";
const description =
  "An interlock is cheaper and reaches every circuit. A transfer switch is clearer to operate and harder to misuse. Both are safe when properly installed.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Comparisons",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Interlock Kit vs Transfer Switch",
          item: "https://www.thehonestreviewers.com/interlock-kit-vs-transfer-switch/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is an interlock kit as safe as a transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, when properly installed and inspected. An interlock plate mechanically prevents the main breaker and the generator backfeed breaker being on simultaneously, achieving the same isolation a transfer switch provides. The difference between them is cost and ease of operation, not safety.",
          },
        },
        {
          "@type": "Question",
          name: "Is an interlock kit cheaper than a transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, generally noticeably so. The hardware is a plate and a breaker rather than a sub-panel, and installation is simpler because no circuits need moving into a new enclosure. Both still require an electrician, an outdoor inlet box and usually a permit.",
          },
        },
        {
          "@type": "Question",
          name: "What is the main advantage of an interlock kit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Access to every circuit in the panel rather than a fixed set of six to twelve. You choose during the outage which breakers to leave on, and you are not locked into decisions made at installation. The trade-off is that you must manage the generator load yourself.",
          },
        },
        {
          "@type": "Question",
          name: "What is the main advantage of a manual transfer switch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is much harder to misuse. Each switch is labelled with the circuit it controls, so operating it requires no understanding of the panel, and the big loads that would stall a generator are simply not available on it. Many also include watt meters for load management.",
          },
        },
        {
          "@type": "Question",
          name: "Can I fit an interlock kit to any electrical panel?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Interlock kits must match the panel brand and model exactly, because the physical geometry provides the interlocking. Older, obscure or full panels often have no listed kit available, in which case a manual transfer switch is the route. Have an electrician confirm before planning around one.",
          },
        },
        {
          "@type": "Question",
          name: "Do both need a permit and an electrician?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes in most jurisdictions. Both involve working inside a live panel and changing how your home connects to the grid, and the inspection is what verifies that generator power cannot reach the utility lines. Neither is appropriate DIY work.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Generators & Backup Power",
    tags: [
      "interlock kit vs transfer switch",
      "generator interlock kit",
      "manual transfer switch",
      "generators & backup power",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Home Generators",
    link: "/best-home-generator-for-power-outages/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Comparison
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Interlock Kit vs <span class="text-[#38BDF8]">Transfer Switch</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Both solve the same problem safely. The real difference is cost against how foolproof the thing is to operate at 2am by whoever happens to be home.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#head-to-head"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Comparison
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="10.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#head-to-head" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Comparison</a>
          <a href="#interlock" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Case for an Interlock</a>
          <a href="#transfer-switch" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Case for a Transfer Switch</a>
          <a href="#choosing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Which Should You Choose?</a>
          <a href="#both-need" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. What Both Require</a>
          <a href="#operating" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Operating Each One</a>
          <a href="#upgrading" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Changing Later</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Both devices do the same essential job: they let a portable generator feed your household circuits while making it physically impossible to energise the utility lines. Where they differ is cost, how many circuits you can reach, and how much thinking is required to use them correctly.
        </p>

        <div id="head-to-head" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Interlock Kit vs Transfer Switch at a Glance
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Interlock Kit</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Manual Transfer Switch</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">What it is</td>
                    <td class="px-4 py-4 text-gray-700">A plate on your existing panel</td>
                    <td class="px-4 py-4 text-gray-700">A separate sub-panel beside it</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Circuits available</td>
                    <td class="px-4 py-4 text-gray-700">Every circuit in the panel</td>
                    <td class="px-4 py-4 text-gray-700">A fixed set, typically 6-12</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Relative cost</td>
                    <td class="px-4 py-4 text-gray-700">Lower</td>
                    <td class="px-4 py-4 text-gray-700">Higher</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Operation</td>
                    <td class="px-4 py-4 text-gray-700">Switch main off, slide plate, switch generator breaker on</td>
                    <td class="px-4 py-4 text-gray-700">Flip labelled switches</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ease of use under stress</td>
                    <td class="px-4 py-4 text-gray-700">Requires understanding your panel</td>
                    <td class="px-4 py-4 text-gray-700">Clearly labelled, hard to get wrong</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Overload protection</td>
                    <td class="px-4 py-4 text-gray-700">You must manage load yourself</td>
                    <td class="px-4 py-4 text-gray-700">Fixed circuits limit what can be switched on</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Panel compatibility</td>
                    <td class="px-4 py-4 text-gray-700">Must match panel brand and model exactly</td>
                    <td class="px-4 py-4 text-gray-700">Works with any panel</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Installed by</td>
                    <td class="px-4 py-4 text-gray-700">Electrician</td>
                    <td class="px-4 py-4 text-gray-700">Electrician</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Both Are Safe — That Is Not the Difference</p>
            <p class="text-xl font-bold text-white mb-3">Each physically prevents backfeed.</p>
            <p class="text-gray-300 leading-relaxed m-0">An interlock plate mechanically stops the main breaker and generator breaker being on together. A transfer switch achieves the same isolation with separate switching. Neither is a compromise on safety when properly installed and inspected. The choice is about cost and usability, not risk.</p>
          </div>
        </div>

        <div id="interlock" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Case for an Interlock Kit
          </h2>

          <p>
            An interlock kit is a metal plate fitted to your existing electrical panel. It sits over the main breaker and a dedicated generator backfeed breaker in such a way that only one of the two can be switched on at a time — sliding the plate to turn the generator breaker on forces the main breaker off first.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Every Circuit Is Available</h3>

          <p>
            This is the genuine advantage and it is bigger than it first appears. Because the generator feeds the whole panel, every circuit in the house is potentially available — you simply choose which breakers to leave on. You are not committed at installation time to a fixed list of six or ten circuits, and you can change your mind during an outage.
          </p>

          <p>
            That flexibility matters more than people expect. The circuits you thought you would want in a summer outage may not be the ones you want in a winter one, and a household whose needs change — a new freezer, a home office, a medical device — is not stuck with decisions made years earlier.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">It Costs Less</h3>

          <p>
            The hardware is a plate and a breaker rather than a sub-panel, and the installation is correspondingly simpler — no moving circuits into a new enclosure. For a household where budget is the binding constraint, an interlock is a proper solution rather than a cut-price one.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Catch: You Manage the Load</h3>

          <p>
            With every circuit available, nothing stops someone switching on the electric dryer and stalling the generator. Operating an interlock correctly means understanding which breakers you can afford to have on, and that understanding has to exist in whoever is home during the outage, not just in the person who commissioned the installation.
          </p>
        </div>

        <div id="transfer-switch" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Case for a Manual Transfer Switch
          </h2>

          <p>
            A manual transfer switch is a small sub-panel installed beside your main panel. Selected circuits are moved into it during installation, and each has a switch with three positions: utility, off, and generator.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">It Is Hard to Get Wrong</h3>

          <p>
            This is the argument that matters most for many households. Each switch is labelled with what it controls — furnace, fridge, sump pump, kitchen lights — and operating it is a matter of flipping the ones you want across to generator. There is no need to understand load management or to know which breaker in a crowded panel does what.
          </p>

          <p>
            That difference shows up at the worst moment. An interlock operated by someone who understands the household load is fine; the same interlock operated at 2am by a partner, a teenager or a house-sitter who has never done it before is a different proposition. A labelled transfer switch is genuinely more foolproof.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Fixed Circuit List Is a Feature</h3>

          <p>
            Because only chosen circuits are on the switch, the loads that would overload a portable generator — electric range, dryer, water heater — are simply not available to switch on. That constraint prevents the most common way people stall a generator, which is switching on something they forgot draws 5,000 watts.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Many Include Watt Meters</h3>

          <p>
            A useful practical touch: many manual transfer switches include watt meters showing the load on each leg of the generator supply. That turns load management from guesswork into something you can see, which helps considerably in balancing what is switched on.
          </p>
        </div>

        <div id="choosing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Which One Should You Actually Fit?
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Choose an Interlock If</h3>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Budget is the binding constraint and you want a proper solution at the lower cost.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>You want access to every circuit rather than a fixed selection.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>The people likely to operate it understand the panel and household loads.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Your needs may change and you would rather not be locked into a circuit list.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Your panel is a brand and model with a well-supported interlock kit available.</span>
            </li>
          </ul>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Choose a Manual Transfer Switch If</h3>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Anyone in the household might need to operate it, including people who are not technical.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>You want the reassurance of clear labelling and a fixed, safe circuit list.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>You would rather the big loads simply be unavailable than rely on remembering.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A watt meter to manage the generator load would be genuinely useful to you.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Your panel is full, an unusual brand, or has no matching interlock kit.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Panel Decides More Often Than You Would Think</p>
            <p class="text-xl font-bold text-white mb-3">No matching kit means no interlock.</p>
            <p class="text-gray-300 leading-relaxed m-0">Interlock plates must match the panel brand and model exactly, because the physical geometry is the safety mechanism. Older, obscure or full panels frequently have no listed kit available, and in that case the decision is made for you. Have an electrician confirm availability before planning around an interlock.</p>
          </div>
        </div>

        <div id="both-need" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. What Both Options Require Either Way
          </h2>

          <p>
            Whichever you choose, several things are common to both and worth budgeting for from the start.
          </p>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">A licensed electrician</p>
                <p class="text-gray-700 text-sm m-0">Both involve working inside a live panel and altering the connection between your home and the grid. This is not DIY work and in most jurisdictions is legally required to be done professionally.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">An outdoor generator inlet box</p>
                <p class="text-gray-700 text-sm m-0">A weatherproof inlet where the generator cord connects, sited so the machine sits well away from doors, windows and vents.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">A suitably rated generator cord</p>
                <p class="text-gray-700 text-sm m-0">Matched to the inlet and the generator outlet, and rated for the current you intend to draw.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">A permit and inspection</p>
                <p class="text-gray-700 text-sm m-0">Required in most jurisdictions. The inspection verifies that the isolation actually works, which is the whole point of the device.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Clear labelling</p>
                <p class="text-gray-700 text-sm m-0">Which circuits, which sequence, written where someone will find it during an outage rather than in a folder somewhere.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">An annual test</p>
                <p class="text-gray-700 text-sm m-0">Start the generator, transfer, confirm each intended circuit works. Twenty minutes a year catches fuel problems and coverage gaps.</p>
              </div>
            </div>
          </div>

          <p>
            That last point applies particularly to interlocks, because correct operation depends on knowledge rather than labelling. Walking through the sequence once a year with everyone in the household who might need to do it is worth more than any amount of documentation, and it takes very little time.
          </p>
        </div>

        <div id="operating" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. What Using Each One Actually Looks Like
          </h2>

          <p>
            The practical difference shows up in the sequence you follow during an outage, so it is worth seeing both written out.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Operating an Interlock</h3>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Switch off the large loads first</p>
                <p class="text-gray-700 text-sm m-0">Range, dryer, water heater and air conditioning breakers off before you start, so nothing draws on the generator unexpectedly.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Start the generator outside and let it stabilise</p>
                <p class="text-gray-700 text-sm m-0">Well away from the house with exhaust directed away from doors and windows.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Connect the cord to the inlet</p>
                <p class="text-gray-700 text-sm m-0">Generator end first, then the inlet, with the generator breaker still off.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Switch the main breaker off</p>
                <p class="text-gray-700 text-sm m-0">This disconnects the house from the utility supply.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Slide the interlock plate and switch the generator breaker on</p>
                <p class="text-gray-700 text-sm m-0">The plate makes it physically impossible to do this with the main still on.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Bring circuits on one at a time</p>
                <p class="text-gray-700 text-sm m-0">Switch individual breakers back on gradually, watching the generator load as you go.</p>
              </div>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Operating a Manual Transfer Switch</h3>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Start the generator outside and let it stabilise</p>
                <p class="text-gray-700 text-sm m-0">Same siting rules; the machine should be at speed before any load transfers.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Connect the cord to the inlet</p>
                <p class="text-gray-700 text-sm m-0">As before, generator end first.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Flip the labelled switches to generator</p>
                <p class="text-gray-700 text-sm m-0">One at a time, watching the watt meters if fitted. Each is labelled with what it feeds.</p>
              </div>
            </div>
          </div>

          <p>
            Three steps against six, with no requirement to know which breaker does what. That is the entire case for the transfer switch, and whether it is worth the extra cost depends almost entirely on who will be carrying out those steps.
          </p>
        </div>

        <div id="upgrading" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Can You Change Your Mind Later?
          </h2>

          <p>
            Both options leave you reasonably free to change course, which takes some pressure off the decision.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Change</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Practicality</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Interlock to transfer switch</td>
                    <td class="px-4 py-4 text-gray-700">Straightforward</td>
                    <td class="px-4 py-4 text-gray-700">The inlet and cord carry over; a sub-panel is added</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Transfer switch to interlock</td>
                    <td class="px-4 py-4 text-gray-700">Possible but rarely worth it</td>
                    <td class="px-4 py-4 text-gray-700">You would be spending money to remove a capability</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Either to a standby system</td>
                    <td class="px-4 py-4 text-gray-700">Substantial</td>
                    <td class="px-4 py-4 text-gray-700">An automatic switch replaces the manual arrangement</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Adding circuits to a transfer switch</td>
                    <td class="px-4 py-4 text-gray-700">Depends on spare capacity</td>
                    <td class="px-4 py-4 text-gray-700">Easy if the switch has unused positions</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Adding circuits with an interlock</td>
                    <td class="px-4 py-4 text-gray-700">Already available</td>
                    <td class="px-4 py-4 text-gray-700">Every circuit is reachable by design</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Start With the Interlock If You Are Unsure</h3>

          <p>
            Where the decision is genuinely finely balanced, starting with an interlock is the lower-regret option. It costs less, the inlet box and cord — a meaningful share of the total — carry over unchanged if you later fit a transfer switch, and you will have learned from real outages which circuits you actually reach for.
          </p>

          <p>
            The exception is a household where you already know the person operating it will not be comfortable with a panel. In that case the transfer switch is worth specifying from the outset rather than discovering the limitation during the first outage.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Choosing an Interlock for a Household That Cannot Operate It</h3>
              <p class="text-gray-700 text-sm m-0">
                An interlock gives access to every circuit, which means nothing stops someone switching on the dryer and stalling the generator. If the person most likely to be home during an outage does not know the panel, a labelled transfer switch with a fixed circuit list is the safer specification.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying an Interlock Kit That Nearly Fits</h3>
              <p class="text-gray-700 text-sm m-0">
                Interlock plates are specific to panel brand and model, and the physical geometry is the entire safety mechanism. A plate that almost fits does not provide the interlocking it exists to provide. Confirm the exact panel model, and if no listed kit exists, fit a transfer switch instead.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming an Interlock Is the Cheap and Unsafe Option</h3>
              <p class="text-gray-700 text-sm m-0">
                It is neither. A properly installed and inspected interlock provides the same physical prevention of backfeed as a transfer switch. The trade-off is usability and load management, not safety, and dismissing it on safety grounds means paying more for no real gain.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting the Inlet Box and Cord in the Budget</h3>
              <p class="text-gray-700 text-sm m-0">
                Both options need a weatherproof outdoor inlet and a suitably rated generator cord, and neither is included in the price of the switch or kit itself. Budget for the complete chain from generator to panel rather than for the headline device alone.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Never Walking Anyone Else Through It</h3>
              <p class="text-gray-700 text-sm m-0">
                Outages do not wait for the household member who understands the system to be home. Whichever device you fit, walk everyone who might need to use it through the sequence once a year, and leave written instructions at the panel rather than filed away somewhere.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is an interlock kit as safe as a transfer switch?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, when properly installed and inspected. An interlock plate mechanically prevents the main breaker and the generator backfeed breaker being on simultaneously, achieving the same isolation a transfer switch provides. The difference between them is cost and ease of operation, not safety.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is an interlock kit cheaper than a transfer switch?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, generally noticeably so. The hardware is a plate and a breaker rather than a sub-panel, and installation is simpler because no circuits need moving into a new enclosure. Both still require an electrician, an outdoor inlet box and usually a permit.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the main advantage of an interlock kit?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Access to every circuit in the panel rather than a fixed set of six to twelve. You choose during the outage which breakers to leave on, and you are not locked into decisions made at installation. The trade-off is that you must manage the generator load yourself.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the main advantage of a manual transfer switch?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is much harder to misuse. Each switch is labelled with the circuit it controls, so operating it requires no understanding of the panel, and the big loads that would stall a generator are simply not available on it. Many also include watt meters for load management.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I fit an interlock kit to any electrical panel?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Interlock kits must match the panel brand and model exactly, because the physical geometry provides the interlocking. Older, obscure or full panels often have no listed kit available, in which case a manual transfer switch is the route. Have an electrician confirm before planning around one.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do both need a permit and an electrician?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes in most jurisdictions. Both involve working inside a live panel and changing how your home connects to the grid, and the inspection is what verifies that generator power cannot reach the utility lines. Neither is appropriate DIY work.
              </p>
            </div>
          </div>
        </div>

