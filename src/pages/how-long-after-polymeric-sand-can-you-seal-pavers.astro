      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How long after polymeric sand can you seal pavers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At least 30 days. Polymeric sand is walkable within 24 hours and takes vehicles at 24 to 48, but it continues releasing moisture internally for weeks. Sealing before it has finished traps that moisture under the film and produces a milky haze across the pavers.",
