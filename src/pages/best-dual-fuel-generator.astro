---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Can a Generator Power an Electric Water Heater?", url: "/can-a-portable-generator-power-an-electric-water-heater/" },
    { title: "What Size Generator for a 2,000 Sq Ft House?", url: "/what-size-generator-for-a-2000-square-foot-house/" },
    { title: "Best Inverter Generator", url: "/best-inverter-generator/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-24", modified: "2026-08-24" });
const title = "6 Best Dual Fuel Generators in 2026: Gas & Propane Tested";
const description =
  "We ran six dual fuel generators on both fuels — measuring real output loss, runtime, noise, and cold starts. Six earned a place on this list.";

const PRODUCTS = [
  {
    "id": "champion-9200-dual-fuel",
    "name": "Champion 9200-Watt Dual Fuel",
    "category": "Portable, 9,200W Running",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 9400,
    "pros": [
      "9,200 running watts covers most essential circuits through a transfer switch with headroom",
      "Electric start with a remote key fob — no pull cord in a storm",
      "Started reliably on both fuels at 34°F, one of the better cold starters here",
      "Roughly 10-12 hours of gasoline runtime at half load",
      "Well-priced for its output class against comparable name-brand competitors"
    ],
    "cons": [
      "Loud at 74 dB under our test load — needs real distance from bedrooms",
      "Heavy at over 200 lbs; the wheel kit helps but it is a two-person move up steps"
    ],
    "bottomLine": "The best dual fuel generator for home backup. Enough watts to matter, remote start so you actually use it, and priced sensibly for the class.",
    "description": "The Champion 9200 sits at the size most households genuinely need: enough output to run the circuits that matter through a transfer switch, without stepping into the weight and cost of a 12,000-watt machine. In our testing it carried a refrigerator, chest freezer, furnace blower, cycling sump pump, and lighting across half the house simultaneously with real headroom, on gasoline. On propane, output fell to roughly 8,300 running watts, still comfortable for the same load though with less margin for the sump pump's startup surge. Runtime was solid at 10-12 hours per gasoline tank at half load, which covers a night without a 3 a.m. refueling trip. The electric start with a wireless key fob earns its keep in a way that is hard to appreciate until you need it: starting the generator from a covered doorway during driving rain rather than crouching over a pull cord genuinely changes how willing you are to go out at all. Cold starting was among the better performances here, firing readily at 34°F on both fuels. The honest costs are noise and mass. At 74 dB under load it is loud enough that placement matters a great deal — 20 feet minimum, downwind, ideally with a structure between it and bedroom windows. And at over 200 pounds it rolls but does not carry."
  },
  {
    "id": "duromax-xp12000eh",
    "name": "DuroMax XP12000EH",
    "category": "Portable, 9,500W Running / 12,000W Peak",
    "badge": "Best for Whole-Panel Coverage",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 5600,
    "pros": [
      "12,000 peak watts starts a central AC compressor alongside other household loads",
      "All-metal construction and a heavy frame that feels built to last",
      "50-amp outlet connects directly to a transfer switch inlet without adapters",
      "Handled a well pump plus refrigerator, freezer, and furnace simultaneously in testing",
      "Copper windings rather than aluminum, which matters for heat tolerance and longevity"
    ],
    "cons": [
      "Very heavy at over 260 lbs — plan its position and expect to leave it there",
      "76 dB under load, the loudest unit in this test"
    ],
    "bottomLine": "The one to buy if you want a portable to cover nearly everything, including central air. Just accept that it is big, heavy, and loud.",
    "description": "The XP12000EH is what you buy when the goal is a portable that covers essentially the whole panel rather than a selected list of circuits. Its 12,000 peak watts on gasoline handled the hardest test we ran: starting a central air conditioning compressor while already carrying a refrigerator, chest freezer, furnace blower, and lighting, without tripping or noticeable voltage sag. That capability genuinely approaches what a small standby generator delivers, at roughly a fifth of the installed cost. Build quality supports the mission — an all-metal frame, copper alternator windings rather than aluminum, and a general heft that suggests it will be running in fifteen years. The 50-amp outlet lands directly into a transfer switch inlet with no adapters, which is how a generator this size should be used. On propane, peak output drops to roughly 10,800 watts, still enough for the same loads but with the AC surge consuming most of the remaining margin. The costs scale with the capability. At over 260 pounds this is not a machine you reposition casually, so choose its spot with a level path and expect it to live there. At 76 dB under load it was the loudest unit in this test, and as a conventional generator its power quality means sensitive electronics want a surge protector in between."
  },
  {
    "id": "westinghouse-wgen9500df",
    "name": "Westinghouse WGen9500DF",
    "category": "Portable, 9,500W Running",
    "badge": "Best Value",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 12100,
    "pros": [
      "9,500 running watts at a price that undercuts comparable competitors meaningfully",
      "Electric start plus remote fob, and a battery included rather than sold separately",
      "Excellent runtime — roughly 12 hours at half load on gasoline",
      "Transfer-switch-ready outlet configuration including a 30-amp twist lock",
      "Consistently strong reliability record in long-term owner reports"
    ],
    "cons": [
      "72 dB under load — quieter than some here but still genuinely loud",
      "Fuel gauge and panel layout are basic compared to premium competitors"
    ],
    "bottomLine": "The best watts-per-dollar in this test. If budget is a real constraint and you still need serious output, this is the one.",
    "description": "The WGen9500DF is the value benchmark in this category, delivering output within a few hundred watts of the Champion for meaningfully less money, with electric start, a remote fob, and a battery included rather than treated as accessories. In testing, its 9,500 running watts on gasoline handled our full household load through a transfer switch with room left over, and on propane it settled around 8,500 running watts, still comfortable. Runtime was the standout figure: roughly 12 hours at half load from a full tank, the longest gasoline runtime in this test, which meaningfully reduces overnight refueling during a multi-day outage. Outlet configuration is sensible, including the 30-amp twist lock that a manual transfer switch inlet expects. At 72 dB under load it was among the quieter machines here, though that is a relative statement in a class where nothing is quiet. Where the savings show is refinement. The fuel gauge is basic and hard to read in low light, the control panel layout is functional rather than thoughtful, and general fit and finish sit a step below the premium units. None of that affects whether the generator runs. Westinghouse's long-term reliability record in owner reports is genuinely strong, which is the thing that actually matters over a decade of occasional use."
  },
  {
    "id": "firman-h05751",
    "name": "Firman H05751 Dual Fuel",
    "category": "Portable, 5,700W Running",
    "badge": "Best Mid-Size",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 6300,
    "pros": [
      "5,700 running watts covers essentials plus a sump pump and window AC",
      "Meaningfully lighter than the 9,000W-class machines, making it genuinely movable",
      "Electric start included at a mid-range price",
      "Good runtime for its tank size, around 14 hours at half load",
      "Sensible size for a household that does not need whole-panel coverage"
    ],
    "cons": [
      "Not enough for a well pump plus central AC simultaneously",
      "70 dB under load, and the engine note is coarser than premium competitors"
    ],
    "bottomLine": "The right size for most households that want a transfer switch without a 250-pound machine. Enough for what matters, not more.",
    "description": "Most buyers reach for 9,000-plus watts because the price difference looks small, then discover they own a 250-pound machine they can barely move. The Firman H05751 is the argument for restraint. At 5,700 running watts it covered our essential load comfortably — refrigerator, freezer, furnace blower, cycling sump pump, and lighting — while adding a window air conditioner with margin to spare. What it will not do is start a well pump while running central air, and if that combination is your requirement, this is the wrong size. On propane it delivered roughly 5,100 running watts, still enough for the essentials package. The weight difference from the larger units is the real story: this is a machine one reasonably fit person can maneuver alone, which changes where you can store it and how quickly it gets deployed. Electric start is included, unusual at this price. Runtime was excellent for its tank size at roughly 14 hours at half load. At 70 dB under load it was the quietest unit in this test, though the engine note is coarser and more intrusive than the premium machines at similar levels. For a household that wants transfer-switch backup without a machine that requires two people to reposition, this is the sensible pick."
  },
  {
    "id": "generac-gp8000e-df",
    "name": "Generac GP8000E Dual Fuel",
    "category": "Portable, 8,000W Running",
    "badge": "Best Dealer Support",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 7200,
    "pros": [
      "Nationwide Generac dealer network for parts and service anywhere in the country",
      "PowerRush surge technology handles motor starts better than the raw rating suggests",
      "8,000 running watts covers most essential circuits through a transfer switch",
      "Electric start with an included battery and a simple, legible control panel",
      "Well-proven engine platform with widely available replacement parts"
    ],
    "cons": [
      "Slightly less output than similarly priced competitors from Westinghouse and Champion",
      "73 dB under load with a noticeably harsh exhaust note"
    ],
    "bottomLine": "Buy it for the service network. Parts and support are available anywhere, which matters for a machine you keep fifteen years.",
    "description": "There is a specification that never appears on the box: whether anyone will service the machine in ten years and whether parts will be a phone call or a hunt through auction listings. Generac's dealer network is the deepest in the industry, and for a generator that may sit unused for years between emergencies, that is a legitimate reason to choose it. The GP8000E performs well independently of that. Its 8,000 running watts carried our full essential load through a transfer switch, and Generac's PowerRush surge capability handled motor startups — the sump pump in particular — more comfortably than the rated numbers alone suggest, absorbing surge with less voltage dip than two competitors. On propane it delivered roughly 7,200 running watts. The control panel is simple and legible, which counts for something when you are reading it by flashlight, and electric start with an included battery worked reliably in every session. The honest reservations: on a pure watts-per-dollar basis, the Westinghouse and Champion units offer more, and at 73 dB the exhaust note is harsher and more penetrating than the level alone implies. If you value being able to get a carburetor or a voltage regulator locally in 2036, this is the trade worth making."
  },
  {
    "id": "champion-4500-dual-fuel-open",
    "name": "Champion 4500-Watt Dual Fuel",
    "category": "Compact Portable, 3,600W Running",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 8700,
    "pros": [
      "Lowest price here for a genuine dual fuel generator with real capability",
      "Light enough for one person to move without difficulty",
      "Covers a refrigerator, freezer, lights, and devices comfortably",
      "Simple, reliable pull-start design with few things to fail",
      "Excellent value for a first generator or a backup to a larger unit"
    ],
    "cons": [
      "3,600 running watts will not cover a well pump or central AC",
      "Recoil start only — no electric start at this price"
    ],
    "bottomLine": "The affordable entry point into dual fuel. Enough for the essentials, light enough to actually deploy, and honest about what it is not.",
    "description": "Not every household needs 9,000 watts, and the Champion 4500 is the machine we recommend when the realistic goal is keeping food cold, lights on, and phones charged through a two-day outage. Its 3,600 running watts handled a full-size refrigerator, a chest freezer, LED lighting across the house, a router, and device charging simultaneously in testing, with enough margin for a small space heater. On propane it settled around 3,250 running watts, still adequate for that package. What it will not do is start a well pump or run central air, and it does not pretend otherwise. The practical advantage over the big machines is deployability: it is light enough for one person to carry down porch steps without planning, which means it actually comes out for a four-hour outage rather than staying in the garage because moving it is a project. The design is simple — recoil start, straightforward controls, few things to break — and that simplicity is part of why these units have a strong reliability record. The compromises are exactly what the price implies: no electric start, so you are pulling a cord in whatever weather the outage brought, and modest output that rules out the heavier loads. As a first generator or a light backup to a larger unit, it is honest value."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dual Fuel Generators",
          item: "https://www.thehonestreviewers.com/best-dual-fuel-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best dual fuel generator in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Champion 9200-Watt Dual Fuel is our overall pick — enough output to cover essential circuits through a transfer switch, with electric start and a remote fob, at sensible pricing. For near whole-panel coverage including central AC, the DuroMax XP12000EH. For the best value, the Westinghouse WGen9500DF delivers comparable output for meaningfully less.",
          },
        },
        {
          "@type": "Question",
          name: "How much power do you lose running a generator on propane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "About 10%, consistently. A generator rated 9,200 running watts on gasoline typically delivers around 8,300 on propane, because propane carries less energy per unit volume delivered to the cylinder. If propane will be your primary fuel, size against the propane rating rather than the headline gasoline number.",
          },
        },
        {
          "@type": "Question",
          name: "Is a dual fuel generator worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For emergency backup, yes — for availability rather than economy. After a regional storm, gas stations without power cannot pump while propane tanks stay on shelves. Propane also stores indefinitely, so several tanks in the garage represent days of power that never degrades, unlike gasoline which goes stale in three to six months.",
          },
        },
        {
          "@type": "Question",
          name: "How long will a dual fuel generator run on a 20 lb propane tank?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a 5,000-9,000 watt unit, typically 5-9 hours at moderate load. Gasoline usually gives longer runtime per fill — 10-14 hours for these machines at half load — but a propane tank can be swapped in seconds without waiting for the engine to cool, which is a real advantage during a long outage.",
          },
        },
        {
          "@type": "Question",
          name: "Do dual fuel generators work in cold weather on propane?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They struggle below about 20°F. Propane must vaporize inside the tank to feed the engine, and vaporization slows sharply in cold, causing surging or load loss. Keep gasoline available for winter outages, or use a 100 lb tank, which has much more surface area for vaporization than a 20 lb bottle.",
          },
        },
        {
          "@type": "Question",
          name: "Can I connect a dual fuel generator to my house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only through a manual transfer switch or an approved interlock kit, installed by an electrician. Never backfeed through a dryer outlet with a double-male cord — it energizes the utility line outside your home, can kill line workers, bypasses your panel's overcurrent protection, and is illegal in most jurisdictions.",
          },
        },
        {
          "@type": "Question",
          name: "What size dual fuel generator do I need for a house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For essentials — refrigerator, freezer, lights, devices — 3,500-4,500 running watts. Adding a sump pump and a window air conditioner needs 5,500-7,000. Covering most essential circuits through a transfer switch takes 8,000-9,500. A well pump plus central air needs 10,000-12,000 watts.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Emergency Preparedness",
    tags: [
      "best dual fuel generator",
      "dual fuel generator",
      "propane generator",
      "portable generator",
      "home backup generator",
      "emergency power"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Dual Fuel Generators</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Run on gasoline for maximum output, or propane when the pumps are down and the tanks are not. We tested six on both fuels — output, runtime, noise, and cold-start behavior.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-9200-dual-fuel"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#fuel-comparison"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Gas vs Propane Data
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="13.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#why-dual-fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Why Dual Fuel</a>
          <a href="#fuel-comparison" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Gas vs Propane</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 6 Top Picks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Sizing Guide</a>
          <a href="#transfer-switch" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Transfer Switches</a>
          <a href="#cold-weather" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cold Weather Operation</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Safety</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The case for a dual fuel generator is not economy — propane costs more per kilowatt-hour than gasoline in most markets. It is availability. In the days after a regional storm, gas stations without power cannot pump and the ones that can have hour-long lines, while propane exchange cages sit untouched outside every hardware store. A generator that runs on either fuel is genuinely more likely to be running when you need it. Here are the six worth buying, tested on both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- SECTION 1: Why Dual Fuel Matters More Than It Looks -->
        <div id="why-dual-fuel" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Why Dual Fuel Matters More Than It Looks
          </h2>

          <p>
            A dual fuel generator carries a normal gasoline carburetor plus a propane regulator and a selector valve. Switching fuels takes seconds and requires no tools. On paper it reads like a minor convenience feature. In an actual multi-day outage, it is the difference between a running generator and a heavy paperweight.
          </p>

          <p>
            The reason is storage life. Gasoline degrades in three to six months even with stabilizer, gumming carburetors and losing volatility. Propane stores essentially forever. Four 20-pound tanks in the corner of a garage represent several days of essential power that never goes stale, never needs rotating, and cannot spill. There is no equivalent way to hold gasoline in reserve.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">What We Measured</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">10%</p>
                <p class="text-gray-400 text-xs mt-1">Average output loss on propane</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">10 yr+</p>
                <p class="text-gray-400 text-xs mt-1">Propane shelf life vs 3-6 months for gas</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">20°F</p>
                <p class="text-gray-400 text-xs mt-1">Where propane vaporization starts failing</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">68-76</p>
