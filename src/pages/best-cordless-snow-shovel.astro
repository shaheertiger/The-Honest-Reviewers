const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "6 Best Cordless Snow Shovels: Battery Picks for Steps, Decks and Walks";
const description =
  "The best cordless snow shovels from EGO, Toro, Greenworks, Snow Joe, Ryobi and DeWalt, compared by width, depth, weight and battery platform, with picks for seniors.";

const PRODUCTS = [
  {
    "id": "ego-sns1201-12-inch-snow-shovel",
