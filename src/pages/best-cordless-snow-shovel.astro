    "pros": [
      "Runs on DeWalt 20V MAX batteries many people already own",
      "Listed at 13.23 lb, light to carry up steps",
      "6-inch depth and 20-foot rated throw, per DeWalt",
      "Brushless motor"
    ],
    "cons": [
      "10-inch width means more passes",
      "About 20 minutes on a 4Ah battery, per DeWalt",
      "Bare tool only, and stock can be limited"
    ],
    "bottomLine": "Only worth it if you own DeWalt 20V batteries, but then it is the cheapest way to stop hand-shovelling the steps."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
