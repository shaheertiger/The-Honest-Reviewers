---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cordless Vacuums",
    "url": "/best-cordless-vacuum/"
  },
  {
    "title": "Best Robot Vacuums",
    "url": "/best-robot-vacuum/"
  },
  {
    "title": "Best Vacuum Cleaners",
    "url": "/best-vacuum-cleaner/"
  },
  {
    "title": "Best Spin Mops",
    "url": "/best-spin-mop/"
  },
  {
    "title": "Best Steam Cleaners",
    "url": "/best-steam-cleaner/"
  },
  {
    "title": "Best Vinyl Plank Flooring",
    "url": "/best-vinyl-plank-flooring/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "7 Best Cordless Vacuums for Hardwood Floors in 2026";
const description =
  "The best cordless vacuums for hardwood floors on Amazon: smart sticks with dust detection, budget and lightweight sticks, and a wet-dry vacuum for sealed wood, compared on brushroll, filtration and runtime.";

const PRODUCTS = [
  {
    "id": "dyson-v12-detect-slim-absolute",
    "name": "Dyson V12 Detect Slim Absolute Cordless Vacuum",
    "category": "Cordless Stick, Laser Dust Detection, Particle Counting Display",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "An angled laser makes invisible dust visible on hard floors, per the listing",
      "Counts and sizes dust particles and shows the results on an LCD as you clean",
      "Single-button power, so there is no trigger to hold",
      "No-touch bin emptying pushes debris out in one action",
      "Wall-mounted charging dock with a battery that trickles once full"
    ],
    "cons": [
      "The most expensive pick here",
      "The listing does not state a runtime, so check the current model's figures",
      "The laser is most useful on hard floors and does little on carpet"
    ],
    "bottomLine": "The best cordless vacuum for hardwood floors if you want to see exactly what you are picking up: the laser shows fine dust that bare floors hide.",
    "description": "Hardwood hides fine dust well until light catches it at a low angle, and that is exactly the problem the Dyson V12 Detect Slim Absolute is built to solve. The listing describes a precisely angled laser that makes invisible dust visible on hard floors, so you can see the film of dust and pet dander along a board instead of guessing whether you have covered it. A sensor sizes and counts the particles it picks up and shows the results on an LCD screen as you clean, which sounds like a gimmick until you watch the count drop on a second pass. Day-to-day use is easy: power is a single button rather than a trigger you have to hold, the bin empties with a no-touch ejection that pushes debris out in one action, and the vacuum drops into a wall-mounted charging dock. Dyson says the battery cuts power to a trickle once full, so leaving it on the dock is fine. The trade-offs are price and scope. It is the most expensive vacuum here, and the laser is a hard-floor feature that does little on carpet. The listing we checked does not give a runtime, so check the current figures before you buy for a large home. Buy the Shark Detect Pro instead for similar smart features for less."
  },
  {
    "id": "shark-detect-pro-iw1120",
    "name": "Shark Detect Pro Cordless Stick Vacuum (IW1120)",
    "category": "Cordless Stick + Handheld, Floor, Dirt and Edge Detection, HEPA",
    "badge": "Best Smart Features for the Money",
    "amazonUrl": "#",
    "pros": [
      "Floor Detect adjusts the brushroll speed automatically between carpet and hard floor",
      "DirtDetect and EdgeDetect raise suction for hidden dirt and along baseboards",
      "HEPA filtration with an anti-allergen complete seal, listed at over 99.97% of dust and allergens",
      "Self-cleaning PowerFins brushroll is listed to prevent hair wrap",
      "Converts to a handheld and stores freestanding with the included wand clip"
    ],
    "cons": [
      "The PowerFins roll is a multi-surface roll, not a soft hard-floor roller",
      "The listing does not state a runtime",
      "Smart sensing adds cost over a basic stick vacuum"
    ],
    "bottomLine": "The best value smart stick for homes with hardwood and some rugs: it senses the floor and the edges and adjusts itself.",
    "description": "The Shark Detect Pro is the value alternative to the Dyson for a home that is mostly hardwood with a few rugs, because it adjusts itself to the floor instead of making you switch heads. The listing describes three detection systems. Floor Detect senses the floor type and changes brushroll speed, running it harder on carpet and gentler on hard floors. DirtDetect raises suction when it finds hidden dirt, and EdgeDetect does the same along edges and corners, which on hardwood is where dust and pet hair collect against the baseboards. An LED ring changes color as an area gets cleaner. Filtration is HEPA with what Shark calls an anti-allergen complete seal, listed at over 99.97 percent of dust and allergens down to 0.3 microns, which matters on bare floors where dust gets kicked back into the air easily. The PowerFins brushroll is self-cleaning, so long hair does not wrap around it, and the vacuum converts to a handheld and stands up with the included wand clip. The trade-off is the roll itself. PowerFins is a multi-surface roll, not a soft fabric roller, and the listing does not give a runtime. Buy the Dyson V12 for the dust-revealing laser, or the Shark PowerPro Reveal Plus for a lower price."
  },
  {
    "id": "shark-powerpro-reveal-plus-iz376h",
    "name": "Shark PowerPro Reveal Plus Cordless Vacuum (IZ376H)",
    "category": "Cordless Stick + Handheld, FloorDetect, LED Headlights, 40-Min Runtime",
    "badge": "Best Value",
    "amazonUrl": "#",
    "pros": [
      "Marketed specifically for hardwood floors and carpet",
      "FloorDetect senses carpet or hard floor and adjusts brushroll speed, with no nozzle swapping",
      "Up to 40 minutes of runtime, measured at the handheld in standard mode, per Shark",
      "Dirt-Reveal technology and LED headlights show hidden dust",
      "HEPA filtration with an anti-allergen complete seal"
    ],
    "cons": [
      "Runtime is measured at the handheld, so expect less on the floor head",
      "Fewer sensors than the Detect Pro",
      "No dust display or particle counting"
    ],
    "bottomLine": "A lower-cost Shark built for hardwood and carpet, with automatic floor sensing and headlights that show dust on bare floors.",
    "description": "The Shark PowerPro Reveal Plus is the most affordable way into Shark's floor-sensing technology, and its listing pitches it directly as a lightweight vacuum for hardwood floors and carpet. FloorDetect senses whether it is on carpet or a hard floor and adjusts the brushroll speed automatically, so you do not have to change nozzles when you roll off a rug onto oak. Dirt-Reveal technology and LED headlights show hidden dust and debris, which is the feature that matters most on hardwood: a low headlight shows the dust film that overhead lighting hides. Filtration is HEPA with Shark's anti-allergen complete seal. The self-cleaning PowerFins brushroll and HyperVelocity suction are listed for pet hair without hair wrap, and the vacuum turns into a hand vacuum, with an 8-inch crevice tool and an upholstery tool included for baseboards, stairs and furniture. Shark lists up to 40 minutes of runtime, but note the footnote: it is measured at the handheld in standard mode, so expect less with the floor head running. Compared with the Detect Pro, it lacks the edge and dirt sensors and the color-changing display. Buy the Detect Pro instead if you want the extra sensing, or the Levoit if price matters most."
  },
  {
    "id": "dyson-v8-absolute",
    "name": "Dyson V8 Absolute Cordless Vacuum",
    "category": "Cordless Stick, De-tangling Motorbar Head, Up to 40-Min Runtime",
    "badge": "Best Dyson for Less",
    "amazonUrl": "#",
    "pros": [
      "De-tangling Motorbar head cleans carpets and hard floors and clears long hair from the bar",
      "Up to 40 minutes of runtime, per the listing",
      "Whole-machine filtration traps 99.99% of particles down to 0.3 microns in Boost mode",
      "Washable lifetime filter, so there is nothing to buy",
      "Hair Screw Tool for pet hair on upholstery"
    ],
    "cons": [
      "Older design without a laser or dust sensing",
      "Runtime varies with power mode and attachments",
      "Trigger-operated power, unlike the V12's single button"
    ],
    "bottomLine": "The cheapest way to get Dyson suction and filtration on hardwood, without the laser and sensors.",
    "description": "The Dyson V8 Absolute is an older design, but it remains a sensible hardwood vacuum because the basics are strong and the price is well below the V12. The listing gives up to 40 minutes of runtime, noting that actual time depends on power mode and attachments. The De-tangling Motorbar cleaner head is listed for deep cleaning carpets and hard floors, with vanes that clear long and pet hair from the brush bar, which stops the hair-wrapped roll that leaves streaks of debris on bare boards. Filtration is the V8's strongest point. Dyson lists the whole machine as trapping 99.99 percent of particles as small as 0.3 microns in Boost mode and at least 99.97 percent in other modes, and the filter is washable and reusable for the life of the machine, so there is no filter to buy every few months as with the Levoit. Fifteen cyclones in two tiers are listed to prevent suction loss as the bin fills. A Hair Screw Tool handles pet hair on upholstery. What you give up is the newer technology: there is no laser to show dust, no particle counting and no automatic floor sensing, and power is controlled by a trigger. Buy the V12 Detect Slim if you want to see the dust, or the Shark PowerPro for floor sensing at a similar price."
  },
  {
    "id": "tineco-floor-one-s5",
    "name": "Tineco Floor ONE S5 Cordless Wet Dry Vacuum",
    "category": "Wet-Dry Vacuum and Mop, Hard Floors, Dual Tanks, Self-Cleaning",
    "badge": "Best Wet-Dry for Sealed Hardwood",
    "amazonUrl": "#",
    "pros": [
      "Vacuums and mops in one pass on hard floors, wet or dry messes",
      "iLoop sensor adjusts suction, water flow and roller speed automatically",
      "Dual tanks keep clean and dirty water separate",
      "One-press self-cleaning flushes the roller and tubing",
      "Roller designed to clean close to baseboards and into corners"
    ],
    "cons": [
      "Only for sealed hardwood: water can damage unsealed or worn finishes",
      "Filter and HEPA need cleaning monthly, per Tineco",
      "Not a replacement for a stick vacuum on rugs"
    ],
    "bottomLine": "For sealed hardwood that gets sticky spills and muddy paws, this vacuums and mops in one pass and cleans itself afterward.",
    "description": "A stick vacuum lifts dust, but it will not touch a dried juice spill or muddy paw prints. The Tineco Floor ONE S5 is a cordless wet-dry vacuum that vacuums and mops hard floors in one pass, and Tineco markets it for sticky messes and pet hair. Its iLoop smart sensor adjusts suction, water flow and roller speed to the mess it detects, and its brush roller is designed to glide close to baseboards and into corners. Dual tanks keep clean and dirty water separate, so you are not spreading dirty water back over the floor, and the clean tank is listed as 30 percent larger than the previous Floor ONE. The self-cleaning cycle flushes the roller and tubing at the push of a button, then spins the roller to dry it, and a pet hair strainer keeps the dirty tank easy to empty. The essential caveat is the floor itself. A wet-dry vacuum suits sealed hardwood with an intact finish. Unsealed, waxed or worn floors can be damaged by water, so check with your flooring maker before you use it, and use as little water as the job needs. Tineco also says to clean the filter and HEPA monthly. Buy a stick vacuum as well if you have area rugs, because this is a hard-floor tool."
  },
  {
    "id": "levoit-cordless-anti-tangle",
    "name": "Levoit Cordless Vacuum (LVAC-200)",
    "category": "Cordless Stick, Anti-Tangle Brush, 180-Degree Lay-Flat, LED Lights",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "Lies 180 degrees flat to reach under beds and sofas",
      "Three LED lights to spot dust on bare floors",
      "Anti-tangle brush designed to reduce hair wrap",
      "5-stage filtration listed at 99.9% of particles down to 0.3 microns",
      "One-click bin emptying"
    ],
    "cons": [
      "About 30 minutes with the floor head and 12 in Turbo, per the listing",
      "Levoit says to replace the filter every 3 months",
      "Dry messes only"
    ],
    "bottomLine": "A low-cost stick vacuum with the features hardwood needs: lights, a flat-reaching wand and an anti-tangle brush.",
    "description": "The Levoit LVAC-200 shows that a hardwood vacuum does not need to be expensive, as long as you are clear about runtime. Its listing is honest about the numbers: up to 50 minutes with the crevice or pet tool in Eco mode, 30 minutes with the vacuum head, and 12 minutes in Turbo mode. On a hardwood home of modest size, 30 minutes with the floor head covers a lot, because bare floors need less power than carpet and you rarely need Turbo. The features that matter on hard floors are all here. Three LED lights show dust as you go, the wand lies 180 degrees flat to reach under beds and sofas where dust bunnies collect on bare boards, and the anti-tangle brush is designed to clear hair without you cutting it free. Filtration is listed as five stages capturing 99.9 percent of particles as small as 0.3 microns, tested to ASTM F1977, and the bin empties with one click. The trade-offs are ongoing costs and limits. Levoit says to replace the filter every three months, which adds up compared with the Dyson V8's washable lifetime filter. It is for dry messes only, and there is no floor sensing. Buy the Shark PowerPro instead if you want automatic floor sensing and a longer stated runtime."
  },
  {
    "id": "eureka-rapidclean-pro-nec280tl",
    "name": "Eureka RapidClean Pro Cordless Stick Vacuum (NEC280TL)",
    "category": "Cordless Stick, 5.3 lbs, 250W, Tangle-Free Brushroll, LED Headlights",
    "badge": "Lightest Pick",
    "amazonUrl": "#",
    "pros": [
      "Listed at 5.3 lbs, the lightest stick on this list by stated weight",
      "Up to 40 minutes in Eco mode, with three power modes",
      "Tangle-free brushroll for pet hair on hard floors and carpets",
      "LED headlights for dust under furniture",
      "180-degree swivel head for steering around chair and table legs"
    ],
    "cons": [
      "About 15 minutes in Max mode, per the listing",
      "No floor sensing, so you choose the power mode yourself",
      "Filtration is listed as 5-stage, not HEPA"
    ],
    "bottomLine": "The easiest vacuum here to carry and steer, for quick daily passes over hardwood, especially for anyone who finds heavier sticks tiring.",
    "description": "Weight matters more than most specs on a vacuum you will use every day, and the Eureka RapidClean Pro is the lightest stick on this list at a listed 5.3 lbs. Eureka markets it as easy for seniors and anyone who finds heavier sticks tiring on the wrists and back, and a light stick on hardwood means quick daily passes rather than one big weekly session. A 180-degree swivel head steers around chair legs and table bases, and LED headlights light up dust under beds and sofas, which on bare floors is where most of it ends up. Eureka lists up to 40 minutes in Eco mode, with three power modes, Eco, Standard and Max, and up to 15 minutes in Max. On hardwood, Eco or Standard is usually enough, so the longer figure is the realistic one for bare floors. The tangle-free brushroll is listed for pet hair on hard floors, carpets and furniture, and the 250W motor is tested on dog and cat hair, per Eureka. The trade-offs are the basics you give up for the low weight and price: there is no automatic floor sensing, so you change modes yourself, and filtration is listed as five-stage rather than sealed HEPA. Buy the Shark Detect Pro instead if allergies are a concern."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cordless Vacuums for Hardwood Floors",
          item: "https://www.thehonestreviewers.com/best-cordless-vacuum-for-hardwood-floors/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cordless vacuum for hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Dyson V12 Detect Slim Absolute is the best cordless vacuum for hardwood floors for most people who can afford it. Its laser makes invisible dust visible on hard floors, and it counts particles on screen as you clean. The Shark Detect Pro is the better value, with automatic floor, dirt and edge detection and sealed HEPA filtration."
          }
        },
        {
          "@type": "Question",
          "name": "Is a cordless vacuum good for hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Hardwood needs less power than carpet, so a cordless stick's battery goes further on bare floors. Light weight also makes it easy to do quick daily passes, which keeps grit from scratching the finish. Choose one with headlights or dust detection, sealed filtration and a brushroll that slows or adjusts on hard floors."
          }
        },
        {
          "@type": "Question",
          "name": "Can a vacuum scratch hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can if grit gets trapped under the head or wheels, or if a stiff brushroll spins fast on a soft finish. Check the underside of the head regularly, keep the wheels free of hair, and use a vacuum that slows its brushroll on hard floors. Vacuuming often actually protects floors by removing abrasive grit."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a wet-dry vacuum on hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On sealed hardwood with an intact finish, yes, using the lowest water setting that cleans the mess. Wet-dry vacuums like the Tineco Floor ONE S5 pick water up in the same pass. Do not use them on unsealed, waxed or worn floors, and check your flooring warranty for any restrictions."
          }
        },
        {
          "@type": "Question",
          "name": "Should I turn off the brushroll on hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On many vacuums a slower or stopped brushroll works better on hardwood, because fast stiff bristles scatter debris. Floor-sensing vacuums like the Shark Detect Pro and PowerPro Reveal Plus adjust brushroll speed automatically. If yours has a manual setting for hard floors, use it."
          }
        },
        {
          "@type": "Question",
          "name": "How often should you vacuum hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In busy homes or homes with pets, a quick pass daily or every other day in high-traffic areas, plus a fuller clean weekly. Frequent vacuuming removes grit before it is ground into the finish, which is the main cause of dull, scratched hardwood."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best cheap cordless vacuum for hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Levoit LVAC-200 is the best budget pick. It lies flat to reach under furniture, has LED lights to show dust, an anti-tangle brush and filtration listed at 99.9 percent of particles down to 0.3 microns. Expect about 30 minutes with the floor head, per the listing, and filter changes every three months."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "cordless vacuum for hardwood floors",
      "best cordless vacuum for hardwood floors",
      "stick vacuum for hardwood floors",
      "cordless vacuum for hard floors",
      "vacuum for wood floors",
      "hardwood floor vacuum",
      "cordless vacuum for hardwood and pet hair"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Cordless Vacuums for <span class="text-[#38BDF8]">Hardwood Floors</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Fine dust, pet hair and grit that scratches the finish: hardwood needs a vacuum that picks it up without scattering it. Seven cordless models on Amazon, chosen for bare floors.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dyson-v12-detect-slim-absolute"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What Matters on Hardwood
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Matters on Hardwood</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Stick, Wet-Dry or Lightweight</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Cordless Vacuums for Hardwood</a>
          <a href="#scratches" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Can a Vacuum Scratch Hardwood?</a>
          <a href="#wet-cleaning" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Wet-Dry Vacuums on Hardwood</a>
          <a href="#pet-hair" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Hardwood and Pet Hair</a>
          <a href="#rugs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Hardwood With Area Rugs</a>
          <a href="#how-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. How to Vacuum Hardwood</a>
          <a href="#runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Runtime and Batteries</a>
          <a href="#vs-robot" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Stick vs Robot Vacuum</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
