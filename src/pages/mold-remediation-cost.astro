                    <td class="px-4 py-4 text-gray-700">EPA says most homeowners can clean this themselves</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Bathroom or small room</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 500 to 3,000 dollars</td>
                    <td class="px-4 py-4 text-gray-700">More if drywall, subfloor or cabinets come out</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Basement section</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1,500 to 5,000 dollars</td>
                    <td class="px-4 py-4 text-gray-700">Finished basements cost more due to tear-out</td>
                  </tr>
