                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-bold text-gray-900">Polyurea-Polyaspartic Hybrid</td>
                  <td class="px-4 py-4 text-gray-700">$7–$13</td>
                  <td class="px-4 py-4 text-gray-700">$3,500–$6,500</td>
                  <td class="px-4 py-4 text-gray-700">Same-day</td>
                </tr>
                <tr class="bg-white">
                  <td class="px-4 py-4 font-bold text-gray-900">Pure Polyurea</td>
                  <td class="px-4 py-4 text-gray-700 font-bold text-[#FF4500]">$9–$16</td>
                  <td class="px-4 py-4 text-gray-700 font-bold text-[#FF4500]">$4,500–$8,000</td>
