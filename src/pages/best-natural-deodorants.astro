<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-08-25",
    modifiedTime: "2026-08-25",
    author: "Alex Rivers",
    section: "Grooming",
    tags: [
      "natural deodorant",
      "aluminum-free deodorant",
      "baking soda free deodorant",
      "sensitive skin deodorant",
      "best natural deodorants",
      "grooming",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our #1 Pick",
    link: "#native-classic",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
