    id: "kosas-chemistry-aha",
    name: "Kosas Chemistry AHA Serum Deodorant",
    category: "AHA Serum, Underarm Skincare Hybrid",
    badge: "Best for Underarm Skin",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 9100,
