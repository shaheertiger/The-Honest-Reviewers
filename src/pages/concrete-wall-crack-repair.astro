const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Wall Crack Repair",
          item: "https://www.thehonestreviewers.com/concrete-wall-crack-repair/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can I repair a poured concrete wall crack myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for non-structural cracks. Vertical or slightly diagonal shrinkage cracks under about 1/8 in that are not growing are good DIY candidates, and a low-pressure injection kit can seal them through the full wall thickness. Horizontal cracks, bowing walls, displacement, or cracks over about 1/4 in should be assessed by a structural engineer before any repair."
          }
        },
        {
          "@type": "Question",
          "name": "Is polyurethane or epoxy injection better for foundation wall cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Polyurethane is usually better for leaking cracks, because it stays flexible, tolerates damp conditions and handles small seasonal movement. Epoxy is better for dry, stable cracks that need structural rebonding, because it cures rigid and bonds the crack faces together. Many contractors use polyurethane for water problems and reserve epoxy for engineer-specified structural repairs."
          }
        },
        {
          "@type": "Question",
          "name": "How far apart should injection ports be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kits and contractors commonly space surface ports about 6 to 12 in apart along the crack, with closer spacing on very narrow cracks where resin travels more slowly and wider spacing on larger cracks. Put a port near each end of the crack. During injection, resin should appear at the next port before you move up, which confirms the spacing worked."
          }
        },
        {
          "@type": "Question",
          "name": "Does hydraulic cement fix a concrete wall crack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It stops water fast, but it is rarely a permanent crack repair on its own. Hydraulic cement fills only the outer inch or two of the crack and cures rigid, so in a crack that moves seasonally it tends to debond along its edges. Use it to stop an active leak, then inject the crack for a full-depth seal."
          }
        },
        {
          "@type": "Question",
          "name": "How long does crack injection take to cure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the resin and the temperature. The epoxy surface paste often needs about an hour or more before you can inject. Polyurethane resins typically react and set within minutes to hours. Injection epoxies commonly need around 24 hours before ports can be removed, longer in a cold basement. Always follow the specific kit's label times."
          }
        },
        {
          "@type": "Question",
          "name": "Why do block walls crack differently from poured walls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Block walls are built from hollow units joined by mortar, which is weak in tension, so cracks follow the mortar joints in stair-step or straight vertical lines. Poured walls are monolithic and crack mostly from shrinkage. That is why injection works well in poured walls but poorly in block, where resin runs into the hollow cores instead of sealing."
          }
        },
        {
          "@type": "Question",
          "name": "What does a horizontal crack in a basement wall mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A horizontal crack in a basement wall usually means soil pressure from outside is pushing the wall inward, often from saturated or frozen soil. It is one of the more serious foundation warning signs, especially with any bow in the wall. Do not seal it and move on. Have a structural engineer assess it and recommend bracing or anchoring if needed."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
