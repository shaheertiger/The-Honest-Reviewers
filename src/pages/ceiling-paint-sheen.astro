                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Light reflected</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Flaw hiding</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Wipeability</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flat</td>
                    <td class="px-4 py-4 text-gray-700">Lowest</td>
                    <td class="px-4 py-4 text-gray-700">Best</td>
                    <td class="px-4 py-4 text-gray-700">Lowest</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Matte</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Very good</td>
                    <td class="px-4 py-4 text-gray-700">Fair</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Eggshell</td>
                    <td class="px-4 py-4 text-gray-700">Low-medium</td>
                    <td class="px-4 py-4 text-gray-700">Fair</td>
                    <td class="px-4 py-4 text-gray-700">Good</td>
                  </tr>
