const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Sheen for Ceiling Paint",
          item: "https://www.thehonestreviewers.com/ceiling-paint-sheen/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best sheen for a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flat is the best sheen for most ceilings. It reflects the least light, so it hides drywall seams, patches and roller marks, and it makes touch-ups blend easily. Bathrooms and kitchens are the main exceptions, where a matte or eggshell with mildew resistance may be worth the extra reflection."
          }
        },
        {
          "@type": "Question",
          "name": "Is matte or flat better for ceilings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flat hides imperfections slightly better and touches up more easily; matte is a little more washable. For most ceilings flat is the better choice. Matte makes sense on low ceilings people can reach, in well-ventilated bathrooms or when you want the ceiling to match matte walls."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use eggshell paint on a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but it shows more flaws. Eggshell resists moisture and cleans better, which is useful in bathrooms and kitchens. On large ceilings with strong window light it will highlight seams and roller laps, so it is best reserved for small, humid rooms with careful prep."
          }
        },
        {
          "@type": "Question",
          "name": "What sheen should a bathroom ceiling be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With a good exhaust fan, a mildew-resistant flat or matte ceiling paint works well. With weak ventilation, an eggshell or satin bath paint is safer because it sheds moisture better. Whatever the sheen, the fan running during and after showers matters more than the paint."
          }
        },
        {
          "@type": "Question",
          "name": "Should the ceiling and walls be the same sheen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not necessarily. Many rooms use flat on the ceiling and eggshell or satin on the walls, which is a sensible split. If you want a seamless look with the same color on both, using the same matte paint throughout works well."
          }
        },
        {
          "@type": "Question",
          "name": "Does flat paint make a ceiling look higher?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flat paint does not change the actual height, but because it reflects less light and hides flaws, it makes the ceiling recede visually. A lighter color has a bigger effect on perceived height than sheen does. White or a pale tint in flat is the classic choice for making a ceiling feel higher."
          }
        },
        {
          "@type": "Question",
          "name": "What is ultra-flat ceiling paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ultra-flat paints reflect even less light than standard flat. They are particularly good for large smooth ceilings with lots of window light and for older plaster ceilings with surface variation, because they hide the most. Several ceiling paint lines offer an ultra-flat finish."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
