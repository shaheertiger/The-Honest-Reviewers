                    <td class="px-4 py-4 font-black text-gray-900">Satin</td>
                    <td class="px-4 py-4 text-gray-700">Medium</td>
                    <td class="px-4 py-4 text-gray-700">Poor</td>
                    <td class="px-4 py-4 text-gray-700">Very good</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Semi-gloss and gloss</td>
                    <td class="px-4 py-4 text-gray-700">High</td>
                    <td class="px-4 py-4 text-gray-700">Very poor</td>
                    <td class="px-4 py-4 text-gray-700">Best</td>
