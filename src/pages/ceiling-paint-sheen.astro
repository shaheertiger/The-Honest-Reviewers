import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Ceiling Paints",
    "url": "/best-ceiling-paint/"
  },
  {
    "title": "How to Paint a Ceiling",
    "url": "/how-to-paint-a-ceiling/"
  },
  {
    "title": "Ceiling Paint vs Wall Paint",
    "url": "/ceiling-paint-vs-wall-paint/"
  },
  {
    "title": "Ceiling Paint Roller Marks",
    "url": "/ceiling-paint-roller-marks/"
  },
  {
    "title": "How Much Paint for a Ceiling",
    "url": "/how-much-paint-for-a-ceiling/"
  },
  {
    "title": "Best Interior Paints",
    "url": "/best-interior-paint/"
  }
];
