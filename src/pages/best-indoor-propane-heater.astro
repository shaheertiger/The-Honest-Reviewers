---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Indoor Heaters for Power Outages",
    "url": "/best-indoor-heater-for-power-outage/"
  },
  {
    "title": "Best Kerosene Heaters",
    "url": "/best-kerosene-heater/"
  },
  {
    "title": "Best Carbon Monoxide Detectors",
    "url": "/best-carbon-monoxide-detector/"
  },
  {
    "title": "Best Battery-Powered Heaters",
    "url": "/best-battery-powered-heater/"
  },
  {
    "title": "Best Garage Heaters",
    "url": "/best-garage-heater/"
  },
  {
    "title": "Best Electric Space Heaters",
    "url": "/best-electric-space-heater/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Indoor Propane Heaters in 2026: ODS Safety, BTU and Fuel";
const description =
  "The best indoor propane heaters from Mr. Heater, Dyna-Glo and ProCom, compared on indoor rating, oxygen depletion sensors, BTU per square foot, 1 lb cylinders vs 20 lb tanks, ventilation, CO alarms and altitude limits.";

const PRODUCTS = [
  {
    "id": "mr-heater-portable-buddy-9000",
    "name": "Mr. Heater 9,000 BTU Portable Buddy Radiant Propane Heater",
    "category": "4,000/9,000 BTU Radiant, Indoor/Outdoor Rated, Low-Oxygen Shutoff, Up to 225 sq ft",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Designed and approved for indoor and outdoor use, per the listing",
      "Emergency low-oxygen safety system",
      "Two settings: 4,000 or 9,000 BTU per hour",
      "Heats up to about 225 square feet",
      "Runs on a 1 lb cylinder or a 20 lb tank with optional hose and filter"
    ],
    "cons": [
      "Radiant heat warms what it faces more than the whole room",
      "Burns through a 1 lb cylinder in a few hours on high",
      "Indoor use is not approved in every jurisdiction"
    ],
    "bottomLine": "The default indoor propane heater for one room in an outage: indoor-rated, low-oxygen shutoff, and simple enough to use in the dark.",
    "description": "The Portable Buddy is the heater most people mean when they ask for an indoor propane heater, and it is the right starting point for warming one room through a power outage. The listing states it is designed and approved for indoor and outdoor use, emits 4,000 or 9,000 BTU per hour of radiant heat, and heats up to about 225 square feet. The spec that matters most is the emergency low-oxygen safety system: an oxygen depletion sensor pilot that shuts the gas off if the air in the room gets too thin. That, plus a cracked window and a working CO alarm, is what makes indoor use reasonable. It needs no electricity, so it works when the grid is down. Runtime follows simple math: a 1 lb cylinder holds roughly 21,600 BTU, so it lasts about 5.4 hours on low and a little over 2 hours on high. With an optional Buddy hose and fuel filter it can run from a 20 lb tank kept outdoors for far longer. The trade-off is that radiant heat warms people and objects in front of it rather than the whole room evenly. Indoor use is not approved in some places, so check local rules. For a living room bigger than 225 square feet, the Big Buddy is the better buy."
  },
  {
    "id": "mr-heater-big-buddy-18000",
    "name": "Mr. Heater 18,000 BTU Big Buddy Heater (MH18B NF)",
    "category": "4,000/9,000/18,000 BTU Radiant, Indoor/Outdoor Rated, ODS Shutoff, Up to 450 sq ft",
    "badge": "Best for Larger Rooms",
    "amazonUrl": "#",
    "pros": [
      "Three settings: 4,000, 9,000 or 18,000 BTU per hour",
      "Heats up to about 450 square feet",
      "Automatic low-oxygen shutoff system (ODS)",
      "Designed and approved for indoor and outdoor use",
      "Takes two 1 lb cylinders or a 20 lb tank with optional hose"
    ],
    "cons": [
      "High setting empties 1 lb cylinders quickly",
      "Larger and heavier than the Portable Buddy",
      "Mr. Heater prohibits unauthorized accessories and attachments"
    ],
    "bottomLine": "The pick for a living room or open-plan space, with enough output to take the chill off a whole floor area in an outage.",
    "description": "The Big Buddy is for households that need to keep a larger room warm, such as an open living and kitchen area where the family gathers during an outage. The listing specifies 4,000, 9,000 or 18,000 BTU per hour, coverage up to about 450 square feet, and an automatic low-oxygen shutoff system (ODS). That three-step range is the spec that matters: run it on high to bring a cold room up to temperature, then drop to low to hold it and stretch your fuel. It is designed and approved for indoor and outdoor use and runs on two 1 lb cylinders or, with an optional hose, a 20 lb tank. Other Big Buddy versions on Amazon list a built-in fan that combines radiant heat with convection airflow, which helps spread warmth further than the smaller Buddy. Runtime is straightforward arithmetic: a 20 lb tank holds about 432,000 BTU, so on low the Big Buddy family is listed at up to 216 hours on two 20 lb tanks. On high it uses fuel more than four times faster. The trade-offs are size and appetite. It is bulkier than the Portable Buddy, and 18,000 BTU in a small closed room is too much heat and too much combustion for the space. Mr. Heater also warns that unauthorized accessories void the warranty. For a single bedroom-sized space, buy the Portable Buddy instead."
  },
  {
    "id": "mr-heater-buddy-flex-11000",
    "name": "Mr. Heater Buddy FLEX 11,000 BTU Radiant Propane Heater",
    "category": "8,000-11,000 BTU Radiant, Indoor/Outdoor Rated, Omni-Directional Burner, Up to 275 sq ft",
    "badge": "Best Even Heat",
    "amazonUrl": "#",
    "pros": [
      "Designed and approved for indoor and outdoor use",
      "Omni-directional fiber mesh burner spreads heat more evenly",
      "8,000 to 11,000 BTU per hour output",
      "Heats up to about 275 square feet",
      "Part of Mr. Heater's Buddy FLEX system of accessories"
    ],
    "cons": [
      "Runtime is short: up to 3.5 hours on low and 2 on high, per the listing",
      "Low setting is higher than the classic Buddy's 4,000 BTU",
      "Better suited to shorter heating sessions than all-night use"
    ],
    "bottomLine": "A slightly stronger Buddy with a round burner that throws heat in more directions, for short sessions in a mid-size room.",
    "description": "The Buddy FLEX suits people who want a little more heat than the classic Portable Buddy and a burner that spreads it around the room instead of straight ahead. The listing describes an omni-directional fiber mesh burner for more uniform heat distribution, an output of 8,000 to 11,000 BTU per hour, and coverage up to about 275 square feet. The burner shape is the spec that matters: a flat Buddy face warms what it points at, while the FLEX burner radiates in a wider arc, which helps when several people are sitting around it. It is designed and approved for indoor and outdoor use and belongs to Mr. Heater's FLEX line, which shares cylinders and accessories across products. Runtime is the trade-off. The listing specifies up to 3.5 hours on low and 2 hours on high, so on 1 lb cylinders you will be swapping fuel often during a long outage, and its low setting is still double the classic Buddy's 4,000 BTU. Treat it as a heater for evenings and short warm-up sessions rather than slow all-day background heat. As with any indoor propane heater, keep a window cracked and a CO alarm running. If you want the longest runtime per cylinder, the Portable Buddy on low or the Little Buddy goes further."
  },
  {
    "id": "mr-heater-little-buddy-3800",
    "name": "Mr. Heater 3,800 BTU Little Buddy Portable Radiant Propane Heater (Midnight Edition)",
    "category": "3,800 BTU Radiant, Indoor/Outdoor Rated, Up to 95 sq ft, 5.6 Hr per 1 lb Cylinder",
    "badge": "Best for Small Spaces",
    "amazonUrl": "#",
    "pros": [
      "Up to 5.6 hours on a single 1 lb cylinder, per the listing",
      "Small 3,800 BTU output suits a bathroom or small office",
      "Designed and approved for indoor and outdoor use",
      "No electricity required",
      "Compact enough to store with emergency supplies"
    ],
    "cons": [
      "Heats only about 95 square feet",
      "Single fixed output with no low setting",
      "Indoor use not approved in Canada or Massachusetts"
    ],
    "bottomLine": "The small, frugal option for warming one small room or a single person during an outage.",
    "description": "The Little Buddy is for heating a small space, such as a home office, bathroom or the corner of a room where one or two people sit, without burning more propane than you need. The listing specifies 3,800 BTU of radiant heat for spaces up to 95 square feet, and up to 5.6 hours on a single 1 lb cylinder. That small output is the spec that matters. Every BTU you burn indoors also uses oxygen and adds water vapour and carbon dioxide to the room, so matching the heater to the space is a safety choice as much as an economy one. A 3,800 BTU heater in a small room is far easier to ventilate than a 9,000 BTU heater in the same space. It is designed and approved for indoor and outdoor use, though the listing notes indoor use is not approved in Canada or Massachusetts, and it needs no electricity. The trade-offs are clear: one fixed output, no hose option mentioned in the listing, and too little heat for a living room. It works best close to the people it is warming. If you need to heat a whole bedroom-sized room or more, the Portable Buddy, with its 9,000 BTU high setting, is the better choice."
  },
  {
    "id": "dyna-glo-bfss10lpt-2p",
    "name": "Dyna-Glo BFSS10LPT-2P 10,000 BTU Liquid Propane Blue Flame Thermostatic Vent-Free Wall Heater",
    "category": "8,000-10,000 BTU Blue Flame Convection, Thermostat, LP Only, Up to 300 sq ft",
    "badge": "Best Vent-Free Wall Heater",
    "amazonUrl": "#",
    "pros": [
      "Thermostat control holds the room at a set temperature",
      "Blue flame convection warms the air across the room",
      "Heats up to about 300 square feet",
      "No electricity required for backup heating",
      "Modest 10,000 BTU maximum is easier to ventilate"
    ],
    "cons": [
      "Must be installed on a gas line or outdoor tank, not a 1 lb cylinder",
      "Propane only; fuel conversion is not permitted",
      "Vent-free heaters are restricted in some states and rooms"
    ],
    "bottomLine": "A permanent, thermostatic propane heater for one room that keeps working when the power is out.",
    "description": "The Dyna-Glo BFSS10LPT-2P is for homeowners who want a permanent backup heater in one room rather than a portable unit they drag out in a storm. It is a 10,000 BTU vent-free wall heater for liquid propane, and the listing specifies 8,000 to 10,000 BTU per hour of adjustable output, a thermostat control knob that automatically maintains the room's heat level, and coverage up to about 300 square feet. The spec that matters is the blue flame convection design. Instead of beaming heat at whatever is in front of it like a Buddy, it warms the air, which circulates around the room the way central heat does. Combined with the thermostat, that gives steadier, more even warmth over a long outage, and it needs no electricity. The trade-offs are installation and rules. The listing says it is propane ready with fuel conversion not permitted, and like any vent-free wall heater it runs from a gas supply line or an outdoor tank, ideally installed by a qualified gas fitter. Vent-free heaters add moisture to a home, and some states and cities restrict them or bar them from bedrooms and bathrooms, so check local code before buying. If you rent or only need heat a few times a year, a portable Buddy is the simpler choice."
  },
  {
    "id": "dyna-glo-irss12lpt-2p",
    "name": "Dyna-Glo IRSS12LPT-2P 12,000 BTU Liquid Propane Infrared Vent-Free Thermostatic Wall Heater",
    "category": "12,000 BTU Infrared, Thermostat, LP Only, Up to 300 sq ft",
    "badge": "Best Infrared Wall Heater",
    "amazonUrl": "#",
    "pros": [
      "Infrared heat warms people and objects directly",
      "Thermostat control maintains the set heat level",
      "Up to 12,000 BTU per hour for up to 300 square feet",
      "No electricity required",
      "Wall-mounted, so it stays out of the way of foot traffic"
    ],
    "cons": [
      "Infrared warms what faces it more than the far side of a room",
      "Needs a fixed gas supply and proper installation",
      "Field conversion to natural gas is not permitted"
    ],
    "bottomLine": "A wall-mounted infrared heater for rooms where people sit in one area, such as a den or workshop corner.",
    "description": "The Dyna-Glo IRSS12LPT-2P suits a room where people spend time in one zone, such as a den with a sofa facing the wall or a hobby room, and where the owner wants a fixed backup heater that runs without power. The listing specifies infrared technology that warms objects first, similar to the sun, up to 12,000 BTU per hour, coverage up to about 300 square feet, and a thermostat control knob that maintains the heat level. Infrared is the spec that matters. People in front of the heater feel warm quickly even before the air temperature has caught up, which is useful in a cold house at the start of an outage. The trade-off is that the far side of the room stays cooler than with a blue flame convection heater like the Dyna-Glo BFSS10LPT-2P. It is liquid propane only, and field conversion is not permitted. Like every vent-free wall heater it needs a proper gas supply from a line or outdoor tank, installed by a qualified gas fitter, plus clear wall and floor clearances from furniture and curtains. Vent-free heaters are restricted in some places and in certain rooms, so check local code. If you need heat spread evenly across a room rather than aimed at a seating area, the blue flame Dyna-Glo is the better match."
  },
  {
    "id": "procom-ml100tbahr",
    "name": "ProCom ML100TBAHR 10,000 BTU Liquid Propane Ventless Heater with Hose and Regulator",
    "category": "10,000 BTU Blue Flame, Thermostat, ODS Pilot, Includes 10-ft Hose and Regulator",
    "badge": "Best With 20 lb Tank Kit",
    "amazonUrl": "#",
    "pros": [
      "Built-in pilot oxygen depletion sensor (ODS)",
      "Includes a 10-foot hose with regulator for a 20 lb cylinder",
      "Thermostat cycles the burner to hold the set temperature",
      "Push-button piezo ignition, no electricity required",
      "Heats up to about 300 square feet"
    ],
    "cons": [
      "Marketed for ice houses as well as homes; follow residential code",
      "Hose setup still needs the tank outside the living space",
      "Some states and rooms restrict vent-free heaters"
    ],
    "bottomLine": "A compact thermostatic blue flame heater that arrives with the hose and regulator for a 20 lb tank.",
    "description": "The ProCom ML100TBAHR is for buyers who want the steady, thermostatic heat of a vent-free blue flame heater but need it to run from a standard 20 lb propane cylinder rather than a plumbed line. That is the spec that sets it apart: the listing says it includes a 10-foot hose with a regulator so the heater can operate off a standard 20 lb cylinder. It produces up to 10,000 BTU, heats up to about 300 square feet, and its thermostat automatically cycles the burner on and off to maintain the room temperature. Safety equipment is clearly listed: push-button piezo ignition and a built-in pilot oxygen depletion sensor that shuts the heater down if oxygen in the room drops. It needs no electricity, which is the point in an outage. The trade-offs need care. ProCom markets this model for ice fishing houses as well as residential rooms, and a 20 lb cylinder belongs outdoors, not inside a home, so the hose has to reach from an outside tank through a properly sealed opening. Many owners have a gas fitter mount it and run a permanent line instead. Vent-free heaters are restricted in some states and rooms, so check local code. If you need a heater you can move between rooms, a Mr. Heater Buddy is simpler."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Indoor Propane Heaters",
          item: "https://www.thehonestreviewers.com/best-indoor-propane-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best indoor propane heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the Mr. Heater 9,000 BTU Portable Buddy. It is listed as designed and approved for indoor and outdoor use, has a low-oxygen safety shutoff, heats up to about 225 square feet and needs no electricity. Choose the Big Buddy for larger rooms, or a Dyna-Glo vent-free wall heater if you want permanent thermostatic backup heat."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to use a propane heater indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the heater is rated for indoor use and has an oxygen depletion sensor, and only with fresh air and a working battery-backed carbon monoxide alarm. Keep it clear of anything that burns, turn portable heaters off before sleep, and never use outdoor heaters, grills, camp stoves or a gas oven to heat a living space."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 1 lb propane cylinder last in a Buddy heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 1 lb cylinder holds roughly 21,600 BTU, so divide that by the heater's output. A Portable Buddy on its 4,000 BTU low setting runs about five hours; on 9,000 BTU high, a little over two. The 3,800 BTU Little Buddy is listed at up to 5.6 hours. For long outages, a 20 lb tank outdoors is cheaper."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to crack a window with an indoor propane heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every propane flame uses oxygen and releases water vapour and carbon dioxide. Follow the fresh-air opening in your heater's manual, which in practice usually means cracking a window an inch or two in the heated room or a connected room. Foggy windows or a headache are signs the room needs more fresh air."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a 20 lb propane tank indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Fire codes generally do not allow 20 lb cylinders inside homes, basements or attached garages, because propane is heavier than air and a leak pools at floor level. Keep the tank outside and run the heater's approved hose in through a cracked window or proper wall fitting, with the fuel filter Buddy heaters need on that hose."
          }
        },
        {
          "@type": "Question",
          "name": "Can you sleep with a propane heater on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Do not sleep with a portable propane heater running. Warm the room before bed, turn the heater off and use blankets or a battery-powered electric blanket overnight. Permanently installed vent-free wall heaters follow local building code, and many codes prohibit them in bedrooms. A battery-backed carbon monoxide alarm should be in every sleeping area."
          }
        },
        {
          "@type": "Question",
          "name": "Do indoor propane heaters work at high altitude?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often not above the manual's limit. Oxygen depletion sensors are calibrated for lower elevations and can shut the heater off in thin mountain air. Mr. Heater's Buddy manuals list about 7,000 feet as the maximum, and many vent-free wall heaters set a lower limit. Check your exact model, and never tamper with the sensor to keep it running."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Appliances",
    tags: [
      "indoor propane heater",
      "best indoor propane heater",
      "indoor propane heater for power outage",
      "indoor safe propane heater",
      "vent free propane heater",
      "mr heater buddy"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Indoor Propane Heaters</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Propane heat works when the power is out, but only the right heater, set up the right way, belongs inside a home. Seven indoor-rated and vent-free heaters, with the safety rules that come with them.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#mr-heater-portable-buddy-9000"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which Are Safe Indoors?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#indoor-safe" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Which Heaters Are Safe Indoors</a>
          <a href="#what-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Size You Need</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Indoor Propane Heaters</a>
          <a href="#cylinders-vs-tank" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. 1 lb Cylinders vs 20 lb Tank</a>
          <a href="#ventilation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Ventilation</a>
          <a href="#co-detectors" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Carbon Monoxide Detectors</a>
          <a href="#radiant-vs-blue-flame" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Radiant vs Blue Flame</a>
          <a href="#altitude" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Altitude Limits</a>
          <a href="#propane-vs-kerosene" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Propane vs Kerosene vs Battery</a>
          <a href="#safe-setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Safe Setup Checklist</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
