const description =
  "The best water heater anode rods on Amazon from Ozek, Corro-Protec, Water Connection and Eastman, compared on material, hex vs outlet fit, 3/4-inch NPT length, flexible designs and rotten-egg smell.";

const PRODUCTS = [
  {
    "id": "ozek-44-segmented-magnesium",
    "name": "Ozek 44 in Segmented Magnesium Anode Rod (3/4 in NPT)",
    "category": "Magnesium, Flexible 44-in Segmented, 3/4-in NPT Hex, PTFE Tape Included",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Magnesium, the most active standard anode material",
      "Segmented 44-inch design bends in under low ceilings",
      "Standard 3/4-inch NPT thread for dedicated hex anode ports",
      "Pipe sealing tape included",
      "Listing spells out which heaters it does not fit"
