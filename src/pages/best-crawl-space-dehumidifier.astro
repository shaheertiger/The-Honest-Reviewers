---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Dehumidifier for Basement",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Whole-House vs Portable Dehumidifier",
    "url": "/whole-house-vs-portable-dehumidifier/"
  },
  {
    "title": "What Size Dehumidifier for a Basement",
    "url": "/what-size-dehumidifier-for-basement/"
  },
  {
    "title": "Vapor Barrier vs Waterproofing Membrane",
    "url": "/vapor-barrier-vs-waterproofing-membrane/"
  },
  {
    "title": "How Much Electricity Does a Dehumidifier Use?",
    "url": "/how-much-electricity-does-a-dehumidifier-use/"
  },
  {
    "title": "Do You Need a Dehumidifier in Winter?",
    "url": "/do-you-need-a-dehumidifier-in-winter/"
  },
  { title: "Crawl Space Encapsulation Cost", url: "/crawl-space-encapsulation-cost/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Crawl Space Dehumidifiers for Sealed and Encapsulated Crawl Spaces";
const description =
  "Seven crawl space dehumidifiers compared on low-temperature output, real pint ratings, drainage and size, plus why you must encapsulate before you buy.";

const PRODUCTS = [
  {
    "id": "alorair-sentinel-hd55-crawl-space",
    "name": "AlorAir Sentinel HD55 Crawl Space Dehumidifier",
    "category": "55 PPD at AHAM, 120 PPD Saturation, Up to 1,300 Sq Ft",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 1800,
    "pros": [
      "Rated to run down to 33.8°F with automatic defrost, so it keeps working through a cold crawl space winter",
      "Draws about 4.1 amps, low enough to share a circuit with a sump pump or crawl space lighting",
      "Metal housing and a 6-inch duct collar, which a plastic portable never offers",
      "Washable MERV-8 filter and a gravity drain line included; a pump version (HD55P) is sold for sites without a drain",
      "Current versions add Wi-Fi app control, useful for a space you rarely crawl into"
    ],
    "cons": [
      "Sized for up to about 1,300 sq ft of sealed crawl space, so large or leaky crawl spaces need the HD90",
      "App and firmware experience is functional rather than polished"
    ],
    "bottomLine": "The right size, the right temperature range and a sensible price for the typical encapsulated crawl space under a 1,000 to 1,800 sq ft house.",
    "description": "Most sealed crawl spaces under an average house need a low-profile, low-temperature unit rated somewhere around 50 to 70 pints at AHAM conditions, and that is exactly where the HD55 sits. AlorAir rates it at 55 pints per day at 80°F and 60% relative humidity and 120 pints at saturation, and it covers up to roughly 1,300 square feet of properly encapsulated space. What matters more than either number is the operating range: the HD55 is rated from 33.8°F to 104°F with automatic defrost, which is the difference between a machine that runs through a January cold snap and one that ices its coil and sits idle. It draws about 4.1 amps and delivers roughly 2.4 liters per kWh, and the housing is metal rather than the thin plastic of a bedroom dehumidifier. It ships with a drain line, a washable MERV-8 filter and a 6-inch duct collar, so you can pull air from the far end of a long crawl space instead of just drying the corner it sits in. If you have no downhill path for a gravity drain, buy the HD55P, the version with a built-in condensate pump, rather than bolting on a separate pump later. We would size up to the HD90 for anything over 1,500 square feet or for a crawl space that is not fully sealed yet."
  },
  {
    "id": "aprilaire-e070-crawl-space",
    "name": "Aprilaire E070 70 Pint Crawl Space Dehumidifier",
    "category": "70 PPD at 80°F/60%, 12.5-Inch Tall, Up to 2,200 Sq Ft",
    "badge": "Best Pro-Grade",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 600,
    "pros": [
      "Only 12.5 inches tall and 12.5 inches wide, so it slides between joists and fits low crawl spaces",
      "Honest dual rating: 70 pints at 80°F/60% and 53 pints at the cooler 73°F/60% condition",
      "Rated to operate down to about 40°F with automatic defrost",
      "Washable MERV-8 filter, corrosion-resistant aluminum coils and a 10-foot drain tube included",
      "Made by the company whose whole-house humidity equipment many HVAC contractors already install"
    ],
    "cons": [
      "No built-in pump; you need a gravity route or a separate condensate pump",
      "Its 40°F floor is fine for most sealed crawl spaces but not as low as AlorAir's 33.8°F"
    ],
    "bottomLine": "The contractor's choice for tight, low crawl spaces, with a spec sheet that tells you what it does at realistic temperatures instead of only the flattering one.",
    "description": "Aprilaire builds whole-house humidifiers and dehumidifiers that HVAC contractors install every day, and the E070 is its purpose-built crawl space model. The first thing you notice is the shape: 12.5 inches wide, 12.5 inches tall and 25 inches deep, which lets it sit between floor joists or slide through a small access hatch without drama. The second is the spec sheet, which lists two capacity figures instead of one. At the AHAM condition of 80°F and 60% relative humidity it removes 70 pints per day; at 73°F and 60% it removes 53. That second number is closer to what a crawl space actually looks like in summer, and it is refreshing to see a manufacturer publish it rather than leave you to discover the gap. Aprilaire rates it for spaces up to about 2,200 square feet and says it operates down to 40°F with automatic defrost. It includes a washable MERV-8 filter and 10 feet of drain tubing, and the coils are corrosion-resistant aluminum, which matters in an environment that stays damp for years. The one gap is drainage: there is no built-in pump, so if the crawl space has no floor drain, sump pit or downhill exit, budget for a separate condensate pump. For a sealed crawl space with a drain route, it is the most refined unit here."
  },
  {
    "id": "santa-fe-compact70-crawl-space",
    "name": "Santa Fe Compact70 Dehumidifier",
    "category": "70 PPD at 80°F/60%, 12 x 12 x 21 Inches, ENERGY STAR Most Efficient",
    "badge": "Most Compact",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 300,
    "pros": [
      "70 pints at 80°F/60% from the smallest body in this guide",
      "Tiny 12 x 12 x 21 inch body is the easiest unit here to get through a small access door",
      "150 CFM blower and 580-watt draw on a standard 120-volt circuit",
      "Six-year manufacturer warranty, the longest of any unit in this guide",
      "Santa Fe advertises an ENERGY STAR Most Efficient designation for this model"
    ],
    "cons": [
      "Minimum operating temperature is listed at 49°F, so it is less suited to cold-climate crawl spaces",
      "No built-in pump and a premium price for a compact unit"
    ],
    "bottomLine": "The easiest unit to get into a tight crawl space and a strong long-term pick in mild or warm climates, where its temperature floor never comes into play.",
    "description": "Santa Fe is the Therma-Stor brand that basement and crawl space contractors have used for years, and the Compact70 is the smallest unit in its range. It removes 70 pints per day at 80°F and 60% relative humidity from a body just 12 inches wide, 12 inches tall and 21 inches deep, which makes it the easiest unit in this guide to carry through a small access hatch. Efficiency is the other selling point. Santa Fe advertises an ENERGY STAR Most Efficient designation for it, and on a crawl space unit that may run several thousand hours a year, efficiency shows up on the electric bill. It moves 150 CFM, draws around 580 watts and 5.1 amps, and Santa Fe sizes it for roughly 1,800 to 2,600 square feet of sealed crawl space. The six-year warranty is the longest we found. The honest drawback is temperature. Santa Fe lists a 49°F minimum, which is fine for a sealed crawl space in the South or a mild coastal climate but not ideal where the crawl space dips into the low 40s every winter. Humidity load is usually lowest in the cold months, so this is less of a problem than it sounds, but in the far North we would pick the AlorAir or the Aprilaire instead. There is no built-in pump."
  },
  {
    "id": "alorair-sentinel-hd90-crawl-space",
    "name": "AlorAir Sentinel HD90 Crawl Space Dehumidifier",
    "category": "90 PPD at AHAM, 198 PPD Saturation, Up to 2,600 Sq Ft",
    "badge": "Best for Large Crawl Spaces",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "90 pints at AHAM conditions and 198 at saturation handles big footprints and recovery after a wet spell",
      "ENERGY STAR certified with a listed efficiency of about 2.69 liters per kWh",
      "Rated to operate down to 33.8°F, like the smaller Sentinel units",
      "AlorAir publishes a 60°F capacity figure of roughly 48 pints, a useful reality check",
      "Five-year manufacturer warranty"
    ],
    "cons": [
      "About 17.7 inches tall, which rules it out for very low crawl spaces",
      "Oversized for an average sealed crawl space, where it will short-cycle"
    ],
    "bottomLine": "The pick for crawl spaces over about 1,500 sq ft, for homes with partial encapsulation, or for a humid climate where a 55-pint unit runs all day and still loses ground.",
    "description": "The HD90 is the big brother of the HD55, and it earns its place in homes where the crawl space is large, the climate is humid or the encapsulation is not yet perfect. AlorAir rates it at 90 pints per day at 80°F and 60% and 198 at saturation, and it covers up to about 2,600 square feet. The most useful number on its spec sheet, though, is the one most brands leave off: about 48 pints per day at 60°F and 60%. That is what a big crawl space dehumidifier really delivers on a mild spring day in a cool crawl space, and it is a good reminder of why you should not size a crawl space unit on the AHAM figure alone. It is ENERGY STAR certified with a listed efficiency of about 2.69 liters per kWh, it is rated to run down to 33.8°F with defrost, and it comes with a five-year warranty. The downside is height. At roughly 23 by 15 by 18 inches it needs about 18 inches of clearance, which many crawl spaces simply do not have, so measure the hatch and the lowest beam before ordering. In a typical 1,000 square foot sealed crawl space it is more machine than you need and will cycle on and off; buy it when the space is genuinely large or genuinely wet."
  },
  {
    "id": "alorair-sentinel-hd35-crawl-space",
    "name": "AlorAir Sentinel HD35P Dehumidifier with Pump",
    "category": "35 PPD at AHAM, 70 PPD Saturation, Built-In Pump, Up to 1,000 Sq Ft",
    "badge": "Best for Small Crawl Spaces",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 700,
    "pros": [
      "Built-in condensate pump plus a gravity option, so it works whether or not you have a downhill drain",
      "ENERGY STAR certified and rated to operate down to 33.8°F",
      "Sized for up to about 1,000 sq ft, which suits small homes, additions and cottages",
      "Quieter than the larger units at a listed 55 dB maximum",
      "Lowest purchase price of the purpose-built crawl space units here"
    ],
    "cons": [
      "35 pints at AHAM is modest, so it will struggle in a leaky or partially sealed crawl space",
      "Pump hose is shorter than the gravity hose, so long runs need extra tubing"
    ],
    "bottomLine": "For a small, fully sealed crawl space it is all the machine you need, and the built-in pump makes it the easiest install in this guide.",
    "description": "Not every crawl space needs a 70-pint machine. A fully sealed crawl space under a small house, an addition or a cottage often only needs something that can hold 50% to 55% relative humidity against a light moisture load, and the HD35P is built for that job. AlorAir rates it at 35 pints per day at AHAM conditions and 70 at saturation, for spaces up to roughly 1,000 square feet. It is ENERGY STAR certified, it is rated to operate down to 33.8°F, and its listed maximum noise level is 55 dB, noticeably quieter than the bigger units if the crawl space sits under a bedroom. The feature that makes it the easiest install here is drainage. It includes a built-in condensate pump with its own hose for pushing water up and out through a rim joist or into a sump pit, plus a longer hose for gravity drainage if you have a downhill route. That flexibility matters because drainage is where most crawl space installs go wrong. The limits are the obvious ones. Thirty-five pints is not much headroom, so if your vapor barrier is incomplete, the vents are still open or the crawl space floods in spring, it will run constantly and still lose. In that case, fix the envelope first or step up to the HD55P."
  },
  {
    "id": "santa-fe-advance90-crawl-space",
    "name": "Santa Fe Advance90 Dehumidifier",
    "category": "90 PPD at 80°F/60%, 309 CFM, MERV-13 Filter",
    "badge": "Best for Ducted Installs",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 200,
    "pros": [
      "90 pints per day at 80°F/60% with a 309 CFM blower that moves serious air across a big space",
      "Horizontal design with dual airflow outlet options suits ducted installs",
      "MERV-13 filter is a step above the MERV-8 filters on most crawl space units",
      "Efficient for its size at about 6.4 pints per kWh",
      "Auto defrost and auto restart after a power cut"
    ],
    "cons": [
      "80 lb and about 19.4 inches tall, so it needs a generous crawl space and two people to install",
      "Overkill and overpriced for an average sealed crawl space"
    ],
    "bottomLine": "A contractor-grade unit for large crawl spaces or basement-plus-crawl-space setups where you plan to duct the supply air, not a first choice for a standard install.",
    "description": "The Advance90 is Santa Fe's larger contractor unit, and it is the one to look at when you intend to duct the air rather than let the unit sit in one spot. It removes 90 pints per day at 80°F and 60%, and its 309 CFM blower moves far more air than the compact units here, which is what makes ducting worthwhile: you can pull return air from the damp far end of a long crawl space and push dry air back across the whole floor. Santa Fe lists it at about 6.4 pints per kWh, which is excellent for a machine this size, and it uses a MERV-13 filter, a noticeable step up from the MERV-8 filters on most crawl space units. It sizes the unit at around 2,200 square feet of crawl space based on a five-foot height. Auto defrost and auto restart are included. The drawbacks are physical and financial. It weighs about 80 pounds and measures roughly 14.5 by 19.4 by 26 inches, so it needs a crawl space with real headroom and an access opening you can get it through. It is also priced as a professional unit. For a standard 1,000 to 1,500 square foot sealed crawl space, the Compact70 or HD55 does the job for less; the Advance90 earns its keep in large homes, ducted systems and spaces with a basement and crawl space served together."
  },
  {
    "id": "alorair-storm-lgr-extreme-crawl-space",
    "name": "AlorAir Storm LGR Extreme Dehumidifier with Pump",
    "category": "85 PPD at AHAM, 180 PPD Saturation, Built-In Pump",
    "badge": "Best for Wet Crawl Spaces",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1100,
    "pros": [
      "180 pints at saturation makes it the fastest way to pull down a crawl space after a leak or flood",
      "Heavy-duty built-in condensate pump designed for continuous commercial use",
      "Rated from 33.8°F to 104°F with automatic defrost",
      "Top handles and a rugged housing built to be moved between job sites",
      "210 CFM airflow at a 5.6-amp draw on a standard outlet"
    ],
    "cons": [
      "About 17.3 inches tall and 70 lb, too bulky for many low crawl spaces",
      "Louder than the Sentinel units at up to about 58 dB"
    ],
    "bottomLine": "Buy it for recovery after water intrusion or for a crawl space that is still wet while you fix the drainage, then consider something smaller for the long haul.",
    "description": "Low grain refrigerant, or LGR, dehumidifiers were built for water damage restoration, where the job is to dry a soaked structure fast and keep pulling moisture even as the air gets drier. The Storm LGR Extreme brings that design into a unit you can buy and run yourself. AlorAir rates it at 85 pints per day at AHAM conditions and 180 at saturation, and it covers up to roughly 2,300 square feet. It moves about 210 CFM, draws 5.62 amps and runs at around 2.44 liters per kWh. The heavy-duty condensate pump is built in, and it is rated to operate from 33.8°F to 104°F with automatic defrost. Where it belongs is the crawl space that is actively wet: after a plumbing leak, after a spring when the crawl space took on water, or while you are still waiting on a drainage contractor. In those conditions a 55-pint unit falls behind for days, and the Storm pulls the space down quickly. It is less ideal as a permanent crawl space dehumidifier. At about 22.8 by 13.7 by 17.3 inches and 70.5 pounds it needs headroom and a strong back, and at up to about 58 dB it is the loudest unit here. Many owners use it for the recovery phase and then run a Sentinel for maintenance."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Crawl Space Dehumidifiers",
          item: "https://www.thehonestreviewers.com/best-crawl-space-dehumidifier/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size dehumidifier do I need for a crawl space?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A common starting point, reflected in recent editions of the residential building code, is about 70 pints per day at AHAM conditions for every 1,000 square feet of sealed crawl space. For a typical 800 to 1,300 square foot sealed crawl space, a 55 to 70 pint unit is right. Size up for humid climates, high water tables or incomplete encapsulation."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a regular portable dehumidifier in a crawl space?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but it rarely lasts. Portables lose most of their capacity in the cool temperatures common in crawl spaces, spend long periods defrosting, and are not built for years of unattended continuous running. Their plastic housings and short warranties reflect that. A purpose-built crawl space unit costs more upfront but usually costs less over its life."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to encapsulate my crawl space before adding a dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A dehumidifier in a vented crawl space with bare soil is drying outdoor air and ground moisture that never stop arriving. At minimum, cover the floor with a sealed vapor barrier that runs up the walls and close the foundation vents. Without that, even a large unit will run constantly and struggle to hold humidity."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should a crawl space be kept at?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most contractors target 50% to 55% relative humidity. That keeps conditions below the roughly 60% level where mold and dust mites thrive and keeps wood framing dry enough to prevent rot. Going below about 45% wastes energy. Verify the level at the far end of the space with a separate hygrometer rather than trusting the unit's display."
          }
        },
        {
          "@type": "Question",
          "name": "Where should the dehumidifier water drain in a crawl space?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best destination is a floor drain or sump pit reached by a steadily sloping gravity line. Without a downhill route, use a unit with a built-in pump or add a condensate pump, and discharge outside well away from the foundation. Protect the outside end from freezing and inspect it every season so a blockage does not shut the unit down."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a crawl space dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 55 to 70 pint crawl space unit draws roughly 500 to 600 watts while running. In a well-sealed crawl space it may run a third to half the time in summer and much less in winter, which typically works out to tens of dollars per month in peak season. Efficient models and good encapsulation both cut run time significantly."
          }
        },
        {
          "@type": "Question",
          "name": "What is an LGR dehumidifier and do I need one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LGR stands for low grain refrigerant. These units are designed to keep removing moisture as air gets drier and cooler, and they come from the water damage restoration industry. You need one for drying a crawl space after a leak or flood. For a sealed crawl space in steady state, a compact crawl space unit is usually enough and costs less."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Basement Waterproofing",
    tags: [
      "best crawl space dehumidifier",
      "best dehumidifier for crawl space",
      "crawl space dehumidifier",
      "crawl space encapsulation",
      "LGR dehumidifier",
      "AlorAir Sentinel"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Units Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Crawl Space Dehumidifiers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven purpose-built units compared on what matters under a house: output in cool air, minimum operating temperature, drainage and whether it will even fit through the hatch.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#alorair-sentinel-hd55-crawl-space"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Encapsulate First
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#encapsulate-first" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Encapsulate First</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
