      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Alliance Gator polymeric sand any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gator is one of the better-documented premium polymeric sands, with clear joint-width ratings, a 15-minute rain-safe window on its G2 formulas and an overlay rating on Maxx G2. Its weaknesses are a narrow colour range and dealer-led availability. Like every polymeric sand, it performs only as well as the installation: dry pavers, full compaction and correct watering."
          }
        },
        {
          "@type": "Question",
