const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Riding Lawn Mower Maintenance",
          item: "https://www.thehonestreviewers.com/riding-lawn-mower-maintenance/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How often should you change the oil in a riding mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most riding mower engine manuals specify an oil change every 50 to 100 hours or at least once a season, with an earlier first change after break-in on a new engine. Heavy use, dusty conditions or towing justify the shorter end. Follow your engine manufacturer's interval, since it varies by engine."
          }
        },
        {
          "@type": "Question",
          "name": "What maintenance does a riding lawn mower need every year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At minimum: change the oil and filter, replace the air filter and spark plug, sharpen or replace the blades, replace the fuel filter, grease all fittings, level the deck, check belts and tire pressures, and prepare the fuel and battery for winter storage. Larger properties may need some tasks more than once a year."
          }
        },
        {
          "@type": "Question",
          "name": "How often should riding mower blades be sharpened?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typically every 25 to 50 hours of use, which is once or twice a season for most residential lawns. Sandy soil, roots and stones dull blades faster. Torn, ragged grass tips that turn brown after mowing are the clearest sign the blades need attention."
          }
        },
        {
          "@type": "Question",
          "name": "What tire pressure should a riding mower have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Riding mower tires typically run at low pressures, often somewhere around 10 to 20 PSI depending on the tire size and type. The correct figure is printed on the tire sidewall or in the manual. Keep left and right sides matched, since uneven pressure tilts the deck and produces an uneven cut."
          }
        },
        {
          "@type": "Question",
          "name": "Should I run my riding mower out of gas for winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Either running it dry or filling it with stabilized fuel works, and manufacturers differ on which they prefer. Running dry removes the fuel that would gum the carburetor; stabilized fuel keeps seals from drying out. Follow your manual, and never leave untreated ethanol-blended fuel in the system over winter."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to grease my riding lawn mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it has grease fittings, which many riders do on deck spindles, front axle pivots and steering components. Greasing them a couple of times a season pushes out moisture and old grease and prevents bearing and bushing wear. Some machines use sealed components that need no grease; your manual lists the points."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know if my riding mower deck is level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Park on a flat surface with tires correctly inflated, turn the blades so the tips point side to side, and measure tip height from the ground on each side; then turn them front to back and measure again. Compare with the manual's specification, which usually has the front slightly lower than the rear."
          }
        }
      ],
    },
