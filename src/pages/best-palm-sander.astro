          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 180 to 220 for most furniture taking a stain or clear finish. Going finer closes the grain and can make stain absorb unevenly, producing a blotchy result. Painted work can stop at 150, since primer fills the remaining scratches.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a vacuum?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Strongly recommended. Beyond the health benefit of capturing fine dust, extracting from under the disc stops loose grit being dragged across the surface, which is a significant cause of scratches at fine grits. Use a fine dust or HEPA filter in the vacuum.",
          },
        },
        {
          "@type": "Question",
          name: "What orbit stroke is best?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 2 to 3mm for furniture finishing, which sands finely at the cost of speed. Around 5mm for stock removal, deck sanding and paint stripping, which is faster but leaves a coarser pattern that needs finer grits afterwards. Most general purpose machines sit near 3mm.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-08-24",
      dateModified: "2026-08-24",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      aggregateRating: {
        "@type": "AggregateRating",
