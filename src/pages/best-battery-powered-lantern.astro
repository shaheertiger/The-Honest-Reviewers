---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-charger-for-power-outages/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "Are Portable Power Stations Safe Indoors?",
    "url": "/are-portable-power-stations-safe-indoors/"
  },
  {
    "title": "Best Battery Powered Generators",
    "url": "/best-battery-powered-generator/"
  },
  {
    "title": "How to Charge a Portable Power Station With Solar",
    "url": "/how-to-charge-a-portable-power-station-with-solar/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Battery Powered Lanterns for Outages & Camping (2026)";
const description =
  "The 7 best battery powered lanterns for power outages and camping, from rechargeable USB lanterns to D-cell backups, with lumens vs runtime explained.";

const PRODUCTS = [
  {
    "id": "goal-zero-lighthouse-600",
    "name": "Goal Zero Lighthouse 600 Lantern & USB Power Hub",
    "category": "600 lumens, built-in 18.7Wh battery, USB out, hand crank",
    "badge": "Best Overall for Power Outages",
    "amazonUrl": "#",
    "pros": [
      "600 lumens of warm 3,500K light is bright enough for a kitchen or living room",
      "Four ways to recharge: USB, solar panel, hand crank, or another power bank",
      "USB-A output charges a phone while the lantern is lit",
      "Directional control lets you light one side of the lantern to stretch runtime",
      "Fold-out legs and a hanging handle work on a table, a hook or uneven ground"
    ],
    "cons": [
      "Only about 2.5 hours at the full 600 lumens, so plan to run it dimmer",
      "The crank is an emergency backup, not a practical way to refill the battery"
    ],
    "bottomLine": "The single best battery powered lantern for a power outage: bright, warm, rechargeable four ways, and able to top up a phone in a pinch.",
    "description": "The Lighthouse 600 is the lantern we would keep by the breaker panel. It puts out up to 600 lumens of warm 3,500K light from two LEDs, which is enough to cook by or read in a living room, and the warm color temperature is much easier on the eyes over a long evening than the blue-white glare of cheap lanterns. The built-in lithium-ion battery is rated at 5,200mAh, or about 18.7Wh. Goal Zero and retailers quote roughly 2.5 hours at full brightness and hundreds of hours on the lowest setting, and the honest way to use it is somewhere in between: half brightness on one side lights a table for an evening. That one-side trick is the Lighthouse's best feature. You can switch either half of the lantern on independently, so pointing light at the room instead of the wall doubles the runtime at the same useful brightness. Recharging is where it earns the outage pick. It charges from any USB source, from a Goal Zero solar panel, or from the built-in hand crank, which Goal Zero rates at about 10 minutes of low light per minute of cranking. That is a last resort, not a way to refill it, but it means the lantern is never completely dead. A USB-A output lets it act as a small power bank for a phone, with the caveat that every watt-hour you send to a phone is light you no longer have. It weighs about 1.1 pounds, folds its legs flat, and hangs from its handle. For most households, this is the one to buy first."
  },
  {
    "id": "streamlight-siege-44931",
    "name": "Streamlight Siege 3D Alkaline Lantern",
    "category": "D-cell lantern, white and red LEDs, floats",
    "badge": "Best D-Cell Lantern",
    "amazonUrl": "#",
    "pros": [
      "Runs on three D cells, which sit in a drawer for years and still work",
      "Rated for roughly 295 hours on low, about 12 days of continuous light",
      "Red night mode preserves night vision and lasts even longer",
      "Built for rough use: impact-rated, water-resistant and it floats",
      "Removable globe and a bottom hook let it hang upside down as a ceiling light"
    ],
    "cons": [
      "No USB output and no rechargeable battery",
      "D cells are heavy and expensive per hour compared with recharging"
    ],
    "bottomLine": "The lantern for people who want light that works after sitting in a closet for five years; buy it as the backstop behind a rechargeable.",
    "description": "Rechargeable lanterns have one weakness: they discharge sitting on a shelf, and the one you forgot to top up is the one that is flat when the storm hits. The Streamlight Siege avoids that problem entirely. It runs on three D-cell alkaline batteries, which keep most of their charge for years in storage, so a Siege with a spare set of cells in the drawer is the most dependable light you can own. Streamlight built it for first responders and the outdoors, and it shows. The housing is impact-rated, water-resistant and floats, and the clear globe comes off so the lantern can hang upside down from its bottom hook and spread light from the ceiling of a tent or a dark hallway. Streamlight's current spec sheet rates the high setting at 540 lumens for about 30 hours and the low setting at roughly 55 lumens for about 295 hours, which is around 12 days of continuous use. Older units were rated lower, at 340 lumens on high, so check the listing. A red LED mode, rated for about 235 hours, gives you enough light to get to the bathroom at night without wrecking anyone's night vision, and there is a red SOS flash. What you give up is any way to recharge it or charge anything else. D cells also cost more per hour of light than recharging from the wall, so the Siege makes most sense as the backup lantern behind a rechargeable one, or as the light for someone who will never remember to charge anything."
  },
  {
    "id": "duracell-1500-lumen-hybrid-lantern",
    "name": "Duracell 1,500-Lumen Hybrid Lantern",
    "category": "Built-in rechargeable battery plus 4 D-cell backup, USB in/out",
    "badge": "Best Duracell Lantern",
    "amazonUrl": "#",
    "pros": [
      "Runs on a built-in rechargeable battery or on four D cells as a backup",
      "Very bright top setting for lighting a whole room",
      "USB output charges a phone from the rechargeable battery",
      "Dimming and several modes stretch runtime on lower settings",
      "IPX4 splash resistance and drop testing for outdoor use"
    ],
    "cons": [
      "Big and heavy with D cells installed",
      "Runtime figures vary by listing; Duracell's packaging is the source to trust"
    ],
    "bottomLine": "The Duracell lantern worth buying: rechargeable for everyday use with a D-cell fallback for a long outage, at a warehouse-club price.",
    "description": "Search for a Duracell lantern and you will find several versions; the one we recommend is the 1,500-lumen hybrid model sold through warehouse clubs and farm stores. It solves the rechargeable lantern's shelf problem in a practical way: it runs from a built-in rechargeable battery for everyday use, and if that battery is flat when an outage starts, you drop in four D-cell alkalines and keep going. That dual setup is exactly what an outage lantern should have, and few lanterns at this price offer it. The 1,500-lumen top setting is very bright, enough to light a kitchen or a garage, though you will rarely want it at full power indoors and it drains the battery quickly. Use the dimmer settings for long evenings. A USB output lets the lantern charge a phone from its rechargeable battery, and it charges over USB. Retailers list IPX4 splash resistance and a drop test, so it handles a wet porch or a campsite without fuss. The downsides are size and documentation. With D cells installed it is a hefty lantern, not a backpacking light. And Duracell's listings disagree on battery capacity and runtime, which is common for warehouse-club products sold in several regional variants, so read the box for the exact model number and rated runtimes rather than trusting any one online listing. For a household that wants a bright, inexpensive lantern with a backup power source, it is a sensible buy and a better choice than the generic multi-packs sold next to it."
  },
  {
    "id": "coleman-classic-recharge-800",
    "name": "Coleman Classic Recharge 800 Lumens LED Lantern",
    "category": "Rechargeable, 4,800mAh battery, USB out",
    "badge": "Best Budget Rechargeable",
    "amazonUrl": "#",
    "pros": [
      "800 lumens on high, with 300 and 100 lumen settings for long evenings",
      "Rated for up to 45 hours on low from the built-in 4,800mAh battery",
      "USB port charges a phone even while the lantern is on",
      "USB-C charging cord stores in the base so it does not get lost",
      "IPX4 water resistance, 1 meter impact rating and a 3-year warranty"
    ],
    "cons": [
      "Only about 5 hours on high, so it is a medium or low lantern in practice",
      "No backup battery option once the internal cell is flat"
    ],
    "bottomLine": "The best value rechargeable lantern: bright, simple, well-built and cheap enough to buy one for each main room.",
    "description": "The Coleman Classic Recharge is the rechargeable lantern we would buy in multiples. It is a straightforward design from a brand that has made lanterns for generations, and it does the basics well. There are three brightness settings: 800 lumens on high, 300 on medium and 100 on low. Coleman rates them at about 5, 15 and 45 hours respectively from the built-in 4,800mAh lithium-ion battery. In a power outage, the medium setting is the useful one; 300 lumens comfortably lights a dinner table, and 15 hours covers two or three evenings before you need to recharge. Low is enough for a hallway or a bathroom nightlight. A battery-level indicator shows what is left, which matters more than people expect during a multi-day outage, when you are deciding whether to spend charge on light or on a phone. Speaking of which, the lantern has a USB port that charges a phone while the light is on. The USB-C charging cord nests in the base, a small touch that means the cable is there when you need it. It is rated IPX4 for splashes and impact-resistant to one meter, and Coleman backs it with a three-year limited warranty. The trade-offs are what you would expect at the price. High mode is short-lived, and once the internal battery is flat you need a USB source, a power bank or a power station to bring it back. For a household building an outage kit on a budget, two or three of these plus one D-cell backup lantern is a very good setup."
  },
  {
    "id": "fenix-cl30r",
    "name": "Fenix CL30R Rechargeable Camping Lantern",
    "category": "650 lumens, three 18650 cells, power bank function",
    "badge": "Best Premium Rechargeable",
    "amazonUrl": "#",
    "pros": [
      "Runs on one, two or three removable 18650 cells, which are replaceable when they age",
      "650 lumens max with several brightness steps and a red mode",
      "Doubles as a power bank for a phone in an outage",
      "Waterproof construction from a flashlight brand known for build quality",
      "Compact and solid enough to live in a car or a go-bag"
    ],
    "cons": [
      "Expensive next to the Coleman and Goal Zero",
      "Charges over micro-USB and only runs on low while charging"
    ],
    "bottomLine": "A premium rechargeable lantern for people who want replaceable batteries and serious build quality; overkill for most outage kits, excellent for those who use it often.",
    "description": "Most rechargeable lanterns seal their battery inside, which means the whole lantern is done when the cell wears out. The Fenix CL30R takes a different approach: it runs on standard 18650 lithium-ion cells, three of which come in the box, and it will run on one, two or all three. When those cells eventually lose capacity, you replace them instead of the lantern, and if you already own 18650-powered flashlights from Fenix or other brands, the cells are interchangeable. Fenix is a flashlight company first, and the CL30R is built like one. It is compact, dense and waterproof, and it shrugs off the kind of knocks that crack cheaper plastic lanterns. Maximum output is 650 lumens, with several lower steps for long runtimes and a red mode for night use. Fenix's published runtime chart is the source to check for exact hours, but with three cells installed it runs for days on its lower settings. In an outage, the CL30R also works as a power bank, sending charge from its cells to a phone. The drawbacks are real. It charges through micro-USB, which is dated in 2026 and means another cable to keep around, and while it is charging the lantern is limited to its low mode. It is also expensive; for the price you could buy two Coleman lanterns. That makes it the pick for campers, overlanders and people who use a lantern every week, rather than for a household that will light it twice a year during storms."
  },
  {
    "id": "biolite-alpenglow-500",
    "name": "BioLite AlpenGlow 500 Lantern",
    "category": "500 lumens, 6,400mAh (23.6Wh) battery, USB out",
    "badge": "Best for Camping Ambience",
    "amazonUrl": "#",
    "pros": [
      "Rated for about 200 hours on low and 5 hours at 500 lumens",
      "Large 6,400mAh (23.6Wh) battery with USB-A output for a phone",
      "Warm white, color and flicker modes make it a pleasant room light",
      "Shake-to-change controls are easy to use in the dark",
      "IPX4 splash resistance for campsites and porches"
    ],
    "cons": [
      "Charges over micro-USB and takes about 3 hours to refill",
      "Stock has been spotty at some retailers"
    ],
    "bottomLine": "The nicest light to sit under on a campsite or through a long blackout evening, with a big battery and phone charging built in.",
    "description": "The AlpenGlow 500 is the lantern that makes a power outage feel less grim. BioLite designed it around ambience rather than raw brightness: it diffuses 500 lumens through a frosted body for even, glare-free light, and it has warm white, cool white, multi-color and a candle-flicker mode that does a surprisingly good job of replacing the candles you should not be burning anyway. The controls are simple; you press a button or give it a shake to cycle modes, which is easy to do in a dark room. The battery is the other strength. At 6,400mAh, or about 23.6Wh, it is larger than most lanterns in this size class, and BioLite rates it at around 5 hours on the 500-lumen high setting and about 200 hours on the lowest. In practice, a warm medium setting lasts several evenings. A USB-A output rated at 2.4A charges a phone, and reviewers report roughly one full modern phone charge if you sacrifice the light to do it. It is IPX4 splash-resistant and weighs a little over 13 ounces. The weak points are dated charging and availability. It recharges over micro-USB, taking about three hours, and stock has been spotty at some retailers, so buy it when you see it in stock at a reputable seller. For campers and for families who will spend outage evenings around the kitchen table, it is the most pleasant light on this list."
  },
  {
    "id": "black-diamond-apollo",
    "name": "Black Diamond Apollo Lantern",
    "category": "Small 250-lumen lantern, rechargeable or 3 AA",
    "badge": "Best Small Lantern",
    "amazonUrl": "#",
    "pros": [
      "Runs on its rechargeable pack or on three AA batteries as a backup",
      "Small enough to stand on a nightstand like a battery operated lamp",
      "Fold-down legs and a hanging loop work on tables, shelves and tent hooks",
      "USB output can top up a phone from the internal battery",
      "Dimmable frosted globe gives soft, even light without glare"
    ],
    "cons": [
      "250 lumens is a small-room light, not a whole-kitchen light",
      "Older charging port; check the current listing for USB type"
    ],
    "bottomLine": "The best small battery operated lamp for a bedroom or bathroom during an outage, with the AA backup that most compact lanterns lack.",
    "description": "Not every room needs a 600-lumen lantern. A bedroom, a bathroom or a child's room during an outage needs a small, soft light that will run all night, and the Black Diamond Apollo is the best small battery operated lamp we found for that job. It stands about the height of a coffee mug with its legs extended, and the frosted globe spreads its light evenly, so it reads more like a bedside lamp than a camping lantern. Black Diamond currently rates it at 250 lumens on its top setting, and it dims smoothly down to a glow that, per Black Diamond, runs for up to about 150 hours. The feature that earns it a place on an outage list is its dual power. It runs from an internal rechargeable lithium-ion pack, rated at 2,600mAh, and it also accepts three AA batteries. AA cells are the most common batteries in any house, so even if you forgot to charge the Apollo, it still works. A USB output can send charge from the internal pack to a phone, though at this battery size that is an emergency top-up rather than a full charge. The legs fold up for packing, and a loop on top hangs it from a hook or a tent ceiling. The limits are brightness and an older charging port; recent units still list micro-USB at several retailers, so check the current listing. As the small light in a family's outage kit, paired with a brighter main lantern, it is an easy recommendation."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Battery Powered Lanterns",
          item: "https://www.thehonestreviewers.com/best-battery-powered-lantern/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best battery powered lantern for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Goal Zero Lighthouse 600 is the best all-round pick. It gives up to 600 lumens of warm light, recharges from USB, solar or a hand crank, and can top up a phone. Pair it with a D-cell lantern such as the Streamlight Siege, which stays ready in storage for years, so you have reliable light even if the rechargeable is flat."
          }
        },
        {
          "@type": "Question",
          "name": "Is a rechargeable lantern better than one that uses D batteries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For everyday use, yes; a rechargeable lantern costs almost nothing to run and can be refilled from a power bank or solar panel. For long storage, D cells win because they hold their charge for years. The best answer is a hybrid lantern that takes both, or one rechargeable lantern plus one D-cell lantern as a backstop."
          }
        },
        {
          "@type": "Question",
          "name": "How many lumens do I need in a lantern for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Around 200 to 300 lumens lights a dinner table or living room, and 400 to 600 lumens is enough to cook by. Bedrooms and hallways need only 50 to 100 lumens. Buy a lantern that reaches 500 lumens or more, then run it on medium most of the time, because runtime drops sharply on high."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Duracell lantern any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Duracell 1,500-lumen hybrid lantern is a good value. It runs on a built-in rechargeable battery with a four D-cell backup, has a USB output for a phone, and is splash resistant. Duracell sells several lantern versions with different specs, so check the model number and the rated runtimes on the box before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a camping lantern during a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as it is battery powered. LED camping lanterns work well indoors. Never use propane, butane, white gas or kerosene camping lanterns inside a home; they produce carbon monoxide and use an open flame. For outages, favor a lantern with a large battery or disposable-cell backup and a warm light that fills a room."
          }
        },
        {
          "@type": "Question",
          "name": "Can a lantern charge my phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many rechargeable lanterns have a USB output, but their batteries are small. A lantern with an 18.7Wh battery gives roughly one phone charge and then has nothing left for light. Treat the port as an emergency backup and use a dedicated power bank to keep phones charged through a multi-day outage. Better still, use the power bank to recharge the lantern."
          }
        },
        {
          "@type": "Question",
          "name": "Why shouldn't I use candles during a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Candles cause many house fires during outages, usually when they are left unattended, knocked over or placed near something flammable. Fire safety agencies recommend battery powered lights instead. An LED lantern cannot start a fire if it tips over, gives more light than several candles, and runs for days on one charge or one set of batteries."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "battery powered lantern",
      "rechargeable lantern",
      "lantern for power outage",
      "duracell lantern",
      "small battery operated lamp",
      "small battery operated lights",
      "led camping lantern"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Battery Powered Lanterns</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          When the lights go out, a good lantern turns a dark, anxious evening into a normal one. These are the rechargeable, D-cell and hybrid lanterns worth keeping in the closet, and how to make sure they work when you need them.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#goal-zero-lighthouse-600"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Our 7 Top Picks Reviewed</a>
          <a href="#lumens-runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Lumens vs Runtime</a>
          <a href="#power-source" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Rechargeable vs AA and D Cells</a>
          <a href="#usb-out" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. USB Power-Out Lanterns</a>
