];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Acrylic Concrete Sealer",
          item: "https://www.thehonestreviewers.com/best-acrylic-concrete-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between solvent-based and water-based acrylic sealers?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Solvent-based acrylics dissolve resin in a carrier like xylene, which penetrates concrete pores before evaporating and leaves a thicker, glossier film with stronger UV retention. Water-based acrylics suspend resin particles in water, which coalesce into a film as the water evaporates. Water-based formulas are lower odor, non-flammable, and easier to clean up, but they typically produce a thinner film with less dramatic gloss and require more frequent recoating on driveways.",
          },
        },
        {
          "@type": "Question",
          name: "What gloss level should I choose for an acrylic concrete sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "High-gloss wet-look acrylics measuring 80-plus gloss units deliver the most dramatic color enhancement and are popular on driveways and showcase patios, but they show dirt more easily and can be slippery when wet. Satin acrylics in the 40-60 range provide a more natural look with better everyday practicality. Flat or low-sheen acrylics protect with minimal visual change, best for surfaces where you want protection without altering the concrete's appearance.",
          },
        },
        {
          "@type": "Question",
          name: "How long does acrylic concrete sealer last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Solvent-based acrylic sealers typically last 2-3 years on patios and walkways and 1-2 years on driveways before recoating is needed. Water-based acrylics generally need recoating slightly more often, especially on surfaces exposed to vehicle traffic. UV exposure, traffic level, and climate all affect the actual lifespan, and the water droplet test is the simplest way to check: if water no longer beads on the surface, it is time to reseal.",
          },
        },
        {
          "@type": "Question",
          name: "Will acrylic sealer make my concrete yellow?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Lower-quality acrylic sealers, especially budget solvent-based formulas without UV-stabilized resins, can yellow within 12-18 months of direct sun exposure. Premium acrylics formulated with non-yellowing UV-stable resin packages resist this for 3-5 years or more. Water-based acrylic emulsions generally resist yellowing even better than solvent-based formulas due to differences in the UV stabilizer chemistry used in each type.",
          },
        },
        {
          "@type": "Question",
          name: "Is acrylic sealer slippery when wet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "High-gloss acrylic sealers can become noticeably slippery when wet, which is a real safety concern on walkways, steps, and pool-adjacent patios. Satin and matte acrylic sheens are less slippery than high gloss. For any surface that gets wet regularly, mixing in a polymer bead or fine aluminum oxide non-slip additive before application is strongly recommended regardless of gloss level.",
          },
        },
        {
          "@type": "Question",
          name: "How many coats of acrylic sealer do I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Two thin coats is the standard specification for most solvent-based acrylic sealers, applied 2-4 hours apart. Water-based acrylics often require two to three coats to reach a comparable dry film thickness because each coat deposits less resin than a solvent-based coat. Applying one thick coat instead of multiple thin coats is the most common application mistake and leads to bubbling, uneven gloss, and premature failure.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Alex Rivers" },
      datePublished: "2026-02-18",
      dateModified: "2026-08-01",
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: product.amazonUrl,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
