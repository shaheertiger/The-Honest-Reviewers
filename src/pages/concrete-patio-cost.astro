import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Pavers vs Concrete",
    "url": "/pavers-vs-concrete/"
  },
  {
    "title": "How Long Does Concrete Take to Cure",
    "url": "/how-long-does-concrete-take-to-cure/"
  },
  {
    "title": "Concrete Driveway Cost",
    "url": "/concrete-driveway-cost/"
  },
  {
    "title": "Concrete Sealer Cost",
    "url": "/concrete-sealer-cost/"
  },
  {
    "title": "Best Stamped Concrete Sealers",
    "url": "/best-stamped-concrete-sealer/"
  },
  {
    "title": "How to Stain a Concrete Patio to Look Like Stone",
    "url": "/how-to-stain-concrete-patio-to-look-like-stone/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-09", modified: "2026-10-09" });
const title = "Concrete Patio Cost: Prices by Size and Finish, From Broom to Stamped";
const description =
  "A concrete patio typically costs $6 to $12 per sq ft plain and $12 to $25 stamped, about $1,900 to $3,800 for a plain 16x20. Sizes, finishes, prep, sealing.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Patio Cost",
          item: "https://www.thehonestreviewers.com/concrete-patio-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a concrete patio cheaper than pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. Plain poured concrete typically costs roughly $6 to $12 per square foot installed, while concrete pavers commonly run higher because each unit is laid by hand on a prepared base. Stamped concrete can approach or overlap paver pricing. Pavers are easier to repair one piece at a time, so the cheaper upfront choice is not always cheaper over decades."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a concrete patio last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A well-built concrete patio commonly lasts 25 to 30 years or more. The biggest factors are base preparation, drainage, control joints, the concrete mix and your climate. Freeze-thaw cycles and deicing salts shorten its life, while periodic sealing and keeping water from pooling on or under the slab help extend it. Decorative finishes may need refreshing sooner than the slab itself."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a permit for a concrete patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on where you live. Some jurisdictions require permits for any new patio, others only for patios attached to the house, above a certain size, or that change drainage or impervious surface area. Covered patios and those with footings for a roof almost always need one. Call your local building department before you pour, since fixing an unpermitted slab later can be expensive."
          }
        },
        {
          "@type": "Question",
          "name": "How thick should a concrete patio be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Four inches is the standard thickness for a patio that carries foot traffic and furniture. Thicker slabs or thickened sections are often recommended for hot tubs, outdoor kitchens, heavy planters or areas that may see vehicles. The base matters too: a compacted gravel layer beneath the slab supports it and helps drainage. Make sure all quotes specify the same thickness and base."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal a new concrete patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sealing is optional for plain concrete but recommended in freeze-thaw climates and for stamped or stained patios. A sealer reduces water and stain absorption and protects decorative color. Many manufacturers recommend waiting about 28 days after the pour, though some products are formulated for newer concrete. Plan to reseal every few years with film-forming sealers, less often with penetrating ones."
          }
        },
        {
          "@type": "Question",
          "name": "Does a concrete patio add value to a home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A patio can make a home more appealing to buyers, especially in regions with long outdoor seasons, but it rarely returns its full cost at sale. The best value comes from a patio that is well built, sized to the yard and in good condition. A cracked, stained or poorly drained patio can count against a home, so maintenance matters as much as the original build."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time of year to pour a patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mild weather is best. Many contractors prefer temperatures roughly between 50 and 80 degrees Fahrenheit, which let concrete set at a manageable pace and cure without extra protection. Very hot weather speeds evaporation and shortens finishing time, while cold weather slows curing and risks freezing. In cold climates, late spring and early fall are common choices, with summer pours done early in the morning."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

