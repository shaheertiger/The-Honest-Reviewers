                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Machine</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Clearing Width</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                  </tr>
                </thead>
