                    <td class="px-4 py-4 font-black text-gray-900">Self-leveling polyurethane</td>
                    <td class="px-4 py-4 text-gray-700">Excellent</td>
                    <td class="px-4 py-4 text-gray-700">Needs dry</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Floor cracks, cove joint</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Acrylic latex</td>
