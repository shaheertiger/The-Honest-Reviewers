---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Dual Fuel Inverter Generators",
    "url": "/best-dual-fuel-inverter-generator/"
  },
  {
    "title": "Best Generator Inlet Boxes",
    "url": "/best-generator-inlet-box/"
  },
  {
    "title": "Best Manual Transfer Switches",
    "url": "/best-manual-transfer-switch/"
  },
  {
    "title": "Interlock Kit vs Transfer Switch",
    "url": "/interlock-kit-vs-transfer-switch/"
  },
  {
    "title": "Can a Generator Power a Furnace, Refrigerator and Sump Pump?",
    "url": "/can-a-generator-power-a-furnace-refrigerator-and-sump-pump/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Generators for a Furnace in 2026: Clean Power and Safe Hookup";
const description =
  "The best generators for running a gas or oil furnace in a winter outage, from Honda, WEN, Westinghouse, Champion and Generac, compared on running watts, clean inverter power under 3% THD, 240V inlet outlets and dual fuel.";

const PRODUCTS = [
  {
    "id": "honda-eu3000is",
    "name": "Honda EU3000iS 3000 Watt Inverter Generator (EU3000IS1AN)",
    "category": "3,000W Gas Inverter, Electric Start, 3.4 Gal Tank, CO-MINDER, 50-57 dB(A)",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Honda's listing names furnaces among the loads it is meant for",
      "Electric start, which matters with cold hands on a winter night",
      "3.4 gallon tank rated for 6.9 to 19.6 hours, so it runs overnight",
      "CO-MINDER shuts the engine down if carbon monoxide builds up",
      "Rated 50 to 57 dB(A), quiet enough to run beside a house all night"
    ],
    "cons": [
      "Gasoline only, with no propane option for long storage",
      "120V only, so it cannot feed both legs of a 240V inlet",
      "Heavy for its output compared with newer open-frame inverters"
    ],
    "description": "The EU3000iS is the generator we would hand to someone whose only goal is keeping a gas furnace running through a winter outage. Honda lists furnaces by name among the loads it is designed for, and its inverter produces the home-outlet quality power that ECM blower motors and furnace control boards expect. The spec that matters most here is the tank: 3.4 gallons, rated for 6.9 to 19.6 hours depending on load. A furnace blower cycles on and off all night, so the generator spends long stretches at light load, which is exactly where Honda's Eco Throttle stretches the run time past a full night's sleep. Electric start is the other practical win. Pulling a recoil cord in single-digit cold is miserable, and a push button removes that step. CO-MINDER adds an automatic shutdown if carbon monoxide builds up around the unit. The trade-off is that it is a 120V-only, gasoline-only machine. It suits a single-circuit furnace transfer switch or a 120V manual transfer switch, but it cannot feed both legs of a 240V inlet box on its own. Gasoline also goes stale between winters unless you stabilize it. If you want propane for storage, or 240V to run a well pump alongside the furnace, look at the WEN DF680iX or the Westinghouse iGen12000DFc instead.",
    "bottomLine": "The quietest, simplest way to keep a furnace and a few circuits running overnight, as long as 120V and gasoline suit you."
  },
  {
    "id": "wen-df680ix",
    "name": "WEN DF680iX 6800-Watt Dual Fuel Inverter Generator",
    "category": "Dual Fuel Inverter, 5,100W Rated (Gas), L14-30R 120/240V, Electric Start, CO Watchdog",
    "badge": "Best for a 240V Inlet Box",
    "amazonUrl": "#",
    "pros": [
      "L14-30R 120/240V outlet matches the standard 30A generator inlet box",
      "Runs on gasoline (5,100 rated watts) or propane (4,500 rated watts)",
      "Electric start and a CO Watchdog shutdown sensor",
      "Fuel shut-off runs the carburetor dry before storage",
      "Wheels and a telescoping handle for moving it out to the inlet"
    ],
    "cons": [
      "Listing specifies a bonded-neutral configuration, so check how your transfer equipment handles neutral",
      "Propane output drops to 4,500 rated watts",
      "Heavier and louder than the small 120V inverters"
    ],
    "description": "Most homes connect a portable generator through a 30-amp inlet box with an L14-30 twist-lock, and most inverter generators simply lack that outlet. The DF680iX has one: an L14-30R 120/240V receptacle, alongside two household outlets and a TT-30R. That one outlet is the reason it ranks second. It lets you feed an interlock kit or manual transfer switch with both legs of the panel live, so the furnace circuit works whichever leg it sits on, and a 240V well pump becomes possible too. Output is rated at 5,100 watts on gasoline and 4,500 on propane, comfortably above a furnace blower, inducer and igniter with room for a refrigerator, lights and a sump pump. Dual fuel matters in winter: propane stores for years without going stale, and you can swap tanks without pouring gasoline in the cold. Electric start and WEN's CO Watchdog shutdown sensor round it out. The trade-off is in the listing itself: WEN describes a bonded-neutral 240V configuration, aimed partly at Level 2 EV charging. Whether that suits your transfer switch depends on whether the switch transfers the neutral, which is a question for the electrician doing the install. If you only need the furnace on one 120V circuit, the smaller Honda or Westinghouse is quieter and lighter.",
    "bottomLine": "The rare dual fuel inverter with an L14-30R, which makes it the easiest clean-power way to feed a standard generator inlet box."
  },
  {
    "id": "westinghouse-igen5000dfc",
    "name": "Westinghouse iGen5000DFc Dual Fuel Inverter Generator",
    "category": "Dual Fuel Inverter, 3,900W Running (Gas), Under 3% THD, Remote Start, TT-30R, CO Sensor",
    "badge": "Best Dual Fuel for a Furnace Circuit",
    "amazonUrl": "#",
    "pros": [
      "Under 3% THD per the listing, safe for ECM motors and control boards",
      "3,900 running watts on gasoline, 3,500 on propane",
      "Remote start key fob plus electric start",
      "As low as 52 dBA with a double-insulated cover",
      "Parallel kit (sold separately) adds a 240V outlet"
    ],
    "cons": [
      "No 240V outlet without the optional parallel kit and a second unit",
      "Outlets limited to a TT-30R, one duplex and USB",
      "Remote fob is one more battery to keep charged"
    ],
    "description": "The iGen5000DFc is the dual fuel pick for anyone running the furnace off a single dedicated circuit, through a furnace transfer switch or a 120V manual transfer switch. Westinghouse specifies under 3% total harmonic distortion, which is the clean-power threshold that matters for variable-speed ECM blower motors and the electronic boards that run modern furnaces. The number that matters most for winter is its fuel flexibility: 3,900 running watts on gasoline and 3,500 on propane, enough to cover a furnace with a refrigerator and some lighting on the same feed. Propane is the better winter fuel because a stored tank does not go stale, and you can swap tanks without handling gasoline in freezing weather. The remote start key fob is a genuine convenience in a storm, since you can start the generator from indoors once it is set up safely outside. Noise is listed as low as 52 dBA. The trade-off is its outlet panel. You get a TT-30R, one 5-20R duplex and USB ports, and 240V only arrives if you buy the parallel kit and a second iGen5000DFc. That makes it awkward for a standard L14-30 inlet box. If your electrician has already installed a 30-amp 240V inlet, the WEN DF680iX fits that setup better.",
    "bottomLine": "Clean, quiet dual fuel power for a dedicated 120V furnace circuit, with remote start for stormy nights."
  },
  {
    "id": "champion-4500-dual-fuel-inverter",
    "name": "Champion 4500-Watt Electric Start Dual Fuel Inverter Generator",
    "category": "Dual Fuel Inverter, 3,500W Running (Gas), 3,150W (Propane), Electric Start, CO Shield",
    "badge": "Best Value Dual Fuel",
    "amazonUrl": "#",
    "pros": [
      "Runs on gasoline or propane out of the box, with LPG hose included",
      "Up to 14 hours on gas and 21 hours on propane, per the listing",
      "Electric start with the EZ Start Dial",
      "CO Shield carbon monoxide auto shutoff",
      "3-year limited warranty and free lifetime technical support"
    ],
    "cons": [
      "120V only, so it suits a furnace circuit rather than a 240V inlet",
      "3,500 running watts leaves less headroom than the larger picks",
      "61 dBA is louder than the Honda and Westinghouse"
    ],
    "description": "This Champion is the sensible-money answer for a furnace backup: dual fuel, electric start, a carbon monoxide shutoff and an inverter, from a brand with a large US service network. The listing rates it at 4,500 starting and 3,500 running watts on gasoline, and 3,150 running watts on propane. For a typical gas furnace, which draws well under 1,200 watts once the blower is running, that leaves a comfortable margin for the blower's start-up surge plus a refrigerator. The spec to focus on is run time, because a winter outage is measured in days. Champion lists up to 14 hours on gasoline and up to 21 hours on propane, and the propane figure is the one that makes this generator attractive: a couple of 20-pound tanks carry a furnace through a long night without refuelling in the dark. Electric start and the EZ Start Dial make cold starts simpler, and CO Shield shuts the engine down if carbon monoxide builds. The trade-off is output and noise. It is a 120V machine at 61 dBA, so it pairs with a furnace transfer switch or a 120V manual transfer switch rather than a 240V inlet. If you need to run a 240V well pump too, step up to the WEN DF680iX or Westinghouse iGen12000DFc.",
    "bottomLine": "The best balance of price, propane run time and safety features for keeping one furnace circuit alive."
  },
  {
    "id": "generac-5200-dual-fuel-inverter",
    "name": "Generac 5,200 Watt Dual-Fuel Portable Inverter Generator",
    "category": "Dual Fuel Inverter, 3,900W Running (Gas), Under 3% THD, L5-30R, Electric Start, COsense",
    "badge": "Best With a 30A 120V Outlet",
    "amazonUrl": "#",
    "pros": [
      "Under 3% THD, per the listing",
      "120V 30A L5-30R twist-lock plus two 20A GFCI outlets",
      "3,900 running watts on gas, 3,500 on propane",
      "COsense shuts the unit down if dangerous CO is detected",
      "Up to 11 hours on a 20 lb propane tank at 50% load"
    ],
    "cons": [
      "No 240V outlet, so it cannot energize both panel legs through an L14-30 inlet",
      "GFCI outlets can trip when feeding some furnace transfer switches",
      "Shorter gas run time than the Honda at half load"
    ],
    "description": "Generac's dual fuel inverter earns its place with an outlet many inverters skip: a 120V 30-amp L5-30R twist-lock. A locking connector is what you want on a cord that runs through snow to a furnace transfer switch or a 120V generator inlet, because it cannot be kicked loose by a shovel or a pet. Alongside it are two 20-amp GFCI outlets, USB-A and USB-C. The listing specifies under 3% THD, which is clean enough for ECM blower motors and furnace control boards, and rates the generator at 3,900 running watts on gasoline and 3,500 on liquid propane. That covers a furnace, a refrigerator and lights on one 120V feed. Run time is listed at up to 9 hours on gas or 11 hours on a 20-pound propane tank at 50% load, stretching to 15 hours on gas at 25% load, which is closer to what a cycling furnace draws. COsense automatically shuts the unit down if carbon monoxide builds to dangerous levels. The trade-off is that it is still 120V only. An L5-30 feed can supply a 120V transfer switch, but it cannot energize both legs of a 240V panel through an L14-30 inlet without adapters we would not recommend. If your inlet box is 240V, choose the WEN DF680iX or one of the 240V models below.",
    "bottomLine": "A locking 30A outlet and clean dual fuel power make it a tidy match for a 120V furnace transfer switch."
  },
  {
    "id": "westinghouse-igen12000dfc",
    "name": "Westinghouse iGen12000DFc Dual Fuel Inverter Generator",
    "category": "Dual Fuel Inverter, 9,000W Running (Gas), 14-50R + L14-30R, Under 3% THD, Remote Start",
    "badge": "Best for the Whole House",
    "amazonUrl": "#",
    "pros": [
      "9,000 running watts on gasoline per the listing, enough for the furnace and most of the house",
      "Both a 14-50R 50A and an L14-30R 30A outlet, transfer switch or interlock ready",
      "Under 3% THD inverter power",
      "7.9 gallon tank, up to 19 hours at 25% load",
      "Remote start key fob, electric start and CO sensor"
    ],
    "cons": [
      "Large and heavy, so it lives on wheels and needs a spot near the inlet",
      "Overkill if all you need is the furnace",
      "Burns more fuel per hour than the small inverters at the same light load"
    ],
    "description": "If the goal is not just the furnace but the house around it, the iGen12000DFc is the inverter to buy. Westinghouse rates it at 12,000 peak and 9,000 running watts on gasoline, and it carries both a 120/240V 14-50R 50-amp outlet and an L14-30R 30-amp twist-lock, which the listing describes as transfer switch or interlock kit ready. That means it can feed a 50-amp inlet box and run the furnace, refrigerator, freezer, sump pump, well pump and most lighting circuits at once, rather than making you choose. The spec that separates it from conventional open-frame generators of similar size is power quality. It produces under 3% THD, so the variable-speed ECM blower in a high-efficiency furnace and the electronics elsewhere in the house get the same clean sine wave they get from the grid. Fuel economy is helped by Eco Mode and a 7.9-gallon tank rated for up to 19 hours at 25% load, and dual fuel lets you run propane when gasoline is hard to find after a storm. Remote start and a CO sensor are included. The trade-off is size: this is a large wheeled machine, and it is more generator than a furnace-only setup needs. If you only want heat and a fridge, the Champion or Generac is far easier to live with.",
    "bottomLine": "Whole-home clean power with both 50A and 30A transfer-ready outlets, so the furnace is just one of many circuits it can carry."
  },
  {
    "id": "honda-eu7000is",
    "name": "Honda EU7000iS 7000 Watt 120/240V Inverter Generator (EU7000ISNAT1X)",
    "category": "Gas Inverter, 120/240V, Electric Start, 5.1 Gal Tank, 6.4-16 Hr Run Time, CO-MINDER",
    "badge": "Premium 240V Pick",
    "amazonUrl": "#",
    "pros": [
      "120/240V output for a standard inlet box and transfer switch",
      "Electric start and Bluetooth app monitoring",
      "Rated 52 to 58 dB(A), very quiet for its size",
      "5.1 gallon tank rated for 6.4 to 16 hours",
      "CO-MINDER automatic shutdown"
    ],
    "cons": [
      "Gasoline only, so fuel storage between winters needs a stabilizer",
      "One of the most expensive portable generators in its class",
      "Heavy, two-person lift without its wheels"
    ],
    "description": "The EU7000iS is the generator for buyers who want Honda's reputation and refinement on a 240V inlet box. The listing specifies 120/240V output, so it can feed an interlock kit or manual transfer switch with both panel legs live, running the furnace together with a well pump, sump pump, refrigerator and lighting. Honda rates it at 52 to 58 dB(A), which is notably quiet for a generator this size and makes overnight running beside the house more tolerable for you and your neighbors. The spec that matters is the 5.1-gallon tank, rated for 6.4 to 16 hours. At the light, cycling load a furnace and refrigerator create, it leans toward the long end of that range, so one fill typically carries you through a night. Electric start, a Bluetooth app for monitoring and remote stop, and CO-MINDER automatic shutdown are all included. The trade-off is fuel and cost. It runs on gasoline only, and gasoline left in a tank from one winter to the next can gum the carburetor unless it is stabilized or drained. It is also one of the priciest portables available. If propane storage matters more to you than the Honda badge, the WEN DF680iX gives you a 240V L14-30R and dual fuel for considerably less.",
    "bottomLine": "Quiet, refined 240V inverter power for an inlet box, for buyers happy to manage gasoline storage."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Generators for a Furnace",
          item: "https://www.thehonestreviewers.com/best-generator-for-furnace/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best generator for a furnace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes the Honda EU3000iS is the best generator for a furnace on a dedicated circuit: clean inverter power, electric start and an overnight tank. If you have a 240V inlet box, the WEN DF680iX adds an L14-30R outlet and dual fuel. For the furnace plus most of the house, the Westinghouse iGen12000DFc is the clean-power choice with 50A and 30A outlets."
          }
        },
        {
          "@type": "Question",
          "name": "What size generator do I need to run my furnace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most gas furnaces draw 600 to 1,200 running watts, with a blower start-up surge two to three times the blower's running draw. A 2,500 to 3,000-watt inverter runs the furnace alone. If you also want a refrigerator, lights and internet, choose 3,500 to 5,000 running watts. Check the furnace nameplate amps and multiply by 120 for a precise figure."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug my furnace into a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not directly. Furnaces are hardwired, so the safe options are a single-circuit furnace transfer switch, an inlet box with an interlock kit, or a manual transfer switch, all installed by a licensed electrician. Some installers fit a plug and receptacle at the furnace for this purpose, but that must meet local code. Never backfeed the house through a dryer or wall outlet."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need an inverter generator for a gas furnace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For any furnace with a circuit board or an ECM variable-speed blower, which covers nearly every furnace sold in the last twenty years, an inverter is strongly recommended. Inverters are typically rated under 3% THD, close to grid power. Distorted power from some conventional generators can cause blower hunting, error codes and board damage that costs more than the price difference."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my furnace shut off when running on a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually because the control board cannot sense the flame. Flame sensing needs a neutral-to-ground reference, and a generator with a floating neutral feeding a furnace through a cord often lacks one. Connecting through a transfer switch or interlock tied to your bonded main panel usually solves it. Reversed polarity in an adapter is the second most common cause."
          }
        },
        {
          "@type": "Question",
          "name": "How long can a generator run a furnace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As long as you keep it fueled and the oil fresh. A mid-size inverter running a furnace and refrigerator typically sits around 25% load, where the Honda EU3000iS is rated for up to 19.6 hours per tank and the Champion 4500 for up to 21 hours on propane. Check the oil every day or so during a long outage, as the manual specifies."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable power station run a furnace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for a while. A gas furnace drawing 500 to 800 watts while the blower runs, cycling about half the time, uses several kilowatt-hours a day in cold weather. A 2kWh station covers part of a night. Stations are useful for short outages or as a bridge, but a fueled generator is still the practical choice for multi-day winter outages."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "generator for furnace",
      "best generator for gas furnace",
      "what size generator to run a furnace",
      "inverter generator for furnace",
      "generator for oil furnace",
      "generator for boiler"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Generators for a Furnace</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A gas furnace needs only 600 to 1,200 watts to keep a house warm in a blackout, but it needs clean power and a safe connection. Seven inverter generators that deliver both.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#honda-eu3000is"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#furnace-watts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Furnace Watts</a>
          <a href="#clean-power" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Clean Power and THD</a>
          <a href="#what-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. What Size You Need</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The 7 Best Picks</a>
          <a href="#how-to-connect" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How to Connect It</a>
