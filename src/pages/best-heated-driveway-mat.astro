const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Heated Driveway Mats",
          item: "https://www.thehonestreviewers.com/best-heated-driveway-mat/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best snow melting mat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the HeatTrak walkway mat with power unit is the best snow melting mat. HeatTrak lists a 2 inch per hour melt rate, a surface about 40°F above air temperature and a 2-year warranty, and you can chain more stair and walkway mats from it. For a single doorstep, the Cozy Products Ice-Away is simpler and draws only 240 watts."
          }
        },
        {
          "@type": "Question",
          "name": "Do heated driveway mats really work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, within limits. Plug-in mats keep up with falling snow at the 2 to 4 inches per hour their makers list, and work best when switched on before the storm. They cover a path or two tire tracks, not a whole driveway, and in extreme cold they keep the surface passable rather than bare. Check for a vehicle rating before driving on one."
          }
        },
        {
          "@type": "Question",
          "name": "How do snow melting mats work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A heating element sealed inside rubber, PVC, TPU or silicone warms the mat's surface when it is plugged into a 120 volt outlet. Snow melts as it lands and drains off the edges. HeatTrak says its surface reaches about 40°F above the air temperature. Mats cannot be cut or folded because the element runs through the whole mat."
          }
        },
        {
          "@type": "Question",
          "name": "How many heated mats can I plug into one outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add up every mat's amps, using the label or listing, and stay within both the maker's chaining limit and the circuit's limit. HeatTrak's power unit is listed at 13 or 14 amps, Toriexon allows 1,500 watts and EaseRoll one 12 foot mat per setup. Keep long-running loads to about 12 amps on a 15 amp circuit."
          }
        },
        {
          "@type": "Question",
          "name": "Are heated snow melting mats safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, when used as the maker intends. Plug them into a GFCI-protected outdoor outlet, use only outdoor-rated extension cords and only if the maker allows them, never cut, fold or cover a running mat, and inspect mats and cords each season. Follow the maker's instructions and your local electrical codes, and call an electrician if outlets lack GFCI protection."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a heated mat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Multiply watts by hours, divide by 1,000 and multiply by your electricity rate. A 330 watt mat running 10 hours uses 3.3 kilowatt-hours, about 56 cents at an example rate of 17 cents per kilowatt-hour. A 900 watt runner costs roughly three times that. Running mats only during snow keeps the winter total low."
          }
        },
        {
          "@type": "Question",
          "name": "Can you drive on heated driveway mats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the maker rates the mat for vehicles. None of the listings on our list give a vehicle weight rating, even those that call themselves heated driveway mats. Ask the maker before driving on one, drive straight on and off without turning the wheel, and never park on a mat. For a fully heated driveway, an installed system is the better route."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best snow melting mat",
      "heated driveway mats",
      "snow melting mats",
      "heated mats",
      "heated walkway mats",
      "heated sidewalk mats",
      "ice melting mats",
      "heattrak mats"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Heated Driveway Mat</span> and Snow Melting Mat Picks
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven plug-in heated mats on Amazon for walkways, steps, landings and driveway tire tracks, compared on size, amps and safe wiring.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#heattrak-walkway-mat-20x60"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How Many Amps?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="2.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-they-work" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Snow Melting Mats Work</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Type You Need</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Heated Mats</a>
          <a href="#driveway" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Heated Driveway Mats</a>
          <a href="#amps" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Amps and Circuits</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. GFCI and Cord Safety</a>
          <a href="#running-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Running Cost</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. What Size You Need</a>
          <a href="#setup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Setting Up</a>
          <a href="#alternatives" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Mats vs Ice Melt and Blowers</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Storage and Care</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

