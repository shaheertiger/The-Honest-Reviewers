---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "Nozzle Colors Explained", url: "/pressure-washer-nozzle-colors-explained/" },
    { title: "What Not to Pressure Wash", url: "/what-not-to-pressure-wash/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "How to Pressure Wash a Car Without Damaging Paint";
const description =
  "Under 1,500 PSI, a 40 degree tip and a foam cannon. The distances, the two-bucket step people skip, and where clear coat actually lifts.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Pressure Wash a Car",
          item: "https://www.thehonestreviewers.com/how-to-pressure-wash-a-car/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What PSI is safe to wash a car?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Up to about 1,500 PSI with a 40 degree white nozzle held two to three feet from the paint. Sound flat panels tolerate more, but there is no cleaning benefit above that figure, and the risk rises sharply at panel edges, stone chips and badge surrounds where the stream can get underneath.",
          },
        },
        {
          "@type": "Question",
          name: "Can a pressure washer damage car paint?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Undamaged paint on a flat panel is tough and a wide nozzle at a sensible distance will not hurt it. Damage happens at edges and existing defects: stone chips, peeling lacquer, door shuts, trim adhesive and wrap edges. Narrow nozzles at close range cause almost all of it.",
          },
        },
        {
          "@type": "Question",
          name: "Do I still need to wash by hand after using a pressure washer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For anything beyond light soiling, yes. A pressure washer removes loose grit and, with foam, a good deal of road film, but bonded film needs contact. The value of the pressure washer is removing the grit first, so the contact wash does not drag it across the paint.",
          },
        },
        {
          "@type": "Question",
          name: "What nozzle should I use to wash a car?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 40 degree white tip for all paint and glass, and the black soap nozzle for applying detergent, since it is the only tip that lets the siphon draw at all. A 25 degree green tip is acceptable inside wheel arches where there is no paint. Never use the red or yellow tips.",
          },
        },
        {
          "@type": "Question",
          name: "Is a foam cannon worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the accessory that makes a pressure washer genuinely useful for car care. It produces thick foam that clings to vertical panels for several minutes, and that dwell time is what breaks down road film. The black soap nozzle produces thin foam that runs off in seconds.",
          },
        },
        {
          "@type": "Question",
          name: "Can I pressure wash the engine bay?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is best avoided. Engine bays resist rain, not a directed jet, and water forced into connectors, sensors and modules causes intermittent electrical faults that are miserable to diagnose. If you must, use very low pressure from a distance and cover the alternator and air intake.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my car have water spots after washing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Water left to evaporate deposits dissolved minerals on the paint, and in hard water areas those spots etch into the clear coat if they dry in the sun. Dry promptly with a large plush microfibre or a drying aid, work in the shade, and dry the glass first.",
          },
        },
        {
          "@type": "Question",
          name: "How often should I pressure wash my car?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "As often as it is dirty, and more frequently in winter. In a salted-road climate a periodic low-pressure rinse of the underside, arches and sills does more for the car long-term than any attention to the panels, because salt is what actually destroys a vehicle.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "how to pressure wash a car",
      "pressure washing car paint",
      "foam cannon pressure washer",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            How-To
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How to Pressure <span class="text-[#38BDF8]">Wash a Car</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Cars are the lowest-pressure job in the category, and most of the damage happens in places people never think about: panel edges, existing stone chips, and badge surrounds where the stream gets underneath.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#settings"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Method
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="16.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#settings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Safe Settings</a>
          <a href="#where-damage-happens" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Where Damage Happens</a>
          <a href="#the-method" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Method</a>
          <a href="#foam-cannon" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Foam Cannons</a>
          <a href="#wheels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Wheels and Arches</a>
          <a href="#machine-choice" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Choosing a Machine</a>
          <a href="#aftercare" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Drying and Aftercare</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A pressure washer does not wash a car. It rinses one, applies foam to one, and removes the grit that would otherwise be dragged across the paint by a sponge. Understanding that distinction is what separates a clean car from a swirled one.
        </p>

        <div id="settings" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Settings That Are Safe
          </h2>

          <p>
            Vehicles sit at the bottom of the pressure chart, and there is no job on a car that benefits from more.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Setting</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Use</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Up to ~1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">The whole job</td>
                    <td class="px-4 py-4 text-gray-700">Above this, damage risk rises with no cleaning benefit</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">40&deg; white nozzle</td>
                    <td class="px-4 py-4 text-gray-700">Everything on the paint</td>
                    <td class="px-4 py-4 text-gray-700">Widest spread, gentlest impact per square inch</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Black soap nozzle</td>
                    <td class="px-4 py-4 text-gray-700">Applying detergent</td>
                    <td class="px-4 py-4 text-gray-700">The only tip that draws detergent at all</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">25&deg; green</td>
                    <td class="px-4 py-4 text-gray-700">Wheel arches and undersides only</td>
                    <td class="px-4 py-4 text-gray-700">Never on painted panels</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">0&deg; red and 15&deg; yellow</td>
                    <td class="px-4 py-4 text-gray-700">Never on a vehicle</td>
                    <td class="px-4 py-4 text-gray-700">These strip paint and lift clear coat</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2-3 feet standoff</td>
                    <td class="px-4 py-4 text-gray-700">Paint and glass</td>
                    <td class="px-4 py-4 text-gray-700">Distance is your finest pressure control</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">12 inches</td>
                    <td class="px-4 py-4 text-gray-700">Wheels and tyres</td>
                    <td class="px-4 py-4 text-gray-700">Sound surfaces that tolerate more</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            If your machine has adjustable pressure, use it. Pressure that is genuinely too low to hurt anything still rinses foam and lifts road film perfectly well, because on a vehicle the detergent does the cleaning and the water only carries it away.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Distance Rule</p>
            <p class="text-xl font-bold text-white mb-3">Standing back is more effective protection than a lower spec.</p>
            <p class="text-gray-300 leading-relaxed m-0">A 2,000 PSI machine used at three feet with a 40 degree tip is gentler on paint than a 1,500 PSI machine held six inches away. Pressure at the nozzle is what the manufacturer prints; pressure at the surface is what actually matters, and it falls off quickly with distance. Set your standoff first and adjust the machine second.</p>
          </div>
        </div>

        <div id="where-damage-happens" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Where Damage Actually Happens
          </h2>

          <p>
            Undamaged, well-adhered paint on a flat panel is remarkably tough, and a wide nozzle at a sensible distance will not hurt it. Damage happens at edges and at existing defects, where the stream can get underneath something.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Existing stone chips, where water gets under the edge of the clear coat and lifts it further.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Panel edges and door shuts, where paint is thinnest and there is a lip to catch.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Badges, trim strips and plastic mouldings, whose adhesive is not designed for a directed jet.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Peeling lacquer on an older car, which will not survive any pressure once it has started.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Window and door rubbers, which can be forced out of their channels.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Aftermarket wraps and decals, especially at the edges, where lifting is the normal failure.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Radiator and condenser fins under the front bumper, which flatten easily and cost cooling efficiency.</span>
            </li>
          </ul>

          <p>
            The pattern is consistent: anything with an edge, a seam or an existing failure is vulnerable, and flat sound paint is not. That is why the technique below emphasises spraying along panels rather than into shuts, and keeping a wider berth around anything already damaged.
          </p>

          <p>
            Engine bays deserve a separate warning. Modern engine bays contain sensitive connectors, sensors and modules that are weatherproof against rain, not against a directed jet at close range. If you clean one at all, do it at very low pressure from a distance, cover the alternator and the air intake, and accept that a lot of people who do this end up chasing an electrical fault afterwards.
          </p>
        </div>

        <div id="the-method" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Method, Step by Step
          </h2>

          <p>
            The order matters, because the whole point is to remove grit before anything touches the paint.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">1. Set Up and Pre-Rinse</h3>

          <p>
            Work in the shade on cool paint, never in direct sun on a hot panel, where detergent dries before you can rinse it and leaves marks that are harder to remove than the dirt was. Connect the hose, open the spigot fully, purge air through the wand, then switch the machine on. Rinse the whole car top to bottom with the 40 degree tip at two to three feet, taking your time on the lower panels and arches where the heaviest grit sits.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">2. Foam It and Let It Dwell</h3>

          <p>
            Apply snow foam or car shampoo with a foam cannon, or with the black soap nozzle if you do not have one. Work bottom to top so the foam cannot run down dry paint and streak. Let it dwell for several minutes without drying, which is where the actual cleaning happens: the detergent breaks the bond between road film and clear coat so the rinse can carry it away.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">3. Rinse the Foam Off</h3>

          <p>
            Now rinse top to bottom with the 40 degree tip, so dirt has somewhere to go. A well-foamed car with heavy dirt already removed is dramatically less likely to be scratched by whatever comes next, and a lightly soiled car may genuinely be finished at this point.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">4. Contact Wash With Two Buckets</h3>

          <p>
            For anything beyond light soiling, the pressure washer cannot replace a contact wash. Use two buckets, one with shampoo and one with plain rinse water, both with grit guards. Wash a panel with a clean mitt, then rinse the mitt in the plain water before it goes back into the shampoo. This is the step that prevents swirl marks, and it is the step people skip.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">5. Final Rinse and Dry</h3>

          <p>
            Rinse top to bottom again, then dry promptly with a large plush microfibre or a drying aid, because water left to evaporate leaves mineral spots that are harder to remove than the dirt was. In hard water areas this matters a great deal, and it is the most common reason a properly washed car still looks poor.
          </p>
        </div>

        <div id="foam-cannon" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Foam Cannons and Why They Work
          </h2>

          <p>
            A foam cannon is the accessory that makes a pressure washer genuinely worth owning for car care, and it is the reason detailing enthusiasts favour particular machines.
          </p>

          <p>
            It mixes shampoo, water and air under pressure to produce thick foam that clings to vertical panels instead of running straight off. That clinging is the whole point: dwell time is what lets the chemistry break down road film, and a runny soap gives you about four seconds of it.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Foam Cannon</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Black Soap Nozzle</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Bucket and Sponge</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Foam thickness</td>
                    <td class="px-4 py-4 text-gray-700">Thick, clinging</td>
                    <td class="px-4 py-4 text-gray-700">Thin, runs off</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dwell time achieved</td>
                    <td class="px-4 py-4 text-gray-700">Several minutes</td>
                    <td class="px-4 py-4 text-gray-700">Under a minute</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Removes grit before contact</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Partly</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Swirl risk</td>
                    <td class="px-4 py-4 text-gray-700">Lowest</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Highest</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Extra cost</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Included</td>
                    <td class="px-4 py-4 text-gray-700">Minimal</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Two practical points when buying one. Check that the fitting matches your machine, since some brands use a proprietary connection rather than a standard quick-connect, and check the minimum flow the cannon needs, because a low-GPM machine will produce thin foam whatever the soap.
          </p>

          <p>
            Use a shampoo formulated for foam cannons rather than dish soap. Household detergent strips wax and sealant, which is the protective layer doing the work of keeping the car clean between washes, and it is aggressive on rubber and trim over time.
          </p>
        </div>

        <div id="wheels" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Wheels, Arches and the Underside
          </h2>

          <p>
            These are the only areas on a car where you can reasonably step up the aggression, and they are also where the dirt actually is.
          </p>

          <p>
            Do the wheels first, before the body, and use a separate mitt and bucket for them. Brake dust is metallic and abrasive, and a mitt that has touched a wheel will put fine scratches into paint if it goes anywhere near a panel afterwards.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse the arches thoroughly with the 40 degree tip; a 25 degree tip is acceptable inside the arch liner where there is no paint.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Use a dedicated wheel cleaner and let it dwell, because brake dust is bonded and pressure alone will not shift it.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the stream off wheel weights, valve stems and any tyre pressure sensor.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Be careful with painted or diamond-cut alloys, where the lacquer fails the same way clear coat does.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse the underside and sills in winter, where road salt does the real long-term damage to a car.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Avoid blasting directly into wheel bearings and CV boots at close range.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Winter Job That Matters Most</p>
            <p class="text-xl font-bold text-white mb-3">Salt under the car outlasts dirt on the paint.</p>
            <p class="text-gray-300 leading-relaxed m-0">In a salted-road climate, a periodic low-pressure rinse of the underside, arches and sills does more for the car's long-term condition than any amount of attention to the panels. It is unglamorous, nobody sees it, and it is the single most useful thing a pressure washer does for a vehicle.</p>
          </div>
        </div>

        <div id="machine-choice" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Choosing a Machine for Car Washing
          </h2>

          <p>
            Car washing rewards a different machine than driveway cleaning does, and the specification that matters is not pressure.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Adjustable pressure, so you can genuinely dial it down rather than relying on distance alone.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Enough flow to run a foam cannon well, since thin foam is usually a flow problem rather than a soap problem.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A standard quick-connect fitting, or you will be buying accessories from one brand forever.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>An induction motor if you want quiet, because washing a car is a driveway activity done at weekends near neighbours.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A hose reel or good hose management, because a stiff high-pressure hose dragged across paint is its own hazard.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A Total Stop System, since a car wash involves a lot of standing around with the trigger released.</span>
            </li>
          </ul>

          <p>
            That last point is more than a convenience for this job specifically. Car washing has long pauses while foam dwells, and a machine left running in bypass circulates water inside the pump and heats it rapidly, which is the leading cause of pump failure. A Total Stop System removes the risk of forgetting.
          </p>

          <p>
            Note that a high-pressure machine is not disqualifying, since you can always use less. But a very high-flow, high-pressure machine costs more, weighs more and is louder, and none of that buys you anything on a car. The picks in our <a href="/best-electric-pressure-washer/">electric pressure washer guide</a> flag which machines suit vehicle work specifically.
          </p>
        </div>

        <div id="aftercare" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Drying, Protection and Frequency
          </h2>

          <p>
            The washing is most of the work and the least of the difference. What happens in the ten minutes afterwards decides how the car actually looks.
          </p>

          <p>
            Dry promptly. Water left to evaporate deposits dissolved minerals on the paint, and in a hard water area those spots etch into the clear coat if they sit in the sun. A large plush microfibre drying towel, worked with no pressure, or a drying aid sprayed on to provide lubrication, removes water without dragging anything across the surface.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Dry in the shade, and dry the glass first, where spotting shows most.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Open the doors and boot to dry the shuts, which is where water sits and drips onto clean panels afterwards.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Reapply protection periodically, since a wax or sealant is what makes the next wash easier and safer.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never use dish soap, which strips exactly the protection you are relying on.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Wash more often in winter, when salt is the active threat, and rinse the underside as well as the panels.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep a separate mitt, bucket and drying towel for wheels, permanently.</span>
            </li>
          </ul>

          <p>
            A protected car is genuinely easier and safer to wash, because dirt sits on top of the sealant rather than bonding to the paint, and the foam stage removes far more of it before anything makes contact. That is why regular protection matters more than any equipment decision on this list.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using a Narrow Nozzle on Paint</h3>
              <p class="text-gray-700 text-sm m-0">
                The red 0 degree and yellow 15 degree tips concentrate the machine's entire output into a tiny area and will lift clear coat at a stone chip or a panel edge in a fraction of a second. The 40 degree white tip is the only one that belongs on paint, and the 25 degree stays inside the arch liners.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Washing in Direct Sun on Hot Paint</h3>
              <p class="text-gray-700 text-sm m-0">
                Detergent dries on the panel before you can rinse it, leaving marks that are harder to remove than the dirt was, and water spots etch faster on a hot surface. Work in the shade on cool paint, and if that is not possible, do one panel at a time and rinse before it dries.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Skipping the Two-Bucket Contact Wash</h3>
              <p class="text-gray-700 text-sm m-0">
                A pressure washer removes loose grit but not bonded road film, so a car beyond light soiling still needs contact. Washing with one bucket puts the grit you just removed straight back onto the mitt and drags it across the paint, which is exactly how swirl marks are created.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using Dish Soap in the Foam Cannon</h3>
              <p class="text-gray-700 text-sm m-0">
                Household detergent strips wax and sealant, which is the layer keeping dirt from bonding to your paint and making every future wash easier. It is also hard on rubber and trim over time. Use a shampoo formulated for foam cannons, which is designed to clean without removing protection.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Pressure Washing the Engine Bay</h3>
              <p class="text-gray-700 text-sm m-0">
                Modern engine bays are weatherproof against rain, not against a directed jet at close range, and forcing water into connectors, sensors and modules is how people acquire intermittent electrical faults. If you clean one at all, use very low pressure from a distance and cover the alternator and intake.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI is safe to wash a car?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Up to about 1,500 PSI with a 40 degree white nozzle held two to three feet from the paint. Sound flat panels tolerate more, but there is no cleaning benefit above that figure, and the risk rises sharply at panel edges, stone chips and badge surrounds where the stream can get underneath.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can a pressure washer damage car paint?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Undamaged paint on a flat panel is tough and a wide nozzle at a sensible distance will not hurt it. Damage happens at edges and existing defects: stone chips, peeling lacquer, door shuts, trim adhesive and wrap edges. Narrow nozzles at close range cause almost all of it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do I still need to wash by hand after using a pressure washer?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For anything beyond light soiling, yes. A pressure washer removes loose grit and, with foam, a good deal of road film, but bonded film needs contact. The value of the pressure washer is removing the grit first, so the contact wash does not drag it across the paint.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What nozzle should I use to wash a car?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The 40 degree white tip for all paint and glass, and the black soap nozzle for applying detergent, since it is the only tip that lets the siphon draw at all. A 25 degree green tip is acceptable inside wheel arches where there is no paint. Never use the red or yellow tips.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is a foam cannon worth it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is the accessory that makes a pressure washer genuinely useful for car care. It produces thick foam that clings to vertical panels for several minutes, and that dwell time is what breaks down road film. The black soap nozzle produces thin foam that runs off in seconds.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I pressure wash the engine bay?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is best avoided. Engine bays resist rain, not a directed jet, and water forced into connectors, sensors and modules causes intermittent electrical faults that are miserable to diagnose. If you must, use very low pressure from a distance and cover the alternator and air intake.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why does my car have water spots after washing?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Water left to evaporate deposits dissolved minerals on the paint, and in hard water areas those spots etch into the clear coat if they dry in the sun. Dry promptly with a large plush microfibre or a drying aid, work in the shade, and dry the glass first.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How often should I pressure wash my car?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                As often as it is dirty, and more frequently in winter. In a salted-road climate a periodic low-pressure rinse of the underside, arches and sills does more for the car long-term than any attention to the panels, because salt is what actually destroys a vehicle.
              </p>
            </div>
          </div>
        </div>

