---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 10,000 Watt Generators",
    "url": "/best-10000-watt-generator/"
  },
  {
    "title": "Best Dual Fuel Generators",
    "url": "/best-dual-fuel-generator/"
  },
  {
    "title": "Generator Transfer Switch Types and Cost",
    "url": "/generator-transfer-switch-types-cost-and-installation/"
  },
  {
    "title": "What Size Generator Runs a Well Pump",
    "url": "/what-size-generator-runs-a-well-pump/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 8000 Watt Generators in 2026: The 30-Amp Transfer Switch Sweet Spot";
const description =
  "The best 8000 watt generators for running a fridge, freezer, furnace, well pump and window AC through a 30A twist-lock and transfer switch, with fuel burn math.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen7500dfc",
    "name": "Westinghouse WGen7500DFc Dual Fuel Portable Generator",
    "category": "Open Frame, 7,500W Running / 9,500W Peak, Dual Fuel",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 3100,
    "pros": [
      "7,500 running watts on gasoline, enough to use a full 30-amp connection",
      "Propane rating of 6,750 running watts is one of the smallest drops here",
      "Remote key fob start plus push-button and recoil backup",
      "L14-30R transfer-switch-ready outlet and two GFCI duplexes",
      "CO sensor with automatic shutdown and a 3-year limited warranty"
    ],
    "cons": [
      "Around 200 pounds dry, so a two-person lift into a truck",
      "Runtime is published at 25% load, which flatters it against half-load figures"
    ],
    "bottomLine": "The 8,000 watt-class generator to buy for a 30-amp transfer switch: enough running watts on either fuel to use the whole connection, with remote start for storm nights.",
    "description": "The WGen7500DFc is the model we would wire to a 30-amp transfer switch first. Westinghouse rates it at 7,500 running and 9,500 peak watts on gasoline and 6,750 running and 8,550 peak on propane, so even on propane it can deliver close to the 7,200 watts an L14-30 cord carries. Power comes from a 420cc engine with a 6.6 gallon tank, and Westinghouse lists up to 11 hours at 25% load. The panel has an L14-30R twist-lock for the transfer switch and two 120V GFCI duplex outlets, protected by a 30-amp double-pole main breaker. Starting is the strong point: a remote key fob, push-button electric start and a recoil backup, so you can start it from a doorway. The c suffix adds a CO sensor that shuts the engine down if carbon monoxide builds up around it. Westinghouse lists a dry weight of about 201 pounds, so it lives on its wheels. The fuel selector can be switched while running. It is not quiet, as an open-frame unit, and it costs more than the WEN, but it is the best balance of output, fuel flexibility and convenience at this size."
  },
  {
    "id": "generac-gp8000e-8929",
    "name": "Generac GP8000E 8929 Portable Generator with COsense",
    "category": "Open Frame, 8,000W Running / 10,000W Starting, Gasoline",
    "badge": "Best for Motor Starts",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1400,
    "pros": [
      "10,000 starting watts, the highest surge rating on this list",
      "Generac rates it for up to 12 hours at 50% load on a 7.9 gallon tank",
      "COsense shutdown and PowerRush starting technology",
      "50-state compliant version",
      "Electric start with included battery"
    ],
    "cons": [
      "Gasoline only, no propane option",
      "About 207 pounds per Generac's spec sheet"
    ],
    "bottomLine": "Buy it for a house with a big well pump or an older AC that needs a hard start, and for owners who already store treated gasoline.",
    "description": "The GP8000E is Generac's long-running 8,000 watt open-frame generator, and the 8929 is the current 50-state version sold with COsense. Generac rates it at 8,000 running and 10,000 starting watts on gasoline, and markets PowerRush as adding extra starting capacity for motors, which is the right strength for a house with a well pump and a window AC that might start together. Generac's spec sheet lists up to 12 hours at 50% load from the 7.9 gallon steel tank, the longest half-load figure in this roundup, and a unit weight of 207 pounds. COsense watches for carbon monoxide build-up and shuts the engine down. Electric start runs from an included battery. The limit is fuel: it is gasoline only, so you need a fuel routine with stabiliser and rotation, and you lose propane's shelf life. Earlier GP8000E versions carry an L14-30R twist-lock with two GFCI duplexes; check the panel photo on the 8929 listing before buying a cord, since we could not confirm its outlet list on Generac's sheet."
  },
  {
    "id": "duromax-xp9500ih",
    "name": "DuroMax XP9500iH Dual Fuel Inverter Generator",
    "category": "Inverter, 7,600W Running / 9,500W Peak, Dual Fuel",
    "badge": "Best Inverter",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "7,600 running watts on gas and 7,200 on propane, the best propane rating here",
      "Rated 61 dBA at 23 feet at quarter load",
      "Up to 11 hours at 50% load on a 7.1 gallon tank",
      "Remote electric start and CO alert shutdown",
      "Inverter output for furnace control boards and electronics"
    ],
    "cons": [
      "About 216 pounds dry",
      "Costs much more than open-frame generators of similar output"
    ],
    "bottomLine": "The best-performing generator here on propane, and quiet enough to run near neighbours. Worth the premium if noise or a fussy furnace board matters.",
    "description": "The XP9500iH is a dual fuel inverter that sits at the top of this class. DuroMax rates it at 7,600 running and 9,500 peak watts on gasoline and 7,200 running and 9,025 peak on propane, a smaller propane drop than anything else here, so it can fill a 30-amp connection on either fuel. The 7.1 gallon tank is rated for 11 hours at 50% load and 21 at 25%, and DuroMax's sheet lists 10 hours at half load on a 40 pound propane cylinder. Noise is rated at 61 dBA from 23 feet at quarter load, roughly half as loud as open-frame units in this class. Inverter output with low distortion suits high-efficiency furnace boards and electronics. It has remote and electric start, a CO alert that shuts the engine down, and DuroMax lists a 5-year warranty on the Amazon listing. The cost is weight, at about 216 pounds dry, and price: you pay well over an open-frame unit for the quiet and the propane rating. If you live close to neighbours or plan to run mostly on propane, it is worth it."
  },
  {
    "id": "champion-201175-8500w-dual-fuel-inverter",
    "name": "Champion 201175 8500-Watt Dual Fuel Inverter Generator",
    "category": "Inverter, 7,000W Running / 8,500W Starting, Dual Fuel",
    "badge": "Quietest Pick",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 1100,
    "pros": [
      "Inverter with Quiet Technology, rated 64 dBA at 23 feet by Champion",
      "Up to 14 hours on gasoline at 25% load from a 5.33 gallon tank",
      "Up to 12 hours on a 20 pound propane cylinder",
      "CO Shield shutdown and electric start",
      "120/240V 30A locking outlet plus two GFCI duplexes"
    ],
    "cons": [
      "Starting rating of 8,500 watts is lower than the open-frame picks",
      "Propane drops running output to 6,300 watts"
    ],
    "bottomLine": "A quiet inverter for a 30-amp transfer switch that is easier on the neighbours. Pick the DuroMax instead if you need more on propane.",
    "description": "Champion's 201175 is the dual fuel version of its 8,500 watt inverter with Quiet Technology. Champion rates it at 8,500 starting and 7,000 running watts on gasoline and 8,500 starting and 6,300 running watts on propane from a 420cc engine. The 5.33 gallon tank is rated for up to 14 hours at 25% load, and Champion lists up to 12 hours on a 20 pound propane cylinder. Champion's own page lists 64 dBA from 23 feet, and some retailers quote 61 dBA; either way it is much quieter than the open-frame picks. The panel has a 120/240V 30A locking outlet for a transfer switch, two 120V 20A GFCI duplexes and a 12V outlet, and CO Shield shuts the engine off if carbon monoxide builds up. Electric start comes with an LPG hose and a 3-year warranty. Its weaknesses are a lower starting rating than the open-frame units, which matters for big well pumps, and a larger propane drop than the DuroMax. Retail listings put the weight well over 200 pounds."
  },
  {
    "id": "wen-df8000x",
    "name": "WEN DF8000X 8000-Watt Dual Fuel Portable Generator",
    "category": "Open Frame, 6,500W Rated / 8,000W Surge, Dual Fuel",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1600,
    "pros": [
      "Lowest price in this class by a wide margin",
      "Lightest here at about 139 pounds with the wheel kit",
      "Rated 10.5 hours at half load on a 6.7 gallon tank",
      "L14-30R transfer-switch-ready outlet and CO shutdown sensor",
      "Electric start on gasoline or propane"
    ],
    "cons": [
      "8,000 is the surge figure; rated output is 6,500 watts on gas and 5,850 on propane",
      "Smaller 340cc engine has the least headroom for simultaneous motor starts"
    ],
    "bottomLine": "The cheapest way into a 30-amp transfer switch setup. Fine for a fridge, freezer and furnace; tight if the well pump and AC start together.",
    "description": "The WEN DF8000X is the budget pick and the one to read carefully. Its 8,000 watts is the surge rating; WEN's manual lists 6,500 rated watts and 8,000 surge on gasoline, and 5,850 rated and 7,200 surge on propane, from a 340cc engine. That is less than the other picks, but it still fits under the 7,200 watt limit of a 30-amp L14-30 connection, and it runs the typical running load of a fridge, freezer, furnace blower, lights and a window AC. Where it is tight is the moment a well pump and an AC start at once. The 6.7 gallon tank is rated for 10.5 hours at half load, and with the wheel and handle kit it weighs about 139 pounds, 60 or more pounds lighter than the rest. The panel has a transfer-switch-ready L14-30R, electric start, and CO Watchdog shutdown. For a house without a well pump, or one that can hold the AC until the pump has filled the tank, it is a lot of generator for the money."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 8000 Watt Generator",
          item: "https://www.thehonestreviewers.com/best-8000-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will an 8000 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, a refrigerator, chest freezer, gas furnace blower, a 1 HP well pump, one window air conditioner, lights and electronics at the same time. That load typically runs around 5,000 watts and peaks above 7,000 when the pump starts. It will not run central air, an electric water heater or an electric dryer alongside everything else."
          }
        },
        {
          "@type": "Question",
          "name": "Can an 8000 watt generator run a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a whole house with central air and electric appliances. It runs the essentials and comforts of most homes through a transfer switch, but through a 30-amp L14-30 connection it is capped at 7,200 watts. Whole-house coverage with central air usually needs a 50-amp portable at 12,000 watts or more, or a standby generator."
          }
        },
        {
          "@type": "Question",
          "name": "Is 8000 watts enough for a well pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for most residential well pumps up to about 1.5 HP. A 1 HP 240V pump typically needs 3,000 to 4,000 watts to start, and this class has 8,000 to 10,000 starting watts. The pump must be fed at 240V through the L14-30R outlet and a transfer switch, not from a 120V outlet."
          }
        },
        {
          "@type": "Question",
          "name": "How long will an 8000 watt generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "About 10 to 12 hours at half load on the 6.7 to 7.9 gallon tanks in this class, based on manufacturer ratings. That works out to around two-thirds of a gallon an hour. At quarter load the same tank lasts longer, around 14 to 21 hours, depending on the model and whether it is an inverter."
          }
        },
        {
          "@type": "Question",
          "name": "How much propane does an 8000 watt generator use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly 4 pounds an hour at half load, based on DuroMax's rating of 10 hours on a 40 pound cylinder for the XP9500iH. That means a standard 20 pound grill tank lasts about five hours at half load, and a full day of continuous running needs around 100 pounds of propane."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between an 8000 and an 8500 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually the label, not the output. Many 8,500 watt generators, like the Champion 201175, are rated 8,500 starting and 7,000 running, while some 8,000 watt models are rated 8,000 running and 10,000 starting. Compare running watts on your fuel, not the model name, because the bigger number can be the smaller generator."
          }
        },
        {
          "@type": "Question",
          "name": "What size transfer switch do I need for an 8000 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 30-amp transfer switch or interlock with a 30-amp inlet and a 10-gauge L14-30 cord. That matches the L14-30R outlet on every generator in this class and carries up to 7,200 watts. A 50-amp switch only makes sense if you plan to move up to a generator with a 14-50R outlet."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "8000 watt generator",
      "8500 watt generator",
      "8000w generator",
      "best 8000 watt generator",
      "8000 watt dual fuel generator",
      "generator for transfer switch"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">8000 Watt Generators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Eight thousand watts is the most a 30-amp twist-lock cord can actually deliver to your panel. Here are the five generators in this class worth wiring to a transfer switch, and the load math that tells you whether you need one.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen7500dfc"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 8,000 Watts Runs</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#thirty-amp" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 30-Amp Ceiling</a>
          <a href="#dual-fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Gas, Propane or Both</a>
          <a href="#fuel-burn" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Fuel Burn at 50% Load</a>
          <a href="#inverter" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Inverter or Open Frame</a>
          <a href="#motor-starts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Well Pump and AC Starts</a>
          <a href="#hookup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Transfer Switch Hookup</a>
          <a href="#bigger" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. 8kW vs 10kW vs 12kW</a>
          <a href="#skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Should Skip This Size</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          An 8,000 watt generator is the size that turns an outage from camping indoors into a slightly louder normal evening: refrigerator, chest freezer, furnace blower, well pump and one window air conditioner, all on at once, fed through a 30-amp inlet and a transfer switch. It is also the ceiling for that 30-amp connection, which is the single most useful thing to know before you buy one.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-it-runs" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What 8,000 Watts Actually Runs
          </h2>

          <p>
            Start with the list most people write down when the power goes out for more than a day: the kitchen refrigerator, a chest freezer in the garage, the gas furnace blower in winter, the well pump if you are on a private well, a window air conditioner in one bedroom in summer, and a handful of lights, a router and phone chargers. That is the list this size exists for. Add up typical running watts and you land somewhere between 4,500 and 5,500 watts, which looks like it should fit on a much smaller machine.
          </p>

          <p>
            The catch is starting watts. Every one of those loads except the lights has a motor or compressor, and each motor pulls two to three times its running watts for a second or two as it starts. The well pump is the worst offender: a typical 1 HP submersible on 240V runs at around 1,000 to 1,500 watts and can ask for 3,000 to 4,000 watts to start. A 10,000 BTU window unit wants roughly 3,000 watts for the first second. If the pump kicks on while the fridge, freezer, furnace and AC are already running, the generator has to carry the whole running load plus that surge at the same instant.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Load</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical running watts</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical starting watts</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Refrigerator</td>
                    <td class="px-4 py-4 text-gray-700">600-800</td>
                    <td class="px-4 py-4 text-gray-700">1,800-2,200</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chest freezer</td>
                    <td class="px-4 py-4 text-gray-700">400-600</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Gas furnace blower (1/2 HP)</td>
                    <td class="px-4 py-4 text-gray-700">700-900</td>
                    <td class="px-4 py-4 text-gray-700">2,000-2,400</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Well pump (1 HP, 240V)</td>
                    <td class="px-4 py-4 text-gray-700">1,000-1,500</td>
                    <td class="px-4 py-4 text-gray-700">3,000-4,000</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Window AC (10,000 BTU)</td>
                    <td class="px-4 py-4 text-gray-700">900-1,200</td>
                    <td class="px-4 py-4 text-gray-700">2,700-3,200</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lights, router, TV, chargers</td>
                    <td class="px-4 py-4 text-gray-700">400-600</td>
                    <td class="px-4 py-4 text-gray-700">400-600</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
