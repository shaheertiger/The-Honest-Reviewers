---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best Dual Fuel Inverter Generator", url: "/best-dual-fuel-inverter-generator/" },
    { title: "Best Inverter Generator", url: "/best-inverter-generator/" },
    { title: "Best Natural Gas Generator", url: "/best-natural-gas-generator/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-01", modified: "2026-09-01" });
const title = "How Much Propane Does a Generator Use Per Hour?";
const description =
  "A mid-size portable empties a 20 lb cylinder in 5-8 hours. A 22kW standby can use 2-3 gallons an hour. Here is how to plan fuel for a multi-day outage.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Generator Propane Consumption",
          item: "https://www.thehonestreviewers.com/how-much-propane-does-a-generator-use/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much propane does a generator use per hour?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on size and load. A 5,000 to 7,500 watt portable at moderate load uses roughly 0.6 to 0.9 gallons an hour, while a 22,000 watt standby unit at half load can use 2 to 3 gallons an hour. Consumption scales with how hard the machine is working, not just its rating.",
          },
        },
        {
          "@type": "Question",
          name: "How long will a 20 lb propane tank run a generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Roughly five to eight hours on a mid-size portable at moderate load, and eight to twelve hours on a small inverter generator. A 20 lb cylinder holds about 4.6 gallons of propane. Heavier loads shorten those figures considerably.",
          },
        },
        {
          "@type": "Question",
          name: "How long will a 500 gallon propane tank run a standby generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 500 gallon tank holds about 400 usable gallons after the eighty percent fill rule. A 22,000 watt standby unit using 2 to 3 gallons an hour would run roughly six to eight days continuously, and considerably longer if it is not running at half load the whole time.",
          },
        },
        {
          "@type": "Question",
          name: "Is propane or gasoline better for a generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Propane for preparedness, gasoline for energy density. Propane stores indefinitely and is available when filling stations have no power, while gasoline degrades in months and is often unobtainable during regional outages. Gasoline delivers slightly more power and runtime per volume.",
          },
        },
        {
          "@type": "Question",
          name: "Does a generator use more propane in cold weather?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Consumption itself is driven by load, but cold weather causes a different problem: propane vaporises less readily as temperature falls, so a small cylinder can struggle to deliver enough vapour under load and may frost up. Larger tanks cope better, and dual-fuel machines can switch to gasoline.",
          },
        },
        {
          "@type": "Question",
          name: "How much propane should I store for a power outage?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Work it out rather than guessing. Multiply your machine’s consumption at your typical load by the hours you will run it each day and the days you want covered, then add margin. A 7,500 watt portable running twelve hours a day for three days needs roughly five to seven 20 lb cylinders.",
          },
        },
        {
          "@type": "Question",
          name: "Does propane go bad in storage?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Propane does not degrade the way gasoline does and can be stored indefinitely, which is its main advantage for outage preparedness. The cylinders themselves age — valves and seals deteriorate and cylinders carry recertification dates — so check them periodically even though the fuel inside is fine.",
          },
        },
        {
          "@type": "Question",
          name: "Is it cheaper to run a generator on propane or gasoline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It varies with local fuel prices, and propane carries slightly less energy per unit volume so a generator uses somewhat more of it for the same output. The stronger argument for propane is availability rather than cost — it stores indefinitely and is on hand when filling stations have no power.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Generators & Backup Power",
    tags: [
      "how much propane does a generator use",
      "generator propane consumption",
      "propane generator runtime",
      "generators & backup power",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Dual Fuel Generators",
    link: "/best-dual-fuel-generator/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Fuel Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How Much Propane <span class="text-[#38BDF8]">Does a Generator Use?</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Consumption scales with load, not with the size of the machine — which means the honest answer depends on what you are actually running.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#consumption"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Consumption Figures
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.5k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#consumption" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Consumption Figures</a>
          <a href="#tank-sizes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Tank Sizes and Runtime</a>
          <a href="#propane-vs-gas" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Propane vs Gasoline</a>
          <a href="#planning" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Planning Your Fuel</a>
          <a href="#efficiency" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Making Fuel Last</a>
          <a href="#natural-gas" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Natural Gas Comparison</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A 20 lb barbecue cylinder holds about 4.6 gallons of propane and will run a mid-size portable generator for roughly five to eight hours under moderate load. Scale that up to a standby unit powering a whole house and you are into gallons per hour — which is why fuel planning matters more than machine capacity over a long outage.
        </p>

        <div id="consumption" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How Much Propane Generators Actually Use
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Generator</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Load</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. Consumption</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">20 lb Cylinder Runtime</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2,000-3,500W portable</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">8-12 hours</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">5,000-7,500W portable</td>
                    <td class="px-4 py-4 text-gray-700">Moderate</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 0.6-0.9 gal/hr</td>
                    <td class="px-4 py-4 text-gray-700">5-8 hours</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">9,500-12,000W portable</td>
                    <td class="px-4 py-4 text-gray-700">Moderate to heavy</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1-1.5 gal/hr</td>
                    <td class="px-4 py-4 text-gray-700">3-5 hours</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">14,000W standby</td>
                    <td class="px-4 py-4 text-gray-700">Half load</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1.5-2 gal/hr</td>
                    <td class="px-4 py-4 text-gray-700">Not practical on cylinders</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">22,000W standby</td>
                    <td class="px-4 py-4 text-gray-700">Half load</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 2-3 gal/hr</td>
                    <td class="px-4 py-4 text-gray-700">Needs a large tank</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            These are planning figures rather than specifications. Actual consumption depends heavily on how hard the machine is working, and every manufacturer publishes figures for their specific model at quarter, half and full load. Those published numbers are what to plan against once you know which machine you have.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Load Drives Everything</p>
            <p class="text-xl font-bold text-white mb-3">A generator at quarter load may use a third of what it does at full load.</p>
            <p class="text-gray-300 leading-relaxed m-0">Consumption is not a fixed property of the machine. A 7,500 watt generator running a fridge, a furnace blower and some lights is working far below capacity and sips fuel; the same machine running a water heater as well is working hard and drinks it. Right-sizing your load list is also fuel management.</p>
          </div>
        </div>

        <div id="tank-sizes" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Propane Tank Sizes and What They Buy You
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Tank</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Propane Capacity</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical Use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">20 lb cylinder</td>
                    <td class="px-4 py-4 text-gray-700">About 4.6 gallons</td>
                    <td class="px-4 py-4 text-gray-700">Barbecue size; portable generators</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">30 lb cylinder</td>
                    <td class="px-4 py-4 text-gray-700">About 7 gallons</td>
                    <td class="px-4 py-4 text-gray-700">Larger portables; still hand-portable</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">100 lb cylinder</td>
                    <td class="px-4 py-4 text-gray-700">About 23 gallons</td>
                    <td class="px-4 py-4 text-gray-700">Semi-permanent; heavy to move</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">120 gallon tank</td>
                    <td class="px-4 py-4 text-gray-700">About 96 gallons usable</td>
                    <td class="px-4 py-4 text-gray-700">Small standby installations</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">250 gallon tank</td>
                    <td class="px-4 py-4 text-gray-700">About 200 gallons usable</td>
                    <td class="px-4 py-4 text-gray-700">Common standby size</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">500 gallon tank</td>
                    <td class="px-4 py-4 text-gray-700">About 400 gallons usable</td>
                    <td class="px-4 py-4 text-gray-700">Whole-house standby, long outages</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Note that tanks are filled to about eighty percent of their nominal capacity to allow for thermal expansion, so a 500 gallon tank holds around 400 gallons of usable propane rather than 500. That eighty percent rule applies across sizes and is worth remembering when planning runtime.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">What That Means for a Multi-Day Outage</h3>

          <p>
            A 22,000 watt standby unit consuming around 2 to 3 gallons an hour at half load will use roughly 48 to 72 gallons a day if it runs continuously. On a 250 gallon tank filled to eighty percent — about 200 usable gallons — that is roughly three to four days of continuous whole-house operation. A 500 gallon tank doubles it.
          </p>

          <p>
            That arithmetic is worth doing before you need it. Households that assume a standby generator means unlimited runtime are often surprised, because unlimited applies to natural gas from the mains, not to propane from a tank on the property.
          </p>
        </div>

        <div id="propane-vs-gas" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Propane Against Gasoline and Natural Gas
          </h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Propane</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gasoline</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Natural Gas</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Storage life</td>
                    <td class="px-4 py-4 text-gray-700">Indefinite</td>
                    <td class="px-4 py-4 text-gray-700">Months, even stabilised</td>
                    <td class="px-4 py-4 text-gray-700">Not stored</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Runtime per tank</td>
                    <td class="px-4 py-4 text-gray-700">5-8 hrs on 20 lb</td>
                    <td class="px-4 py-4 text-gray-700">8-12 hrs per tank</td>
                    <td class="px-4 py-4 text-gray-700">Unlimited</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Energy per volume</td>
                    <td class="px-4 py-4 text-gray-700">Lower</td>
                    <td class="px-4 py-4 text-gray-700">Higher</td>
                    <td class="px-4 py-4 text-gray-700">Piped supply</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Available in an outage</td>
                    <td class="px-4 py-4 text-gray-700">Yes, if stored</td>
                    <td class="px-4 py-4 text-gray-700">Stations often closed</td>
                    <td class="px-4 py-4 text-gray-700">Usually, but can be shut off</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cold weather starting</td>
                    <td class="px-4 py-4 text-gray-700">Can struggle in severe cold</td>
                    <td class="px-4 py-4 text-gray-700">Generally reliable</td>
                    <td class="px-4 py-4 text-gray-700">Reliable</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Engine cleanliness</td>
                    <td class="px-4 py-4 text-gray-700">Burns cleaner</td>
                    <td class="px-4 py-4 text-gray-700">More deposits</td>
                    <td class="px-4 py-4 text-gray-700">Burns clean</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Storage Argument Is the Decisive One</h3>

          <p>
            Propane delivers slightly less energy per unit volume than gasoline, so a generator running on propane produces marginally less power and shorter runtime from an equivalent volume. That is a genuine disadvantage on paper and largely irrelevant in practice, because the deciding factor for outage preparedness is whether you have fuel at all.
          </p>

          <p>
            Gasoline degrades within months, needs stabiliser and rotation, and is frequently unobtainable during regional outages when filling stations have no power to run their pumps. Propane cylinders sit in a garage for years and are ready whenever you need them. For a machine that may sit unused for eighteen months and then be needed urgently, that difference outweighs the energy density.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Cold Weather Is the Propane Caveat</h3>

          <p>
            Propane vaporises less readily as temperatures fall, and in severe cold a small cylinder can struggle to deliver enough vapour to run a generator at load — the tank frosts and pressure drops. Larger tanks have more surface area and cope better. In genuinely cold climates this is worth planning for, either with a larger tank or with a dual-fuel machine that can switch to gasoline.
          </p>
        </div>

        <div id="planning" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. How Much Propane to Keep on Hand
          </h2>

          <div class="space-y-4 my-8">
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">1</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Decide how long you want to be covered</p>
                <p class="text-gray-700 text-sm m-0">Three days covers most outages; a week is a realistic target in areas with severe weather.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">2</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Estimate your daily running hours</p>
                <p class="text-gray-700 text-sm m-0">Few people run a generator continuously. Twelve hours a day, cycling it off overnight, is a common and sensible pattern.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">3</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Find your machine’s consumption at your load</p>
                <p class="text-gray-700 text-sm m-0">Use the manufacturer’s figures for quarter and half load rather than a generic number.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">4</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Multiply out and add margin</p>
                <p class="text-gray-700 text-sm m-0">Hours per day times days times consumption, plus at least a cylinder or two of margin.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">5</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Store cylinders safely</p>
                <p class="text-gray-700 text-sm m-0">Outdoors or in a well-ventilated unheated space, upright, away from ignition sources and living areas. Never in a basement.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start bg-gray-50 border border-gray-100 rounded-2xl p-5">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black flex-shrink-0">6</span>
              <div>
                <p class="font-bold text-gray-900 m-0 mb-1">Rotate and check</p>
                <p class="text-gray-700 text-sm m-0">Propane does not degrade, but valves and seals age. Check cylinders periodically and observe recertification dates.</p>
              </div>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">A Worked Example</h3>

          <p>
            A household with a 7,500 watt portable running essentials at moderate load uses roughly 0.6 to 0.9 gallons an hour. Running twelve hours a day for three days is 36 hours, so about 22 to 32 gallons — which is five to seven 20 lb cylinders. That is a meaningful amount of storage, and it is the sort of figure that surprises people planning with one spare cylinder in the garage.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Cycling the Generator Saves More Than Anything</p>
            <p class="text-xl font-bold text-white mb-3">You do not need to run it continuously.</p>
            <p class="text-gray-300 leading-relaxed m-0">Running a generator twelve hours a day rather than twenty-four roughly halves fuel consumption, and a well-stocked freezer holds temperature for hours without power. Cycling the machine — several hours on, several off — is the single most effective way to stretch a limited fuel supply through a long outage.</p>
          </div>
        </div>

        <div id="efficiency" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Getting More Hours From the Propane You Have
          </h2>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Run the generator only when you need it rather than continuously; a full freezer coasts for hours.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Shed the largest loads. A water heater or electric range consumes fuel at a startling rate.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Right-size the machine to the job — a large generator lightly loaded is less efficient than a smaller one working properly.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Consider an inverter generator if you have one; variable engine speed matches fuel use to load.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the machine serviced. A clean air filter and fresh oil measurably affect consumption.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep cylinders warm in cold weather, within safe limits, so vapour pressure stays adequate.</span>
            </li>
          </ul>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Inverter Generators and Part Load</h3>

          <p>
            A conventional generator runs its engine at a fixed speed regardless of load, so it burns a substantial amount of fuel even when barely loaded. An inverter generator varies engine speed to match demand, which makes a real difference during the long stretches when you are only running a fridge and some lights. For extended outage use at low average load, that efficiency compounds meaningfully.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Dual-Fuel Insurance Policy</h3>

          <p>
            A dual-fuel or tri-fuel machine lets you run on propane by default and switch to gasoline if propane runs out, or the reverse. For outage preparedness that flexibility is worth a great deal — it means one supply failing does not stop the generator, and you can use whichever fuel you can actually obtain at the time.
          </p>
        </div>

        <div id="natural-gas" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. How Propane Compares to Natural Gas Consumption
          </h2>

          <p>
            If you are choosing between a propane and a natural gas standby installation, consumption behaves differently enough to be worth understanding.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Propane</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Natural Gas</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Energy per cubic foot</td>
                    <td class="px-4 py-4 text-gray-700">Higher</td>
                    <td class="px-4 py-4 text-gray-700">Lower</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Volume consumed per hour</td>
                    <td class="px-4 py-4 text-gray-700">Lower</td>
                    <td class="px-4 py-4 text-gray-700">Higher</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Supply</td>
                    <td class="px-4 py-4 text-gray-700">Tank on the property</td>
                    <td class="px-4 py-4 text-gray-700">Piped from the utility</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Runs out?</td>
                    <td class="px-4 py-4 text-gray-700">Yes, when the tank empties</td>
                    <td class="px-4 py-4 text-gray-700">Effectively no</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost visibility</td>
                    <td class="px-4 py-4 text-gray-700">You buy fills</td>
                    <td class="px-4 py-4 text-gray-700">Metered like any gas usage</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Available if the gas main is shut</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Propane carries more energy per cubic foot than natural gas, so a generator burns a smaller volume of propane than of natural gas for the same output. That sounds like an advantage and mostly is not, because natural gas arrives through a pipe and volume consumed is a billing matter rather than a runtime constraint.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The Real Difference Is Whether It Can Run Out</h3>

          <p>
            A natural gas standby unit has effectively unlimited runtime, which is its single largest advantage over every other option. A propane unit runs until the tank empties, and refilling during a widespread outage may be difficult. That is the comparison that matters when planning for a long event, rather than the energy density arithmetic.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Where Propane Wins</h3>

          <p>
            Two situations favour propane clearly. Rural properties frequently have no natural gas service at all, making propane the only piped-fuel option. And in seismically active regions the gas main can be shut off as a safety measure precisely during a major event, at which point a tank on your own property is the supply that still works.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            7. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming a Standby Generator Has Unlimited Runtime</h3>
              <p class="text-gray-700 text-sm m-0">
                Unlimited applies to natural gas from the mains, not to propane from a tank. A 22,000 watt unit using 2 to 3 gallons an hour will empty a 250 gallon tank — about 200 usable gallons — in roughly three to four days of continuous running. Do that arithmetic before you need it.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Planning With One Spare Cylinder</h3>
              <p class="text-gray-700 text-sm m-0">
                A 7,500 watt portable running twelve hours a day for three days needs roughly 22 to 32 gallons, which is five to seven 20 lb cylinders. One spare in the garage covers a single evening. Work out the actual figure for your machine and running pattern rather than guessing.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting Tanks Fill to 80 Percent</h3>
              <p class="text-gray-700 text-sm m-0">
                Propane tanks are filled to about eighty percent of nominal capacity to allow for thermal expansion, so a 500 gallon tank holds around 400 usable gallons. Planning runtime on the nameplate figure overstates your coverage by a fifth.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Running the Generator Continuously</h3>
              <p class="text-gray-700 text-sm m-0">
                Cycling a generator — several hours on, several off — roughly halves fuel consumption over a day, and a full freezer holds temperature comfortably through the gaps. Running continuously out of habit is the fastest way to exhaust a limited propane supply during a long outage.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Storing Cylinders Indoors</h3>
              <p class="text-gray-700 text-sm m-0">
                Propane cylinders belong outdoors or in a well-ventilated unheated space, upright and away from ignition sources — never in a basement or living space. This is a straightforward safety rule that people break when preparing for a storm and wanting fuel close to hand.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much propane does a generator use per hour?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It depends on size and load. A 5,000 to 7,500 watt portable at moderate load uses roughly 0.6 to 0.9 gallons an hour, while a 22,000 watt standby unit at half load can use 2 to 3 gallons an hour. Consumption scales with how hard the machine is working, not just its rating.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long will a 20 lb propane tank run a generator?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Roughly five to eight hours on a mid-size portable at moderate load, and eight to twelve hours on a small inverter generator. A 20 lb cylinder holds about 4.6 gallons of propane. Heavier loads shorten those figures considerably.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long will a 500 gallon propane tank run a standby generator?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A 500 gallon tank holds about 400 usable gallons after the eighty percent fill rule. A 22,000 watt standby unit using 2 to 3 gallons an hour would run roughly six to eight days continuously, and considerably longer if it is not running at half load the whole time.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is propane or gasoline better for a generator?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Propane for preparedness, gasoline for energy density. Propane stores indefinitely and is available when filling stations have no power, while gasoline degrades in months and is often unobtainable during regional outages. Gasoline delivers slightly more power and runtime per volume.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Does a generator use more propane in cold weather?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Consumption itself is driven by load, but cold weather causes a different problem: propane vaporises less readily as temperature falls, so a small cylinder can struggle to deliver enough vapour under load and may frost up. Larger tanks cope better, and dual-fuel machines can switch to gasoline.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much propane should I store for a power outage?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Work it out rather than guessing. Multiply your machine’s consumption at your typical load by the hours you will run it each day and the days you want covered, then add margin. A 7,500 watt portable running twelve hours a day for three days needs roughly five to seven 20 lb cylinders.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Does propane go bad in storage?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Propane does not degrade the way gasoline does and can be stored indefinitely, which is its main advantage for outage preparedness. The cylinders themselves age — valves and seals deteriorate and cylinders carry recertification dates — so check them periodically even though the fuel inside is fine.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is it cheaper to run a generator on propane or gasoline?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It varies with local fuel prices, and propane carries slightly less energy per unit volume so a generator uses somewhat more of it for the same output. The stronger argument for propane is availability rather than cost — it stores indefinitely and is on hand when filling stations have no power.
              </p>
            </div>
          </div>
        </div>

