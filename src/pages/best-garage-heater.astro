---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  { "title": "Best Garage Door Bottom Seal", "url": "/best-garage-door-bottom-seal/" },
  {
    "title": "Best Garage Floor Epoxy",
    "url": "/best-garage-floor-epoxy/"
  },
  {
    "title": "Best Garage Floor Coatings",
    "url": "/best-garage-floor-coating/"
  },
  {
    "title": "Best Garage Floor Tiles",
    "url": "/best-garage-floor-tiles/"
  },
  {
    "title": "Garage Flooring Options",
    "url": "/garage-flooring-options/"
  },
  {
    "title": "Garage Floor Epoxy Drying Time",
    "url": "/garage-floor-epoxy-drying-time/"
  },
  {
    "title": "Best Attic Ladders",
    "url": "/best-attic-ladder/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Garage Heaters, Sized for the Garage You Actually Have";
const description =
  "Seven garage heaters compared, from 240V electric to vented gas and portable propane, plus how to size BTUs, wire the circuit and vent safely.";

const PRODUCTS = [
  {
    "id": "dr-infrared-dr975-garage-heater",
    "name": "Dr. Infrared Heater DR-975 7500W Garage Heater",
    "category": "240V Hardwired Electric, 7,500W",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1500,
    "pros": [
      "7,500 watts, roughly 25,600 BTU per hour, is the right output for an insulated two-car garage in most of the country",
      "Remote-controlled digital thermostat lets you set the temperature from the bench instead of climbing to a ceiling unit",
      "Two heat levels, so it can idle on the lower setting once the space is up to temperature",
      "Five adjustable louvers aim warm air at the work area rather than at the ceiling",
      "Mounts to the ceiling or a wall, keeping it off the floor and away from gasoline vapors"
    ],
    "cons": [
      "Draws about 31 amps at 240V, which means a 40-amp circuit and heavier wire rather than the 30-amp circuit many people assume",
      "Must be hardwired, so budget for an electrician if you are not comfortable working in the panel"
    ],
    "bottomLine": "The sweet spot for an insulated two-car garage: enough output to recover quickly after the door has been open, with controls you can reach from the floor.",
    "description": "Seventy-five hundred watts is where electric garage heat stops being a compromise for a typical two-car garage. At 240V the DR-975 puts out roughly 25,600 BTU per hour, which by our sizing rule covers an insulated 576-square-foot garage with a comfortable margin on a cold night, and it recovers noticeably faster than the 5,000-watt class after you have had the door up to pull a car in. It hangs from the ceiling or a wall on the included bracket, and five adjustable louvers let you point the airflow at the bench rather than letting it pool against the ceiling. The feature that matters most in daily use is the remote-controlled digital thermostat. Ceiling heaters with a dial on the housing get set once and forgotten, because nobody wants to fetch a ladder to adjust them. With the remote you can drop the set point to a frost-protection level when you leave and bring it back up when you walk in. The caveat is electrical, and it is not minor. At 31.25 amps this is a continuous load, and code sizes the circuit at 125 percent of that, which puts you on a 40-amp double-pole breaker with 8-gauge copper, not the 30-amp circuit that suits 5,000-watt heaters. If your panel has the capacity, this is the heater we would put in most insulated attached garages."
  },
  {
    "id": "modine-hot-dawg-hd45",
    "name": "Modine Hot Dawg HD45 Power Vented Garage Heater",
    "category": "Natural Gas or LP, 45,000 BTU Input",
    "badge": "Best Gas Heater",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 300,
    "pros": [
      "About 36,900 BTU per hour of delivered heat, which is what an uninsulated or cold-climate two-car garage actually needs",
      "Built-in power venter exhausts combustion gases outdoors through a sidewall or roof",
      "Mounts within 1 inch of the ceiling, preserving headroom for lifts and garage doors",
      "Aluminized steel heat exchanger with a 10-year warranty on that component",
      "Quiet propeller fan at 720 CFM moves heat to the floor instead of stratifying"
    ],
    "cons": [
      "Premium-priced, and installation needs a gas line, a vent penetration and a 115V connection",
      "Natural gas and propane are separate versions, so you must order the right one"
    ],
    "bottomLine": "The heater a contractor would put in a cold-climate garage: vented, quiet, and built to run for a decade or more.",
    "description": "If you live somewhere with real winters and your garage is not well insulated, electric heat gets expensive and underpowered quickly, and a vented gas unit heater becomes the sensible answer. The Hot Dawg is the one professionals tend to specify for residential garages, and the reasons are practical. Its 45,000 BTU input delivers roughly 36,900 BTU per hour of heat at around 82 percent thermal efficiency, which Modine sizes for a two to two-and-a-half car garage. A built-in power venter pushes combustion gases outside through a sidewall or the roof, so there is no carbon monoxide or water vapor dumped into the space, and the low-profile case installs just an inch from the ceiling on two angle brackets. That headroom matters if you have a car lift or a garage door track running nearby. Gas, electrical and flue connections can be switched to the other side by flipping the unit over, which simplifies fitting it into an awkward corner. The heat exchanger carries a 10-year warranty and the motor is permanently lubricated. The downsides are cost and installation. You are buying a premium appliance, then paying for a gas line, a vent penetration and a thermostat run, and in most places that work should be done by a licensed installer with a permit. For a garage you use most winter days, it pays back in comfort and running costs."
  },
  {
    "id": "mr-heater-big-maxx-mhu50ng",
    "name": "Mr. Heater Big Maxx MHU50NG 50,000 BTU Unit Heater",
    "category": "Natural Gas, LP Kit Included, 50,000 BTU",
    "badge": "Best Value Gas",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1300,
    "pros": [
      "50,000 BTU input rated for up to about 1,250 square feet, enough for most two- and three-car garages",
      "Ships for natural gas with a propane conversion kit in the box",
      "Spark ignition with a self-diagnostic control module, so there is no standing pilot to relight",
      "Vents vertically through the roof or horizontally through a sidewall",
      "Substantially less expensive than contractor-grade unit heaters of similar output"
    ],
    "cons": [
      "Needs at least 8 feet of clearance from the floor to the bottom of the heater",
      "Fan and cabinet are louder than the Modine, and the 3-year warranty is shorter"
    ],
    "bottomLine": "The most heat per dollar for a gas-plumbed garage, as long as your ceiling is high enough and you accept a louder fan.",
    "description": "The Big Maxx is the budget route into vented gas heat, and for a lot of garages it is the smarter buy than the Modine. The 50,000 BTU input is actually larger than the Hot Dawg HD45, and Mr. Heater rates it for about 1,250 square feet, which comfortably covers a typical two-car garage and stretches to a modest three-car one. It arrives set up for natural gas with a propane conversion kit included, which removes the risk of ordering the wrong version. Ignition is by spark with a self-diagnostic control module, so there is no standing pilot burning gas all summer. It vents vertically as a Category I appliance through the roof, or horizontally as a Category III appliance through a sidewall, and the sidewall route is usually the easier retrofit in an existing garage. Two limits decide whether it fits. First, it needs 8 feet of clearance between the floor and the base of the heater, which rules it out in some low-ceiling garages, particularly once a door opener is in the way. Second, it is simply a less refined appliance than the Modine: the fan is louder, the build is lighter, and the warranty is three years on parts and labor. None of that matters much in a hobby garage. Pair it with a proper wall thermostat, which it needs, and have the gas and vent work done to code."
  },
  {
    "id": "fahrenheat-fuh54-garage-heater",
    "name": "Fahrenheat FUH54 5000W Garage Heater",
    "category": "240V Hardwired Electric, 5,000W",
    "badge": "Best Budget Electric",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 2400,
    "pros": [
      "5,000 watts, about 17,000 BTU per hour, on a standard 30-amp 240V circuit",
      "Built-in thermostat with a wide 45 to 135 degree range",
      "Fan delay waits for the element to warm, so it does not blow cold air on start-up",
      "Ceiling bracket allows horizontal, vertical or angled airflow",
      "Simple, long-running design with very few parts to fail"
    ],
    "cons": [
      "Only enough output for about 500 square feet, which is a one-car or a well-insulated small two-car garage",
      "Thermostat dial is on the heater itself, so ceiling mounting makes adjusting it a ladder job"
    ],
    "bottomLine": "A durable, affordable heater for a one-car or small insulated two-car garage, provided you size it honestly.",
    "description": "The FUH54 has been hanging in garages for years because it does one job with very little to go wrong. It produces 5,000 watts, roughly 17,000 BTU per hour, from a 240V circuit, drawing just under 21 amps, which is why it sits comfortably on a 30-amp double-pole breaker with 10-gauge wire. The built-in thermostat runs from 45 to 135 degrees, a fan-delay control holds the fan off until the element is warm so you do not get a blast of cold air at start-up, and a high-limit cutout shuts it down if it overheats. The ceiling bracket lets you point the airflow straight down, horizontally or anywhere between, and its 270 CFM fan throws air about 16 feet, so aim it along the long axis of the garage rather than into a wall. Its honest limit is output. Fahrenheat rates it for about 500 square feet, and our sizing rule agrees for an insulated space: it suits a one-car garage, a small insulated two-car garage or a basement shop. In an uninsulated two-car garage in a northern winter it will take the edge off near the heater and not much more. The other annoyance is that the thermostat lives on the unit, so a ceiling-mounted heater means a ladder every time you change the setting. The NewAir G73 is a near-identical 5,000-watt alternative if this one is out of stock."
  },
  {
    "id": "dr-infrared-dr988-garage-heater",
    "name": "Dr. Infrared Heater DR-988 Garage Shop Heater",
    "category": "240V Plug-In Electric, 5,600W",
    "badge": "Best Plug-In 240V",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1900,
    "pros": [
      "Plugs into a NEMA 6-30 receptacle, so no hardwiring and it can move between garage and shop",
      "5,600 watts at 240V, about 19,100 BTU per hour, is more than most 5,000-watt units",
      "Built-in thermostat from 45 to 95 degrees with automatic overheat cut-off",
      "Steel housing with finger-proof grilles on both intake and discharge",
      "Works at 208V as well, at reduced output"
    ],
    "cons": [
      "Sits on the floor or a bench, where it collects sawdust and is closer to fuel vapors",
      "Output drops to about 4,200 watts on a 208V supply"
    ],
    "bottomLine": "The right pick if you rent, move the heater between spaces, or already have a 30-amp 240V outlet for a welder.",
    "description": "Not everyone can hardwire a ceiling heater, and not everyone wants to. Renters, people who move a heater between a garage and a detached shop, and anyone who already has a 30-amp 240V receptacle for a welder or compressor will get more use from the DR-988. It arrives with a heavy-duty 6-foot cord and a NEMA 6-30 plug, which matches the common 30-amp 240V outlet, and it delivers 5,600 watts, about 19,100 BTU per hour, at 240V. That is a little more than the 5,000-watt ceiling class, and Dr. Infrared rates it for up to 600 square feet. The built-in thermostat covers 45 to 95 degrees, and an overheat cut-off and finger-proof steel grilles front and back make it reasonably safe to have near a bench. Despite the brand name, this is a fan-forced heater, not a radiant infrared one, and it heats the air like any other unit on this list. Two things to know before buying. It is a floor unit, which puts it where sawdust and debris collect, so keep the intake clear, and it sits lower than a ceiling heater relative to anything that gives off flammable vapors, so keep it well away from fuel cans and solvent storage. And if your home has a 208V supply, which is common in some apartment and condo buildings, expect about 4,200 watts instead of 5,600."
  },
  {
    "id": "king-kb2410-eco2s-garage-heater",
    "name": "King KB2410 ECO2S 10,000W Garage Heater",
    "category": "240V Hardwired Electric, 10,000W, Two-Stage",
    "badge": "Best for Large Garages",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 400,
    "pros": [
      "10,000 watts, about 34,100 BTU per hour, covers up to roughly 1,000 square feet of insulated space",
      "Two-stage heat, so it runs at half output once the garage is warm",
      "Digital controls with remote, a 45 to 99 degree range and an ECO mode",
      "Throws air about 24 feet at 725 CFM, reaching the far end of a three-car garage",
      "Commercial-grade construction from a maker known for heavy-duty electric heat"
    ],
    "cons": [
      "Draws about 42 amps at 240V, which typically means a 60-amp circuit and 6-gauge wire",
      "Many older 100-amp services cannot spare that capacity without a load calculation or upgrade"
    ],
    "bottomLine": "The electric option for a big, insulated garage when gas is not available, if your service can carry the load.",
    "description": "When a garage is too big for 7,500 watts and there is no gas line, the next step is a 10-kilowatt heater, and King builds one of the better ones. The KB2410 puts out about 34,100 BTU per hour at 240V and King rates it for spaces up to about 1,000 square feet, which covers an insulated three-car garage or a long workshop. Its two-stage design is the practical advantage over a single-stage heater of the same size: it runs at full output to bring the space up to temperature, then drops to the lower stage to hold it, which reduces cycling and keeps the temperature steadier. The ECO2S versions add digital controls with a remote, a 45 to 99 degree thermostat range, a fan-only mode and an ECO setting, and the fan throws air about 24 feet at 725 CFM. Before ordering, check your electrical service. At 240V this heater draws about 41.6 amps, and because heaters are continuous loads the circuit is sized at 125 percent, which typically puts you on a 60-amp breaker with 6-gauge copper wire; confirm the exact figure in the installation manual for your model. On a 100-amp service with an electric range, dryer and water heater, there may simply not be room, and an electrician should run a load calculation before anything else. If your service can take it, it is a genuinely strong electric heater."
  },
  {
    "id": "mr-heater-big-buddy-mh18b",
    "name": "Mr. Heater Big Buddy MH18B Portable Propane Heater",
    "category": "Portable Propane, 4,000-18,000 BTU",
    "badge": "Best Portable",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 18000,
    "pros": [
      "Three settings from 4,000 to 18,000 BTU, rated for spaces up to about 450 square feet",
      "Oxygen depletion sensor and tip-over shut-off make it indoor-rated",
      "Runs on two 1-pound cylinders or a 20-pound tank with an optional hose and filter",
      "No electrical work at all, and it moves wherever you need it",
      "Radiant heat warms you and the bench directly, even with the door partly open"
    ],
    "cons": [
      "Unvented: every gallon of propane burned releases roughly 0.8 gallons of water vapor into the garage",
      "Too small to heat a whole two-car garage in real cold, and 1-pound cylinders run out quickly on high"
    ],
    "bottomLine": "The right tool for occasional weekend work in a small space; the wrong tool for daily heat or for curing a floor coating.",
    "description": "For someone who works in the garage a few weekends a winter, running a 240V circuit or a gas line is hard to justify, and the Big Buddy fills that gap well. It has three settings, 4,000, 9,000 and 18,000 BTU per hour, and Mr. Heater rates it for up to about 450 square feet. It runs on two 1-pound cylinders, or on a 20-pound tank with the optional hose, and on a big tank it becomes a surprisingly practical heat source. Its radiant ceramic burner warms the people and objects in front of it directly, which is why it feels effective even with the door cracked open. The safety features are real: an oxygen depletion sensor shuts it down if oxygen levels fall, and a tip-over switch cuts it off if it is knocked over. That said, it is an unvented heater, and you should understand what that means before using it in an attached garage. All the combustion products stay in the room, including carbon monoxide at low levels and a lot of water vapor, roughly 0.8 gallons for every gallon of propane burned. That moisture condenses on cold tools and car bodies, and it is exactly what you do not want when you are applying an epoxy floor coating. Keep a window cracked, run a carbon monoxide alarm, store spare cylinders outside, and treat it as spot heat rather than a way to heat the building."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Garage Heaters",
          item: "https://www.thehonestreviewers.com/best-garage-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size heater do I need for a two-car garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A typical two-car garage is about 576 square feet. If it is insulated, a 7,500-watt electric heater, about 25,600 BTU per hour, is a comfortable fit in most climates, and 5,000 watts is marginal. If it is uninsulated or you live somewhere very cold, plan on a 40,000 to 50,000 BTU vented gas heater instead."
          }
        },
        {
          "@type": "Question",
          "name": "Is a gas or electric garage heater cheaper to run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most areas natural gas is considerably cheaper per unit of heat than electricity, even after accounting for heat lost up the vent. Electric heaters cost less to buy and install if you have panel capacity, so they often make more sense in insulated garages used a few times a week. Use your own utility rates to compare."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug a garage heater into a regular outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can plug in a 1,500-watt 120V heater, but it will only warm a small area near you. Real garage heaters run on 240V. Some, like the Dr. Infrared DR-988, plug into a 30-amp NEMA 6-30 outlet, but most ceiling units must be hardwired to a dedicated double-pole breaker."
          }
        },
        {
          "@type": "Question",
          "name": "What breaker does a 7,500-watt heater need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At 240V a 7,500-watt heater draws 31.25 amps. Heaters are continuous loads, so the circuit is sized at 125 percent, about 39 amps. That puts you on a 40-amp double-pole breaker with 8-gauge copper wire in most cases. Confirm against the minimum circuit ampacity printed in your heater's installation manual."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to use a propane heater in an attached garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An indoor-rated propane heater with an oxygen depletion sensor, such as the Mr. Heater Big Buddy, can be used in a garage with ventilation. Crack a window or the door a few inches, keep a carbon monoxide alarm running, store spare cylinders outside and never leave it running unattended or while anyone is sleeping nearby."
          }
        },
        {
          "@type": "Question",
          "name": "How warm should I keep my garage in winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To protect paint, adhesives, batteries and water-based products from freezing, 40 to 45 degrees is enough. For working comfortably in a jacket, 50 to 55 degrees is usually fine. Holding a garage at living-room temperature costs far more than it is worth, so use a low set point when nobody is out there."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to heat my garage to apply floor epoxy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, if it is cold. Most garage floor epoxies need the slab and air at 50 to 60 degrees or warmer to cure properly. Heat the space for a day or two beforehand so the concrete warms through, check the slab with an infrared thermometer, and use electric or vented gas heat rather than an unvented propane heater."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home & Garage",
    tags: [
      "best garage heater",
      "electric garage heater",
      "natural gas garage heater",
      "240V garage heater",
      "garage heater sizing",
      "workshop heater"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Heaters Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Garage Heaters</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most garage heaters that disappoint were the wrong size or the wrong fuel for the building, not bad products. We sized, wired and ran each type so you can match one to your garage before you buy.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dr-infrared-dr975-garage-heater"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Size One
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How to Size a Garage Heater</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
