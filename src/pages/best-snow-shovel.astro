  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "7 Best Snow Shovels: Pushers, Scoops, Ergonomic and Wheeled Picks";
const description =
  "The best snow shovels by job: combo shovels, wide pushers, ergonomic second-handle designs, deep scoops and a wheeled pusher, chosen on blade, edge and handle.";

const PRODUCTS = [
  {
    "id": "true-temper-18-poly-combo-1627200",
    "name": "True Temper 18\" Poly Combo Snow Shovel/Pusher (1627200)",
    "badge": "Best Overall",
    "category": "Combo Shovel/Pusher, Poly Blade, Steel Wear Strip",
