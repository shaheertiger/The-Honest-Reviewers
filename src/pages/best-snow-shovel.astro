      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best type of snow shovel for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An 18-inch combo shovel with a steel wear strip suits most homes. It is narrow enough to lift a load of wet snow, curved enough to push light snow across pavement, and the strip protects the plastic edge on concrete. Add a wide pusher for a long, flat driveway, or a scoop if you often dig out cars or clear decks."
          }
        },
