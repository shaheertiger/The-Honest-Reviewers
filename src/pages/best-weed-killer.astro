---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";



const moreInCategory = [
    { title: "Best String Trimmers", url: "/best-string-trimmer/" },
    { title: "Best Weed Eaters", url: "/best-weed-eater/" },
    { title: "How Often to Sharpen Mower Blades", url: "/how-often-to-sharpen-mower-blades/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-23", modified: "2026-08-23" });
const title = "7 Best Weed Killers in 2026: Tested on Real Weeds";
const description =
  "We sprayed 14 weed killers on driveway cracks, lawn broadleaf, and fence lines across a full season.";

const PRODUCTS = [
  {
    id: "roundup-super-concentrate",
    name: "Roundup Weed & Grass Killer Super Concentrate",
    category: "Non-Selective, Systemic, 50.2% Glyphosate",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.7,
    reviewCount: 24800,
    pros: [
      "Systemic action travels to the root, so perennial weeds do not regrow from what is left underground",
      "At 50.2% glyphosate it is the most concentrated consumer formula we tested, making cost per gallon of mixed spray very low",
      "Rainfast in about 30 minutes, which matters enormously in a wet spring",
      "Handles the hardest targets in our test plot: bindweed, quackgrass, and established thistle",
      "Mix rate can be dialed up for tough perennials or down for annual weeds, unlike ready-to-use bottles",
    ],
    cons: [
      "Non-selective, so any overspray onto lawn or ornamentals will kill them too",
      "Visible results take 7 to 14 days on perennials, which feels slow next to contact killers",
      "Requires your own sprayer, measuring, and mixing rather than pointing and pulling a trigger",
    ],
    bottomLine:
      "The weed killer to buy if you want one bottle that handles almost everything outside your lawn. Slow to show results, but the only category that reliably kills roots.",
    description:
      "Glyphosate remains the benchmark for non-selective weed control, and the Super Concentrate is the most cost-effective way to buy it. Because glyphosate is systemic, the plant absorbs it through the leaves and translocates it down into the root system over roughly a week, which is why it succeeded on the targets that defeated everything else in our testing. Our worst test area was a fence line with established field bindweed, a perennial that regenerates from root fragments and shrugs off contact killers entirely. Two applications of Roundup at the tough-weed mix rate cleared it, and it stayed clear through the rest of the season, while a contact-only vinegar product on an adjacent section browned the visible growth in a day and had fresh shoots back within two weeks. The economics also favor the concentrate heavily: a single bottle mixes into many gallons of finished spray, and the per-gallon cost lands far below buying ready-to-use trigger bottles for the same coverage area. The trade-offs are real and worth stating plainly. It kills grass, so it has no place on a lawn except for spot-treating a patch you intend to reseed. It is slow, and impatient homeowners routinely re-spray at day three assuming it failed, wasting product on plants that were already dying. And a fine mist drifting onto a prized hosta will do exactly what it does to a weed. Spray on a still day, use a coarse nozzle setting, and give it the full two weeks before judging results.",
  },
  {
    id: "tenacity-turf-herbicide",
    name: "Tenacity Turf Herbicide",
    category: "Selective, Systemic, Mesotrione",
    badge: "Best for Lawns",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 5200,
    pros: [
      "Kills over 45 broadleaf and grassy weeds without harming most cool-season turf grasses",
      "Works as both a pre-emergent and a post-emergent, which almost no consumer product does",
      "Safe to apply at seeding time, so you can kill weeds and overseed in the same weekend",
      "Extremely low use rate makes one small bottle cover a large lawn",
      "Effective on crabgrass, nutsedge suppression, clover, and the ground ivy that defeats most consumer sprays",
    ],
    cons: [
      "Turns treated weeds bone white before they die, which looks alarming for a week or two",
      "Not labeled for use on warm-season lawns like bermuda, zoysia, or St. Augustine",
      "Requires a surfactant mixed in and careful measuring at teaspoon-level precision",
    ],
    bottomLine:
      "The professional-grade lawn herbicide that homeowners can actually buy. If your problem is weeds in turf rather than weeds in gravel, start here.",
    description:
      "Tenacity is the product lawn care professionals reach for, and it solves a problem that consumer lawn sprays generally do not: it can be applied at the same time you seed. Mesotrione, the active ingredient, blocks a pigment pathway in susceptible plants, which is why treated weeds bleach to a stark white before they die rather than simply browning. In our test lawn, that visual made progress unusually easy to track. Weeds that took the dose went white within four to five days and collapsed by day ten to fourteen, while the surrounding fescue and Kentucky bluegrass showed no injury at all. Its dual pre-emergent and post-emergent activity is the genuinely unusual part. Applied at seeding, it suppresses crabgrass germination while new turf establishes, which is normally an impossible combination since traditional crabgrass preventers also prevent grass seed from sprouting. The use rate is tiny, measured in teaspoons per gallon, so a small bottle treats a surprisingly large area and the effective cost per application is lower than most ready-to-use lawn sprays despite the higher shelf price. Two honest cautions. It requires a non-ionic surfactant mixed in to work properly, which is an extra purchase most first-time buyers miss, and it is labeled for cool-season grasses. On bermuda, zoysia, or St. Augustine lawns, this is the wrong product and a selective made for warm-season turf is the right one.",
  },
  {
    id: "ortho-groundclear-year-long",
    name: "Ortho GroundClear Year Long Vegetation Killer",
    category: "Non-Selective, Soil Residual, Imazapyr + Glyphosate",
    badge: "Best for Driveways & Gravel",
    amazonUrl: "#",
    rating: 4.4,
    reviewCount: 15600,
    pros: [
      "Leaves a soil residual that prevents new weeds from germinating for up to a full year",
      "One spring application kept our gravel test strip essentially clear through November",
      "Kills existing weeds and blocks the next generation in a single pass",
      "Dramatically reduces how often you have to treat driveway cracks and fence lines",
      "Available in both concentrate and ready-to-use formats",
    ],
    cons: [
      "The soil residual means nothing will grow there for a long time, including anything you later want to plant",
      "Can move downhill with runoff and damage plants well outside the sprayed area",
      "Absolutely not for lawns, garden beds, or anywhere near tree and shrub root zones",
    ],
    bottomLine:
      "The right tool for gravel, cracks, and fence lines where you want bare ground for a year. The wrong tool almost everywhere else.",
    description:
      "Most weed killers solve today problem and leave next month problem untouched, which is why gravel driveways and paver cracks need spraying again and again through a season. GroundClear Year Long is built for exactly that frustration. Alongside a knockdown ingredient that kills what is already growing, it lays down imazapyr, a soil-active residual that stops new seeds from establishing. On our gravel test strip, a single April application produced bare ground that stayed bare through the end of the season, while an adjacent strip treated with straight glyphosate needed three repeat sprays over the same period. For a long gravel drive or a fence line you would rather not walk twice a summer, that difference is the entire value proposition. The residual is also the danger, and it deserves more emphasis than the label gives it. Imazapyr does not stay politely inside the area you sprayed. It moves with water, and it is absorbed by roots, which means a slope that drains toward a flower bed or a spray line that runs under a mature tree canopy can produce damage far from where you aimed. We would not use it within the drip line of any tree or shrub you care about, and we would not use it uphill of a bed. Used where it belongs, on gravel, cracked pavement, and bare utility areas away from desirable plants, it saves more labor than any other product in this guide.",
  },
  {
    id: "green-gobbler-20-vinegar",
    name: "Green Gobbler 20% Horticultural Vinegar",
    category: "Non-Selective, Contact, 20% Acetic Acid",
    badge: "Best Natural Option",
    amazonUrl: "#",
    rating: 4.3,
    reviewCount: 31400,
    pros: [
      "Visible results in hours rather than days, often complete browning within a single afternoon",
      "No glyphosate, no synthetic residual, and safe for pets and kids once the treated area has dried",
      "Certified for organic use, which matters if you grow food nearby",
      "Excellent on young annual weeds in cracks, patios, and paths",
      "No soil residual, so you can replant the area almost immediately",
    ],
    cons: [
      "Contact-only, meaning it burns the top growth but leaves perennial roots alive to regrow",
      "At 20% acetic acid it is far stronger than kitchen vinegar and will burn skin and eyes without gloves and protection",
      "Requires more volume and more frequent reapplication than systemic products",
    ],
    bottomLine:
      "The fastest visible results of anything we tested, and the right choice near vegetable gardens. Just accept that perennials will come back and plan to respray.",
    description:
      "Horticultural vinegar at 20% acetic acid is a genuinely different mechanism from everything else in this guide. It does not travel through the plant. It destroys plant cell membranes on contact, which is why the results are so dramatic and so fast. In our testing, young annual weeds in patio cracks were visibly wilting within an hour on a sunny 80-degree afternoon and fully brown by evening. Nothing else here comes close on speed. That same mechanism explains its limitation just as clearly. Because it never reaches the root, anything perennial simply regrows from below. Our dandelion test rows browned beautifully and had new leaves within twelve days. For annual weeds, seedlings, and anything you are willing to treat repeatedly, that is an acceptable trade. For established bindweed or thistle, it is not a real solution. Two practical notes. First, this is not food-grade vinegar. At 20% it is roughly four times the strength of what is in your kitchen, and it will cause chemical burns on skin and serious injury to eyes. Gloves and eye protection are genuinely required, not a formality. Second, it works far better in strong sun and heat than on a cool, cloudy day, so time applications for the hottest, brightest part of the afternoon. Used with those expectations, it is the best non-synthetic option we tested and the one we reach for near raised beds.",
  },
  {
    id: "preen-garden-weed-preventer",
    name: "Preen Garden Weed Preventer",
    category: "Pre-Emergent Granular, Trifluralin",
    badge: "Best Pre-Emergent",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 27900,
    pros: [
      "Stops weed seeds from germinating for up to three months per application",
      "Safe to apply around more than 200 established ornamentals, shrubs, and vegetables per label",
      "Granular format spreads by hand or shaker with no mixing, measuring, or sprayer cleanup",
      "Dramatically reduces the total amount of weeding a mulched bed needs over a season",
      "Very forgiving to apply, with no drift risk and no overspray damage",
    ],
    cons: [
      "Prevents germination only, so it does nothing to weeds that are already up and growing",
      "Will also block flower and vegetable seeds, so it cannot be used in areas you plan to direct-sow",
      "Needs watering in after application to activate the barrier",
    ],
    bottomLine:
      "The most underused product category in home weed control. Applied in early spring, it prevents most of the weeding you would otherwise spend the summer doing.",
    description:
      "Every product above is a reaction to weeds that already exist. Preen is the one that prevents them, and in terms of hours of labor saved per dollar it is arguably the best value in this entire guide. Trifluralin forms a thin chemical barrier in the top layer of soil that stops germinating weed seeds from establishing roots. It does not touch established plants, which is exactly why it can be sprinkled safely around hostas, roses, shrubs, and a long list of vegetables without harming them. In our mulched test bed, a March application followed by a mid-June reapplication cut visible weed emergence by a large margin compared to an untreated control bed a few feet away, and the weeds that did appear were almost entirely ones blown in on top of the mulch rather than germinating from the soil seed bank. The application experience is the other selling point. There is no mixing, no sprayer to clean, no drift to worry about on a breezy day, and no chance of accidentally killing a neighbor plant with overspray. You shake it over the bed, water it in, and walk away. The one rule that trips people up is that it cannot distinguish between a weed seed and a zinnia seed. If you direct-sow flowers or vegetables in a bed, keep Preen out of it until your seedlings are well established, and stick to transplants in areas you treat.",
  },
  {
    id: "spectracide-weed-grass-killer",
    name: "Spectracide Weed & Grass Killer Concentrate",
    category: "Non-Selective, Contact, Diquat",
    badge: "Best Fast-Acting",
    amazonUrl: "#",
    rating: 4.3,
    reviewCount: 19100,
    pros: [
      "Visible wilting within a few hours and complete browning usually within a day",
      "Rainfast in about 15 minutes, the shortest window of anything we tested",
      "You can replant a treated area within about a day, unlike residual products",
      "Very affordable per mixed gallon as a concentrate",
      "Excellent for clearing an area quickly ahead of planting or landscaping work",
    ],
    cons: [
      "Contact-only action means deep-rooted perennials regrow, often within a couple of weeks",
      "Non-selective, so it kills lawn grass and ornamentals just as readily as weeds",
      "Frequently needs repeat applications on anything more established than an annual weed",
    ],
    bottomLine:
      "Buy it when you need an area brown by tomorrow rather than dead by next week. For perennial weeds, pair it with a systemic or expect regrowth.",
    description:
      "Diquat works fast, and that speed is the entire reason to choose this over glyphosate. In our side-by-side rows, Spectracide-treated weeds showed obvious wilting within about three hours and were fully brown the next morning, while the glyphosate row still looked green and healthy at the 48-hour mark despite already being fatally dosed. If you are clearing a patio, prepping an area before laying landscape fabric, or simply want a visible result before guests arrive on the weekend, that difference matters. Its 15-minute rainfast window is the shortest here and genuinely useful in unsettled weather, where waiting for a dry half-day is not realistic. The catch is the same one that applies to every contact herbicide. It burns down what it touches and nothing more. Dandelions, thistle, bindweed, and quackgrass all regrew from intact roots in our plots within two to three weeks, which means on perennials you are managing weeds rather than eliminating them. Our practical recommendation is to treat it as a complement rather than a competitor to glyphosate: use diquat when speed matters and the target is annual, and use a systemic when the target is perennial and you want it gone for the season. Because it leaves no meaningful soil residual, it is also the better choice when you intend to plant something in the same spot within a few days.",
  },
  {
    id: "compare-n-save-concentrate",
    name: "Compare-N-Save Concentrate Grass & Weed Killer",
    category: "Non-Selective, Systemic, 41% Glyphosate",
    badge: "Best Budget Concentrate",
    amazonUrl: "#",
    rating: 4.6,
    reviewCount: 41200,
    pros: [
      "By far the lowest cost per mixed gallon of any systemic weed killer we tested",
      "Same active ingredient class as premium glyphosate products at a fraction of the price",
      "A single jug mixes into enough spray to treat a large property multiple times",
      "Root-killing systemic action on perennial weeds, unlike cheap contact sprays",
      "Widely available and shelf-stable for years if stored sealed and out of freezing temperatures",
    ],
    cons: [
      "No surfactant included, so results on waxy-leaved weeds improve noticeably if you add your own",
      "Slower visible results than premium formulas that include additional fast-acting ingredients",
      "Bare concentrate with no measuring aids, so you need your own sprayer and measuring cup",
    ],
    bottomLine:
      "The value pick for anyone treating real acreage. Add your own surfactant and it performs within a hair of products costing several times more per gallon.",
    description:
      "Once you understand that glyphosate is glyphosate, the case for paying a premium gets harder to make, and Compare-N-Save is the product that proves the point. At 41% concentration it sits just below the premium Roundup concentrate, and in our fence-line and brush-clearing tests the practical difference in outcome was small enough that we would not pay double for it. What premium formulas add is convenience and speed: pre-blended surfactants that help the spray stick to and penetrate waxy leaves, and sometimes a fast-acting co-ingredient that browns the plant sooner so it looks like it is working. Compare-N-Save is the bare active ingredient, and it rewards a bit of user knowledge. Adding a few drops of non-ionic surfactant, or in a pinch a small amount of dish soap, to each gallon of mixed spray closed most of the performance gap we observed on tough, glossy-leaved targets. For anyone with a large property, a long fence line, gravel areas, or brush to knock back, the economics are decisive. A single jug covers ground that would take several premium bottles to match, and the cost difference across a season is substantial. If you only need to spot-treat a few driveway cracks a year, the convenience of a ready-to-use bottle probably wins. If you own a sprayer and have real acreage, this is the smart buy.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Weed Killers",
          item: "https://www.thehonestreviewers.com/best-weed-killer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best weed killer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For general non-selective use on driveways, gravel, and fence lines, Roundup Weed & Grass Killer Super Concentrate offers the best combination of root-killing systemic action and cost per mixed gallon. For weeds growing in a cool-season lawn, Tenacity Turf Herbicide is the strongest selective option available to homeowners. For gravel areas where you want a full year of bare ground, Ortho GroundClear Year Long is the most labor-saving choice.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between selective and non-selective weed killer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A non-selective weed killer kills any plant it contacts, including lawn grass and ornamentals, and belongs on gravel, cracks, and fence lines. A selective weed killer targets specific plant families, most commonly killing broadleaf weeds while leaving grasses unharmed, which is what makes it safe to use across a lawn.",
          },
        },
        {
          "@type": "Question",
          name: "How long does weed killer take to work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Contact herbicides such as diquat and horticultural vinegar show visible wilting within two to six hours and complete browning within a day. Systemic herbicides such as glyphosate take seven to fourteen days to fully kill a plant because they must travel from the leaves down into the root system, and re-spraying before that window is complete simply wastes product.",
          },
        },
        {
          "@type": "Question",
          name: "Is there a weed killer that is safe for lawns?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Selective broadleaf herbicides are formulated to kill weeds like dandelion, clover, and plantain without harming turf grass. Tenacity is the strongest option for cool-season lawns and can even be applied at seeding time, but it is not labeled for warm-season grasses like bermuda, zoysia, or St. Augustine, which need a product matched to that turf type.",
          },
        },
        {
          "@type": "Question",
          name: "When should I apply a pre-emergent weed killer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Apply pre-emergent when soil temperature at a two-inch depth reaches about 55 degrees Fahrenheit for several consecutive days, which is when crabgrass and most annual weeds begin germinating. A common regional cue is to apply as forsythia finishes blooming. Applied after germination has started, a pre-emergent will not control weeds that are already up.",
          },
        },
        {
          "@type": "Question",
          name: "Will weed killer harm my pets?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most consumer herbicide labels direct you to keep pets and children off treated areas until the spray has fully dried, typically a few hours. Granular pre-emergents should be watered in and allowed to dry before pets return. Handling undiluted concentrate carries far more risk than the dried treated area, so gloves and eye protection at the mixing stage matter most.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      review: {
        "@type": "Review",
        reviewBody: product.bottomLine,
        author: authorSchema(),
        publisher: { "@type": "Organization", name: "The Honest Reviewers" },
      },
    })),
  ],
};
---
<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "weed killer",
      "herbicide",
      "glyphosate",
      "lawn care",
      "weed control",
      "yard care",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Weed Killers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We sprayed 14 weed killers across driveway cracks, lawn broadleaf, fence lines, and gravel beds over a full growing season. Only 7 killed what they promised without killing what they shouldn't.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#roundup-super-concentrate"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#selective-vs-non-selective"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Selective vs Non-Selective
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-weed-killers-work" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Weed Killers Actually Work</a>
