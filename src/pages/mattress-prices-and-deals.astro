                    <td class="px-4 py-4 text-gray-700">First big brand sale of the year</td>
                    <td class="px-4 py-4 text-gray-700">Yes, if buying in winter</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Memorial Day</td>
                    <td class="px-4 py-4 text-gray-700">Late May</td>
                    <td class="px-4 py-4 text-gray-700">Major brand-site promotions</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">July 4 / Prime Day</td>
                    <td class="px-4 py-4 text-gray-700">July</td>
                    <td class="px-4 py-4 text-gray-700">Brand sales plus Amazon member deals</td>
                    <td class="px-4 py-4 text-gray-700">Yes, compare both channels</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Labor Day</td>
                    <td class="px-4 py-4 text-gray-700">Early September</td>
                    <td class="px-4 py-4 text-gray-700">End-of-summer brand promotions</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Prime Big Deal Days</td>
                    <td class="px-4 py-4 text-gray-700">October (recent years)</td>
                    <td class="px-4 py-4 text-gray-700">Amazon member deals</td>
                    <td class="px-4 py-4 text-gray-700">Often</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Black Friday / Cyber Monday</td>
                    <td class="px-4 py-4 text-gray-700">Late November</td>
                    <td class="px-4 py-4 text-gray-700">Often the year's strongest offers</td>
