import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Mattresses",
    "url": "/best-mattress/"
  },
  {
    "title": "Best Mattress Brands",
    "url": "/best-mattress-brands/"
  },
  {
    "title": "Best Mattress for Back Pain",
    "url": "/best-mattress-for-back-pain/"
  },
  {
    "title": "Best Mattress for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattress Topper",
    "url": "/best-mattress-topper/"
  },
  {
    "title": "Best Mattress Protector",
    "url": "/best-mattress-protector/"
  },
  {
    "title": "Best Mattress for Heavy People",
    "url": "/best-mattress-for-heavy-people/"
  },
  {
    "title": "Best Mattress for Seniors",
    "url": "/best-mattress-for-seniors/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "Mattress Deals: When Mattresses Go on Sale and What to Pay";
const description =
  "Mattress prices by type and size, the US sale calendar, how to spot a fake discount, and what trial periods, returns and warranties really cover before you buy.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Mattress Deals",
          item: "https://www.thehonestreviewers.com/mattress-prices-and-deals/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best mattress deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best mattress deal is a price below what that specific model usually sells for, on the size you need, with a trial and return policy you can actually use. Holiday windows such as Memorial Day, Labor Day and Black Friday tend to bring the lowest prices. For product picks rather than deals, start with our best mattress guide."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to buy a mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Major US holiday weekends are the best times: Presidents' Day, Memorial Day, July 4, Labor Day and Black Friday through Cyber Monday. Amazon's Prime Day in July and Prime Big Deal Days in the fall also bring discounts on mattresses sold there. Prices between those windows often drift back up toward their usual level."
          }
        },
        {
          "@type": "Question",
          "name": "How much should I spend on a mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Very roughly, a decent queen foam mattress can cost a few hundred dollars, a mid-range foam or hybrid commonly sits in the high hundreds to around two thousand, and latex or adjustable air beds cost more. Prices vary by size and retailer. Spend enough to get the support your body weight and sleep position need."
          }
        },
        {
          "@type": "Question",
          "name": "Are mattress sales real?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some are and some are not. Many brands keep a permanent promotion running, so the sale price is effectively the regular price. A sale is real when the price drops below what the same model has sold for over recent months. Check price history or the brand page over several weeks before trusting the banner."
          }
        },
        {
          "@type": "Question",
          "name": "Can you return a mattress bought on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes, but the terms depend on the listing. Amazon's return window and the brand's own sleep trial are not always the same thing. Check the return policy on the listing before buying, and confirm with the brand whether its full trial applies to Amazon orders. Keep the order details and the law label."
          }
        },
        {
          "@type": "Question",
          "name": "Do mattress warranties cover sagging?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, but only beyond a set depth, commonly around an inch to an inch and a half measured with no weight on the bed. Shallower softening is treated as normal wear. Warranties also typically require proper foundation support and a clean, unstained mattress, so a protector and a suitable frame help keep coverage valid."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

