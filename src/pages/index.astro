---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import { CATEGORIES } from '../data/constants';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Honest Reviewers',
  url: 'https://www.thehonestreviewers.com',
  description: 'Unbiased, expert-led men\'s grooming and lifestyle product reviews.',
};
---
<Layout jsonLd={siteSchema}>
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-24 lg:pt-32 lg:pb-40 bg-gradient-to-br from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-8 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block mb-4">
              <TrustBadge />
            </div>
            <h1 class="text-5xl lg:text-7xl font-black tracking-tight text-[#333333] mb-6 leading-[1.1]">
              Stop Guessing. <br />
              <span class="text-[#1E90FF]">Start Buying Smarter.</span>
            </h1>
            <p class="text-xl text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
              The Honest Reviewers test thousands of products every year so you can find the perfect match for your life and budget.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/best-of/"
                class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transition-all no-underline"
              >
                View Best of 2026
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
              <button class="bg-white hover:bg-gray-50 text-[#333333] border-2 border-gray-200 px-8 py-4 rounded-xl font-bold text-lg shadow-sm">
                How We Test
              </button>
            </div>
          </div>
          <div class="mt-16 lg:mt-0 relative">
            <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#1E90FF]/10 rounded-full blur-3xl"></div>
            <div class="relative bg-white p-2 rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
              <img
                src="https://picsum.photos/seed/gadget/1200/800"
                alt="Review Showcase"
                class="w-full h-auto rounded-xl object-cover"
              />
              <div class="absolute bottom-6 left-6 right-6">
                <div class="bg-white/90 backdrop-blur p-4 rounded-xl border border-white/50 shadow-lg flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold text-[#1E90FF] uppercase">#1 Guide</p>
                    <h2 class="font-bold text-gray-900">Best Men's Back Shavers 2026</h2>
                  </div>
                  <a
                    href="/best-mens-back-shavers/"
                    class="bg-[#FF4500] text-white p-2 rounded-lg no-underline"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Categories -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Trending Categories
        </h2>
        <button class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {CATEGORIES.map(cat => (
          <div
            class="group cursor-pointer bg-white border border-gray-100 p-8 rounded-3xl text-center hover:border-[#1E90FF] hover:shadow-xl transition-all"
          >
            <span class="text-5xl block mb-6 transform group-hover:scale-110 transition-transform">{cat.icon}</span>
            <h3 class="font-bold text-lg group-hover:text-[#1E90FF]">{cat.name}</h3>
            <p class="text-gray-400 text-sm mt-2">120+ Reviews</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Best-Of Guides -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF4500]"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Best-Of Buying Guides
        </h2>
        <a href="/best-of/" class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1 no-underline">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>

      <!-- Featured Guide Card: Back Shavers -->
      <div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-3xl overflow-hidden shadow-2xl border border-gray-700">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

          <!-- Left: Content -->
          <div class="p-10 lg:p-14 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-6">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
                  #1 Guide — Grooming
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
                  Updated Feb 2026
                </span>
              </div>

              <h3 class="text-3xl lg:text-4xl font-black text-white leading-tight mb-4">
                4 Best Men's Back Shavers:<br/>
                <span class="text-[#1E90FF]">Tested &amp; Ranked</span>
              </h3>

              <p class="text-gray-400 text-lg leading-relaxed mb-8">
                We bought and tested 12+ back shavers over 90 days — counting nicks, measuring shave closeness, and verifying live Amazon data. Only 4 made the cut.
              </p>

              <!-- Stats row -->
              <div class="grid grid-cols-3 gap-4 mb-8">
                <div class="text-center bg-white/5 rounded-2xl p-4 border border-white/10">
                  <p class="text-2xl font-black text-[#1E90FF]">12+</p>
                  <p class="text-gray-500 text-xs mt-1">Shavers Tested</p>
                </div>
                <div class="text-center bg-white/5 rounded-2xl p-4 border border-white/10">
                  <p class="text-2xl font-black text-[#1E90FF]">90</p>
                  <p class="text-gray-500 text-xs mt-1">Days Testing</p>
                </div>
                <div class="text-center bg-white/5 rounded-2xl p-4 border border-white/10">
                  <p class="text-2xl font-black text-[#1E90FF]">4</p>
                  <p class="text-gray-500 text-xs mt-1">Top Picks</p>
                </div>
              </div>
            </div>

            <a
              href="/best-mens-back-shavers/"
              class="inline-flex items-center justify-center gap-2 bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-black text-lg shadow-lg shadow-[#FF4500]/25 transition-all transform hover:-translate-y-0.5 no-underline w-full sm:w-auto text-center"
            >
              Read the Full Guide
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>

          <!-- Right: Product picks preview -->
          <div class="bg-white/5 border-l border-white/10 p-10 lg:p-14 flex flex-col justify-center gap-4">
            <p class="text-gray-400 text-xs font-black uppercase tracking-widest mb-2">Our 4 Top Picks</p>

            {[
              { rank: 1, name: 'Mangroomer Ultimate Pro', badge: 'Best Overall', price: '$49.99' },
              { rank: 2, name: 'Bro Shaver 3.0', badge: 'Best Budget', price: '$13.99' },
              { rank: 3, name: 'BAKblade 2.0 ELITE PLUS', badge: 'Smoothest Shave', price: '$34.95' },
              { rank: 4, name: 'Philips Norelco Bodygroom 5000', badge: 'Sensitive Skin', price: '$59.96' },
            ].map((pick) => (
              <div class="flex items-center gap-4 bg-white/5 hover:bg-white/10 transition-colors rounded-2xl p-4 border border-white/10">
                <span class={`text-2xl font-black shrink-0 ${pick.rank === 1 ? 'text-[#FF4500]' : 'text-gray-600'}`}>
                  #{pick.rank}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-white text-sm truncate">{pick.name}</p>
                  <span class="text-xs text-[#1E90FF] font-bold">{pick.badge}</span>
                </div>
                <span class="text-white font-black text-sm shrink-0">{pick.price}</span>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gray-900 rounded-3xl p-10 lg:p-14 text-white">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-black mb-3">Trusted by Real Buyers</h2>
          <p class="text-gray-400 max-w-xl mx-auto">Our reviews are backed by hands-on testing and verified community data from Reddit, Amazon, and expert forums.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-4xl font-black text-[#FF4500]">2,400+</p>
            <p class="text-gray-400 text-sm mt-1">Hours of Testing</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#1E90FF]">45+</p>
            <p class="text-gray-400 text-sm mt-1">Products Reviewed</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#FF4500]">50k+</p>
            <p class="text-gray-400 text-sm mt-1">Weekly Readers</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#1E90FF]">$0</p>
            <p class="text-gray-400 text-sm mt-1">Free Samples Accepted</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We're Different -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">How We're Different From Other Review Sites</h2>
        <p class="text-gray-500 mt-3 max-w-2xl mx-auto">Most "review" sites never touch the products they recommend. We're not most sites.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="relative bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow overflow-hidden">
          <img
            src="/images/guides/hands-on-testing.png"
            alt="Hands-on product testing in our review lab"
            class="w-full h-40 object-cover rounded-2xl mb-6"
            loading="lazy"
          />
          <h3 class="font-bold text-xl mb-3">We Buy Everything</h3>
          <p class="text-gray-600 leading-relaxed">
            Every product on our site was purchased with our own money at full retail price. No manufacturer samples, no sponsored placements. This eliminates the unconscious bias that comes with free products.
          </p>
        </div>
        <div class="relative bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow overflow-hidden">
          <img
            src="/images/guides/data-analysis.png"
            alt="Data-driven analysis of product performance metrics"
            class="w-full h-40 object-cover rounded-2xl mb-6"
            loading="lazy"
          />
          <h3 class="font-bold text-xl mb-3">Data Over Opinions</h3>
          <p class="text-gray-600 leading-relaxed">
            We measure, time, and quantify everything. Shave closeness in millimeters. Battery life in actual minutes. Real-world performance metrics that you can compare objectively — not vague "feels great" language.
          </p>
        </div>
        <div class="relative bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow overflow-hidden">
          <img
            src="/images/guides/community-reviews.png"
            alt="Community-verified reviews from Reddit and forums"
            class="w-full h-40 object-cover rounded-2xl mb-6"
            loading="lazy"
          />
          <h3 class="font-bold text-xl mb-3">Community Verified</h3>
          <p class="text-gray-600 leading-relaxed">
            We cross-reference our findings with thousands of Reddit threads, Amazon verified reviews, and specialty forums. If the community disagrees with our testing, we investigate why — and update our rankings accordingly.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Blog Content -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Latest from the Blog
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <a href="/the-brutal-truth-about-back-hair/" class="group bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-xl transition-all no-underline">
          <div class="relative aspect-video overflow-hidden">
            <img
              src="/images/guides/back-hair-truth.png"
              alt="The Brutal Truth About Back Hair article"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-[#FF4500] text-white px-3 py-1 rounded-full text-xs font-black uppercase">Trending</span>
            </div>
          </div>
          <div class="p-6">
            <p class="text-xs font-bold text-[#1E90FF] uppercase tracking-widest mb-2">Grooming Guide</p>
            <h3 class="text-xl font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
              The Brutal Truth About Back Hair: Why Ignoring It Is Destroying Your Confidence
            </h3>
            <p class="text-gray-500 text-sm">
              50%+ of men have back hair. Only 24% groom it regularly. We break down the science, the myths, and the 5-minute fix.
            </p>
          </div>
        </a>
        <a href="/best-mens-back-shavers/" class="group bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-xl transition-all no-underline">
          <div class="relative aspect-video overflow-hidden">
            <img
              src="/images/guides/shaver-comparison.png"
              alt="Best Men's Back Shavers 2026 comparison guide"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-[#1E90FF] text-white px-3 py-1 rounded-full text-xs font-black uppercase">#1 Guide</span>
            </div>
          </div>
          <div class="p-6">
            <p class="text-xs font-bold text-[#FF4500] uppercase tracking-widest mb-2">Complete Rankings</p>
            <h3 class="text-xl font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
              8 Best Men's Back Shavers (2026): Reddit's Top Picks Tested & Ranked
            </h3>
            <p class="text-gray-500 text-sm">
              120 days of testing. 8 shavers. Real Reddit data. Only one earned our "Best Overall" badge.
            </p>
          </div>
        </a>
        <a href="/buzz-cut-guide/" class="group bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-xl transition-all no-underline">
          <div class="relative aspect-video overflow-hidden">
            <img
              src="/images/buzz-cut/buzz-cut-hero.svg"
              alt="Complete buzz cut guide for men 2026"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-black uppercase">New</span>
            </div>
          </div>
          <div class="p-6">
            <p class="text-xs font-bold text-[#1E90FF] uppercase tracking-widest mb-2">Hair Guide</p>
            <h3 class="text-xl font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
              What Is a Buzz Cut? The Complete Men's Guide for 2026
            </h3>
            <p class="text-gray-500 text-sm">
              Guards, face shapes, DIY tutorial, styling tips, growing out, bleaching — everything you need to know.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- Trust Builders -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1E90FF] rounded-[3rem] p-12 lg:p-20 relative overflow-hidden text-white">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
        </div>
        <div class="max-w-3xl relative z-10">
          <h2 class="text-4xl lg:text-5xl font-black mb-8 leading-tight">Our Integrity is Our Only Inventory.</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-xl mb-2">100% In-House Testing</h3>
              <p class="text-white/80 leading-relaxed">We buy every product we review. No freebies, no bias, just raw data and real experience.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Verified Experts</h3>
              <p class="text-white/80 leading-relaxed">Our team consists of engineers, former chefs, and certified fitness trainers — real specialists in their fields.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Reddit Cross-Referenced</h3>
              <p class="text-white/80 leading-relaxed">Every recommendation is validated against thousands of Reddit threads and community discussions to ensure real-world accuracy.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Updated Monthly</h3>
              <p class="text-white/80 leading-relaxed">Prices, availability, and rankings are refreshed monthly against live Amazon data. No stale recommendations.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
