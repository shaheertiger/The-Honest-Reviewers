---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import UrgencyTimer from '../components/UrgencyTimer';
import { PRODUCTS, CATEGORIES } from '../data/constants';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Expert Product Reviews',
  description: 'Top-rated products reviewed and tested by our expert team.',
  itemListElement: PRODUCTS.map((product, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      image: product.imageUrl,
      description: product.description,
      brand: { '@type': 'Brand', name: product.brand },
      offers: {
        '@type': 'Offer',
        price: product.price,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: product.amazonUrl,
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
        bestRating: 5,
        worstRating: 1,
      },
    },
  })),
};
---
<Layout jsonLd={itemListSchema}>
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-24 lg:pt-32 lg:pb-40 bg-gradient-to-br from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-8 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block mb-4">
              <TrustBadge />
            </div>
            <h1 class="text-5xl lg:text-7xl font-black tracking-tight text-[#333333] mb-6 leading-[1.1]">
              Stop Guessing. <br />
              <span class="text-[#1E90FF]">Start Buying Smarter.</span>
            </h1>
            <p class="text-xl text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
              The Honest Reviewers test thousands of products every year so you can find the perfect match for your life and budget.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/best-of"
                class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transition-all no-underline"
              >
                View Best of 2026
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
              <button class="bg-white hover:bg-gray-50 text-[#333333] border-2 border-gray-200 px-8 py-4 rounded-xl font-bold text-lg shadow-sm">
                How We Test
              </button>
            </div>
          </div>
          <div class="mt-16 lg:mt-0 relative">
            <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#1E90FF]/10 rounded-full blur-3xl"></div>
            <div class="relative bg-white p-2 rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
              <img
                src="https://picsum.photos/seed/gadget/1200/800"
                alt="Review Showcase"
                class="w-full h-auto rounded-xl object-cover"
              />
              <div class="absolute bottom-6 left-6 right-6">
                <div class="bg-white/90 backdrop-blur p-4 rounded-xl border border-white/50 shadow-lg flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold text-[#1E90FF] uppercase">Latest Review</p>
                    <h3 class="font-bold text-gray-900">UltraVision Pro OLED 4K</h3>
                  </div>
                  <a
                    href="/review/p1"
                    class="bg-[#FF4500] text-white p-2 rounded-lg no-underline"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Categories -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Trending Categories
        </h2>
        <button class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {CATEGORIES.map(cat => (
          <div
            class="group cursor-pointer bg-white border border-gray-100 p-8 rounded-3xl text-center hover:border-[#1E90FF] hover:shadow-xl transition-all"
          >
            <span class="text-5xl block mb-6 transform group-hover:scale-110 transition-transform">{cat.icon}</span>
            <h3 class="font-bold text-lg group-hover:text-[#1E90FF]">{cat.name}</h3>
            <p class="text-gray-400 text-sm mt-2">120+ Reviews</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured Reviews -->
    <section class="bg-gray-50 py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <UrgencyTimer client:load />
          <h2 class="text-4xl font-bold mt-6">Expert Verdicts: Top Picks Today</h2>
          <p class="text-gray-500 mt-4 text-lg max-w-2xl mx-auto">
            We've spent 2,400+ hours testing these products to ensure they deliver exactly what they promise.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {PRODUCTS.map(product => (
            <div
              class="bg-white rounded-3xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-2xl transition-all group"
            >
              <div class="relative aspect-[16/9] overflow-hidden">
                <img src={product.imageUrl} alt={product.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute top-4 left-4 flex gap-2">
                  {product.badges?.map(badge => (
                    <span class="bg-white/90 backdrop-blur px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest text-[#1E90FF] border border-[#1E90FF]/20 shadow-sm">
                      {badge}
                    </span>
                  ))}
                </div>
              </div>
              <div class="p-8">
                <div class="flex items-center gap-1 text-[#FFB800] mb-2">
                  {[...Array(5)].map((_, i) => (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill={i < Math.floor(product.rating) ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  ))}
                  <span class="text-gray-400 text-xs ml-2 font-bold">{product.reviewCount.toLocaleString()} Verified Reviews</span>
                </div>
                <h3 class="text-2xl font-bold mb-3">{product.name}</h3>
                <p class="text-gray-600 mb-6 line-clamp-2">{product.description}</p>

                <div class="flex items-center justify-between pt-6 border-t border-gray-100">
                  <div>
                    <span class="text-3xl font-black text-[#333333]">${product.price}</span>
                    <p class="text-xs text-green-600 font-bold uppercase tracking-widest">In Stock - Ships Fast</p>
                  </div>
                  <a
                    href={`/review/${product.id}`}
                    class="bg-[#333333] hover:bg-black text-white px-6 py-3 rounded-xl font-bold transition-all no-underline"
                  >
                    Read Full Review
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Trust Builders -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1E90FF] rounded-[3rem] p-12 lg:p-20 relative overflow-hidden text-white">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
        </div>
        <div class="max-w-2xl relative z-10">
          <h2 class="text-4xl lg:text-5xl font-black mb-8 leading-tight">Our Integrity is Our Only Inventory.</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div>
              <h4 class="font-bold text-xl mb-2">100% In-House Testing</h4>
              <p class="text-white/80 leading-relaxed">We buy every product we review. No freebies, no bias, just raw data and real experience.</p>
            </div>
            <div>
              <h4 class="font-bold text-xl mb-2">Verified Experts</h4>
              <p class="text-white/80 leading-relaxed">Our team consists of engineers, former chefs, and certified fitness trainers.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
