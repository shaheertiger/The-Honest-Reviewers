---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Driveway Crack Filler",
    "url": "/best-driveway-crack-filler/"
  },
  {
    "title": "Best Concrete Driveway Sealers",
    "url": "/best-concrete-driveway-sealer-reviews/"
  },
  {
    "title": "Best Concrete Sealer",
    "url": "/best-concrete-sealer/"
  },
  {
    "title": "Driveway Crack Repair",
    "url": "/driveway-crack-repair/"
  },
  {
    "title": "Fill Driveway Cracks Before Sealing",
    "url": "/fill-driveway-cracks-before-sealing/"
  },
  {
    "title": "Best Asphalt Crack Filler",
    "url": "/best-asphalt-crack-filler/"
  },
  {
    "title": "How to Seal a Concrete Driveway",
    "url": "/how-to-seal-a-concrete-driveway/"
  },
  { title: "Concrete Leveling Cost", url: "/concrete-leveling-cost/" },
  { title: "Mudjacking vs Polyjacking", url: "/mudjacking-vs-polyjacking/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Concrete Crack Fillers, Matched to the Crack You Actually Have";
const description =
  "Seven concrete crack fillers compared by crack type: self-leveling polyurethane for moving joints, epoxy for static cracks, and when backer rod is a must.";

const PRODUCTS = [
  {
    "id": "sikaflex-self-leveling-sealant",
    "name": "Sikaflex Self-Leveling Sealant",
    "category": "Self-Leveling Polyurethane, 10.1 or 29 oz",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 2800,
    "pros": [
      "Rated for movement of up to 25 percent of the joint width, so it flexes with seasonal slab movement",
      "Flows flat into horizontal cracks and control joints with no tooling",
      "Sika publishes clear depth and width-to-depth guidance, which takes the guesswork out of installation",
      "Sold in 10.1 oz tubes for spot repairs and 29 oz tubes for long joints",
      "Accelerated-cure formula skins over faster than older polyurethane joint sealants"
    ],
    "cons": [
      "Runs out of vertical cracks and wanders on steeper driveway slopes",
      "The smooth gray bead is visible against weathered, textured concrete"
    ],
    "bottomLine": "The self-leveling polyurethane to buy for driveway, patio and garage-floor cracks that move with the seasons.",
    "description": "Sikaflex Self-Leveling is a single-component, premium-grade polyurethane joint sealant, and it is the product we would put in most horizontal concrete cracks. The case for it is movement. Sika rates it for expansion and contraction of up to 25 percent of the average joint width, which is what lets a bead survive a crack that opens in January and closes in July. Rigid fillers cannot do that, and it is the main reason they fail outdoors. It is also properly self-leveling. Poured into a clean crack, it flows to the edges and settles into a flat, smooth surface that sheds water and does not catch a snow shovel blade. In our test cracks it needed no tooling at all, and the finished surface sat level with the concrete once we learned to stop just short of the top and let it settle. Sika is also unusually specific about installation: a sealant depth between 1/4 and 1/2 inch in moving joints, the full 1/2 inch in horizontal joints that carry traffic, and a two-to-one width-to-depth ratio. Follow that with backer rod underneath and the bead lasts. The limitation is the flip side of the flow. It will not stay in a vertical crack, and on a steep driveway it creeps downhill before it skins, so lay short sections or use a non-sag product on the steepest stretch."
  },
  {
    "id": "quikrete-self-leveling-polymer-sealant",
    "name": "Quikrete Advanced Polymer Self-Leveling Sealant",
    "category": "Solvent-Free Self-Leveling Polymer, 10.1 or 29 oz",
    "badge": "Fastest Tack-Free",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1600,
    "pros": [
      "Tack-free in about 60 minutes per Quikrete, so debris and footprints are less of a risk",
      "Solvent- and isocyanate-free formula, a real advantage in attached garages and basements",
      "Levels to a smooth, flat finish in horizontal cracks and expansion joints",
      "Quikrete publishes coverage: about 12 linear feet per 10.1 oz tube at a 1/2 by 1/4 inch joint",
      "Stocked widely in both tube sizes"
    ],
    "cons": [
      "Horizontal use only; it will not hold in a wall crack",
      "Coverage disappears fast in deep cracks, so backer rod is close to mandatory"
    ],
    "bottomLine": "A strong alternative to Sikaflex, and our pick for indoor slabs where a fast tack-free time and low odor matter.",
    "description": "Quikrete's Advanced Polymer Self-Leveling Sealant does the same job as the Sikaflex above with a different chemistry, and in a couple of situations we would choose it first. It is solvent and isocyanate free, which matters when you are sealing a crack in a basement floor or an attached garage where fumes have nowhere to go. And it reaches a tack-free surface in about an hour according to Quikrete, which is noticeably quicker than traditional urethane sealants. On an outdoor slab that shortens the window in which leaves, grit, insects and curious pets can end up embedded in the bead. In our test cracks it poured easily from a standard caulk gun and leveled into a smooth, flat finish that sat flush with the concrete. Like every self-leveler, it is for horizontal surfaces only; tip the tube at a wall crack and it simply runs out. The other thing to plan for is volume. Quikrete rates a 10.1 ounce tube at about 12 linear feet in a joint half an inch wide and a quarter inch deep, which is honest and also a warning: an untreated crack an inch deep will swallow a tube in a few feet. Set the depth with backer rod first and the tubes go a long way. If you have a long control joint, the 29 ounce size and a larger caulk gun save a lot of reloading."
  },
  {
    "id": "loctite-pl-concrete-crack-sealant",
    "name": "Loctite PL Concrete Crack & Masonry Sealant",
    "category": "Non-Sag Textured Polyurethane, 10 oz",
    "badge": "Best for Vertical Cracks",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1900,
    "pros": [
      "Non-sag gun grade holds its bead in foundation, step and retaining-wall cracks",
      "Textured finish blends into concrete and mortar far better than a glossy caulk line",
      "Loctite says no primer is needed on concrete, brick, stone or block",
      "Stays elastic to move with the joint rather than cracking out",
      "Also usable on horizontal cracks when a perfectly flat finish is not critical"
    ],
    "cons": [
      "Needs tooling to look neat, and the texture makes smoothing slower",
      "Not recommended for joints deeper than 1/2 inch without backer rod, or for permanent water immersion"
    ],
    "bottomLine": "The polyurethane to reach for on walls, steps and the joint where a slab meets the house.",
    "description": "Self-leveling sealants are the best answer on a flat slab and useless on a wall, and this is where the Loctite PL earns its place. It is a one-component, moisture-curing polyurethane in a gun-grade, non-sag consistency, which means it stays exactly where you put it in a vertical crack instead of slumping out and running down the face of the foundation. Loctite lists foundations, concrete walls, brick and block walls, expansion joints, driveways and sidewalks among its uses, and says it needs no primer on concrete or masonry. The feature we liked most is the texture. Most sealants cure to a smooth, slightly shiny bead that draws the eye to every repair. This one has a sandy, gritty finish that, once tooled, reads as part of the concrete or mortar joint rather than a strip of caulk. On a front step or a visible retaining wall, that makes a real difference to how the repair looks from the sidewalk. It also works well on the isolation joint between a driveway and the house wall, where you want flexibility and a product that will not sag. The trade-offs are modest. It takes a few minutes of tooling to get a clean line, and the texture makes that slower than smoothing a plain caulk. And like any gun-grade sealant, joints deeper than half an inch need backer rod."
  },
  {
    "id": "sashco-slab-crack-repair",
    "name": "Sashco Slab Concrete Crack Repair",
    "category": "Water-Based Elastomeric Sealant, 10.5 oz",
    "badge": "Most Flexible",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1400,
    "pros": [
      "Sashco rates it to stretch up to 300 percent of its cured size",
      "Water cleanup and a low-VOC, low-odor formula",
      "Suited to sidewalk, patio, garage and driveway cracks plus horizontal expansion joints",
      "Clear instructions on bead thickness and when to use backer rod",
      "Friendlier for first-timers than solvent-based urethanes"
    ],
    "cons": [
      "Water-based sealants cure slowly in cold, damp weather, and Sashco specifies storage between 40 and 90 degrees",
      "Needs a bead at least 1/4 inch thick to stretch properly, so it is not for hairlines"
    ],
    "bottomLine": "The most elastic option here, and a good choice for cracks that move a lot if you can work in mild weather.",
    "description": "Sashco's Slab is built around one number: the company rates it to stretch up to 300 percent of its cured size without tearing or pulling away. That is a lot of headroom for a crack that opens noticeably in winter, and it is the reason we pick it for the liveliest cracks in the test set. It is water-based, which brings the usual advantages: soap-and-water cleanup, a low-odor formula with low VOC content, and no solvent smell hanging around a garage for a day. For a homeowner doing their first crack repair, being able to wipe mistakes off hands and tools with a wet rag makes the job considerably less stressful than working with a sticky urethane. Sashco is clear about how to install it. The bead should be at least a quarter inch thick so it has enough body to stretch, and no more than half an inch, and any crack deeper than half an inch and wider than a quarter inch needs backer rod first. Follow those rules and it performs as advertised. The trade-off is the chemistry. Water-based sealants cure by evaporation, so cold, damp weather slows them down considerably, and Sashco specifies storage between 40 and 90 degrees. Plan the job for a dry spell in spring or fall rather than a chilly November weekend, and keep traffic off it until it has fully cured."
  },
  {
    "id": "quikrete-concrete-crack-seal",
    "name": "Quikrete Concrete Crack Seal",
    "category": "Acrylic Latex Liquid, Squeeze Tube or Bottle",
    "badge": "Best for Hairline Cracks",
    "amazonUrl": "#",
    "rating": 4.1,
    "reviewCount": 2300,
    "pros": [
      "Thin enough to run into hairlines that a caulk can only bridge",
      "Squeeze-bottle applicator puts the liquid right into the crack",
      "Self-levels and blends toward the color of natural concrete",
      "Quikrete rates it for cracks up to 1/2 inch wide",
      "Dry to the touch in about 30 minutes"
    ],
    "cons": [
      "Acrylic latex has little movement capability, so it will reopen in a live crack",
      "Takes about 24 hours to harden, and deeper cracks may need a second pass as it settles"
    ],
    "bottomLine": "The right tool for fine, stable cracks where a thick sealant would just sit on top and peel.",
    "description": "Hairline cracks are the ones most people try to fill with the wrong product. A thick polyurethane cannot get into a crack a sixteenth of an inch wide; it bridges the surface, bonds to the dusty edges, and peels away within months. Quikrete Concrete Crack Seal is a ready-to-use acrylic latex liquid that is thin enough to actually run into those fine cracks. Squeezed straight from the bottle along the crack line, it flows in, self-levels and dries toward a concrete-gray color that is far less obvious than a caulk bead. Quikrete says it is dry to the touch in about 30 minutes and hardens in about 24 hours, and it is rated for cracks up to half an inch wide, though in our view the wider end of that range is better served by a polyurethane. It comes in a small squeeze tube for a few repairs and in quart and gallon bottles for a whole patio. Be realistic about what it is. Acrylic latex is not a high-movement sealant, so in a crack that visibly opens and closes with the seasons it will eventually crack out. It is at its best in stable shrinkage cracks on sidewalks, steps and patios, where the goal is to keep water from entering the slab and freezing. On deeper hairlines it can sink as it soaks in, so a second pass the next day is sometimes needed."
  },
  {
    "id": "pc-concrete-epoxy",
    "name": "PC Products PC-Concrete Two-Part Epoxy",
    "category": "100% Solids Epoxy Paste, 8.6 oz Cartridge",
    "badge": "Best for Static Cracks",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 2600,
    "pros": [
      "100 percent solids, 1:1 structural epoxy that bonds cracked concrete back into one piece",
      "Dispenses and mixes through the included nozzle from a standard caulk gun",
      "About 20 minutes of working time at 75 degrees, with painting possible in as little as 4 hours",
      "Solvent-free and odorless, so it is comfortable to use indoors",
      "Doubles as an anchoring adhesive for bolts, rebar and railing posts"
    ],
    "cons": [
      "Fully rigid, so it cracks out of, or beside, any crack that still moves",
      "Mixing nozzles clog between uses, and one cartridge covers a limited length of crack"
    ],
    "bottomLine": "The filler for cracks that have stopped moving and repairs where you want real strength, not flexibility.",
    "description": "Epoxy is the opposite of every other product on this list, and that is precisely why it belongs here. PC-Concrete is a two-part, 100 percent solids structural epoxy paste that cures harder than the concrete around it. Squeezed from a standard caulk gun, the resin and hardener meet in the included static mixing nozzle in a one-to-one ratio, so there is no measuring or stirring. PC Products gives about 20 minutes of working time at 75 degrees and says the repair can be painted or bolted down in as little as four hours. Where it shines is a crack that is not going anywhere: an old shrinkage crack in a basement slab, a broken corner on a step, a cracked concrete post base, or a slab crack that you have watched for a year without it changing. Epoxy bonds the two sides together and restores strength across the crack, which no sealant can do. It is also solvent-free and odorless, which makes indoor use pleasant, and it doubles as an anchoring adhesive for bolts and railing posts. The warning is important. In a crack that still opens and closes, rigid epoxy transfers the stress to the concrete beside it, and a new crack simply forms next to the repair. If you are not sure whether a crack is moving, use polyurethane. Nozzles also clog quickly, so keep a spare."
  },
  {
    "id": "red-devil-concrete-patch",
    "name": "Red Devil Pre-Mixed Concrete Patch",
    "category": "Acrylic Premixed Patch, 1 qt Tub",
    "badge": "Best for Chips and Holes",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 1100,
    "pros": [
      "Ready to use straight from the tub with a putty knife",
      "Acrylic formula with water cleanup and very low VOC content",
      "Dries to a concrete color and can be painted",
      "Fills holes, chips and broken edges that a sealant cannot hold",
      "Rated for both interior and exterior use"
    ],
    "cons": [
      "Red Devil says it is not for areas with vehicle traffic, so keep it off driveways",
      "Not a crack sealant; in a moving crack it will reopen along the same line"
    ],
    "bottomLine": "A handy premix for small, shallow damage on walks, steps and walls, not a fix for driveway cracks.",
    "description": "Not every concrete repair is a crack. Chipped step edges, small popouts, anchor holes and gouges in a basement wall need something with body that can be pressed in and smoothed flat, and a pourable sealant is useless for that. Red Devil's Pre-Mixed Concrete Patch is an acrylic-based, ready-to-use compound in a one-quart tub. Open it, press it into the damage with a putty knife, smooth it off, and clean your tools with water. There is no mixing, no pot life to race against, and the leftover keeps in the sealed tub for the next small job. Red Devil says it will not shrink or crack as it cures, stays slightly flexible, dries to a concrete color and can be painted. It handles interior and exterior repairs, and on our test step corner it built up without slumping and cured hard over about a day. Two limits keep it at the bottom of this list for most readers. Red Devil states it is not recommended for areas subject to vehicular traffic, so it does not belong on a driveway or garage floor where tires will roll over it. And it is a patch, not a sealant. Smear it into a crack that moves and it will reopen along the same line within a season. Use it for small, stable damage on walks, steps and walls, and use a polyurethane for anything that moves."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Concrete Crack Filler",
          item: "https://www.thehonestreviewers.com/best-concrete-crack-filler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best concrete crack filler for a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most driveway cracks between 1/8 and 1/2 inch, a self-leveling polyurethane such as Sikaflex Self-Leveling Sealant or Quikrete Advanced Polymer Self-Leveling Sealant is the right choice. It flexes with seasonal movement, levels flat so tires and shovels do not catch it, and holds up to traffic when installed at the proper depth over backer rod. Hairlines need a thinner liquid filler."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use regular caulk to fill cracks in concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is rated for concrete. Standard household acrylic or silicone caulk is not designed for the movement, abrasion and UV exposure of an outdoor slab, and most will fail within a season. Look for a polyurethane or hybrid polymer labeled for concrete, and check whether it is self-leveling for horizontal cracks or non-sag for vertical ones."
          }
        },
        {
          "@type": "Question",
          "name": "How wide a crack can concrete crack filler fix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most caulk-tube sealants handle cracks from about 1/8 inch up to 1/2 inch comfortably, and self-leveling joint sealants can fill joints over an inch wide when set on backer rod. Past about an inch and a half you are no longer sealing a crack; the edges usually need patching with a cement-based repair product, or the section needs replacing."
          }
        },
        {
          "@type": "Question",
          "name": "Should I fill hairline cracks in concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. Many hairline shrinkage cracks are cosmetic and stable. Where water can get in and freeze, a thin liquid filler that wicks into the crack helps, and a penetrating sealer over the whole slab protects against water entering through hairlines too fine to fill. Thick caulk over a hairline just bridges the surface and peels off within months."
          }
        },
        {
          "@type": "Question",
          "name": "How long does concrete crack filler last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A properly installed polyurethane sealant in a clean, dry crack at the correct depth typically lasts several years, and longer out of direct traffic and sun. Acrylic liquids and patching compounds wear out sooner, especially in freeze-thaw climates. Inspect filled cracks each fall and re-seal any section that has pulled away from one side before winter sets in."
          }
        },
        {
          "@type": "Question",
          "name": "Is epoxy or polyurethane better for concrete cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on whether the crack moves. Polyurethane stays flexible and is right for outdoor slab cracks and joints that open and close with temperature. Epoxy is rigid and structural, so it suits cracks that have stopped moving and repairs where you want the two sides bonded together, such as a broken step edge or a stable basement slab crack."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal or paint over concrete crack filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, once it has cured. Most polyurethane and acrylic crack fillers accept a concrete sealer or paint after the cure time on the label, often a few days. Check the data sheet, since some sealants need longer before coating. Always fill cracks before sealing the slab, never after, so the sealer does not interfere with the filler's bond."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete",
    tags: [
      "best concrete crack filler",
      "concrete crack sealant",
      "self-leveling polyurethane sealant",
      "concrete crack repair",
      "epoxy crack filler",
      "backer rod"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Fillers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Concrete Crack Filler</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most failed crack repairs used a decent product in the wrong crack. Here is which filler belongs in a hairline, a half-inch gap and a joint that moves every winter.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#sikaflex-self-leveling-sealant"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All 7
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked and Tested</a>
          <a href="#crack-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Diagnose the Crack First</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#filler-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Polyurethane vs Epoxy vs Patch</a>
          <a href="#backer-rod" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Backer Rod and Joint Depth</a>
          <a href="#horizontal-vertical" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Horizontal vs Vertical Cracks</a>
