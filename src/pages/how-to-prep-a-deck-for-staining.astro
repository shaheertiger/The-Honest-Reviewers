---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Deck Cleaners", url: "/best-deck-cleaner/" },
    { title: "How to Stain a Deck", url: "/how-to-stain-a-deck/" },
    { title: "How to Strip Deck Stain", url: "/how-to-strip-deck-stain/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "How to Prep a Deck for Staining";
const description =
  "Clean, strip, brighten, sand, dry — in that order, and only the steps your deck needs. How to tell which ones those are before you buy anything.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Prepping a Deck for Staining",
          item: "https://www.thehonestreviewers.com/how-to-prep-a-deck-for-staining/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do you prepare a deck for staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Clear and repair it, remove any failing coating with a stripper if one is present, wash it with a deck cleaner to remove mildew and grey surface fibres, neutralise with a wood brightener, sand only where the surface is rough, and then let it dry until water soaks in rather than beading. Skipping the brightener or the drying time causes most uneven finishes.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need to strip my deck before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if a previous coating is still present and intact. A worn penetrating stain that has faded away does not need stripping, just cleaning. A solid stain or paint that is peeling, or any finish that still makes water bead, has to come off, because a new coat applied over it cannot bond to the wood.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between deck cleaner and deck brightener?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A cleaner is usually alkaline and removes mildew, dirt and the loose grey fibres left by UV damage. A brightener is acidic, typically oxalic acid, and neutralises the alkalinity the cleaner leaves behind while lifting tannin and rust marks. They are two halves of one process, and using the cleaner alone leaves the wood chemically unbalanced.",
          },
        },
        {
          "@type": "Question",
          name: "Should you sand a deck before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only where the surface needs it: raised fibres after pressure washing, mill glaze on new smooth lumber, splinters on handrails, or a stripped area with residue. Use 60 to 80 grit and no finer, because sanding too smooth closes the grain and reduces how much stain the wood can absorb.",
          },
        },
        {
          "@type": "Question",
          name: "How do you know when a deck is dry enough to stain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sprinkle water on several spots across the deck, including shaded ones. If it soaks in and darkens the wood within a minute or two, the deck is ready. If it beads or sits, either the wood is still wet or an old finish is still working, and stain applied now will not penetrate.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use bleach to clean a deck before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Household chlorine bleach kills surface mildew but damages wood fibres, strips natural colour and can corrode fasteners, and it does not remove the grey oxidised layer. Sodium percarbonate cleaners, sold as oxygen bleach deck cleaners, do the same job without the fibre damage and are the better choice before staining.",
          },
        },
        {
          "@type": "Question",
          name: "How long after cleaning a deck can you stain it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Generally 24 hours after a light wash and 48 hours or more after pressure washing, extended in humid or cool weather or if the deck is shaded. Boards dry from the outside in, so the surface can feel dry while the wood beneath is still wet. The water test is more reliable than the clock.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need to prep a brand new deck before staining?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. New lumber carries mill glaze from the planing process, dirt from the yard, and often moisture from treatment, all of which stop stain penetrating. Clean it, and check it with the water test. If it beads, it needs either more weathering time or a light sanding to open the surface.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
