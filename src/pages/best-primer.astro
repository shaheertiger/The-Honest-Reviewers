---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Interior Paint",
    "url": "/best-interior-paint/"
  },
  {
    "title": "Best Ceiling Paint",
    "url": "/best-ceiling-paint/"
  },
  {
    "title": "Best Spackle",
    "url": "/best-spackle/"
  },
  {
    "title": "Best Painter's Tape",
    "url": "/best-painters-tape/"
  },
  {
    "title": "Best Paint Brushes",
    "url": "/best-paint-brushes/"
  },
  {
    "title": "Best Paint Sprayers",
    "url": "/best-paint-sprayer/"
  },
  {
    "title": "Joint Compound vs Spackle",
    "url": "/joint-compound-vs-spackle/"
  },
  { title: "Can You Paint Over Wallpaper?", url: "/can-you-paint-over-wallpaper/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "8 Best Primers for Stains, Glossy Surfaces and New Drywall";
const description =
  "Eight paint primers compared by job: water stains, smoke odor, glossy tile, torn drywall and exterior wood — plus when paint-and-primer is enough on its own.";

const PRODUCTS = [
  {
    "id": "zinsser-bulls-eye-123-primer",
    "name": "Zinsser Bulls Eye 1-2-3 Primer",
    "category": "Water-Based All-Purpose, Interior/Exterior",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 3800,
    "pros": [
      "Genuinely multi-surface: drywall, wood, masonry, previously painted surfaces and metal, inside and out",
      "Dries in about 30 minutes and takes a topcoat in roughly an hour",
      "Mildew-resistant film makes it a sensible choice for bathrooms and exterior trim",
      "Tintable, so it can carry a gray or color base under deep topcoats",
      "Low odor and soap-and-water cleanup, which matters in occupied rooms"
    ],
    "cons": [
      "Handles light and moderate stains only — severe water marks and smoke need a dedicated stain-killer",
      "Needs about a week to reach full cure, so treat freshly primed trim gently"
    ],
    "bottomLine": "The primer to keep on the shelf: it handles most everyday priming jobs well and only hands off to a specialist when the stain or surface is genuinely difficult.",
    "description": "If you are only going to own one can of primer, this is the one we would choose. Bulls Eye 1-2-3 is a water-based acrylic that Zinsser rates for interior and exterior use across the surfaces a homeowner actually paints: patched drywall, bare and previously painted wood, masonry, and sound painted surfaces. It dries to the touch in around 30 minutes and is ready for a topcoat in about an hour, so a primer coat and a first finish coat fit comfortably in one afternoon. Coverage lands in the familiar range of roughly 300 to 400 square feet per gallon depending on how porous the surface is. What sets it apart from cheaper all-purpose primers is adhesion and the mildew-resistant film. Zinsser markets it as bonding to glossy surfaces without sanding, and in our experience it grips semi-gloss trim far better than a builder-grade primer does — although we still recommend a light scuff with 220-grit on anything shiny, because it costs two minutes and removes all doubt. It is also tintable, which is useful under deep reds and navies. Where it stops is serious stains. It will lock in pencil, crayon and light water marks, but a ceiling ring from a roof leak or a nicotine-yellow wall needs a shellac or oil-based stain-killer instead."
  },
  {
    "id": "zinsser-bin-shellac-primer",
    "name": "Zinsser B-I-N Shellac-Base Primer",
    "category": "Shellac-Base Stain Killer, Interior + Spot Exterior",
    "badge": "Best Stain & Odor Blocker",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 4200,
    "pros": [
      "The most reliable blocker we know for severe water stains, smoke, fire damage, nicotine and knots",
      "Dries to the touch in about 20 minutes and can be recoated in about 45 minutes",
      "Seals odors from smoke and pets rather than masking them",
      "High coverage of roughly 500 square feet per gallon at recommended thickness",
      "Sticks to glossy surfaces, plastic laminate and metal with minimal prep"
    ],
    "cons": [
      "Strong alcohol fumes — needs real ventilation and a respirator in closed rooms",
      "Not for full exterior use and cleanup needs denatured alcohol, not water"
    ],
    "bottomLine": "When a stain has already bled through two coats of paint, this is what finally stops it.",
    "description": "Pigmented shellac has been the professional answer to impossible stains for decades, and B-I-N is the version almost every painter reaches for. Shellac works differently from acrylic and oil primers: it is dissolved in alcohol, which evaporates in minutes and leaves a hard film that water-soluble stains simply cannot migrate through. That is why it succeeds on the problems that defeat everything else — the brown ring left by a roof leak, the yellow haze of nicotine, soot and smoke damage after a kitchen fire, and resinous knots in pine that bleed through latex paint for years. The same film seals odor molecules in, which is why restoration contractors use it after fires and in houses that were smoked in. The speed is a genuine bonus. It dries to the touch in about 20 minutes and can take a topcoat in around 45, and it covers roughly 500 square feet per gallon, which offsets its higher price. The trade-offs are real, though. The alcohol fumes are intense, and in a small bathroom or closet you need open windows, a fan and an organic vapor respirator. Cleanup needs denatured alcohol. It is rated for interior use and exterior spot priming only, not whole exterior walls, and the film develops its full adhesion over one to three days."
  },
  {
    "id": "kilz-restoration-primer",
    "name": "KILZ Restoration Interior Primer",
    "category": "Water-Based Maximum Stain Blocker, Interior",
    "badge": "Best Low-Odor Stain Blocker",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 2400,
    "pros": [
      "Water-based formula rated for severe water damage, smoke, nicotine, tannin and pet stains",
      "Low odor compared with oil and shellac stain-killers, so occupied homes are workable",
      "Recoat in about an hour, with soap-and-water cleanup",
      "Also rated for sealing pet and smoke odors",
      "Coverage of roughly 300 to 400 square feet per gallon"
    ],
    "cons": [
      "Interior only, so it is not the answer for exterior stains",
      "On the very worst stains shellac still has the edge, and a second coat may be needed"
    ],
    "bottomLine": "The best choice for heavy stains in a lived-in house where shellac fumes are not an option.",
    "description": "KILZ Restoration is the manufacturer's attempt to deliver oil and shellac stain-blocking performance in a water-based primer, and it gets closer than any other water-based product we have used. KILZ rates it for the difficult list: severe water damage, rust, smoke, nicotine, grease, tannin bleed, ink, marker and pet stains, and for sealing pet and smoke odors. The reason that matters is the working environment. Oil and shellac stain-killers make a house smell for a day and need serious ventilation; Restoration has a mild odor and cleans up with soap and water, which makes it the practical choice for a nursery, a rental between tenants or a bedroom you need to sleep in tonight. It dries to the touch in around 30 minutes and takes a topcoat in about an hour, with coverage in the 300 to 400 square foot per gallon range. Our honest read is that it handles the large majority of heavy interior stains in one coat, and a second coat closes the gap on the rest. On a smoke-blackened ceiling after a fire, or knots that have already bled through latex, we would still use shellac. For water rings, nicotine-yellowed walls and the general grime of a neglected room, Restoration is the easier product to live with."
  },
  {
    "id": "kilz-original-oil-primer",
    "name": "KILZ Original Oil-Based Interior Primer",
    "category": "Oil-Based Stain Blocker, Interior",
    "badge": "Best Oil-Based Primer",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 3100,
    "pros": [
      "Classic oil-based stain blocker for water, smoke, tannin, ink, grease and marker stains",
      "Seals pet, food and smoke odors in addition to stains",
      "Ready for topcoat in about an hour on current formulas",
      "Oil film penetrates and seals chalky or porous surfaces well",
      "Accepts latex or oil topcoats"
    ],
    "cons": [
      "Strong solvent odor and mineral-spirits cleanup",
      "Rated for interior use; the exterior job belongs to a different product"
    ],
    "bottomLine": "A dependable, widely stocked oil-based stain-killer that costs less than shellac and seals porous surfaces well.",
    "description": "Before water-based stain blockers got good, this is what most homeowners bought when a stain would not stay hidden, and it still earns its place. KILZ Original is an oil-based interior primer that the company rates for most heavy interior stains — water, smoke, tannin, ink, pencil, marker and grease — and for sealing persistent pet, food and smoke odors. Oil-based primers have two advantages over acrylics. The solvent carries the resin deeper into porous and chalky surfaces, locking down powdery old paint and bare plaster, and the cured film is a strong barrier against water-soluble stains. It dries to the touch in about 30 minutes and is ready for a topcoat in around an hour on current formulas, with coverage in the 300 to 400 square foot per gallon range. It sits between the other stain-killers here. It is gentler to work with than shellac and less expensive, but it smells like what it is — an oil-based coating — and needs mineral spirits for cleanup. Compared with KILZ Restoration, it seals chalky and porous surfaces better but is far less pleasant indoors. It is labeled for interior use, so for exterior wood that needs an oil primer, look at Zinsser Cover Stain instead. Stir it thoroughly; the pigment settles hard."
  },
  {
    "id": "zinsser-cover-stain-primer",
    "name": "Zinsser Cover Stain Oil-Based Primer",
    "category": "Oil-Based Stain Killer, Interior/Exterior",
    "badge": "Best for Exterior Wood",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 1100,
    "pros": [
      "Rated for both interior and exterior use, unlike most oil-based stain killers",
      "Blocks tannin bleed from cedar and redwood, which is the main exterior priming problem",
      "Seals water, smoke, fire and nicotine stains",
      "Bonds to glossy surfaces and dries to the touch in about 35 minutes",
      "Flexible film suited to wood that moves with the seasons"
    ],
    "cons": [
      "Solvent odor and mineral-spirits cleanup",
      "Recoat time varies by formula and conditions — plan on one to two hours"
    ],
    "bottomLine": "The oil-based stain killer to buy when the job includes exterior wood, especially cedar or redwood.",
    "description": "Cover Stain is Zinsser's oil-based primer-sealer, and its main advantage over KILZ Original is that it is rated for both interior and exterior surfaces. That makes it the natural choice for the most common exterior priming problem: tannin bleed. Cedar and redwood contain water-soluble extractives that migrate through latex paint and leave brown streaks within weeks, and an oil-based primer is the standard fix. Cover Stain is formulated to block that bleed, and it handles the interior stain list too — water, smoke, fire damage and nicotine. It dries to the touch in around 35 minutes and covers roughly 300 to 400 square feet per gallon. Recoat guidance differs between formulas and conditions, so plan on one to two hours before topcoating and longer in cool, damp weather. Zinsser also rates it for adhesion to glossy surfaces, which makes it useful on old alkyd-painted trim, and the film is flexible enough for wood siding that expands and contracts with the seasons. It accepts latex or oil topcoats. The downsides are standard for oil: a noticeable solvent smell and mineral-spirits cleanup. For interior-only jobs in occupied rooms, KILZ Restoration is easier to live with; for exterior cedar trim, this is the better tool."
  },
  {
    "id": "insl-x-stix-bonding-primer",
    "name": "INSL-X Stix Waterborne Bonding Primer",
    "category": "Acrylic-Urethane Bonding Primer, Interior/Exterior",
    "badge": "Best Bonding Primer",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 600,
    "pros": [
      "Acrylic-urethane primer made for surfaces paint will not normally stick to: glossy tile, PVC, glass and glazed surfaces",
      "Water-based, low odor and soap-and-water cleanup",
      "Smooth leveling and good enamel holdout under cabinet and trim finishes",
      "Rated for interior and exterior use",
      "Covers roughly 300 to 400 square feet per gallon"
    ],
    "cons": [
      "Needs three to four days of cure before it reaches full scratch and scrape resistance",
      "Sold mainly through Benjamin Moore retailers; Amazon listings are often third-party and priced higher"
    ],
    "bottomLine": "The primer to use when a surface is so smooth that normal paint peels off it with a fingernail.",
    "description": "Stix is made by INSL-X, a Benjamin Moore brand, and it is the primer painters use when a surface is too smooth for paint to grip: glazed ceramic tile, PVC, fiberglass, glass, glossy laminate and factory-finished cabinets. It is an acrylic-urethane waterborne formula, so it has low odor and cleans up with water, yet its adhesion on hard, non-porous surfaces is better than most oil-based primers. The data sheet is honest about the one thing people get wrong. Stix dries to the touch in about 30 minutes and can take a topcoat in three to four hours, but it needs approximately three to four days to cure before it reaches maximum resistance to scrape-off. Test it too early with a fingernail and it will come away, which convinces people it failed when it simply was not finished. Coverage is roughly 300 to 400 square feet per gallon, and it levels well, which matters on cabinet doors where brush marks show. Prep still counts: clean with a degreaser, rinse, and scuff-sand gloss. Availability is the catch. It is sold mainly through independent Benjamin Moore retailers, and online listings are often third-party sellers at a premium. If you have a Benjamin Moore store nearby, buy it there."
  },
  {
    "id": "zinsser-gardz-sealer",
    "name": "Zinsser Gardz Problem Surface Sealer",
    "category": "Clear Penetrating Sealer, Interior",
    "badge": "Best for Damaged Drywall",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 1900,
    "pros": [
      "Soaks into torn drywall face paper and hardens it so joint compound will not bubble",
      "Seals wallpaper adhesive residue that makes latex paint crack and peel",
      "Locks down chalky surfaces and skim-coated walls before priming",
      "Water-based, low odor and dries clear to a matte finish",
      "Thin consistency penetrates better than a pigmented primer"
    ],
    "cons": [
      "Clear film has no hiding power and blocks no stains, so it is not a replacement for primer",
      "Easy to over-apply on vertical surfaces, where it runs"
    ],
    "bottomLine": "Not a primer in the usual sense, but the only product here that fixes torn drywall paper and adhesive residue properly.",
    "description": "Gardz solves a problem that ordinary primers make worse. When wallpaper comes off and takes the drywall face paper with it, the exposed brown layer soaks up moisture from joint compound or paint and swells into bubbles. Most people then prime it with a latex primer, which is also water-based, and the bubbles get bigger. Gardz is a thin, clear, water-based sealer that soaks into the torn paper and hardens it, so the surface can then be skim-coated or painted without blistering. It does the same job over the thin layer of wallpaper paste left after stripping — residue that otherwise causes latex paint to crack in a crazed pattern weeks later — and over chalky old paint and fresh skim coats. It dries clear to a matte finish with a low odor and soap-and-water cleanup. It is important to be clear about what it is not. Gardz has no pigment, so it hides nothing and blocks no stains; it is a sealer that fixes the substrate. On a heavily damaged wall the right sequence is Gardz, then skim coat with a quality compound, then a pigmented primer. Apply it with a roller and do not flood vertical surfaces, because the thin consistency runs easily."
  },
  {
    "id": "kilz-2-all-purpose-primer",
    "name": "KILZ 2 All-Purpose Primer",
    "category": "Water-Based All-Purpose, Interior/Exterior",
    "badge": "Best Budget Primer",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 5200,
    "pros": [
      "One of the least expensive name-brand primers and stocked almost everywhere",
      "Fast: dry to the touch in about 30 minutes and ready for paint in an hour",
      "Rated for interior and exterior use with a mildew-resistant film",
      "Blocks medium stains including minor water marks, pencil, ink and marker",
      "Mild odor and soap-and-water cleanup"
    ],
    "cons": [
      "Thinner and lower-hiding than Bulls Eye 1-2-3; dark colors can need a second coat",
      "Not suitable for heavy water, smoke or nicotine stains"
    ],
    "bottomLine": "A good value for large areas of new drywall and simple color changes, as long as you do not ask it to hide serious stains.",
    "description": "KILZ 2 is the primer most people see first on the shelf, and for straightforward work it is a reasonable buy. It is a water-based, multi-surface primer rated for interior and exterior use, with a mildew-resistant film, mild odor and soap-and-water cleanup. KILZ rates it for medium stains — minor water stains, rust, grease, ink, pencil and marker — which covers most of what you meet on walls that have simply been lived in. It dries to the touch in about 30 minutes and can be painted after an hour, with coverage in the 300 to 400 square foot per gallon range. The main difference from our top pick is body and hiding power. KILZ 2 goes on thinner, and going from a dark color to a light one, or covering a bold accent wall, often takes two coats where Bulls Eye 1-2-3 needs one. That can erase the price advantage on smaller jobs. Where it makes most sense is large areas of new drywall in a finished basement or an addition, where you need coverage at a sensible price and the surface has no stains to hide. Keep expectations realistic on stains: a ceiling ring from a real leak needs KILZ Restoration, KILZ Original or shellac, not this."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Primers",
          item: "https://www.thehonestreviewers.com/best-primer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do I need primer if I use paint and primer in one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for repainting a sound, clean surface in a similar color, where paint-and-primer products work well. You still need a separate primer over new drywall, patches, stains, glossy surfaces, bare wood and major color changes. Paint-and-primer products do not block stains or improve adhesion the way dedicated primers do, and they cost more per coat than primer."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best primer for water stains on a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fix the leak and let the ceiling dry first. For light stains, a premium water-based stain blocker such as KILZ Restoration works well. For dark rings or stains that have already bled through paint, use a shellac primer like Zinsser B-I-N or an oil-based stain blocker. Prime beyond the stain edge, then paint the ceiling."
          }
        },
        {
          "@type": "Question",
          "name": "Is oil-based primer better than water-based?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in general. Oil-based primers are better at blocking tough stains, tannin bleed and sealing chalky surfaces. Water-based primers are better for new drywall, general use and low-odor work, and they stay flexible outside. Premium water-based stain blockers now handle many jobs that once needed oil. Choose based on the problem rather than the chemistry."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint latex over oil-based primer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Most oil-based primers, including KILZ Original and Zinsser Cover Stain, can be topcoated with latex or oil paint once dry. Shellac primers also accept latex and oil topcoats. What you should avoid is applying latex directly over old oil-based gloss paint without priming, because the latex usually cannot bond to it and will peel."
          }
        },
        {
          "@type": "Question",
          "name": "How long should primer dry before painting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the type. Shellac primers such as B-I-N can often be recoated in about 45 minutes, while most water-based and oil-based primers need around one to two hours. Bonding primers can be topcoated in a few hours but need several days to fully cure. Humidity and cold slow drying, so check the can."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of primer do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One coat is enough for most drywall, patches and sound painted surfaces. Use two coats over severe stains, strong odors, very porous surfaces and major dark-to-light color changes. If a stain shows through after one coat and a test patch of paint, add another coat of primer before painting the rest of the surface."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use interior primer outside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is rated for exterior use. Primers like Bulls Eye 1-2-3, KILZ 2 and Cover Stain are rated for interior and exterior use, while KILZ Restoration and KILZ Original are interior products. Shellac primers such as B-I-N are for interior and exterior spot priming. Exterior-rated primers stay more flexible and resist mildew better."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Home Improvement",
    tags: [
      "best primer",
      "stain blocking primer",
      "shellac primer",
      "bonding primer",
      "drywall primer",
      "oil-based primer"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            8 Primers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Primers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Primer is not one product. The right can depends on what you are covering — a water stain, a glossy cabinet, raw drywall or smoke-damaged plaster — and picking the wrong type is how paint jobs fail.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#zinsser-bulls-eye-123-primer"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            When You Need Primer
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#when-you-need-primer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. When You Actually Need Primer</a>
