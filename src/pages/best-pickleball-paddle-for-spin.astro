---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Pickleball Paddles",
    "url": "/best-pickleball-paddle/"
  },
  {
    "title": "Best Pickleball Paddles for Tennis Elbow",
    "url": "/best-pickleball-paddle-for-tennis-elbow/"
  },
  {
    "title": "Carbon Fiber vs Fiberglass Pickleball Paddles",
    "url": "/carbon-fiber-vs-fiberglass-pickleball-paddle/"
  },
  {
    "title": "Thermoformed Pickleball Paddles",
    "url": "/thermoformed-pickleball-paddle/"
  },
  {
    "title": "14mm vs 16mm Pickleball Paddles",
    "url": "/14mm-vs-16mm-pickleball-paddle/"
  },
  {
    "title": "USA Pickleball Approved Paddles",
    "url": "/usa-pickleball-approved-paddles/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-18", modified: "2026-10-18" });
const title = "6 Best Pickleball Paddles for Spin: Raw Carbon Picks That Grip the Ball";
const description =
  "Six raw and textured carbon pickleball paddles chosen for spin, compared on face, core, weight and shape, plus how grit wears and what the spin rules allow.";

const PRODUCTS = [
  {
    "id": "six-zero-double-black-diamond-control-16mm",
    "name": "Six Zero Double Black Diamond Control 16mm",
    "badge": "Best Overall",
    "category": "Raw Toray Carbon, 16mm, Hybrid Shape",
    "amazonUrl": "#",
    "description": "The Double Black Diamond Control is the spin paddle we would point most players to first, because it pairs a raw carbon face with a shape and weight that are easy to live with. Six Zero describes the hitting surface as a Japanese Toray 700K raw carbon fiber with a textured finish, and Pickleball Central lists a 16mm polymer honeycomb core, an overall length of about 16.3 inches and an average weight of 8.1 ounces within a 7.9 to 8.3 ounce range. That hybrid length gives you a little more reach and swing speed than a standard-shape paddle without the twist and sluggishness some elongated paddles bring to hand battles. The 16mm core is the control-oriented thickness, which suits players who want to shape dinks and drops with spin rather than overpower the ball. Retailers list a 4.25-inch grip circumference; handle length is given as 5.3 inches on some listings and 5.5 on others, so check the listing if you have a two-handed backhand. It is also offered in 14mm for players who want more pop.",
    "pros": [
      "Raw Toray 700K carbon face, per Six Zero",
      "16mm core suits a control and spin game",
      "Hybrid length of about 16.3 in balances reach and maneuverability",
      "Average weight around 8.1 oz, per Pickleball Central",
      "Also offered in a 14mm version"
    ],
    "cons": [
      "Handle length listed inconsistently across retailers",
      "Control-first feel gives up some pop on drives",
      "Premium price"
    ],
    "bottomLine": "For most players chasing spin, the Six Zero Double Black Diamond Control 16mm is the paddle to start with: a raw Toray carbon face, a control-oriented 16mm core and a hybrid shape that stays quick at the kitchen line."
  },
  {
    "id": "joola-ben-johns-perseus-16mm",
    "name": "JOOLA Ben Johns Perseus 16mm",
    "badge": "Best for Power and Spin",
    "category": "Textured Carbon Face, 16mm, Elongated",
    "amazonUrl": "#",
    "description": "The Perseus is JOOLA's Ben Johns signature paddle, and it suits players who want spin on drives and serves as much as on soft shots. Retailers list a 16.5-inch length, a 7.5-inch width, a 5.5-inch handle and a weight of about 8.0 ounces for the 16mm version, with a polymer honeycomb core. JOOLA describes the face with its own branding, Charged Carbon or Carbon Friction Surface depending on the generation, and retailers describe the texture as rough rather than smooth. Grip size is listed at 4.25 inches for the 16mm on most listings, with one source giving 4.125, so confirm it on the box. The elongated shape gives more leverage on serves and groundstrokes, which helps topspin, at the cost of a slightly slower feel at the net. The bigger caveat is naming: retailers sell Perseus, Perseus CFS, Perseus 3S and later versions side by side, and specs shift between generations, so match the exact model and year before you compare.",
    "pros": [
      "Elongated 16.5 in shape adds leverage for topspin drives and serves",
      "Textured carbon face, per JOOLA and retailers",
      "About 8.0 oz for the 16mm, per retailers",
      "Long 5.5 in handle suits two-handed backhands"
    ],
    "cons": [
      "Several generations on sale with different specs",
      "Elongated shape is slower in fast hand battles",
      "Grip size listed as 4.25 or 4.125 in depending on the listing"
    ],
    "bottomLine": "If you want spin on drives and serves as well as soft shots, the JOOLA Perseus 16mm adds elongated leverage to a textured carbon face; just match the generation before you buy."
  },
  {
    "id": "engage-pursuit-pro1-6-0-elongated",
    "name": "Engage Pursuit Pro1 6.0 Elongated",
    "badge": "Best Elongated",
    "category": "Raw T700 Carbon, About 16mm, Elongated",
    "amazonUrl": "#",
    "description": "The Pursuit Pro1 6.0 is Engage's raw carbon line, and the elongated version is the one to look at if reach and spin on serves matter most. Engage lists a raw Toray T700 carbon fiber skin and a 5/8-inch core, and Pickleball Central lists the elongated model at 16.5 by 7.5 inches with a 16mm core and an average weight of 8.0 ounces for the standard version or about 7.75 ounces for the LITE. Engage's own pages give a standard weight range of 8.0 to 8.3 ounces, so expect some spread. The two weight options are useful: the LITE suits players who want faster hands or are sensitive in the arm, while the standard weight adds stability on hard-hit balls. Note that Engage sells Hybrid and Widebody variants under the same 6.0 name with a different core thickness, about 15.2mm on the Hybrid per Pickleball Central, so check the shape on the listing.",
    "pros": [
      "Raw Toray T700 carbon skin, per Engage",
      "Elongated 16.5 x 7.5 in shape for reach and serve leverage",
      "Standard and LITE weights",
      "About 16mm core for control"
    ],
    "cons": [
      "Hybrid and Widebody versions share the 6.0 name but differ",
      "Weight ranges differ between Engage and retailers",
      "Elongated shape trades away some hand speed"
    ],
    "bottomLine": "For an elongated raw carbon paddle with a choice of weights, the Engage Pursuit Pro1 6.0 Elongated is a strong option, provided you confirm the shape and weight version."
  },
  {
    "id": "crbn-1x-16mm",
    "name": "CRBN 1X Power Series 16mm",
    "badge": "Best Raw Carbon Elongated",
    "category": "Raw T700 Carbon, 16mm, Elongated",
    "amazonUrl": "#",
    "description": "CRBN built its name on raw carbon paddles, and the 1X is its elongated model. Tennis Warehouse lists a 16.5-inch length, a 7.5-inch width, a 16mm polypropylene honeycomb core, a raw T700 carbon fiber face and foam-injected edge walls, with an average weight of about 8.0 ounces; Pickleball Central lists 8.1 to 8.3 ounces. Foam in the edge walls is meant to steady off-center hits, which helps when you brush up the back of the ball and catch it high on the face. Grip size is listed between 4.25 and 4.375 inches depending on the retailer, which makes it a better fit for larger hands. One caution: USA Pickleball removed CRBN paddles from its approved list in 2022, and reports since then about reinstatement are mixed. If you play sanctioned tournaments, look up the exact model on USA Pickleball's equipment list before buying.",
    "pros": [
      "Raw T700 carbon face, per retailers",
      "Foam-injected edge walls for stability on mishits",
      "Elongated 16.5 in shape",
      "Larger grip, listed at 4.25 to 4.375 in"
    ],
    "cons": [
      "Check current USA Pickleball approval before tournament use",
      "Weight listed at 8.0 to 8.3 oz depending on source",
      "Grip may feel thick for small hands"
    ],
    "bottomLine": "The CRBN 1X 16mm is a well-built elongated raw carbon paddle for recreational and club play; tournament players should confirm its listing on USA Pickleball's approved list first."
  },
  {
    "id": "vatic-pro-flash-16mm",
    "name": "Vatic Pro Flash 16mm",
    "badge": "Best Budget",
    "category": "Raw T700 Carbon, 16mm, Hybrid Shape",
    "amazonUrl": "#",
    "description": "The Vatic Pro Flash is the paddle that proved raw carbon spin does not have to cost $200 or more. Vatic describes a textured raw Toray T700 carbon fiber face in a unibody build, with a 16mm polymer honeycomb core, and lists an average weight of 8.0 to 8.2 ounces for the 16mm. Retailers list a length of about 16.2 to 16.3 inches and a width of 7.7 inches, a slightly wide hybrid shape that keeps the sweet spot generous. Grip circumference is given as 4.125 inches by Vatic and 4.25 by one retailer. Retailers and reviewers list it as USA Pickleball approved. Prices vary with the naming, around $100 for the Prism Flash version and more for the original Flash, so compare listings. It is the sensible first raw carbon paddle for an improving player who wants to learn what a textured face does before spending more.",
    "pros": [
      "Textured raw T700 carbon face at a budget price, per Vatic",
      "16mm core for control",
      "Wide 7.7 in face for a forgiving sweet spot",
      "Listed as USA Pickleball approved by retailers"
    ],
    "cons": [
      "Prism Flash and Flash naming makes price comparisons confusing",
      "Grip size listed differently by Vatic and retailers",
      "Fewer pro-level refinements than premium paddles"
    ],
    "bottomLine": "The Vatic Pro Flash 16mm gives you a textured raw carbon face and a control core for roughly half the price of a premium paddle, which makes it the easy budget pick."
  },
  {
    "id": "head-radical-tour-raw",
    "name": "HEAD Radical Tour Raw",
    "badge": "Softest Feel",
    "category": "Raw Carbon, 15mm, Standard Shape",
    "amazonUrl": "#",
    "description": "The HEAD Radical Tour Raw is the pick for players who want a raw carbon face but a softer, more comfortable feel than most spin paddles. Retailer listings for the 2024 model give a 15mm core, an average weight of about 7.9 ounces and a length of about 16 1/16 inches, with a raw carbon face that HEAD and retailers describe as soft and comfortable on contact. The slightly thinner 15mm core adds a touch more pop than 16mm control paddles, while the standard length keeps it quick at the net. HEAD has since released newer Radical models, including a TOUR15 with a 15mm core and T700 face, so the name now covers several paddles; check the year and version on the listing. It is a good fit for former tennis players who want the HEAD feel and a face that grips the ball without a stiff, harsh response.",
    "pros": [
      "Raw carbon face with a softer feel, per HEAD and retailers",
      "About 7.9 oz average for the 2024 model",
      "15mm core balances control and pop",
      "Standard length stays quick at the kitchen"
    ],
    "cons": [
      "Several Radical Tour versions with different specs",
      "Standard length offers less reach than elongated paddles",
      "Fewer specs published than some rivals"
    ],
    "bottomLine": "If you want raw carbon spin with a softer, more comfortable response, the HEAD Radical Tour Raw is worth a look; confirm the model year before you buy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pickleball Paddles for Spin",
          item: "https://www.thehonestreviewers.com/best-pickleball-paddle-for-spin/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best pickleball paddle for spin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most players, the Six Zero Double Black Diamond Control 16mm is our pick. Six Zero lists a raw Toray 700K carbon face, and retailers list a 16mm core, a hybrid length of about 16.3 inches and an average weight around 8.1 ounces. That combination grips the ball well and stays quick at the net. Budget buyers should look at the Vatic Pro Flash 16mm."
          }
        },
        {
          "@type": "Question",
          "name": "Do raw carbon paddles really give more spin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raw carbon faces are textured and unpainted, so the ball grips rather than skids when you brush across it. That lets more of your swing's spin transfer to the ball than a smooth painted or fiberglass face. The paddle does not create spin on its own, though: your swing path and paddle speed still produce most of it."
          }
        },
        {
          "@type": "Question",
          "name": "Is 14mm or 16mm better for spin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many players find 16mm cores easier for spin on soft shots because they feel softer and hold the ball a fraction longer, which helps shape dinks and drops. Thinner 13 to 14mm cores add pop on drives. Choose based on whether your game leans toward control or power, then pick a textured carbon face."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the grit on a spin paddle last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on how often you play, whether you play outdoors and how the texture was made. Players who play several times a week often report a noticeable loss of grip after a few months. Wiping the face after play and avoiding court scrapes slows the wear, but texture does not last forever."
          }
        },
        {
          "@type": "Question",
          "name": "Are spin paddles legal in tournaments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as the exact model is on USA Pickleball's approved list and the face has not been altered. USA Pickleball caps surface roughness, and reports in 2025 and 2026 describe a move toward a spin-rate test. Check the current equipment standards and the approved list before a sanctioned event."
          }
        },
        {
          "@type": "Question",
          "name": "Can I add grip to my paddle face for more spin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Adding coatings, tape or abrasives to the hitting face can make the paddle illegal for sanctioned play and can damage the carbon. Clean the face with a damp microfiber cloth to remove dust and grime instead, and replace the paddle when the texture is worn out."
          }
        },
        {
          "@type": "Question",
          "name": "Is a spin paddle good for beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A raw carbon paddle is fine for beginners, and many budget options like the Vatic Pro Flash cost about the same as older fiberglass paddles. But beginners gain more from consistency and placement than from spin. A 16mm control paddle with a forgiving sweet spot is a sensible first choice either way."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Outdoor Gear",
    tags: [
      "best pickleball paddle for spin",
      "spin pickleball paddle",
      "raw carbon fiber pickleball paddle",
      "best carbon fiber pickleball paddle",
      "textured pickleball paddle",
      "pickleball paddle grit"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Buyer's Guide
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Pickleball Paddles <span class="text-[#38BDF8]">for Spin</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Six raw and textured carbon paddles that give your topspin and slice something to bite with, and the honest limits of what a paddle face can do.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#six-zero-double-black-diamond-control-16mm"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#how-spin-works"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How Spin Really Works
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-chose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Chose</a>
          <a href="#how-spin-works" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How a Paddle Creates Spin</a>
          <a href="#texture-and-wear" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Grit, Texture and Wear</a>
          <a href="#rules" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What the Rules Allow</a>
          <a href="#shape-and-weight" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Shape, Weight and Swing Speed</a>
          <a href="#thermoformed" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Thermoformed or Not</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Technique Beats Texture</a>
          <a href="#buying-checklist" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Buying Checklist</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A spin paddle does one thing: it gives the ball something to grip for the few milliseconds it sits on the face. Raw carbon fiber does that better than smooth fiberglass or painted graphite, and the paddles below all use it. But the face is only half the story. Swing path, paddle speed and contact point produce most of your spin, the grit wears down with play, and the rules cap how rough a face can be. Buy a textured carbon paddle for the bite, then put the work into the stroke.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-chose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Chose These Six
          </h2>

          <p>
            Search for a spin paddle and you will find hundreds of raw carbon faces that look almost identical in photos. The differences that matter sit underneath the face: core thickness, shape, weight, grip size and whether the paddle is on the USA Pickleball approved list. We narrowed the field to paddles that use a raw or textured carbon face from an established brand, publish their core, weight and dimensions, and are widely sold in the United States. We have not measured spin rates ourselves, so every number on this page is attributed to the manufacturer or a major retailer, and we flag where listings disagree.
          </p>

          <p>
            We then picked six that cover the real choices a player faces. There is a control-first hybrid paddle for players who want spin on soft shots, an elongated power-and-spin option, two more elongated paddles with different weights and grip sizes, a budget raw carbon paddle and a softer-feeling 15mm option for players who dislike the stiff response of many carbon faces. Our full ranking of every style of paddle lives in our guide to the <a href="/best-pickleball-paddle/">best pickleball paddles</a>, and this page focuses on the spin question alone.
          </p>

          <p>
            One honest note before the picks. A paddle face cannot add spin you are not creating with your swing. What a textured carbon face does is let the ball grip rather than skid, so the spin your stroke produces actually transfers to the ball. That is a real advantage, and it is the reason all six picks use carbon, but it is not a shortcut around technique. The section on technique below explains where most of your spin comes from.
          </p>

          <p>
            If you are still deciding between face materials, our comparison of <a href="/carbon-fiber-vs-fiberglass-pickleball-paddle/">carbon fiber vs fiberglass pickleball paddles</a> covers the trade-offs in more depth, including why fiberglass can feel livelier but grips the ball less.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Our 6 Picks for Spin
          </h2>

          <p>
            We have not lab-tested these paddles or measured spin rates. Every spec below comes from the manufacturer or major retailers, and we note where listings disagree. The six cover a control-first standard paddle, a pro-level power and spin option, two elongated reach paddles, a budget raw carbon pick and a softer-feeling 15mm option.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
