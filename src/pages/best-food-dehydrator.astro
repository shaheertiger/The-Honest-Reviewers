const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Food Dehydrators",
          item: "https://www.thehonestreviewers.com/best-food-dehydrator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best food dehydrator for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most kitchens, a mid-sized stainless shelf dehydrator with a timer is the best balance, such as the Nesco FD-7SSD, which Nesco lists at 600 watts with a 90 to 160 degree range and a 24-hour timer. If you are starting on a budget, an expandable stackable like the Nesco Snackmaster Pro is a good entry point."
          }
        },
        {
          "@type": "Question",
          "name": "Is a stainless steel dehydrator better than plastic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stainless cabinets and steel trays are more durable, resist staining and odors better, and often clean more easily. Plastic models are lighter and cheaper and work well. The bigger performance difference is usually airflow design, shelf versus stackable, rather than the material itself."
          }
        },
        {
          "@type": "Question",
          "name": "Can you make jerky in a food dehydrator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as the machine reaches a suitable temperature and you follow current food safety guidance. The USDA advises heating meat to a safe internal temperature as part of making jerky. Check your dehydrator's maximum temperature, which is 160°F on the Nesco models here, and use a thermometer."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to dehydrate food?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the food, slice thickness, humidity and the machine. Herbs can take a few hours, fruit often takes several hours to overnight, and jerky commonly takes several hours. Follow your dehydrator's manual and recipe book, and check food regularly rather than relying on a fixed time."
          }
        },
        {
          "@type": "Question",
          "name": "How much electricity does a dehydrator use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Multiply wattage by hours for the maximum. A 600-watt unit running 10 hours uses up to 6 kilowatt-hours, or roughly $1 at an assumed 17 cents per kilowatt-hour. Thermostats cycle the heater, so real use is usually lower. Larger machines use more power but dry more food per run."
          }
        },
        {
          "@type": "Question",
          "name": "Are stackable dehydrators any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for many people. They are affordable, compact and often expandable, like the Nesco Snackmaster Pro, which Nesco says expands from 5 to 12 trays. The trade-off is that trays nearest the fan may dry faster, so you may need to rotate them. A top-mounted fan keeps drips out of the heater."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use my oven instead of a dehydrator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some ovens have a low-temperature or dehydrate setting and can work for small batches. Many ovens do not hold low temperatures steadily, though, and running an oven for many hours uses more energy and ties up the kitchen. A dehydrator is designed for long, low, even drying with steady airflow."
