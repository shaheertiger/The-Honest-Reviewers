  },
  {
    "id": "fritaire-glass-air-fryer-pro",
    "name": "Fritaire Glass Air Fryer 9-in-1 Pro",
    "category": "5-Quart Glass Bowl",
    "badge": "Glass Bowl Alternative",
    "amazonUrl": "#",
    "pros": [
      "5-quart tempered glass bowl gives a full 360° view of the food",
      "Listings describe a rotisserie spit and a tumbling basket in the 9-in-1 Pro",
