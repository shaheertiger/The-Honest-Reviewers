];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "Ninja Crispi Air Fryer Review (2026): Glass, Pros and Cons";
const description =
  "Ninja Crispi review: what Ninja lists for the glass containers, PowerPod, 450°F max and functions, the real pros and cons, and four compact alternatives.";

