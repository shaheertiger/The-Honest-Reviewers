---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Electric Pressure Washers", url: "/best-electric-pressure-washer/" },
    { title: "What PSI Do I Need?", url: "/what-psi-pressure-washer-do-i-need/" },
    { title: "Nozzle Colors Explained", url: "/pressure-washer-nozzle-colors-explained/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-06", modified: "2026-09-06" });
const title = "How to Pressure Wash Vinyl Siding Safely";
const description =
  "1,500 to 2,000 PSI, a wide nozzle, and never spray upward under the laps. The technique that cleans siding without driving water into the wall.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Pressure Wash Vinyl Siding",
          item: "https://www.thehonestreviewers.com/how-to-pressure-wash-vinyl-siding/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What PSI should I use on vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "1,500 to 2,000 PSI with a 40 degree white or 25 degree green nozzle, starting with the wider tip about ten feet back and closing in gradually. That range is comfortably inside what any mid-market electric machine delivers, which is why siding is the job electric washers do best.",
          },
        },
        {
          "@type": "Question",
          name: "Can pressure washing damage vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The boards themselves are fairly tough. The real damage is water driven behind them by an upward-angled stream, which soaks sheathing and insulation inside the wall and shows up months later as damp, mould or rot. Keep the stream angled downward or level, never up under the laps.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best cleaner for vinyl siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A dedicated house wash solution applied through the black soap nozzle, which is the only tip that lets the detergent siphon engage. Siding dirt is mostly organic growth and atmospheric film, which chemistry removes far more effectively and far more safely than additional pressure.",
          },
        },
        {
          "@type": "Question",
          name: "Should I wash siding from the top down or bottom up?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both, in that order. Apply the cleaner from the bottom up so it cannot run down dry siding and streak, let it dwell for several minutes, then rinse from the top down so dirt runs onto surfaces you have not yet finished rather than onto clean ones.",
          },
        },
        {
          "@type": "Question",
          name: "How do I clean second-storey siding safely?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "With a telescoping extension wand from the ground. Never operate a pressure washer from a ladder: the recoil is exactly the force that causes falls. An extension wand costs very little, removes the risk completely, and gives you a better working angle than a ladder does.",
          },
        },
        {
          "@type": "Question",
          name: "Can I pressure wash the roof while I am up there?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Asphalt shingles carry mineral granules that provide their UV protection and most of their service life, and pressure strips them permanently. The damage is invisible from the ground. Roof cleaning is a low-pressure chemical job and a completely different task from washing siding.",
          },
        },
        {
          "@type": "Question",
          name: "How do I remove tiger striping on gutters?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "With a dedicated gutter cleaner and dwell time, plus a soft brush. The striping is a bonded film of oxidised residue that pressure does not remove, so increasing pressure only damages the fascia and trim behind it while leaving the marks in place.",
          },
        },
        {
          "@type": "Question",
          name: "How often should I wash my siding?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically once a year, and more often on shaded elevations where algae and green growth build up faster. The north side of most houses needs attention before the rest, and it is often the only elevation that genuinely needs a second application of cleaner.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Tools & Equipment",
    tags: [
      "how to pressure wash vinyl siding",
      "pressure wash house siding",
      "cleaning vinyl siding",
      "tools & equipment",
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Electric Pressure Washers",
    link: "/best-electric-pressure-washer/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            How-To
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Field Tested
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          How to Pressure Wash <span class="text-[#38BDF8]">Vinyl Siding</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The damage that matters here is the damage you cannot see. Spraying upward under lap siding drives water behind the boards and into the wall, and it does not announce itself for months.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#settings"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See the Method
          </a>
          <a
            href="#faq"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the FAQ
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="13.5k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#settings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Settings</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Chemistry First</a>
          <a href="#preparation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Preparation</a>
          <a href="#method" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Method</a>
          <a href="#gutters-and-trim" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Gutters and Trim</a>
          <a href="#machine" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. The Right Machine</a>
          <a href="#when-not-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. When Not To</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Siding is the job electric pressure washers are best at, because it needs modest pressure and gravity does half the work. It is also the job with the most consequential failure mode, and almost nobody who commits it finds out until the following spring.
        </p>

        <div id="settings" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Pressure, Nozzle and Distance
          </h2>

          <p>
            Vinyl siding wants 1,500 to 2,000 PSI with a 40 degree white or 25 degree green nozzle. That is comfortably inside the range of any mid-market electric machine, and it is one of the reasons a modest machine is entirely adequate for house washing.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Surface</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pressure</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Nozzle</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vinyl siding</td>
                    <td class="px-4 py-4 text-gray-700">1,500-2,000 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg; or 25&deg;</td>
                    <td class="px-4 py-4 text-gray-700">Start with 40&deg; and step down only if needed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fiber cement siding</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg;</td>
                    <td class="px-4 py-4 text-gray-700">More brittle; keep pressure low</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Painted wood siding</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg;</td>
                    <td class="px-4 py-4 text-gray-700">Paint lifts easily; test first</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Aluminium siding</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg;</td>
                    <td class="px-4 py-4 text-gray-700">Dents and chalks; be gentle</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Soffits and fascia</td>
                    <td class="px-4 py-4 text-gray-700">1,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">40&deg;</td>
                    <td class="px-4 py-4 text-gray-700">Use an extension wand, never a ladder</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brick with sound mortar</td>
                    <td class="px-4 py-4 text-gray-700">2,000-2,500 PSI</td>
                    <td class="px-4 py-4 text-gray-700">25&deg;</td>
                    <td class="px-4 py-4 text-gray-700">Stop immediately if mortar washes out</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Distance does as much work as the setting. Start about ten feet back with the widest nozzle you have, close in gradually while watching how the siding responds, and step down one nozzle angle only if the wide tip at a reasonable distance genuinely will not shift the dirt.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Rule That Matters Most</p>
            <p class="text-xl font-bold text-white mb-3">Never spray upward under the laps.</p>
            <p class="text-gray-300 leading-relaxed m-0">Lap siding overlaps downward to shed rain. A stream angled upward gets under that overlap and drives water behind the boards into the wall cavity, where it soaks sheathing and insulation with nowhere to dry. It causes no visible damage on the day and shows up as damp, mould or rot months later. Keep the stream angled downward or level on vertical surfaces, always.</p>
          </div>
        </div>

        <div id="chemistry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Let the Cleaner Do the Work
          </h2>

          <p>
            The dirt on siding is mostly organic: algae, mildew, green growth on the shaded north side, plus atmospheric grime. All of that breaks down chemically far more readily than it breaks off mechanically, which is why a house wash solution matters more than the machine.
          </p>

          <p>
            Apply the cleaner with the black soap nozzle, which is the only tip that lets the detergent siphon engage at all. Trying to apply soap through a high-pressure tip simply will not draw it, and that is the most common reason people conclude their detergent system is broken.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pre-wet the siding and, importantly, the plants and lawn below it, which protects them and stops the cleaner from concentrating on foliage.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Apply the cleaner from the bottom up, so it cannot run down dry siding and leave streaks that are difficult to remove.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Let it dwell for several minutes without drying, which is where the actual cleaning happens.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Re-wet the surface if it starts to dry, particularly in sun or wind.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse from the top down, so the dirt has somewhere to go and you are not re-soiling clean siding.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse the surrounding plants thoroughly again when you finish.</span>
            </li>
          </ul>

          <p>
            That bottom-up, then top-down sequence is counterintuitive and it is the difference between an even result and a streaked one. Cleaner running down dry siding leaves tracks; water running down already-wet siding does not.
          </p>

          <p>
            On heavy green growth, expect to need a dedicated product rather than general purpose soap, and expect a second application on the north side. Chemistry costs a few dollars and works on exactly the soils that dominate house washing, which is why reaching for more pressure instead is both less effective and riskier.
          </p>
        </div>

        <div id="preparation" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What to Do Before You Start
          </h2>

          <p>
            House washing touches more vulnerable things than any other pressure washing job, because a wall is full of openings, fittings and services. Fifteen minutes of preparation prevents almost all of the trouble.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Close every window and door, and check the ones nobody opens, like a basement hopper or a garage side window.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Cover outdoor outlets, light fixtures, doorbells, cameras and any exterior speaker. None of these are rated for a directed stream.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Turn off power to exterior circuits at the panel if you are working near fixtures or outlets.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Cover or move light furniture, cushions, and anything on a deck below the work area.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pre-wet plants and shrubs thoroughly, and consider covering delicate ones with sheeting.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Look for loose or damaged siding boards and note them; pressure will find them and make them worse.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Check for existing gaps at window trim and utility penetrations, which are direct routes into the wall.</span>
            </li>
          </ul>

          <p>
            Take the loose board check seriously. A cracked or unclipped siding panel is a hole in the building envelope, and water directed at it goes straight into the wall regardless of how careful your angle is. Fix it or work around it, but do not wash over it and hope.
          </p>

          <p>
            On an older house, be alert to lead paint. Any painted surface predating 1978 may contain it, and pressure washing disperses paint chips and dust across the garden and into the soil. That is a job with its own rules, and a pressure washer is the wrong tool for it.
          </p>
        </div>

        <div id="method" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. The Washing Method
          </h2>

          <p>
            Work in sections roughly ten to fifteen feet wide, completing each fully before moving on, so nothing dries partway through the process.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Work Top to Bottom on the Rinse</h3>

          <p>
            Once the cleaner has dwelled, rinse from the top of the section downward. Dirt then runs onto surfaces you have not yet cleaned rather than onto ones you have. Working upward means rinsing dirty water over finished siding and doing it twice.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Keep the Wand Moving</h3>

          <p>
            Cleaning is a function of dwell time as much as pressure, so a stationary stream removes progressively more from one spot. Sweep in steady, overlapping passes at a constant distance and angle. Pausing mid-stroke is what produces the striping people blame on the machine.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Hold the Angle Down or Level</h3>

          <p>
            Approach each course of siding with the stream angled slightly downward or straight on, never up. On the highest course you can reach comfortably, this is easy. It gets harder as you reach up, which is exactly why an extension wand matters more than reach does.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Use an Extension Wand, Never a Ladder</h3>

          <p>
            A telescoping wand lets you reach second-storey siding and soffits from the ground. Using a pressure washer from a ladder is genuinely dangerous, because the recoil is exactly the force that puts people on the ground, and an inexpensive extension eliminates that risk entirely.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Rinse Everything Below When You Finish</h3>

          <p>
            Cleaner running down onto windows, decking and plants will dry there and leave marks. A final rinse of the surrounding area is part of the job rather than an afterthought, and it takes two minutes.
          </p>
        </div>

        <div id="gutters-and-trim" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Gutters, Soffits and Trim
          </h2>

          <p>
            The area where the wall meets the roof collects the worst of the growth and contains the most vulnerable details. It needs the gentlest approach on the house.
          </p>

          <p>
            Gutter faces develop tiger striping, a bonded film of oxidised residue that pressure alone does not remove. It needs a dedicated gutter cleaner and dwell time; increasing pressure will not shift it and will damage the trim and fascia behind it.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Rinse soffits at low pressure with a 40 degree tip, working across rather than jabbing upward into the vents.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Never drive water into soffit vents, which lead directly into the roof space.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Keep the stream off the roof edge and shingles entirely, because pressure strips their protective granules.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Use a gutter cleaner and a soft brush on striping, rather than more pressure.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Do not spray into gutter joints and seams, which will separate.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Watch for wasp and bird nests in soffits before you start, not after.</span>
            </li>
          </ul>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">The Roof Is Not on the List</p>
            <p class="text-xl font-bold text-white mb-3">Never pressure wash shingles, at any setting.</p>
            <p class="text-gray-300 leading-relaxed m-0">Asphalt shingles carry a layer of mineral granules that provide their UV protection and most of their service life. Pressure strips those granules, and the damage is invisible from the ground and entirely permanent. Roof cleaning is a low-pressure chemical job, and it is a different job from washing siding.</p>
          </div>
        </div>

        <div id="machine" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. The Right Machine for House Washing
          </h2>

          <p>
            House washing is the job that makes the case for electric machines most clearly, because everything the job needs is inside their range and everything a gas machine adds is unusable here.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Pressure in the 1,500 to 2,300 PSI range is ample. More is capability you will deliberately avoid using.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>Flow matters more than pressure, because rinsing a large vertical area is a volume job and gravity does the clearing.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A working detergent siphon and a black soap nozzle are essential, since chemistry does most of the cleaning.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A long high-pressure hose beats a long power cord, because you will be moving around the whole building.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>A telescoping extension wand is close to mandatory on a two-storey house, and it costs far less than a fall.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span>An induction motor is worth having for a job that takes hours rather than minutes.</span>
            </li>
          </ul>

          <p>
            Note the second point in particular. On siding, gravity helps carry debris downward, so flow is doing the useful work and pressure only needs to be enough to lift the loosened film. That is exactly the profile a mid-range electric machine fits, and it is why the gas advantage on driveways does not translate here. Our comparison of <a href="/electric-vs-gas-pressure-washer/">electric versus gas machines</a> sets out where the difference actually lies.
          </p>

          <p>
            On the electrical side, keep the machine near a GFCI outlet on a short heavy-gauge cord and gain reach with hose rather than cable. Dragging a long thin extension cord around a wet house is both a shock hazard and a slow way to kill the motor. Our <a href="/pressure-washer-extension-cord-size/">cord sizing guide</a> covers the gauges.
          </p>
        </div>

        <div id="when-not-to" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. When Not to Pressure Wash Siding at All
          </h2>

          <p>
            Some walls should be cleaned by other means, and recognising them beforehand saves an expensive repair.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Situation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why Not</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Do This Instead</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Paint predating 1978</td>
                    <td class="px-4 py-4 text-gray-700">Disperses lead paint chips and dust</td>
                    <td class="px-4 py-4 text-gray-700">Follow lead-safe practices; do not wash</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Peeling or failing paint</td>
                    <td class="px-4 py-4 text-gray-700">Pressure strips it in sheets</td>
                    <td class="px-4 py-4 text-gray-700">Scrape, prep and repaint</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Loose or cracked siding boards</td>
                    <td class="px-4 py-4 text-gray-700">Water goes straight into the wall</td>
                    <td class="px-4 py-4 text-gray-700">Repair first, then wash</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Old or soft mortar on masonry</td>
                    <td class="px-4 py-4 text-gray-700">Joints wash out</td>
                    <td class="px-4 py-4 text-gray-700">Soft wash with chemistry only</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stucco and EIFS</td>
                    <td class="px-4 py-4 text-gray-700">Easily damaged and hard to repair</td>
                    <td class="px-4 py-4 text-gray-700">Low-pressure soft wash</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Known water ingress at windows</td>
                    <td class="px-4 py-4 text-gray-700">You will make it much worse</td>
                    <td class="px-4 py-4 text-gray-700">Fix the flashing first</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Any work needing a ladder</td>
                    <td class="px-4 py-4 text-gray-700">Recoil causes falls</td>
                    <td class="px-4 py-4 text-gray-700">Extension wand, or hire a professional</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The common thread is that pressure washing assumes an intact building envelope. Where the envelope is already compromised, by failing paint, loose boards, soft mortar or bad flashing, adding pressurised water finds the weakness rather than cleaning around it.
          </p>

          <p>
            That is what professionals mean by soft washing: applying cleaning chemistry at garden hose pressure and rinsing gently, letting the chemicals do everything. It is slower, and on a fragile or elderly wall it is the correct method. Our list of <a href="/what-not-to-pressure-wash/">surfaces to never pressure wash</a> covers the rest of the house.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            8. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Spraying Upward Under the Laps</h3>
              <p class="text-gray-700 text-sm m-0">
                Lap siding overlaps downward to shed rain, so an upward stream gets behind the boards and drives water into the wall cavity, soaking sheathing and insulation with no way to dry. There is no visible damage on the day, which is exactly why this mistake gets repeated until it shows up as rot.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Applying Cleaner From the Top Down</h3>
              <p class="text-gray-700 text-sm m-0">
                Detergent running down dry siding leaves streaks that are harder to remove than the original dirt. Apply from the bottom up onto pre-wetted siding so it cannot track, let it dwell, then rinse from the top down so the dirt has somewhere to go.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Working From a Ladder</h3>
              <p class="text-gray-700 text-sm m-0">
                A pressure washer pushes back hard, and that recoil is precisely the force that puts people off ladders. A telescoping extension wand reaches second-storey siding and soffits from the ground for a fraction of the cost of an emergency room visit, and it does the job better anyway.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Reaching for Pressure Instead of a Cleaner</h3>
              <p class="text-gray-700 text-sm m-0">
                Siding dirt is mostly algae, mildew and organic film, all of which break down chemically far more easily than mechanically. A house wash solution left to dwell removes more than another 800 PSI will, and it does it without risking the boards, the trim or the wall behind them.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Forgetting Outlets, Fixtures and Vents</h3>
              <p class="text-gray-700 text-sm m-0">
                Outdoor outlets, light fixtures, doorbells, cameras and soffit vents are weatherproof against rain, not against a directed stream. Cover them, turn off exterior circuits at the panel where you are working close, and never jab water upward into soffit vents, which open into the roof space.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            9. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What PSI should I use on vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                1,500 to 2,000 PSI with a 40 degree white or 25 degree green nozzle, starting with the wider tip about ten feet back and closing in gradually. That range is comfortably inside what any mid-market electric machine delivers, which is why siding is the job electric washers do best.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can pressure washing damage vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The boards themselves are fairly tough. The real damage is water driven behind them by an upward-angled stream, which soaks sheathing and insulation inside the wall and shows up months later as damp, mould or rot. Keep the stream angled downward or level, never up under the laps.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the best cleaner for vinyl siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                A dedicated house wash solution applied through the black soap nozzle, which is the only tip that lets the detergent siphon engage. Siding dirt is mostly organic growth and atmospheric film, which chemistry removes far more effectively and far more safely than additional pressure.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should I wash siding from the top down or bottom up?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Both, in that order. Apply the cleaner from the bottom up so it cannot run down dry siding and streak, let it dwell for several minutes, then rinse from the top down so dirt runs onto surfaces you have not yet finished rather than onto clean ones.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I clean second-storey siding safely?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                With a telescoping extension wand from the ground. Never operate a pressure washer from a ladder: the recoil is exactly the force that causes falls. An extension wand costs very little, removes the risk completely, and gives you a better working angle than a ladder does.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I pressure wash the roof while I am up there?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Asphalt shingles carry mineral granules that provide their UV protection and most of their service life, and pressure strips them permanently. The damage is invisible from the ground. Roof cleaning is a low-pressure chemical job and a completely different task from washing siding.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How do I remove tiger striping on gutters?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                With a dedicated gutter cleaner and dwell time, plus a soft brush. The striping is a bonded film of oxidised residue that pressure does not remove, so increasing pressure only damages the fascia and trim behind it while leaving the marks in place.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How often should I wash my siding?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Typically once a year, and more often on shaded elevations where algae and green growth build up faster. The north side of most houses needs attention before the rest, and it is often the only elevation that genuinely needs a second application of cleaner.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">Related Pressure Washer Guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/best-electric-pressure-washer/" class="bg-gray-50 border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow no-underline group">
