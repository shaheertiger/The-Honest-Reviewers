const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Fire Pits",
          item: "https://www.thehonestreviewers.com/best-fire-pit/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do smokeless fire pits really work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They significantly reduce smoke once the fire is hot and burning dry wood, by burning off smoke with heated secondary air near the top of the pit. They still smoke while lighting and with damp wood, so wood quality matters as much as the design."
          }
        },
        {
          "@type": "Question",
          "name": "What size fire pit do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pit around 19 to 20 inches suits two to four people, around 24 to 27 inches suits four to eight, and larger pits suit big gatherings. A larger pit burns more wood, so size it for your usual group rather than occasional parties."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a fire pit during a burn ban?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wood fires are usually prohibited during burn bans. Some jurisdictions allow approved gas appliances with a shut-off valve during certain restrictions, but others ban all open flame. Always check the specific restriction with your local fire department."
          }
        },
        {
          "@type": "Question",
          "name": "How far should a fire pit be from my house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow the larger of your manufacturer's stated clearance and your local fire code. Keep the pit well away from walls, fences, overhangs and trees, and never use it under a covered porch or awning."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put a fire pit on a wooden deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no, unless the manufacturer specifically approves it with a particular stand or heat shield. Embers and radiant heat can damage or ignite wood and composite decking, so a stone, concrete or paver surface is much safer."
          }
        },
        {
          "@type": "Question",
          "name": "Is a propane fire pit as warm as a wood fire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Propane pits produce less radiant heat than a wood fire of similar size and are more about ambience. Their advantages are no smoke, no ash, instant on and off, and possible use during some burn restrictions."
          }
        },
        {
          "@type": "Question",
          "name": "How do I put out a fire pit safely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Let the fire burn down, then extinguish it with water or by smothering, and stir until the embers are cold to the touch, following your manufacturer's guidance. Store cold ash in a lidded metal container away from the house."
          }
        }
