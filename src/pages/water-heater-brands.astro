                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rheem</td>
                    <td class="px-4 py-4 text-gray-700">Rheem, Ruud, Richmond</td>
                    <td class="px-4 py-4 text-gray-700">Home Depot, Menards, pro distributors</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">A.O. Smith</td>
                    <td class="px-4 py-4 text-gray-700">A.O. Smith, State, American, Lochinvar</td>
