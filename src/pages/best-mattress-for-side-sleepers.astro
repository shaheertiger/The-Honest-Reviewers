const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "7 Best Mattresses for Side Sleepers in 2026: Shoulder & Hip";
const description =
  "The best mattress for side sleepers, including side sleepers with hip pain or back pain, compared on shoulder and hip pressure relief, firmness by weight and foam vs hybrid.";

const PRODUCTS = [
