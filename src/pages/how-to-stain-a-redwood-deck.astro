                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Finish</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">On a redwood deck</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Main trade-off</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clear water repellent</td>
                    <td class="px-4 py-4 text-gray-700">Natural tan, greys in full sun</td>
