                    <td class="px-4 py-4 text-gray-700">Opaque colour</td>
                    <td class="px-4 py-4 text-gray-700">Wears and peels in traffic lanes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Paint</td>
                    <td class="px-4 py-4 text-gray-700">Opaque film</td>
