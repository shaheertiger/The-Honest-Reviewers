                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Bleaching stain</td>
                    <td class="px-4 py-4 text-gray-700">Even silver-grey</td>
                    <td class="px-4 py-4 text-gray-700">Lowest upkeep, loses the red</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Semi-transparent oil</td>
                    <td class="px-4 py-4 text-gray-700">Redwood tone, grain visible</td>
                    <td class="px-4 py-4 text-gray-700">Best balance for most decks</td>
                  </tr>
