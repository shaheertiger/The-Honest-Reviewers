];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 1500 Watt Generators",
          item: "https://www.thehonestreviewers.com/best-1500-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will a 1500 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 1,500-watt generator typically runs at about 1,000 to 1,200 watts, which covers a full-size refrigerator, LED lights, phones, laptops, a router, a TV and a CPAP. It can run a small coffee maker or a 5,000 BTU window AC on its own. It will not run a microwave, space heater on high, hair dryer or well pump."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 1500 watt generator run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes. A typical full-size refrigerator runs at 100 to 200 watts with a startup surge several times higher, and the 1,250 to 1,500-watt surge ratings in this class handle most modern fridges. Large side-by-sides and older units can be harder to start, so check the label or measure with a plug-in watt meter."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 1500 watt generator run a space heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a standard 1,500-watt heater on high. That draws 12.5 amps continuously, above the running rating of every generator in this class. A heater with a 750-watt low setting will run on a 1,000 to 1,200-watt unit, but runtime falls to a few hours and nothing else can share the power."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a 1200 and a 1500 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually about 100 to 300 running watts. A 1,200-watt unit typically runs at 900 to 1,000 watts; a 1,500-watt unit at 1,000 to 1,200. The extra matters for starting a refrigerator alongside other loads or running a small window AC. Compare running watts, not the peak number on the box."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a CPAP on a 1500 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on an inverter. A CPAP without heated humidification typically draws 30 to 60 watts, a small fraction of any generator here. Use an inverter rather than a conventional two-stroke for its cleaner power. Many CPAP users run the machine from a battery power station indoors and use the generator outside to recharge it."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 1500 watt generator run on a tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the load. Westinghouse rates the iGen1500c at up to 12 hours at quarter load on 0.79 gallons. The Honda EU1000i is rated at 7.1 hours at quarter load and 3.2 at rated load. The WEN 56125i and Pulsar PG1500iS are listed at about 5 hours at half load."
          }
        },
        {
          "@type": "Question",
          "name": "Can you parallel two 1500 watt generators?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some, yes. Westinghouse lists the iGen1500c as parallel capable, and the WEN 56125i manual shows parallel ports. Two 1,000-watt running units give roughly 2,000 running watts together. Use two identical units and the manufacturer's parallel kit, which is often sold separately. Not every small generator supports parallel, so check before buying."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

