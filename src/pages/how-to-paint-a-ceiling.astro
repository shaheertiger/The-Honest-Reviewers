const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Paint a Ceiling",
          item: "https://www.thehonestreviewers.com/how-to-paint-a-ceiling/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Should you paint the ceiling or the walls first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paint the ceiling first. Drips and roller spatter from the ceiling inevitably land on the walls, and cutting in the ceiling slightly onto the wall is easy to cover when you paint the walls afterward. If the walls are staying as they are, tape them at the ceiling line or cut in carefully with a good angled brush."
          }
        },
        {
          "@type": "Question",
          "name": "Which direction should you roll a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spread the paint however is comfortable, but make the final light pass in each section parallel to the main source of daylight, usually the largest window wall. Roller texture that runs with the light is far less visible than texture running across it. Keep every finishing stroke in that same direction across the whole ceiling."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to prime a ceiling before painting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. A clean, sound ceiling being repainted in a similar color usually needs only spot priming over patches. New drywall needs a drywall primer, and water stains, smoke or nicotine discoloration need a stain-blocking primer. Glossy or oil-based ceilings need a bonding primer so latex paint adheres properly."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of paint does a ceiling need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most ceilings look best with two coats. One coat can be enough when you are refreshing the same white over clean, sound paint, but inspect it in daylight before deciding. Color changes, new drywall and stained ceilings all need a primer and two finish coats for an even result."
          }
        },
        {
          "@type": "Question",
          "name": "What size roller nap is best for a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 3/8-inch nap is the usual choice for smooth drywall ceilings because it carries plenty of paint without leaving heavy stipple. Use a 1/2-inch nap for light texture and a thicker nap for heavy texture. Popcorn ceilings are best tested first, because the texture can loosen when wet."
          }
        },
        {
          "@type": "Question",
          "name": "How do you avoid lap marks on a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keep a wet edge by working in small sections and rolling each new section into the last while it is still wet. Close windows and turn off fans that speed drying, keep the roller fully loaded and do not stop partway across the ceiling. Finish each section with light strokes in one direction."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint a ceiling without a ladder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mostly, yes. An extension pole lets you roll a standard eight- or nine-foot ceiling from the floor, which is safer and keeps paint out of your face. You will still want a step ladder for cutting in along the edges and around fixtures, unless you use an edging tool on a pole."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
