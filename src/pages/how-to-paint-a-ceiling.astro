    "title": "Best Primers",
    "url": "/best-primer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-18", modified: "2026-10-18" });
const title = "How to Paint a Ceiling: The Order, the Tools and the Wet Edge That Matter";
const description =
