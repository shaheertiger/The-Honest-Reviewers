---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Largest Portable Generators",
    "url": "/best-largest-portable-generator/"
  },
  {
    "title": "Best Whole House Generators",
    "url": "/best-whole-house-generator/"
  },
  {
    "title": "Best 12000 Watt Generators",
    "url": "/best-12000-watt-generator/"
  },
  {
    "title": "Transfer Switch Types and Cost",
    "url": "/generator-transfer-switch-types-cost-and-installation/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 20,000 Watt Generators in 2026: True Running Watts Ranked";
const description =
  "The best 20,000-watt generators, ranked by real running watts, plus the 50-amp inlet limit, 500 lb weights, fuel burn, and when a standby is the better buy.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen20000c",
    "name": "Westinghouse WGen20000c",
    "category": "Gas Open Frame, 20,000W Running / 28,000W Peak",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 640,
    "pros": [
      "A genuine 20,000 running watts on gasoline, with 28,000 peak for motor starts",
      "Two 14-50R outlets, two L14-30R and an L5-30 cover every common transfer switch and RV hookup",
      "17.2-gallon tank, rated for 14 hours at 25% load",
      "Remote electric start and a CO sensor that shuts the engine down",
      "3-year limited residential warranty"
    ],
    "cons": [
      "541 lb dry, so moving it is a two-person job on flat ground",
      "Gasoline only; listed at 74 dBA, and not CARB compliant"
    ],
    "bottomLine": "The plainest way to buy a true 20,000 running watts. Buy it if you have a 240V load list that justifies it and a flat path from storage to the run spot.",
    "description": "The WGen20000c is one of the few portables where the 20,000 on the box is the running figure, not the peak. Westinghouse rates it at 20,000 running and 28,000 peak watts from a 999cc V-twin, which is enough surge to start a central air compressor while a well pump and electric range are already on. The panel carries two 120/240V 14-50R outlets, two L14-30R, one L5-30 and two 5-20R duplexes, and the 17.2-gallon tank is rated for 14 hours at 25% load or 8 hours at 50%. Remote start with a key fob and a CO sensor are standard. The cost is mass: 541 pounds dry on never-flat wheels is a two-person job on concrete and close to impossible on a lawn after rain. It is also gas-only and not sold in California. If you already know you need more than 12,000 running watts, this is the simplest machine that delivers it."
  },
  {
    "id": "duromax-xp28000ih",
    "name": "DuroMax XP28000iH",
    "category": "Dual Fuel Inverter, 22,000W Running / 28,000W Peak",
    "badge": "Best Inverter",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 110,
    "pros": [
      "22,000 running watts on gasoline, the highest rating of any portable here",
      "Inverter output with an engine that slows down at light load",
