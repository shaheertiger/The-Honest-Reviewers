  },
  {
    "id": "duromax-xp15000hx",
    "name": "DuroMax XP15000HX",
    "category": "Dual Fuel Open Frame, 12,000W Running / 15,000W Peak",
    "badge": "Best Step-Down",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 950,
    "pros": [
      "12,000 running watts is the most a single 14-50 inlet can carry anyway",
      "345 lb dry, about 200 lb lighter than the 20kW Westinghouse",
      "Rated for 12 hours at 50% load from a 13.2-gallon tank",
      "Dual fuel with 11,400 running watts on propane; 5-year warranty"
