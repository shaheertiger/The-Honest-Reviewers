---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Whole-House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Whole House Fan vs Attic Fan",
    "url": "/whole-house-fan-vs-attic-fan/"
  },
  {
    "title": "Best Ceiling Fans With Lights",
    "url": "/best-ceiling-fans-with-lights/"
  },
  {
    "title": "Best Mini-Split Heat Pumps",
    "url": "/best-mini-split-heat-pump/"
  },
  {
    "title": "Best Dehumidifiers for Garages",
    "url": "/best-dehumidifier-for-garage/"
  },
  {
    "title": "Best Electric Fireplaces",
    "url": "/best-electric-fireplace/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "5 Best Evaporative Coolers: Swamp Cooler Picks for Dry Climates";
const description =
  "The best evaporative coolers for patios, garages and dry-climate homes, compared on airflow, coverage, tank size and pads, with an honest look at humidity limits.";

const PRODUCTS = [
  {
    "id": "hessaire-mc37m",
    "name": "Hessaire MC37M Evaporative Cooler",
    "badge": "Best Overall",
    "category": "Portable, Mid-Size",
    "amazonUrl": "#",
    "description": "The Hessaire MC37M is the cooler we would point most dry-climate homeowners to for a patio, open-plan room or garage. Retailer listings and review roundups consistently give it 3,100 CFM of airflow for spaces up to about 950 square feet, with a 10.3-gallon reservoir that listings estimate at three to four hours per fill. A float valve and garden-hose adapter let you run it continuously from a hose instead of refilling by hand, which is the feature that makes a cooler this size practical. Listings show three fan speeds, 115-volt power, a 59 dB noise figure and a weight of about 39 pounds, in a footprint of roughly 24 by 16 by 38 inches. We did not find an official Hessaire spec sheet for this exact model, so confirm figures with Hessaire if you are planning a specific installation.",
    "pros": [
      "3,100 CFM for up to about 950 sq ft per listings",
      "10.3-gallon reservoir plus continuous hose fill",
      "Three speeds on standard 115 V power",
      "About 39 lb, easy to roll between spaces"
    ],
    "cons": [
      "Figures come from retailers, not a Hessaire spec sheet",
      "Three to four hours per manual fill",
      "Less effective once relative humidity rises"
    ],
    "bottomLine": "The right size for most dry-climate patios and open rooms, and the hose connection removes the refilling chore."
  },
  {
    "id": "hessaire-mc18m",
    "name": "Hessaire MC18M Evaporative Cooler",
    "badge": "Best for Small Spaces",
    "category": "Portable, Compact",
    "amazonUrl": "#",
    "description": "The Hessaire MC18M is the smaller sibling, rated by retailers at 1,300 CFM for spaces up to 500 square feet. Most listings give a 4.8-gallon tank good for three to four hours, though one listing quotes a different runtime, so expect to refill it during a long afternoon. Its big advantage is efficiency: listings put it at 0.7 amps and 85 watts, which makes it very cheap to run. It weighs about 16 pounds and measures roughly 28 by 20 by 10 inches, with two fan speeds and three cooling pads. Hessaire's own material says evaporative coolers are most effective in dry climates with an average relative humidity of 40 percent or less, which is the most useful single sentence a manufacturer can give you about this category.",
    "pros": [
      "1,300 CFM for up to 500 sq ft per retailers",
      "About 85 W, so very low running cost",
      "16 lb and slim enough for a bedroom or office",
      "Three cooling pads"
    ],
    "cons": [
      "4.8-gallon tank needs regular refilling",
      "Only two fan speeds",
      "Small coverage for open-plan spaces"
    ],
    "bottomLine": "A light, frugal cooler for a single room or home office in a genuinely dry climate."
  },
  {
    "id": "honeywell-co30xe",
    "name": "Honeywell CO30XE Indoor/Outdoor Evaporative Cooler",
    "badge": "Best for One Room",
    "category": "Portable, Compact",
    "amazonUrl": "#",
    "description": "The Honeywell CO30XE is a compact indoor/outdoor cooler from a familiar brand. Honeywell's spec sheet lists 525 CFM, and listings agree on coverage of about 320 square feet with a 30-liter tank, which is about 7.9 US gallons; a few reviews quote other tank sizes, but the 30-liter figure matches the manufacturer and the model's own naming. O'Reilly lists it at 24 pounds and 120 volts with three speeds, while some sources say four, so check the box. A 30-liter tank on a 525 CFM fan means long runtimes between fills, which suits a bedroom or a small covered patio where you do not want to keep topping it up. Its airflow is modest, so it is a spot cooler rather than a whole-room solution for large spaces.",
    "pros": [
      "525 CFM per Honeywell's spec sheet",
      "30-liter (about 7.9 gal) tank for long runtimes",
      "Rated for indoor and outdoor use",
      "24 lb, easy to move"
    ],
    "cons": [
      "Modest airflow; best for about 320 sq ft",
      "Sources disagree on the number of speeds",
      "Spot cooling rather than whole-space cooling"
    ],
    "bottomLine": "A quiet-running spot cooler for one room or a small patio, with a tank that lasts."
  },
  {
    "id": "big-ass-fans-cool-space-300",
    "name": "Big Ass Fans Cool-Space 300",
    "badge": "Best for Garages and Workshops",
    "category": "Portable, High-Capacity",
    "amazonUrl": "#",
    "description": "The Big Ass Fans Cool-Space 300 is the pick for a garage, workshop or home gym in a dry climate. Big Ass Fans markets it for spaces up to 1,200 square feet, and retailers list an 18-inch fan with up to 2,800 CFM, a 16-gallon reservoir, 8-inch-thick cooling media and a direct-drive variable-speed motor. Sylvane lists it at about 100 pounds and 47.5 inches tall. Sylvane's listing showed $1,899 against a $2,499 list price, with other retailers at $1,899 to $1,999, so it is a serious investment. The warranty is listed at five years on the main unit, with one retailer stating three years on other components. Noise figures disagree between sources, from about 63 dBA to 75 dBA, so do not expect a quiet machine.",
    "pros": [
      "Up to 2,800 CFM and 1,200 sq ft per Big Ass Fans",
      "16-gallon reservoir and 8-inch media",
      "Variable speed, direct-drive motor",
      "Five-year warranty on the main unit"
    ],
    "cons": [
      "Around $1,900 at listed prices",
      "About 100 lb",
      "Loud at higher speeds per published figures"
    ],
    "bottomLine": "Built for a big garage or shop in a dry climate, at a price that reflects the build."
  },
  {
    "id": "big-ass-fans-cool-space-200",
    "name": "Big Ass Fans Cool-Space 200",
    "badge": "Best Compact Premium",
    "category": "Portable, Mid-Size",
    "amazonUrl": "#",
    "description": "The Cool-Space 200 brings Big Ass Fans' build quality to a smaller footprint. A retailer lists 900 to 1,800 CFM from dual 10-inch fans and an 8-gallon reservoir good for up to three hours on a fill, and Big Ass Fans positions it for spaces up to 800 square feet. Listings describe 4-inch resin-treated cooling media with GreenGuard Gold certification, which is thicker than the media in many budget coolers and helps effectiveness. The warranty is listed at up to five years, varying by region. It costs more than the Hessaire models but is aimed at people who want a cooler that holds up to daily use on a patio or in a small shop.",
    "pros": [
      "900 to 1,800 CFM from dual fans per a retailer",
      "8-gallon tank with a low-water indicator",
      "4-inch treated cooling media",
      "Up to five-year warranty, by region"
    ],
    "cons": [
      "Up to three hours per fill",
      "Costs more than mass-market coolers",
      "Coverage claim of 800 sq ft is ideal-conditions"
    ],
    "bottomLine": "A sturdier mid-size cooler for daily patio or shop use, with thicker media than budget models."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Evaporative Coolers",
          item: "https://www.thehonestreviewers.com/best-evaporative-cooler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do evaporative coolers work in humid climates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not well. They cool by evaporating water, which only happens readily in dry air. Hessaire says they are most effective at an average relative humidity of 40 percent or less, and other guidance says effectiveness drops sharply above about 60 percent. In humid regions an air conditioner or dehumidifier is the better choice."
          }
        },
        {
          "@type": "Question",
          "name": "How much cooler can an evaporative cooler make the air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on how dry the air is and how good the cooler's media is. In hot, dry conditions a good unit can lower the air it blows by 15 to 20 degrees or more. The Southwest Energy Efficiency Project notes that thick-media systems can reach about 93 percent effectiveness, while thin-pad designs reach 50 to 80 percent."
          }
        },
        {
          "@type": "Question",
          "name": "How much water does an evaporative cooler use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Several gallons an hour on a hot, dry day for a mid-size unit, depending on airflow, temperature and humidity. Listings suggest a 10.3-gallon tank, like the Hessaire MC37M's, lasts about three to four hours. A garden-hose connection with a float valve lets the cooler refill automatically."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an evaporative cooler indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in a dry climate, as long as the room is ventilated. Open a window or door on the far side so humid air can escape. Manufacturers such as Portacool advise against using coolers in closed spaces with no ventilation, because humidity builds up and cooling stops working."
          }
        },
        {
          "@type": "Question",
          "name": "Is an evaporative cooler cheaper to run than an air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, by a wide margin. A cooler runs only a fan and pump; the Hessaire MC18M is listed at about 85 watts, roughly 1.5 cents an hour at 17 cents per kWh. A window or portable air conditioner typically draws several hundred to over a thousand watts."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I replace evaporative cooler pads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When they become stiff with mineral deposits, discolored or musty. That can be once a season or more often with hard water. Thicker rigid media, like the 4-inch and 8-inch media on Big Ass Fans coolers, generally lasts longer than thin fiber pads."
          }
        },
        {
          "@type": "Question",
          "name": "What size evaporative cooler do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with airflow. Multiply floor area by ceiling height to get your space's volume, then compare it with the cooler's CFM. Many guides suggest replacing the air every two to three minutes in dry climates. When in doubt, choose the larger cooler and run it on a lower speed."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best evaporative cooler",
      "swamp cooler",
      "portable evaporative cooler",
      "evaporative air cooler",
      "best swamp cooler",
      "outdoor evaporative cooler"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Home Cooling
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Evaporative Coolers <span class="text-[#38BDF8]">That Actually Cool in Dry Air</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Five evaporative coolers matched to the space they cool, from a 320-square-foot room to a 1,200-square-foot garage, with the one rule that decides whether any of them will work for you: how dry your air is.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#hessaire-mc37m"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Will One Work Where I Live?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-chose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Chose</a>
          <a href="#humidity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Humidity Rule</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 5 Picks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Sizing by CFM</a>
          <a href="#water" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Water, Tanks and Pads</a>
          <a href="#indoor-outdoor" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Indoor vs Outdoor Use</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Running Cost</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Maintenance</a>
          <a href="#alternatives" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When to Choose Something Else</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          An evaporative cooler can drop the temperature of the air it blows by 15 to 20 degrees or more in a hot, dry climate, for a fraction of what an air conditioner costs to run. In a humid climate it does very little and adds moisture you do not want. So the best evaporative cooler starts with a check of your local humidity, and only then with airflow, coverage and tank size.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="how-we-chose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. How We Chose
          </h2>

          <p>
            Evaporative coolers are one of the most over-promised products in home cooling. Listings routinely show people relaxing indoors in a humid-looking climate, and room-size claims rarely mention humidity at all. So we started with the condition that decides whether any cooler will work: the relative humidity of the air it is cooling. Every recommendation on this page assumes a dry climate, and the humidity section explains how to check yours.
          </p>

          <p>
            Within that frame we looked for coolers that publish the numbers that matter: airflow in cubic feet per minute, the area they are designed for, reservoir size and whether they can run from a garden hose. We favored brands with an established presence in the category, Hessaire, Honeywell and Big Ass Fans, and dropped models that the maker lists as discontinued, which removed two popular Portacool units from consideration.
          </p>

          <p>
            We did not test these coolers. Every airflow, coverage, tank and weight figure is from a manufacturer page or a retailer listing, and where sources disagree, which happens often in this category, we give both figures. Treat coverage claims as best-case numbers for very dry air, not a guarantee for your space.
          </p>

          <p>
            We ended up with five picks rather than a padded list. They cover the realistic range of uses: a single room, a small patio, a larger patio or open room, and a garage or workshop. If none of them fits, the alternatives section explains when a fan or an air conditioner is the better buy.
          </p>
        </div>

        <div id="humidity" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Humidity Rule
          </h2>

          <p>
            An evaporative cooler works by blowing air through wet pads. As the water evaporates it absorbs heat, so the air leaving the cooler is cooler and more humid than the air going in. The drier the incoming air, the more water can evaporate and the bigger the temperature drop. In humid air, very little water evaporates, and the cooler mostly blows damp air around.
          </p>

          <p>
            Hessaire's own material puts it plainly: evaporative coolers are most effective in dry climates with an average relative humidity of 40 percent or less. Other industry guidance says effectiveness falls away above roughly 60 percent relative humidity, especially at lower temperatures. A USGS illustration of where evaporative coolers work best shows the dry western United States, with the humid East better served by conventional air conditioning.
          </p>

          <p>
            The size of the drop depends on how dry the air is and how good the cooler is. The Southwest Energy Efficiency Project notes that well-designed systems with thick media, 10 to 12 inches or more, can reach about 93 percent effectiveness, while older designs with thin pads may reach only 50 to 80 percent. That is one reason the thicker media on the Big Ass Fans units is worth noting.
          </p>

          <p>
            Before you buy, look up the typical afternoon relative humidity for your area in summer, not the morning figure. If it is usually below about 40 percent on hot afternoons, a good evaporative cooler can make a real difference. If it is regularly above 60 percent, put the money toward an air conditioner or a dehumidifier instead, or for winter comfort look at our <a href="/best-electric-fireplace/">best electric fireplace</a> picks, and see our guide to <a href="/ideal-indoor-humidity/">ideal indoor humidity</a> for why adding moisture to already damp air backfires.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Our 5 Picks
          </h2>

          <p>
            These five run from a compact room cooler to a workshop unit with a 16-gallon reservoir. We chose currently sold models with published airflow, coverage and tank figures; two popular Portacool models we considered, the Cyclone 120 and Jetstream 240, are listed as discontinued on Portacool's own site, so they are not here. Figures come from manufacturer pages and retailer listings, and we note where they disagree. We researched these picks from published specs and listings; we did not lab-test them.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} reviews)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
