---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Tankless Water Heaters",
    "url": "/best-tankless-water-heater/"
  },
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  },
  {
    "title": "Best Gas Tankless Water Heaters",
    "url": "/best-gas-tankless-water-heater/"
  },
  {
    "title": "Best Electric Tankless Water Heaters",
    "url": "/best-electric-tankless-water-heater/"
  },
  {
    "title": "Water Heater Expansion Tanks",
    "url": "/water-heater-expansion-tank/"
  },
  {
    "title": "What Size Tankless Water Heater Do I Need?",
    "url": "/what-size-tankless-water-heater-do-i-need/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "7 Best Hot Water Recirculating Pumps in 2026: No More Waiting";
const description =
  "Waiting a minute for hot water wastes gallons. Seven hot water recirculating pumps, from under-sink valve kits to return-line circulators, with tankless compatibility.";

const PRODUCTS = [
  {
    "id": "grundfos-comfort-system-up15-10su7p",
    "name": "Grundfos Comfort System UP15-10SU7P/TLC (595916)",
    "category": "Pump at the Heater + Under-Sink Valve, No Return Line, Timer, Tank Heaters",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "No dedicated return line needed: uses the cold line to return water",
      "Pump mounts at the water heater, out of the way of the sink cabinet",
      "TLC version has a timer and line cord, per the model name",
      "Grundfos is one of the best-known circulator makers",
      "Replacement sensor valves are widely sold, so it is easy to service"
    ],
    "cons": [
      "The Amazon listing is thin: check Grundfos's spec sheet",
      "Cold tap can run lukewarm for a few seconds",
      "Ask your heater maker before using it on a tankless unit"
    ],
    "bottomLine": "The classic retrofit for a house with a tank water heater and no return line: pump at the heater, valve under the far sink.",
    "description": "The Grundfos Comfort System is the setup most plumbers mean when they talk about adding hot water recirculation to an existing house, and it is our pick for most homes with a tank water heater. The pump, model UP15-10SU7P/TLC, mounts on the hot outlet of the water heater, and a thermostatic sensor valve goes under the sink farthest from the heater, bridging the hot and cold supply lines. When the hot line cools, water is pushed back to the heater through the cold pipe, so you need no dedicated return line. The TLC in the model name stands for timer and line cord, so you can limit pumping to the hours you actually use hot water. Be aware that the Amazon listing is thin: it gives the model and part number, 595916, and little else, so confirm what is in the box and the pump's ratings on Grundfos's own spec sheet before you buy. Replacement sensor valves for the system are sold widely, which makes long-term servicing easy. The trade-offs are the ones every cold-line system shares: the cold tap at the far sink can run lukewarm for a few seconds, and the pump needs an outlet near the heater. Buy the Laing E1 or APCOM UT1 instead if you would rather put everything under one sink, or a Taco or Grundfos bronze circulator if your home already has a return line."
  },
  {
    "id": "laing-autocirc-e1",
    "name": "Laing AutoCirc E1 Undersink Recirculating Pump (60AOG6001-E1-BCAFNCTW-01)",
    "category": "Under-Sink, No Return Line, Fixed 85-95 F Thermostat, 24-Hour Timer, Tank Heaters Only",
    "badge": "Best Under-Sink Pump",
    "amazonUrl": "#",
    "pros": [
      "Everything installs under one sink, no work at the heater",
      "Built-in thermostat: on at 85 F, off at 95 F, per the listing",
      "24-hour adjustable timer to run only when you need hot water",
      "Energy-efficient ECM motor, described as silent",
      "1/2-inch NPT connections and a 6-foot power cord"
    ],
    "cons": [
      "Not for tankless water heaters, the listing says so plainly",
      "Thermostat is fixed, not adjustable",
      "Needs an electrical outlet under the sink"
    ],
    "bottomLine": "A compact all-in-one pump for the far sink in a tank-heater house, with a fixed thermostat and a programmable timer.",
    "description": "If the water heater is in a cramped closet or crawlspace and you would rather do all the work in one sink cabinet, the Laing AutoCirc E1 is the pump to look at. It installs under the sink farthest from the heater, between the hot and cold supply lines, and uses the cold pipe to carry cooled water back, so no return line is needed. The spec that matters is its control: Laing lists a built-in temperature sensor that switches the pump on when the hot line cools to 85 F and off when it reaches 95 F, plus a 24-hour adjustable timer so it only runs when your household actually uses hot water. That 95 F cut-off is deliberately low, which keeps the cold line from heating too much, but it also means the water arriving is warm rather than fully hot until you run the tap a moment. The listing describes an energy-efficient ECM motor, 1/2-inch NPT connections and a 6-foot cord, and says this model replaces the older Laing LHB08100092. The trade-offs are clear in the listing: it is for tank-type water heaters only, not tankless, the thermostat is fixed rather than adjustable, and you need an outlet under the sink. Buy the PROZRTED on-demand kit instead if you have a tankless heater, or the Grundfos Comfort System if you prefer the pump at the heater."
  },
  {
    "id": "apcom-ut1",
    "name": "APCOM UT1 Under Sink Hot Water Recirculation Pump Kit",
    "category": "Under-Sink Kit, No Return Line, Thermostat + Timer, Up to 250 ft of Piping, Tank Heaters",
    "badge": "Best Complete DIY Kit",
    "amazonUrl": "#",
    "pros": [
      "Complete kit: stainless pump, 2 braided hoses, 2 tees and fittings",
      "APCOM says it installs under the sink in under 10 minutes",
      "Built-in thermostat and timer for automatic operation",
      "Rated for homes with up to 250 feet of household piping",
      "Works with standard tank or indirect water heaters"
    ],
    "cons": [
      "Not listed for tankless water heaters",
      "Indoor installation only",
      "Needs an outlet under the sink"
    ],
    "bottomLine": "The most complete box for a weekend DIY install: pump, hoses, tees and fittings for a tank-heater house without a return line.",
    "description": "Plenty of recirculation pumps arrive as a pump and nothing else, leaving you to find the right hoses and tees. The APCOM UT1 is the opposite, which is why it is the pick for a first-time DIY install. APCOM lists a stainless steel pump, two braided hoses, two tees and all the fittings needed to mount it under the sink farthest from the water heater, and says it installs in under 10 minutes with one wrench and no plumber. Like the Laing and Grundfos systems, it is built for homes without a dedicated hot water return line, using the cold pipe to send cooled water back to the heater, and APCOM rates it for up to 250 feet of household piping. Control is automatic: a built-in thermostat and timer, and the listing says the pump typically runs three to four times an hour for one to two minutes at a time, which is a useful clue to how little it actually needs to run. It works with a standard tank or an indirect water heater. The trade-offs: tankless heaters are not listed, it is designed for indoor installation only, and you need an electrical outlet under the sink, which many older kitchens and bathrooms do not have. Buy the PROZRTED instead for a tankless heater, or the Grundfos Comfort System if there is no outlet at the sink but there is one beside the heater."
  },
  {
    "id": "prozrted-hbs24-12",
    "name": "PROZRTED HBS24-12 Smart Instant Hot Water Recirculating Pump System",
    "category": "On-Demand Remote, Tank or Tankless, NSF/ANSI 61 & 372, 3-Speed, 6 GPM Max",
    "badge": "Best for Tankless (On-Demand)",
    "amazonUrl": "#",
    "pros": [
      "Listed for both tank and tankless water heaters",
      "On-demand: press a remote and hot water arrives in 2-3 minutes",
      "Supports up to 5 remotes for different bathrooms",
      "NSF/ANSI 61 and 372 for drinking water, per the listing",
      "Built-in check valve and two temperature sensors"
    ],
    "cons": [
      "You must press the button and wait, it is not instant",
      "A lesser-known brand than Grundfos, Laing or Taco",
      "Check your tankless maker's minimum flow rate first"
    ],
    "bottomLine": "A push-button recirculation kit that works with tankless heaters by running only when you ask for hot water.",
    "description": "Tankless water heaters complicate recirculation, because most need a minimum flow rate before the burner fires, and a constantly running pump can cycle them on and off all day. The PROZRTED HBS24-12 avoids that with an on-demand design. Rather than running on a thermostat around the clock, you press a remote two to three minutes before you need hot water, the pump pushes water around the loop until its sensors read hot, and it stops. The listing says it works with tank or tankless water heaters, gives a maximum flow of 6 GPM and a maximum lift of 39.3 feet, and lists three speeds, a built-in check valve from the hot side to the cold side, two temperature sensors, a 60-minute auto shut-off in manual mode, and support for up to five remotes. The whole kit is listed as NSF/ANSI 61 and 372 certified for drinking water, and PROZRTED offers a two-year warranty. The real trade-off is behavior: you have to remember to press a button and wait a couple of minutes, which suits planned showers more than quick hand washing. It is also a smaller brand, so check your tankless heater's manual for its minimum activation flow and the maker's position on external pumps before installing. Buy the Rinnai GTK15 instead if you own a compatible Rinnai with a return line."
  },
  {
    "id": "rinnai-gtk15",
    "name": "Rinnai GTK15 Pump Kit for Luxury and Ultra Series Tankless Water Heaters",
    "category": "Tankless Pump Kit, Dedicated Return Line, Circ-Logic Compatible, Grundfos 15-55 Pump",
    "badge": "Best for Rinnai Tankless",
    "amazonUrl": "#",
    "pros": [
      "Made by Rinnai for its own Luxury and Ultra series heaters",
      "Compatible with Rinnai Circ-Logic recirculation control",
      "Grundfos 15-55 pump sized for most homes, per Rinnai",
      "Internal check valve simplifies dedicated return line installs",
      "Stainless steel housing for domestic hot water"
    ],
    "cons": [
      "Only for compatible Rinnai tankless models",
      "Needs a dedicated return line",
      "Professional installation is the sensible route"
    ],
    "bottomLine": "The matched pump kit for Rinnai Luxury and Ultra tankless heaters on homes with a dedicated hot water return line.",
    "description": "The cleanest way to add recirculation to a tankless water heater is to use the pump its maker designed for it, and the Rinnai GTK15 is that kit for Rinnai's Luxury and Ultra series. Matching matters because a tankless heater controls its burner by flow, and Rinnai's Circ-Logic feature is built to manage recirculation so the heater is not cycling on and off at random. Rinnai lists the GTK15 as compatible with Circ-Logic, with a built-in timer to limit run time, a stainless steel pump housing for domestic hot water, and a Grundfos 15-55 pump that it says meets the flow needs of most homes. The internal check valve is the detail installers care about: it stops water from flowing backward through the return line, which is required in a dedicated return system and is one less part to plumb separately. That is the catch, too. This kit is meant for homes with a dedicated hot water return line, so a house without one needs new piping or a different approach. It is also only for compatible Rinnai heaters, so check your model number against Rinnai's documentation, and have a plumber install it, since it is wired and plumbed into the heater. Newer Rinnai models with a built-in pump do not need it. Buy the PROZRTED instead for a tankless heater from another brand."
  },
  {
    "id": "taco-006-bc7-1ifc",
    "name": "Taco 006-BC7-1IFC Bronze Circulator Pump with Integral Check Valve",
    "category": "Bronze Circulator, Dedicated Return Line, 1/2-in Sweat, 1/40 HP, Integral Check Valve",
    "badge": "Best for Dedicated Return Lines",
    "amazonUrl": "#",
    "pros": [
      "Bronze body, the usual choice for potable hot water",
      "Integral flow check valve built into the pump",
      "Replaceable cartridge, field serviceable",
      "Self-lubricating with no mechanical seal to leak",
      "Low-power 1/40 HP direct-drive motor"
    ],
    "cons": [
      "Needs a dedicated return line",
      "No timer or thermostat: add a control",
      "1/2-inch sweat connections mean soldering"
    ],
    "bottomLine": "A long-lived bronze circulator for houses already plumbed with a hot water return line, with the check valve built in.",
    "description": "If your house was built with a dedicated hot water return line, a pipe running from the far end of the hot water system back to the heater, you do not need an under-sink valve kit at all. You need a good potable-water circulator, and the Taco 006 is one of the most common in residential recirculation. This version has a bronze body, the material normally used for potable water because, unlike cast iron, it is not meant to rust in fresh, oxygenated water. Cast iron circulators are for closed heating loops, so do not swap one in. The IFC in the model name is an integral flow check valve, which stops water from flowing backward through the loop, and Taco lists a replaceable cartridge design that can be serviced in the field, a self-lubricating build with no mechanical seal, and a 1/40 horsepower direct-drive motor. Connections are 1/2-inch sweat, so installation means soldering into copper. The trade-off is that this is a bare pump: there is no timer, thermostat or on-demand control, and running it 24 hours a day wastes heat. Pair it with a plug-in timer, an aquastat or a Taco smart control. Buy an under-sink kit such as the Laing E1 or APCOM UT1 instead if you have no return line, or the Grundfos UP15-10B7 if you want the other big-name bronze circulator."
  },
  {
    "id": "grundfos-up15-10b7",
    "name": "Grundfos UP15-10B7 Bronze Circulator Pump (59896226)",
    "category": "Bronze Circulator, Dedicated Return Line, 115V, 1/25 HP, Compact",
    "badge": "Best Bronze Circulator Alternative",
    "amazonUrl": "#",
    "pros": [
      "Bronze body for potable hot water",
      "Compact: about 4 x 5-1/8 x 6-3/8 inches, per the listing",
      "Light at about 6 pounds",
      "115V, 1/25 HP motor",
      "Common replacement part, so plumbers know it"
    ],
    "cons": [
      "The listing gives almost no performance data",
      "No built-in timer or thermostat",
      "Needs a dedicated return line"
    ],
    "bottomLine": "A compact bronze Grundfos circulator for return-line systems, best bought as a like-for-like replacement or paired with a timer.",
    "description": "The Grundfos UP15-10B7 is the other big-name bronze circulator you will find on dedicated return-line systems, and it is the logical choice when the pump you are replacing is already a Grundfos UP15. Grundfos lists it as a bronze-bodied, 115-volt, 1/25 horsepower circulator, and the listing gives its size as roughly 4 by 5-1/8 by 6-3/8 inches and its weight as just under 6 pounds, small enough to fit in tight spots beside a water heater. Bronze matters here for the same reason as with the Taco: potable hot water carries fresh oxygen, so domestic recirculation needs a bronze or stainless pump, never the cast iron versions sold for boiler loops. That is the extent of what the Amazon listing states, though. It does not give flow, head, connection type or whether a timer is included, so check Grundfos's product page or spec sheet for the B7 connection details and pump curve before you order, especially if you are matching an existing pump's flanges or unions. As a bare circulator, it needs a separate timer, aquastat or other control to avoid running nonstop and needs a dedicated return line to work at all. Buy the Taco 006-BC7-1IFC instead if you want a check valve built into the pump, or the Grundfos Comfort System if your house has no return line."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Hot Water Recirculating Pumps",
          item: "https://www.thehonestreviewers.com/best-hot-water-recirculating-pump/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best hot water recirculating pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes with a tank water heater and no return line, the Grundfos Comfort System UP15-10SU7P/TLC is the best hot water recirculating pump: the pump sits at the heater and a sensor valve goes under the farthest sink. Choose the Laing E1 or APCOM UT1 for an all-under-sink install, and a Taco or Grundfos bronze circulator if you have a dedicated return line."
          }
        },
        {
          "@type": "Question",
          "name": "How does a hot water recirculating pump work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It moves water from the water heater through the hot pipes and back to the heater, so the pipes stay warm and hot water reaches the tap in seconds. The water returns either through a dedicated return line or, in most retrofits, through the cold line via a thermostatic valve under the farthest sink. A timer, thermostat or button controls when it runs."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a return line for a recirculating pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Under-sink systems like the Grundfos Comfort System, Laing AutoCirc E1 and APCOM UT1 use the cold water line as the return path, with a valve bridging hot and cold under the farthest sink. A dedicated return line gives the best performance and leaves the cold line cold, but adding one usually means opening walls."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use a recirculating pump with a tankless water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but it must be compatible. Tankless heaters fire only above a minimum flow rate, so many tank-heater pumps, including the Laing E1, are not meant for them. Use the heater maker's pump kit, such as the Rinnai GTK15, a heater with built-in recirculation, or an on-demand pump listed for tankless use, like the PROZRTED HBS24-12."
          }
        },
        {
          "@type": "Question",
          "name": "How do you install a hot water recirculating pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For an under-sink kit, shut off the water at the far sink, fit the tees to the stop valves, connect the hoses to the pump or valve, reconnect the faucet lines, plug it in and set the timer. Heater-mounted pumps and return-line systems involve soldering and wiring, so most people hire a plumber. Always follow the maker's instructions and local codes."
          }
        },
        {
          "@type": "Question",
          "name": "Does a recirculating pump waste energy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can if it runs around the clock, because hot water loses heat through the pipe walls. With a timer, thermostat or on-demand control, the pump runs only briefly, and its own electricity use is small. Insulating accessible hot water pipes reduces heat loss further. The water you stop pouring down the drain is a guaranteed saving."
          }
        },
        {
          "@type": "Question",
          "name": "Why is my cold water warm after installing a recirculating pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Systems without a return line send cooled hot water back through the cold pipe, so the cold tap at that sink can run lukewarm for a few seconds. Use a timer so the pump is off when you want cold water, and check the sensor valve. If cold taps run hot across the house, the valve has probably failed open and needs replacing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "best hot water recirculating pump",
      "hot water recirculating pump",
      "hot water circulation pump",
      "recirculation pump",
      "water heater recirculating pump",
      "tankless water heater recirculating pump",
      "under sink recirculating pump"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Hot Water Recirculating Pumps</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          In a long ranch house or a far bathroom, you can wait a minute or more for hot water while gallons run down the drain. Seven recirculation pumps on Amazon, from under-sink kits to return-line circulators and tankless pump kits, matched to the plumbing you have.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#grundfos-comfort-system-up15-10su7p"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Return Line or Not?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="2.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-it-works" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How It Works</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Return Line or Under-Sink Valve</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Recirculating Pumps</a>
          <a href="#tankless" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. For Tankless Water Heaters</a>
          <a href="#controls" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Timers, Thermostats, On-Demand</a>
          <a href="#install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How to Install One</a>
