---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Power Banks",
    "url": "/best-solar-power-bank/"
  },
  {
    "title": "Can a Portable Power Station Run a CPAP?",
    "url": "/can-a-portable-power-station-run-a-cpap/"
  },
  {
    "title": "Best Portable Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "What Size Portable Power Station Do I Need?",
    "url": "/what-size-portable-power-station-do-i-need/"
  },
  {
    "title": "LiFePO4 vs Lithium-Ion Power Stations",
    "url": "/lifepo4-vs-lithium-ion-power-stations/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Power Stations for CPAP in 2026: Nights Per Charge, DC and UPS";
const description =
  "The best portable power stations for CPAP from Jackery, BLUETTI, Anker SOLIX and EcoFlow, compared on watt-hours, nights per charge with and without a humidifier, DC cables, pure sine wave and UPS switchover.";

const PRODUCTS = [
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station (1,024Wh)",
    "category": "1,024Wh LiFePO4, 1,500W Pure Sine Wave AC, 10ms UPS, 30 dB Quiet Charge Mode",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "1,024Wh covers several nights without the humidifier, by our estimate",
      "Listing specifies pure sine wave AC outlets",
      "10ms UPS switchover for outage nights at home",
      "App-selectable 30 dB quiet overnight charging mode",
      "LiFePO4 rated for 4,000 cycles to 70% capacity"
    ],
    "cons": [
      "Heavier than the small stations; not a carry-on item",
      "Fast charging needs to be enabled in the app",
      "Far more output than a CPAP alone needs"
    ],
    "bottomLine": "The best all-round power station for CPAP: enough capacity for a humidifier night or several dry nights, with UPS switchover and a quiet charging mode.",
    "description": "This is the station to buy if the CPAP is the reason you are shopping and you want one box that handles outage nights at home and long weekends away. The spec that matters is capacity: Jackery lists 1,024Wh, and using the formula in this guide (rated Wh times 0.85, divided by one night's draw) that works out to roughly 2.7 nights for a machine averaging 40 watts over eight hours, or a little over one night with heated humidification pulling about 90 watts. Those are estimates, not measured runtimes, so plug in your own machine's figure. The listing also specifies pure sine wave AC outlets and a 10ms UPS switchover, which matters if you want the CPAP plugged through the station every night so a power cut never wakes you. Jackery's app adds a 30 dB quiet overnight charging mode, useful when the station sits beside the bed. The battery is LiFePO4, rated to keep over 70% of capacity after 4,000 cycles. The trade-off is size: it is a 1,500W station (3,000W peak) carrying far more inverter than a CPAP needs, and it is heavier than the 300Wh class. If you only camp one night at a time with the humidifier off, the Bluetti Elite 30 V2 or Jackery Explorer 300 is lighter and cheaper to carry."
  },
  {
    "id": "bluetti-elite-100-mini",
    "name": "BLUETTI Elite 100 Mini Portable Power Station (1,004.8Wh)",
    "category": "1,004.8Wh LFP, 700W AC, 10ms UPS, Under 10W Self-Consumption, 23.59 lb",
    "badge": "Best Compact 1kWh",
    "amazonUrl": "#",
    "pros": [
      "Around 1kWh in a 9.25 x 8.48 x 11.54 inch vertical footprint",
      "Listed self-consumption under 10W stretches small-load runtime",
      "10ms UPS switchover, with CPAP named in the listing",
      "Rated for 6,000+ cycles on LFP cells",
      "App control over Bluetooth or Wi-Fi"
    ],
    "cons": [
      "700W rated output limits it as a general home backup",
      "Still 23.59 lb, so it is not a backpacking battery",
      "Newer model with a shorter track record than the Jackery"
    ],
    "bottomLine": "A 1kWh station that fits on a nightstand, with low idle draw and UPS switchover that suit a CPAP better than raw output does.",
    "description": "The Elite 100 Mini is for people who want multi-night CPAP capacity but do not want a big box beside the bed. BLUETTI lists 1,004.8Wh in a vertical case of 9.25 by 8.48 by 11.54 inches at 23.59 lb, which the listing describes as smaller and lighter than similar 1kWh stations. The spec that matters for a CPAP is not the 700W output but the self-consumption, listed at under 10W. A station's own electronics run all night alongside the machine, so a low idle figure leaves more of the battery for the CPAP. On our estimate (1,004.8Wh times 0.85, divided by eight hours of use), that is roughly 2.7 nights at a 40W average draw or about 1.2 nights at 90W with heated humidification; your machine's figure may differ. The listing also specifies a 10ms UPS switchover and names CPAP machines among the equipment it keeps running, plus 6,000+ life cycles on LFP cells and app monitoring. The trade-off is output: 700W continuous (1,400W in Power Lifting mode for resistive loads) will not run a microwave or many kitchen appliances in an outage. If you want one station for the CPAP and the rest of the house, the EcoFlow DELTA 3 Classic or Anker SOLIX C1000 Gen 2 is the better fit."
  },
  {
    "id": "anker-solix-c1000-gen-2",
    "name": "Anker SOLIX C1000 Gen 2 Portable Power Station (1,024Wh)",
    "category": "1,024Wh LiFePO4, 2,000W AC (3,000W Peak), 49-Min Recharge, 600W Solar Input",
    "badge": "Fastest Recharge",
    "amazonUrl": "#",
    "pros": [
      "Full recharge in about 49 minutes at 1,600W, per the listing",
      "600W solar input recharges in about 1.8 hours in good sun",
      "1,024Wh for multi-night CPAP use, by our estimate",
      "Ten output ports for CPAP, phones and a lamp at once",
      "Rated for 4,000 cycles to at least 80% capacity"
    ],
    "cons": [
      "Fast-charge mode is enabled in the Anker app",
      "Listing gives no UPS switchover time",
      "More output and weight than a CPAP-only buyer needs"
    ],
    "bottomLine": "Best when you need the battery back to full quickly between nights, from a wall, a generator or a large solar array.",
    "description": "The SOLIX C1000 Gen 2 suits CPAP users who expect long outages and plan to top the battery up by day from a generator, a neighbour's outlet or solar. The spec that matters here is recharge speed. Anker lists a full recharge in about 49 minutes at 1,600W with HyperFlash enabled in the app, and 600W of solar input (60V maximum) refilling it in about 1.8 hours. That means a short generator run or a sunny morning restores a whole night of CPAP power and more. Capacity is 1,024Wh, which by our estimate (Wh times 0.85, divided by eight hours of draw) covers roughly 2.7 nights at a 40W average or about 1.2 nights at 90W with the humidifier; check your own machine's figure. Output is 2,000W continuous with 3,000W peak across ten ports, and Anker rates the LiFePO4 battery for 4,000 cycles to at least 80%. The trade-off for a CPAP buyer is that the listing positions it for UPS use but does not state a switchover time, so if seamless pass-through every night is your priority, the Jackery Explorer 1000 v2 or EcoFlow DELTA 3 Classic, which both list one, is the safer choice. It is also more station than a CPAP alone needs, so weekend campers should look at the 300Wh class instead."
  },
  {
    "id": "ecoflow-delta-3-classic",
    "name": "EcoFlow DELTA 3 Classic Portable Power Station (1,024Wh)",
    "category": "1,024Wh LiFePO4, 1,800W AC (3,600W Surge), Under 10ms UPS, 100W USB-C",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "pros": [
      "Under 10ms UPS switchover, with medical devices named in the listing",
      "1,800W output also runs a fridge or microwave in an outage",
      "0 to 80% in about 45 minutes on AC",
      "Recharges in about 2.5 hours from 500W of solar",
      "LiFePO4 cells rated for 10+ years of daily use"
    ],
    "cons": [
      "Larger and heavier than a CPAP-only station needs to be",
      "Inverter capacity is wasted on a 40W overnight load",
      "Solar panel is optional and sold separately"
    ],
    "bottomLine": "The pick when the CPAP is one of several things you need to keep running through an outage at home.",
    "description": "Buy the DELTA 3 Classic if the CPAP has to share the battery with the rest of the house. EcoFlow lists 1,800W of output with 3,600W surge, enough for a refrigerator, microwave or laptop, so in a storm it can keep food cold by day and the CPAP running by night. The spec that matters for sleep is the UPS: the listing says the station switches to battery in under 10ms and names medical devices among the sensitive electronics it protects. Leave the CPAP plugged through it and a power cut should pass without a gap, though you should confirm that with your own machine on a quiet evening. Capacity is 1,024Wh, which by our estimate (Wh times 0.85, divided by eight hours) gives roughly 2.7 nights at a 40W average or a little over one night at 90W with heated humidification, before anything else draws from it. Recharging is quick: 0 to 80% in about 45 minutes on AC, or about 2.5 hours from an optional 500W solar panel. The trade-off is that every watt you spend on the fridge comes out of the CPAP's nights, so plan the day's loads. If you only need the CPAP covered, the BLUETTI Elite 100 Mini gives similar capacity in a smaller box."
  },
  {
    "id": "bluetti-elite-30-v2",
    "name": "BLUETTI Elite 30 V2 Portable Power Station (288Wh)",
    "category": "288Wh LFP, 600W AC, 10ms UPS, 9.4 lb, 0-80% in 45 Min",
    "badge": "Best Small Station With UPS",
    "amazonUrl": "#",
    "pros": [
      "10ms UPS switchover, with CPAP named in the listing",
      "Light at 9.4 lb for camping and travel",
      "0 to 80% in 45 minutes on its 380W wall charge",
      "600W output is plenty for a CPAP with humidifier",
      "LFP battery chemistry"
    ],
    "cons": [
      "About one night at most without the humidifier, by our estimate",
      "Well short of a full night with heated humidification",
      "Exceeds the 160Wh airline limit, so it cannot fly"
    ],
    "bottomLine": "The best small station for a one-night outage or a single camping night with the humidifier off.",
    "description": "The Elite 30 V2 is for CPAP users who need to cover one night, not a week: a short outage, a single camping night, or a bridge until the grid returns. Its key spec is the UPS. BLUETTI lists a 10ms switchover and names CPAP machines in the listing, so you can run the machine through it at home and stay asleep if the power drops. At 9.4 lb it is easy to carry to a tent or cabin, and the 380W wall charge refills it from 0 to 80% in 45 minutes, which matters if you can reach an outlet or a generator during the day. Capacity is where you need to be honest with yourself. At 288Wh, our estimate (288 times 0.85, divided by eight hours) gives roughly 0.8 nights at a 40W average draw, or about 1.5 nights if your machine averages nearer 20W, and only about a third of a night with heated humidification at 90W. Real draw depends on your pressure, mask and settings, so check your machine's own figure before relying on it. Turning the humidifier off, and using a DC cable where your machine allows, stretches it furthest. If you want the humidifier on, or several nights between charges, step up to the Jackery Explorer 1000 v2 or BLUETTI Elite 100 Mini."
  },
  {
    "id": "jackery-explorer-300",
    "name": "Jackery Explorer 300 Portable Power Station (292Wh)",
    "category": "292Wh LiFePO4, 300W AC (600W Surge), 120W Car Port, 7.5 lb",
    "badge": "Best Lightweight for Camping",
    "amazonUrl": "#",
    "pros": [
      "Light at 7.5 lb with an integrated handle",
      "120W car port suits a 12V CPAP DC cable",
      "Two AC outlets plus a 100W USB-C PD port",
      "LiFePO4 rated for 4,000+ cycles to 70%",
      "Recharges from a 100W solar panel to 80% in about 2.8 hours"
    ],
    "cons": [
      "Listing gives no UPS function",
      "About one night at most without the humidifier, by our estimate",
      "300W rated output is small for anything but light loads"
    ],
    "bottomLine": "A light, simple CPAP battery for camping and road trips, best run through a DC cable with the humidifier off.",
    "description": "The Explorer 300 is the camper's choice: a 7.5 lb box with a handle that rides in a pack or a car and powers a CPAP through one night off-grid. The spec that matters is the 120W car port. Many CPAP makers sell a 12V DC cable for their machines, and running that cable from the car port skips the inverter, which wastes power converting battery DC to AC and back again inside the CPAP's own power brick. That makes this a better CPAP battery than its 292Wh capacity suggests. On our estimate (292 times 0.85, divided by eight hours) it gives roughly 0.8 nights at a 40W average on AC, or about 1.6 nights if your machine averages 20W, and somewhat more through a DC cable because you avoid inverter losses. With heated humidification it will not last a full night. Jackery lists the battery as LiFePO4 rated for over 4,000 cycles to 70%, plus two AC outlets, a 100W USB-C PD port and two USB-A ports, and a 100W solar panel reaches 80% in about 2.8 hours. The trade-off is that the listing mentions no UPS function, so it is not the box to leave plugged in at home for outage nights. For that, choose the BLUETTI Elite 30 V2 at the same size."
  },
  {
    "id": "anker-solix-c300-dc",
    "name": "Anker SOLIX C300 DC Portable Power Station (288Wh)",
    "category": "288Wh LiFePO4, 300W DC-Only, 120W Car Socket, Two 140W USB-C",
    "badge": "Best DC-Only Option",
    "amazonUrl": "#",
    "pros": [
      "No inverter: DC output avoids AC conversion losses",
      "120W car socket for a 12V CPAP cable",
      "Two 140W two-way USB-C ports charge it from a laptop brick",
      "LiFePO4 battery with a 3-year guarantee",
      "Listed as 30% smaller than similar stations"
    ],
    "cons": [
      "No AC outlets, so it needs your machine's DC cable",
      "No wall charger included",
      "Short of a full night with heated humidification"
    ],
    "bottomLine": "The most efficient small CPAP battery if your machine has a 12V DC cable, and useless for it if it does not.",
    "description": "The SOLIX C300 DC suits one specific buyer: someone whose CPAP has a 12V DC cable and who wants the most nights from the least weight. There are no AC outlets at all. Anker lists 288Wh and 300W of DC output through a 120W car socket, two 140W two-way USB-C ports, a 100W USB-C port, a 15W USB-C port and two USB-A ports. The spec that matters is that car socket. A DC cable from the socket powers the machine directly, so none of the battery is spent running an inverter overnight. Our estimate for AC stations divides capacity by 0.85; with DC you can reasonably expect a little better than that, though the exact gain depends on your machine and cable. As a baseline, 288Wh times 0.85, divided by eight hours, gives roughly 0.8 nights at a 40W average or about 1.5 nights at 20W, and less than half a night with heated humidification. The battery is LiFePO4 with a 3-year guarantee. The trade-offs are real: no wall charger is included (you charge it over USB-C with an 18W or higher charger, and the listing says only two of the USB-C ports accept input), and if your machine has no DC cable it cannot run it at all. In that case buy the Jackery Explorer 300 or BLUETTI Elite 30 V2, which have AC outlets."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Power Stations for CPAP",
          item: "https://www.thehonestreviewers.com/best-portable-power-station-for-cpap/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best power station for CPAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the Jackery Explorer 1000 v2. Its listing specifies 1,024Wh of LiFePO4 capacity, pure sine wave AC outlets, a 10ms UPS switchover and a quiet overnight charging mode. By our estimate that covers roughly 2.7 nights at a 40W average draw. For one-night camping, the BLUETTI Elite 30 V2 or Jackery Explorer 300 is lighter."
          }
        },
        {
          "@type": "Question",
          "name": "How many hours will a 1000Wh power station run a CPAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Multiply 1,000Wh by about 0.85 for usable energy, about 850Wh, then divide by your machine's average watts. At 40 watts that is roughly 21 hours, or about two and a half eight-hour nights. At 90 watts with heated humidification it is roughly nine hours. These are estimates, so check your machine's own consumption figure and keep a margin."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 300Wh power station run a CPAP all night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, if the humidifier is off. A 300Wh station gives about 255 usable watt-hours by our estimate, which covers an eight-hour night at an average draw of about 32 watts or less. Many machines average less than that without humidification, especially through a DC cable. With heated humidification, a 300Wh station will not last the night."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a DC cable or the AC outlet for my CPAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a DC cable when capacity is tight. It skips the inverter, which wastes energy converting battery power to AC and then back to DC inside the CPAP's power supply. The gain is largest on small stations. Use AC on a large station or when you want UPS pass-through at home, since switchover applies to the AC outlets."
          }
        },
        {
          "@type": "Question",
          "name": "Does a CPAP need a pure sine wave inverter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A CPAP's power supply is designed for clean grid-style AC, and a modified sine wave inverter can make it run hot, hum or fail to start. Confirm pure sine wave on the spec sheet of the exact station you buy. If you power the CPAP through a DC cable, the inverter is bypassed and the waveform no longer matters."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take a portable power station on a plane for my CPAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not one of these. Airline rules allow lithium batteries up to 100Wh freely and 100 to 160Wh with airline approval, and ban larger batteries on passenger aircraft. Every station in this guide is well over 160Wh. Travelers should buy a CPAP battery designed for flight and check their airline's medical device rules before the trip."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to leave a CPAP plugged into a power station every night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on a station that lists UPS or pass-through charging, which is what the feature is for. Keep the station on a hard surface with clear vents, away from bedding. LiFePO4 batteries tolerate nightly cycling well. Test the switchover once by turning the wall outlet off while the CPAP runs, so you know your machine rides through it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "power station for cpap",
      "best portable power station for cpap",
      "cpap battery backup",
      "cpap power station",
      "battery backup for cpap machine",
      "solar generator for cpap"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Power Stations for CPAP</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A CPAP is a small load, but it runs all night, every night. Seven LiFePO4 power stations sized by watt-hours, with the math for nights per charge shown so you can check it against your own machine.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#jackery-explorer-1000-v2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Nights Per Charge
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#cpap-watts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Many Watts a CPAP Uses</a>
          <a href="#nights-per-charge" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Nights Per Charge</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Power Stations for CPAP</a>
          <a href="#dc-vs-ac" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. DC Adapter vs AC Inverter</a>
          <a href="#pure-sine-wave" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Pure Sine Wave</a>
          <a href="#ups-pass-through" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. UPS Pass-Through</a>
