    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How long does it take to seal marble?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The application itself takes twenty to forty minutes for a typical kitchen counter, including the dwell and wipe-off. Allow a day beforehand for the stone to dry after cleaning, and at least 24 hours afterwards before using the surface normally. Full stain resistance can take around 72 hours to develop, depending on the product."
          }
        },
