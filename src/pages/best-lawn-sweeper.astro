---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Leaf Blowers",
    "url": "/best-leaf-blower/"
  },
  {
    "title": "Best Cordless Leaf Blowers",
    "url": "/best-cordless-leaf-blower/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Zero-Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Mulching Mowers",
    "url": "/best-mulching-mower/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Lawn Sweepers for Leaves, Needles and Thatch";
const description =
  "Seven push and tow-behind lawn sweepers compared on brush speed, hopper size and height adjustment — plus when a blower or mulching mower beats a sweeper.";

const PRODUCTS = [
  {
    "id": "agri-fab-45-0492-lawn-sweeper",
    "name": "Agri-Fab 45-0492 44-Inch Tow Lawn Sweeper",
    "category": "44\" Tow-Behind, Flow-Through Bag",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 2900,
    "pros": [
      "5.6:1 brush-to-wheel ratio is the fastest on this list, which is what lifts matted leaves instead of rolling them",
      "Patented offset hitch lets the sweeper run beside the mower deck, so you can mow and sweep in one pass",
      "Large flow-through bag (25 cu ft on most retail listings) fills back to front, so it actually uses its full volume",
      "12-inch semi-pneumatic wheels roll over bumpy turf without bouncing the brushes off the ground",
      "Tool-free assembly and a collapsible hopper for winter storage"
    ],
    "cons": [
      "At about 95 lb it is too heavy to pull with anything smaller than a lawn tractor or zero-turn",
      "The offset hitch takes a few passes to get used to on tight turns around beds"
    ],
    "bottomLine": "The sweeper most tractor owners should buy: fast brushes, a big bag and an offset hitch that genuinely saves a pass.",
    "description": "The 45-0492 earns the top spot because it gets the one spec that matters most right: brush speed. Its brush-to-wheel ratio of 5.6:1 means the brushes turn more than five and a half times for every turn of the wheels, and that extra tip speed is what flicks flattened, slightly damp leaves up into the bag instead of rolling them into a mat. The bag is the other half of the story. It is a flow-through design that fills from the back forward, so debris packs toward the front instead of piling up at the chute and blocking it while the rear of the bag is still empty. Most retailers list it at 25 cubic feet and Agri-Fab's own sheet quotes slightly more; either way, it is large enough that a half-acre of oak leaves means a handful of dumps rather than a dozen. The offset hitch is a genuinely useful feature rather than a gimmick. Because the sweeper tracks to one side of the tractor instead of directly behind it, you can mow with the discharge chute feeding clippings straight into the sweeper path and pick them up on the same lap. The 12-inch semi-pneumatic wheels keep the brush height consistent over rough ground. The catch is weight and size: roughly 95 lb and 78 inches long assembled, it needs a real lawn tractor or zero-turn and a garage corner to live in."
  },
  {
    "id": "ohio-steel-50swp26-lawn-sweeper",
    "name": "Ohio Steel 50SWP26 Professional Grade 50-Inch Lawn Sweeper",
    "category": "50\" Tow-Behind, 26 cu ft Hopper",
    "badge": "Best for Large Properties",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1300,
    "pros": [
      "50-inch sweep path and a 26 cu ft hopper cover big lots in fewer laps and fewer dumps",
      "Patented spiral brush sweeps continuously rather than in pulses and puts less shock load on the gears",
      "Extra-wide 9-inch chute is noticeably harder to clog with sticks and pine cones",
      "Sealed ball bearings on the brush axle, a detail cheaper sweepers skip",
      "Hopper empties by rope from the seat and removes completely for storage"
    ],
    "cons": [
      "4.5:1 brush ratio is slower than the Agri-Fab, so wet, matted leaves need a slower ground speed",
      "Too wide to fit through a standard 48-inch garden gate assembled"
    ],
    "bottomLine": "The one to buy if you have an acre or more of lawn under hardwoods and want the fewest possible dump runs.",
    "description": "Ohio Steel builds this sweeper around two ideas: go wide, and do not clog. The 50-inch sweep path covers about 14 percent more ground per lap than a 44-inch unit, which adds up quickly on an acre, and the 26 cubic foot hopper is among the largest you can buy for a residential tractor. The chute between the brushes and the hopper is 9 inches wide, and that matters more than it sounds. A narrow chute is where sticks, pine cones and wads of wet leaves jam, and once the chute is blocked, the sweeper keeps turning its brushes while collecting nothing. The spiral brush design is Ohio Steel's other point of difference. Instead of straight brush rows that hit the turf one after another, the spiral bristles sweep continuously across the width, which gives a more even pickup and reduces the shock load on the drive gears — a common failure point on sweepers that are used hard. The brush-to-wheel ratio is 4.5:1, a bit slower than our top pick, so on wet, matted leaves you get better results by dropping the tractor into a lower gear and lowering the brush height a notch. Build quality is a step up from typical big-box sweepers: sealed ball bearings on the brush axle, 11-inch semi-pneumatic wheels and a three-year limited warranty. The hopper dumps by rope from the seat and lifts off entirely for storage."
  },
  {
    "id": "brinly-sts-427lxh-lawn-sweeper",
    "name": "Brinly STS-427LXH 42-Inch Tow-Behind Lawn Sweeper",
    "category": "42\" Tow-Behind, 24 cu ft Hamper",
    "badge": "Best for Year-Round Use",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1800,
    "pros": [
      "Ten-position Twist-Lock height adjustment mounted on the side, where you can actually reach it",
      "The lock knob stops the height lever vibrating loose over rough ground",
      "Six 11-inch brushes at a 5:1 ratio handle both wet and dry grass clippings",
      "Stands or hangs upright for storage, taking up a fraction of the floor space",
      "Full-length windscreen and T-handle dump cord keep debris in and let you empty from the seat"
    ],
    "cons": [
      "24 cu ft hamper fills faster than the 26 cu ft Ohio Steel on heavy leaf drops",
      "42-inch path means more laps on large lots"
    ],
    "bottomLine": "The best-designed 42-inch sweeper for owners who will use it for clippings all summer and leaves all fall.",
    "description": "Brinly's sweeper is the one on this list that seems designed by people who have actually used a lawn sweeper through a full season. The detail that proves it is the height adjustment. On most sweepers, the brush height lever sits up on the tow bar, awkward to reach from the tractor and prone to vibrating out of position. Brinly moved it to the side, gave it ten settings from short grass to thick leaves, and added a Twist-Lock knob that holds it in place over bumpy ground. Correct brush height is the difference between a clean lawn and one that looks swept but is not, so making it easy to change is worth a lot. The six 11-inch brushes run at a 5:1 brush-to-wheel ratio, which sits between the Ohio Steel units and the Agri-Fab 44-inch. In practice that is enough speed to collect both wet and dry grass clippings, which is why we recommend it for owners who plan to use a sweeper from May through November rather than just for fall leaves. The 24 cubic foot hamper is generous for a 42-inch machine, a full-length windscreen keeps light material from blowing back out, and a T-handle dump cord lets you empty from the seat. The self-storing design is the other win: the whole unit stands or hangs upright, which matters in a crowded garage. It connects with a universal hitch pin."
  },
  {
    "id": "ohio-steel-42swp22-lawn-sweeper",
    "name": "Ohio Steel 42SWP22 42-Inch Spiral Brush Lawn Sweeper",
    "category": "42\" Tow-Behind, 22 cu ft Hopper",
    "badge": "Best Mid-Size Tow Sweeper",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "Same patented spiral brush and 9-inch anti-clog chute as the 50-inch Ohio Steel",
      "5-position hitch adjustment sets the sweeper level behind almost any tractor or zero-turn",
      "\"No-slip\" positive lock height adjustment does not vibrate out of position",
      "22 cu ft hopper is plenty for a typical half-acre suburban lot",
      "Hopper empties by rope from the seat and removes for compact storage"
    ],
    "cons": [
      "4.5:1 brush ratio means slowing down for wet leaves",
      "Fewer reviews than the Agri-Fab and Brinly, so long-term data is thinner"
    ],
    "bottomLine": "The right size for most suburban lots, with the anti-clog chute and spiral brush of its bigger sibling.",
    "description": "If the 50-inch Ohio Steel is more machine than your yard needs, the 42SWP22 gives you the same engineering at a size that suits a typical half-acre lot and a tractor with a 42-inch deck. Matching the sweep width to the mower deck is more useful than it sounds: when the two are the same width, you can follow your mowing stripes and know you have covered the whole lawn without overlap guesswork. The sweeper uses Ohio Steel's patented spiral brush with 11-inch polypropylene bristles and a 4.5:1 brush-to-wheel ratio, and it keeps the extra-wide 9-inch chute that makes Ohio Steel sweepers less prone to jamming on sticks and acorns. The hitch has five height positions, which is the feature that quietly determines how well any tow-behind sweeper works. If the sweeper sits nose-up or nose-down behind your tractor, the brushes contact the turf unevenly and leave strips of debris. Being able to level it for your specific hitch height solves that. The height adjustment uses a positive lock that will not vibrate loose, a genuine improvement over friction levers. The 22 cubic foot hopper is smaller than the flagship models but still holds a lot of leaves; expect to dump more often on heavy oak drops. It empties by rope from the seat and comes off completely for storage, folding the sweeper down to a manageable footprint."
  },
  {
    "id": "agri-fab-45-0546-lawn-sweeper",
    "name": "Agri-Fab 45-0546 52-Inch Tow Lawn Sweeper",
    "category": "52\" Tow-Behind, 26 cu ft Flow-Through Bag",
    "badge": "Widest Sweep Path",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 700,
    "pros": [
      "52-inch sweep path is the widest here and matches the larger zero-turn decks",
      "26 cu ft flow-through bag fills back to front for full use of its volume",
      "Six brushes with an adjustable brush lever for lawns, driveways and gravel edges",
      "Semi-pneumatic 11-inch wheels and a universal hitch that fits most tractors",
      "Hopper removes without tools for storage"
    ],
    "cons": [
      "Slowest brush ratio on this list (Agri-Fab lists 4.25:1), so it is weakest on wet, matted leaves",
      "About 95 lb and 60 inches wide, so storage and gate clearance need planning"
    ],
    "bottomLine": "The pick for big, open lawns and wide zero-turn decks, as long as you sweep leaves while they are dry.",
    "description": "The 45-0546 is the sweeper for owners whose problem is simply square footage. Its 52-inch sweep path is the widest on this list, and paired with a 52- or 54-inch zero-turn deck, it lets you follow your mowing pattern lap for lap. On a two-acre property, the difference between a 42-inch and a 52-inch path is roughly a fifth fewer laps, which is a real saving across a full fall. The bag is Agri-Fab's flow-through design, rated at 26 cubic feet, and like the 44-inch model it fills from the back toward the front so debris does not stall at the chute. Six brushes run across the width, and an adjustable brush lever lets you raise them for driveways and gravel edges or drop them for thick turf. The honest limitation is brush speed. Agri-Fab's own spec sheet lists the brush-to-wheel ratio at 4.25:1, the lowest here, and that means the brushes have less tip speed to lift heavy, wet leaves. On dry leaves and grass clippings it works well; on a soggy November mat you will need to slow right down or wait for a dry afternoon. It weighs around 95 lb, rides on 11-inch semi-pneumatic wheels, and attaches with a universal hitch. The hopper removes without tools, but even collapsed, this is a large machine to store."
  },
  {
    "id": "agri-fab-45-0570-push-sweeper",
    "name": "Agri-Fab 45-0570 30-Inch Push Lawn Sweeper",
    "category": "30\" Push, Steel Housing",
    "badge": "Best Push Sweeper",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 500,
    "pros": [
      "Powder-coated steel frame and housing, sturdier than the all-poly push sweepers",
      "Infinite brush height adjustment instead of a few fixed notches",
      "5:1 brush-to-wheel ratio, as fast as many tow-behind units",
      "Flat-free composite wheels and an adjustable handle height",
      "Bag-in-bag hopper design with tool-free bag assembly and forward dumping"
    ],
    "cons": [
      "At 48 lb it is twice the weight of a plastic push sweeper, which you feel on slopes",
      "Still a push machine: an hour of sweeping is real exercise on a large lawn"
    ],
    "bottomLine": "The push sweeper to buy if you want one that lasts longer than a couple of seasons.",
    "description": "Most push lawn sweepers are lightweight plastic and feel like it. The 45-0570 is Agri-Fab's answer to that complaint: a 30-inch push sweeper with a powder-coated steel frame and housing that is built to take being bumped into fence posts and stored in a damp shed. The wider 30-inch path also means fewer passes than the common 26-inch size, which matters when you are the engine. Brush speed is solid for a push unit at 5:1, and the brush height adjustment is infinite rather than stepped, which lets you dial in the exact setting where the bristles just flick the turf rather than digging into it. That precision is useful for thatch pickup after dethatching, where you want the brushes low enough to grab loose material but not so low they drag. The wheels are flat-free composite, 10-inch at the front and 7-inch at the rear, and the handle adjusts for height, which makes a bigger difference to comfort over an hour than you would expect. The hopper uses a bag-in-bag design and dumps forward. The downside is weight: at 48 lb it is double a plastic push sweeper, and on a sloped yard you will notice it on every uphill pass. Agri-Fab does not publish a single hopper volume figure for this model, so we have not listed one, but it is bigger than the 26-inch push unit."
  },
  {
    "id": "agri-fab-45-0218-push-sweeper",
    "name": "Agri-Fab 45-0218 26-Inch Push Lawn Sweeper",
    "category": "26\" Push, Poly Housing",
    "badge": "Best Budget Push",
    "amazonUrl": "#",
    "rating": 4,
    "reviewCount": 3800,
    "pros": [
      "Budget price and only 26 lb, so it is easy to push, lift and hang on a wall",
      "5.0:1 brush ratio with four brushes picks up dry leaves and clippings well",
      "Rust-proof poly construction that can live in a damp shed",
      "Collapsible hopper and compact 31-inch width for small garages and side gates"
    ],
    "cons": [
      "Small 6.2 cu ft hopper (some listings say 7) fills quickly under a mature tree",
      "Plastic drive gears and height adjuster are the common failure points in owner reviews"
    ],
    "bottomLine": "A sensible, inexpensive sweeper for small lawns and light work; buy the steel 30-inch model if you need it to last.",
    "description": "For a small lawn without a tractor, the 45-0218 is the obvious entry point. It is inexpensive, weighs about 26 lb, and at 31 inches wide it fits through side gates and hangs on a garage wall. Four brushes turn at a 5.0:1 ratio, which is enough to lift dry leaves, grass clippings and pine needles off a reasonably flat lawn. Agri-Fab says it clears a lawn around 50 percent faster than raking, and on a small, flat yard that sounds about right: the win is less about speed and more about not bending over. The limits are clear, though, and owner reviews are consistent about them. The hopper is small — Agri-Fab's spec sheet says 6.2 cubic feet, some retailers list 7 — and under a single mature maple it fills every few passes. The body and gears are plastic, and stripped wheel gears are the most common complaint in long-term reviews; the brush height adjustment is also fiddly to set. Treat it as a budget tool for light, dry debris on a small yard. If you have a large lawn, heavy leaf fall or slopes, spend more on the 30-inch steel model or, if you have a tractor, go straight to a tow-behind. For wet leaves, this is not the tool at all; a mulching mower will do a better job."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Lawn Sweepers",
          item: "https://www.thehonestreviewers.com/best-lawn-sweeper/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do lawn sweepers actually work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on the right lawn. A tow-behind sweeper with a good brush ratio clears dry leaves, clippings, pine needles and acorns from an open lawn far faster than raking, and faster than blowing onto a tarp. They are weaker on wet, matted leaves and cannot reach into beds or along fences, which is where a leaf blower still earns its place."
          }
        },
        {
          "@type": "Question",
          "name": "Will a lawn sweeper pick up wet leaves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Somewhat, and it depends heavily on the brush ratio. A high-ratio sweeper like the Agri-Fab 45-0492 at 5.6:1 does noticeably better than a 4.25:1 unit. Lower the brushes a notch and drive slower. For a soaked, matted layer, mulching the leaves with a mower or waiting for a dry day usually gives a better result than forcing a sweeper through it."
          }
        },
        {
          "@type": "Question",
          "name": "Can a lawn sweeper pick up pine needles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pine needles are light, so they sweep up well if you set the brushes lower than you would for leaves and slow your ground speed. Expect a second pass under heavy needle drop. Spiral brush designs, like Ohio Steel's, tend to leave fewer stray needles because the bristles contact the turf continuously across the width."
          }
        },
        {
          "@type": "Question",
          "name": "Is a push lawn sweeper worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small, flat lawns of roughly a quarter acre or less, yes. A push sweeper is faster and easier on your back than raking, and it is quick to store. On larger lawns, slopes, or under several mature trees, the small hopper and the effort involved make a mulching mower or a blower the better investment."
          }
        },
        {
          "@type": "Question",
          "name": "What size lawn sweeper do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Match the sweep width to your mower deck: a 42-inch deck pairs with a 42- or 44-inch sweeper, a 50- to 54-inch deck with a 50- or 52-inch unit. Then check the hopper holds roughly half a cubic foot per inch of width so you are not dumping every few laps. Small lawns without a tractor need a 26- to 30-inch push model."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a lawn sweeper on a zero-turn mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as the zero-turn has a rear hitch plate with a pin hole. All of the tow-behind sweepers here use a standard pin hitch. Take turns wide, because a zero-turn can pivot faster than the sweeper can follow, and a sharp turn can tip or jackknife the sweeper. Most models also let you adjust hitch height to sit level."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a lawn sweeper after dethatching?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, it is one of the best uses for one. Dethatching pulls up a large volume of dead grass that must be removed before overseeding, and a sweeper with the brushes set low collects it far faster than raking. Do not sweep up aeration plugs, though; those should be left on the lawn to break down naturally."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best lawn sweeper",
      "tow behind lawn sweeper",
      "push lawn sweeper",
      "leaf sweeper",
      "lawn sweeper for pine needles",
      "fall leaf cleanup"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Sweepers Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Lawn Sweepers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Push and tow-behind sweepers compared on the specs that decide whether the leaves end up in the bag: brush speed ratio, hopper design and height adjustment.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#agri-fab-45-0492-lawn-sweeper"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Choose
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked</a>
          <a href="#what-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Sweep Width vs Hopper Capacity</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#push-vs-tow" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Push vs Tow-Behind</a>
          <a href="#brush-ratio" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Brush Ratio and Height</a>
