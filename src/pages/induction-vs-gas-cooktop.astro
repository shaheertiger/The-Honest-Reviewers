                    <td class="px-4 py-4 font-black text-gray-900">Power outage</td>
                    <td class="px-4 py-4 text-gray-700">Does not work without power</td>
                    <td class="px-4 py-4 text-gray-700">Burners usually lightable by match</td>
                    <td class="px-4 py-4 text-gray-700">Gas</td>
                  </tr>
