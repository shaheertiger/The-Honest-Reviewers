const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Water Heater Leaking",
          item: "https://www.thehonestreviewers.com/water-heater-leaking/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a leaking water heater dangerous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be. The main risks are water damage, scalding from hot water, and electrical hazards if water reaches wiring on an electric heater. A dripping T&P valve is a sign of excess pressure or temperature that needs attention. The tank itself is not likely to explode from a leak, but cut the energy source and close the supply until you know the cause."
          }
        },
        {
          "@type": "Question",
          "name": "Can I still use my water heater if it is leaking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If the leak is from a loose fitting and you have stopped it, yes. If the leak is from the T&P valve, find the cause first, because the valve is opening for a reason. If the tank itself is leaking, use it only as long as it takes to arrange a replacement, keep an eye on it, and drain it if the leak grows."
          }
        },
        {
          "@type": "Question",
          "name": "Why is my water heater leaking from the bottom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The usual candidates are the drain valve, condensation on a gas model, water running down from a fitting on top, a T&P discharge pipe that ends near the floor, or a leaking element gasket on an electric model. If you rule all of those out and water still seeps from under the tank, the inner tank has corroded and needs replacing."
          }
        },
        {
          "@type": "Question",
          "name": "How much water leaking from a water heater is normal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small amount of condensation under a gas heater when it is filled with cold water is normal and should stop once it heats up. Occasional drops from the T&P discharge pipe right after a heating cycle suggest thermal expansion. Anything steady, rusty or growing is not normal and needs to be traced."
          }
        },
        {
          "@type": "Question",
          "name": "Will homeowners insurance cover a leaking water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Policies commonly cover sudden and accidental water damage from a failed heater but not the heater itself or damage from a slow leak that was ignored. Coverage varies by insurer and policy, so read yours and call your agent. Document the damage with photos, stop the leak promptly, and keep the failed heater until the claim is settled."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a water heater last after it starts leaking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A leak from a fitting or valve says nothing about the tank's life and can be fixed. A leak from the tank itself means the steel has corroded through, and there is no reliable way to predict how long it will hold. Some seep for weeks; others fail suddenly. Treat a tank leak as a replacement you should schedule within days, not months."
          }
        },
        {
          "@type": "Question",
          "name": "Should I call a plumber for a leaking water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tightening a connector, capping a drain valve or flushing debris from a T&P valve is reasonable DIY. Call a plumber for gas line or venting work, a leak at corroded tank threads, a T&P valve that keeps opening, or any replacement. Many jurisdictions require a permit to replace a water heater, and a licensed installer handles it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
