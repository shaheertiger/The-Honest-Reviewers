---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cordless Tool Brand",
    "url": "/best-cordless-tool-brand/"
  },
  {
    "title": "Milwaukee vs DeWalt",
    "url": "/milwaukee-vs-dewalt/"
  },
  {
    "title": "Best Snow Shovels",
    "url": "/best-snow-shovel/"
  },
  {
    "title": "Best Snow Blowers",
    "url": "/best-snow-blower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "7 Best Heated Vests in 2026: Tool Battery or Power Bank";
const description =
  "A heated vest is only as warm as its battery. The best heated vests for working outside, from Milwaukee M12, DeWalt and Makita to Ororo and Venustas, compared.";

const PRODUCTS = [
  {
    "id": "milwaukee-m12-axis-heated-vest",
    "name": "Milwaukee M12 Heated AXIS Vest Kit with 2.0Ah Battery (303B-21)",
    "category": "Tool Battery, M12 12V, Front and Back Heat Zones, Kit with 2.0Ah Pack",
    "badge": "Best Overall for Tool Owners",
    "amazonUrl": "#",
    "pros": [
      "Runs on the same M12 batteries as Milwaukee's 12V drills, drivers and lights",
      "Kit includes a 2.0Ah M12 battery, so it works out of the box",
      "Front and back heat zones, per the listing",
      "Quilted AXIS shell fits under a work coat or over a hoodie",
      "Vest-only versions are sold for owners who already have M12 packs"
    ],
    "cons": [
      "Priced well above power-bank vests, roughly $250-$300 for the kit",
      "The included 2.0Ah pack is small; a larger M12 pack runs longer but adds weight",
      "Only worth it if you own or plan to own M12 tools"
    ],
    "bottomLine": "The heated vest to buy if you already run Milwaukee M12 tools: spare batteries you own become spare hours of heat.",
    "description": "If there is already a bag of red M12 batteries in your truck or garage, this is the heated vest to buy. The AXIS vest runs on Milwaukee's 12V M12 packs, the same batteries that power its compact drills, impact drivers, lights and inflators, and that changes the runtime question completely. A power-bank vest gives you whatever its one or two packs hold. This vest gives you every charged M12 battery you own, which on a long day of shoveling or a winter job site is the difference between warm until lunch and warm until you pack up. The listing for this kit names a 2.0Ah battery and front and back heat zones, and the quilted AXIS shell is thin enough to wear under a work coat or over a hoodie. A 2.0Ah M12 pack holds about 24 watt-hours, which is modest, so treat the included battery as the starter and use a larger M12 pack from your tool kit when you will be out all day. Milwaukee also sells this vest without a battery for people who already own M12 packs, which is the better value if that is you. The trade-off is price. The kit sits around $250 to $300, two to three times a good power-bank vest. If you own no M12 tools and do not plan to, buy the Ororo or Venustas below instead."
  },
  {
    "id": "ororo-4-zone-heated-vest",
    "name": "ORORO Men's Heated Vest, Lightweight 4-Zone Battery Puffer Vest",
    "category": "Power Bank, 4 Heat Zones, Water- and Wind-Resistant Puffer Shell",
    "badge": "Best Power-Bank Heated Vest",
    "amazonUrl": "#",
    "pros": [
      "Four heat zones in a classic puffer cut, per the listing",
      "Water- and wind-resistant shell for snow and wind on the driveway",
      "Battery pack is included, so no tool platform is needed",
      "Insulated, so it keeps some warmth even when the heat is off",
      "Matching women's version from the same brand"
    ],
    "cons": [
      "One battery limits a full workday unless you buy a spare",
      "Puffer bulk can feel warm under a heavy work coat while shoveling",
      "Proprietary pack, so it does not share batteries with your tools"
    ],
    "bottomLine": "The best heated vest for most people who do not own a tool battery platform: insulated, weather-resistant, and sold with its battery.",
    "description": "If you do not own a cordless tool platform, or you want a vest you can also wear to the store, the Ororo 4-zone puffer is the one we would start with. Ororo is one of the longest-running heated apparel brands on Amazon, and this vest is its classic model. The listing describes four heat zones, an insulated puffer design and a water- and wind-resistant shell, which is the right combination for standing in a driveway in blowing snow. The insulation matters more than it sounds. A heated vest with a thin shell loses its heat to the wind almost as fast as it makes it, while a puffer holds the warmth against your body and keeps you reasonably comfortable even after the battery runs flat. The battery pack is sold with the vest, so there is nothing else to buy to get started, though a second pack is the first thing we would add if you plan to be outside for more than a morning. The trade-off is the battery itself. It is Ororo's own pack, not a tool battery, so your drill batteries cannot top it up mid-shift. The puffer cut is also warm enough that, under a heavy work coat during hard shoveling, many people will run it on low or off. If you own M12, DeWalt or Makita tools, buy their vest instead."
  },
  {
    "id": "dewalt-dchv095-heated-puffer-vest",
    "name": "DEWALT DCHV095BD1 Cold Weather Men's Heated Puffer Vest Kit with Battery",
    "category": "Tool Battery, DeWalt Platform, Puffer Vest, Kit with Battery",
    "badge": "Best for DeWalt Owners",
    "amazonUrl": "#",
    "pros": [
      "Kit includes a DeWalt battery, per the listing",
      "Puffer construction keeps some warmth with the heat off",
      "Lets DeWalt owners share charged packs between tools and vest",
      "Usually priced below the Milwaukee kit, roughly $190-$230",
      "Part of DeWalt's Cold Weather line, so jackets and hoodies are sold to match"
    ],
    "cons": [
      "The listing title does not state the voltage of the included pack, so confirm it before buying spares",
      "Puffer bulk is less ideal as a thin mid-layer",
      "Little reason to buy it without other DeWalt tools"
    ],
    "bottomLine": "The DeWalt owner's answer to the M12 AXIS vest: a puffer vest kit that turns the tool batteries you already charge into heat.",
    "description": "DeWalt owners should buy this vest for the same reason Milwaukee owners should buy the AXIS: the batteries already sitting on your chargers become extra hours of heat. The DCHV095BD1 is a kit, so it arrives with a DeWalt battery, and it is a puffer vest rather than a thin quilted layer, which means it keeps you warmer when the heat is switched off or the pack runs down. That makes it a good fit for standing work, such as feeding a snow blower, holding a ladder or waiting on a delivery at a cold job site, where you are not generating much heat of your own. DeWalt's heated gear runs on its tool batteries; its jacket kits, for example, are listed as working with 20V and 12V MAX packs. The Amazon title for this vest kit does not state the voltage of the included battery, so check the product details before you buy spare packs for it, and expect a bigger pack to run longer than the one in the box. On price, this kit has usually listed below Milwaukee's AXIS kit, roughly $190 to $230 depending on size. The trade-offs are bulk and lock-in. A puffer under a heavy coat can be too warm during hard shoveling, and the vest only makes sense if DeWalt is your platform. If you are still choosing a platform, read our Milwaukee vs DeWalt comparison first."
  },
  {
    "id": "venustas-20-hour-heated-vest",
    "name": "Venustas Men's Heated Vest with Battery, Up to 20 Hours of Warmth",
    "category": "Power Bank, 6 Heat Zones, Rated Up to 20 Hours, Water-Resistant",
    "badge": "Longest Rated Runtime",
    "amazonUrl": "#",
    "pros": [
      "Rated for up to 20 hours of warmth, per the listing",
      "Six heat zones, more coverage than most four-zone vests",
      "Water-resistant fabric with a silver mylar lining",
      "Lightweight FELLEX insulation, per the listing",
      "Battery listed as recharging in about 3 hours"
    ],
    "cons": [
      "The 20-hour figure is a best-case low-setting rating, not high heat",
      "Priced near the top of the power-bank vests",
      "Proprietary battery, not shared with tools"
    ],
    "bottomLine": "The power-bank vest to pick for the longest day outside, as long as you read its 20-hour rating as a low-setting number.",
    "description": "If your problem is running out of heat before you run out of work, the Venustas 20-hour vest is the power-bank model to look at. The listing rates it for up to 20 hours of warmth, the longest runtime claim among the vests we picked, and gives it six heat zones, a water-resistant shell, a silver mylar lining and lightweight FELLEX insulation. Six zones usually means heat beyond the chest and back, which helps when you are bent over a shovel and the wind gets at your sides. Read the runtime claim the way you would read any battery rating. Twenty hours is what the brand rates at its lowest setting. On high, every heated vest burns through its battery several times faster, so plan on far less than 20 hours if you crank it up. Even so, a vest rated this long on low will comfortably cover a full day of yard cleanup or a weekend of snow removal at medium. The battery is listed as recharging in about three hours, so it is ready again by the next storm. The trade-offs are price and lock-in. It sits near the top of the power-bank vests, and its pack does not share with your tools. If you own M12, DeWalt or Makita tools and keep several batteries charged, the tool-platform vests will usually give you more total hours for the money."
  },
  {
    "id": "makita-dcv200z-heated-vest",
    "name": "Makita DCV200Z 18V LXT Lithium-Ion Cordless Heated Vest, Vest Only",
    "category": "Tool Battery, Makita 18V LXT, Vest Only (Battery Sold Separately)",
    "badge": "Best for Makita Owners",
    "amazonUrl": "#",
    "pros": [
      "Runs on Makita 18V LXT batteries, per the listing",
      "Vest-only pricing suits owners who already have LXT packs",
      "18V packs store more energy than 12V packs of the same amp-hours",
      "Sold in sizes up to 3X-Large",
      "Lets you swap in a charged tool battery mid-job"
    ],
    "cons": [
      "No battery or charger in the box",
      "An 18V pack is heavier to carry than a power-bank battery",
      "Pointless without Makita LXT batteries"
    ],
    "bottomLine": "For Makita 18V LXT owners, the cheapest way into a heated vest that can run all day on packs you already own.",
    "description": "Makita's DCV200Z is the vest for people who already have a shelf of 18V LXT batteries. It is sold as vest only, with no battery or charger, which keeps the price in the low-to-mid $200s and means you pay only for the garment. What you get in return is the energy of an 18V tool pack. At the same amp-hour rating, an 18V battery stores half again as many watt-hours as a 12V one, so a common 5.0Ah LXT pack holds roughly 90 watt-hours, more than double the power bank that comes with a typical heated vest. That is why tool-platform vests make sense for long cold shifts: you are not limited to one pack, and the packs are big. The listing offers sizes up to 3X-Large, which helps if you wear it over a hoodie. Makita also sells a newer DCV202Z vest listed for both 18V and 14.4V LXT packs, worth a look if you still run older 14.4V batteries. The trade-offs are weight and lock-in. An 18V pack in a pocket is heavier than a slim power bank, so most people clip it where it rides at the hip. And without Makita batteries, the vest is a costly piece of fabric. If you are on Milwaukee or DeWalt, buy their vests; if you own no tools, an Ororo or Venustas kit is cheaper and complete."
  },
  {
    "id": "venustas-heated-fleece-vest",
    "name": "Venustas Men's Heated Fleece Vest with 6 Heating Zones and Battery Pack",
    "category": "Power Bank, 6 Heat Zones incl. Collar and Shoulders, Fleece Mid-Layer",
    "badge": "Best Mid-Layer Under a Work Coat",
    "amazonUrl": "#",
    "pros": [
      "Six heat zones including the collar and shoulders, per the listing",
      "Soft fleece is thin enough to wear under a work jacket",
      "Rated for up to 10 hours of runtime",
      "Battery listed as recharging in about 2.5 hours",
      "Usually one of the cheaper complete kits from a known brand"
    ],
    "cons": [
      "Fleece is not wind- or water-resistant on its own: it needs a shell",
      "Shorter rated runtime than the 20-hour Venustas",
      "Proprietary battery"
    ],
    "bottomLine": "The heated vest to wear under the coat you already own, with collar heat for the wind on your neck.",
    "description": "Not everyone needs another outer layer. If you already own a good work coat or ski shell, the smarter buy is a thin heated layer that goes underneath it, and the Venustas fleece vest is built for that job. The listing describes six heat zones including the collar and shoulders, a soft fleece body, a rated runtime of up to 10 hours and a battery that recharges in about two and a half hours. Collar heat is the detail that sells it for snow work. The back of your neck is where cold wind bites first when you are bent over a shovel or walking behind a snow blower, and most vests leave it alone. Fleece also breathes better than a puffer, which matters when you are working hard enough to sweat: trapped sweat is what chills you once you stop. Wear it over a base layer and under a windproof coat and you get warmth without the bulk. The trade-off is that fleece is not a shell. Worn alone in wind or wet snow, it will lose heat quickly and soak through, so this is a layer, not a jacket replacement. The rated runtime is also half that of the 20-hour Venustas, so carry a spare pack for long days. It usually lists below the brand's puffer vests. If you want one vest to wear on its own, choose the Ororo puffer instead."
  },
  {
    "id": "ororo-womens-5-zone-heated-vest",
    "name": "ORORO Women's Heated Vest, Lightweight 5-Zone Water Resistant Vest",
    "category": "Power Bank, 5 Heat Zones, Water-Resistant, Women's Cut",
    "badge": "Best for Women",
    "amazonUrl": "#",
    "pros": [
      "Cut for women rather than a resized men's vest",
      "Five heat zones, per the listing",
      "Water-resistant shell for wet snow",
      "Lightweight enough for active work like shoveling and raking",
      "Battery included, with no tool platform needed"
    ],
    "cons": [
      "One included battery, so buy a spare for long days",
      "Not compatible with tool batteries",
      "Priced like the men's Ororo puffer, around $110"
    ],
    "bottomLine": "The best heated vest for women doing outdoor work: a real women's fit, five zones and a water-resistant shell.",
    "description": "A heated vest only works if the heat panels sit against your body, and a men's vest sized down rarely fits well enough for that. The Ororo women's 5-zone vest is cut for women, and the listing describes five heat zones, a lightweight build and a water-resistant shell. That combination makes it the pick for women who shovel, clear walks or do winter yard work, where a loose vest lets cold air in at the hem and armholes and moves the heat panels away from the back and chest. Five zones is one more than Ororo's classic four-zone vest, and the lightweight construction is easier to move in than a heavy puffer when you are swinging a shovel or carrying bags of ice melt. The water-resistant shell handles the wet, heavy snow that soaks a fleece vest. The battery comes in the box, and like every power-bank vest it is the limit on a long day, so a second pack is a sensible add-on. The trade-offs are the same as the men's Ororo: the battery does not share with your tools, and the price, around $110, is high for a vest you only need on the coldest days. Milwaukee also sells a women's M12 heated AXIS vest, which is the better buy if you already own M12 tools. Ororo makes a matching men's 5-zone vest for a household that wants two."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Heated Vest",
          item: "https://www.thehonestreviewers.com/best-heated-vest/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best heated vest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people working outside who already own Milwaukee M12 tools, the M12 Heated AXIS Vest is the best heated vest, because every charged M12 battery becomes extra hours of heat. If you do not own a tool platform, the Ororo 4-zone puffer is the best all-round choice: insulated, wind- and water-resistant, and sold complete with its battery pack."
          }
        },
        {
          "@type": "Question",
          "name": "How long do heated vests last on one charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the battery and the setting. Listings quote best-case low-setting figures, typically 8 to 10 hours, and some models such as the Venustas 20-hour vest are rated longer. On high heat, expect a fraction of that, often a few hours. Cold batteries also give less, so keep the pack inside the vest and carry a spare."
          }
        },
        {
          "@type": "Question",
          "name": "Is a heated vest or heated jacket better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For active work such as shoveling, raking or construction, a heated vest is usually better. It warms your core, leaves your arms free to move and layers under the coat you already own. A heated jacket is better for standing still in serious cold for hours, because it heats more of your body and replaces your outer layer."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use my Milwaukee or DeWalt tool batteries in a heated vest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you buy the matching brand's vest. Milwaukee's M12 heated vests run on M12 batteries, Makita's DCV200Z runs on 18V LXT packs and DeWalt sells heated vests on its tool batteries. Batteries are not interchangeable between brands without third-party adapters, which we do not recommend for heated gear. Check the exact model before buying spares."
          }
        },
        {
          "@type": "Question",
          "name": "Are heated vests safe to wear all day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Heated vests from established brands are low voltage and safe for most people when worn over a base layer rather than bare skin. Use lower settings for long wear to avoid low-temperature burns, use only the brand's own battery and charger, and talk to a doctor first if you have reduced sensation in your skin, such as from diabetic neuropathy."
          }
        },
        {
          "@type": "Question",
          "name": "Can you wash a heated vest in the washing machine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most heated vests from known brands can be washed if the care label allows it. Remove the battery, zip the connector into its pocket, close all zippers and use a gentle cycle with mild detergent, ideally in a mesh laundry bag. Air dry the vest and make sure the connector is fully dry before reconnecting the battery."
          }
        },
        {
          "@type": "Question",
          "name": "Do heated vests work in wet snow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A heated vest with a water-resistant shell, such as the Ororo or Venustas puffer models, handles wet snow and light precipitation, but no heated vest is fully waterproof gear. Wear a waterproof shell on top in heavy wet snow or rain. If the vest gets soaked, switch it off, remove the battery and dry it before using it again."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Tools & Equipment",
    tags: [
      "best heated vest",
      "heated vest",
      "heated jacket",
      "heated vest for men",
      "milwaukee heated vest",
      "dewalt heated vest",
      "heated vest for work"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated for Winter 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          7 Best <span class="text-[#38BDF8]">Heated Vests</span> for Working Outside
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Heat zones get the attention, but the battery decides whether a heated vest is still warm at hour three. For shoveling, yard work and job sites, buy a vest that runs on tool batteries you already own, or a power-bank vest with a spare pack.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#milwaukee-m12-axis-heated-vest"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Long a Vest Lasts</a>
          <a href="#platform" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Tool Battery or Power Bank</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Heated Vests</a>
          <a href="#vest-vs-jacket" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Heated Vest vs Heated Jacket</a>
          <a href="#layering" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How to Wear One for Work</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. What Size to Buy</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Are Heated Vests Safe?</a>
          <a href="#washing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. How to Wash One</a>
          <a href="#worth-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Are They Worth It?</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
