  "What do haircut numbers mean? Our complete chart explains every clipper guard number from 0 to 8+, with exact lengths in inches and mm, photos, and barber tips.";

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: "Alex Rivers",
  },
  datePublished: "2026-02-26",
  dateModified: "2026-02-26",
  publisher: {
    "@type": "Organization",
    name: "The Honest Reviewers",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": "https://thehonestreviewers.com/haircut-numbers",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What do haircut numbers mean?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Haircut numbers refer to the clipper guard size attached to electric hair clippers. Each number corresponds to a specific hair length: #1 = 1/8 inch (3mm), #2 = 1/4 inch (6mm), #3 = 3/8 inch (10mm), #4 = 1/2 inch (13mm), and so on. The higher the number, the longer the hair left behind. A #0 with no guard cuts closest to the scalp at about 1/16 inch (1.5mm).",
      },
    },
    {
      "@type": "Question",
      name: "What is the most popular haircut number?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The #2 guard (1/4 inch or 6mm) is the most popular haircut number for all-over buzz cuts. For fade haircuts, the most common combination is a #3 or #4 on top with a #1 or #0 fade on the sides. The #2 is popular because it's short enough to look clean and intentional but long enough that the scalp doesn't show prominently.",
      },
    },
    {
      "@type": "Question",
      name: "What is a number 3 haircut?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A number 3 haircut leaves 3/8 inch (10mm) of hair. It's the most popular starting point for first-timers because it's short enough to be low-maintenance but long enough to show clear hair texture and color. A #3 all over gives a clean crew cut look. It's also commonly used as the top length in taper fade combinations.",
      },
    },
    {
      "@type": "Question",
      name: "How do I tell my barber what number I want?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tell your barber the guard number for each section of your head. For example: 'I want a 3 on top, faded to a 1 on the sides.' You can also say the length in inches or millimeters if you prefer. Bring a reference photo if possible — barbers appreciate visual references more than verbal descriptions alone.",
      },
    },
    {
      "@type": "Question",
      name: "What is the difference between a #1 and #2 haircut?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A #1 haircut leaves 1/8 inch (3mm) of hair — very short with visible scalp. A #2 haircut leaves 1/4 inch (6mm) — still short but with noticeably more coverage. The difference is 3mm, but visually it's significant: a #1 shows scalp clearly while a #2 shows the hair's color and provides fuller coverage. Most men prefer a #2 for all-over cuts because it balances clean appearance with adequate coverage.",
      },
    },
    {
      "@type": "Question",
      name: "Are clipper guard numbers the same across all brands?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Clipper guard numbers are mostly standardized across major brands like Wahl, Andis, and Oster — a #2 guard is 1/4 inch (6mm) regardless of brand. However, there can be slight variations of 0.5-1mm between manufacturers, and some brands offer half-sizes (#1.5, #0.5) that others don't. Always check the millimeter marking printed on the guard if precision matters.",
      },
    },
  ],
};
