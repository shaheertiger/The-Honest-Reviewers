---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Portable Power Stations", url: "/best-portable-power-station/" },
    { title: "Portable Power Station vs Generator", url: "/portable-power-station-vs-generator/" },
    { title: "Generator Wattage Chart", url: "/generator-wattage-chart/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-08", modified: "2026-09-08" });
const title = "What Size Portable Power Station Do I Need? (Sizing Guide)";
const description =
  "Two numbers decide it: the watts you draw at once and the watt-hours you use in a day. Here is how to work out both without guessing.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Size Portable Power Station Do I Need",
          item: "https://www.thehonestreviewers.com/what-size-portable-power-station-do-i-need/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What size portable power station do I need for home backup?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a refrigerator, internet, phones and lights through an evening outage, 1,000 to 1,500 watt-hours is enough. To carry the same loads plus a gas furnace blower through a full night and into the next morning, plan on 2,000 to 3,000 watt-hours. Below 500Wh you are powering devices rather than a household.",
          },
        },
        {
          "@type": "Question",
          name: "How many watt-hours do I need per day?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Add the daily consumption of everything you intend to run. A full-size refrigerator uses 1,000 to 2,000Wh a day, a gas furnace blower 1,000 to 2,500Wh on a cold night, and phones, a router, a laptop and LED lights together around 400Wh. A realistic backup day for most households is three to six kilowatt-hours.",
          },
        },
        {
          "@type": "Question",
          name: "Is 1,000Wh enough for a power station?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is enough for a fridge overnight, or a CPAP for two or three nights, or a weekend of phones, lights and laptops while camping. It is not enough to carry a whole household through a full day. Treat 1,000Wh as one appliance for one night rather than as house backup.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need more watts or more watt-hours?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Watts decide whether an appliance will start at all; watt-hours decide how long it runs. Check watts first, because an undersized inverter simply refuses the load, then check watt-hours against your daily total. Most people buy enough watts and not enough watt-hours.",
          },
        },
        {
          "@type": "Question",
          name: "How much usable capacity does a power station actually have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Plan on eighty-five per cent of the rated figure when running AC appliances. The inverter loses roughly ten to fifteen per cent converting DC to AC, and the battery management system holds a small reserve. A 1,000Wh unit realistically delivers around 850Wh at the outlets, less in the cold.",
          },
        },
        {
          "@type": "Question",
          name: "What size power station runs a refrigerator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Any unit with a 1,000W or larger inverter will start a domestic fridge, and 1,000Wh of capacity will run one for eight to fourteen hours. For a full twenty-four hours of fridge and freezer, size at 2,000Wh, because the compressor's duty cycle rises as the kitchen warms up.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a bigger power station than I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Buy one size larger than your arithmetic suggests, but not three. Cold weather, ageing cells and inverter losses all erode real capacity, and a battery that is never fully drained lasts longer. Beyond that, extra capacity mostly buys weight you will not carry and money better spent on solar panels.",
          },
        },
        {
          "@type": "Question",
          name: "Can I expand a portable power station later?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many mid-size and large models accept add-on battery packs that double or triple capacity without changing the inverter. If your needs might grow, buying into an expandable range is cheaper than replacing the whole unit, but check that the expansion battery is still sold before relying on the promise.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

