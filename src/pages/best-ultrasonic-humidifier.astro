const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Ultrasonic Humidifiers",
          item: "https://www.thehonestreviewers.com/best-ultrasonic-humidifier/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Are ultrasonic humidifiers better than evaporative ones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are quieter and cheaper to run, and they cannot be beaten for silence in a bedroom. Evaporative models are better if your water is hard and you will not use distilled water, because the wick traps minerals instead of putting them in the air, and they naturally resist over-humidifying. Neither is better for everyone; your water and your tolerance for cleaning decide it."
          }
        },
        {
          "@type": "Question",
          "name": "Do I have to use distilled water in an ultrasonic humidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. If your tap water is soft, you may see little or no white dust. If it is hard, distilled or reverse-osmosis water is the reliable way to avoid dust, and the EPA advises using water with lower mineral content to reduce exposure. A demineralization cartridge is the middle ground if buying distilled water every week is not realistic for you."
          }
        },
        {
          "@type": "Question",
          "name": "Is white dust from a humidifier harmful?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA says some people are bothered by the white dust ultrasonic and impeller humidifiers produce, and that using lower-mineral water reduces exposure. It has not set a specific health limit for it. If anyone in the home has asthma or a lung condition, use distilled water as a matter of course and ask their doctor whether a different humidifier type would suit them better."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I clean an ultrasonic humidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Empty and refill it daily, and give it a rinse and wipe every third day, which is the interval the EPA recommends for portable humidifiers. Once a week, descale the base and transducer with white vinegar following the manual, then rinse thoroughly. A top-fill unit with a wide opening makes this far easier than a narrow bottle-style tank."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put essential oils in an ultrasonic humidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only in the aroma pad or tray if the model has one, such as the LV600S, or in VapoPads on Vicks models. Adding oil directly to the tank can damage plastic parts and the transducer, and most manuals forbid it. If the unit has no aroma feature, use a separate diffuser instead of putting oil in the water."
          }
        },
        {
          "@type": "Question",
          "name": "Is warm mist from an ultrasonic humidifier cleaner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, not reliably. Warm-mist ultrasonic units warm the water before the transducer turns it into mist; they do not boil it for long enough to rely on for sterilizing. Minerals pass through either way, so white dust and tank hygiene rules are identical in both modes. If you want a unit that truly boils its water, look at a steam vaporizer."
          }
        },
        {
          "@type": "Question",
          "name": "What size ultrasonic humidifier do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a single bedroom or office, a 1.5 to 4 liter tank is plenty. For a large bedroom or a modest living room, a 6-liter unit with around 300 mL per hour of output is the sweet spot. For open-plan spaces, look at a 10-liter tower like the OasisMist 1000S, a large evaporative console or two units in separate rooms."
