const moreInCategory = [
  {
    "title": "Best Humidifiers",
    "url": "/best-humidifier/"
  },
  {
    "title": "Best Evaporative Humidifiers",
    "url": "/best-evaporative-humidifier/"
  },
  {
    "title": "Evaporative vs Ultrasonic Humidifier",
