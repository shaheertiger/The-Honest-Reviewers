const dates = pageDates(Astro.url.pathname, { published: "2026-10-20", modified: "2026-10-20" });
const title = "Best Ultrasonic Humidifiers: 6 Quiet Picks, Minus the White Dust";
const description =
  "Six ultrasonic humidifiers compared on tank size, warm mist, coverage and cleaning, plus the water rules that stop white dust before it coats your furniture.";

