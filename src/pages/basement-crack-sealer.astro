const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Basement Crack Sealer",
          item: "https://www.thehonestreviewers.com/basement-crack-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best basement crack sealer for a leaking wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a leaking crack in a poured concrete wall, low-pressure polyurethane injection is generally the best choice. The resin travels through the full thickness of the wall, reacts with moisture, and expands into a flexible seal that tolerates seasonal movement. It can usually be injected into a damp crack. Surface caulks and coatings rarely stop a pressurized leak on their own."
          }
        },
        {
          "@type": "Question",
          "name": "Is epoxy or polyurethane better for basement wall cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the job. Polyurethane is better for sealing leaks, because it stays flexible and tolerates moisture during injection. Epoxy is better when a dry, stable crack needs structural strength restored, because it bonds the two faces together rigidly. Injecting epoxy into a crack that still moves or is wet usually leads to a new crack and a returning leak."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal a basement crack from the inside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Injection from the inside is the standard method for leaking poured wall cracks, because the resin is pushed through the wall to the outside face. Interior caulks and coatings also work for dry cracks. What interior surface products cannot reliably do is hold back water pressure on their own. For multiple leaks, exterior waterproofing is the most reliable fix."
          }
        },
        {
          "@type": "Question",
          "name": "Does hydraulic cement permanently fix a leaking crack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Hydraulic cement sets in minutes and can stop flowing water, but it is rigid and only fills the outer part of the crack. In a crack that moves seasonally, owners commonly report the plug cracking along its edges and the leak returning. Use it to stop an active leak, then inject the crack or coat the wall."
          }
        },
        {
          "@type": "Question",
          "name": "Will Drylok or other waterproofing paint seal a crack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Masonry waterproofing paints are designed for porous walls with general dampness, not for open cracks. Most manufacturers instruct you to fill or seal cracks before painting. A paint film over a moving crack will split along the crack line, and water concentrated there can push the coating off. Seal the crack first, then paint the wall if seepage is widespread."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use basement crack injection on a block wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Injection works by filling a continuous crack through solid concrete. Hollow concrete block has open cores, so injected resin flows into the cores instead of sealing the crack. Block wall leaks are usually handled with exterior drainage, interior drainage systems, and masonry coatings. Stair-step cracks in block also need a structural assessment before any repair."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know if a basement crack needs a professional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call a professional if the crack is horizontal, forms a stair-step pattern in block, is wider than about 1/4 in, shows one side offset from the other, or comes with a bowing or leaning wall. Also call if the crack keeps widening when you measure it over months. Those signs point to soil pressure or settlement, not simple shrinkage."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
