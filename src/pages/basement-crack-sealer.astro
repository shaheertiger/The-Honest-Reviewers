                    <td class="px-4 py-4 text-gray-700">Water-reactive polyurethane foam</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dry, stable hairline</td>
                    <td class="px-4 py-4 text-gray-700">Polyurethane caulk or coating</td>
                    <td class="px-4 py-4 text-gray-700">Leave it and monitor</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Block wall seepage</td>
                    <td class="px-4 py-4 text-gray-700">Drainage plus masonry coating</td>
