---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "Best Brick Sealer", url: "/best-brick-sealer-reviews/" },
    { title: "Best Cinder Block Sealer", url: "/best-cinder-block-sealer-reviews/" },
    { title: "Sealing Old Concrete", url: "/sealing-old-concrete/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-08", modified: "2026-09-08" });
const title = "LastiSeal Review: Does the 15-Year Sealer Deliver?";
const description =
  "An honest LastiSeal review — how the penetrating polymerising sealer works on brick, block and concrete, where it beats film-forming products, and where it fails.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "LastiSeal Review", item: "https://www.thehonestreviewers.com/lastiseal-reviews/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does LastiSeal actually work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On porous masonry that has been properly cleaned, yes. LastiSeal penetrates into the pore structure and polymerises inside it, so there is no surface film to peel and the treated brick or block stops absorbing water. Its weakness is not the chemistry but the tolerance: on a dense, sealed, or contaminated surface it cannot get in, and a sealer that cannot penetrate does nothing at all.",
          },
        },
        {
          "@type": "Question",
          name: "Is LastiSeal better than a silane-siloxane sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They work differently rather than better or worse. Silane-siloxane sealers line the pores with a hydrophobic layer and leave the masonry breathable; LastiSeal fills and polymerises inside the pores, which blocks water more completely but reduces vapour transmission. For most exterior brick, silane-siloxane is the safer default. For very porous, deteriorating masonry that needs consolidating as well as sealing, LastiSeal has the advantage.",
          },
        },
        {
          "@type": "Question",
          name: "Does LastiSeal change the appearance of brick?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The clear sealer is designed to leave the natural appearance unchanged — no gloss, no wet look, no darkening — because there is no film on the surface. In practice, very porous or previously stained masonry can darken slightly, so a test patch is worth doing. The Stain and Sealer version is a different product entirely and deliberately adds colour.",
          },
        },
        {
          "@type": "Question",
          name: "How long does LastiSeal last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The manufacturer offers a 15-year warranty on properly applied product, and the mechanism supports a long life: a polymer locked inside the pore structure is not exposed to UV or abrasion the way a surface film is. The realistic caveat is that the warranty assumes a correctly prepared, sufficiently porous substrate — the same condition that determines whether it works at all.",
          },
        },
        {
          "@type": "Question",
          name: "Can you apply LastiSeal over an existing sealer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It has to penetrate, and any existing sealer — film-forming or penetrating — blocks that. The surface must be stripped and cleaned back to bare, open masonry. The water test settles it: if water beads rather than soaking in within about thirty seconds, the surface is not ready and applying LastiSeal will waste the product.",
          },
        },
        {
          "@type": "Question",
          name: "How many coats of LastiSeal do you need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Two to three thin coats applied wet-on-wet, with each coat going on while the previous one is still damp. That technique keeps the pores open and carries the product deeper rather than letting the surface seal off first. Flooding it on in a single heavy coat does the opposite and leaves a residue on the surface.",
          },
        },
        {
          "@type": "Question",
          name: "Is LastiSeal worth the price?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On porous brick, block, or old concrete that will otherwise need resealing every two to four years, the arithmetic favours it — one careful application against several rounds of stripping and recoating. On dense concrete where it cannot fully penetrate, or where a wet look is the goal, cheaper products do the job better and it is not worth the premium.",
          },
        },
        {
          "@type": "Question",
          name: "Can LastiSeal be used on basement walls?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is used on interior masonry and helps against moisture migrating through porous block, but it is not a substitute for a rated waterproofing coating where hydrostatic pressure is involved. For a wall with active seepage, a cementitious waterproofer with a published pressure rating is the correct product, and drainage comes before either.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
