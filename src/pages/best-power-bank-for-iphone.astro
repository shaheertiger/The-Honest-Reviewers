---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Solar Power Banks",
    "url": "/best-solar-power-bank/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-charger-for-power-outages/"
  },
  {
    "title": "Best Power Banks for Travel",
    "url": "/best-power-bank-for-travel/"
  },
  {
    "title": "Best Power Banks for Camping",
    "url": "/best-camping-power-bank/"
  },
  {
    "title": "Best Laptop Power Banks",
    "url": "/best-laptop-power-bank/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-25", modified: "2026-11-25" });
const title = "7 Best Power Banks for iPhone in 2026: MagSafe, Qi2 and USB-C";
const description =
  "The best power banks for iPhone from Anker, Belkin, Baseus and INIU, compared on Qi2 and MagSafe magnetic charging vs USB-C cables, 20W and 30W output, real iPhone charges per mAh and airline limits.";

const PRODUCTS = [
  {
    "id": "anker-maggo-10k-slim",
    "name": "Anker MagGo Power Bank (10K, Slim)",
    "category": "10,000mAh, Qi2 Certified 15W Magnetic, 30W USB-C, 0.58 in Thick",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "pros": [
      "Qi2 certified 15W magnetic charging for iPhone 12 and later",
      "30W max USB-C port for faster wired top-ups",
      "Listed at 0.58 x 2.78 x 4.09 inches, slim enough for a pocket",
      "Anker rates it for up to 1.8 charges of an iPhone 15 Pro",
      "Metal frame and aerogel insulation to keep it cool, per the listing"
    ],
    "cons": [
      "No display, so you read charge level from LEDs",
      "No built-in stand",
      "Anker does not recommend it for Android phones"
    ],
    "bottomLine": "The best power bank for iPhone for most people: Qi2 magnetic charging, a 30W cable port and 10,000mAh in a pocketable slab.",
    "description": "Most iPhone owners want one thing from a power bank: snap it on, forget about it, and get home with battery left. The slim Anker MagGo does that better than anything else here. The listing describes a 10,000mAh pack measuring 0.58 by 2.78 by 4.09 inches with Qi2 certified magnetic charging at up to 15W, the standard Qi2 speed that recent iPhones accept from a magnetic pack. The spec that matters is the second output: a 30W max USB-C port. When you are in a hurry, a cable from that port charges faster and wastes less energy than the magnetic pad, and it handles AirPods or a second phone at the same time. Anker rates it for up to 1.8 charges of an iPhone 15 Pro, which matches the conversion math in this guide. Owners commonly report it stays comfortable in the hand during wireless charging, which Anker credits to a metal frame and aerogel insulation. The trade-offs are small: there is no screen, only indicator lights, and no kickstand for watching video. Anker also says it is designed for iPhone and does not recommend it for Android phones. Buy the MagGo 2 Pro instead if you own a recent iPhone that supports 25W Qi2.2 charging and want speed, or the Belkin if you want a stand."
  },
  {
    "id": "anker-maggo-2-pro",
    "name": "Anker MagGo 2 Pro Power Bank (10K, Qi2.2 25W)",
    "category": "10,000mAh, Qi2.2 25W Magnetic, Active Cooling Fan, Smart Display and Stand",
    "badge": "Fastest Magnetic",
    "amazonUrl": "#",
    "pros": [
      "Qi2.2 magnetic charging rated up to 25W",
      "Active cooling fan and graphene layers to hold charging speed",
      "Smart display shows charging power, temperature and battery health",
      "Built-in 0 to 80 degree stand folds flat",
      "45W USB-C recharge: 80% in 52 minutes, per Anker"
    ],
    "cons": [
      "25W only on iPhones that support Qi2.2; older models charge slower",
      "A fan is one more thing that can make noise",
      "Thicker and heavier than the slim MagGo"
    ],
    "bottomLine": "The fastest magnetic bank here, worth it only if your iPhone supports 25W Qi2.2 charging.",
    "description": "Wireless charging has always been the slow, warm way to charge an iPhone. The MagGo 2 Pro is Anker's attempt to fix both problems at once. The listing rates it for Qi2.2 magnetic charging at up to 25W, and Anker says it takes a supported iPhone to 50% in 25 minutes. The spec that matters is the active cooling: a small fan, dual air channels and three graphene layers, which Anker says keep the pack below 96.8 degrees Fahrenheit. Heat is what makes wireless charging slow down, because the iPhone throttles itself when it gets warm, so cooling is how a magnetic bank actually holds 25W instead of advertising it. A smart display shows charging power, temperature and battery health, a stand folds out from 0 to 80 degrees, and the bank recharges to 80% in 52 minutes from a 45W source. The trade-off is that 25W only applies to iPhones that support Qi2.2; Anker's listing carries a compatibility note, so check it against your model before buying. Older iPhones still charge, just at 15W or below, and then you are paying for speed you cannot use. Buy the slim MagGo instead if your phone is older than the iPhone 16 family or you hate the idea of a fan."
  },
  {
    "id": "belkin-boostcharge-pro-qi2-10k-stand",
    "name": "Belkin BoostCharge Pro 10,000mAh Qi2 15W Power Bank with Kickstand",
    "category": "10,000mAh, Qi2 15W Magnetic, Built-In Kickstand, Charges 3 Devices",
    "badge": "Best With a Stand",
    "amazonUrl": "#",
    "pros": [
      "Qi2 magnetic charging at up to 15W",
      "Built-in kickstand for video calls and StandBy mode",
      "Charges three devices at once: one wireless, two by USB-C",
      "15W pass-through mode while the bank itself is plugged in",
      "3.3 ft USB-C to USB-C cable in the box"
    ],
    "cons": [
      "LED indicator only, no percentage display",
      "Wired output is modest next to the 30W Anker",
      "Kickstand adds a little thickness"
    ],
    "bottomLine": "The magnetic bank to buy if you prop your iPhone up to watch, call or navigate while it charges.",
    "description": "Belkin is one of the accessory makers Apple has sold in its own stores for years, and this BoostCharge Pro is the one to pick if you want your iPhone standing up while it charges. The listing describes a 10,000mAh pack with Qi2 magnetic charging at up to 15W and a built-in kickstand, so the phone sits at a usable angle on a desk, tray table or nightstand. The spec that matters is pass-through: Belkin lists 15W charging in Pass-Thru Mode, which means you can plug the bank into the wall overnight, leave the iPhone attached, and wake up with both topped up. That turns one accessory into a travel bedside charger and saves packing a separate MagSafe puck. It can also charge three devices at once, one by magnet and two over USB-C cables, and Belkin rates it for up to 35 extra hours of video playback on a phone. The trade-offs are that charge level shows on LEDs rather than a percentage display, the wired output is not as quick as the 30W port on the slim Anker, and the stand adds some thickness in a pocket. Buy the Baseus PicoGo instead if you want a stand in the smallest possible size and only need a partial top-up."
  },
  {
    "id": "baseus-picogo-5000-stand",
    "name": "Baseus PicoGo 5,000mAh Qi2 Magnetic Power Bank with Stand",
    "category": "5,000mAh, Qi2 Certified 15W Magnetic, 20W USB-C, Aluminum Kickstand, 0.3 lb",
    "badge": "Most Compact",
    "amazonUrl": "#",
    "pros": [
      "Credit-card footprint: 3.4 x 2.3 x 0.5 inches",
      "About 0.3 lb, so it disappears on the back of the phone",
      "Qi2 certified 15W magnetic charging",
      "20W max USB-C port for wired charging",
      "Aluminum kickstand for landscape or portrait viewing"
    ],
    "cons": [
      "5,000mAh is roughly a 70 to 90% top-up, not a full charge, on most iPhones",
      "Small capacity makes heat and conversion loss proportionally costly",
      "Not enough for a weekend away from power"
    ],
    "bottomLine": "The smallest sensible magnetic bank: a daily insurance top-up that you will actually carry.",
    "description": "A power bank only helps if it is with you, and the Baseus PicoGo is small enough that it always will be. The listing gives a credit-card footprint of 3.4 by 2.3 by 0.5 inches and a weight of about 0.3 pounds, with Qi2 certified magnetic charging at up to 15W, a 20W max USB-C port and an aluminum kickstand. Baseus says it fits even an iPhone 13 mini without hanging over the edges. The spec that matters is the capacity, and it cuts both ways. At 5,000mAh it holds about 18.5 watt-hours, and after wireless losses that is roughly 10 to 12 watt-hours delivered to the phone, which is most of a charge on a base iPhone and well under half of a Pro Max. That is the right amount for someone who leaves home at 80% and dies at 6 p.m., and the wrong amount for a weekend trip. If you charge by cable from the 20W port you lose less energy and squeeze a little more out of it. The kickstand is a genuine bonus for video on a flight or a call at your desk. Buy a 10,000mAh magnetic bank instead if you own a Pro Max, use your phone heavily for navigation, or want a full charge in reserve."
  },
  {
    "id": "anker-zolo-20k-usb-c-lightning",
    "name": "Anker Zolo Power Bank (20K, 30W, Built-In USB-C and Lightning Cables)",
    "category": "20,000mAh, 30W, Built-In USB-C and MFi Lightning Cables, 4 Outputs",
    "badge": "Best for Lightning iPhones",
    "amazonUrl": "#",
    "pros": [
      "Built-in USB-C cable and MFi certified Lightning cable",
      "30W output: iPhone 15 to 58% in 30 minutes, per Anker",
      "Rated for 4.02 charges of an iPhone 15 Pro",
      "Charges four devices at once with a USB-C and a USB-A port too",
      "Cables rated for 10,000+ bends"
    ],
    "cons": [
      "No magnetic charging",
      "Too big to clip to the back of a phone",
      "18-month warranty, shorter than the MagGo line"
    ],
    "bottomLine": "The one bank that charges every iPhone in a mixed Lightning and USB-C household without a cable hunt.",
    "description": "Many homes still have an iPhone 13 or 14 next to an iPhone 15 or 16, which means one Lightning phone and one USB-C phone. The Anker Zolo with both cables built in solves that without a drawer of adapters. The listing describes a 20,000mAh pack with an MFi certified Lightning cable and a USB-C cable fixed to the body, plus a separate USB-C port and a USB-A port, so it can charge four devices at once. Output is rated at 30W, and Anker says that takes an iPhone 15 to 58% in 30 minutes. The spec that matters is capacity: Anker rates it for 4.02 charges of an iPhone 15 Pro, which lines up with the 20,000mAh math in this guide and makes it a sensible family bank for a road trip or a power cut. MFi certification matters for the Lightning lead, because uncertified Lightning cables are the ones iPhones reject with an accessory warning. It measures 4.72 by 2.89 by 1.24 inches, so it lives in a bag rather than on the phone, and there is no magnetic pad. Buy a MagGo or the Belkin instead if everyone in the house is on iPhone 12 or later and prefers snap-on charging, or the INIU slim if you only need 10,000mAh."
  },
  {
    "id": "anker-nano-5k-built-in-usb-c",
    "name": "Anker Nano Power Bank (5K, 22.5W, Built-In USB-C Connector)",
    "category": "5,000mAh, 22.5W, Foldable Built-In USB-C Connector, 2 USB-C Ports",
    "badge": "Best Cable-Free for iPhone 15+",
    "amazonUrl": "#",
    "pros": [
      "Foldable USB-C connector plugs straight into iPhone 15 and later",
      "22.5W output, quicker than any 15W magnetic pad",
      "No cable to carry, lose or forget",
      "Second USB-C port for AirPods or another device",
      "24-month warranty, per the listing"
    ],
    "cons": [
      "Useless directly on Lightning iPhones (14 and older)",
      "Sticks out from the bottom of the phone while charging",
      "5,000mAh is a top-up, not a full day"
    ],
    "bottomLine": "For iPhone 15 and newer owners who want the quickest, most efficient top-up with nothing to carry but the bank.",
    "description": "Since the iPhone 15 moved to USB-C, the most efficient way to top up an iPhone is a bank that plugs straight into the port. The Anker Nano does exactly that. The listing describes a 5,000mAh pack with a foldable built-in USB-C connector and two USB-C ports rated for 22.5W output. The spec that matters is the direct connection. A wired path wastes far less energy than a magnetic pad, so the same 5,000mAh delivers more charge to the phone than the PicoGo can manage wirelessly, and 22.5W is faster than any 15W Qi2 bank. There is also no cable to forget, which is the usual reason a power bank sits uselessly in a bag. Owners commonly like that it works with the phone in a case, though very thick cases can get in the way of the connector. The trade-offs are clear. It only works directly with USB-C iPhones, so an iPhone 14 or older needs a USB-C to Lightning cable from the second port. While it charges, the bank sticks out from the bottom of the phone, which is awkward if you want to use the phone at the same time. Buy the slim MagGo instead if you want to keep using the phone comfortably while it charges, or the Zolo for Lightning models."
  },
  {
    "id": "iniu-slim-10000-20w",
    "name": "INIU Slim 10,000mAh 20W PD Portable Charger",
    "category": "10,000mAh, 20W PD USB-C, 0.5 in Thick, Built-In Flashlight",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "pros": [
      "20W PD output, the speed Apple's own 20W adapter delivers",
      "About 0.5 inch thick, per INIU",
      "Rated for 1.8 charges of an iPhone 14",
      "Two USB-C ports, so it works with the cable that came with your iPhone",
      "Built-in flashlight and TempGuard temperature monitoring"
    ],
    "cons": [
      "No magnetic charging",
      "20W ceiling, below the 30W banks here",
      "You still carry a separate cable"
    ],
    "bottomLine": "The no-frills way to give any iPhone 20W fast charging and nearly two full charges.",
    "description": "If you do not need magnets, a display or a built-in stand, the INIU slim covers the basics with nothing extra to pay for. The listing describes a 10,000mAh pack about half an inch thick with 20W Power Delivery fast charging, which INIU says takes an iPhone 14 to 60% in 30 minutes. The spec that matters is that 20W PD rating. It is the same speed as Apple's own 20W USB-C adapter, which is enough to fast-charge every iPhone since the iPhone 8, and it is the floor you should insist on for any iPhone bank. INIU rates it for 1.8 charges of an iPhone 14, the same as the 10,000mAh magnetic banks, because a cable wastes less energy than a magnetic pad. Two USB-C ports mean it works with the USB-C cable that ships with recent iPhones, and with a USB-C to Lightning cable for older ones. A small flashlight is genuinely useful in a power cut, and INIU's TempGuard monitors temperature during charging. The trade-offs are that you must carry a cable, the phone and bank are separate objects in your hand, and output stops at 20W. Buy the slim MagGo instead if you would rather snap the bank on and keep using the phone, or the Zolo if you want twice the capacity."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Power Banks for iPhone",
          item: "https://www.thehonestreviewers.com/best-power-bank-for-iphone/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best power bank for iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the Anker MagGo Power Bank (10K, Slim). It is Qi2 certified for 15W magnetic charging, has a 30W USB-C port for faster wired top-ups, is rated for about 1.8 charges of an iPhone 15 Pro, and is slim enough for a pocket. Owners of recent iPhones that support Qi2.2 should consider the 25W Anker MagGo 2 Pro instead."
          }
        },
        {
          "@type": "Question",
          "name": "How many times will a 10,000mAh power bank charge an iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "About 1.8 times by cable for a standard iPhone, and roughly 1.5 times wirelessly. The math: 10,000mAh at 3.7 volts is 37 Wh, about 65% of which reaches the phone by cable, or around 24 Wh. Divided by a roughly 13 Wh iPhone battery, that is 1.8 charges. A Pro Max gets about 1.3 charges from the same bank."
          }
        },
        {
          "@type": "Question",
          "name": "Is a MagSafe power bank worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you top up while using your phone. A Qi2 magnetic bank snaps on, charges without a cable and lets you keep scrolling or navigating. It is less efficient than a cable, so you get fewer charges per mAh and more heat. If you mostly charge overnight or in an outage, a USB-C cable bank gives more charge for the money."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between MagSafe and Qi2?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "MagSafe is Apple's magnetic charging system for iPhone 12 and later. Qi2 is the open wireless standard built on the same magnetic alignment, and a Qi2 certified bank charges a compatible iPhone at up to 15W. Qi2.2 raises that to 25W on recent iPhones that support it. Older packs sold only as MagSafe-compatible often deliver just 7.5W."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a 20W or 30W power bank for iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 20W USB Power Delivery output is enough to fast-charge any iPhone from the iPhone 8 on, reaching around 50% in about 30 minutes. A 30W port adds headroom so recent models can hold their peak charging rate longer and so a second device can charge at the same time without slowing the phone. Make sure the output is USB-C PD."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take an iPhone power bank on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Power banks up to 100 Wh can be carried without airline approval under FAA and IATA guidance, and every bank in this guide is well below that; a 20,000mAh bank is about 74 Wh. They must go in carry-on luggage, never checked bags. Some airlines now restrict using power banks during the flight, so check your carrier's rules."
          }
        },
        {
          "@type": "Question",
          "name": "Will a power bank damage my iPhone battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A quality bank charges an iPhone the same way a wall adapter does, and the phone controls its own charging. Heat is what wears a battery, and wireless charging creates more of it. Avoid charging a phone in direct sun or a hot car with a magnetic bank attached, and let Optimized Battery Charging or the 80% limit work."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Generators & Backup Power",
    tags: [
      "power bank for iphone",
      "best power bank for iphone",
      "magsafe power bank",
      "qi2 power bank",
      "iphone portable charger",
      "magnetic power bank for iphone"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Power Banks for iPhone</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Snap-on Qi2 packs, 25W magnetic chargers and USB-C cable banks for every iPhone from the 12 to today, with the math on how many charges you really get.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-maggo-10k-slim"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See All 7 Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="3.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#charges" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How Many Charges in 10,000mAh</a>
          <a href="#magsafe" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. MagSafe, Qi2 or Cable</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The 7 Best Power Banks for iPhone</a>
          <a href="#watts" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. 20W or 30W?</a>
          <a href="#connector" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. USB-C or Lightning</a>
          <a href="#size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. What Size You Need</a>
          <a href="#airline" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Flying With a Power Bank</a>
          <a href="#battery-health" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Battery Health and Heat</a>
          <a href="#outages" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. iPhones in a Power Outage</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
