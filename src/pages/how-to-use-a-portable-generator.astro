const title = "How to Use a Portable Generator: The Order That Protects the Machine";
const description =
  "Placement, start-up with nothing connected, adding loads largest first, and shutting down under no load. The sequence that avoids both carbon monoxide and a dead alternator.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
