                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Size</td>
                    <td class="px-4 py-4 text-gray-700">No smaller than the valve outlet, full size to the end</td>
