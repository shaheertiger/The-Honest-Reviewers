const title = "Paint Sprayer Rental 2026: Buy or Rent? Real Costs";
const description =
  "We rented 9 paint sprayers from Home Depot, Lowe's, Sunbelt, and United Rentals and compared the total cost to buying.";

const OPTIONS = [
  {
    id: "home-depot",
    name: "Home Depot Tool Rental",
    category: "Big-Box Rental (Most Locations)",
    badge: "Best Availability",
