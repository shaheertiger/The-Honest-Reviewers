---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Fertilizer for Grass",
    "url": "/best-fertilizer-for-grass/"
  },
  {
    "title": "Best Grass Seed",
    "url": "/best-grass-seed/"
  },
  {
    "title": "Best Weed Killers",
    "url": "/best-weed-killer/"
  },
  {
    "title": "Best Ice Melt for Concrete",
    "url": "/best-ice-melt-for-concrete/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Mulching Mowers",
    "url": "/best-mulching-mower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "8 Best Broadcast Spreaders for Fertilizer, Seed and Ice Melt";
const description =
  "Eight broadcast spreaders compared on accuracy, edge control, hopper size and build, from Scotts EdgeGuard to LESCO stainless and tow-behinds, plus calibration.";

const PRODUCTS = [
  {
    "id": "scotts-elite-spreader",
    "name": "Scotts Elite Spreader",
    "category": "Dual-Rotor Broadcast, up to 20,000 sq ft",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 5000,
    "pros": [
      "Dual rotors throw a 6-foot pattern, so you make fewer passes than with a standard 5-foot spreader",
      "Hopper holds enough product for up to 20,000 sq ft, enough for most suburban lawns in one fill",
      "EdgeGuard lever blocks the right side of the pattern along driveways, beds and walks",
      "10-inch foam-filled tires never go flat and roll well over bumpy turf",
      "Arrives fully assembled, and every Scotts bag prints its setting for this dial"
    ],
    "cons": [
      "Plastic frame and gearbox are homeowner grade, not built for daily professional use",
      "Scotts publishes no mechanical warranty, only its satisfaction guarantee"
    ],
    "bottomLine": "The best broadcast spreader for most homeowners: wide, accurate, easy to set, and ready to use straight out of the box.",
    "description": "The Elite takes the thing Scotts spreaders already do well — easy, printed-on-the-bag settings — and fixes the thing they traditionally did poorly, which is spread width. Instead of a single spinning disc, it uses two rotors side by side, which produces a 6-foot spread pattern that is more even across its width than single-rotor designs. Scotts rates it as about 20 percent faster than a standard 5-foot spreader, and on a quarter-acre lawn that is the difference between a dozen passes and fifteen. The dual rotors also reduce the familiar striping pattern that appears when a single-disc spreader throws more product in the middle than at the edges. The hopper holds enough for up to 20,000 square feet, which covers most suburban lawns in one fill. EdgeGuard is a lever on the handle that blocks the right side of the pattern, so you can run the spreader along a driveway or flower bed without throwing fertilizer onto concrete or mulch. The 10-inch foam-filled tires will never go flat, and while they do not cushion quite as well as air-filled tires, they roll easily over rough lawns. It arrives fully assembled and pre-calibrated, has a phone holder on the handle, and the handle folds for storage. The limitations are about durability: the frame and gearbox are plastic, and Scotts backs it with its satisfaction guarantee rather than a mechanical warranty. For a homeowner applying four or five times a year, that is an acceptable trade."
  },
  {
    "id": "lesco-101186-spreader",
    "name": "LESCO 101186 High Wheel Commercial Spreader",
    "category": "80 lb Commercial Rotary, Stainless Frame",
    "badge": "Best Commercial-Grade",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 1500,
    "pros": [
      "80 lb hopper covers large lawns without constant refilling",
      "Stainless steel frame, axle, impeller shaft and on/off assembly resist fertilizer corrosion",
      "13 x 5.00-6 pneumatic tires roll smoothly and keep the spread steady on rough ground",
      "Enclosed 5:1 gearbox is protected from dust and granules, and the oscillating agitator keeps product flowing",
      "Three-position handle adjusts for operator height"
    ],
    "cons": [
      "Premium price, and heavier than homeowner spreaders at about 42 lb empty",
      "No Scotts-style settings on the bag, so you need a conversion chart or your own calibration"
    ],
    "bottomLine": "The spreader landscapers buy, and the one to get if you have a large lawn or want a spreader that will last a decade.",
    "description": "The LESCO 101186 is the spreader you see bolted to the side of landscaping trailers, and the reasons carry over to a homeowner with a big lawn. The first is corrosion resistance. Fertilizer is salt, and salt eats steel; the most common way a spreader dies is a rusted axle or a seized impeller shaft. LESCO builds the frame, axle, impeller shaft and on/off assembly from stainless steel, so it survives years of fertilizer and ice melt in a way painted steel spreaders do not. The second is the drivetrain: a fully enclosed gearbox with a 5:1 ratio keeps grit and granules out of the gears, and a cam-operated oscillating agitator keeps product flowing through the drop holes without crushing coated fertilizer. The 80 lb hopper holds far more than any homeowner push spreader, which on a half-acre lawn or larger means far fewer trips back to the garage. The large 13 x 5.00-6 pneumatic tires roll over lumpy turf without jolting the hopper, which helps keep the pattern steady, and the handle adjusts to three heights. Two caveats: this is a premium-priced spreader, and it weighs about 42 lb empty. The more important one is settings. Because it is not a Scotts spreader, the bag will not always print a setting for it; you will rely on conversion charts or, better, your own calibration. For experienced users, that is a feature, not a problem."
  },
  {
    "id": "scotts-edgeguard-dlx-spreader",
    "name": "Scotts Turf Builder EdgeGuard DLX Broadcast Spreader",
    "category": "Broadcast, up to 15,000 sq ft",
    "badge": "Best Value",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 9500,
    "pros": [
      "Holds enough product for up to 15,000 sq ft of lawn",
      "EdgeGuard blocks the right side of the pattern along edges",
      "Arrives assembled and pre-calibrated, with settings printed on every Scotts bag",
      "Mid-range price with the features most homeowners actually use"
    ],
    "cons": [
      "Single rotor gives a narrower, less even pattern than the Elite's dual rotors",
      "Plastic construction and gearing wear out faster than steel spreaders"
    ],
    "bottomLine": "The best balance of price and function for lawns up to about a third of an acre.",
    "description": "The EdgeGuard DLX is one of the best-selling broadcast spreaders around for a reason: it does everything a typical homeowner needs, for a mid-range price, with no setup. It comes out of the box assembled and pre-calibrated, and every Scotts bag prints a setting for it, so you can put down a bag of fertilizer on a Saturday morning without doing any maths. The hopper holds enough for up to 15,000 square feet, which covers most lawns up to about a third of an acre in one fill. EdgeGuard works the same way it does on the Elite: flip the lever, and a shield blocks the right side of the throw so you can walk along a driveway or bed edge without spraying granules onto concrete or mulch. Scotts lists the spread width at up to about 6 feet, though the effective even pattern is narrower than that, so plan overlapping passes. Compared with the Elite, the DLX gives up the dual rotors, which means a slightly narrower and less even pattern and more attention needed to avoid stripes. It also gives up the foam-filled tires. Compared with a commercial spreader, it gives up durability: the plastic gearing and frame will not last as many years if you also use the spreader for ice melt, and it should be rinsed after every use. For most homeowners with a standard suburban lot, those compromises are worth the lower price."
  },
  {
    "id": "earthway-2150-spreader",
    "name": "Earthway 2150 Commercial Broadcast Spreader",
    "category": "50 lb Commercial Walk-Behind",
    "badge": "Best Mid-Size Pro Spreader",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 2000,
    "pros": [
      "Large 13 x 4.00 pneumatic tires on rustproof poly rims handle rough ground",
      "Rate control sits high on the handle with a direct-connect linkage for accurate, repeatable settings",
      "Fully enclosed super-duty gearbox for long life",
      "Adjustable side-throw control helps keep product off beds and walks",
      "Light at about 23 lb empty, with a hopper screen and nylon shut-off plate included"
    ],
    "cons": [
      "50 lb hopper is smaller than the LESCO, so large lawns mean more refills",
      "Settings are not printed on Scotts bags, so calibration is on you"
    ],
    "bottomLine": "Commercial-grade build at a mid-range price, and the best step up from a Scotts spreader for most owners.",
    "description": "The Earthway 2150 sits in the middle ground between a homeowner Scotts spreader and a full commercial rig like the LESCO, and for a lot of buyers it is the sweet spot. It has the features that make commercial spreaders last and spread accurately — large pneumatic tires, an enclosed gearbox and a proper rate control linkage — in a lighter package with a 50 lb hopper. The tires are 13 x 4.00 pneumatic on rustproof poly rims, which roll far more smoothly over bumpy turf than hard plastic wheels and keep the spread pattern consistent. The rate control is mounted high on the handle, and the linkage from lever to gate is a solid direct connection rather than a flexible cable. That matters more than it sounds: cable-operated gates stretch and drift, which means the same setting gives a different rate after a couple of seasons. A direct linkage stays calibrated. The gearbox is fully enclosed and heavy duty, and the spreader includes a hopper screen to catch clumps and a nylon shut-off plate. The side-throw adjustment helps along edges, though it is not as simple as Scotts' EdgeGuard lever. At about 23 lb empty, it is easy to push and load into a truck. The trade-offs: settings are not on the bag of most retail fertilizers, so plan to calibrate it yourself, and the 50 lb hopper means refilling more often on large properties."
  },
  {
    "id": "agri-fab-45-0463-tow-spreader",
    "name": "Agri-Fab 45-0463 130 lb Tow Behind Broadcast Spreader",
    "category": "130 lb Tow-Behind, up to 12 ft Spread",
    "badge": "Best Tow-Behind",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 4000,
    "pros": [
      "130 lb hopper covers an estimated acre (about 25,000 sq ft) per fill",
      "Spreads up to 12 ft wide, roughly double a push spreader",
      "Flow control rod adjusts from the tractor seat",
      "Enclosed gear housing and 13 x 4 pneumatic tires",
      "Rustproof poly hopper and a 3-year limited warranty"
    ],
    "cons": [
      "Wide throw is harder to keep off beds and driveways, with no EdgeGuard-style shield",
      "Needs a lawn tractor or zero-turn with a hitch; overkill below half an acre"
    ],
    "bottomLine": "The obvious choice for an acre or more if you already own a lawn tractor.",
    "description": "Once your lawn is larger than about half an acre, walking behind a push spreader stops making sense, and the Agri-Fab 45-0463 is the most sensible tow-behind for residential use. The 130 lb hopper holds enough to cover an estimated acre, about 25,000 square feet, in one fill, and the spread pattern reaches up to 12 feet wide. That means a one-acre lawn takes a fraction of the passes and walking a push spreader would require. The flow control is a steel rod that runs forward to the tractor seat, so you can open, close and adjust the rate without stopping and climbing off, which is essential for shutting off at the ends of rows. The gear housing is fully enclosed and uses a commercial-grade gearbox, and the hopper is rustproof poly, which matters because this spreader will spend its life full of salty fertilizer and ice melt. It rides on two 13 x 4 pneumatic tires and connects with a universal hitch that fits most lawn tractors. Agri-Fab covers it with a three-year limited warranty. The big trade-off is edge control. A 12-foot throw is hard to keep off driveways, beds and ponds, and there is no EdgeGuard-type shield; plan to finish the perimeter with a push or handheld spreader. If you are shopping for a tractor to pull it, our riding mower guide covers hitch-equipped models."
  },
  {
    "id": "chapin-8003a-spreader",
    "name": "Chapin 8003A Residential Salt Spreader with Baffles",
    "category": "65 lb Walk-Behind, Ice Melt Specialist",
    "badge": "Best for Ice Melt",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 1200,
    "pros": [
      "Adjustable side and front baffles aim the spread onto sidewalks and driveways",
      "Spiked auger breaks up clumps of damp ice melt",
      "9-inch pneumatic wheels roll on snow and ice",
      "Powder-coated steel frame and enclosed gearbox",
      "10 to 12 ft spread width for wide driveways"
    ],
    "cons": [
      "Built and marketed for ice melt; a dedicated lawn spreader is the better tool for fertilizer",
      "Chapin does not recommend it for rock salt, sand or sand mixes"
    ],
    "bottomLine": "Buy it as a dedicated winter spreader so salt never goes near your lawn spreader.",
    "description": "Using the same spreader for fertilizer in spring and ice melt in winter is common, and it is also the quickest way to kill a spreader. Salt is highly corrosive, it clumps in damp air, and it demands a different spread pattern — a narrow, controllable strip on a sidewalk rather than a wide, even fan on a lawn. The Chapin 8003A is designed for that job. Its key feature is a set of adjustable baffles on the sides and front that let you aim the spread onto a sidewalk or driveway and away from the lawn and plantings beside it, which is exactly where salt does the most damage. The hopper holds about 65 lb, and a spiked auger breaks up the clumps that form when ice melt absorbs moisture in storage. The 9-inch pneumatic wheels grip on snow and ice better than hard plastic wheels, and the frame is powder-coated steel with an enclosed gearbox to keep salt away from the gears. Chapin lists a 10 to 12 foot spread width with the baffles open. Chapin does not recommend it for rock salt, sand or sand blends, so it is best matched to commercial ice melt products; see our guide to the best ice melt for concrete for the right ones. We would not buy it as a primary lawn spreader. Buy it as a second, winter-only spreader, and your lawn spreader will last years longer."
  },
  {
    "id": "scotts-edgeguard-mini-spreader",
    "name": "Scotts Turf Builder EdgeGuard Mini Broadcast Spreader",
    "category": "Compact Broadcast, up to 5,000 sq ft",
    "badge": "Best for Small Lawns",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 9000,
    "pros": [
      "Holds enough for up to 5,000 sq ft, one bag of most Scotts products",
      "EdgeGuard shield for driveways and beds",
      "Only about 11 lb, with a fold-down handle for easy storage",
      "Comes fully assembled with settings on every Scotts bag",
      "Budget price"
    ],
    "cons": [
      "Small hopper means refilling on anything larger than a small lawn",
      "Up to 5 ft spread is narrower than the larger Scotts models"
    ],
    "bottomLine": "The best spreader for small lawns, townhouses and anyone who wants something light and cheap to store.",
    "description": "Not every lawn needs a big spreader, and for a small yard the EdgeGuard Mini is the best value in the category. It holds enough product for up to 5,000 square feet, which matches the coverage of many standard bags of lawn fertilizer, so you can empty one bag into the hopper and finish the lawn without a refill. It weighs about 11 lb and the handle folds down, so it hangs on a hook or slides onto a shelf in a way that the larger spreaders do not. It arrives fully assembled, and like every Scotts spreader, the settings are printed on Scotts bags, which removes most of the guesswork for first-time users. The EdgeGuard shield is a genuine benefit on small lawns, where a much higher share of the lawn sits beside a driveway, walk or bed. The Scotts redesign also improved the hopper and agitator so product funnels more smoothly and coverage is more consistent than on earlier versions. The limits are obvious: the spread pattern is up to 5 feet, so you will make more passes than with the DLX or the Elite, and on a lawn larger than about 5,000 square feet you will be stopping to refill. It is not built for heavy ice melt use either, since its plastic components will not stand up to salt for long. For a small front yard or a townhouse strip, though, it is all the spreader you need."
  },
  {
    "id": "scotts-wizz-spreader",
    "name": "Scotts Wizz Hand-Held Spreader",
    "category": "Battery Handheld, up to 2,500 sq ft",
    "badge": "Best Handheld",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 5500,
    "pros": [
      "Battery-powered rotor (4 AA batteries) gives a consistent throw without hand cranking",
      "23 settings, with rates printed on Scotts bags",
      "Edge guard directs product away from non-lawn areas",
      "Up to 2,500 sq ft per fill and a 5 ft spread",
      "Works for patches, beds, steps and ice melt on small areas"
    ],
    "cons": [
      "Uses AA batteries, so keep spares or rechargeables on hand",
      "Too small to be anyone's main spreader on a real lawn"
    ],
    "bottomLine": "The best tool for patch repairs, small side yards and salting steps, and a smart companion to a push spreader.",
    "description": "The Wizz is the tool for jobs that are too small or too awkward for a walk-behind spreader. It is a handheld broadcast spreader with a battery-powered rotor, which solves the main problem with crank-operated hand spreaders: the throw varies with how fast you turn the crank, so the rate varies too. With a motor spinning the rotor at a constant speed, the spread is far more even. It runs on four AA batteries, which is convenient but means you should keep spares or rechargeables on hand. It holds enough for up to 2,500 square feet and throws a pattern about 5 feet wide, and it offers 23 settings, with rates printed on Scotts bags. An edge guard lets you direct product away from walkways, beds and patios. Where it earns its place: overseeding bare patches, feeding narrow side yards and strips between a house and fence where a push spreader cannot turn, spreading granular products around shrubs, and putting ice melt on steps and small walks in winter. It is also the easiest way to spot-treat a patch of weeds with a granular weed and feed. As a primary spreader for a lawn of any real size, it is the wrong tool; your arm will tire and the coverage will be patchy. Pair it with a push spreader and it covers everything the big one cannot reach."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Broadcast Spreaders",
          item: "https://www.thehonestreviewers.com/best-broadcast-spreader/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best broadcast spreader for homeowners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners with lawns up to about half an acre, the Scotts Elite is the best choice. Its dual rotors give a wider, more even pattern than single-rotor spreaders, EdgeGuard keeps product off edges, and settings are printed on every Scotts bag. For smaller lawns or a tighter budget, the EdgeGuard DLX or Mini do the same job with fewer features."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a Scotts spreader with other brands of fertilizer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Many non-Scotts fertilizer bags print a setting for common Scotts spreaders, and Scotts has an online lookup tool. If you cannot find a setting, calibrate by spreading a weighed amount over a measured 1,000 square foot area and adjusting until the rate matches the bag. The spreader itself works with any granular product."
          }
        },
        {
          "@type": "Question",
          "name": "Is a drop spreader or broadcast spreader better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most lawns, a broadcast spreader is better. It covers ground much faster and its tapered pattern blends overlapping passes, so it is less likely to leave stripes. A drop spreader is more precise and suits lawns next to water, vegetable gardens or delicate beds. A broadcast spreader with an edge shield gives most of that precision with far less effort."
          }
        },
        {
          "@type": "Question",
          "name": "How do I avoid stripes when spreading fertilizer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Set the spreader to half the recommended rate and cover the lawn twice, walking the second pass perpendicular to the first. Overlap each pass so the edge of the throw reaches the previous wheel track, walk at a steady pace, and close the gate during every turn. Spreading on a calm day also helps keep the pattern even."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a broadcast spreader for ice melt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is much more even and economical than a scoop. But ice melt is corrosive and clumps, so rinse and dry the spreader after every use and never store salt in the hopper. If you salt frequently, a dedicated spreader like the Chapin 8003A with baffles will protect both your lawn spreader and the grass beside your driveway."
          }
        },
        {
          "@type": "Question",
          "name": "What size spreader do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure your lawn first. Under 5,000 square feet, a compact spreader like the EdgeGuard Mini is enough. From 5,000 to 20,000 square feet, a full-size push spreader like the DLX or Elite. From about half an acre up, a 50 to 80 lb commercial walk-behind, or a tow-behind spreader if you own a lawn tractor."
          }
        },
        {
          "@type": "Question",
          "name": "Are pneumatic tires worth it on a spreader?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if your lawn is bumpy or you spread often. Air-filled tires absorb bumps, which keeps the hopper steady and the throw pattern consistent, and they roll more easily on soft ground. Foam-filled tires, like on the Scotts Elite, are a good compromise that never go flat. Hard plastic wheels are the least accurate on rough turf."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best broadcast spreader",
      "fertilizer spreader",
      "grass seed spreader",
      "lawn spreader",
      "tow behind spreader",
      "ice melt spreader"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            8 Spreaders Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Broadcast Spreaders</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Push, tow-behind and handheld spreaders compared on the things that decide whether your lawn greens evenly: spread pattern, edge control, rate settings and whether it survives salt.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#scotts-elite-spreader"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How to Choose
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
