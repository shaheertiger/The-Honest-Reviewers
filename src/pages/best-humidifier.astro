---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Warm Mist Humidifiers",
    "url": "/best-warm-mist-humidifier/"
  },
  {
    "title": "Best Small Humidifiers",
    "url": "/best-small-humidifier/"
  },
  {
    "title": "Best Humidifiers for Allergies",
    "url": "/best-humidifier-for-allergies/"
  },
  {
    "title": "Types of Humidifiers",
    "url": "/types-of-humidifiers/"
  },
  {
    "title": "Stainless Steel Humidifiers",
    "url": "/stainless-steel-humidifier/"
  },
  {
    "title": "How Much Does a Humidifier Cost?",
    "url": "/how-much-does-a-humidifier-cost/"
  },
  {
    "title": "Humidifier Air Purifier Combo",
    "url": "/humidifier-air-purifier-combo/"
  },
  {
    "title": "Best Humidifiers for Bedrooms",
    "url": "/best-humidifier-for-bedroom/"
  },
  {
    "title": "Best Humidifiers for Large Rooms",
    "url": "/best-humidifier-for-large-room/"
  },
  {
    "title": "Best Whole-House Humidifiers",
