import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Concrete Crack Repair Guide",
    "url": "/concrete-crack-repair/"
  },
  {
    "title": "Concrete Popping Out: Causes and Fixes",
    "url": "/concrete-popping-out/"
  },
  {
    "title": "Cracked Concrete Patio Options",
    "url": "/cracked-concrete-patio/"
  },
  {
    "title": "Self-Leveling Concrete Crack Filler",
    "url": "/self-leveling-concrete-crack-filler/"
  },
  {
    "title": "Best Concrete Resurfacers",
    "url": "/best-concrete-resurfacer/"
  },
  {
    "title": "How to Use Hydraulic Cement",
    "url": "/how-to-use-hydraulic-cement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-11", modified: "2026-11-11" });
const title = "Concrete Repair Products: Which One Fits Each Kind of Damage";
const description =
  "A damage-first guide to concrete repair products: what to use on hairline cracks, moving cracks, spalls, broken steps, scaled slabs, anchor holes and leaks.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Repair Products",
          item: "https://www.thehonestreviewers.com/concrete-repair-products/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best all-purpose concrete repair product?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no true all-purpose product. If you only buy one, a polymer-modified concrete patcher covers the most common surface damage, and a polyurethane sealant with backer rod covers most slab cracks. Those two handle the majority of household repairs. Structural cracks, active leaks and large areas each need their own specific product family."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use hydraulic cement on a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is rarely the right choice. Hydraulic cement is designed to set fast in wet conditions and stop leaks, not to resist traffic, deicers and freeze-thaw on an exposed slab. For driveway spalls use a polymer-modified patcher or resurfacer, and for driveway cracks use a polyurethane sealant. Save hydraulic cement for basement leaks and below-grade work."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use epoxy or polyurethane for concrete cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use epoxy when the crack has stopped moving and you need to rebond it for strength, typically indoors and on structural elements after the cause is fixed. Use polyurethane when the crack still moves or leaks, since it stays flexible and seals water. On outdoor slabs, polyurethane sealant is usually the safer and longer-lasting choice."
          }
        },
        {
          "@type": "Question",
          "name": "How deep can concrete patching products go?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the product. Resurfacers are typically rated for about 1/16 to 1/2 inch. Vinyl and polymer-modified patchers usually cover roughly 1/4 inch to an inch or two per layer. Fast-setting repair cements and concrete mixes go deeper, often in lifts. Always check the label minimum and maximum, because both too thin and too thick cause failures."
          }
        },
        {
          "@type": "Question",
          "name": "Do concrete repair products match the color of old concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rarely exactly. New cement-based patches usually start darker and lighten over weeks, while old concrete has weathered. Owners commonly report patches that remain visible for a year or more. Resurfacing a whole slab gives a uniform color, and concrete stains can blend patches if appearance matters, but plan on some visible difference."
          }
        },
        {
          "@type": "Question",
          "name": "How long before I can drive on a concrete repair?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It varies by product. Polyurethane sealants often allow foot traffic within a day and vehicles in a few days. Fast-setting repair cements may take vehicles within hours to a day. Resurfacers typically need around 24 hours for foot traffic and longer for vehicles. Follow the specific label, and allow more time in cool, damp weather."
          }
        },
        {
          "@type": "Question",
          "name": "When are concrete repair products not enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When the concrete is moving as a whole, broken into pieces, heaving, sinking more than an inch or so, or showing structural signs like horizontal wall cracks or bowing. Repair products treat surface damage and cracks in otherwise sound concrete. Slabs that have failed structurally need leveling, partial replacement or a contractor's assessment."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
