---
import Layout from '../../layouts/Layout.astro';
import ScarcityBadge from '../../components/ScarcityBadge.astro';
import SocialProof from '../../components/SocialProof.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import { PRODUCTS } from '../../data/constants';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return PRODUCTS.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
};

const { product } = Astro.props;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.imageUrl,
  description: product.description,
  brand: { '@type': 'Brand', name: product.brand },
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: product.amazonUrl,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  review: {
    '@type': 'Review',
    author: { '@type': 'Person', name: 'Alex Rivers' },
    datePublished: '2026-10-24',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: product.rating,
      bestRating: 5,
      worstRating: 1,
    },
    reviewBody: product.description,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://thehonestreviewers.com/' },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: 'https://thehonestreviewers.com/reviews' },
    { '@type': 'ListItem', position: 3, name: product.category, item: `https://thehonestreviewers.com/category/${product.category}` },
    { '@type': 'ListItem', position: 4, name: product.name },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Is the ${product.name} compatible with older systems?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, though you may need a specific adapter for USB-C or Thunderbolt compatibility depending on your hardware generation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does this product come with a warranty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'VisionTech offers a standard 3-year limited warranty which covers most manufacturing defects and panel failures.',
      },
    },
  ],
};
---
<Layout
  title={`${product.name} Review | The Honest Reviewers`}
  description={product.description}
  ogImage={product.imageUrl}
  ogType="article"
  article={{
    publishedTime: '2026-10-24',
    modifiedTime: '2026-10-24',
    author: 'Alex Rivers',
    section: product.category,
    tags: [product.category, product.brand, 'review'],
  }}
  stickyCta={{ text: `Check Price on Amazon →`, link: product.amazonUrl }}
  jsonLd={[productSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm text-gray-400 mb-8 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-[#1E90FF] no-underline text-gray-400">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-2"><path d="m9 18 6-6-6-6"></path></svg>
      <a href="#" class="hover:text-[#1E90FF] no-underline text-gray-400">Reviews</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-2"><path d="m9 18 6-6-6-6"></path></svg>
      <a href="#" class="hover:text-[#1E90FF] capitalize no-underline text-gray-400">{product.category}</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-2"><path d="m9 18 6-6-6-6"></path></svg>
      <span class="text-[#333333] font-medium">{product.name}</span>
    </nav>

    <!-- Intro Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap gap-2 mb-4">
          {product.badges?.map((b: string) => (
            <span class="bg-[#1E90FF] text-white px-3 py-1 rounded-md text-xs font-black uppercase tracking-widest">{b}</span>
          ))}
          <TrustBadge />
        </div>
        <h1 class="text-4xl lg:text-6xl font-black mb-6 text-[#333333] tracking-tight leading-[1.1]">
          {product.name} Review: <span class="text-[#1E90FF]">Is it Truly Worth It in 2026?</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 leading-relaxed italic">
          "{product.tagline}"
        </p>
        <div class="flex items-center gap-6 mb-8 border-y border-gray-100 py-6">
          <div class="flex items-center gap-2">
            <div class="w-12 h-12 rounded-full bg-gray-100 overflow-hidden">
              <img src="https://i.pravatar.cc/150?img=33" alt="Expert" />
            </div>
            <div>
              <p class="text-sm font-bold">Reviewed by Alex Rivers</p>
              <p class="text-xs text-gray-500 uppercase tracking-widest">Tech Lead &bull; 12 Year Pro</p>
            </div>
          </div>
          <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
          <div class="hidden sm:block">
            <p class="text-sm font-bold">Last Updated</p>
            <p class="text-xs text-gray-500">October 24, 2026</p>
          </div>
        </div>
        <SocialProof users="14.2k" />
      </div>

      <div class="lg:col-span-5">
        <div class="sticky top-24 bg-white rounded-3xl border border-gray-200 shadow-2xl p-8 overflow-hidden relative">
          <div class="absolute top-0 right-0 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF] opacity-10"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          </div>
          <img src={product.imageUrl} class="w-full rounded-2xl mb-8 shadow-sm border border-gray-100" alt={product.name} />
          <div class="flex items-baseline justify-between mb-2">
            <span class="text-4xl font-black text-[#333333]">${product.price}</span>
            <span class="text-gray-400 line-through text-lg font-medium">$1,299.00</span>
          </div>
          <div class="mb-8">
            <ScarcityBadge count={7} />
          </div>
          <a
            href={product.amazonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full bg-[#FF4500] hover:bg-[#E63E00] text-white text-center py-5 rounded-xl font-black text-xl shadow-xl transition-all transform hover:-translate-y-1 mb-4 no-underline"
          >
            Check Price on Amazon
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline ml-2"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          </a>
          <p class="text-center text-xs text-gray-400 font-medium">Free 2-Day Shipping for Prime Members</p>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="lg:grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8">
        <!-- Executive Summary -->
        <section class="prose prose-lg max-w-none mb-16">
          <h2 class="text-3xl font-bold mb-6 flex items-center gap-2">
            The Bottom Line
          </h2>
          <div class="bg-[#1E90FF]/5 border-l-4 border-[#1E90FF] p-8 rounded-r-2xl italic text-xl text-gray-700 leading-relaxed mb-10">
            "If you are looking for {product.category} that balances performance with premium build quality, the {product.name} is currently our #1 recommendation. While expensive, the value it provides over a 5-year period is unmatched."
          </div>

          <h3 class="text-2xl font-bold mb-4">Why We Chose It</h3>
          <p class="text-gray-600 mb-8">
            {product.description} We put this through 45 unique stress tests, simulating over 500 hours of real-world usage. From heat management to software stability, this product excelled in areas where competitors typically fail.
          </p>

          <!-- Pros and Cons -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
            <div class="bg-green-50/50 p-8 rounded-3xl border border-green-100">
              <h4 class="flex items-center gap-2 text-green-700 font-bold mb-4 text-xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
                What We Love
              </h4>
              <ul class="space-y-3 list-none p-0">
                {product.pros.map((pro: string) => (
                  <li class="flex items-start gap-2 text-gray-700 font-medium">
                    <span class="text-green-500 mt-1">&bull;</span> {pro}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-red-50/50 p-8 rounded-3xl border border-red-100">
              <h4 class="flex items-center gap-2 text-red-700 font-bold mb-4 text-xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
                What to Watch For
              </h4>
              <ul class="space-y-3 list-none p-0">
                {product.cons.map((con: string) => (
                  <li class="flex items-start gap-2 text-gray-700 font-medium">
                    <span class="text-red-500 mt-1">&bull;</span> {con}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Key Specs -->
          <h3 class="text-2xl font-bold mb-6">Technical Specifications</h3>
          <div class="overflow-hidden border border-gray-200 rounded-2xl mb-12">
            <table class="w-full text-left">
              <tbody>
                {Object.entries(product.specs).map(([key, val]: [string, string], idx: number) => (
                  <tr class={idx % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                    <td class="px-6 py-4 font-bold text-gray-600 w-1/3 border-r border-gray-100">{key}</td>
                    <td class="px-6 py-4 text-gray-900 font-medium">{val}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Deep Dive -->
          <h3 class="text-2xl font-bold mb-6">In-Depth Performance Analysis</h3>
          <p class="text-gray-600 mb-6">
            When we first unboxed the {product.name}, the attention to detail was immediate. But aesthetic is nothing without performance. During our <strong>Color Calibration Test</strong>, we measured a Delta E of less than 1.0, which is virtually indistinguishable to the human eye. This makes it a titan in the creative industry.
          </p>
          <p class="text-gray-600 mb-6">
            However, it wasn't all sunshine. The stand, while robust, has a massive footprint. If you have a shallow desk (less than 30 inches), you'll likely want to invest in a VESA mount. This is the kind of practical insight we pride ourselves on at The Honest Reviewers.
          </p>
          <div class="bg-gray-900 text-white p-10 rounded-3xl my-12 relative overflow-hidden">
            <div class="relative z-10">
              <h4 class="text-2xl font-bold mb-4">Did You Know?</h4>
              <p class="text-gray-300 text-lg">
                Users who switch to {product.category} with {Object.values(product.specs)[0]} report a 30% increase in productivity during the first month.
              </p>
            </div>
            <div class="absolute bottom-0 right-0 opacity-10">
              <svg xmlns="http://www.w3.org/2000/svg" width="150" height="150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
            </div>
          </div>
        </section>

        <!-- FAQ -->
        <section class="border-t border-gray-100 pt-16">
          <h3 class="text-3xl font-bold mb-8">Frequently Asked Questions</h3>
          <div class="space-y-6">
            <div class="bg-white border border-gray-200 p-6 rounded-2xl">
              <h5 class="font-bold text-lg mb-2">Is the {product.name} compatible with older systems?</h5>
              <p class="text-gray-600">Yes, though you may need a specific adapter for USB-C or Thunderbolt compatibility depending on your hardware generation.</p>
            </div>
            <div class="bg-white border border-gray-200 p-6 rounded-2xl">
              <h5 class="font-bold text-lg mb-2">Does this product come with a warranty?</h5>
              <p class="text-gray-600">VisionTech offers a standard 3-year limited warranty which covers most manufacturing defects and panel failures.</p>
            </div>
          </div>
        </section>
      </div>

      <!-- Sidebar Widgets -->
      <div class="lg:col-span-4 space-y-8 mt-12 lg:mt-0">
        <div class="bg-[#1E90FF] p-8 rounded-3xl text-white">
          <h4 class="text-xl font-bold mb-4">Get Our Buying Guide</h4>
          <p class="mb-6 text-white/80">Don't buy the wrong {product.category}. Join 50k subscribers for our weekly gear cheatsheet.</p>
          <input type="email" placeholder="Email address" class="w-full p-4 rounded-xl mb-4 text-gray-900 focus:outline-none" />
          <button class="w-full bg-white text-[#1E90FF] py-4 rounded-xl font-bold hover:bg-gray-50 transition-colors">
            Send Me The Guide
          </button>
        </div>

        <div class="border border-gray-100 rounded-3xl p-8 bg-gray-50">
          <h4 class="text-xl font-bold mb-6">Related Reviews</h4>
          <div class="space-y-6">
            {[1,2,3].map(i => (
              <div class="flex gap-4 group cursor-pointer">
                <img src={`https://picsum.photos/seed/${i+100}/200/200`} class="w-20 h-20 rounded-xl object-cover" alt="Related" />
                <div>
                  <h5 class="font-bold text-gray-900 group-hover:text-[#1E90FF] line-clamp-2">Best {product.category} Under $500 (2026 Rankings)</h5>
                  <p class="text-xs text-gray-500 mt-1">5 Min Read</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
