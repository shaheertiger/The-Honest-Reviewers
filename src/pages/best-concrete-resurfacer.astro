---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Driveway Sealer vs Resurfacer",
    "url": "/driveway-sealer-vs-resurfacer/"
  },
  {
    "title": "Driveway Resurfacing Cost",
    "url": "/driveway-resurfacing-cost/"
  },
  {
    "title": "Sealing Old Concrete",
    "url": "/sealing-old-concrete/"
  },
  {
    "title": "How to Prevent Concrete Spalling in Winter",
    "url": "/how-to-prevent-concrete-spalling-in-winter/"
  },
  {
    "title": "Best Concrete Driveway Sealers",
    "url": "/best-concrete-driveway-sealer-reviews/"
  },
  {
    "title": "Best Penetrating Concrete Sealer",
    "url": "/best-penetrating-concrete-sealer/"
  },
  {
    "title": "Concrete Driveway Cost",
    "url": "/concrete-driveway-cost/"
