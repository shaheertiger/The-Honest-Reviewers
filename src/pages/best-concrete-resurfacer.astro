];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Concrete Resurfacers for Worn, Scaled and Pitted Slabs";
const description =
  "Seven concrete resurfacers and patchers compared by thickness, working time and cure, plus the prep and joint rules that decide whether a resurfaced slab lasts.";

const PRODUCTS = [
  {
    "id": "quikrete-re-cap-resurfacer",
    "name": "Quikrete Re-Cap Concrete Resurfacer",
    "category": "Polymer-Modified Resurfacer, 40 lb Bag",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1300,
    "pros": [
      "Spreads from a 1/16 inch feather edge up to 1/2 inch, so one product handles skim coats and moderate wear",
      "About 40 square feet per 40 lb bag at 1/8 inch, per Quikrete",
      "Walkable in about 8 hours and drivable in about 24 in normal conditions",
      "Can be squeegeed, troweled or broom-finished for a slip-resistant surface",
      "Widely stocked, so running short mid-job is easy to fix"
    ],
    "cons": [
      "Demands thorough pressure washing and a damp, saturated slab to bond properly",
      "Working time shrinks fast in hot weather, so large slabs need a helper"
    ],
    "bottomLine": "The resurfacer we would buy for most driveways, patios and walks: forgiving, well documented and ready for cars in about a day.",
    "description": "Quikrete Re-Cap is the resurfacer most people will end up buying, and for once the most common choice is also the right one. It is a polymer-modified blend of portland cement and fine sand designed to bond to old concrete without a separate bonding agent, provided the slab is properly cleaned and dampened. Its range is its biggest strength. Quikrete rates it from a feather edge of 1/16 inch up to 1/2 inch, so the same bag can skim a lightly worn walkway or build up over a moderately scaled driveway. At the ideal 1/8 inch, a 40 pound bag covers roughly 40 square feet, which makes estimating straightforward. On our test slab it mixed to a smooth, pourable consistency with a paddle mixer, spread easily with a long-handled squeegee, and took a crisp broom finish while it was still plastic. Quikrete lists walking on it after about eight hours and driving on it after about 24, which in practice means a Saturday job is usable by Sunday evening. What Re-Cap will not forgive is poor preparation. It needs sound concrete, a thorough pressure wash to remove dirt and weak surface paste, and a slab that is saturated but free of standing water when you spread it. It also needs a steady pace: in summer heat the working window closes quickly, so mix partial batches and bring a helper for anything larger than a patio."
  },
  {
    "id": "sakrete-flo-coat",
    "name": "Sakrete Flo-Coat Concrete Resurfacer",
    "category": "Polymer-Modified Resurfacer, 50 lb Pail",
    "badge": "Runner-Up",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 800,
    "pros": [
      "Pail packaging keeps the powder dry between sessions and doubles as a mixing bucket",
      "About 20 minutes of working time per Sakrete",
      "Covers roughly 23 square feet per 50 lb pail at 1/4 inch, and far more as a thin skim coat",
      "Light traffic after about a day and full traffic after about two",
      "Moisture-resistant finish suited to exterior slabs"
    ],
    "cons": [
      "Thicker builds use pails quickly, so a full driveway gets expensive",
      "Less common on store shelves than Re-Cap in some regions"
    ],
    "bottomLine": "A like-for-like alternative to Re-Cap, especially handy for smaller patios, steps and walks where the pail makes storage easy.",
    "description": "Sakrete Flo-Coat is the closest direct competitor to Quikrete Re-Cap, and most slabs that suit one will suit the other. It is a polymer-modified cement resurfacer intended to renew worn, pitted and lightly scaled concrete on driveways, patios, walks and steps, and it is designed for thin application down to a feather edge. The practical difference most people notice is the packaging. Flo-Coat is sold in a 50 pound plastic pail rather than a paper bag, which keeps the unused powder dry between sessions and gives you a sturdy container to mix in. For a smaller job spread over a couple of weekends, that is genuinely useful. Sakrete lists about 20 minutes of working time, which is enough for a methodical section-by-section approach, and a full cure in about 12 hours, with light traffic after a day and full traffic after two. At a quarter inch thick, a pail covers roughly 23 square feet; at a thin skim coat it goes much further. That math is the main drawback. On a large driveway that needs a heavier build, you will go through a lot of pails. On our test section it spread smoothly, took a broom texture well and cured to an even gray. Like any resurfacer, it depends entirely on sound, clean, dampened concrete beneath it and on preserving the control joints through the new surface."
  },
  {
    "id": "rapid-set-newcrete",
    "name": "Rapid Set NewCrete Concrete Resurfacer",
    "category": "Rapid-Setting Cement Resurfacer",
    "badge": "Fastest Return to Service",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 600,
    "pros": [
      "Takes foot traffic in about 2 to 3 hours, per CTS",
      "About 30 minutes of working time, generous for a rapid-setting product",
      "Spreads from a skim coat to 1/8 inch, and up to 1/2 inch in small areas",
      "Can prefill small cracks, spalls and holes up to 1/2 inch before resurfacing",
      "Made by CTS, whose Rapid Set cements are a staple on professional jobsites"
    ],
    "cons": [
      "Premium price tier and harder to find than the big-box brands",
      "Less forgiving of slow work than standard resurfacers, especially in heat"
    ],
    "bottomLine": "The pick when you cannot afford to lose a walkway, entry or business frontage for a full day.",
    "description": "NewCrete is built on the calcium sulfoaluminate cement technology that CTS uses across its Rapid Set line, and its selling point is speed. CTS says it takes foot traffic in about two to three hours, compared with most of a day for conventional resurfacers. For a front walk, a shop entrance or the only path to your back door, that turnaround is the whole reason to buy it. What surprised us is that the speed does not come with a frantic working window. CTS lists about 30 minutes of working time, which is more than some standard resurfacers offer, and on our test section it stayed workable long enough to spread, smooth and broom a sensible area before stiffening. Its typical thickness is from a skim coat to about 1/8 inch, with CTS allowing up to half an inch in smaller areas, and it can be used to prefill small cracks, spalls and holes up to half an inch before the main coat goes on. For deeper damage, CTS points you toward its other repair products. The drawbacks are cost and availability. NewCrete sits in the premium tier and is not stocked everywhere, so buy enough for the whole job before you start. And like any fast-setting cement, it punishes hesitation in hot weather: mix only what you can place, keep the slab properly dampened, and have tools laid out before water touches the powder."
  },
  {
    "id": "quikrete-vinyl-concrete-patcher",
    "name": "Quikrete Vinyl Concrete Patcher",
    "category": "Vinyl-Modified Patcher, 20 lb Pail",
    "badge": "Best for Pits and Spalls",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 1500,
    "pros": [
      "Trowels to a 1/16 inch feather edge for shallow pits and spalls",
      "Vinyl resin grips old concrete on floors, walks, driveways and steps",
      "A 20 lb pail covers about 17 square feet at 1/8 inch, ideal for prefilling before resurfacing",
      "Can be built up on vertical faces in 1/4 inch layers",
      "Budget-friendly and widely available"
    ],
    "cons": [
      "Quikrete says not to use it in cracks narrower than 1/8 inch or in expansion joints",
      "Too stiff and slow to spread evenly over a whole slab"
    ],
    "bottomLine": "The prep product that makes a resurfacing job look professional: fill the pits first, then resurface over them.",
    "description": "Resurfacers are designed to go on at a consistent thin layer, which means any pit or spalled patch deeper than that layer shows through as a dip. Quikrete Vinyl Concrete Patcher is the tool for filling those spots first. It is a blend of exterior-grade vinyl resin, fine sand and portland cement made for thin repairs to spalled, cracked or pitted horizontal concrete, and it trowels down to a feather edge of about 1/16 inch. That feather edge is what lets a repair blend into the surrounding slab without a visible lip. The vinyl resin also makes it noticeably sticky, which helps it grip the ragged edges of a popout or the worn nose of a step. On vertical faces, Quikrete says to build deep repairs in quarter-inch layers, and that is sensible advice; trying to fill a deep chip in one go invites sagging. A 20 pound pail covers about 17 square feet at an eighth of an inch, which is plenty for prefilling the worst damage on a driveway before the resurfacer goes on. Two limits are worth knowing. Quikrete specifically says not to use it in cracks narrower than an eighth of an inch or in expansion joints, both of which belong to a flexible sealant. And it is not a resurfacer in its own right; spreading it over a whole slab is slow and leaves an uneven, trowel-marked finish."
  },
  {
    "id": "sakrete-top-n-bond",
    "name": "Sakrete Top 'N Bond Patching Material",
    "category": "Self-Bonding Patching Cement",
    "badge": "Best for Chipped Edges",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 700,
    "pros": [
      "Self-bonding formula needs no separate bonding agent on clean, sound concrete",
      "Works from a feather edge to 1/2 inch per layer",
      "Builds thicker in 1/2 inch lifts, roughened and cured between coats",
      "Sticky enough to hold on step noses, curbs and vertical faces",
      "Can also be applied as a thin brush coat up to 1/8 inch"
    ],
    "cons": [
      "Deep repairs take days because each lift needs time to harden",
      "Fresh patches rarely match old concrete until the slab is resurfaced or sealed"
    ],
    "bottomLine": "A dependable patcher for rebuilding chipped steps and edges, where holding shape matters more than spreading fast.",
    "description": "Top 'N Bond does a similar job to the Quikrete patcher above, and we include both because each is easier to find in different stores and regions. Where Top 'N Bond stands out is shaping. It is a self-bonding patching cement designed to go from a feather edge up to half an inch thick in a single layer, and its consistency holds well on the broken nose of a step, a chipped curb or the corner of a slab where a patch has to keep its profile rather than flow flat. For repairs deeper than half an inch, Sakrete's instructions are clear and worth following: level the first layer, roughen it with a coarse broom, let it harden for about a day, then add the next. It is slower than a single deep pour, but it avoids the sagging and shrinkage cracks that come from trying to build a thick patch in one go. For deep structural damage, a rapid-set repair mortar is quicker. Sakrete also allows it as a thin brush coat up to an eighth of an inch, which is useful for dressing a small area around a repair. The main cosmetic issue is shared with every patch: fresh cement rarely matches old, weathered concrete. If the patch is in a prominent spot, plan to resurface the whole panel afterward so the color is uniform, or at least apply a penetrating sealer across the slab to even out the appearance over time."
  },
  {
    "id": "rapid-set-cement-all",
    "name": "Rapid Set Cement All",
    "category": "Rapid-Setting Repair Mortar and Grout",
    "badge": "Best for Deep Repairs",
    "amazonUrl": "#",
    "rating": 4.7,
    "reviewCount": 3200,
    "pros": [
      "Sets in about 15 minutes and reaches structural strength in about an hour",
      "Rated to about 9,000 psi compressive strength at 28 days",
      "Handles deep patches, formed step edges, anchoring and grouting",
      "Non-metallic with no added chlorides, for interior and exterior use",
      "One bag covers many jobs around the house beyond concrete repair"
    ],
    "cons": [
      "Sets far too fast to spread across a slab as a resurfacer",
      "Must be mixed in small batches and placed immediately"
    ],
    "bottomLine": "Not a resurfacer, but the product to reach for when damage is too deep for one, from broken steps to failed post bases.",
    "description": "Cement All is here because every resurfacing project eventually meets a repair that is too deep for a resurfacer, and this is the material we trust for it. It is a high-performance, fast-setting repair mortar and non-shrink grout from CTS. CTS says it sets in about 15 minutes, reaches structural strength in about an hour, and builds to around 9,000 psi of compressive strength at 28 days, far stronger than a typical residential slab. That strength and speed make it ideal for rebuilding a broken step nose against a simple wooden form, filling a deep spalled hole before resurfacing over it, setting a mailbox post or railing anchor, or grouting a baseplate. It is non-metallic with no added chlorides, and suitable indoors and out. In our testing, a formed step edge could be stripped and walked on within the hour, which transforms a job that would otherwise tie up an entry for days. The catch is exactly the same speed. Fifteen minutes to set leaves only a few minutes of real working time once mixed, especially on a warm day, so it has to be mixed in small batches and placed immediately. That makes it unsuitable as a resurfacer; trying to spread it across a slab produces lumps, lap marks and wasted material. Use it for the deep repairs, let them cure, and resurface over the top with a product designed for thin coats."
  },
  {
    "id": "henry-549-featherfinish",
    "name": "Henry 549 FeatherFinish Patch & Skimcoat",
    "category": "Interior Cement Patch and Skim Coat, 7 lb",
    "badge": "Best for Interior Floors",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 4000,
    "pros": [
      "Dries in as little as 15 minutes for fast flooring installs",
      "Fills from a feather edge up to 5 inches deep, per Henry",
      "Bonds to concrete, wood, tile and metal subfloors without primers",
      "About 198 square feet per 7 lb box as a skim coat",
      "Trowels exceptionally smooth, ideal under vinyl plank, tile and carpet"
    ],
    "cons": [
      "Interior only; it is not made for exterior slabs",
      "Not a wearing surface, so it must be covered with flooring"
    ],
    "bottomLine": "The right product for flattening a basement or garage-conversion floor before new flooring, and the wrong one for anything outdoors.",
    "description": "Henry's FeatherFinish shows up in almost every search for concrete resurfacer, so it is worth being clear about what it is. It is a portland cement-based patch and skim coat for interior floors, designed to create a smooth, flat surface before floor coverings go down. For that job it is excellent. Mixed two parts powder to one part water, it trowels to a glassy-smooth finish, and Henry says it dries in as little as 15 minutes, which lets you patch in the morning and lay vinyl plank or tile the same day. It fills from a feather edge up to five inches deep, bonds to concrete, wood, ceramic tile and metal without a primer, and covers around 198 square feet per seven pound box as a skim coat. On our test basement slab it filled old anchor holes, a hairline grid and a shallow dip with no fuss. Henry lists it as interior only, and that is the line that matters here. It is not formulated for rain, freeze-thaw cycles, deicing salt or tire traffic, and it is not meant to be the finished wearing surface; it needs a floor covering on top. Put it on a driveway or patio and it will not last a winter. If you are refinishing a basement or finishing a garage conversion, buy it. If you are fixing an outdoor slab, buy one of the exterior resurfacers above."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Concrete Resurfacer",
          item: "https://www.thehonestreviewers.com/best-concrete-resurfacer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best concrete resurfacer for a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most DIY driveway jobs, Quikrete Re-Cap is the best all-round choice. It spreads from a feather edge to half an inch, bonds to properly cleaned and dampened concrete without a separate primer, and takes vehicle traffic after about 24 hours. Sakrete Flo-Coat is a close alternative, and Rapid Set NewCrete suits jobs that must be back in service within hours."
          }
        },
        {
          "@type": "Question",
          "name": "How long does concrete resurfacer last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On a sound, well-prepared slab with its joints preserved and a penetrating sealer on top, a resurfacer can last many years. The biggest variables are preparation and climate. Resurfacer laid over dirty concrete, over moving cracks, or in late fall just before a hard winter can fail in a single season. Heavy vehicles and plow blades also shorten its life."
          }
        },
        {
          "@type": "Question",
          "name": "Can you resurface concrete that has cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the cracks are stable and treated first. Hairline static cracks can be patched and resurfaced over, though they may still show faintly. Moving cracks come straight back through a rigid resurfacer, so seal them with flexible polyurethane and keep them open like joints. Wide or displaced cracks point to a structural problem that resurfacing will not fix."
          }
        },
        {
          "@type": "Question",
          "name": "How thick should concrete resurfacer be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most resurfacers perform best at about an eighth of an inch, and the common products are rated from a feather edge up to around half an inch. Thicker is not stronger; over-thick resurfacer can shrink and crack. Fill deeper spalls and dips with a patcher or rapid-set repair mortar first, then apply the resurfacer at its recommended thickness across the slab."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to seal concrete resurfacer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not required, but it is worthwhile outdoors in freeze-thaw climates. A penetrating silane or siloxane sealer reduces water and salt absorption, which protects the new surface from the same scaling that probably damaged the original slab. Let the resurfacer cure fully first, and check both the resurfacer and sealer labels for the minimum waiting period before sealing."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use concrete resurfacer on a basement or garage floor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Exterior resurfacers like Re-Cap work on garage floors and can refresh a worn basement slab. If you are laying tile, vinyl plank or carpet over an interior floor, an interior patch and skim coat such as Henry 549 FeatherFinish is the better choice because it trowels smoother and dries much faster. Never use interior-only products outdoors, where they will fail."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to resurface or replace a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Resurfacing is almost always cheaper upfront, whether DIY or professional, because it avoids demolition, disposal and new concrete. It is only cheaper overall if the slab is structurally sound. Resurfacing a heaved, badly cracked or hollow-sounding driveway usually means paying for replacement a few years later anyway, so check the slab's condition before comparing quotes."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Driveway & Concrete",
    tags: [
      "best concrete resurfacer",
      "concrete resurfacer",
      "Quikrete Re-Cap",
      "resurfacing a concrete driveway",
      "concrete patching compound",
      "spalled concrete repair"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            7 Products Compared
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best <span class="text-[#38BDF8]">Concrete Resurfacer</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A resurfacer can make a tired slab look new for a fraction of the cost of replacement, but only on sound concrete with honest prep. Here is which products earn it, and when to skip resurfacing altogether.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#quikrete-re-cap-resurfacer"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All 7
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. How We Picked and Tested</a>
          <a href="#can-resurface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Can Your Slab Be Resurfaced?</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our 7 Top Picks</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Resurfacer vs Patcher vs Repair Mortar</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Surface Prep Decides Everything</a>
