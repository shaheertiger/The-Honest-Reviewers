---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
    { title: "How to Clean a Deck", url: "/how-to-clean-a-deck/" },
    { title: "How to Prep a Deck for Staining", url: "/how-to-prep-a-deck-for-staining/" },
    { title: "Best Deck Cleaners", url: "/best-deck-cleaner/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "Deck Brightener vs Deck Cleaner: Do You Need Both?";
const description =
  "A cleaner strips grey and mildew and leaves the wood alkaline. A brightener reverses that and opens the grain. Why skipping the second step causes blotchy stain.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.thehonestreviewers.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.thehonestreviewers.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Deck Brightener vs Deck Cleaner", item: "https://www.thehonestreviewers.com/deck-brightener-vs-deck-cleaner/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between a deck cleaner and a deck brightener?",
          acceptedAnswer: { "@type": "Answer", text: "A cleaner is alkaline and removes what is sitting on the wood — grey oxidised fibres, dirt, algae and mildew. A brightener is acidic, usually oxalic acid, and does not clean at all. It neutralises the alkalinity the cleaner leaves behind, lifts iron and tannin darkening, and reopens the grain so the wood accepts stain evenly. They do opposite chemistry and both steps have a job." },
        },
        {
          "@type": "Question",
          name: "Do you need both a cleaner and a brightener before staining?",
          acceptedAnswer: { "@type": "Answer", text: "Before staining, yes, in almost every case. The cleaner does the removal and leaves the wood surface alkaline, darker and less absorbent. Without the brightener the stain goes on unevenly, often looking blotchy between the sun-bleached and sheltered areas. If you are washing a deck for appearance only and not staining it, the brightener is optional." },
        },
        {
          "@type": "Question",
          name: "Can you use a brightener without a cleaner?",
          acceptedAnswer: { "@type": "Answer", text: "You can, and it is the right call in one narrow case — a deck that is clean and sound but shows rust runs, tannin bleed or leaf staining. Oxalic acid removes those marks specifically. What it will not do is remove grey, mildew or dirt, because it is not a cleaner. If the deck is genuinely dirty, skipping the cleaner just spreads the dirt around." },
        },
        {
          "@type": "Question",
          name: "What happens if you skip the brightener?",
          acceptedAnswer: { "@type": "Answer", text: "The wood stays alkaline and stays partly closed, so it accepts less stain and accepts it inconsistently. Cedar and redwood look muddy and darker than they should. Iron marks around fasteners stay dark. And the finish often looks patchy within the first season because absorption varied across the deck. It is the most commonly skipped step and the most common cause of a disappointing stain job on a deck that was properly cleaned." },
        },
        {
          "@type": "Question",
          name: "Is deck brightener the same as wood bleach?",
          acceptedAnswer: { "@type": "Answer", text: "No, though the terms get mixed up constantly. Brightener is oxalic or citric acid, and it restores colour by reversing pH and dissolving iron and tannin compounds. Wood bleach usually means chlorine or a two-part hydroxide-peroxide product, which chemically lightens the wood itself. Brightener does not bleach anything — it reveals the colour that the cleaning step masked." },
        },
        {
          "@type": "Question",
          name: "How long do you leave brightener on a deck?",
          acceptedAnswer: { "@type": "Answer", text: "Ten to fifteen minutes on a damp deck, per most labels, and never let it dry on the surface. Apply it while the wood is still wet from rinsing the cleaner, keep it damp by misting if the sun is on it, then rinse thoroughly. The colour change is visible within a few minutes, which makes it one of the more satisfying steps in the whole job." },
        },
        {
          "@type": "Question",
          name: "Can you use vinegar as a deck brightener?",
          acceptedAnswer: { "@type": "Answer", text: "Not effectively. Vinegar is acetic acid and it is too weak to neutralise a percarbonate cleaner across a whole deck or to dissolve iron staining. Oxalic acid is what the commercial products use because it does both, and it costs $20 to $30 a gallon — less than the stain you would waste on a badly prepared surface." },
        },
        {
          "@type": "Question",
          name: "Do you need a brightener on a new deck?",
          acceptedAnswer: { "@type": "Answer", text: "If you have cleaned it, yes. New pressure-treated lumber also benefits from a brightener on its own, because mill glaze and the surface crushing from planing both reduce absorption, and the acid opens the grain. On new cedar it also removes the darkening from the metal banding and fasteners used in transit." },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Stone & Wood Sealers",
    tags: ["deck brightener vs deck cleaner", "deck brightener", "oxalic acid", "deck prep"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Deck Cleaners", link: "/best-deck-cleaner/" }}
>
  <article class="relative overflow-hidden">
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6"><TrustBadge /></div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">Comparison</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">Field Tested</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">Deck Brightener vs <span class="text-[#38BDF8]">Deck Cleaner</span></h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          They are not two versions of the same product. One removes, the other reverses what the removal did — and the second is the step almost everybody skips.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#what-each-does" class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline">See the Difference</a>
          <a href="#faq" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline">Jump to the FAQ</a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto"><SocialProof users="7.1k" /></div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-each-does" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What Each One Does</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Chemistry, Briefly</a>
          <a href="#do-you-need-both" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Do You Need Both?</a>
          <a href="#skipping" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Skipping It Costs</a>
          <a href="#sequence" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The Correct Sequence</a>
          <a href="#by-wood" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. It Matters More on Some Woods</a>
          <a href="#buying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. What to Buy</a>
          <a href="#common-mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Common Mistakes to Avoid</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people buy a deck cleaner, use it, look at a clean deck, and reasonably conclude the preparation is finished. The deck is clean. It is also alkaline, slightly closed and, on cedar, oddly dark — and none of those things fix themselves.
        </p>

        <div id="what-each-does" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. What Each One Actually Does</h2>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm"></th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Deck Cleaner</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Deck Brightener</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chemistry</td>
                    <td class="px-4 py-4 text-gray-700">Alkaline — percarbonate or hydroxide</td>
                    <td class="px-4 py-4 text-gray-700">Acidic — oxalic or citric acid</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Removes</td>
                    <td class="px-4 py-4 text-gray-700">Grey fibres, dirt, algae, mildew</td>
                    <td class="px-4 py-4 text-gray-700">Iron and tannin marks only</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Effect on pH</td>
                    <td class="px-4 py-4 text-gray-700">Leaves the wood alkaline</td>
                    <td class="px-4 py-4 text-gray-700">Returns it to neutral</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Effect on colour</td>
                    <td class="px-4 py-4 text-gray-700">Often darkens cedar and redwood</td>
                    <td class="px-4 py-4 text-gray-700">Restores the natural tone</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Effect on absorption</td>
                    <td class="px-4 py-4 text-gray-700">Reduces it slightly</td>
                    <td class="px-4 py-4 text-gray-700">Opens the grain</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Dwell time</td>
                    <td class="px-4 py-4 text-gray-700">10-15 minutes, scrubbed</td>
                    <td class="px-4 py-4 text-gray-700">10-15 minutes, no scrubbing</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Read down the middle column and you have a complete account of why the second product exists. Everything the cleaner does well, it does at the cost of leaving the wood in a chemical state that stain does not like. The brightener is not an upsell; it is the other half of one process.
          </p>
        </div>

        <div id="chemistry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. The Chemistry, Briefly</h2>

          <p>
            Deck cleaners are alkaline because alkalinity is what breaks down the organic material you are trying to remove. Sodium percarbonate dissolves into hydrogen peroxide and soda ash, which lifts the degraded surface fibres that read as grey, kills mildew, and loosens dirt. Sodium hydroxide products go further and are correspondingly harsher.
          </p>

          <p>
            Wood, however, is not neutral about pH. Alkaline solutions darken the tannins in cedar, redwood and other extractive-rich species — which is why a cedar deck often comes out of the cleaning stage looking browner and muddier than it went in, and why people assume the cleaner has not worked. It has; the colour is a chemical reaction, not dirt.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">What the Acid Does</p>
            <p class="text-xl font-bold text-white mb-3">Oxalic acid neutralises the alkalinity, chelates iron into a soluble compound that rinses away, and reverses the tannin darkening.</p>
            <p class="text-gray-300 leading-relaxed m-0">All three happen in the same ten minutes. The visible result is the deck lightening several shades in front of you, which is why the step is called brightening rather than neutralising — but neutralising is the part that matters for the stain.</p>
          </div>

          <p>
            The iron chemistry is worth understanding separately, because it explains a mark most people misdiagnose. Black or blue-black staining around nails, screws and joist hangers is not mildew and not rot. It is iron tannate, formed when metal reacts with the wood's tannins in the presence of moisture, and no cleaner touches it. Oxalic acid dissolves it in minutes.
          </p>
        </div>

        <div id="do-you-need-both" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Do You Need Both?</h2>

          <p>
            It depends entirely on what happens next.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Your Situation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cleaner</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Brightener</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cleaning and staining this weekend</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes — do not skip</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Annual wash, finish still sound</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Optional</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clean deck with rust or tannin marks</td>
                    <td class="px-4 py-4 text-gray-700">Not needed</td>
                    <td class="px-4 py-4 text-gray-700">Yes — this is its job</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">After stripping an old finish</td>
                    <td class="px-4 py-4 text-gray-700">Usually not</td>
                    <td class="px-4 py-4 text-gray-700">Yes — strippers are strongly alkaline</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">New pressure-treated lumber</td>
                    <td class="px-4 py-4 text-gray-700">Light clean</td>
                    <td class="px-4 py-4 text-gray-700">Yes — opens mill-glazed grain</td>
                  </tr>
                  <tr class="bg-gray-50">
                    <td class="px-4 py-4 font-black text-gray-900">Composite decking</td>
                    <td class="px-4 py-4 text-gray-700">Composite-safe only</td>
                    <td class="px-4 py-4 text-gray-700">No — nothing to open</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The row people miss is the fourth. Deck strippers are aggressive alkaline products, considerably more so than cleaners, and stripping without neutralising afterwards leaves a surface that will fight the new finish. If you have stripped a deck, the brightener is not optional under any circumstances — the process is covered in <a href="/how-to-strip-deck-stain/">how to strip deck stain</a>.
          </p>
        </div>

        <div id="skipping" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. What Skipping It Actually Costs</h2>

          <p>
            Four things go wrong, in rough order of how much they will annoy you.
          </p>

          <ul class="space-y-2 my-6">
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Uneven absorption, and therefore uneven colour.</strong> The alkaline surface takes less stain, and it does so inconsistently between areas that were bleached by sun and areas that were sheltered. This is the single most common cause of a blotchy result on a deck that was cleaned properly.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Muddy colour on cedar and redwood.</strong> The stain goes over a surface that is already darkened by the cleaner, so the finished tone is browner and flatter than the sample suggested.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Black marks around every fastener remain.</strong> Iron staining survives cleaning untouched, and semi-transparent stain does not hide it. On a deck with a few hundred screws, that is a visible pattern.</span>
            </li>
            <li class="flex items-start gap-2 text-gray-700">
              <svg class="w-5 h-5 text-[#1E90FF] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
              <span><strong>Less stain absorbed means a shorter interval.</strong> A penetrating finish protects in proportion to how much of it got into the wood. A surface that took eighty percent of a normal load will need recoating sooner.</span>
            </li>
          </ul>

          <p>
            Set that against the cost of the step: $20 to $30 for a gallon of brightener, and about fifteen minutes on a deck you are already standing on with a hose in your hand. It is the cheapest insurance in the whole job.
          </p>
        </div>

        <div id="sequence" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. The Correct Sequence</h2>

          <p>
            Order matters, and so does not letting the deck dry in between.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Clean First, Rinse Hard</h3>
          <p>
            Apply the cleaner to a pre-wetted deck, let it dwell ten to fifteen minutes without drying out, scrub with the grain, and rinse thoroughly — including the framing below and any siding it splashed. The full method is in <a href="/how-to-clean-a-deck/">how to clean a deck</a>.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Brighten While the Deck Is Still Wet</h3>
          <p>
            Do not wait for it to dry. Apply the brightener to the damp surface with a pump sprayer, working in sections, and leave it for the labelled time. There is no scrubbing involved — the acid does the work chemically and agitation adds nothing. Mist the surface if the sun starts drying it.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Rinse Again, Thoroughly</h3>
          <p>
            Residual acid left in the grain will interfere with the stain just as residual cleaner would. Rinse until the runoff is clear, and rinse the plants and the siding while you are at it.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Then Wait, and Test With Water</h3>
          <p>
            Twenty-four to forty-eight hours in warm, dry, breezy weather, and up to four days in humidity or heavy shade. Judge readiness with a water-drop test rather than by eye: if water soaks in and darkens the wood, the deck is ready for stain. If it beads or sits, there is still moisture in the surface.
          </p>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
            <p class="text-sm font-black text-amber-800 mb-2">Never Mix Them</p>
            <p class="text-sm text-amber-700">
              An acid and an alkali combined neutralise each other and both stop working. Products sold as a single-step "clean and brighten" do exist and are a compromise rather than a shortcut — they contain a milder cleaner to keep the acid viable. On a genuinely grey deck, two products in sequence outperform them clearly.
            </p>
          </div>
        </div>

        <div id="by-wood" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. It Matters More on Some Woods Than Others</h2>

          <p>
            <strong>Cedar and redwood</strong> are the strongest case. Both are full of tannins and extractives, both darken markedly under an alkaline cleaner, and both recover dramatically under acid. If you have ever seen a before-and-after of a brightener working, it was almost certainly cedar.
          </p>

          <p>
            <strong>Pressure-treated pine</strong> shows less colour change, so the visual argument is weaker — but the absorption argument is stronger. Treated lumber is often mill-glazed, meaning the planing process crushed and burnished the surface fibres closed, and the acid helps open them. New treated decks benefit even without a preceding clean, which is discussed in <a href="/how-long-to-wait-to-stain-a-new-deck/">how long to wait to stain a new deck</a>.
          </p>

          <p>
            <strong>Ipe and other dense tropical hardwoods</strong> absorb very little at the best of times, which makes maximising what they do absorb worthwhile. Brightening also lifts the grey from these species more effectively than cleaning alone, since much of what looks weathered on ipe is surface oxidation rather than dirt.
          </p>

          <p>
            <strong>Composite decking</strong> is the exception where it does nothing useful, because there is no grain to open and no tannin to reverse. Clean it with a composite-safe product and stop there — and if the goal was to change its colour, read <a href="/can-you-stain-composite-decking/">whether composite can be stained</a> first.
          </p>
        </div>

        <div id="buying" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. What to Buy</h2>

          <p>
            Brighteners are simple products and the differences between them are small. Read the label for the active ingredient: oxalic acid is the standard and the most effective on iron staining; citric acid formulations are gentler, slightly less effective, and easier on planting.
          </p>

          <p>
            One gallon of concentrate typically covers 500 to 1,000 square feet depending on dilution, so a single container handles most decks with the railings included. Apply it with a pump sprayer rather than a roller — you want an even wet film rather than a worked-in coat, and a sprayer uses noticeably less product.
          </p>

          <p>
            Wear gloves and eye protection. Oxalic acid is not dangerous to handle sensibly but it is a genuine irritant, and it will etch some stone and concrete, so wet down and rinse any masonry the runoff crosses. Our <a href="/best-deck-cleaner/">deck cleaner testing</a> covers the cleaning half of the pairing, including which products bundle a brightener in the same range.
          </p>
        </div>

        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">A Test That Settles It in Five Minutes</h2>
        <p>
          If you are genuinely unsure whether your deck needs the second step, there is a way to find out that costs nothing but a corner of the deck. Clean a small area normally, rinse it, and let half of it dry. Brighten the other half while it is still wet, rinse, and let that dry too. Then look at the two halves side by side in daylight.
        </p>
        <p>
          On cedar or redwood the difference is usually obvious enough to end the argument — the brightened half comes back several shades warmer and lighter, while the cleaned-only half stays flat and slightly grey-brown. On pressure-treated pine the colour difference can be subtle, so judge that one by absorption instead: put a few drops of water on each half and watch which one drinks it faster. The brightened side almost always wins, and that difference is exactly the difference in how much stain the wood will take.
        </p>
        <p>
          It is also worth doing this test on the section of deck that gets the most sun, because that is where the two halves diverge most and where an uneven finish would show first. A shaded corner under the table is the least informative place to run it.
        </p>
        <p>
          One caveat on interpreting the result: a brightened surface looks lighter, which occasionally worries people into thinking the acid has bleached the wood. It has not. What you are seeing is the natural colour of the timber with the alkaline darkening removed, and it is the colour the stain was formulated to sit on. The sample chips at the store were made over neutral wood, not over a freshly cleaned alkaline surface, which is part of why finished decks so often look darker than the chip.
        </p>

        <div id="common-mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">8. Common Mistakes to Avoid</h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Treating the Brightener as Optional</h3>
              <p class="text-gray-700 text-sm m-0">It is half of a two-part process, not an upgrade. The cleaner leaves the wood alkaline, darker and less absorbent, and only an acid reverses that. Fifteen minutes and $25 against a blotchy finish you live with for three years is not a close call.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Letting the Deck Dry In Between</h3>
              <p class="text-gray-700 text-sm m-0">Brightener works best applied to a deck still wet from rinsing the cleaner. On a dry surface it absorbs unevenly and can leave its own light patches, which is an ironic way to fail at the step meant to prevent patchiness.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Scrubbing the Brightener In</h3>
              <p class="text-gray-700 text-sm m-0">It is a chemical step, not a mechanical one. Agitation adds nothing and risks raising grain on a surface you have just softened with water. Spray it, leave it, rinse it.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Skipping It After Stripping</h3>
              <p class="text-gray-700 text-sm m-0">Strippers are far more alkaline than cleaners, so neutralising afterwards matters more, not less. A stripped deck that goes straight to stain is the most reliable way to produce a finish that fails early and unevenly.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Staining Before the Wood Is Dry</h3>
              <p class="text-gray-700 text-sm m-0">A brightened deck still holds water in the top few millimetres for a day or more. Stain applied over it sits on the surface, stays tacky and never bonds. Give it 24 to 48 hours and confirm with a water-drop test rather than by eye.</p>
            </div>
          </div>
        </div>

        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">9. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is the difference between a deck cleaner and a brightener?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">A cleaner is alkaline and removes what sits on the wood — grey fibres, dirt, algae, mildew. A brightener is acidic and does not clean at all; it neutralises the alkalinity, lifts iron and tannin marks, and reopens the grain so stain absorbs evenly.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do you need both before staining?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Almost always, yes. The cleaner leaves the surface alkaline, darker and less absorbent, and without the brightener the stain goes on unevenly. If you are washing purely for appearance and not staining, the brightener is optional.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you use a brightener without a cleaner?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Yes, in one case — a clean, sound deck showing rust runs, tannin bleed or leaf marks. Oxalic acid removes those specifically. It will not remove grey, mildew or dirt, so on a genuinely dirty deck it just moves the dirt around.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What happens if you skip the brightener?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">The wood stays alkaline and partly closed, so it takes less stain and takes it inconsistently. Cedar looks muddy, iron marks stay dark, and the finish often looks patchy within a season. It is the most skipped step and the most common cause of a disappointing result.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is brightener the same as wood bleach?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">No. Brightener is oxalic or citric acid and restores colour by reversing pH and dissolving iron compounds. Wood bleach is chlorine or a two-part peroxide product that lightens the wood itself. Brightener reveals colour rather than removing it.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long do you leave brightener on?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Ten to fifteen minutes on a damp deck, and never let it dry. Apply while the wood is still wet from rinsing the cleaner, mist it if the sun is on it, then rinse thoroughly. The colour change is visible within minutes.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can you use vinegar instead?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">Not effectively. Acetic acid is too weak to neutralise a percarbonate cleaner across a whole deck or to dissolve iron staining. Oxalic acid does both, and a gallon costs $20 to $30 — less than the stain wasted on a badly prepared surface.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do you need a brightener on a new deck?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">If you cleaned it, yes. New pressure-treated lumber also benefits on its own, since mill glaze from planing reduces absorption and the acid opens the grain. On new cedar it also removes darkening from transit banding and fasteners.</p>
            </div>
          </div>
        </div>

