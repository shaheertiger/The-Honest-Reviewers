          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">May 27, 2026</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.4k" />
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4">In This Guide</h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#sprayer-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Sprayer Types: Airless vs HVLP vs Cup</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Our 7 Top Picks Reviewed</a>
