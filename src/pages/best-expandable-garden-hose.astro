---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";

const title = "7 Best Expandable Garden Hoses in 2026: Tested to Failure";
const description =
  "We ran 12 expandable hoses through a full season and kept using them until they burst. Here are the 7 that lasted, plus the care routine that triples their lifespan.";

const PRODUCTS = [
