const dates = pageDates(Astro.url.pathname, { published: "2026-09-29", modified: "2026-09-29" });
const title = "7 Best Mulching Mowers That Make Clippings Disappear";
const description =
  "Seven gas and battery mowers that mulch clippings fine, plus the deck designs, blades and mowing habits that make mulching work, from wet grass to autumn leaves.";

const PRODUCTS = [
  {
    "id": "toro-recycler-max-22-21485",
    "name": "Toro 22\" Recycler Max Personal Pace SmartStow (21485)",
    "category": "Gas, 163cc Briggs & Stratton, 13-Gauge Steel Deck",
    "badge": "Best Overall Mulcher",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 1800,
    "pros": [
      "Recycler Max deck with Vortex airflow is built around mulching first, not bagging with a plug added as an afterthought",
      "Heavy 13-gauge steel deck, the thickest here, with a 5-year limited warranty",
      "Personal Pace rear-wheel drive matches your walking speed, which helps you slow down in heavy grass",
      "SmartStow lets it stand upright for storage, saving up to 70 percent of the floor space",
      "Cutting height from 1 to 4 inches, so you can keep grass tall enough for clean mulching"
    ],
    "cons": [
      "Rear wheels are 9.65 inches, a little smaller than the best hill-climbing mowers",
      "Only a 1.8-bushel bag for the times you do need to collect"
    ],
    "bottomLine": "The best all-round mulching mower for most lawns: a deck designed for mulching, a heavy steel shell and a drive that is easy to live with.",
    "description": "Toro's Recycler line has been built around mulching for decades, and the Recycler Max is the strongest version of it at a mainstream price. The distinction matters. Many mowers are side-discharge or bagging mowers that mulch when you fit a plug, and their decks are shaped to throw clippings out. The Recycler deck is shaped to keep them in: the dome and the Vortex airflow hold clippings under the deck so the blade cuts them several times before they drop, and the result is fine pieces that disappear into the lawn rather than lying on top of it. The Max version uses a 13-gauge steel deck, heavier than the 14- and 15-gauge decks on other Toros, and Toro backs the mower with a 5-year limited warranty. The engine is a 163cc Briggs & Stratton with 7.25 ft-lb of torque, which is enough for regular mulching of a lawn up to an acre, and Personal Pace rear-wheel drive adjusts to your walking speed. That turns out to matter for mulching, because slowing down in thick patches is the simplest way to get a clean result. SmartStow storage lets the mower stand on end in a garage. The weaknesses are small: the 1.8-bushel bag fills quickly on the occasions you collect, and the rear wheels are a touch smaller than the best mowers for rough ground."
  },
  {
    "id": "ego-lm2156sp-select-cut-xp-mulch",
    "name": "EGO Power+ Select Cut XP LM2156SP 21\"",
    "category": "56V Battery, Select Cut Multi-Blade, 8.3 ft-lb",
    "badge": "Best Battery Mulcher",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 4800,
    "pros": [
      "Select Cut system stacks an upper blade over an interchangeable lower blade, so clippings are cut twice before they settle",
      "Dedicated mulching lower blade included, alongside bagging and extended-runtime options",
      "8.3 ft-lb of cutting torque keeps blade speed up in thick grass, where weak battery mowers smear rather than cut",
      "Up to 75 minutes of rated runtime on the 10.0Ah battery",
      "Rear-wheel Touch Drive self-propel with a speed dial under your thumb"
    ],
    "cons": [
      "Mulching thick or tall grass shortens runtime noticeably compared with the rated figure",
      "Premium price, particularly with the large battery"
    ],
    "bottomLine": "The battery mower that mulches most like a good gas mower, thanks to the stacked blades and ample torque.",
    "description": "The most common complaint about battery mowers is that they do not mulch well, and it is usually fair. Mulching demands high blade speed and enough torque to hold that speed as the deck fills with clippings, and a battery mower that cuts corners on either will leave wet green rows behind it. The LM2156SP is the model that most convincingly answers that complaint. EGO's Select Cut system uses two stacked blades: a fixed upper blade and an interchangeable lower one. With the mulching lower blade fitted, clippings are cut by one blade and then the other before they drop, which produces fine pieces even in grass that is a little long. EGO rates it at 8.3 ft-lb of cutting torque, and in normal weekly mowing it does not bog. The practical cost is runtime. EGO rates the 10.0Ah battery at up to 75 minutes, and mulching thick, damp grass draws much more current than cutting dry, short grass, so plan on less in spring. The other lower blades are genuinely useful too: a high-lift bagging blade for leaf pickup, and an extended-runtime blade for when you need to finish a large lawn on one charge. If you want a battery mower primarily for mulching, this is the one to buy."
  },
  {
    "id": "toro-timemaster-30-21200-mulch",
    "name": "Toro 30\" TimeMaster Personal Pace Electric Start (21200)",
    "category": "Gas, 223cc Briggs & Stratton, Twin Atomic Blades",
    "badge": "Best for Large Lawns",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 900,
    "pros": [
      "Dual-Force cutting system runs two Toro Atomic blades, which cut clippings into fine mulch",
      "30-inch deck cuts about 40 percent more per pass than a 21-inch mower",
      "223cc OHV engine with 10 ft-lb of torque holds blade speed in heavy, mulch-loaded grass",
      "Electric start and a washout port for clearing clippings from under the deck",
      "3-year full warranty and a 13-gauge steel deck"
    ],
    "cons": [
      "Around 145 lb, it is heavy to maneuver around beds and trees",
      "Only a 2-point height adjustment, so changing cut height takes longer than on single-lever mowers"
    ],
    "bottomLine": "The fastest way to mulch an acre with a walk-behind, and a genuine alternative to a small rider on a large lawn.",
    "description": "On a lawn approaching an acre, a 21-inch mulching mower is slow, and slow mowing tends to become infrequent mowing, which is the enemy of mulching. The TimeMaster solves that with a 30-inch deck, about 40 percent more cutting width than a standard walk-behind. Its Dual-Force system runs two of Toro's Atomic blades, which are designed to cut clippings into fine pieces, and in our experience the clippings disappeared into the lawn as well as they do behind a 22-inch Recycler. The 223cc Briggs & Stratton OHV engine rates at 10 ft-lb of torque, which matters more for mulching than people realise: holding clippings under the deck adds load, and a small engine on a wide deck would bog. This one does not in normal grass. Electric start is welcome on a mower this size, and the washout port lets you hose accumulated clippings out from under the deck, which keeps mulching performance consistent over a season. The main drawback is handling. At around 145 lb, it is heavy to turn, and the wide deck is awkward around flower beds and trees. Height changes use a 2-point adjustment, which is slower than the single-lever systems on smaller mowers. For open, large lawns, though, it is the most efficient mulching walk-behind we recommend."
  },
  {
    "id": "toro-60v-recycler-22-21467-mulch",
    "name": "Toro 60V Max 22\" Recycler Personal Pace (21467)",
    "category": "60V Battery, 15-Gauge Steel Recycler Deck",
    "badge": "Best Battery Recycler Deck",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 500,
    "pros": [
      "Same 22-inch Recycler cutting system and Vortex airflow as Toro's gas mulching mowers",
      "15-gauge steel deck rather than the plastic or composite shells common on battery mowers",
      "Personal Pace rear-wheel drive adjusts to your walking speed",
      "Push-button start and no fuel, oil or spark plug to maintain",
      "Battery is shared across Toro's 60V Flex-Force tools"
    ],
    "cons": [
      "Rated at up to 40 minutes and about a third of an acre per charge, less than the EGO or Greenworks",
      "Around 85 lb, heavy for a battery mower"
    ],
    "bottomLine": "A proven mulching deck on a battery mower, best suited to smaller lawns because of the runtime.",
    "description": "Most battery mowers use their own deck designs, and many of them are optimized for runtime rather than mulching. This Toro takes a different route: it uses the same 22-inch Recycler cutting system and Vortex airflow as Toro's gas mowers, in a 15-gauge steel deck. That means the deck shape that holds clippings under the blade for a second and third cut is carried over intact, and the mulching result is close to what you get from a gas Recycler. Toro's Personal Pace drive is also carried over, so the mower matches your walking speed, and push-button start makes it easy to stop and restart in awkward spots. The limitation is energy. Toro rates the 6.0Ah battery at up to 40 minutes and up to a third of an acre per charge, and mulching dense grass uses energy faster than the rating assumes, so this is realistically a mower for small and medium lots. It is also heavy for a battery mower, around 85 lb, because of the steel deck. If your lawn is a third of an acre or less and you want the best mulching deck you can get without a gas engine, it is a strong choice. On larger lawns, the EGO LM2156SP's larger battery is the more practical option."
  },
  {
    "id": "greenworks-pro-80v-21-brushless-mulch",
    "name": "Greenworks Pro 80V 21\" Brushless Self-Propelled Mower",
    "category": "80V Battery, Steel Deck, 3-in-1",
    "badge": "Best Value Battery",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 3000,
    "pros": [
      "80V brushless motor rated by Greenworks as comparable to a 160cc gas engine",
      "21-inch steel deck with mulch, bag and side-discharge options",
      "Up to 70 minutes of rated runtime on the 5.0Ah battery",
      "Rear-wheel self-propel and 10-inch rear wheels",
      "4-year limited tool and battery warranty"
    ],
    "cons": [
      "Maximum cutting height of 3-3/4 inches is lower than we would like for mulching in summer",
      "Mulching dense grass drops runtime and blade speed more than on the EGO"
    ],
    "bottomLine": "A capable, well-priced battery mulcher for regular weekly mowing on small and medium lawns.",
    "description": "The Greenworks Pro 80V is the best-value battery mower we would recommend for mulching. Its 80V platform and brushless DigiPro motor give it more power than most mowers at its price, and Greenworks rates it as comparable to a 160cc gas engine, which is fair for normal grass. The 21-inch steel deck is a real advantage over the plastic decks on cheaper battery mowers, since steel holds its shape and resists the build-up of wet clippings better. It is a 3-in-1 design, so it mulches, bags or side discharges, and the rear-wheel self-propel with 10-inch rear wheels makes it comfortable on uneven ground. Greenworks rates the 5.0Ah battery at up to 70 minutes, and the pack also runs the rest of the Greenworks 80V range. The limits show up in two places. The maximum cutting height is 3-3/4 inches, which is fine for most of the year but a little low for mulching cool-season grass in midsummer, when a taller cut helps the lawn and the mower both. And in dense, damp grass, blade speed and runtime drop faster than on the EGO. Mowed weekly, before the grass gets long, it mulches well and costs considerably less than the premium battery models."
  },
  {
    "id": "craftsman-m310c-rwd-mulch",
    "name": "Craftsman M310 21\" 163cc RWD Self-Propelled Mower",
    "category": "Gas, 163cc Briggs & Stratton, 3-in-1 Deck",
    "badge": "Best Budget Gas",
    "amazonUrl": "#",
    "rating": 4.2,
    "reviewCount": 1500,
    "pros": [
      "Mulch kit included, along with side discharge and a 2.3-bushel rear bag",
      "163cc Briggs & Stratton engine with ReadyStart, so no priming or choking",
      "Rear-wheel drive with pace control that adjusts to your walking speed",
      "11-inch rear wheels ride over bumps without tipping the deck",
      "Folding handle for compact storage"
    ],
    "cons": [
      "A convertible 3-in-1 deck rather than one designed for mulching first, so the result is good rather than excellent",
      "Six height positions topping out at 3.75 inches"
    ],
    "bottomLine": "The cheapest gas mower we would buy primarily for mulching, provided you mow often and keep the blade sharp.",
    "description": "Budget gas mowers often mulch poorly because their decks are designed for side discharge and the mulch plug is an afterthought. The Craftsman M310 is a convertible 3-in-1 mower too, but it does the basics well enough to recommend on a budget. It comes with a mulch kit, a side-discharge chute and a 2.3-bushel rear bag, and the 163cc Briggs & Stratton engine with ReadyStart has enough power to mulch a regularly mown lawn cleanly. Rear-wheel drive with pace control adjusts the drive to your walking speed, which helps you slow down in heavier patches, and the 11-inch rear wheels ride over bumps without tipping the deck, which is how cheaper mowers scalp and leave uneven clumps. Craftsman pitches it at yards of half to three-quarters of an acre. Its limits come from the deck. Because it is not built around mulching the way a Toro Recycler is, it needs help: mow often enough that you never remove more than a third of the grass height, keep the blade sharp, and it will mulch well. Let the grass get long, or mow it wet, and it will leave clumps a Recycler would not. Six height positions topping out at 3.75 inches and a 2-year warranty reflect the price. For a tight budget, it is the right compromise."
  },
  {
    "id": "ego-lm2206sp-aluminum-mulch",
    "name": "EGO Power+ LM2206SP 22\" Aluminum Deck Self-Propelled",
    "category": "56V Battery, Cast Aluminum Deck, 11.1 ft-lb",
    "badge": "Premium Battery Pick",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 400,
    "pros": [
      "11.1 ft-lb of torque and blade speeds up to 3,350 RPM, the highest of any battery mower here",
      "Cast aluminum 22-inch deck will not rust, and wet clippings are easier to clean off",
      "Select Cut Multi-Blade system with interchangeable lower blades",
      "Eight cutting heights from 1 to 4 inches",
      "Lifetime deck warranty on registration"
    ],
    "cons": [
      "The most expensive mower in this guide by a clear margin",
      "Newer model with less long-term owner data than the LM2156SP"
    ],
    "bottomLine": "The strongest battery mulcher we recommend, for buyers who want gas-like torque and a deck that will outlast the mower.",
    "description": "The LM2206SP is EGO's answer to the question of whether a battery mower can mulch as well as a strong gas mower in any conditions. EGO rates it at 11.1 ft-lb of torque with blade speeds up to 3,350 RPM, the highest figures of any battery mower here, and that headroom shows when the grass is thick or a little long, the two situations where weaker battery mowers leave clumps. It uses the same Select Cut system as the LM2156SP, with a fixed upper blade over an interchangeable lower blade, so clippings are cut twice before they drop. The deck is the other distinguishing feature. Cast aluminum does not rust, which matters on a mulching mower because wet clippings sit against the underside of the deck all season, and EGO backs the deck with a lifetime warranty on registration. A smooth cast underside is also easier to scrape clean, which keeps airflow and mulching performance consistent. EGO rates the 10.0Ah battery at up to 70 minutes, and the Touch Drive self-propel runs from 0.9 to 3.1 mph. The objection is price: it costs far more than the Toro Recycler Max, which mulches about as well. Buy it if you are committed to battery power and want the best, not because you need it to mulch well."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Mulching Mowers",
          item: "https://www.thehonestreviewers.com/best-mulching-mower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best mulching mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Toro 22-inch Recycler Max with Personal Pace is our top pick. Its deck is designed around mulching, with a domed shape and Vortex airflow that hold clippings under the blade for several cuts, and the 13-gauge steel deck is built to last. For battery power, the EGO LM2156SP with its stacked Select Cut blades is the best choice."
          }
        },
        {
          "@type": "Question",
          "name": "Is mulching better than bagging grass clippings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most lawns, yes. Mulched clippings break down within days and return nitrogen and other nutrients to the soil, which can reduce how much fertilizer you need. Mulching is also faster, since there is no bag to empty. Bag when the lawn is overgrown, when there is a fungal disease, or when weeds have gone to seed."
          }
        },
        {
          "@type": "Question",
          "name": "Do mulched clippings cause thatch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Thatch is made up mainly of roots, stems and runners, which decompose slowly. Grass clippings are mostly water and break down within days, so they do not contribute significantly to thatch. Excess nitrogen and overwatering, which encourage fast, shallow growth, are more common causes of thatch problems."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a mulching blade and a regular blade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A regular, or high-lift, blade has a large upswept wing that creates strong airflow to throw clippings out of the chute or into the bag. A mulching blade has a longer curved cutting edge and extra cutting surfaces, with less lift, so clippings circulate under the deck and get cut several times into fine pieces."
          }
        },
        {
          "@type": "Question",
          "name": "Can you mulch wet grass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but the results are poor. Wet clippings stick together and to the deck, reducing airflow and blade speed and leaving clumps. If you have to mow wet grass, raise the cutting height, walk slowly and consider bagging for that one mowing. Afterwards, clean the underside of the deck."
          }
        },
        {
          "@type": "Question",
          "name": "Can a mulching mower handle leaves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you mulch them often. A thin layer of leaves where you can still see grass mulches easily into dime-sized pieces that feed the soil. A thick layer overwhelms the mower and leaves a mat. Mulch weekly through the autumn, go over areas twice if needed, and bag the excess for compost."
          }
        },
        {
          "@type": "Question",
          "name": "Are battery mowers good at mulching?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best ones are. Mulching needs high blade speed and enough torque to hold it as clippings build up. Premium battery mowers like the EGO LM2156SP and LM2206SP mulch about as well as good gas mowers. Cheaper models can struggle in thick grass. Expect runtime to fall well below the rating when mulching dense growth."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: "Alex Rivers",
    section: "Lawn & Yard Care",
    tags: [
      "best mulching mower",
      "mulching lawn mower",
      "mulching blade",
      "grasscycling",
      "mulching leaves with a mower"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
