import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Self-Propelled Lawn Mowers",
    "url": "/best-self-propelled-lawn-mower/"
  },
  {
    "title": "Best Gas Lawn Mowers",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "Best Electric Lawn Mowers",
    "url": "/best-electric-lawn-mower/"
  },
  {
    "title": "Best Battery-Powered Lawn Mowers",
    "url": "/best-battery-powered-lawn-mower/"
  },
  {
    "title": "How Often to Sharpen Mower Blades",
