---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Generators",
    "url": "/best-portable-generator/"
  },
  {
    "title": "Best 8,000 Watt Generators",
    "url": "/best-8000-watt-generator/"
  },
  {
    "title": "Best 4,000 Watt Generators",
    "url": "/best-4000-watt-generator/"
  },
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "What Size Generator Do I Need for My House",
    "url": "/what-size-generator-do-i-need-for-my-house/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "5 Best 5000 Watt Generators in 2026: The Smallest Size That Backs Up a House";
const description =
  "The best 5000 watt generators for home backup essentials, which ones have a 240V L14-30 outlet, open frame vs inverter at 5kW, and when to size up to 8000W.";

const PRODUCTS = [
  {
    "id": "westinghouse-wgen5300df",
    "name": "Westinghouse WGen5300DF Dual Fuel Portable Generator",
    "category": "Open Frame, 5,300W Running / 6,600W Peak, Dual Fuel",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 2400,
    "pros": [
      "5,300 running watts, more than most 5,000 watt-class units",
      "L14-30R transfer-switch-ready outlet plus a TT-30R RV outlet",
      "Remote electric start with auto choke",
      "Dual fuel with a 120/240V voltage selector",
      "Around 135 pounds, light for an open-frame unit with 240V"
    ],
    "cons": [
      "No CO sensor on this version; the WGen5300DFcv adds one",
      "Open-frame noise level, not suited to close neighbours"
    ],
    "bottomLine": "The best 5,000 watt-class generator for home backup: real running watts, a 240V twist-lock for a transfer switch and remote start, at a reasonable weight.",
    "description": "The WGen5300DF is the generator we would buy for a house on 5,000 watts. Westinghouse rates it at 5,300 running and 6,600 peak watts on gasoline from a 274cc engine, and propane output on the closely related DFv is listed at 4,800 running watts. That is enough to run a fridge, freezer, furnace blower, sump pump and lights together with room for a window AC. The panel has the L14-30R twist-lock you need for a 30-amp transfer switch, a TT-30R RV outlet and household outlets, and a voltage selector lets you run 120V only at full power. Remote electric start with auto choke means you can start it from a doorway in the rain. The 4.7 gallon tank is rated for up to 13.5 hours, a light-load figure. At around 135 pounds it is lighter than most open-frame generators with 240V. This version has no CO sensor; if you want one, the WGen5300DFcv is the same generator with CO shutdown."
  },
  {
    "id": "generac-gp5500e-8150",
    "name": "Generac GP5500E 8150 Portable Generator with COsense",
    "category": "Open Frame, 5,500W Running / 6,875W Starting, Gasoline",
    "badge": "Most Running Power",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 600,
    "pros": [
      "5,500 running watts, the most on this list",
      "Electronic fuel injection, so no carburetor to gum up in storage",
      "COsense shutdown and electric start with included battery",
      "L14-30R twist-lock and two 5-20R GFCI duplexes",
      "Rated 10.5 hours at 50% load; 50-state compliant"
    ],
    "cons": [
      "Gasoline only",
      "Heaviest pick at about 172 pounds"
    ],
    "bottomLine": "The most power you can get in this class, with EFI that removes the most common storage failure. Buy it if you store treated gasoline.",
    "description": "The GP5500E 8150 is Generac's fuel-injected 5,500 watt generator. Generac rates it at 5,500 running and 6,875 starting watts at 120/240V, the most continuous output in this roundup and 1,600 watts more than the iGen5000DFcv. Retail listings agree on a panel with an L14-30R twist-lock and two 5-20R GFCI duplexes, so it connects straight to a 30-amp transfer switch. The fuel injection is the standout. Carburetors gum up when gasoline sits for months, which is the most common reason a home backup generator will not start on the first storm of the year; EFI removes that failure. It is rated for 10.5 hours at 50% load, has electric start with an included battery and COsense, which shuts the engine down if carbon monoxide builds up. The trade-offs are that it runs on gasoline only and weighs about 172 pounds. If you rotate gasoline anyway, it is the strongest generator in this class."
  },
  {
    "id": "duromax-xp5500eh",
    "name": "DuroMax XP5500EH Dual Fuel Portable Generator",
    "category": "Open Frame, 4,500W Running / 5,500W Starting, Dual Fuel",
    "badge": "Best Value",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 2200,
    "pros": [
      "Low price for a dual fuel unit with a 240V twist-lock",
      "120/240V 30A twist-lock and two GFCI duplexes",
      "Switch to run 120V only at full power",
      "Rated 9 hours on gas and 8 on propane at half load",
      "Electric start; about 124 pounds"
    ],
    "cons": [
      "4,500 running watts, less headroom than the top two",
      "No CO shutdown listed"
    ],
    "bottomLine": "The cheapest way to get dual fuel and a 240V transfer switch outlet at this size. Plan on rotating the window AC.",
    "description": "The XP5500EH is the value pick for home backup. DuroMax rates it at 4,500 running and 5,500 starting watts, and it runs on gasoline or propane. The panel has a 120/240V 30A twist-lock for a transfer switch and two 120V GFCI household outlets, plus a selector to run 120V and 240V together or 120V only at full power. DuroMax lists 9 hours on gasoline and 8 hours on propane at 50% load, and the 3.96 gallon tank works out to about 0.44 gallons an hour at half load, the most economical open-frame unit here. Electric start with a recoil backup and a weight of about 124 pounds round it out, with a 3-year warranty. With 4,500 running watts it carries a fridge, freezer, furnace and sump pump comfortably, but a window AC on top leaves little margin, so expect to rotate. It has no CO shutdown listed, so placement matters even more."
  },
  {
    "id": "wen-df500ix",
    "name": "WEN DF500iX 5000-Watt Dual Fuel Inverter Generator",
    "category": "Inverter, 4,220W Rated / 5,000W Surge, Dual Fuel, 120/240V",
    "badge": "Best 240V Inverter",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 500,
    "pros": [
      "Inverter with 120/240V output, unusual at this size",
      "Marketed as transfer-switch and EV-ready, with bonded-neutral 240V for low-power Level 2 charging",
      "Dual fuel: 4,220 rated watts on gas, 3,800 on propane",
      "CO Watchdog shutdown and electric start",
      "Clean inverter power for electronics and furnace boards"
    ],
    "cons": [
      "Less running output than the open-frame picks",
      "Confirm the exact 240V receptacle on the listing before buying a cord"
    ],
    "bottomLine": "The one 5,000 watt inverter here that can feed a 240V transfer switch. Buy it if you want inverter quiet and home backup in one machine.",
    "description": "The DF500iX is WEN's answer to the problem with most 5,000 watt inverters: no 240V. WEN's manual rates it at 5,000 surge watts on both fuels and 4,220 rated watts on gasoline or 3,800 on propane, at 120V and 240V. WEN sells it as RV, transfer-switch and EV-ready, and its bonded-neutral 240V configuration supports low-power Level 2 electric vehicle charging. As an inverter it delivers clean power for electronics and throttles down at light load, and it has electric start and CO Watchdog shutdown. The trade is output: 4,220 running watts is less than the three open-frame picks, so it is a fridge, freezer, furnace and lights generator with a window AC in rotation. We could not confirm the full outlet list from the manual excerpts we read, so check the panel photo on the listing for the 240V receptacle type before buying a transfer-switch cord. If you want one machine for camping and home backup, it is the best compromise here."
  },
  {
    "id": "westinghouse-igen5000dfcv",
    "name": "Westinghouse iGen5000DFcv Dual Fuel Inverter Generator",
    "category": "Inverter, 3,900W Running / 5,000W Peak, Dual Fuel, 120V",
    "badge": "Best for RV and Quiet",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 1800,
    "pros": [
      "Lightest here at around 80 to 85 pounds",
      "Rated under 3% total harmonic distortion",
      "Up to 18 hours at 25% load",
      "TT-30R RV outlet, 5-20R duplex and USB ports",
      "CO sensor shutdown, parallel capable, 3-year warranty"
    ],
    "cons": [
      "No 240V or L14-30R outlet, so no transfer switch for 240V loads",
      "3,900 running watts on gas and 3,500 on propane"
    ],
    "bottomLine": "The best 5,000 watt inverter for an RV or campsite that doubles as outage backup on extension cords. Not the pick for a transfer switch.",
    "description": "The iGen5000DFcv is the quietest, lightest and most versatile generator here, and the weakest for home backup, which is why it ranks last for this page's purpose. Westinghouse rates it at 5,000 peak and 3,900 running watts on gasoline and 4,500 peak and 3,500 running on propane, with total harmonic distortion under 3%. It is rated for up to 18 hours at 25% load, and retail listings put the weight at around 80 to 85 pounds, so one person can wheel it up a ramp. The outlets are a 120V 5-20R duplex, a TT-30R RV outlet and USB ports, plus a CO sensor shutdown and parallel capability. What it lacks is 240V. The TT-30R is a 120V RV plug, so you cannot feed both legs of a panel or a 240V well pump through a transfer switch. For RV owners who want outage backup on extension cords, it is excellent. For house backup, buy one of the three open-frame picks."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best 5000 Watt Generator",
          item: "https://www.thehonestreviewers.com/best-5000-watt-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What will a 5000 watt generator run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A refrigerator, chest freezer, gas furnace blower, sump pump, lights and electronics at the same time for most homes, which typically totals 2,500 to 3,500 running watts. It can add a window air conditioner or start a 1 HP well pump, but usually not both together. It will not run central air or an electric water heater."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 5000 watt generator run a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can run the essentials of most houses through a transfer switch, if it has a 120/240V L14-30R outlet. You will need to rotate the bigger loads, such as the freezer, well pump and window AC. It cannot run central air, an electric range or an electric water heater."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 5000 watt generator run a well pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes for a 1 HP or smaller pump, if the generator has a 240V L14-30R outlet and a transfer switch feeds the pump circuit. A 1 HP pump typically needs 3,000 to 4,000 watts to start, so start it before the window AC, not at the same time."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 5000 watt generator enough for a refrigerator and freezer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Easily. A refrigerator and chest freezer together typically run at 1,000 to 1,400 watts, with brief starting surges around 2,000 watts. A 5,000 watt generator runs both with the furnace and lights, and still has room for a sump pump or a window AC."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 5000 watt generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly 9 to 10.5 hours at half load for the open-frame models here, based on manufacturer ratings, and up to 13.5 to 18 hours at light loads. At half load expect to burn about 0.4 to 0.5 gallons an hour, or around 6 to 10 gallons a day depending on hours run."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 5000 watt inverter generator worth it for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it has 240V. Most 5,000 watt inverters, like the Westinghouse iGen5000DFcv, are 120V only with a TT-30R RV outlet, which cannot feed a home transfer switch for 240V loads. The WEN DF500iX is an exception with 120/240V output. For home-first use, an open-frame unit with an L14-30R gives more running watts per dollar."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a 5000 or 8000 watt generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy 5,000 watts if you are on city water with a gas furnace and are willing to rotate the freezer and window AC. Buy 8,000 watts if you are on a well, want air conditioning without managing loads, or want everything on the transfer switch to run at once."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "5000 watt generator",
      "5000w generator",
      "generator 5000 w",
      "5 000 watt inverter generator",
      "best 5000 watt generator",
      "5000 watt dual fuel generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">5000 Watt Generators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Five thousand watts is the smallest generator that can keep a house functional in an outage, if you pick one with a 240V twist-lock and accept running big loads in turns. Here are the five worth buying and how to tell them apart.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#westinghouse-wgen5300df"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            See the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What 5,000 Watts Runs</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The 5 Best, Ranked</a>
          <a href="#ratings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Reading 5kW Ratings Honestly</a>
          <a href="#two-forty" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The 240V L14-30 Outlet</a>
          <a href="#rotation" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Running a House in Rotation</a>
          <a href="#inverter" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Open Frame vs Inverter at 5kW</a>
          <a href="#gap" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. The 4kW to 8kW Gap</a>
          <a href="#fuel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Fuel Burn and Dual Fuel</a>
          <a href="#hookup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Connecting to the House</a>
          <a href="#skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Should Buy Something Else</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A 5,000 watt generator keeps the food cold, the furnace blowing, the sump pump pumping and the lights on, but not all of the big loads at once, and not at all if it lacks the one outlet that connects it to your panel. At this size the label number tells you less than at any other: some 5,000 watt generators run 5,500 watts all day, and some run 3,900.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-it-runs" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What 5,000 Watts Runs, and What It Does Not
          </h2>

          <p>
            The essentials list for an outage is short: refrigerator, chest freezer, the gas furnace blower in winter or a window AC in summer, a sump pump if you have a basement, lights, a router and phone chargers. Add typical running watts and most homes land between 2,500 and 3,500 watts. That fits comfortably inside a 5,000 watt generator with room left for one motor to start.
          </p>

          <p>
            Motors are the constraint. A refrigerator compressor pulls roughly 1,800 to 2,200 watts for a second as it starts, a half-horsepower sump pump around 2,000, a furnace blower around 2,000 to 2,400, and a 10,000 BTU window AC close to 3,000. A 5,000 watt generator can absorb one of those starts on top of the running load easily, two if the running load is light. What it cannot do is carry the running load plus a well pump start plus an AC start at once, which is the job of an <a href="/best-8000-watt-generator/">8,000 watt generator</a>.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Load</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical running watts</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical starting watts</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fits on 5kW?</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Refrigerator</td>
                    <td class="px-4 py-4 text-gray-700">600-800</td>
                    <td class="px-4 py-4 text-gray-700">1,800-2,200</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chest freezer</td>
                    <td class="px-4 py-4 text-gray-700">400-600</td>
                    <td class="px-4 py-4 text-gray-700">1,200-1,500</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Furnace blower (1/2 HP)</td>
                    <td class="px-4 py-4 text-gray-700">700-900</td>
                    <td class="px-4 py-4 text-gray-700">2,000-2,400</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sump pump (1/2 HP)</td>
                    <td class="px-4 py-4 text-gray-700">800-1,000</td>
                    <td class="px-4 py-4 text-gray-700">1,800-2,200</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Window AC (10,000 BTU)</td>
                    <td class="px-4 py-4 text-gray-700">900-1,200</td>
                    <td class="px-4 py-4 text-gray-700">2,700-3,200</td>
                    <td class="px-4 py-4 text-gray-700">Yes, with care</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Well pump (1 HP, 240V)</td>
                    <td class="px-4 py-4 text-gray-700">1,000-1,500</td>
                    <td class="px-4 py-4 text-gray-700">3,000-4,000</td>
                    <td class="px-4 py-4 text-gray-700">Alone, with 240V outlet</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Central AC (3 ton)</td>
