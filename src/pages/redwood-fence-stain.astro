                    <td class="px-4 py-4 font-black text-gray-900">Semi-transparent oil</td>
                    <td class="px-4 py-4 text-gray-700">Redwood tone, grain visible</td>
                    <td class="px-4 py-4 text-gray-700">3-5 years</td>
                    <td class="px-4 py-4 text-gray-700">Most fences, mixed heart and sapwood boards</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Solid-colour stain</td>
