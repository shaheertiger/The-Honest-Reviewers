import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Shop Vacs Tested and Ranked",
    "url": "/best-shop-vac/"
  },
  {
    "title": "Shop Vac vs Regular Vacuum",
    "url": "/shop-vac-vs-regular-vacuum/"
  },
  {
    "title": "Best Drywall Sander",
    "url": "/best-drywall-sander/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-11", modified: "2026-09-11" });
const title = "What Size Shop Vac Do I Need? Gallons, Hose and Airflow Explained";
const description =
  "Tank gallons decide how often you empty; hose diameter and airflow decide how well it picks up. Here is how to size a shop vac for a garage, a workshop, water or a car.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Size Shop Vac Do I Need?",
          item: "https://www.thehonestreviewers.com/what-size-shop-vac-do-i-need/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size shop vac do I need for home use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Five to eight gallons suits most households. It holds enough that ordinary garage and DIY jobs finish without emptying, it is light enough to carry up stairs or into a car, and it stores in a corner. Step up to nine to fourteen gallons if you cut wood regularly, renovate, or expect to pick up water."
          }
        },
        {
          "@type": "Question",
          "name": "Is a bigger shop vac always better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Tank size decides how often you stop to empty, not how well the machine picks up \u2014 airflow and hose diameter do that. A large tank full of water can weigh over a hundred pounds, cannot be lifted or tipped, and occupies permanent floor space. Many people would be better served by a smaller tank and a wider hose."
          }
        },
        {
          "@type": "Question",
          "name": "What size shop vac do I need for water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Match the tank to the volume you expect to remove: a few gallons for an appliance leak, twelve or more for a flooded basement corner. More important than capacity is a drain port near the base, which lets you empty with a garden hose instead of tipping. Never fill past the marked maximum water line."
          }
        },
        {
          "@type": "Question",
          "name": "Does hose size matter on a shop vac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "More than tank size does. A 2.5-inch hose moves considerably more air than a 1.25-inch hose on the same motor and swallows debris that would jam the narrow one. The small hose is better for car interiors and crevices. The ideal setup is a 2.5-inch port with reducers so you can use both."
          }
        },
        {
          "@type": "Question",
          "name": "How many gallons is a good shop vac for a garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Six to nine gallons is the sweet spot for a domestic garage. It handles sawdust, leaves, the car, and a modest spill without needing emptying mid-job, and it remains light enough to move easily. Sixteen-gallon machines suit workshops and job sites where the vac stays in one place on castors."
          }
        },
        {
          "@type": "Question",
          "name": "What do I need for connecting a shop vac to power tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tool-triggered auto-start outlet, adapters to fit your tools' dust ports, and a plan for filter clogging. Sanding dust blinds a cartridge within minutes, so use a collection bag and clean or tap the filter between sessions. Dedicated dust extractors automate that with filter pulsing, which is the main reason they cost more."
          }
        },
        {
          "@type": "Question",
          "name": "How much does tank size affect suction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at all directly. Suction comes from the motor, the impeller and how restricted the air path is; tank volume only determines how long you can work before emptying. A small vac with strong airflow and a wide hose outperforms a large vac with a weak motor and a narrow hose on every pickup task."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
---

