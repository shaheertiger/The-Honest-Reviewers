      "waterproof basement flooring",
      "best vinyl plank for basement",
      "basement subfloor",
      "flooring for concrete basement"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
