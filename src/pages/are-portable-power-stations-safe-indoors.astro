          },
        },
        {
          "@type": "Question",
          name: "Can you use a power station in a bathroom or near water?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Almost all of these units are rated for dry indoor use only, with no meaningful water protection, and mains-voltage outlets near water are dangerous regardless of the source. Keep them away from bathrooms, sinks and anywhere rain can reach them.",
          },
        },
        {
          "@type": "Question",
          name: "Is it safe to charge a power station overnight indoors?",
