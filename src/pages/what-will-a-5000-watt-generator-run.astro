const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.thehonestreviewers.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.thehonestreviewers.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Will a 5000 Watt Generator Run?",
          item: "https://www.thehonestreviewers.com/what-will-a-5000-watt-generator-run/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a 5000 watt generator run a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It will run the essentials of most houses with gas heat: refrigerator, freezer, furnace blower, sump pump, lights and internet, all at once, with room for one motor to start. It will not run a house as if the power never went out, because central air, electric cooking, an electric water heater and a dryer are each too big. Think of it as an essentials-plus-one-comfort machine."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 5000 watt generator run a refrigerator and a freezer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Easily. A typical refrigerator runs at about 700 watts and a chest freezer at about 500, so both together use roughly a quarter of a 5kW unit's running capacity. Their compressor starts, around 2,200 and 1,500 watts, are well within the starting rating. The only caution is not letting both start in the same second right after the generator comes on."
          }
        },
        {
          "@type": "Question",
          "name": "Will a 5000 watt generator run a window air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, one 10,000 BTU unit alongside the refrigerator, freezer and lights. It typically runs at 1,000 to 1,200 watts and starts at up to about 3,000. With the rest of the list running, the worst-case start lands around 5,600 watts, so a model rated 6,000 or more starting watts handles it. A 5,000 peak watt inverter may struggle in hot weather."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 5000 watt generator run a well pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 1/2 to 1 HP well pump, yes, if the generator has a 120/240V L14-30R outlet and you connect through a transfer switch. Clear other motors off while the pump starts, because a 1 HP pump can surge to 4,000 watts. A 1.5 HP or larger pump usually needs a bigger generator or a soft starter on the pump control box."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 5000 watt generator run central air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in any practical sense. A 3 ton system runs at 3,000 to 3,800 watts and starts at 9,000 to 12,000, so the start alone is about twice what the generator can deliver. A soft starter cuts the surge, but the running draw would still leave almost nothing for the refrigerator and furnace. One window unit in a bedroom is the realistic summer plan at this size."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a 5000 watt generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on load more than size. Many 5kW open-frame models are rated for somewhere around 8 to 13 hours at a quarter to half load on a full tank of four to six gallons, and less at the 3,400 to 3,700 watt loads in this guide. Check the spec sheet's runtime figure and the load it was quoted at, and plan to refuel at least twice a day."
          }
        },
        {
          "@type": "Question",
          "name": "Is 5000 watts enough, or should I buy bigger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is enough if your list is the essentials plus one comfort load, you have gas heat, and any well pump is 1 HP or smaller. Move up to the 6,500 to 8,000 watt class if you have a larger well pump, want two air conditioners, or do not want to stage loads. Move up to 10,000 watts or a standby unit if central air or electric cooking is non-negotiable."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "The Honest Reviewers" },
    },
  ],
};
