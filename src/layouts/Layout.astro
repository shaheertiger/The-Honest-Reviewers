---
import SEO from '../components/SEO.astro';
import MobileNav from '../components/MobileNav';

interface Props {
  title?: string;
  description?: string;
  stickyCta?: { text: string; link: string };
  ogImage?: string;
  ogType?: 'website' | 'article';
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = 'The Honest Reviewers | Expert Product Guides & Comparisons',
  description = 'Unbiased, expert-led product reviews to help you make the best buying decisions. We test so you don\'t have to.',
  stickyCta,
  ogImage,
  ogType,
  article,
  jsonLd,
  noindex,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <SEO
    title={title}
    description={description}
    ogImage={ogImage}
    ogType={ogType}
    article={article}
    jsonLd={jsonLd}
    noindex={noindex}
  />
</head>
<body class="bg-white text-[#333333] selection:bg-[#FF4500] selection:text-white font-sans">
  <div class="min-h-screen flex flex-col bg-white">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center gap-2 cursor-pointer no-underline">
            <span class="text-2xl font-black tracking-tighter text-[#1E90FF]">THE HONEST</span>
            <span class="text-2xl font-black tracking-tighter text-[#333333]">REVIEWERS</span>
          </a>

          <!-- Desktop Nav -->
          <nav class="hidden md:flex space-x-8 items-center">
            <a href="/" class="text-gray-600 hover:text-[#1E90FF] font-medium no-underline">Home</a>
            <a href="/best-of" class="text-gray-600 hover:text-[#1E90FF] font-medium no-underline">Best Lists</a>
            <a href="#" class="text-gray-600 hover:text-[#1E90FF] font-medium no-underline">Guides</a>
            <div class="relative group">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover:text-[#1E90FF] cursor-pointer"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            </div>
          </nav>

          <!-- Mobile menu (React island) -->
          <MobileNav client:load />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Mobile Sticky CTA -->
    {stickyCta && (
      <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-50 shadow-[0_-4px_10px_rgba(0,0,0,0.05)]">
        <a
          href={stickyCta.link}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full bg-[#FF4500] hover:bg-[#E63E00] text-white py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all active:scale-95 shadow-lg no-underline"
        >
          {stickyCta.text}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
    )}

    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200 pt-16 pb-24 md:pb-16 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
          <div class="col-span-1 md:col-span-2">
            <h2 class="text-xl font-bold mb-4">The Honest Reviewers</h2>
            <p class="text-gray-600 max-w-sm mb-6 leading-relaxed">
              Our mission is to cut through the marketing noise and provide genuine, expert-led reviews that help you save time and money.
            </p>
            <div class="bg-[#1E90FF]/10 p-4 rounded-lg border border-[#1E90FF]/20">
              <p class="text-xs text-[#1E90FF] font-bold uppercase tracking-wider mb-1">Affiliate Disclosure</p>
              <p class="text-xs text-gray-500 leading-tight">
                We are a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for us to earn fees by linking to Amazon.com and affiliated sites.
              </p>
            </div>
          </div>
          <div>
            <h3 class="font-bold mb-4">Categories</h3>
            <ul class="space-y-2 text-gray-600 list-none p-0">
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Smart Home</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Kitchen Gear</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Tech Reviews</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Fitness Tech</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold mb-4">Company</h3>
            <ul class="space-y-2 text-gray-600 list-none p-0">
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">About Our Team</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Contact Us</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Privacy Policy</a></li>
              <li><a href="#" class="hover:text-[#1E90FF] no-underline text-gray-600">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-gray-200 text-center text-gray-400 text-sm">
          &copy; {new Date().getFullYear()} The Honest Reviewers. All rights reserved.
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
